# 多階段建構ESG儀表板 - 優化版本
FROM node:20-alpine AS base

# 安裝依賴階段 - 使用多層快取優化
FROM base AS deps
RUN apk add --no-cache libc6-compat git
WORKDIR /app

# 只複製package檔案進行依賴安裝快取
COPY package*.json ./
COPY .npmrc* ./

# 安裝所有依賴（包含建構工具）
RUN npm ci --legacy-peer-deps --no-audit --no-fund && npm cache clean --force

# 建構階段 - 分離依賴和源碼
FROM base AS builder
RUN apk add --no-cache git
WORKDIR /app

# 複製已安裝的依賴
COPY --from=deps /app/node_modules ./node_modules

# 複製源碼
COPY . .

# 設定建構環境變數
ENV NODE_ENV=production
ENV VITE_API_URL=https://api.esg-dashboard.com
ENV NEXT_TELEMETRY_DISABLED=1

# 建構應用
RUN npm run build

# 生產階段 - 使用更小的基礎鏡像
FROM nginx:1.25-alpine AS runner

# 安裝必要的運行時依賴
RUN apk add --no-cache curl tzdata && \
    cp /usr/share/zoneinfo/Asia/Taipei /etc/localtime && \
    echo "Asia/Taipei" > /etc/timezone

# 建立非root用戶
RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nextjs

# 複製nginx配置
COPY --chown=nextjs:nodejs nginx.conf /etc/nginx/nginx.conf

# 複製建構產物
COPY --from=builder --chown=nextjs:nodejs /app/dist /usr/share/nginx/html

# 設定權限
RUN chown -R nextjs:nodejs /var/cache/nginx && \
    chown -R nextjs:nodejs /var/log/nginx && \
    chown -R nextjs:nodejs /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown -R nextjs:nodejs /var/run/nginx.pid

# 創建健康檢查腳本
COPY --chown=nextjs:nodejs <<EOF /healthcheck.sh
#!/bin/sh
curl -f http://localhost/health || exit 1
EOF
RUN chmod +x /healthcheck.sh

# 切換到非root用戶
USER nextjs

# 健康檢查
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD /healthcheck.sh

# 暴露端口
EXPOSE 80

# 設定環境變數
ENV NGINX_WORKER_PROCESSES=auto

# 啟動nginx
CMD ["nginx", "-g", "daemon off;"]