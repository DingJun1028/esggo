{
  "info": {
    "name": "ESGss JunAiKey API Collection",
    "description": "ESG Sunshine Universal System v2.0 API Collection for Postman",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "item": [
    {
      "name": "健康檢查",
      "item": [
        {
          "name": "Get Health Status",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "檢查 API 服務健康狀態"
          }
        }
      ]
    },
    {
      "name": "ESG 數據",
      "item": [
        {
          "name": "獲取 ESG 數據",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text",
                "description": "API 認證金鑰"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/esg-data",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "esg-data"]
            },
            "description": "獲取 ESG 指標數據"
          }
        }
      ]
    },
    {
      "name": "AI 分析",
      "item": [
        {
          "name": "請求趨勢分析",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"carbonEmissions\": 12500,\n    \"energyConsumption\": 87500\n  },\n  \"type\": \"trend_analysis\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/analyze",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "analyze"]
            },
            "description": "請求 AI 趨勢分析"
          }
        },
        {
          "name": "環境影響評估",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"carbonEmissions\": 12500,\n    \"waterUsage\": 45200,\n    \"wasteGeneration\": 1250\n  },\n  \"type\": \"environmental_impact\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/analyze",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "analyze"]
            },
            "description": "請求環境影響評估"
          }
        }
      ]
    },
    {
      "name": "趨勢預測",
      "item": [
        {
          "name": "獲取趨勢預測",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/trends",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "trends"]
            },
            "description": "獲取 ESG 趨勢預測數據"
          }
        }
      ]
    },
    {
      "name": "系統事件",
      "item": [
        {
          "name": "獲取系統事件",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-API-Key",
                "value": "{{api_key}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/events",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "events"]
            },
            "description": "獲取系統事件日誌"
          }
        }
      ]
    },
    {
      "name": "Webhook 整合",
      "item": [
        {
          "name": "Make.com Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"esg_data_updated\",\n  \"data\": {\n    \"company\": \"ABC Corp\",\n    \"metrics\": {\n      \"carbon\": 12500,\n      \"energy\": 87500\n    }\n  },\n  \"timestamp\": \"{{timestamp}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/webhook/make",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "webhook", "make"]
            },
            "description": "模擬 Make.com webhook 請求"
          }
        },
        {
          "name": "Boost.space Webhook",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"webhook\": {\n    \"id\": \"boost_webhook_123\",\n    \"event\": \"scenario_completed\",\n    \"data\": {\n      \"scenarioId\": \"esg_analysis_001\",\n      \"result\": \"success\"\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/webhook/boost",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "webhook", "boost"]
            },
            "description": "模擬 Boost.space webhook 請求"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3001",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "your-api-key-here",
      "type": "string"
    },
    {
      "key": "timestamp",
      "value": "",
      "type": "string"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 自動設置時間戳",
          "pm.collectionVariables.set(\"timestamp\", new Date().toISOString());"
        ]
      }
    }
  ]
}