# ===========================================
# ESG Sunshine JunAiKey V Beta Environment Variables
# ===========================================
# IMPORTANT: DO NOT commit this file. Add .env to your .gitignore file.
# Copy this file to .env and fill in your actual values

# ===========================================
# AI SERVICE CONFIGURATIONS
# ===========================================

# Google Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.7

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.7

# JunAiKey Legacy API Key (for backward compatibility)
API_KEY=your-google-api-key-here

# ===========================================
# DATABASE CONFIGURATIONS
# ===========================================

# Supabase Configuration (Primary Database for ESG Hub)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Legacy PostgreSQL Database (for backward compatibility)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=esg_db
DB_USER=esg_user
DB_PASSWORD=esg_password

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================

# JWT Secret for authentication
JWT_SECRET=esg-jwt-secret-key-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt rounds for password hashing
BCRYPT_ROUNDS=12

# Legacy Admin Secret (for JunAiKey compatibility)
ADMIN_SECRET=legacy-admin-secret-token

# ===========================================
# EXTERNAL INTEGRATIONS
# ===========================================

# AITable.ai Configuration
AITABLE_API_KEY=your-aitable-api-key
AITABLE_BASE_ID=your-aitable-base-id

# Straico AI Configuration
STRAICO_API_KEY=your-straico-api-key
STRAICO_BASE_URL=https://api.straico.com

# Boost.space Configuration
BOOSTSPACE_WEBHOOK_URL=https://your-instance.boost.space/api/webhooks/your-webhook-id
BOOSTSPACE_API_KEY=your-boostspace-api-key

# Cloudflare Tunnel (for JunAiKey)
TUNNEL_TOKEN=your-cloudflare-tunnel-token

# ===========================================
# APPLICATION SETTINGS
# ===========================================

# Node Environment
NODE_ENV=development

# Server Ports
PORT=3001
FRONTEND_PORT=3000

# CORS Settings
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX=100

# ===========================================
# MONITORING & LOGGING
# ===========================================

# Logging
LOG_LEVEL=info

# Monitoring
MONITORING_ENABLED=true
METRICS_INTERVAL=30000
METRICS_RETENTION=86400

# ===========================================
# LEARNING SETTINGS
# ===========================================

# Learning Platform
MAX_LEARNING_USERS=1000
LEARNING_TIMEOUT=3600000
CONTENT_CACHE_TTL=3600

# ===========================================
# FILE UPLOAD SETTINGS
# ===========================================

MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=jpg,jpeg,png,pdf,doc,docx
UPLOAD_PATH=./uploads

# ===========================================
# EMAIL CONFIGURATION (OPTIONAL)
# ===========================================

EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@esgss.com

# ===========================================
# FEATURE FLAGS
# ===========================================

FEATURE_AI_INSIGHTS=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_REALTIME_COLLAB=true
FEATURE_PERSONALIZED_LEARNING=true

# ===========================================
# FRONTEND SETTINGS (for Vite)
# ===========================================

VITE_API_URL=http://localhost:3001/api
VITE_APP_NAME=ESG Sunshine JunAiKey V Beta
VITE_APP_VERSION=5.0.0

# ===========================================
# LEGACY SETTINGS (for backward compatibility)
# ===========================================

# Legacy JunAiKey settings
JAK_API_URL=http://localhost:3001/api
JAK_ADMIN_SECRET=legacy-admin-secret-token

# Legacy database password (for JunAiKey compatibility)
DB_PASSWORD=junaikeydb_secret
