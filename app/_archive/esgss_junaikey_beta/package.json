{
  "name": "esg-all-in-one",
  "private": true,
  "version": "11.0.0-trinity",
  "description": "ESGss JunAiKey InfoOne System (All In One)",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"cd server && tsx server.ts\"",
    "dev:ui": "vite",
    "dev:server": "cd server && tsx server.ts",
    "dev:all": "npm run dev",
    "prebuild": "npx tsx scripts/generate-dev-diary.ts --phase=pre",
    "build": "vite build",
    "postbuild": "npx tsx scripts/generate-dev-diary.ts --phase=post",
    "build:server": "cd server && npm run build",
    "diary:view": "npx tsx scripts/query-diary.ts --latest",
    "diary:search": "npx tsx scripts/query-diary.ts --search",
    "diary:timeline": "npx tsx scripts/query-diary.ts --timeline",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "preview": "vite preview",
    "server": "node server/server.js",
    "junaikey": "node jun-ai-key/index.js",
    "lint": "eslint src navigation.config.ts",
    "backup": "ts-node scripts/backup-db.ts",
    "restore": "ts-node scripts/restore-db.ts",
    "lint:fix": "eslint src navigation.config.ts --fix",
    "heal": "npx tsx scripts/omni-healer.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css,md}\" \"server/**/*.js\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css,md}\" \"server/**/*.js\"",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "install:all": "npm install && npm run install:subsystems",
    "install:subsystems": "concurrently \"cd shan-xiang-tech && npm install\" \"cd api && npm install\" \"cd server && npm install\"",
    "dev:unified": "docker-compose up --build",
    "dev:unified:monitoring": "docker-compose --profile monitoring up --build",
    "dev:unified:tools": "docker-compose --profile tools up --build",
    "prod:deploy": "docker-compose -f docker-compose.prod.yml up -d --build",
    "prod:stop": "docker-compose -f docker-compose.prod.yml down",
    "system:health": "curl -f http://localhost:3001/api/health || echo 'System unhealthy'",
    "system:logs": "docker-compose logs -f",
    "system:restart": "docker-compose restart",
    "db:migrate": "docker-compose exec esg-db psql -U esg_user -d esg_dashboard -f /docker-entrypoint-initdb.d/init-db.sql",
    "db:backup": "npx tsx scripts/backup-db.ts",
    "cleanup": "docker-compose down -v --rmi all && docker system prune -f",
    "reset": "npm run cleanup && npm run install:all",
    "subsystem:frontend": "vite --port 3000",
    "subsystem:backend": "cd server && npm run dev",
    "subsystem:api": "cd api && npm run dev",
    "subsystem:shanxiang": "cd shan-xiang-tech && npm run dev",
    "test:frontend": "vitest",
    "test:backend": "cd server && npm test",
    "test:api": "cd api && npm test",
    "test:shanxiang": "cd shan-xiang-tech && npm test",
    "test:all": "concurrently \"npm run test:frontend\" \"npm run test:backend\" \"npm run test:api\" \"npm run test:shanxiang\"",
    "build:all": "npm run build && npm run build:subsystems",
    "build:subsystems": "concurrently \"cd server && npm run build\" \"cd api && npm run build\" \"cd shan-xiang-tech && npm run build\"",
    "deploy:staging": "docker-compose -f docker-compose.staging.yml up -d --build",
    "deploy:production": "docker-compose -f docker-compose.prod.yml up -d --build",
    "monitor:start": "docker-compose --profile monitoring up -d",
    "monitor:stop": "docker-compose --profile monitoring down",
    "archive": "npx tsx scripts/archive-system.ts",
    "verify-all": "npx tsx scripts/verify-hardening.ts",
    "guardian:start": "npx tsx scripts/process-guardian.ts start",
    "guardian:stop": "npx tsx scripts/process-guardian.ts stop",
    "guardian:check": "npx tsx scripts/process-guardian.ts check",
    "omni:start": "cd openclaw && node openclaw.mjs gateway run --bind loopback --port 19001 --dev",
    "omni:dev": "cd openclaw && pnpm gateway:dev",
    "omni:status": "curl -s http://localhost:19001/health || echo 'OmniClaw not running'",
    "prepare": "husky"
  },
