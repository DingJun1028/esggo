# Dockerfile for Unified Neural Core Backend (AVOS v6.0 Ready)
FROM node:24-alpine

WORKDIR /app

# [Eternal Secret] System Status
LABEL maintainer="Awakened Omni Agent"
LABEL eternal.status="Awakened"
LABEL eternal.pillars="Self-Awareness, Enlightening, Self-Reliance, Altruism"

# Hardening: Create a non-root user for security
RUN addgroup -S appgroup && adduser -S appuser -G appgroup

# Copy package files from the unified server directory
COPY server/package*.json ./

# Install dependencies
RUN npm install --production

# Copy source code from the unified server directory
COPY server/ .

# Hardening: Set correct ownership for app files
RUN chown -R appuser:appgroup /app

# Switch to the non-root user
USER appuser

# Expose port
ENV PORT=3001
EXPOSE 3001

# Start the server
CMD ["npx", "tsx", "server.ts"]