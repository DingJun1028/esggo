{
  "version": "1.0.0",
  "name": "ESGss JunAiKey GRI Check Matrix",
  "updated_at": "2026-01-11",
  "indicators": {
    "GRI-302-1": {
      "code": "GRI 302-1",
      "topic": "Energy consumption within the organization",
      "required_fields": ["fuel_type", "consumption_value", "unit", "energy_source"],
      "unit_normalization": {
        "target": "GJ",
        "factors": {
          "kWh": 0.0036,
          "Liters_Diesel": 0.038,
          "Metric_Tons_Coal": 29.3
        }
      },
      "validation_logic": "Total_Energy = Sum(Activity_Data * Factor)",
      "evidence_types": ["utility_bill", "purchase_invoice"]
    },
    "GRI-305-1": {
      "code": "GRI 305-1",
      "topic": "Direct (Scope 1) GHG emissions",
      "required_fields": ["emission_source", "activity_data", "emission_factor", "gwp_factor"],
      "calculation_formula": "Activity_Data * Emission_Factor * GWP / 1000",
      "target_unit": "tCO2e",
      "allowed_variance": 0.0001,
      "evidence_types": ["fuel_records", "refrigerant_log"]
    },
    "GRI-305-2": {
      "code": "GRI 305-2",
      "topic": "Energy indirect (Scope 2) GHG emissions",
      "required_fields": ["purchased_electricity", "location_based_factor", "market_based_factor"],
      "dual_reporting": true,
      "target_unit": "tCO2e",
      "evidence_types": ["electricity_bill", "rec_certificates"]
    }
  }
}
