t a soul form for ${awakeningAgent.name}`}\n                  </p>\n                </div>\n                <Button variant=\"ghost\" onClick={() => setIsSelectingPersona(false)}>\n                  {isZh ? '??' : 'Cancel'}\n                </Button>\n              </div>\n              <div className=\"flex-1 overflow-hidden p-6\">\n                <OmniAvatarGallery onSelectPersona={handlePersonaSelect} language={language} />\n              </div>\n            </div>\n          </div>\n        )}\n\n        {/* Awakening Ritual */}\n        {isPerformingRitual && awakeningAgent && selectedPersonaId && (\n          <OmniAwakeningRitual\n            agent={awakeningAgent}\n            targetPersonaId={selectedPersonaId}\n            onComplete={handleRitualComplete}\n            onCancel={handleRitualCancel}\n            language={language}\n          />\n        )}\n      </div>\n    </ErrorBoundary>\n  );\n});\n\nAgentForge.displayName = 'AgentForge';\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\AlphaOmegaMatrix.tsx","messages":[{"ruleId":"react/prop-types","severity":2,"message":"'cycle' is missing in props validation","line":34,"column":41,"nodeType":"Property","messageId":"missingPropType","endLine":34,"endColumn":46},{"ruleId":"react/prop-types","severity":2,"message":"'cycle.startTime' is missing in props validation","line":35,"column":56,"nodeType":"Identifier","messageId":"missingPropType","endLine":35,"endColumn":65},{"ruleId":"react/prop-types","severity":2,"message":"'cycle.startTime' is missing in props validation","line":35,"column":75,"nodeType":"Identifier","messageId":"missingPropType","endLine":35,"endColumn":84},{"ruleId":"react/prop-types","severity":2,"message":"'cycle.stage' is missing in props validation","line":36,"column":58,"nodeType":"Identifier","messageId":"missingPropType","endLine":36,"endColumn":63},{"ruleId":"react/prop-types","severity":2,"message":"'cy