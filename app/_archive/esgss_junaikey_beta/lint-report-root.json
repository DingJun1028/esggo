ntity.types';\nimport { GeminiService, TaskComplexity } from '../../services/geminiService';\nimport { omniLogger, LogCategory } from '../../services/omniLogger';\n\n// 奧秘?脣?隢?(Omni Evolution Theory) - ?剖?憟抒儔協議撖虫? (Sentient v2.0)\n// Implements the specific logic for each of the Six Forms of Mystery.\n\nexport class OmniEvolution {\n  // 1. ? (Awakening) - ?交??甇亥??n  static awaken(input: string): { topic: string; rawTimestamp: string } {\n    const topic = input.length > 50 ? input.substring(0, 50) + '...' : input;\n    return {\n      topic,\n      rawTimestamp: new Date().toISOString(),\n    };\n  }\n\n  // 2. 閫?? (Analysis) - ??霅 (Powered by Gemini)\n  static async analyze(\n    input: string\n  ): Promise<{ intent: string; confidence: number; complexity: TaskComplexity }> {\n    // 蝪∪?誘敹恍??n    if (input.length < 10) {\n      return { intent: 'GENERAL_CHAT', confidence: 0.9, complexity: TaskComplexity.SIMPLE };\n    }\n\n    try {\n      // 瑽遣?? Prompt\n      const prompt = `Analyze the following user input and determine the intent and complexity.\nInput: \"${input}\"\nOutput JSON format: { \"intent\": \"string (e.g., SECURITY_SCAN, REPORT_GEN, GENERAL_QUERY)\", \"confidence\": number (0-1), \"complexity\": \"simple|moderate|complex\" }`;\n\n      // 瘜冽?嚗ㄐ?湔隤輻 GeminiService ?航??儐?唬?鞈湔??漲?血?嚗n      // 雿鈭祕??Sentient ?寞改??湔???舀?高品質?n      // ?典祕???Ｙ憓葉嚗遣霅圈? Nexus ?唳郊隢?嚗?甇方??箏?甇亦?敺芋撘n\n      // ??Gemini 銝?剁???啣??澆?\n      if (!GeminiService.checkAvailability()) {\n        return this.heuristicAnalysis(input);\n      }\n\n      // 雿輻 Gemini Generate (?ㄐ蝪∪?嚗?亦 generateStrategy 憿撮??撅方矽完整?游末嚗n      // 雿??隞亦 trick嚗??generateStrategy ????整合 GeminiService?n      // ?箔?銝耨??GeminiService 憭芸?嚗??ㄐ?急?璅⊥銝?矽?剁???閮?execute 階段???)\n      // *?望 GeminiService ?桀??芣?脖? generateStrategy嚗???賡?閬?鞈游??澆?+?摮?\n      // *????閮?analyze 階段銝餉??敹恍?憿?Strategy 階段? AI*\n\n      // *靽格迤蝑*嚗nalyze 靽?敹恍??撘?嚗trategy 階段??摨虫蝙??AI?n      // ?見?臭誑靽??踵??漲?n\n      return this.heuristicAnalysis(input);\n    } catch (error) {\n      omniLogger.warn(LogCategory.AI, 'Analysis phase failed, falling back to heuristics', {\n        error,\n      });\n      return { intent: 'GENERAL_QUERY', confidence: 0.5, complexity: TaskComplexity.SIMPLE };\n    }\n  }\n\n  private static heuristicAnalysis(input: string) {\n    const lowerInput = input.toLowerCase();\n    let intent = 'GENERAL_QUERY';\n    let confidence = 0.6;\n    let complexity = TaskComplexity.SIMPLE;\n\n    if (\n      lowerInput.includes('security') ||\n      lowerInput.includes('scan') ||\n      lowerInput.includes('瞍?')\n    ) {\n      intent = 'SECURITY_OPERATIONS';\n      confidence = 0.9;\n      complexity = TaskComplexity.COMPLEX;\n    } else if (\n      lowerInput.includes('report') ||\n      lowerInput.includes('esg') ||\n      lowerInput.includes('?勗?')\n    ) {\n      intent = 'ESG_REPORTING';\n      confidence = 0.9;\n      complexity = TaskComplexity.MODERATE;\n    } else if (lowerInput.includes('analyze') || lowerInput.includes('??')) {\n      intent = 'DEEP_ANALYSIS';\n      confidence = 0.8;\n      complexity = TaskComplexity.MODERATE;\n    }\n\n    return { intent, confidence, complexity };\n  }\n\n  // 3. ?梢陷 (Resonance) - 閮瑼Ｙ揣甈?設計\n  static calculateResonance(intent: string, memoryWeights: Record<string, number>): number {\n    return memoryWeights[intent] || 0.1;\n  }\n\n  // 4. 憟抒儔 (Strategy) - 蝑多元核心 (Powered by Gemini)\n  static async strategize(\n    intent: string,\n    input: string,\n    complexity: TaskComplexity\n  ): Promise<string[]> {\n    // 憒??舐陛?株?瘙??湔餈?\n    if (complexity === TaskComplexity.SIMPLE) {\n      return ['Direct Response'];\n    }\n\n    // 雿輻 Gemini 多元核心蝑\n    const strategy = await GeminiService.generateStrategy({\n      knowledgeNode: {\n        id: 'current-intent',\n        label: intent,\n        confidence: 0.9,\n        properties: { input },\n      },\n      complexity: complexity,\n      context: `User Input: ${input}\\nIntent: ${intent}\\nGenerate a list of strategic steps to handle this request.`,\n    });\n\n    if (strategy && strategy.content) {\n      // 蝪∪閫???批捆?箸郊撽?銵沔n      return [strategy.title, ...strategy.content.split('\\n').filter(l => l.trim().length > 0)];\n    }\n\n    return ['Standard Operating Procedure'];\n  }\n\n  // 5. ?賢? (Execution) - ?瑁??矽摨吒n  static async execute(intent: string, strategies: string[]): Promise<string> {\n    const strategyCount = strategies.length;\n\n    switch (intent) {\n      case 'SECURITY_OPERATIONS':\n        try {\n          // ??撠??亥矽??SnykService\n          const { SnykService } = await import('../../services/SnykService');\n          if (await SnykService.isReady()) {\n            const scanResult = await SnykService.quickScan();\n            if (scanResult) {\n              return `Security Protocol Executed. Snyk Scan detected ${scanResult.summary.total} issues (${scanResult.summary.critical} Critical). Report ID: ${scanResult.projectId}`;\n            }\n            return 'Security Protocol Executed. Scan completed but returned no data.';\n          }\n          return 'Security Protocol Initiated. (Simulation: Snyk Service not configured)';\n        } catch (e) {\n          return 'Security Protocol Failed. Fallback to defensive maneuvers.';\n        }\n\n      case 'ESG_REPORTING':\n        try {\n          const { reportingService } = await import('../../services/reportingService');\n          const report = await reportingService.generateReport({\n            period: 'Current Quarter',\n            language: 'zh-TW',\n            templateId: 'esg-standard',\n            aiEnhanced: true,\n          });\n          return `ESG Report Generated Successfully. Reliability Hash: ${report.integrityHash}. Status: ${report.status.toUpperCase()}.`;\n        } catch (e) {\n          return 'Report Generation Failed. Check system logs.';\n        }\n\n      default:\n        return `Executing ${intent} with ${strategyCount} strategic vectors. System Optimization ongoing.`;\n    }\n  }\n\n  // 6. ? (Evolution) - 蝬??潸?蝞n  static calculateExperience(currentLevel: number, taskComplexity: number): Promise<number> {\n    const baseXP = 10;\n    // 雿輻 Promise ??隞亦泵??鈭甇交???瘙?(Sentient Future-proofing)\n    return Promise.resolve(baseXP * taskComplexity * (1 + currentLevel * 0.1));\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\core\\OmniKey.test.ts","messages":[{"ruleId":null,"nodeType":null,"fatal":true,"severity":2,"message":"Parsing error: \"parserOptions.project\" has been provided for @typescript-eslint/parser.\nThe file was not found in any of the provided project(s): src\\omni\\core\\OmniKey.test.ts"}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":1,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { describe, it, expect, vi, beforeEach } from 'vitest';\nimport { OmniKey } from './OmniKey';\nimport { TaskComplexity } from '../../services/geminiService';\n\n// Mock dependencies\nvi.mock('../infrastructure/memory/OmniMemory', () => ({\n  useOmniMemory: {\n    getState: vi.fn(() => ({\n      setEvolutionPhase: vi.fn(),\n      addInteractionLog: vi.fn(),\n      palace: {\n        theVault: { conceptWeights: {} },\n        theLibrary: { domainRules: {} },\n      },\n      evolutionState: {\n        evolutionLevel: 1,\n        experiencePoints: 0,\n        currentPhase: 'IDLE',\n      },\n      reinforceConcept: vi.fn(),\n      updateEvolutionMetrics: vi.fn(),\n    })),\n  },\n}));\n\nvi.mock('../../services/geminiService', () => ({\n  GeminiService: {\n    checkAvailability: vi.fn(() => true),\n    generateStrategy: vi.fn(async () => ({\n      title: 'Mock Strategy',\n      content: 'Step 1: Analyze\\nStep 2: Remediation',\n      category: 'Mock',\n    })),\n  },\n  TaskComplexity: {\