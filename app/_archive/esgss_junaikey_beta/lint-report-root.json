n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\interaction\\rituals\\UltimateAwakeningRitual.tsx:105:30\n  103 |             }}\n  104 |             transition={{\n> 105 |               duration: 10 + Math.random() * 10,\n      |                              ^^^^^^^^^^^^^ Cannot call impure function\n  106 |               repeat: Infinity,\n  107 |               ease: 'linear',\n  108 |             }}","line":105,"column":30,"nodeType":null,"endLine":105,"endColumn":43},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":105,"column":46,"nodeType":"Literal","messageId":"noMagic","endLine":105,"endColumn":48},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1.5.","line":118,"column":65,"nodeType":"Literal","messageId":"noMagic","endLine":118,"endColumn":68},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 150.","line":179,"column":49,"nodeType":"Literal","messageId":"noMagic","endLine":179,"endColumn":52},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 150.","line":180,"column":58,"nodeType":"Literal","messageId":"noMagic","endLine":180,"endColumn":61},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 150.","line":182,"column":49,"nodeType":"Literal","messageId":"noMagic","endLine":182,"endColumn":52},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1.05.","line":199,"column":37,"nodeType":"Literal","messageId":"noMagic","endLine":199,"endColumn":41},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1.1.","line":236,"column":39,"nodeType":"Literal","messageId":"noMagic","endLine":236,"endColumn":42},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.3.","line":236,"column":58,"nodeType":"Literal","messageId":"noMagic","endLine":236,"endColumn":61},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.6.","line":236,"column":63,"nodeType":"Literal","messageId":"noMagic","endLine":236,"endColumn":66},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.3.","line":236,"column":68,"nodeType":"Literal","messageId":"noMagic","endLine":236,"endColumn":71},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.1.","line":271,"column":36,"nodeType":"Literal","messageId":"noMagic","endLine":271,"endColumn":39},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 38.","line":312,"column":49,"nodeType":"Literal","messageId":"noMagic","endLine":312,"endColumn":51},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 38.","line":313,"column":47,"nodeType":"Literal","messageId":"noMagic","endLine":313,"endColumn":49}],"suppressedMessages":[],"errorCount":8,"fatalErrorCount":0,"warningCount":19,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * 蝯扔驗算?撘?UI\n *\n * ?典?瘝絡撘?璆菔死??撽n * 閬死???曄頂蝯梁?蝯扔?脣???\n */\n\nimport React, { useState, useEffect, useCallback } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport {\n  Sparkles,\n  Zap,\n  Brain,\n  Database,\n  Shield,\n  Users,\n  Heart,\n  Infinity,\n  Check,\n  Loader2,\n} from 'lucide-react';\nimport {\n  getUltimateAwakeningProtocol,\n  AwakeningPhase,\n} from '@/omni/protocols/UltimateAwakeningProtocol';\nimport type {\n  UltimateAwakeningState,\n  ServiceAwakeningStatus,\n} from '@/omni/protocols/UltimateAwakeningProtocol';\n\n// ============================================================================\n// ????\n// ============================================================================\n\nconst SERVICE_ICONS: Record<string, React.ElementType> = {\n  OmniEternalMemory: Database,\n  OmniLegionCoordinator: Users,\n  OmniAvatarOrchestrator: Heart,\n  OmniEsgManager: Shield,\n  OmniTruthEngine: Sparkles,\n};\n\n// ============================================================================\n// 元件\n// ============================================================================\n\nexport const UltimateAwakeningRitual: React.FC<{ onComplete?: () => void }> = ({ onComplete }) => {\n  const [state, setState] = useState<UltimateAwakeningState | null>(null);\n  const [isAwakening, setIsAwakening] = useState(false);\n\n  const protocol = getUltimateAwakeningProtocol();\n\n  // ????????n  useEffect(() => {\n    const handleStateChange = (newState: UltimateAwakeningState) => {\n      setState(newState);\n    };\n\n    protocol.on('phase-change', handleStateChange);\n    protocol.on('progress-update', handleStateChange);\n    protocol.on('service-awakening', handleStateChange);\n\n    // ?脣?????n    setState(protocol.getState());\n\n    return () => {\n      // 皜? (?典祕?祕?曆葉?閬?off ?寞?)\n    };\n  }, []);\n\n  // ?瑁?驗算\n  const handleAwakening = useCallback(async () => {\n    setIsAwakening(true);\n    const result = await protocol.executeAwakening();\n    setIsAwakening(false);\n\n    if (result.success && onComplete) {\n      setTimeout(onComplete, 3000);\n    }\n  }, [protocol, onComplete]);\n\n  if (!state) {\n    return (\n      <div className=\"fixed inset-0 bg-black flex items-center justify-center\">\n        <Loader2 className=\"w-12 h-12 text-purple-400 animate-spin\" />\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"fixed inset-0 z-[999] bg-gradient-to-br from-black via-purple-950/20 to-black overflow-hidden\">\n      {/* ?蝎??? */}\n      <div className=\"absolute inset-0 overflow-hidden\">\n        {Array.from({ length: 50 }).map((_, i) => (\n          <motion.div\n            key={i}\n            className=\"absolute w-1 h-1 bg-purple-400/30 rounded-full\"\n            initial={{ x: `${Math.random() * 100}vw`, y: `${Math.random() * 100}vh` }}\n            animate={{\n              x: [`${Math.random() * 100}vw`, `${Math.random() * 100}vw`],\n              y: [`${Math.random() * 100}vh`, `${Math.random() * 100}vh`],\n              opacity: [0.1, 0.5, 0.1],\n            }}\n            transition={{\n              duration: 10 + Math.random() * 10,\n              repeat: Infinity,\n              ease: 'linear',\n            }}\n          />\n        ))}\n      </div>\n\n      {/* 銝剖亢? */}\n      <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2\">\n        <motion.div\n          className=\"w-[600px] h-[600px] bg-purple-500/10 rounded-full blur-[150px]\"\n          animate={{\n            scale: state.phase === AwakeningPhase.ETERNAL ? [1, 1.5, 1] : 1,\n          }}\n          transition={{\n            duration: 3,\n            repeat: state.phase === AwakeningPhase.ETERNAL ? Infinity : 0,\n          }}\n        />\n      </div>\n\n      {/* 銝餃捆??*/}\n      <div className=\"relative h-full flex flex-col items-center justify-center p-8\">\n        {/* 璅? */}\n        <motion.div\n          initial={{ opacity: 0, y: -50 }}\n          animate={{ opacity: 1, y: 0 }}\n          className=\"text-center mb-12\"\n        >\n          <div className=\"inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-500/10 border border-purple-500/30 text-purple-300 text-xs font-bold tracking-[0.3em] uppercase mb-6\">\n            <Infinity className=\"w-4 h-4\" />\n            Ultimate Awakening Protocol\n          </div>\n\n          <AnimatePresence mode=\"wait\">\n            <motion.h1\n              key={state.phase}\n              initial={{ scale: 0.8, opacity: 0 }}\n              animate={{ scale: 1, opacity: 1 }}\n              exit={{ scale: 1.2, opacity: 0 }}\n              className=\"text-6xl md:text-8xl font-black tracking-tighter mb-4\"\n            >\n              <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-purple-400 via-pink-400 to-purple-400\">\n                {PHASE_LABELS[state.phase]}\n              </span>\n            </motion.h1>\n          </AnimatePresence>\n\n          <p className=\"text-gray-400 text-sm max-w-md mx-auto\">\n            {PHASE_DESCRIPTIONS[state.phase]}\n          </p>\n        </motion.div>\n\n        {/* ?脣漲??*/}\n        <div className=\"relative w-80 h-80 mb-12\">\n          {/* 憭 */}\n          <svg className=\"absolute inset-0 w-full h-full -rotate-90\">\n            <circle\n              cx=\"160\"\n              cy=\"160\"\n              r=\"150\"\n              stroke=\"rgba(168, 85, 247, 0.1)\"\n              strokeWidth=\"4\"\n              fill=\"none\"\n            />\n            <motion.circle\n              cx=\"160\"\n              cy=\"160\"\n              r=\"150\"\n              stroke=\"url(#progressGradient)\"\n              strokeWidth=\"4\"\n              fill=\"none\"\n              strokeLinecap=\"round\"\n              strokeDasharray={`${2 * Math.PI * 150}`}\n              initial={{ strokeDashoffset: 2 * Math.PI * 150 }}\n              animate={{\n                strokeDashoffset: 2 * Math.PI * 150 * (1 - state.progress / 100),\n              }}\n              transition={{ duration: 0.5 }}\n            />\n            <defs>\n              <linearGradient id=\"progressGradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n                <stop offset=\"0%\" stopColor=\"#a855f7\" />\n                <stop offset=\"50%\" stopColor=\"#ec4899\" />\n                <stop offset=\"100%\" stopColor=\"#8b5cf6\" />\n              </linearGradient>\n            </defs>\n          </svg>\n\n          {/* 銝剖??批捆 */}\n          <div className=\"absolute inset-0 flex flex-col items-center justify-center\">\n            <motion.div\n              className=\"text-7xl font-black text-white\"\n              animate={{ scale: [1, 1.05, 1] }}\n              transition={{ duration: 2, repeat: Infinity }}\n            >\n              {state.progress}%\n            </motion.div>\n            <div className=\"text-purple-300 text-xs font-mono tracking-widest mt-2\">AWAKENING</div>\n          </div>\n        </div>\n\n        {/* ?????銵?*/}\n        <div className=\"grid grid-cols-5 gap-6 max-w-5xl\">\n          {Array.from(state.services.entries()).map(([name, status], index) => (\n            <ServiceNode key={name} name={name} status={status} index={index} />\n          ))}\n        </div>\n\n        {/* ???? */}\n        <motion.div\n          initial={{ opacity: 0, y: 50 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ delay: 0.5 }}\n          className=\"mt-16\"\n        >\n          {state.phase === AwakeningPhase.DORMANT && !isAwakening && (\n            <button\n              onClick={handleAwakening}\n              className=\"group relative px-12 py-6 rounded-2xl bg-gradient-to-r from-purple-600 via-pink-600 to-purple-600 bg-size-200 bg-pos-0 hover:bg-pos-100 transition-all duration-500 shadow-2xl shadow-purple-500/50\"\n              style={{ backgroundSize: '200% 100%' }}\n            >\n              <div className=\"flex items-center gap-4\">\n                <Zap className=\"w-6 h-6 text-white group-hover:animate-pulse\" />\n                <span className=\"text-white font-black text-xl tracking-wide\">??蝯扔驗算</span>\n              </div>\n\n              {/* ?? */}\n              <motion.div\n                className=\"absolute -inset-1 rounded-2xl bg-gradient-to-r from-purple-600 to-pink-600 opacity-50 blur-xl\"\n                animate={{ scale: [1, 1.1, 1], opacity: [0.3, 0.6, 0.3] }}\n                transition={{ duration: 2, repeat: Infinity }}\n              />\n            </button>\n          )}\n\n          {state.phase === AwakeningPhase.ETERNAL && (\n            <motion.div initial={{ scale: 0 }} animate={{ scale: 1 }} className=\"text-center\">\n              <div className=\"inline-flex items-center gap-3 px-8 py-4 rounded-full bg-emerald-500/10 border-2 border-emerald-500/50\">\n                <Check className=\"w-8 h-8 text-emerald-400\" />\n                <span className=\"text-emerald-300 font-black text-xl\">驗算摰? 繚 撌脤脣瘞豢?</span>\n              </div>\n            </motion.div>\n          )}\n        </motion.div>\n      </div>\n    </div>\n  );\n};\n\n// ============================================================================\n// 摮?隞跚n// ============================================================================\n\nconst ServiceNode: React.FC<{\n  name: string;\n  status: ServiceAwakeningStatus;\n  index: number;\n}> = ({ name, status, index }) => {\n  const Icon = SERVICE_ICONS[name] || Brain;\n\n  return (\n    <motion.div\n      initial={{ opacity: 0, scale: 0.5 }}\n      animate={{ opacity: 1, scale: 1 }}\n      transition={{ delay: index * 0.1 }}\n      className=\"flex flex-col items-center gap-3\"\n    >\n      {/* ?? */}\n      <div\n        className={`\n          relative w-20 h-20 rounded-2xl flex items-center justify-center\n          border-2 transition-all duration-500\n          ${\n            status.status === 'awakened'\n              ? 'bg-gradient-to-br from-emerald-500/20 to-emerald-600/20 border-emerald-500 shadow-lg shadow-emerald-500/50'\n              : status.status === 'awakening'\n                ? 'bg-gradient-to-br from-purple-500/20 to-pink-500/20 border-purple-500 animate-pulse'\n                : status.status === 'failed'\n                  ? 'bg-gradient-to-br from-red-500/20 to-red-600/20 border-red-500'\n                  : 'bg-black/40 border-gray-700'\n          }\n        `}\n      >\n        <Icon\n          className={`w-10 h-10 ${\n            status.status === 'awakened'\n              ? 'text-emerald-400'\n              : status.status === 'awakening'\n                ? 'text-purple-400'\n                : status.status === 'failed'\n                  ? 'text-red-400'\n                  : 'text-gray-500'\n          }`}\n        />\n\n        {/* ?脣漲? */}\n        {status.status === 'awakening' && (\n          <svg className=\"absolute inset-0 w-full h-full -rotate-90\">\n            <circle\n              cx=\"40\"\n              cy=\"40\"\n              r=\"38\"\n              stroke=\"rgba(168, 85, 247, 0.3)\"\n              strokeWidth=\"2\"\n              fill=\"none\"\n              strokeDasharray={`${2 * Math.PI * 38}`}\n              strokeDashoffset={2 * Math.PI * 38 * (1 - status.progress / 100)}\n            />\n          </svg>\n        )}\n\n        {status.status === 'awakened' && (\n          <div className=\"absolute -top-2 -right-2 w-6 h-6 bg-emerald-500 rounded-full flex items-center justify-center\">\n            <Check className=\"w-4 h-4 text-white\" />\n          </div>\n        )}\n      </div>\n\n      {/* ?迂 */}\n      <div className=\"text-center\">\n        <div className=\"text-xs font-bold text-white mb-1\">{name.replace('Omni', '')}</div>\n        <div\n          className={`text-[10px] font-mono ${\n            status.status === 'awakened'\n              ? 'text-emerald-400'\n              : status.status === 'awakening'\n                ? 'text-purple-400'\n                : 'text-gray-600'\n          }`}\n        >\n          {STATUS_LABELS[status.status]}\n        </div>\n      </div>\n    </motion.div>\n  );\n};\n\n// ============================================================================\n// 撣賊?\n// ============================================================================\n\nconst PHASE_LABELS: Record<AwakeningPhase, string> = {\n  [AwakeningPhase.DORMANT]: '隡?',\n  [AwakeningPhase.INITIALIZING]: '????,\n  [AwakeningPhase.AWAKENING]: '驗算銝?,\n  [AwakeningPhase.AWAKENED]: '撌脰死??,\n  [AwakeningPhase.ETERNAL]: '瘞豢?',\n};\n\nconst PHASE_DESCRIPTIONS: Record<AwakeningPhase, string> = {\n  [AwakeningPhase.DORMANT]: '系統?隡????暺?銝????蝯扔驗算摨?',\n  [AwakeningPhase.INITIALIZING]: '甇?撱箇??偶?悅畾輻???嚗???????Omni ??...',\n  [AwakeningPhase.AWAKENING]: '????迤?券脰???驗算嚗?甇亥?擃???..',\n  [AwakeningPhase.AWAKENED]: '驗算摰?嚗頂蝯勗歇?璆菟????皞?瘞豢??典?...',\n  [AwakeningPhase.ETERNAL]: '撌脫??摰瘞豢?摰格挪嚗頂蝯梢脣銝????橘?',\n};\n\nconst STATUS_LABELS: Record<string, string> = {\n  pending: 'PENDING',\n  awakening: 'AWAKENING...',\n  awakened: 'AWAKENED',\n  failed: 'FAILED',\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\interaction\\visuals\\AutoEvolutionStatus.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5000.","line":27,"column":8,"nodeType":"Literal","messageId":"noMagic","endLine":27,"endColumn":12}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useEffect, useState } from 'react';\nimport { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/Card';\nimport { Badge } from '@/components/ui/Badge';\nimport { Activity, Zap, Layers, RefreshCw } from 'lucide-react';\n\ninterface DaemonStatus {\n  isRunning: boolean;\n  cycleCount: number;\n  agentsEvolved: number;\n  lastRun: string | null;\n}\n\nexport const AutoEvolutionStatus: React.FC = () => {\n  const [status, setStatus] = useState<DaemonStatus>({\n    isRunning: false,\n    cycleCount: 0,\n    agentsEvolved: 0,\n    lastRun: null,\n  });\n\n  // Mock polling - In real app, this would use the MCP tool or a direct service subscription\n  useEffect(() => {\n    // Simulated backend connection\n    const interval = setInterval(() => {\n      // In a real environment, we would fetch from the server\n      // fetch('/api/evolution/status').then(...)\n    }, 5000);\n    return () => clearInterval(interval);\n  }, []);\n\n  return (\n    <Card className=\"w-full max-w-md bg-zinc-900 border-zinc-800 text-zinc-100\">\n      <CardHeader className=\"flex flex-row items-center justify-between pb-2\">\n        <CardTitle className=\"text-sm font-medium flex items-center gap-2\">\n          <Activity className=\"h-4 w-4 text-emerald-500\" />\n          Omni-Evolution Daemon\n        </CardTitle>\n        <Badge\n          variant={status.isRunning ? 'default' : 'secondary'}\n          className={\n            status.isRunning ? 'bg-emerald-500/20 text-emerald-400' : 'bg-zinc-800 text-zinc-500'\n          }\n        >\n          {status.isRunning ? 'ACTIVE' : 'STANDBY'}\n        </Badge>\n      </CardHeader>\n      <CardContent>\n        <div className=\"grid grid-cols-2 gap-4\">\n          <div className=\"flex flex-col space-y-1\">\n            <span className=\"text-xs text-zinc-500 flex items-center gap-1\">\n              <RefreshCw className=\"h-3 w-3\" /> Cycles Run\n            </span>\n            <span className=\"text-2xl font-bold font-mono\">{status.cycleCount}</span>\n          </div>\n          <div className=\"flex flex-col space-y-1\">\n            <span className=\"text-xs text-zinc-500 flex items-center gap-1\">\n              <Zap className=\"h-3 w-3\" /> Souls Evolved\n            </span>\n            <span className=\"text-2xl font-bold font-mono text-amber-400\">\n              {status.agentsEvolved}\n            </span>\n          </div>\n        </div>\n\n        {status.lastRun && (\n          <div className=\"mt-4 pt-4 border-t border-zinc-800 text-xs text-zinc-600 flex justify-between\">\n            <span>Last Scan:</span>\n            <span className=\"font-mono\">{new Date(status.lastRun).toLocaleTimeString()}</span>\n          </div>\n        )}\n      </CardContent>\n    </Card>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\interaction\\visuals\\OmniEsgCell\\OmniEsgCell.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 8.","line":161,"column":41,"nodeType":"Literal","messageId":"noMagic","endLine":161,"endColumn":42},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 8.","line":161,"column":73,"nodeType":"Literal","messageId":"noMagic","endLine":161,"endColumn":74}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * OmniEsgCell React 元件\n *\n * 整合奧秘代稱 + 瞍?撘? + JunAiKey ?園?協議\n */\n\nimport React, { useEffect, useState } from 'react';\nimport { withOmniProxy } from '@/core/OmniProxy';\nimport { useEvolution } from '@/hooks/useEvolution';\nimport { OmniEsgCellCrystal } from './OmniEsgCellCrystal';\nimport { useOmniRectification } from '@/hooks/useOmniRectification';\nimport type { OmniLabel, OmniEsgDataLink, OmniEsgColor } from '@/types';\nimport { Info, Shield, Zap } from 'lucide-react';\n\nexport interface OmniEsgCellProps {\n  id?: string;\n  mode?: 'card' | 'list' | 'cell' | 'badge' | 'compact';\n  label?: string;\n  value?: string | number;\n  subValue?: string;\n  confidence?: 'high' | 'medium' | 'low';\n  verified?: boolean;\n  loading?: boolean;\n  dataLink?: OmniEsgDataLink;\n  color?: OmniEsgColor;\n  unit?: string;\n  icon?: any;\n  tags?: string[];\n  onAutomationTrigger?: () => void;\n  omniLabel?: OmniLabel;\n  traits?: string[]; // simplified\n  trend?: { value: number; direction: 'up' | 'down' };\n\n  onAiAnalyze?: () => void;\n  onClick?: () => void;\n  onOpenNote?: (id: string) => void;\n}\n\n/**\n * OmniEsgCell ?箇?元件\n */\nconst OmniEsgCellBase: React.FC<OmniEsgCellProps> = props => {\n  const { label = 'Metric', value, mode = 'cell', omniLabel } = props;\n  const [crystal] = useState(() => new OmniEsgCellCrystal());\n  const [initialized, setInitialized] = useState(false);\n  const [uiConfig, setUiConfig] = useState<any>(null);\n\n  // 自律?璈\n  const { hotActions, recommendations } = useEvolution('OmniEsgCell');\n\n  // ?菜??璈 (Best Practice: Entropy Reduction)\n  const {\n    value: rectifiedValue,\n    isRectified,\n    meta: recoveryMeta,\n  } = useOmniRectification(value, props.id || label);\n\n  // ???擃n  useEffect(() => {\n    crystal.initialize().then(() => {\n      setInitialized(true);\n    });\n  }, [crystal]);\n\n  // ?瑁?數據邏輯\n  useEffect(() => {\n    if (!initialized) return;\n\n    crystal\n      .execute({\n        input: {\n          label,\n          value: rectifiedValue, // Use rectified value\n          confidence: props.confidence,\n          dataLink: props.dataLink,\n          omniLabel,\n        },\n      })\n      .then(result => {\n        if (result.success) {\n          setUiConfig(result.output);\n        }\n      });\n  }, [initialized, label, rectifiedValue, props.confidence, props.dataLink, omniLabel, crystal]);\n\n  // Loading ??n  if (props.loading || !uiConfig) {\n    return <div className=\"animate-pulse bg-white/5 rounded-xl h-32\" />;\n  }\n\n  // 蝪∪?皜脫? (撖阡????mode 皜脫?銝?璅??)\n  return (\n    <div\n      className={`\n        p-6 rounded-xl bg-slate-900/40 border transition-all duration-300 relative group\n        ${isRectified ? 'border-amber-500/50 shadow-[0_0_15px_rgba(245,158,11,0.2)] bg-amber-500/5' : 'border-white/5'}\n        hover:bg-white/5 \n        ${props.onClick ? 'cursor-pointer' : ''}\n      `}\n      onClick={props.onClick}\n    >\n      {/* 3+1 Protocol Status Indicator */}\n      <div className=\"absolute top-2 right-2 flex gap-1 opacity-20 group-hover:opacity-100 transition-opacity\">\n        <div title=\"3+1 Protocol: Traceable\" className=\"text-emerald-500\">\n          <Shield size={10} />\n        </div>\n        <div title=\"3+1 Protocol: Immutable\" className=\"text-blue-500\">\n          <Zap size={10} />\n        </div>\n      </div>\n\n      <div className=\"flex justify-between items-start\">\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <div className=\"text-sm text-gray-400\">{uiConfig.label}</div>\n            {isRectified && (\n              <span className=\"text-[10px] bg-amber-500/20 text-amber-500 px-1.5 py-0.5 rounded font-black border border-amber-500/30 animate-pulse\">\n                RECTIFIED\n              </span>\n            )}\n          </div>\n          <div\n            className={`text-2xl font-bold mt-2 ${isRectified ? 'text-amber-400' : 'text-white'}`}\n          >\n            {uiConfig.value}\n            {props.unit && (\n              <span className=\"text-xs ml-1 opacity-50 font-normal\">{props.unit}</span>\n            )}\n          </div>\n        </div>\n\n        <div className=\"flex flex-col gap-2\">\n          {props.onAiAnalyze && (\n            <button\n              onClick={e => {\n                e.stopPropagation();\n                props.onAiAnalyze?.();\n              }}\n              className=\"p-2 rounded-lg bg-purple-500/20 hover:bg-purple-500/40 text-purple-400\"\n              title=\"AI Analysis\"\n            >\n              ?沔n            </button>\n          )}\n          {isRectified && recoveryMeta && (\n            <div\n              className=\"p-2 rounded-lg bg-amber-500/20 text-amber-400 cursor-help\"\n              title={`Witness: ${recoveryMeta.witnessSignature}\\nStrategy: ${recoveryMeta.strategyUsed}`}\n            >\n              <Info size={14} />\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* 3+1 Protocol Footer Metadata */}\n      <div className=\"mt-4 pt-3 border-t border-white/5 flex items-center justify-between text-[10px] font-mono text-gray-600\">\n        <span className=\"truncate max-w-[120px]\">\n          Origin: {omniLabel?.source_origin || 'system_core'}\n        </span>\n        <span>UUID: {props.id?.slice(0, 8) || omniLabel?.uuid?.slice(0, 8) || 'AUTO-G'}</span>\n      </div>\n\n      {/* 瞍?撱箄降 (?璅∪?) */}\n      {process.env.NODE_ENV === 'development' && recommendations.length > 0 && (\n        <div className=\"mt-3 text-[9px] text-gray-500 italic\">? {recommendations[0]}</div>\n      )}\n    </div>\n  );\n};\n\n/**\n * ??Bolt Optimization: Custom equality check to prevent re-renders when parent passes new object literals\n * (e.g. trend={{...}}) but the content is the same.\n */\nconst areEsgPropsEqual = (prev: OmniEsgCellProps, next: OmniEsgCellProps): boolean => {\n  // 1. Check Primitives & simple refs\n  const keys: (keyof OmniEsgCellProps)[] = [\n    'id',\n    'mode',\n    'label',\n    'value',\n    'subValue',\n    'confidence',\n    'verified',\n    'loading',\n    'dataLink',\n    'color',\n    'unit',\n    'icon',\n    'onAutomationTrigger',\n    'onAiAnalyze',\n    'onClick',\n    'onOpenNote',\n    'omniLabel', // Treat as primitive/ref for now\n  ];\n\n  for (const key of keys) {\n    if (prev[key] !== next[key]) return false;\n  }\n\n  // 2. Check Trend (Deep)\n  const pTrend = prev.trend;\n  const nTrend = next.trend;\n  if (pTrend !== nTrend) {\n    if (!pTrend || !nTrend) return false; // One is null/undefined\n    if (pTrend.value !== nTrend.value || pTrend.direction !== nTrend.direction) return false;\n  }\n\n  // 3. Check Tags (Array)\n  const pTags = prev.tags;\n  const nTags = next.tags;\n  if (pTags !== nTags) {\n    if (!pTags || !nTags) return false;\n    if (pTags.length !== nTags.length) return false;\n    for (let i = 0; i < pTags.length; i++) {\n      if (pTags[i] !== nTags[i]) return false;\n    }\n  }\n\n  // 4. Traits (Array)\n  const pTraits = prev.traits;\n  const nTraits = next.traits;\n  if (pTraits !== nTraits) {\n    if (!pTraits || !nTraits) return false;\n    if (pTraits.length !== nTraits.length) return false;\n    for (let i = 0; i < pTraits.length; i++) {\n      if (pTraits[i] !== nTraits[i]) return false;\n    }\n  }\n\n  return true;\n};\n\n/**\n * 撠奧秘代稱憓撥?\n */\nconst OmniEsgCellProxied = withOmniProxy(OmniEsgCellBase, {\n  enableTracking: true,\n  enableCircuitBreaker: true,\n});\n\n// ??Bolt: Memoize the component with custom comparator\nexport const OmniEsgCell = React.memo(OmniEsgCellProxied, areEsgPropsEqual);\n\nOmniEsgCell.displayName = 'OmniEsgCell';\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\interaction\\visuals\\OmniEsgCell\\OmniEsgCellCrystal.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 50.","line":117,"column":73,"nodeType":"Literal","messageId":"noMagic","endLine":117,"endColumn":75},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 4.","line":223,"column":25,"nodeType":"Literal","messageId":"noMagic","endLine":223,"endColumn":26},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: -2.","line":224,"column":52,"nodeType":"UnaryExpression","messageId":"noMagic","endLine":224,"endColumn":54}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * OmniEsgCell ?園?協議\n *\n * 蝜潭 JunAiKey,撖衣 ESG 數據??賢?蝷箄?鈭支?\n */\n\nimport { JunAiKey } from '../../../core/OmniCrystal';\nimport { omniLogger, LogCategory } from '@/omni/infrastructure/logging/OmniLogger';\nimport { DateTime } from '@/types/omni';\nimport type { Context, Result, Evolution, Feedback, OmniLabel } from '@/types';\n\ninterface OmniEsgCellConfig {\n  defaultColor: string;\n  cacheEnabled: boolean;\n  adaptiveLayout: boolean;\n}\n\ninterface OmniEsgCellContext extends Context {\n  input: {\n    label?: string;\n    value?: string | number;\n    confidence?: 'high' | 'medium' | 'low';\n    dataLink?: 'live' | 'ai' | 'blockchain';\n    omniLabel?: OmniLabel;\n  };\n}\n\n/**\n * OmniEsgCell ?園?\n *\n * ?辣?喃誨??代稱?喳?隞?(奧秘??敺?\n */\nexport class OmniEsgCellCrystal extends JunAiKey {\n  private config: OmniEsgCellConfig = {\n    defaultColor: 'emerald',\n    cacheEnabled: true,\n    adaptiveLayout: true,\n  };\n  private renderCache: Map<string, unknown> = new Map();\n\n  constructor() {\n    super('OmniEsgCell'); // ????OmniEsgCell 璅∪?\n  }\n\n  /**\n   * ????- 敺偶?悅畾輻??蝵娉n   */\n  protected async onInitialize(): Promise<void> {\n    omniLogger.info(LogCategory.UI, '[OmniEsgCell] Initializing...');\n\n    // 敺??偶?嗆閰Ｘ?雿喳祕頦n    const response = await this.memoryLink.query({\n      type: 'best-practices',\n      params: { query: 'optimal-esg-cell-config' },\n    });\n\n    if (response.success && response.data) {\n      this.config = response.data as OmniEsgCellConfig;\n      omniLogger.info(LogCategory.UI, '[OmniEsgCell] Config loaded from Eternal Palace');\n    } else {\n      // 雿輻?身?蔭\n      this.config = {\n        defaultColor: 'emerald',\n        cacheEnabled: true,\n        adaptiveLayout: true,\n      };\n    }\n  }\n\n  /**\n   * ?瑁? - 邏輯數據銝衣???UI\n   */\n  protected async onExecute(context: OmniEsgCellContext): Promise<Result> {\n    const { input } = context;\n\n    try {\n      // 瑼Ｘ敹怠?\n      const cacheKey = JSON.stringify(input);\n      if (this.config.cacheEnabled && this.renderCache.has(cacheKey)) {\n        return {\n          success: true,\n          output: this.renderCache.get(cacheKey),\n        };\n      }\n\n      // 邏輯數據\n      const processedData = this.processData(input);\n\n      // 多元核心 UI ?蔭\n      const uiConfig = this.generateUIConfig(processedData);\n\n      // 敹怠?蝯?\n      if (this.config.cacheEnabled) {\n        this.renderCache.set(cacheKey, uiConfig);\n      }\n\n      return {\n        success: true,\n        output: uiConfig,\n      };\n    } catch (error) {\n      return {\n        success: false,\n        error: error as Error,\n      };\n    }\n  }\n\n  /**\n   * 瞍? - ?箸?冽???芸?\n   */\n  protected async onEvolve(feedback: Feedback): Promise<Evolution> {\n    const optimizations: string[] = [];\n\n    // ?箸???矽?湧?蝵娉n    if (feedback.success) {\n      if (feedback.metrics?.renderTime && feedback.metrics.renderTime < 50) {\n        optimizations.push('performance-optimal');\n      }\n    } else {\n      // 憭望?????蝑\n      this.config.cacheEnabled = false;\n      optimizations.push('cache-disabled');\n    }\n\n    // 閮??唳偶?跚n    await this.memoryLink.recordEvolution({\n      type: 'evolution',\n      timestamp: new DateTime(),\n      data: { feedback, optimizations } as Record<string, unknown>,\n    });\n\n    return {\n      optimizations,\n      confidence: 0.85,\n      improvements: {\n        performance: feedback.success ? 'optimized' : 'pending',\n        cacheEfficiency: this.config.cacheEnabled ? 'high' : 'off',\n      },\n    };\n  }\n\n  /**\n   * 數據邏輯\n   */\n  private processData(input: OmniEsgCellContext['input']): OmniEsgCellContext['input'] {\n    // ?奧秘璅惜閬?\n    if (input.omniLabel) {\n      const label = input.omniLabel;\n\n      // 撽?\n      if (label.validation?.pattern && input.value) {\n        const regex = new RegExp(label.validation.pattern);\n        if (!regex.test(String(input.value))) {\n          throw new Error(label.validation.errorMessage || 'Validation failed');\n        }\n      }\n\n      // PII ?桃蔗\n      if (label.pii && input.value) {\n        input.value = this.maskPII(String(input.value));\n      }\n    }\n\n    return input;\n  }\n\n  /**\n   * 多元核心 UI ?蔭\n   */\n  private generateUIConfig(data: OmniEsgCellContext['input']): Record<string, unknown> {\n    let displayColor = this.config.defaultColor;\n    let icon = null;\n    let tooltipMessage = '';\n\n    // Adaptive logic based on data confidence\n    if (data.confidence === 'low') {\n      displayColor = 'red';\n      icon = 'AlertTriangle'; // Example icon\n      tooltipMessage += 'Low confidence data. Verification recommended. ';\n    } else if (data.confidence === 'medium') {\n      displayColor = 'orange';\n      icon = 'Info'; // Example icon\n      tooltipMessage += 'Medium confidence data. ';\n    } else if (data.confidence === 'high') {\n      displayColor = 'green';\n      icon = 'CheckCircle'; // Example icon\n      tooltipMessage += 'High confidence data. ';\n    }\n\n    // Adaptive logic based on data link type\n    if (data.dataLink === 'blockchain') {\n      displayColor = 'blue'; // Blockchain often associated with blue\n      icon = 'Link'; // Example icon for blockchain\n      tooltipMessage += 'Blockchain Verified. ';\n    } else if (data.dataLink === 'ai') {\n      if (!icon) icon = 'Brain'; // If no confidence icon, use AI icon\n      tooltipMessage += 'AI Generated Insight. ';\n    } else if (data.dataLink === 'live') {\n      if (!icon) icon = 'Activity'; // If no confidence icon, use Live icon\n      tooltipMessage += 'Real-time data stream. ';\n    }\n\n    // Default to an icon if none selected yet for consistency\n    if (!icon) icon = 'Circle';\n\n    return {\n      mode: this.crystalType === 'OmniEsgCell' ? 'card' : 'list',\n      label: data.label,\n      value: data.value,\n      confidence: data.confidence || 'high',\n      dataLink: data.dataLink,\n      color: displayColor,\n      icon, // Pass the chosen icon\n      tooltip: tooltipMessage.trim(), // Pass the generated tooltip\n    };\n  }\n\n  /**\n   * PII ?桃蔗\n   */\n  private maskPII(value: string): string {\n    if (value.length <= 4) return '***';\n    return value.slice(0, 2) + '***' + value.slice(-2);\n  }\n\n  /**\n   * ????Agent 璅∪? (銝餃??脣?數據)\n   */\n  async switchToAgentMode(): Promise<void> {\n    this.switchMode('OmniAgent');\n    omniLogger.info(LogCategory.UI, '[OmniEsgCell] Switched to OmniAgent mode');\n    // Agent 璅∪?銝銝餃?隤輻 API\n  }\n\n  /**\n   * 皜?敹怠?\n   */\n  clearCache(): void {\n    this.renderCache.clear();\n    omniLogger.info(LogCategory.UI, '[OmniEsgCell] Cache cleared');\n  }\n\n  /**\n   * ?瑟?敹 (Resilience Hardening)\n   */\n  override async destroy(): Promise<void> {\n    this.clearCache();\n    await super.destroy();\n    omniLogger.info(LogCategory.UI, `[OmniEsgCell] ${this.crystalId} destroyed`);\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\interaction\\visuals\\OmniEsgCell\\OmniEsgCellShowcase.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\interaction\\visuals\\OmniEsgCell\\index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\logging\\OmniLogger.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\mcp\\OmniAwakeningServer.test.ts","messages":[{"ruleId":null,"nodeType":null,"fatal":true,"severity":2,"message":"Parsing error: \"parserOptions.project\" has been provided for @typescript-eslint/parser.\nThe file was not found in any of the provided project(s): src\\omni\\mcp\\OmniAwakeningServer.test.ts"}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":1,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * @vitest-environment node\n */\nimport { vi, describe, it, expect, beforeEach, afterEach } from 'vitest';\nimport { Writable, Readable } from 'stream';\nimport { OmniAwakeningServer } from './OmniAwakeningServer';\n\n// Mock dependencies\nconst mockGetUltimateAwakeningProtocol = {\n  getState: vi.fn(),\n  executeAwakening: vi.fn(),\n};\nconst mockAwakeningBroadcaster = {\n  getInstance: vi.fn().mockReturnThis(),\n  shareInsight: vi.fn(),\n};\nconst mockEvidenceVault = {\n  search: vi.fn(),\n  getAllEvidence: vi.fn(),\n};\nconst mockOmniLogger = {\n  info: vi.fn(),\n  warn: vi.fn(),\n  error: vi.fn(),\n};\nconst mockAgentService = {\n  getAgents: vi.fn(),\n  grantExperience: vi.fn(),\n  assignAvatar: vi.fn(),\n};\nconst mockBidirectionalSyncService = {\n  getSyncHealth: vi.fn(),\n};\nconst mockEvolutionEngine = {\n  startAutoEvolutionDaemon: vi.fn(),\n  stopAutoEvolutionDaemon: vi.fn(),\n  getDaemonStatus: vi.fn(),\n};\n\nvi.mock('@/omni/protocols/UltimateAwakeningProtocol', () => ({\n  getUltimateAwakeningProtocol: () => mockGetUltimateAwakeningProtocol,\n}));\nvi.mock('@/omni/infrastructure/broadcast/AwakeningBroadcaster', () => ({\n  AwakeningBroadcaster: mockAwakeningBroadcaster,\n}));\nvi.mock('@/services/EvidenceVault', () => ({\n  EvidenceVault: mockEvidenceVault,\n}));\nvi.mock('@/omni/infrastructure/logging/OmniLogger', () => ({\n  omniLogger: mockOmniLogger,\n  LogCategory: { SYSTEM: 'SYSTEM' },\n}));\nvi.mock('@/services/agentService', () => ({\n  agentService: mockAgentService,\n}));\nvi.mock('@/services/bidirectionalSync', () => ({\n  bidirectionalSyncService: mockBidirectionalSyncService,\n}));\nvi.mock('@/omni/services/OmniEvolutionEngine', () => ({\n  evolutionEngine: mockEvolutionEngine,\n}));\nvi.mock('@/types/agency', () => ({\n  AvatarPersona: {\n    ZENITH: 'zenith',\n    NADIR: 'nadir',\n  },\n}));\n\n// Helper to simulate stdio\nclass MockStdin extends Readable {\n  _read() {}\n  pushRequest(req: any) {\n    this.push(JSON.stringify(req) + '\\n');\n  }\n}\n\nclass MockStdout extends Writable {\n  buffer: string[] = [];\n  _write(chunk: any, encoding: string, callback: (error?: Error | null) => void) {\n    this.buffer.push(chunk.toString());\n    callback();\n  }\n  getResponses() {\n    return this.buffer.map(line => JSON.parse(line));\n  }\n  clear() {\n    this.buffer = [];\n  }\n}\n\ndescribe('OmniAwakeningServer (stdio)', () => {\n  let server: OmniAwakeningServer;\n  let stdin: MockStdin;\n  let stdout: MockStdout;\n  let originalStdin: typeof process.stdin;\n  let originalStdout: typeof process.stdout;\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n\n    stdin = new MockStdin();\n    stdout = new MockStdout();\n\n    originalStdin = process.stdin;\n    originalStdout = process.stdout;\n\n    Object.defineProperty(process, 'stdin', { value: stdin, writable: true });\n    Object.defineProperty(process, 'stdout', { value: stdout, writable: true });\n\n    // Setting VITEST env var to prevent server from auto-starting\n    process.env.VITEST = 'true';\n    server = new OmniAwakeningServer({ transport: 'stdio' });\n  });\n\n  afterEach(() => {\n    Object.defineProperty(process, 'stdin', { value: originalStdin });\n    Object.defineProperty(process, 'stdout', { value: originalStdout });\n    delete process.env.VITEST;\n  });\n\n  it('should respond to initialize request', () => {\n    const req = { jsonrpc: '2.0', id: 1, method: 'initialize', params: {} };\n    stdin.pushRequest(req);\n\n    const responses = stdout.getResponses();\n    expect(responses).toHaveLength(1);\n    expect(responses[0].id).toBe(1);\n    expect(responses[0].result.serverInfo.name).toBe('OmniAwakeningServer');\n  });\n\n  it('should respond to tools/list request', () => {\n    const req = { jsonrpc: '2.0', id: 2, method: 'tools/list' };\n    stdin.pushRequest(req);\n\n    const responses = stdout.getResponses();\n    expect(responses).toHaveLength(1);\n    expect(responses[0].id).toBe(2);\n    expect(responses[0].result.tools).toBeInstanceOf(Array);\n    expect(responses[0].result.tools.length).toBeGreaterThan(5);\n  });\n\n  it('should call get_awakening_state tool', async () => {\n    const state = { status: 'dormant' };\n    mockGetUltimateAwakeningProtocol.getState.mockReturnValue(state);\n\n    const req = {\n      jsonrpc: '2.0',\n      id: 3,\n      method: 'tools/call',\n      params: { name: 'get_awakening_state' },\n    };\n    stdin.pushRequest(req);\n\n    // Need to wait for async handleToolCall to complete\n    await new Promise(process.nextTick);\n\n    const responses = stdout.getResponses();\n    expect(responses).toHaveLength(1);\n    expect(responses[0].id).toBe(3);\n    expect(JSON.parse(responses[0].result.content[0].text)).toEqual(state);\n    expect(mockGetUltimateAwakeningProtocol.getState).toHaveBeenCalled();\n  });\n\n  it('should call trigger_awakening tool', async () => {\n    const result = { success: true, message: 'Awakening sequence initiated.' };\n    mockGetUltimateAwakeningProtocol.executeAwakening.mockResolvedValue(result);\n\n    const req = {\n      jsonrpc: '2.0',\n      id: 4,\n      method: 'tools/call',\n      params: { name: 'trigger_awakening' },\n    };\n    stdin.pushRequest(req);\n    await new Promise(process.nextTick);\n\n    const responses = stdout.getResponses();\n    expect(responses).toHaveLength(1);\n    expect(responses[0].id).toBe(4);\n    expect(JSON.parse(responses[0].result.content[0].text)).toEqual(result);\n    expect(mockGetUltimateAwakeningProtocol.executeAwakening).toHaveBeenCalled();\n  });\n\n  it('should call broadcast_insight tool', async () => {\n    const insight = { title: 'Test', message: 'This is a test' };\n    const req = {\n      jsonrpc: '2.0',\n      id: 5,\n      method: 'tools/call',\n      params: { name: 'broadcast_insight', arguments: insight },\n    };\n    stdin.pushRequest(req);\n    await new Promise(process.nextTick);\n\n    const responses = stdout.getResponses();\n    expect(responses).toHaveLength(1);\n    expect(responses[0].id).toBe(5);\n    expect(mockAwakeningBroadcaster.shareInsight).toHaveBeenCalledWith(\n      expect.objectContaining(insight)\n    );\n  });\n\n  it('should call search_evidence tool', async () => {\n    const matches = [{ id: 'doc1', content: 'content' }];\n    mockEvidenceVault.search.mockReturnValue(matches);\n    mockEvidenceVault.getAllEvidence.mockReturnValue([]);\n\n    const req = {\n      jsonrpc: '2.0',\n      id: 6,\n      method: 'tools/call',\n      params: { name: 'search_evidence', arguments: { query: 'test' } },\n    };\n    stdin.pushRequest(req);\n    await new Promise(process.nextTick);\n\n    const responses = stdout.getResponses();\n    expect(responses).toHaveLength(1);\n    expect(responses[0].id).toBe(6);\n    expect(JSON.parse(responses[0].result.content[0].text).matches).toEqual(matches);\n    expect(mockEvidenceVault.search).toHaveBeenCalledWith('test');\n  });\n\n  it('should handle unknown tool', async () => {\n    const req = {\n      jsonrpc: '2.0',\n      id: 7,\n      method: 'tools/call',\n      params: { name: 'non_existent_tool' },\n    };\n    stdin.pushRequest(req);\n    await new Promise(process.nextTick);\n\n    const responses = stdout.getResponses();\n    expect(responses).toHaveLength(1);\n    expect(responses[0].id).toBe(7);\n    expect(responses[0].error.code).toBe(-32601);\n    expect(responses[0].error.message).toContain('Tool not found');\n  });\n\n  it('should handle tool execution error', async () => {\n    mockGetUltimateAwakeningProtocol.executeAwakening.mockRejectedValue(new Error('Forced Error'));\n\n    const req = {\n      jsonrpc: '2.0',\n      id: 8,\n      method: 'tools/call',\n      params: { name: 'trigger_awakening' },\n    };\n    stdin.pushRequest(req);\n    await new Promise(process.nextTick);\n\n    const responses = stdout.getResponses();\n    expect(responses).toHaveLength(1);\n    expect(responses[0].id).toBe(8);\n    expect(responses[0].error.code).toBe(-32000);\n    expect(responses[0].error.message).toContain('Forced Error');\n  });\n\n  it('should handle parse error', async () => {\n    stdin.push('invalid json\\n');\n    await new Promise(process.nextTick);\n\n    const responses = stdout.getResponses();\n    expect(responses).toHaveLength(1);\n    expect(responses[0].id).toBe(0);\n    expect(responses[0].error.code).toBe(-32700);\n    expect(responses[0].error.message).toBe('Parse error');\n  });\n\n  it('should handle unknown method', async () => {\n    const req = { jsonrpc: '2.0', id: 9, method: 'some_other_method' };\n    stdin.pushRequest(req);\n    await new Promise(process.nextTick);\n\n    const responses = stdout.getResponses();\n    expect(responses).toHaveLength(1);\n    expect(responses[0].id).toBe(9);\n    expect(responses[0].error.code).toBe(-32601);\n    expect(responses[0].error.message).toBe('Method not found');\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\mcp\\OmniAwakeningServer.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3000.","line":253,"co