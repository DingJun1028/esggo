] bg-[#0df2df] text-[#0a1414] font-black text-[12px] uppercase tracking-widest hover:brightness-110 transition-all shadow-[0_15px_30px_rgba(13,242,223,0.3)] flex items-center justify-center gap-4 active:scale-95 group/match\">\n                  <Favorite /> 蝡慦? Match Now\n                </button>\n              </div>\n            </motion.div>\n          </div>\n        </section>\n\n        {/* ESG Monitor (Right) */}\n        <section className=\"lg:col-span-4 flex flex-col gap-10\">\n          <div className=\"flex items-center justify-between px-4\">\n            <h3 className=\"text-2xl font-black italic tracking-tighter uppercase italic\">\n              ESG ?勗??? Report 3.0\n            </h3>\n            <div className=\"px-5 py-2 rounded-full bg-[#0df2df]/10 border border-[#0df2df]/20 text-[#0df2df] text-[10px] font-black tracking-widest uppercase italic\">\n              2024 撟游漲 Fiscal\n            </div>\n          </div>\n\n          <div className=\"backdrop-blur-3xl bg-white/[0.02] border border-white/10 p-10 rounded-[3rem] space-y-12 shadow-3xl\">\n            <div className=\"space-y-8\">\n              {reportMetrics.map((metric, i) => (\n                <motion.div\n                  key={i}\n                  whileHover={{ x: 10 }}\n                  className=\"flex items-center gap-10 group cursor-pointer\"\n                >\n                  <div className=\"relative size-24 shrink-0 flex items-center justify-center\">\n                    <svg className=\"size-full transform -rotate-90\">\n                      <circle\n                        cx=\"48\"\n                        cy=\"48\"\n                        r=\"40\"\n                        fill=\"none\"\n                        stroke=\"rgba(255,255,255,0.05)\"\n                        strokeWidth=\"6\"\n                      />\n                      <motion.circle\n                        initial={{ strokeDashoffset: 251.2 }}\n                        animate={{ strokeDashoffset: metric.offset }}\n                        cx=\"48\"\n                        cy=\"48\"\n                        r=\"40\"\n                        fill=\"none\"\n                        stroke=\"#0df2df\"\n                        strokeWidth=\"6\"\n                        strokeDasharray=\"251.2\"\n                        className=\"drop-shadow-[0_0_8px_#0df2df]\"\n                        transition={{ duration: 2, ease: 'easeOut', delay: i * 0.3 }}\n                      />\n                    </svg>\n                    <span className=\"absolute text-sm font-black italic\">{metric.val}%</span>\n                  </div>\n                  <div className=\"flex-1 space-y-2\">\n                    <div className=\"flex justify-between items-baseline\">\n                      <h4 className=\"text-sm font-black italic uppercase tracking-tight text-white\">\n                        {metric.label}\n                      </h4>\n                      <span\n                        className={`text-[9px] font-black uppercase tracking-widest ${i === 2 ? 'text-emerald-400' : 'text-[#0df2df]'}`}\n                      >\n                        {metric.status}\n                      </span>\n                    </div>\n                    <p className=\"text-[11px] text-white/30 font-light italic leading-relaxed tracking-tight\">\n                      {metric.desc}\n                    </p>\n                  </div>\n                </motion.div>\n              ))}\n            </div>\n\n            <div className=\"pt-10 border-t border-white/5 space-y-6\">\n              <h4 className=\"text-[9px] font-black text-white/40 uppercase tracking-[0.4em] italic mb-6\">\n                AI ?單?靽格撱箄降 AI Insights\n              </h4>\n              <div className=\"space-y-4\">\n                <div className=\"bg-[#0df2df]/5 border border-[#0df2df]/20 p-6 rounded-3xl flex gap-5 group hover:bg-[#0df2df]/10 transition-all\">\n                  <Lightbulb className=\"text-[#0df2df] size-6 shrink-0 group-hover:scale-125 transition-transform\" />\n                  <p className=\"text-[11px] leading-relaxed font-light italic text-[#0df2df] text-justify tracking-tight\">\n                    撱箄降?具憓?撟葉憓????Ｘ平璅姪隡平??蝣喳?瘥?銵剁?隞亙?撘瑟?鞈犖靽∪???靽∪??n                  </p>\n                </div>\n                <div className=\"bg-white/[0.03] border border-white/5 p-6 rounded-3xl flex gap-5 transition-all\">\n                  <Info className=\"text-white/20 size-6 shrink-0\" />\n                  <p className=\"text-[11px] leading-relaxed font-light italic text-white/30 text-justify tracking-tight\">\n                    ?桀??冗???交?? SASB 定義撠? 15%\n                    ?榆嚗?隤踵?膩隤隞亦泵???核心?n                  </p>\n                </div>\n              </div>\n            </div>\n\n            {/* Mini Heat Map Widget */}\n            <div className=\"rounded-[2.5rem] bg-black/60 border border-white/5 h-48 relative overflow-hidden group shadow-inner mt-8\">\n              <img\n                src=\"https://lh3.googleusercontent.com/aida-public/AB6AXuDLcq58iWNWjacz6HPyvkJgr3DHQRmHJx8TJfgp8ZhWz_Mhz7RIVtu7yN7GxKMtjwwoe4OfXkrWaHYiO4fzh2LHJkhQBdcycKGvNGOswOljBy1kZsIiPS09ef5YcgKQGr6CA7xjNh9H3uJJCMZCKrme-EfO6XgJe3kD4PPj9i83P2m-2fAwo8cHb0VhKDRkwJmdO6XWJ5hOwLOBzXakZr4uLzdRSO7vetYp6o9g0WHH449i0UXfKIa-9R-Phf_oF9tH3Jdgx0HYucs\"\n                className=\"size-full object-cover opacity-30 grayscale hover:grayscale-0 transition-all duration-3000 group-hover:scale-125\"\n                alt=\"map\"\n              />\n              <div className=\"absolute inset-0 bg-gradient-to-t from-[#0a1414] to-transparent\" />\n              <div className=\"absolute bottom-6 left-8 space-y-1\">\n                <p className=\"text-[#0df2df] text-[9px] font-black uppercase tracking-[0.4em]\">\n                  ???梢? Hotspots\n                </p>\n                <p className=\"text-sm font-black italic text-white/60 tracking-tight uppercase\">\n                  鈭云? - 蝬?賣???? Asia Green Energy\n                </p>\n              </div>\n            </div>\n          </div>\n        </section>\n      </main>\n\n      <style>{`\n        .no-scrollbar::-webkit-scrollbar { display: none; }\n        .font-display { font-family: 'Space Grotesk', 'Noto Sans TC', sans-serif; }\n      `}</style>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\GeneticChronicle.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":21,"column":39,"nodeType":"Literal","messageId":"noMagic","endLine":21,"endColumn":41}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport {\n  Dna,\n  History,\n  Award,\n  Sparkles,\n  Trash2,\n  Database,\n  ArrowRight,\n  Search,\n  Fingerprint,\n} from 'lucide-react';\nimport { useGeneticInheritance } from '../../hooks/useGeneticInheritance';\nimport { useAgentRpg } from '../../hooks/useAgentRpg';\n\nexport const GeneticChronicle: React.FC = () => {\n  const { blueprints, synthesizeBlueprint, deleteBlueprint } = useGeneticInheritance();\n  const { profile } = useAgentRpg();\n\n  const isEligible = profile.level >= 10;\n\n  return (\n    <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 p-2\">\n      {/* Left Col: Extraction Forge */}\n      <div className=\"lg:col-span-4 space-y-6\">\n        <div className=\"bg-black/80 border border-emerald-500/20 rounded-2xl p-6 backdrop-blur-xl h-[650px] flex flex-col relative overflow-hidden\">\n          <div className=\"flex items-center gap-3 mb-8 relative z-10\">\n            <div className=\"w-12 h-12 rounded-xl bg-emerald-500/10 flex items-center justify-center border border-emerald-500/30\">\n              <Dna className=\"w-6 h-6 text-emerald-500\" />\n            </div>\n            <div>\n              <h3 className=\"text-base font-black text-white uppercase tracking-tighter\">\n                ?箏?????(Genetic Synthesis)\n              </h3>\n              <p className=\"text-[10px] text-emerald-500/70 font-mono\">INHERITANCE_ENGINE_v3.7</p>\n            </div>\n          </div>\n\n          <div className=\"bg-white/5 border border-white/10 rounded-3xl p-8 flex flex-col items-center text-center relative z-10\">\n            <div\n              className={`w-24 h-24 rounded-full border-4 flex items-center justify-center mb-6 transition-all ${isEligible ? 'border-emerald-500 shadow-[0_0_30px_rgba(16,185,129,0.3)]' : 'border-gray-800 opacity-30'}`}\n            >\n              <Fingerprint\n                className={`w-12 h-12 ${isEligible ? 'text-emerald-500' : 'text-gray-700'}`}\n              />\n            </div>\n            <h4 className=\"text-lg font-black text-white uppercase mb-2\">{profile.title}</h4>\n            <div className=\"flex items-center gap-2 mb-6\">\n              <span className=\"text-[10px] font-black uppercase text-gray-500\">\n                Subject Eligibility\n              </span>\n              <span\n                className={`text-[10px] font-black px-2 py-0.5 rounded-full ${isEligible ? 'bg-emerald-500/20 text-emerald-400' : 'bg-red-500/20 text-red-400'}`}\n              >\n                {isEligible ? 'VERIFIED' : `LEVEL ${profile.level}/10 AWAITING`}\n              </span>\n            </div>\n\n            <p className=\"text-xs text-gray-500 leading-relaxed mb-8 italic\">\n              Extraction converts 20% of your current attributes into a permanent blueprint.\n              <br />\n              <span className=\"text-emerald-500/80 font-bold uppercase tracking-widest mt-2 block\">\n                Generation Mutation possible (10%)\n              </span>\n            </p>\n\n            <button\n              disabled={!isEligible}\n              onClick={() => synthesizeBlueprint(profile)}\n              className=\"w-full py-4 rounded-2xl bg-gradient-to-r from-emerald-600 to-teal-400 text-white font-black uppercase text-xs tracking-widest shadow-xl shadow-emerald-500/20 hover:scale-[1.02] active:scale-95 transition-all disabled:opacity-30 disabled:grayscale\"\n            >\n              Begin Synthesis Ritual\n            </button>\n          </div>\n\n          <div className=\"mt-auto p-4 bg-emerald-500/5 border border-emerald-500/20 rounded-2xl flex items-center gap-4\">\n            <Sparkles className=\"w-5 h-5 text-emerald-400\" />\n            <div className=\"text-[9px] text-emerald-400/80 font-bold uppercase leading-tight\">\n              Generational blueprints provide\n              <br />\n              permanent base stat scaling\n            </div>\n          </div>\n\n          {/* Background Grid */}\n          <div className=\"absolute inset-0 pointer-events-none opacity-[0.03] bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(0,255,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))] bg-[length:100%_2px,3px_100%]\" />\n        </div>\n      </div>\n\n      {/* Right Col: Genetic Library */}\n      <div className=\"lg:col-span-8 space-y-6\">\n        <div className=\"bg-black/90 border border-white/5 rounded-2xl p-8 backdrop-blur-3xl h-[650px] flex flex-col\">\n          <div className=\"flex items-center justify-between mb-8 border-b border-white/5 pb-6\">\n            <div className=\"flex items-center gap-3\">\n              <History className=\"w-5 h-5 text-gray-400\" />\n              <h3 className=\"text-lg font-black text-white uppercase tracking-wider\">\n                ?箏蝺典僑??(The Genetic Chronicle)\n              </h3>\n            </div>\n            <div className=\"relative\">\n              <Search className=\"w-4 h-4 text-gray-600 absolute left-3 top-1/2 -translate-y-1/2\" />\n              <input\n                type=\"text\"\n                placeholder=\"Search Archives...\"\n                className=\"bg-white/5 border border-white/10 rounded-full pl-10 pr-4 py-2 text-[10px] text-white focus:border-emerald-500 outline-none w-48\"\n              />\n            </div>\n          </div>\n\n          <div className=\"flex-1 overflow-y-auto pr-2 scrollbar-thin scrollbar-thumb-white/10\">\n            <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n              <AnimatePresence>\n                {blueprints.length === 0 ? (\n                  <div className=\"col-span-2 h-64 flex flex-col items-center justify-center text-gray-700\">\n                    <Database className=\"w-12 h-12 mb-4 opacity-20\" />\n                    <p className=\"text-xs font-bold uppercase tracking-widest italic opacity-50\">\n                      No blueprints registered in chronological history\n                    </p>\n                  </div>\n                ) : (\n                  blueprints.map(bp => (\n                    <motion.div\n                      key={bp.id}\n                      initial={{ opacity: 0, scale: 0.95 }}\n                      animate={{ opacity: 1, scale: 1 }}\n                      exit={{ opacity: 0, scale: 0.95 }}\n                      className=\"p-6 rounded-3xl bg-white/5 border border-white/10 hover:border-emerald-500/30 transition-all group relative overflow-hidden\"\n                    >\n                      <div className=\"flex justify-between items-start mb-6\">\n                        <div className=\"flex items-center gap-3\">\n                          <div className=\"w-10 h-10 rounded-full bg-emerald-500/10 flex items-center justify-center border border-emerald-500/20\">\n                            <Award className=\"w-5 h-5 text-emerald-500\" />\n                          </div>\n                          <div>\n                            <span className=\"text-[9px] font-mono text-emerald-400\">{bp.id}</span>\n                            <h4 className=\"text-sm font-black text-white uppercase\">\n                              {bp.parentName}\n                            </h4>\n                          </div>\n                        </div>\n                        <button\n                          onClick={() => deleteBlueprint(bp.id)}\n                          className=\"p-2 rounded-lg hover:bg-red-500/10 text-gray-700 hover:text-red-500 transition-colors\"\n                        >\n                          <Trash2 className=\"w-4 h-4\" />\n                        </button>\n                      </div>\n\n                      <div className=\"grid grid-cols-3 gap-2 mb-6\">\n                        <div className=\"text-center\">\n                          <div className=\"text-[8px] text-gray-500 font-black uppercase mb-1\">\n                            Compute\n                          </div>\n                          <div className=\"text-[11px] font-black text-emerald-400\">\n                            +{bp.attributes.computePower}\n                          </div>\n                        </div>\n                        <div className=\"text-center\">\n                          <div className=\"text-[8px] text-gray-500 font-black uppercase mb-1\">\n                            Empathy\n                          </div>\n                          <div className=\"text-[11px] font-black text-emerald-400\">\n                            +{bp.attributes.empathyLevel}\n                          </div>\n                        </div>\n                        <div className=\"text-center\">\n                          <div className=\"text-[8px] text-gray-500 font-black uppercase mb-1\">\n                            Gov\n                          </div>\n                          <div className=\"text-[11px] font-black text-emerald-400\">\n                            +{bp.attributes.governanceScore}\n                          </div>\n                        </div>\n                      </div>\n\n                      <div className=\"flex items-center justify-between text-[10px] text-gray-500 font-bold italic pt-4 border-t border-white/5\">\n                        <span>v{bp.version}.0 Injected</span>\n                        <div className=\"flex items-center gap-1\">\n                          <span>Details</span>\n                          <ArrowRight className=\"w-3 h-3 group-hover:translate-x-1 transition-transform\" />\n                        </div>\n                      </div>\n                    </motion.div>\n                  ))\n                )}\n              </AnimatePresence>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\GeneticForge.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":35,"column":39,"nodeType":"Literal","messageId":"noMagic","endLine":35,"endColumn":41},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 2000.","line":40,"column":42,"nodeType":"Literal","messageId":"noMagic","endLine":40,"endColumn":46},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 8.","line":215,"column":47,"nodeType":"Literal","messageId":"noMagic","endLine":215,"endColumn":48}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport {\n  Dna,\n  Zap,\n  Beaker,\n  Trash2,\n  Download,\n  AlertCircle,\n  Copy,\n  ChevronRight,\n  Search,\n  Leaf,\n} from 'lucide-react';\nimport { useAgentRpg } from '../../hooks/useAgentRpg';\nimport { useGeneticEngine, GeneticBlueprint } from '../../hooks/useGeneticEngine';\nimport { Language } from '@/types';\n\ninterface GeneticForgeProps {\n  readonly language?: Language;\n}\n\nexport const GeneticForge: React.FC<GeneticForgeProps> = ({ language = 'zh-TW' }) => {\n  const isZh = language === 'zh-TW';\n  const { profile } = useAgentRpg();\n  const { blueprints, extractBlueprint, deleteBlueprint } = useGeneticEngine();\n  const [isExtracting, setIsExtracting] = useState(false);\n  const [searchTerm, setSearchTerm] = useState('');\n  const [tasks, setTasks] = useState([\n    { id: 1, title: 'Calibrate Sequencer', description: 'Align the primary DNA scanner.' },\n    { id: 2, title: 'Run Diagnostics', description: 'Check all systems for errors.' },\n    { id: 3, title: 'Archive Old Data', description: 'Move legacy blueprints to cold storage.' },\n  ]);\n\n  const isEligible = profile.level >= 10;\n\n  const handleExtract = async () => {\n    setIsExtracting(true);\n    // Artificial delay for \"Scanning\" effect\n    await new Promise(r => setTimeout(r, 2000));\n\n    const result = extractBlueprint(profile);\n    if (result.success) {\n      // Success log handled by internal logic or could add toast\n    }\n    setIsExtracting(false);\n  };\n\n  const handleCompleteTask = (taskId: number) => {\n    setTasks(tasks.filter(task => task.id !== taskId));\n  };\n\n  const filteredBlueprints = blueprints.filter(\n    b =>\n      b.sourceAgentName.toLowerCase().includes(searchTerm.toLowerCase()) ||\n      b.id.toLowerCase().includes(searchTerm.toLowerCase())\n  );\n\n  return (\n    <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 p-2\">\n      {/* Left Col: Extraction Chamber */}\n      <div className=\"lg:col-span-5 space-y-6\">\n        <div className=\"bg-black/60 border border-purple-500/30 rounded-2xl p-8 backdrop-blur-xl relative overflow-hidden group\">\n          <div className=\"absolute inset-0 bg-gradient-to-br from-purple-600/5 to-transparent pointer-events-none\" />\n\n          <div className=\"relative z-10\">\n            <div className=\"flex items-center gap-3 mb-8\">\n              <div className=\"w-12 h-12 rounded-xl bg-purple-500/20 border border-purple-500/40 flex items-center justify-center\">\n                <Dna className={`w-6 h-6 text-purple-400 ${isExtracting ? 'animate-spin' : ''}`} />\n              </div>\n              <div>\n                <h3 className=\"text-xl font-bold text-white tracking-tight\">\n                  {isZh ? '?箏???摰? : 'Extraction Chamber'}\n                </h3>\n                <p className=\"text-xs text-purple-400/70 font-mono\">GENETIC_SEQUENCER_v4.2</p>\n              </div>\n            </div>\n\n            <div className=\"p-6 bg-white/5 border border-white/10 rounded-2xl mb-8\">\n              <div className=\"flex justify-between items-center mb-4\">\n                <span className=\"text-xs text-gray-500 uppercase font-bold\">\n                  {isZh ? '?嗅??格?' : 'Current Subject'}\n                </span>\n                <span\n                  className={`text-[10px] px-2 py-0.5 rounded ${isEligible ? 'bg-green-500/20 text-green-400' : 'bg-red-500/20 text-red-400'}`}\n                >\n                  {isEligible ? (isZh ? '符合鞈' : 'Eligible') : isZh ? '鞈銝泵' : 'Ineligible'}\n                </span>\n              </div>\n\n              <div className=\"border-l-2 border-purple-500 pl-4 py-1\">\n                <div className=\"text-lg font-bold text-gray-200\">{profile.title}</div>\n                <div className=\"text-xs text-gray-500\">\n                  Lv.{profile.level} ??{profile.archetypeId}\n                </div>\n              </div>\n            </div>\n\n            {!isEligible ? (\n              <div className=\"p-4 bg-red-500/5 border border-red-500/20 rounded-xl mb-8 flex gap-3\">\n                <AlertCircle className=\"w-5 h-5 text-red-500 shrink-0\" />\n                <div className=\"text-xs text-red-400/80 leading-relaxed\">\n                  <span className=\"font-bold text-red-500\">\n                    {isZh ? '?????? : 'Extraction Locked.'}\n                  </span>\n                  {isZh\n                    ? '?格?敹?? 蝑? 10 ???蝛拙??????\n                    : 'Subject must reach Level 10 to provide a stable genetic sequence.'}\n                </div>\n              </div>\n            ) : (\n              <button\n                onClick={handleExtract}\n                disabled={isExtracting}\n                className={`w-full py-4 rounded-xl font-bold flex items-center justify-center gap-2 transition-all ${\n                  isExtracting\n                    ? 'bg-gray-800 text-gray-500 cursor-not-allowed'\n                    : 'bg-gradient-to-r from-purple-600 to-indigo-600 text-white hover:from-purple-500 hover:to-indigo-500 shadow-lg shadow-purple-600/20'\n                }`}\n              >\n                <Zap className={`w-5 h-5 ${isExtracting ? 'animate-pulse' : ''}`} />\n                {isExtracting\n                  ? isZh\n                    ? '摨???銝?..'\n                    : 'Analyzing Sequence...'\n                  : isZh\n                    ? '???箏???'\n                    : 'Extract Genetic Blueprint'}\n              </button>\n            )}\n\n            <div className=\"mt-8 pt-8 border-t border-white/5\">\n              <div className=\"text-[10px] text-gray-600 uppercase font-bold tracking-widest mb-4\">\n                {isZh ? '蝘飛??' : 'Scientific Protocol'}\n              </div>\n              <ul className=\"space-y-3\">\n                <li className=\"flex gap-2 text-[10px] text-gray-500\">\n                  <ChevronRight className=\"w-3 h-3 text-purple-500\" />\n                  {isZh\n                    ? '?? 20% ?＊?批惇?找??粹?喳???\n                    : 'Extract 20% of dominant traits as genetic bonus.'}\n                </li>\n                <li className=\"flex gap-2 text-[10px] text-gray-500\">\n                  <ChevronRight className=\"w-3 h-3 text-purple-500\" />\n                  {isZh\n                    ? '???舐?潭代稱鈭箏?曉?????\n                    : 'Blueprints can be used in the embodiment of new agents.'}\n                </li>\n                <li className=\"flex gap-2 text-[10px] text-gray-500\">\n                  <ChevronRight className=\"w-3 h-3 text-purple-500\" />\n                  {isZh\n                    ? '????銝?敶梢?格??祇???\n                    : 'Extraction does not affect the source unit.'}\n                </li>\n              </ul>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Right Col: Blueprint Library */}\n      <div className=\"lg:col-span-7 flex flex-col space-y-6\">\n        <div className=\"bg-black/40 border border-white/10 rounded-2xl p-6 backdrop-blur-md flex-1 flex flex-col\">\n          <div className=\"flex items-center justify-between mb-8\">\n            <div>\n              <h3 className=\"text-sm font-bold text-gray-300 flex items-center gap-2\">\n                <Beaker className=\"w-4 h-4 text-purple-500\" />\n                {isZh ? '?箏???摨? : 'Blueprint Archive'}\n              </h3>\n              <p className=\"text-[10px] text-gray-600 mt-1 uppercase tracking-tight\">\n                {isZh\n                  ? `已完成${blueprints.length} 璇??\n                  : `${blueprints.length} sequences archived`}\n              </p>\n            </div>\n            <div className=\"relative group\">\n              <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 w-3.5 h-3.5 text-gray-600\" />\n              <input\n                type=\"text\"\n                placeholder={isZh ? '????...' : 'Search Blueprints...'}\n                value={searchTerm}\n                onChange={e => setSearchTerm(e.target.value)}\n                className=\"bg-black/40 border border-white/10 rounded-lg pl-9 pr-4 py-2 text-xs text-gray-300 focus:outline-none focus:border-purple-500/50 w-48 transition-all\"\n              />\n            </div>\n          </div>\n\n          <div className=\"flex-1 overflow-y-auto pr-2 custom-scrollbar space-y-4\">\n            <div className=\"space-y-3\">\n              {filteredBlueprints.length === 0 ? (\n                <div className=\"text-center py-8 text-gray-500 text-xs\">\n                  {isZh ? '?芣?啗??? : 'No blueprints found'}\n                </div>\n              ) : (\n                filteredBlueprints.map(bp => (\n                  <div\n                    key={bp.id}\n                    className=\"bg-white/5 border border-white/10 rounded-xl p-3 flex justify-between items-center group hover:bg-white/10 transition-colors\"\n                  >\n                    <div className=\"flex items-center gap-3\">\n                      <div\n                        className={`w-8 h-8 rounded-lg flex items-center justify-center ${\n                          bp.rarity === 'Legendary'\n                            ? 'bg-orange-500/20 text-orange-400'\n                            : bp.rarity === 'Epic'\n                              ? 'bg-purple-500/20 text-purple-400'\n                              : 'bg-blue-500/20 text-blue-400'\n                        }`}\n                      >\n                        <Dna className=\"w-4 h-4\" />\n                      </div>\n                      <div>\n                        <div className=\"text-sm font-bold text-gray-200\">{bp.sourceAgentName}</div>\n                        <div className=\"text-[10px] text-gray-500 font-mono\">\n                          {bp.id.substring(0, 8)}...\n                        </div>\n                      </div>\n                    </div>\n\n                    <div className=\"flex items-center gap-2 opacity-0 group-hover:opacity-100 transition-opacity\">\n                      <button\n                        className=\"p-1.5 hover:bg-white/10 rounded-lg text-gray-400 hover:text-white transition-colors\"\n                        title={isZh ? '銴ˊ' : 'Clone'}\n                      >\n                        <Copy className=\"w-3.5 h-3.5\" />\n                      </button>\n                      <button\n                        onClick={() => deleteBlueprint(bp.id)}\n                        className=\"p-1.5 hover:bg-red-500/20 rounded-lg text-gray-400 hover:text-red-400 transition-colors\"\n                        title={isZh ? '?芷' : 'Delete'}\n                      >\n                        <Trash2 className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n                  </div>\n                ))\n              )}\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\GoalTracker.tsx","messages":[{"ruleId":"react/prop-types","severity":2,"message":"'goal' is missing in props validation","line":13,"column":41,"nodeType":"Property","messageId":"missingPropType","endLine":13,"endColumn":45},{"ruleId":"react/prop-types","severity":2,"message":"'goal.status' is missing in props validation","line":15,"column":18,"nodeType":"Identifier","messageId":"missingPropType","endLine":15,"endColumn":24},{"ruleId":"react/prop-types","severity":2,"message":"'goal.status' is missing in props validation","line":25,"column":12,"nodeType":"Identifier","messageId":"missingPropType","endLine":25,"endColumn":18},{"ruleId":"react/prop-types","severity":2,"message":"'goal.priority' is missing in props validation","line":36,"column":24,"nodeType":"Identifier","messageId":"missingPropType","endLine":36,"endColumn":32},{"ruleId":"react/prop-types","severity":2,"message":"'goal.priority' is missing in props validation","line":37,"column":12,"nodeType":"Identifier","messageId":"missingPropType","endLine":37,"endColumn":20},{"ruleId":"react/prop-types","severity":2,"message":"'goal.priority' is missing in props validation","line":46,"column":24,"nodeType":"Identifier","messageId":"missingPropType","endLine":46,"endColumn":32},{"ruleId":"react/prop-types","severity":2,"message":"'goal.priority' is missing in props validation","line":47,"column":12,"nodeType":"Identifier","messageId":"missingPropType","endLine":47,"endColumn":20},{"ruleId":"react/prop-types","severity":2,"message":"'goal.status' is missing in props validation","line":49,"column":28,"nodeType":"Identifier","messageId":"missingPropType","endLine":49,"endColumn":34},{"ruleId":"react/prop-types","severity":2,"message":"'goal.status' is missing in props validation","line":50,"column":25,"nodeType":"Identifier","messageId":"missingPropType","endLine":50,"endColumn":31},{"ruleId":"react/prop-types","severity":2,"message":"'goal.status' is missing in props validation","line":51,"column":26,"nodeType":"Identifier","messageId":"missingPropType","endLine":51,"endColumn":32},{"ruleId":"react/prop-types","severity":2,"message":"'goal.description' is missing in props validation","line":70,"column":21,"nodeType":"Identifier","messageId":"missingPropType","endLine":70,"endColumn":32},{"ruleId":"react/prop-types","severity":2,"message":"'goal.tags' is missing in props validation","line":73,"column":21,"nodeType":"Identifier","messageId":"missingPropType","endLine":73,"endColumn":25},{"ruleId":"react/prop-types","severity":2,"message":"'goal.tags.map' is missing in props validation","line":73,"column":26,"nodeType":"Identifier","messageId":"missingPropType","endLine":73,"endColumn":29},{"ruleId":"react/prop-types","severity":2,"message":"'goal.progress' is missing in props validation","line":97,"column":29,"nodeType":"Identifier","messageId":"missingPropType","endLine":97,"endColumn":37},{"ruleId":"react/prop-types","severity":2,"message":"'goal.progress' is missing in props validation","line":111,"column":35,"nodeType":"Identifier","messageId":"missingPropType","endLine":111,"endColumn":43}],"suppressedMessages":[],"errorCount":15,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { memo, useState, useCallback, useMemo } from 'react';\nimport { Card, Button } from '@/components/ui';\nimport { Target, CheckCircle2, Circle, Plus } from 'lucide-react';\nimport { useCoreSystem } from '@/hooks/useCoreSystem';\nimport type { Goal } from '@/core/goal/GoalManager';\n\n// ==================== TYPE DEFINITIONS ====================\ninterface GoalCardProps {\n  readonly goal: Goal;\n}\n\n// ==================== SUB-COMPONENTS ====================\nconst GoalCard = memo<GoalCardProps>(({ goal }) => {\n  const getStatusIcon = useMemo(() => {\n    switch (goal.status) {\n      case 'completed':\n        return { Icon: CheckCircle2, color: 'text-emerald-500' };\n      case 'failed':\n        return { Icon: Circle, color: 'text-red-500' };\n      case 'blocked':\n        return { Icon: Circle, color: 'text-amber-500' };\n      default: // pending, active\n        return { Icon: Circle, color: 'text-indigo-400' };\n    }\n  }, [goal.status]);\n\n  const { Icon, color: iconColor } = getStatusIcon;\n\n  const priorityStyles = useMemo(() => {\n    const styles = {\n      critical: 'bg-rose-100 text-rose-600',\n      high: 'bg-amber-100 text-amber-600',\n      medium: 'bg-slate-100 text-slate-500',\n      low: 'bg-slate-100 text-slate-500',\n    };\n    return styles[goal.priority];\n  }, [goal.priority]);\n\n  const priorityLabel = useMemo(() => {\n    const labels = {\n      critical: '蝺?,\n      high: '擃??,\n      medium: '銝剔?',\n      low: '雿?,\n    };\n    return labels[goal.priority];\n  }, [goal.priority]);\n\n  const isCompleted = goal.status === 'completed';\n  const isFailed = goal.status === 'failed';\n  const isBlocked = goal.status === 'blocked';\n\n  return (\n    <article className=\"group relative p-3 rounded-lg border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 shadow-sm hover:shadow-md transition-all\">\n      <header className=\"flex justify-between items-start mb-2\">\n        <div className=\"flex gap-2\">\n          <Icon className={`w-4 h-4 ${iconColor} mt-0.5`} aria-hidden=\"true\" />\n          <div>\n            <h4\n              className={`text-sm font-medium ${\n                isCompleted\n                  ? 'text-slate-400 line-through'\n                  : isFailed\n                    ? 'text-red-500 line-through'\n                    : isBlocked\n                      ? 'text-amber-500'\n                      : 'text-slate-700 dark:text-slate-200'\n              }`}\n            >\n              {goal.description}\n            </h4>\n            <div className=\"flex gap-1 mt-1\" role=\"list\">\n              {goal.tags.map(tag => (\n                <span\n                  key={tag}\n                  className=\"text-[10px] px-1.5 py-0.5 rounded-full bg-slate-100 dark:bg-slate-700 text-slate-500\"\n                  role=\"listitem\"\n                >\n                  #{tag}\n                </span>\n              ))}\n            </div>\n          </div>\n        </div>\n        <span\n          className={`text-[10px] font-bold px-1.5 py-0.5 rounded uppercase ${priorityStyles}`}\n          role=\"status\"\n          aria-label={`Priority: ${priorityLabel}`}\n        >\n          {priorityLabel}\n        </span>\n      </header>\n\n      <div\n        className=\"w-full h-1.5 bg-slate-100 dark:bg-slate-700 rounded-full overflow-hidden\"\n        role=\"progressbar\"\n        aria-valuenow={goal.progress}\n        aria-valuemin={0}\n        aria-valuemax={100}\n      >\n        <div\n          className={`h-full transition-all duration-500 ${\n            isCompleted\n              ? 'bg-emerald-500'\n              : isFailed\n                ? 'bg-red-500'\n                : isBlocked\n                  ? 'bg-amber-500'\n                  : 'bg-indigo-500'\n          }`}\n          style={{ width: `${goal.progress}%` }}\n        />\n      </div>\n    </article>\n  );\n});\n\nGoalCard.displayName = 'GoalCard';\n\n// ==================== MAIN COMPONENT ====================\nexport const GoalTracker = memo(() => {\n  const { goals, actions } = useCoreSystem();\n  const [newGoalText, setNewGoalText] = useState('');\n\n  const handleAddGoal = useCallback(\n    (e: React.FormEvent) => {\n      e.preventDefault();\n      if (newGoalText.trim()) {\n        actions.addManualGoal(newGoalText);\n        setNewGoalText('');\n      }\n    },\n    [newGoalText, actions]\n  );\n\n  const activeGoalCount = useMemo(\n    () => goals.filter(g => g.status === 'active' || g.status === 'pending').length,\n    [goals]\n  );\n\n  const goalCards = useMemo(\n    () => goals.map(goal => <GoalCard key={goal.id} goal={goal} />),\n    [goals]\n  );\n\n  return (\n    <Card\n      className=\"p-4 bg-white/50 dark:bg-slate-900/50 backdrop-blur border-indigo-200 dark:border-indigo-500/30\"\n      role=\"region\"\n      aria-labelledby=\"goal-tracker-heading\"\n    >\n      <header className=\"flex items-center justify-between mb-4\">\n        <div className=\"flex items-center gap-2\">\n          <Target className=\"h-5 w-5 text-indigo-600 dark:text-indigo-400\" aria-hidden=\"true\" />\n          <h3\n            id=\"goal-tracker-heading\"\n            className=\"font-bold text-lg text-slate-800 dark:text-slate-100\"\n          >\n            隤?格?追蹤\n          </h3>\n        </div>\n        <div className=\"text-xs font-mono text-slate-500 dark:text-slate-400\" aria-live=\"polite\">\n          瘣餉??格?: {activeGoalCount}\n        </div>\n      </header>\n\n      <div className=\"space-y-3 mb-4 max-h-[250px] overflow-y-auto pr-2\" role=\"list\">\n        {goals.length === 0 ? (\n          <div className=\"text-center py-8 text-slate-400 text-sm\" role=\"status\">\n            撠閮剖?隤?格?\n          </div>\n        ) : (\n          goalCards\n        )}\n      </div>\n\n      <form onSubmit={handleAddGoal} className=\"flex gap-2\">\n        <input\n          type=\"text\"\n          value={newGoalText}\n          onChange={e => setNewGoalText(e.target.value)}\n          placeholder=\"頛詨?啁璅?..\"\n          className=\"flex-1 text-sm px-3 py-2 rounded-md border border-slate-200 dark:border-slate-700 bg-transparent focus:outline-none focus:ring-2 focus:ring-indigo-500\"\n          aria-label=\"New goal description\"\n        />\n        <Button\n          type=\"submit\"\n          size=\"sm\"\n          className=\"bg-indigo-600 hover:bg-indigo-700 text-white focus:outline-none focus:ring-2 focus:ring-indigo-500\"\n          aria-label=\"Add new goal\"\n        >\n          <Plus className=\"w-4 h-4\" />\n        </Button>\n      </form>\n    </Card>\n  );\n});\n\nGoalTracker.displayName = 'GoalTracker';\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\GovernanceCenter.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5000.","line":43,"column":40,"nodeType":"Literal","messageId":"noMagic","endLine":43,"endColumn":44}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\nimport {\n  Card,\n  CardContent,\n  CardHeader,\n  CardTitle,\n  CardDescription,\n  Badge,\n  Button,\n  ScrollArea,\n  Progress,\n} from '@/components/ui';\nimport {\n  Vote,\n  Users,\n  Zap,\n  Scale,\n  ShieldCheck,\n  AlertCircle,\n  CheckCircle2,\n  Activity,\n} from 'lucide-react';\nimport { GovernanceDAO, StrategicProposal } from '../../services/GovernanceDAO';\nimport { SwarmEngine } from '../../services/SwarmEngine';\nimport { agentService } from '../../services/agentService';\nimport { Agent } from '../../types/agency';\nimport { motion, AnimatePresence } from 'framer-motion';\n\nexport const GovernanceCenter: React.FC = () => {\n  const [proposals, setProposals] = useState<StrategicProposal[]>([]);\n  const [agents, setAgents] = useState<Agent[]>([]);\n  const [swarmSync, setSwarmSync] = useState<any>(null);\n\n  useEffect(() => {\n    const load = async () => {\n      const propData = GovernanceDAO.getProposals();\n      const agentData = await agentService.getAgents();\n      setProposals(propData);\n      setAgents(agentData);\n      setSwarmSync(SwarmEngine.calculateSync(agentData));\n    };\n    load();\n    const interval = setInterval(load, 5000);\n    return () => clearInterval(interval);\n  }, []);\n\n  const handleCreateProposal = () => {\n    const categories: any[] = ['ENVIRONMENTAL', 'SOCIAL', 'GOVERNANCE'];\n    const randomCat = categories[Math.floor(Math.random() * categories.length)];\n    GovernanceDAO.createProposal(agents, randomCat);\n  };\n\n  const handleVote = (propId: string, support: boolean) => {\n    // Mock user agent voting (In reality, multiple agents would vote)\n    if (agents.length > 0) {\n      GovernanceDAO.castVote(propId, agents[0]!, support);\n    } else {\n      console.warn('No agents available to vote.');\n    }\n  };\n\n  return (\n    <div className=\"p-6 space-y-6 animate-in fade-in duration-700\">\n      {/* GOVERNANCE HEADER */}\n      <div className=\"flex flex-col md:flex-row justify-between items-start md:items-center gap-6\">\n        <div>\n          <h1 className=\"text-3xl font-black flex items-center gap-3 text-white tracking-tighter\">\n            <Scale className=\"w-8 h-8 text-primary\" />\n            ETH-GOV: NEURAL DAO\n          </h1>\n          <p className=\"text-slate-400 font-mono text-sm\">\n            Decentralized Agent Governance & Swarm Consensus\n          </p>\n        </div>\n\n        <div className=\"flex gap-4\">\n          <Button\n            onClick={handleCreateProposal}\n            className=\"bg-primary hover:bg-primary/90 text-white font-bold rounded-xl shadow-lg shadow-primary/20\"\n          >\n            <Activity className=\"w-4 h-4 mr-2\" />\n            Simulate Pulse Proposal\n          </Button>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* PROPOSALS LIST */}\n        <div className=\"lg:col-span-2 space-y-4\">\n          <h2 className=\"text-lg font-bold text-slate-300 flex items-center gap-2\">\n            <Vote className=\"w-5 h-5 text-cyan-400\" />\n            Active Strategic Proposals\n          </h2>\n\n          <ScrollArea className=\"h-[600px] pr-4\">\n            <div className=\"space-y-4\">\n              {proposals.length === 0 ? (\n                <div className=\"p-20 text-center bg-slate-900/40 rounded-3xl border border-dashed border-white/5 text-slate-500\">\n                  No active proposals in the current epoch.\n                </div>\n              ) : (\n                proposals.map(prop => (\n                  <Card\n                    key={prop.id}\n                    className=\"bg-slate-950/60 border-white/5 hover:border-primary/30 transition-all duration-500 group\"\n                  >\n                    <CardHeader className=\"pb-2\">\n                      <div className=\"flex justify-between items-start\">\n                        <Badge\n                          className={`${\n                            prop.category === 'ENVIRONMENTAL'\n                              ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20'\n                              : prop.category === 'SOCIAL'\n                                ? 'bg-pink-500/10 text-pink-400 border-pink-500/20'\n                                : 'bg-blue-500/10 text-blue-400 border-blue-500/20'\n                          }`}\n                        >\n                          {prop.category}\n                        </Badge>\n                        <Badge variant=\"outline\" className=\"text-[10px] opacity-60\">\n                          {prop.status}\n                        </Badge>\n                      </div>\n                      <CardTitle className=\"text-xl mt-2 text-white group-hover:text-primary transition-colors\">\n                        {prop.title}\n                      </CardTitle>\n                      <CardDescription className=\"text-slate-400\">\n                        {prop.description}\n                      </CardDescription>\n                    </CardHeader>\n                    <CardContent>\n                      <div className=\"space-y-4\">\n                        <div className=\"flex justify-between text-xs mb-1 font-mono\">\n                          <span className=\"text-emerald-400\">FOR: {prop.votesFor} Power</span>\n                          <span className=\"text-rose-400\">AGAINST: {prop.votesAgainst} Power</span>\n                        </div>\n                        <div className=\"h-2 bg-slate-900 rounded-full overflow-hidden flex\">\n                          <div\n                            className=\"h-full bg-emerald-500 shadow-[0_0_10px_rgba(16,185,129,0.5)] transition-all duration-1000\"\n                            style={{\n                              width: `${(prop.votesFor / (prop.votesFor + prop.votesAgainst + 1)) * 100}%`,\n                            }}\n                          />\n                          <div\n                            className=\"h-full bg-rose-500 shadow-[0_0_10px_rgba(244,63,94,0.5)] transition-all duration-1000\"\n                            style={{\n                              width: `${(prop.votesAgainst / (prop.votesFor + prop.votesAgainst + 1)) * 100}%`,\n                            }}\n                          />\n                        </div>\n\n                        <div className=\"flex gap-2 pt-2\">\n                          <Button\n                            variant=\"outline\"\n                            className=\"flex-1 rounded-xl border-emerald-500/20 hover:bg-emerald-500/10 text-emerald-400\"\n                            onClick={() => handleVote(prop.id, true)}\n                            disabled={prop.status !== 'ACTIVE'}\n                          >\n                            Consensus Yes\n                          </Button>\n                          <Button\n                            variant=\"outline\"\n                            className=\"flex-1 rounded-xl border-rose-500/20 hover:bg-rose-500/10 text-rose-400\"\n                            onClick={() => handleVote(prop.id, false)}\n                            disabled={prop.status !== 'ACTIVE'}\n                          >\n                            Dissent No\n                          </Button>\n                        </div>\n                      </div>\n                    </CardContent>\n                  </Card>\n                ))\n              )}\n            </div>\n          </ScrollArea>\n        </div>\n\n        {/* SWARM SYNC PANEL */}\n        <div className=\"space-y-6\">\n          <Card className=\"bg-slate-950/80 border-primary/20 shadow-[0_0_30px_rgba(var(--primary-rgb),0.1)] relative overflow-hidden\">\n            <div className=\"absolute inset-0 bg-gradient-to-br from-primary/10 via-transparent to-transparent opacity-50\" />\n            <CardHeader>\n              <CardTitle className=\"flex items-center gap-2 text-white\">\n                <Users className=\"w-5 h-5 text-primary\" />\n                Omni-Swarm Sync\n              </CardTitle>\n              <CardDescription>Real-time neural frequency resonance</CardDescription>\n            </CardHeader>\n            <CardContent className=\"space-y-6 relative z-10\">\n              {swarmSync ? (\n                <>\n                  <div className=\"flex flex-col items-center py-4\">\n                    <div className=\"relative w-32 h-32 flex items-center justify-center\">\n                      <div className=\"absolute inset-0 rounded-full border-4 border-slate-900\" />\n                      <div\n                        className=\"absolute inset-0 rounded-full border-4 border-primary animate-[pulse_2s_infinite]\"\n                        style={{ opacity: swarmSync.syncEfficiency }}\n                      />\n                      <div className=\"text-4xl font-black text-white\">\n                        {Math.round(swarmSync.totalResonance)}\n                        <span className=\"text-sm font-normal text-slate-500\">%</span>\n                      </div>\n                    </div>\n                    <div className=\"mt-4 text-xs font-mono text-primary uppercase tracking-widest\">\n                      Resonance Frequency\n                    </div>\n                  </div>\n\n                  <div className=\"space-y-4\">\n                    <div className=\"flex justify-between items-center text-sm\">\n                      <span className=\"text-slate-400\">Synced Agents</span>\n                      <span className=\"text-white font-bold\">\n                        {swarmSync.activeAgentsCount} Units\n                      </span>\n                    </div>\n                    <div className=\"flex justify-between items-center text-sm\">\n                      <span className=\"text-slate-400\">Amplified Swarm Power</span>\n                      <span className=\"text-cyan-400 font-black\">\n                        +{swarmSync.amplifiedPower} PW\n                      </span>\n                    </div>\n                    <div>\n                      <div className=\"flex justify-between text-[10px] text-slate-500 mb-1 uppercase tracking-tighter\">\n                        Sync Stability\n                      </div>\n                      <Progress value={swarmSync.syncEfficiency * 100} className=\"h-1.5\" />\n                    </div>\n                  </div>\n\n                  <Button className=\"w-full bg-white/5 hover:bg-white/10 text-white rounded-xl border border-white/10 font-mono italic text-xs\">\n                    <Zap className=\"w-3 h-3 mr-2 text-yellow-500 fill-yellow-500\" />\n                    Initialize Swarm Pulse Synchronization\n                  </Button>\n                </>\n              ) : (\n                <div className=\"text-center py-10 text-slate-600\">Calculating neural arrays...</div>\n              )}\n            </CardContent>\n          </Card>\n\n          {/* GOVERNANCE STATS */}\n          <Card className=\"bg-black/40 border-white/5\">\n            <CardHeader className=\"pb-2\">\n              <CardTitle className=\"text-sm text-slate-400 uppercase tracking-widest font-bold\">\n                DAO Health\n              </CardTitle>\n            </CardHeader>\n            <CardContent className=\"space-y-4\">\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-8 h-8 rounded-lg bg-emerald-500/10 flex items-center justify-center border border-emerald-500/20\">\n                  <ShieldCheck className=\"w-4 h-4 text-emerald-400\" />\n                </div>\n                <div>\n                  <div className=\"text-xs text-slate-500\">System Integrity</div>\n                  <div className=\"text-sm font-bold text-white\">OPTIMIZED</div>\n                </div>\n              </div>\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-8 h-8 rounded-lg bg-cyan-500/10 flex items-center justify-center border border-cyan-500/20\">\n                  <CheckCircle2 className=\"w-4 h-4 text-cyan-400\" />\n                </div>\n                <div>\n                  <div className=\"text-xs text-slate-500\">Proposal Quorum</div>\n                  <div className=\"text-sm font-bold text-white\">51% WEIGHTED</div>\n                </div>\n              </div>\n            </CardContent>\n          </Card>\n        </div>\n      </div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\GreenFinancingAssistant.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.4.","line":215,"column":36,"nodeType":"Literal","messageId":"noMagic","endLine":215,"endColumn":39},{"ruleId":"no-magic-n