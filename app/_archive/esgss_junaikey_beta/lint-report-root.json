agic","endLine":210,"endColumn":8},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.4.","line":212,"column":40,"nodeType":"Literal","messageId":"noMagic","endLine":212,"endColumn":43},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.6.","line":212,"column":63,"nodeType":"Literal","messageId":"noMagic","endLine":212,"endColumn":66},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 25.","line":215,"column":23,"nodeType":"Literal","messageId":"noMagic","endLine":215,"endColumn":25},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 50.","line":216,"column":28,"nodeType":"Literal","messageId":"noMagic","endLine":216,"endColumn":30},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 75.","line":217,"column":28,"nodeType":"Literal","messageId":"noMagic","endLine":217,"endColumn":30},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 2000.","line":268,"column":35,"nodeType":"Literal","messageId":"noMagic","endLine":268,"endColumn":39},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.01.","line":285,"column":68,"nodeType":"Literal","messageId":"noMagic","endLine":285,"endColumn":72},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 2000.","line":312,"column":35,"nodeType":"Literal","messageId":"noMagic","endLine":312,"endColumn":39},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 2000.","line":330,"column":35,"nodeType":"Literal","messageId":"noMagic","endLine":330,"endColumn":39},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 95.","line":357,"column":18,"nodeType":"Literal","messageId":"noMagic","endLine":357,"endColumn":20},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 85.","line":358,"column":18,"nodeType":"Literal","messageId":"noMagic","endLine":358,"endColumn":20},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 75.","line":359,"column":18,"nodeType":"Literal","messageId":"noMagic","endLine":359,"endColumn":20},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 65.","line":360,"column":18,"nodeType":"Literal","messageId":"noMagic","endLine":360,"endColumn":20},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 55.","line":361,"column":18,"nodeType":"Literal","messageId":"noMagic","endLine":361,"endColumn":20},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 45.","line":362,"column":18,"nodeType":"Literal","messageId":"noMagic","endLine":362,"endColumn":20},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.5.","line":391,"column":92,"nodeType":"Literal","messageId":"noMagic","endLine":391,"endColumn":95},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 30.","line":401,"column":96,"nodeType":"Literal","messageId":"noMagic","endLine":401,"endColumn":98},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 6.","line":412,"column":48,"nodeType":"Literal","messageId":"noMagic","endLine":412,"endColumn":49},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.8.","line":467,"column":48,"nodeType":"Literal","messageId":"noMagic","endLine":467,"endColumn":51},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.2.","line":467,"column":89,"nodeType":"Literal","messageId":"noMagic","endLine":467,"endColumn":92},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.7.","line":469,"column":49,"nodeType":"Literal","messageId":"noMagic","endLine":469,"endColumn":52},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.3.","line":470,"column":53,"nodeType":"Literal","messageId":"noMagic","endLine":470,"endColumn":56},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10000.","line":504,"column":67,"nodeType":"Literal","messageId":"noMagic","endLine":504,"endColumn":72},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.5.","line":508,"column":26,"nodeType":"Literal","messageId":"noMagic","endLine":508,"endColumn":29},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.3.","line":508,"column":46,"nodeType":"Literal","messageId":"noMagic","endLine":508,"endColumn":49},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.2.","line":508,"column":68,"nodeType":"Literal","messageId":"noMagic","endLine":508,"endColumn":71},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.3.","line":513,"column":35,"nodeType":"Literal","messageId":"noMagic","endLine":513,"endColumn":38},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.2.","line":514,"column":29,"nodeType":"Literal","messageId":"noMagic","endLine":514,"endColumn":32},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.2.","line":515,"column":34,"nodeType":"Literal","messageId":"noMagic","endLine":515,"endColumn":37},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.15.","line":516,"column":32,"nodeType":"Literal","messageId":"noMagic","endLine":516,"endColumn":36},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.15.","line":517,"column":26,"nodeType":"Literal","messageId":"noMagic","endLine":517,"endColumn":30}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":43,"fixableErrorCount":0,"fixableWarningCount":0,"source":"// ESG撠惇??\nexport interface CarbonEmission {\n  id: string;\n  companyId: string;\n  year: number;\n  scope1: number; // ?湔?\n  scope2: number; // ?? (?賣?)\n  scope3: number; // ?嗡???\n  total: number;\n  reductionTarget: number;\n  reductionAchieved: number;\n  verificationStatus: 'pending' | 'verified' | 'rejected';\n  dataSource: string;\n  lastUpdated: number;\n}\n\nexport interface SocialImpact {\n  id: string;\n  companyId: string;\n  category: 'employees' | 'supply_chain' | 'community' | 'diversity';\n  metric: string;\n  value: number;\n  target: number;\n  unit: string;\n  year: number;\n  verified: boolean;\n  stakeholders: string[];\n}\n\nexport interface GovernanceScore {\n  id: string;\n  companyId: string;\n  year: number;\n  boardComposition: number; // ???????(0-100)\n  executiveCompensation: number; // 蝬?鈭箄?祇?摨?(0-100)\n  shareholderRights: number; // ?⊥甈? (0-100)\n  auditQuality: number; // 撖抵??釭 (0-100)\n  riskManagement: number; // 憸券蝞∠? (0-100)\n  overallScore: number; // 蝮賡?瘝餌?閰? (0-100)\n  rating: 'AAA' | 'AA' | 'A' | 'BBB' | 'BB' | 'B' | 'CCC';\n  lastAssessed: number;\n}\n\nexport interface ESGReport {\n  id: string;\n  companyId: string;\n  title: string;\n  type: 'annual' | 'sustainability' | 'integrated' | 'impact';\n  year: number;\n  environmental: {\n    carbonFootprint: number;\n    energyConsumption: number;\n    waterUsage: number;\n    wasteGeneration: number;\n    biodiversityImpact: number;\n  };\n  social: {\n    employeeSatisfaction: number;\n    diversityIndex: number;\n    communityInvestment: number;\n    supplyChainEthics: number;\n    humanRights: number;\n  };\n  governance: {\n    transparencyScore: number;\n    stakeholderEngagement: number;\n    ethicalConduct: number;\n    regulatoryCompliance: number;\n  };\n  overallScore: number;\n  rating: 'A+' | 'A' | 'B+' | 'B' | 'C+' | 'C' | 'D';\n  status: 'draft' | 'review' | 'published' | 'archived';\n  publishedAt?: number;\n  verifiedBy?: string;\n}\n\n// ESG設計撘?\nexport class ESGCalculator {\n  // 設計蝣單??曉撥摨吒n  static calculateCarbonIntensity(emissions: number, revenue: number): number {\n    return revenue > 0 ? (emissions / revenue) * 1000000 : 0; // ?睜O2/?曇蝢??\n  }\n\n  // 設計ESG蝬?閰?\n  static calculateOverallScore(\n    environmentalScore: number,\n    socialScore: number,\n    governanceScore: number,\n    weights = { environmental: 0.3, social: 0.3, governance: 0.4 }\n  ): number {\n    return (\n      environmentalScore * weights.environmental +\n      socialScore * weights.social +\n      governanceScore * weights.governance\n    );\n  }\n\n  // 設計永續?澆??格? (SDGs) 鞎Ｙ摨吒n  static calculateSDGContribution(\n    actions: Array<{\n      sdg: number;\n      impact: number;\n      confidence: number;\n    }>\n  ): Record<number, number> {\n    const contributions: Record<number, number> = {};\n\n    actions.forEach(action => {\n      const currentVal = contributions[action.sdg] || 0;\n      contributions[action.sdg] = currentVal + action.impact * action.confidence;\n    });\n\n    return contributions;\n  }\n\n  // 設計憭????稞n  static calculateDiversityIndex(workforce: {\n    gender: { male: number; female: number; other: number };\n    age: { under30: number; age30to50: number; over50: number };\n    ethnicity: Record<string, number>;\n  }): number {\n    const totalEmployees = Object.values(workforce.gender).reduce((a, b) => a + b, 0);\n\n    if (totalEmployees === 0) return 0;\n\n    // ?批憭???(0-25??\n    const genderRatio = Math.min(workforce.gender.female / totalEmployees, 0.5) * 2;\n    const genderScore = genderRatio * 25;\n\n    // 撟湧翩憭???(0-25??\n    const ageDistribution = Object.values(workforce.age).map(count => count / totalEmployees);\n    const ageEntropy = -ageDistribution.reduce((sum, p) => sum + (p > 0 ? p * Math.log2(p) : 0), 0);\n    const maxEntropy = Math.log2(3); // 3?僑朣∠?\n    const ageScore = (ageEntropy / maxEntropy) * 25;\n\n    // 蝔格?憭???(0-50??\n    const ethnicityValues = Object.values(workforce.ethnicity);\n    const ethnicityTotal = ethnicityValues.reduce((a, b) => a + b, 0);\n    const ethnicityDistribution = ethnicityValues.map(count => count / ethnicityTotal);\n    const ethnicityEntropy = -ethnicityDistribution.reduce(\n      (sum, p) => sum + (p > 0 ? p * Math.log2(p) : 0),\n      0\n    );\n    const ethnicityMaxEntropy = Math.log2(ethnicityValues.length);\n    const ethnicityScore = (ethnicityEntropy / ethnicityMaxEntropy) * 50;\n\n    return Math.min(genderScore + ageScore + ethnicityScore, 100);\n  }\n\n  // 設計靘??◢?芾??n  static calculateSupplyChainRisk(\n    suppliers: Array<{\n      name: string;\n      country: string;\n      riskFactors: {\n        environmental: number; // 0-100\n        social: number; // 0-100\n        governance: number; // 0-100\n        geopolitical: number; // 0-100\n      };\n      revenue: number; // 靘???亙?瘥n    }>\n  ): number {\n    let weightedRisk = 0;\n    let totalWeight = 0;\n\n    suppliers.forEach(supplier => {\n      const supplierRisk =\n        supplier.riskFactors.environmental * 0.25 +\n        supplier.riskFactors.social * 0.35 +\n        supplier.riskFactors.governance * 0.25 +\n        supplier.riskFactors.geopolitical * 0.15;\n\n      weightedRisk += supplierRisk * supplier.revenue;\n      totalWeight += supplier.revenue;\n    });\n\n    return totalWeight > 0 ? weightedRisk / totalWeight : 0;\n  }\n\n  // 設計瘞???琿◢?芾?隡豹n  static assessClimateRisk(exposure: {\n    physical: {\n      acute: number; // ?交折◢??(0-100)\n      chronic: number; // ?Ｘ折◢??(0-100)\n    };\n    transition: {\n      policy: number; // ?輻?憸券 (0-100)\n      technology: number; // ?銵◢??(0-100)\n      market: number; // 撣憸券 (0-100)\n    };\n    opportunities: {\n      resourceEfficiency: number; // 鞈?合約璈? (0-100)\n      energyTransition: number; // ?賣?頧?璈? (0-100)\n      productInnovation: number; // ?Ｗ??菜璈? (0-100)\n    };\n  }): {\n    overallRisk: number;\n    riskLevel: 'low' | 'medium' | 'high' | 'critical';\n    opportunities: number;\n  } {\n    const physicalRisk = (exposure.physical.acute + exposure.physical.chronic) / 2;\n    const transitionRisk =\n      (exposure.transition.policy + exposure.transition.technology + exposure.transition.market) /\n      3;\n    const opportunities =\n      (exposure.opportunities.resourceEfficiency +\n        exposure.opportunities.energyTransition +\n        exposure.opportunities.productInnovation) /\n      3;\n\n    const overallRisk = physicalRisk * 0.4 + transitionRisk * 0.6;\n\n    let riskLevel: 'low' | 'medium' | 'high' | 'critical';\n    if (overallRisk < 25) riskLevel = 'low';\n    else if (overallRisk < 50) riskLevel = 'medium';\n    else if (overallRisk < 75) riskLevel = 'high';\n    else riskLevel = 'critical';\n\n    return {\n      overallRisk,\n      riskLevel,\n      opportunities,\n    };\n  }\n\n  // 設計?拍??賊????漲\n  static calculateStakeholderEngagement(\n    stakeholders: Array<{\n      type: 'employees' | 'investors' | 'customers' | 'suppliers' | 'communities' | 'regulators';\n      engagementLevel: number; // 0-100\n      satisfaction: number; // 0-100\n      influence: number; // 0-100\n    }>\n  ): {\n    overallEngagement: number;\n    satisfactionIndex: number;\n    influenceIndex: number;\n  } {\n    const totalInfluence = stakeholders.reduce((sum, s) => sum + s.influence, 0);\n\n    const weightedEngagement = stakeholders.reduce((sum, s) => {\n      const weight = s.influence / totalInfluence;\n      return sum + s.engagementLevel * weight;\n    }, 0);\n\n    const weightedSatisfaction = stakeholders.reduce((sum, s) => {\n      const weight = s.influence / totalInfluence;\n      return sum + s.satisfaction * weight;\n    }, 0);\n\n    const averageInfluence = totalInfluence / stakeholders.length;\n\n    return {\n      overallEngagement: weightedEngagement,\n      satisfactionIndex: weightedSatisfaction,\n      influenceIndex: averageInfluence,\n    };\n  }\n}\n\n// ESG數據撽??沔nexport class ESGDataValidator {\n  // 撽?蝣單??暹?n  static validateCarbonData(data: Partial<CarbonEmission>): { isValid: boolean; errors: string[] } {\n    const errors: string[] = [];\n\n    if (data.year && (data.year < 2000 || data.year > new Date().getFullYear() + 1)) {\n      errors.push('撟港遢敹???000?唳?撟港???);\n    }\n\n    if (data.scope1 !== undefined && data.scope1 < 0) {\n      errors.push('Scope 1?銝?箄???);\n    }\n\n    if (data.scope2 !== undefined && data.scope2 < 0) {\n      errors.push('Scope 2?銝?箄???);\n    }\n\n    if (data.scope3 !== undefined && data.scope3 < 0) {\n      errors.push('Scope 3?銝?箄???);\n    }\n\n    const total = (data.scope1 || 0) + (data.scope2 || 0) + (data.scope3 || 0);\n    if (data.total !== undefined && Math.abs(data.total - total) > 0.01) {\n      errors.push('蝮賣??暸??cope 1+2+3?蜇???寥?');\n    }\n\n    if (data.reductionTarget !== undefined && data.reductionTarget < 0) {\n      errors.push('皜??格?銝?箄???);\n    }\n\n    if (data.reductionAchieved !== undefined && data.reductionAchieved < 0) {\n      errors.push('撌脣祕?暹???銝?箄???);\n    }\n\n    return { isValid: errors.length === 0, errors };\n  }\n\n  // 撽?蝷暹?敶梢數據\n  static validateSocialData(data: Partial<SocialImpact>): { isValid: boolean; errors: string[] } {\n    const errors: string[] = [];\n\n    if (!data.category) {\n      errors.push('敹???憿');\n    }\n\n    if (!data.metric) {\n      errors.push('敹??????迂');\n    }\n\n    if (data.year && (data.year < 2000 || data.year > new Date().getFullYear() + 1)) {\n      errors.push('撟港遢敹???000?唳?撟港???);\n    }\n\n    if (data.target !== undefined && data.target < 0) {\n      errors.push('?格??潔??賜鞎');\n    }\n\n    return { isValid: errors.length === 0, errors };\n  }\n\n  // 撽?瘝餌?閰?\n  static validateGovernanceData(data: Partial<GovernanceScore>): {\n    isValid: boolean;\n    errors: string[];\n  } {\n    const errors: string[] = [];\n\n    if (data.year && (data.year < 2000 || data.year > new Date().getFullYear() + 1)) {\n      errors.push('撟港遢敹???000?唳?撟港???);\n    }\n\n    const scoreFields = [\n      'boardComposition',\n      'executiveCompensation',\n      'shareholderRights',\n      'auditQuality',\n      'riskManagement',\n    ];\n    scoreFields.forEach(field => {\n      const value = (data as any)[field];\n      if (value !== undefined && (value < 0 || value > 100)) {\n        errors.push(`${field}閰?敹???-100銋?`);\n      }\n    });\n\n    if (data.overallScore !== undefined && (data.overallScore < 0 || data.overallScore > 100)) {\n      errors.push('?湧?閰?敹???-100銋?');\n    }\n\n    return { isValid: errors.length === 0, errors };\n  }\n\n  // ?寞?閰?蝣箏?蝑?\n  static getRatingFromScore(score: number): 'A+' | 'A' | 'B+' | 'B' | 'C+' | 'C' | 'D' {\n    if (score >= 95) return 'A+';\n    if (score >= 85) return 'A';\n    if (score >= 75) return 'B+';\n    if (score >= 65) return 'B';\n    if (score >= 55) return 'C+';\n    if (score >= 45) return 'C';\n    return 'D';\n  }\n\n  // 瑼Ｘ數據銝?湔吭n  static checkDataConsistency(reports: ESGReport[]): {\n    inconsistencies: Array<{\n      reportId: string;\n      field: string;\n      issue: string;\n    }>;\n    score: number; // 0-100, 數據銝?湔扯??n  } {\n    const inconsistencies: Array<{\n      reportId: string;\n      field: string;\n      issue: string;\n    }> = [];\n\n    // 瑼Ｘ撟游漲頞典???湔吭n    const sortedReports = reports.sort((a, b) => a.year - b.year);\n\n    for (let i = 1; i < sortedReports.length; i++) {\n      const current = sortedReports[i];\n      const previous = sortedReports[i - 1];\n\n      if (!current || !previous) continue;\n\n      // ?啣???頞典瑼Ｘ\n      if (current.environmental.carbonFootprint < previous.environmental.carbonFootprint * 0.5) {\n        inconsistencies.push({\n          reportId: current.id,\n          field: 'environmental.carbonFootprint',\n          issue: `蝣唾雲頝∪?${previous.year}撟渡?${previous.environmental.carbonFootprint}憭批?銝???{current.environmental.carbonFootprint}嚗?蝣箄?數據皞Ⅱ?呎,\n        });\n      }\n\n      // 蝷暹???????扳炎?功n      if (\n        Math.abs(current.social.employeeSatisfaction - previous.social.employeeSatisfaction) > 30\n      ) {\n        inconsistencies.push({\n          reportId: current.id,\n          field: 'social.employeeSatisfaction',\n          issue: `?∪極皛踵?摨西???憭?(${previous.social.employeeSatisfaction} ??${current.social.employeeSatisfaction})`,\n        });\n      }\n    }\n\n    // 設計銝?湔扯??n    const totalChecks = sortedReports.length * 6; // 瘥???蜓閬?璅n    const consistencyScore = Math.max(0, 100 - (inconsistencies.length / totalChecks) * 100);\n\n    return {\n      inconsistencies,\n      score: consistencyScore,\n    };\n  }\n}\n\n// ESG?勗?多元核心?沔nexport class ESGReportGenerator {\n  static generateAnnualReport(\n    companyId: string,\n    year: number,\n    data: {\n      carbonData: CarbonEmission[];\n      socialData: SocialImpact[];\n      governanceData: GovernanceScore;\n    }\n  ): ESGReport {\n    // 設計?啣?閰?\n    const latestCarbon = data.carbonData\n      .filter(c => c.year === year)\n      .sort((a, b) => b.lastUpdated - a.lastUpdated)[0];\n\n    const environmental = {\n      carbonFootprint: latestCarbon?.total || 0,\n      energyConsumption: 0, // ?閬?憭?n      waterUsage: 0,\n      wasteGeneration: 0,\n      biodiversityImpact: 0,\n    };\n\n    // 設計蝷暹?閰?\n    const socialMetrics = data.socialData.filter(s => s.year === year);\n    const social = {\n      employeeSatisfaction:\n        socialMetrics.find(m => m.category === 'employees' && m.metric === 'satisfaction')?.value ||\n        0,\n      diversityIndex:\n        socialMetrics.find(m => m.category === 'diversity' && m.metric === 'index')?.value || 0,\n      communityInvestment:\n        socialMetrics.find(m => m.category === 'community' && m.metric === 'investment')?.value ||\n        0,\n      supplyChainEthics:\n        socialMetrics.find(m => m.category === 'supply_chain' && m.metric === 'ethics')?.value || 0,\n      humanRights:\n        socialMetrics.find(m => m.category === 'supply_chain' && m.metric === 'human_rights')\n          ?.value || 0,\n    };\n\n    // 瘝餌?閰?\n    const governance = {\n      transparencyScore:\n        data.governanceData.boardComposition * 0.8 + data.governanceData.auditQuality * 0.2,\n      stakeholderEngagement:\n        data.governanceData.shareholderRights * 0.7 +\n        data.governanceData.executiveCompensation * 0.3,\n      ethicalConduct: data.governanceData.riskManagement,\n      regulatoryCompliance:\n        (data.governanceData.auditQuality + data.governanceData.riskManagement) / 2,\n    };\n\n    // 設計?湧?閰?\n    const environmentalScore = this.calculateEnvironmentalScore(environmental);\n    const socialScore = this.calculateSocialScore(social);\n    const governanceScore = data.governanceData.overallScore;\n\n    const overallScore = ESGCalculator.calculateOverallScore(\n      environmentalScore,\n      socialScore,\n      governanceScore\n    );\n\n    return {\n      id: `report_${companyId}_${year}`,\n      companyId,\n      title: `${year}撟游漲ESG永續?勗?`,\n      type: 'annual',\n      year,\n      environmental,\n      social,\n      governance,\n      overallScore,\n      rating: ESGDataValidator.getRatingFromScore(overallScore),\n      status: 'draft',\n    };\n  }\n\n  private static calculateEnvironmentalScore(data: ESGReport['environmental']): number {\n    // 蝪∪??憓???蝞n    const carbonScore = Math.max(0, 100 - (data.carbonFootprint / 10000) * 100);\n    const energyScore = 80; // ?身?潘??閬祕??n    const resourceScore = 75; // ?身?潘??閬祕??n\n    return carbonScore * 0.5 + energyScore * 0.3 + resourceScore * 0.2;\n  }\n\n  private static calculateSocialScore(data: ESGReport['social']): number {\n    return (\n      data.employeeSatisfaction * 0.3 +\n      data.diversityIndex * 0.2 +\n      data.communityInvestment * 0.2 +\n      data.supplyChainEthics * 0.15 +\n      data.humanRights * 0.15\n    );\n  }\n}\n\n// ?典?撖虫?\nexport const esgCalculator = new ESGCalculator();\nexport const esgValidator = new ESGDataValidator();\nexport const esgReportGenerator = new ESGReportGenerator();\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\services\\esgAiService.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1500.","line":44,"column":35,"nodeType":"Literal","messageId":"noMagic","endLine":44,"endColumn":39},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 2000.","line":69,"column":35,"nodeType":"Literal","messageId":"noMagic","endLine":69,"endColumn":39},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":75,"column":20,"nodeType":"Literal","messageId":"noMagic","endLine":75,"endColumn":22},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 12.","line":75,"column":24,"nodeType":"Literal","messageId":"noMagic","endLine":75,"endColumn":26},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 15.","line":75,"column":28,"nodeType":"Literal","messageId":"noMagic","endLine":75,"endColumn":30},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 18.","line":75,"column":32,"nodeType":"Literal","messageId":"noMagic","endLine":75,"endColumn":34},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 20.","line":75,"column":36,"nodeType":"Literal","messageId":"noMagic","endLine":75,"endColumn":38},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 500.","line":88,"column":35,"nodeType":"Literal","messageId":"noMagic","endLine":88,"endColumn":38}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":8,"fixableErrorCount":0,"fixableWarningCount":0,"source":"// ESG AI Service - M3 Intelligence Module\n// Classified under: ?扳?賢惜 (Cognitive Intelligence Layer)\nimport { omniLogger, LogCategory } from '@/omni/infrastructure/logging/OmniLogger';\nimport { BehaviorSubject } from 'rxjs';\n\n// AI Request Interface\nexport interface AiRequest {\n  id: string;\n  type: 'insight' | 'prediction' | 'sentiment' | 'summary';\n  payload: any;\n  timestamp: number;\n}\n\n// AI Response Interface\nexport interface AiResponse {\n  requestId: string;\n  result: any;\n  confidence: number; // 0-1\n  processingTime: number; // ms\n}\n\n// Service Class\nexport class EsgAiService {\n  private static instance: EsgAiService;\n  private isProcessing = false;\n\n  private constructor() {}\n\n  static getInstance(): EsgAiService {\n    if (!EsgAiService.instance) {\n      EsgAiService.instance = new EsgAiService();\n    }\n    return EsgAiService.instance;\n  }\n\n  // Generate Insights\n  async generateInsights(data: any): Promise<AiResponse> {\n    const start = Date.now();\n    omniLogger.info(LogCategory.AI, 'Generating ESG insights', {\n      dataSize: JSON.stringify(data).length,\n    });\n\n    // Simulate AI processing\n    await this.simulateProcessing(1500);\n\n    return {\n      requestId: `req_${Date.now()}`,\n      result: {\n        summary: 'ESG 蝮暹??甇??頞典 (ESG performance is trending positive).',\n        highlights: [\n          '蝣單??璅歇體驗 (Carbon reduction target met)',\n          '?∪極皛踵?摨行???5% (Employee satisfaction up 5%)',\n        ],\n        recommendations: [\n          '?????賣? (Invest in renewable energy)',\n          '??靘???摨?(Improve supply chain transparency)',\n        ],\n      },\n      confidence: 0.88,\n      processingTime: Date.now() - start,\n    };\n  }\n\n  // Predict Trends\n  async predictTrends(historicalData: any[]): Promise<AiResponse> {\n    const start = Date.now();\n    omniLogger.info(LogCategory.AI, 'Predicting ESG trends', { points: historicalData.length });\n\n    await this.simulateProcessing(2000);\n\n    return {\n      requestId: `req_${Date.now()}`,\n      result: {\n        trend: '銝?頞典 (Upward)',\n        forecast: [10, 12, 15, 18, 20], // Mock forecast\n        volatility: '雿?(Low)',\n      },\n      confidence: 0.85,\n      processingTime: Date.now() - start,\n    };\n  }\n\n  // Sentiment Analysis\n  async analyzeSentiment(text: string): Promise<AiResponse> {\n    const start = Date.now();\n    omniLogger.info(LogCategory.AI, 'Analyzing sentiment', { textLength: text.length });\n\n    await this.simulateProcessing(500);\n\n    return {\n      requestId: `req_${Date.now()}`,\n      result: {\n        sentiment: '甇? (Positive)',\n        score: 0.75,\n        keywords: ['? (Growth)', '永續 (Sustainable)', '?菜 (Innovation)'],\n      },\n      confidence: 0.92,\n      processingTime: Date.now() - start,\n    };\n  }\n\n  // Private: Simulate AI Delay\n  private async simulateProcessing(ms: number): Promise<void> {\n    this.isProcessing = true;\n    return new Promise(resolve =>\n      setTimeout(() => {\n        this.isProcessing = false;\n        resolve();\n      }, ms)\n    );\n  }\n}\n\nexport const esgAiService = EsgAiService.getInstance();\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\services\\esgCardService.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":96,"column":42,"nodeType":"Literal","messageId":"noMagic","endLine":96,"endColumn":44},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":96,"column":47,"nodeType":"Literal","messageId":"noMagic","endLine":96,"endColumn":49},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":109,"column":42,"nodeType":"Literal","messageId":"noMagic","endLine":109,"endColumn":44},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":109,"column":47,"nodeType":"Literal","messageId":"noMagic","endLine":109,"endColumn":49},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 24.","line":109,"column":52,"nodeType":"Literal","messageId":"noMagic","endLine":109,"endColumn":54},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":122,"column":42,"nodeType":"Literal","messageId":"noMagic","endLine":122,"endColumn":44},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":122,"column":47,"nodeType":"Literal","messageId":"noMagic","endLine":122,"endColumn":49},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 48.","line":122,"column":52,"nodeType":"Literal","messageId":"noMagic","endLine":122,"endColumn":54},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 50.","line":151,"column":48,"nodeType":"Literal","messageId":"noMagic","endLine":151,"endColumn":50},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":151,"column":54,"nodeType":"Literal","messageId":"noMagic","endLine":151,"endColumn":56}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":10,"fixableErrorCount":0,"fixableWarningCount":0,"source":"// ESG Card Service - M5 Knowledge Module\n// Classified under: ?扳?賢惜 (Cognitive Intelligence Layer) & 撟喳擃?撅?(Platform Experience Layer)\nimport { omniLogger, LogCategory } from '@/omni/infrastructure/logging/OmniLogger';\nimport { BehaviorSubject } from 'rxjs';\n\n// Card Type Enum\nexport enum CardType {\n  NEWS = 'news',\n  INSIGHT = 'insight',\n  REGULATION = 'regulation',\n  CASE_STUDY = 'case_study',\n  TECH_UPDATE = 'tech_update',\n  EVENT = 'event',\n  PROBLEM = 'problem',\n  SOLUTION = 'solution',\n}\n\n// ESG Card Interface\nexport interface EsgCard {\n  id: string;\n  title: string;\n  summary: string;\n  content: string; // Markdown or HTML\n  type: CardType;\n  tags: string[];\n  source: string;\n  author: string;\n  publishDate: number;\n  imageUrl?: string;\n  impactScore?: number; // 0-100\n  relatedCards?: string[]; // IDs\n  esgCategory?: 'E' | 'S' | 'G';\n  status?: 'active' | 'resolved' | 'pending';\n}\n\n// Service Class\nexport class EsgCardService {\n  private static instance: EsgCardService;\n  private cards: Map<string, EsgCard> = new Map();\n  private cardsSubject = new BehaviorSubject<EsgCard[]>([]);\n\n  private constructor() {\n    this.initializeMockData();\n  }\n\n  static getInstance(): EsgCardService {\n    if (!EsgCardService.instance) {\n      EsgCardService.instance = new EsgCardService();\n    }\n    return EsgCardService.instance;\n  }\n\n  // Get All Cards Observable\n  getCardsObservable() {\n    return this.cardsSubject.asObservable();\n  }\n\n  // Get Cards (Sync snapshot)\n  getCards(): EsgCard[] {\n    return Array.from(this.cards.values()).sort((a, b) => b.publishDate - a.publishDate);\n  }\n\n  // Get Card by ID\n  getCardById(id: string): EsgCard | undefined {\n    return this.cards.get(id);\n  }\n\n  // Get Cards by Type\n  getCardsByType(type: CardType): EsgCard[] {\n    return this.getCards().filter(card => card.type === type);\n  }\n\n  // Search Cards\n  searchCards(query: string): EsgCard[] {\n    const lowerQuery = query.toLowerCase();\n    return this.getCards().filter(\n      card =>\n        card.title.toLowerCase().includes(lowerQuery) ||\n        card.summary.toLowerCase().includes(lowerQuery) ||\n        card.tags.some(tag => tag.toLowerCase().includes(lowerQuery))\n    );\n  }\n\n  // Private: Mock Data\n  private initializeMockData() {\n    const mockCards: EsgCard[] = [\n      {\n        id: 'news_001',\n        title: 'Global Carbon Pricing Reaches New High',\n        summary: 'Major economies agree to standardized carbon pricing mechanisms at COP30.',\n        content: 'Full report content...',\n        type: CardType.NEWS,\n        tags: ['Carbon', 'Policy', 'Economy'],\n        source: 'Global ESG Watch',\n        author: 'AI Analyst',\n        publishDate: Date.now() - 1000 * 60 * 60 * 2, // 2 hours ago\n        impactScore: 92,\n        imageUrl: '/assets/news/carbon_pricing.jpg',\n      },\n      {\n        id: 'tech_001',\n        title: 'New AI Model Optimizes Supply Chain Energy',\n        summary: 'DeepMind releases AlphaSupply, reducing logistics energy consumption by 15%.',\n        content: 'Technical breakdown...',\n        type: CardType.TECH_UPDATE,\n        tags: ['AI', 'Supply Chain', 'Efficiency'],\n        source: 'Tech Tomorrow',\n        author: 'System',\n        publishDate: Date.now() - 1000 * 60 * 60 * 24, // 1 day ago\n        impactScore: 88,\n      },\n      {\n        id: 'reg_001',\n        title: 'EU Green Claims Directive Text Finalized',\n        summary:\n          'Anti-greenwashing regulations to enforce stricter verification starting next quarter.',\n        content: 'Regulation details...',\n        type: CardType.REGULATION,\n        tags: ['EU', 'Regulation', 'Compliance'],\n        source: 'Legal Nexus',\n        author: 'Policy Bot',\n        publishDate: Date.now() - 1000 * 60 * 60 * 48, // 2 days ago\n        impactScore: 95,\n      },\n    ];\n\n    mockCards.forEach(card => this.cards.set(card.id, card));\n    this.cardsSubject.next(this.getCards());\n    omniLogger.info(LogCategory.BUSINESS, 'ESG Card Service initialized with mock data', {\n      count: mockCards.length,\n    });\n  }\n\n  // Problem & Solution Card Logic (OmniCore Support)\n  getPendingProblemCards(): EsgCard[] {\n    // Mock: return empty or random cards\n    return [];\n  }\n\n  generateSolutionCard(problemCard: EsgCard): EsgCard {\n    const solution: EsgCard = {\n      id: `sol_${problemCard.id}`,\n      title: `Solution for ${problemCard.title}`,\n      summary: `Proposed solution...`,\n      content: 'Full solution details...',\n      type: CardType.INSIGHT,\n      tags: ['Solution', ...problemCard.tags],\n      source: 'OmniCore',\n      author: 'OmniAgent',\n      publishDate: Date.now(),\n      impactScore: (problemCard.impactScore || 50) + 10,\n      relatedCards: [problemCard.id],\n    };\n    this.cards.set(solution.id, solution);\n    this.cardsSubject.next(this.getCards());\n    return solution;\n  }\n\n  activateCard(cardId: string): void {\n    const card = this.cards.get(cardId);\n    if (card) {\n      omniLogger.info(LogCategory.BUSINESS, `Card Activated: ${card.title}`, { cardId });\n    }\n  }\n\n  resolveCard(cardId: string): void {\n    const card = this.cards.get(cardId);\n    if (card) {\n      omniLogger.info(LogCategory.BUSINESS, `Card Resolved: ${card.title}`, { cardId });\n    }\n  }\n\n  // OmniCore Support Methods\n  getActiveCards(): EsgCard[] {\n    return this.getCards(); // Return all for now\n  }\n\n  generateEventCardsFromMetrics(metrics: any): EsgCard[] {\n    // Stub implementation\n    return [];\n  }\n}\n\nexport const esgCardService = EsgCardService.getInstance();\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\services\\esgDataCollector.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 85.","line":147,"column":17,"nodeType":"Literal","messageId":"noMagic","endLine":147,"endColumn":19},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":147,"column":38,"nodeType":"Literal","messageId":"noMagic","endLine":147,"endColumn":39},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 70.","line":147,"column":44,"nodeType":"Literal","messageId":"noMagic","endLine":147,"endColumn":46},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":147,"column":65,"nodeType":"Literal","messageId":"noMagic","endLine":147,"endColumn":66},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 92.","line":147,"column":71,"nodeType":"Literal","messageId":"noMagic","endLine":147,"endColumn":73},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3.","line":147,"column":92,"nodeType":"Literal","messageId":"noMagic","endLine":147,"endColumn":93},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 200.","line":156,"column":76,"nodeType":"Literal","messageId":"noMagic","endLine":156,"endColumn":79},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 50.","line":161,"column":46,"nodeType":"Literal","messageId":"noMagic","endLine":161,"endColumn":48},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 220.","line":162,"column":20,"nodeType":"Literal","messageId":"noMagic","endLine":162,"endColumn":23},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.5.","line":162,"column":43,"nodeType":"Literal","messageId":"noMagic","endLine":162,"endColumn":46},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":162,"column":50,"nodeType":"Literal","messageId":"noMagic","endLine":162,"endColumn":51},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 25.","line":167,"column":24,"nodeType":"Literal","messageId":"noMagic","endLine":167,"endColumn":26},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":167,"column":45,"nodeType":"Literal","messageId":"noMagic","endLine":167,"endColumn":46},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":168,"column":21,"nodeType":"Literal","messageId":"noMagic","endLine":168,"endColumn":23},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":168,"column":42,"nodeType":"Literal","messageId":"noMagic","endLine":168,"endColumn":44},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10000.","line":174,"column":51,"nodeType":"Literal","messageId":"noMagic","endLine":174,"endColumn":56},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 50.","line":179,"column":19,"nodeType":"Literal","messageId":"noMagic","endLine":179,"endColumn":21},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":179,"column":40,"nodeType":"Literal","messageId":"noMagic","endLine":179,"endColumn":42},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 30.","line":180,"column":19,"nodeType":"Literal","messageId":"noMagic","endLine":180,"endColumn":21},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":180,"column":40,"nodeType":"Literal","messageId":"noMagic","endLine":180,"endColumn":41}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":20,"fixableErrorCount":0,"fixableWarningCount":0,"source":"// ESG Data Collector - M2 Data Collection Module\nimport { BehaviorSubject, Subscription } from 'rxjs';\nimport { omniLogger, LogCategory } from '@/omni/infrastructure/logging/OmniLogger';\nimport { dataManager, DataOperationResult } from './dataManager';\n\n// Collection Task Interface\nexport interface CollectionTask {\n  id: string;\n  name: string;\n  dataSource: string;\n  interval: number; // Seconds\n  status: 'active' | 'paused' | 'error';\n  lastRun?: number;\n  nextRun?: number;\n  config: Record<string, any>;\n}\n\n// Collector Config\nexport interface CollectorConfig {\n  maxConcurrentTasks: number;\n  defaultInterval: number;\n  retryAttempts: number;\n}\n\n// Main Class\nexport class EsgDataCollector {\n  private static instance: EsgDataCollector;\n  private tasks: Map<string, CollectionTask> = new Map();\n  private timers: Map<string, NodeJS.Timeout> = new Map();\n  private isRunning: boolean = false;\n\n  // Observable for detailed logs if needed\n  private collectionLogs$ = new BehaviorSubject<string[]>([]);\n\n  private constructor() {\n    this.initializeDefaultTasks();\n  }\n\n  static getInstance(): EsgDataCollector {\n    if (!EsgDataCollector.instance) {\n      EsgDataCollector.instance = new EsgDataCollector();\n    }\n    return EsgDataCollector.instance;\n  }\n\n  // Start Collector\n  start(): void {\n    if (this.isRunning) return;\n    this.isRunning = true;\n    omniLogger.info(LogCategory.SYSTEM, 'ESG Data Collector Service Started');\n\n    // Resume all active tasks\n    this.tasks.forEach(task => {\n      if (task.status === 'active') {\n        this.scheduleTask(task);\n      }\n    });\n  }\n\n  // Stop Collector\n  stop(): void {\n    this.isRunning = false;\n    this.timers.forEach(timer => clearInterval(timer));\n    this.timers.clear();\n    omniLogger.info(LogCategory.SYSTEM, 'ESG Data Collector Service Stopped');\n  }\n\n  // Add Task\n  addTask(task: Omit<CollectionTask, 'status'>): string {\n    const newTask: CollectionTask = {\n      ...task,\n      status: 'active',\n    };\n    this.tasks.set(newTask.id, newTask);\n\n    if (this.isRunning) {\n      this.scheduleTask(newTask);\n    }\n\n    return newTask.id;\n  }\n\n  // Remove Task\n  removeTask(taskId: string): boolean {\n    if (this.timers.has(taskId)) {\n      clearInterval(this.timers.get(taskId));\n      this.timers.delete(taskId);\n    }\n    return this.tasks.delete(taskId);\n  }\n\n  // Collect Data Immediately\n  async collectDataNow(taskId: string): Promise<DataOperationResult<any>> {\n    const task = this.tasks.get(taskId);\n    if (!task) {\n      return { success: false, error: 'Task not found' };\n    }\n\n    const startTime = Date.now();\n    try {\n      // Simulation of data collection based on data source\n      const data = await this.simulateCollection(task.dataSource, task.config);\n\n      // Store data using DataManager\n      await dataManager.store(task.dataSource, data);\n\n      task.lastRun = Date.now();\n      task.nextRun = Date.now() + task.interval * 1000;\n\n      return {\n        success: true,\n        data,\n        metadata: {\n          operation: 'collect_data',\n          timestamp: startTime,\n          duration: Date.now() - startTime,\n        },\n      };\n    } catch (error) {\n      task.status = 'error';\n      omniLogger.error(LogCategory.SYSTEM, `Collection failed for task ${taskId}`, { error });\n      return {\n        success: false,\n        error: error instanceof Error ? error.message : 'Unknown error',\n      };\n    }\n  }\n\n  // Private Implementation\n\n  private scheduleTask(task: CollectionTask): void {\n    if (this.timers.has(task.id)) {\n      clearInterval(this.timers.get(task.id));\n    }\n\n    // Interval execution\n    const timer = setInterval(() => {\n      if (this.isRunning && task.status === 'active') {\n        this.collectDataNow(task.id);\n      }\n    }, task.interval * 1000);\n\n    this.timers.set(task.id, timer);\n  }\n\n  public async fetchRealTimeMetrics() {\n    return { E: 85 + Math.random() * 5, S: 70 + Math.random() * 5, G: 92 + Math.random() * 3 };\n  }\n\n  public getConnectionStatus(): 'connected' | 'disconnected' {\n    return this.isRunning ? 'connected' : 'disconnected';\n  }\n\n  private async simulateCollection(source: string, config: any): Promise<any> {\n    // Simulate network delay\n    await new Promise(resolve => setTimeout(resolve, 100 + Math.random() * 200));\n\n    switch (source) {\n      case 'smart_meters':\n        return {\n          power_usage: 100 + Math.random() * 50,\n          voltage: 220 + (Math.random() - 0.5) * 5,\n          timestamp: Date.now(),\n        };\n      case 'iot_sensors':\n        return {\n          temperature: 25 + Math.random() * 5,\n          humidity: 60 + Math.random() * 10,\n          timestamp: Date.now(),\n        };\n      case 'api_connector':\n        return {\n          status: 'ok',\n          external_id: Math.floor(Math.random() * 10000),\n          payload: { value: Math.random() },\n        };\n      case 'carbon_emissions':\n        return {\n          scope1: 50 + Math.random() * 10,\n          scope2: 30 + Math.random() * 5,\n          unit: 'tCO2e',\n        };\n      default:\n        return { value: Math.random(), note: 'Generic simulated data' };\n    }\n  }\n\n  private initializeDefaultTasks(): void {\n    this.tasks.set('default_meter_collection', {\n      id: 'default_meter_collection',\n      name: 'Factory Smart Meter',\n      dataSource: 'smart_meters',\n      interval: 60, // 1 min\n      status: 'active',\n      config: { targets: ['factory_a'] },\n    });\n\n    this.tasks.set('daily_emission_check', {\n      id: 'daily_emission_check',\n      name: 'Daily Carbon Emission',\n      dataSource: 'carbon_emissions',\n      interval: 86400, // 24 hours\n      status: 'active',\n      config: {},\n    });\n  }\n\n  public destroy(): void {\n    this.stop();\n    this.tasks.clear();\n    EsgDataCollector.instance = null!;\n  }\n}\n\nexport const esgDataCollector = EsgDataCollector.getInstance();\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\services\\esgPredictor.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 6.","line":21,"column":23,"nodeType":"Literal","messageId":"noMagic","endLine":21,"endColumn":24},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.25.","line":119,"column":38,"nodeType":"Literal","messageId":"noMagic","endLine":119,"endColumn":42},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.75.","line":120,"column":38,"nodeType":"Literal","messageId":"noMagic","endLine":120,"endColumn":42},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1.5.","line":122,"column":29,"nodeType":"Literal","messageId":"noMagic","endLine":122,"endColumn":32},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1.5.","line":123,"column":29,"nodeType":"Literal","messageId":"noMagic","endLine":123,"endColumn":32},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.3.","line":158,"column":35,"nodeType":"Literal","messageId":"noMagic","endLine":158,"endColumn":38},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.95.","line":170,"column":22,"nodeType":"Literal","messageId":"noMagic","endLine":170,"endColumn":26},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1.05.","line":173,"column":22,"nodeType":"Literal","messageId":"noMagic","endLine":173,"endColumn":26},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3.","line":198,"column":46,"nodeType":"Literal","messageId":"noMagic","endLine":198,"endColumn":47},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: -6.","line":258,"column":31,"nodeType":"UnaryExpression","messageId":"noMagic","endLine":258,"endColumn":33},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.9.","line":267,"column":34,"nodeType":"Literal","messageId":"noMagic","endLine":267,"endColumn":37},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1.1.","line":267,"column":40,"nodeType":"Literal","messageId":"noMagic","endLine":267,"endColumn":43},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1.1.","line":270,"column":34,"nodeType":"Literal","messageId":"noMagic","endLine":270,"endColumn":37},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.9.","line":270,"column":40,"nodeType":"Literal","messageId":"noMagic","endLine":270,"endColumn":43},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.9.","line":297,"column":21,"nodeType":"Literal","messageId":"noMagic","endLine":297,"endColumn":24},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3.","line":304,"column":23,"nodeType":"Literal","messageId":"noMagic","endLine":304,"endColumn":24},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: -3.","line":306,"column":31,"nodeType":"UnaryExpression","messageId":"noMagic","endLine":306,"endColumn":33},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.05.","line":312,"column":28,"nodeType":"Literal","messageId":"noMagic","endLine":312,"endColumn":32},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 30.","line":327,"column":63,"nodeType":"Literal","messageId":"noMagic","endLine":327,"endColumn":65},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 24.","line":327,"column":68,"nodeType":"Literal","messageId":"noMagic","endLine":327,"endColumn":70},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":327,"column":73,"nodeType":"Literal","messageId":"noMagic","endLine":327,"endColumn":75},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":327,"column":78,"nodeType":"Literal","messageId":"noMagic","endLine":327,"endColumn":80},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 30.","line":337,"column":55,"nodeType":"Literal","messageId":"noMagic","endLine":337,"endColumn":57},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 24.","line":337,"column":60,"nodeType":"Literal","messageId":"noMagic","endLine":337,"endColumn":62},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":337,"column":65,"nodeType":"Literal","messageId":"noMagic","endLine":337,"endColumn":67},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":337,"column":70,"nodeType":"Literal","messageId":"noMagic","endLine":337,"endColumn":72},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.5.","line":340,"column":71,"nodeType":"Literal","messageId":"noMagic","endLine":340,"endColumn":74},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.1.","line":340,"column":78,"nodeType":"Literal","messageId":"noMagic","endLine":340,"endColumn":81},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.5.","line":372,"column":33,"nodeType":"Literal","messageId":"noMagic","endLine":372,"endColumn":36},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.5.","line":376,"column":28,"nodeType":"Literal","messageId":"noMagic","endLine":376,"endColumn":31}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":30,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { omniLogger, LogCategory } from '../omni/infrastructure/logging/OmniLogger';\nimport { PredictionResult } from './aiIntelligence';\n\nexport class ESGPredictor {\n  private models: Map<string, any>;\n\n  constructor() {\n    this.models = new Map();\n    this.initializeModels();\n  }\n\n  async predict(params: {\n    metric: string;\n    data: any[];\n    horizon: number;\n    scenario: 'baseline' | 'optimistic' | 'pessimistic';\n    confidenceThreshold: number;\n  }): Promise<PredictionResult> {\n    const { metric, data, scenario, horizon, confidenceThreshold } = params;\n\n    if (data.length < 6) {\n      throw new Error('數據暺?頞喉??喳??閬???數據');\n    }\n\n    // 數據?葫璅∪?\n    const model = this.selectModel(metric);\n\n    // 皞?數據\n    const processedData = this.preprocessData(data);\n\n    // 多元核心?葫\n    const prediction = await this.generatePrediction(processedData, scenario, horizon, model);\n\n    // 設計靽∪?摨吒n    const confidence = this.calculateConfidence(prediction, processedData);\n\n    if (confidence < confidenceThreshold) {\n      omniLogger.warn(\n        LogCategory.AI,\n        `?葫靽∪?摨虫?頞? ${confidence.toFixed(2)} < ${confidenceThreshold}`\n      );\n    }\n\n    const lastValue = processedData.length > 0 ? (processedData[processedData.length - 1] ?? 0) : 0;\n\n    return {\n      metric: params.metric,\n      currentValue: lastValue,\n      predictedValue: prediction.value,\n      confidence,\n      scenario: params.scenario,\n      trend: this.determineTrend(processedData),\n      uncertainty: prediction.uncertainty,\n      dataPoints: this.generateDataPoints(processedData, prediction, horizon),\n    };\n  }\n\n  private initializeModels(): void {\n    // ??????璅??葫璅∪?\n    this.models.set('carbon_emission', {\n      type: 'time_series',\n      algorithm: 'exponential_smoothing',\n      parameters: { alpha: 0.3 },\n    });\n\n    this.models.set('energy_consumption', {\n      type: 'regression',\n      algorithm: 'linear_regression',\n      parameters: { include_seasonality: true },\n    });\n\n    this.models.set('waste_generation', {\n      type: 'time_series',\n      algorithm: 'arima',\n      parameters: { p: 1, d: 1, q: 1 },\n    });\n\n    this.models.set('employee_satisfaction', {\n      type: 'classification',\n      algorithm: 'random_forest',\n      parameters: { n_estimators: 100 },\n    });\n\n    // ?身璅∪?\n    this.models.set('default', {\n      type: 'time_series',\n      algorithm: 'moving_average',\n      parameters: { window: 3 },\n    });\n  }\n\n  private selectModel(metric: string): any {\n    // ?寞???憿?數據璅∪?\n    const m = metric.toLowerCase();\n    if (m.includes('carbon') || m.includes('emission')) {\n      return this.models.get('carbon_emission');\n    }\n    if (m.includes('energy')) {\n      return this.models.get('energy_consumption');\n    }\n    if (m.includes('waste')) {\n      return this.models.get('waste_generation');\n    }\n    if (m.includes('satisfaction') || m.includes('engagement')) {\n      return this.models.get('employee_satisfaction');\n    }\n\n    return this.models.get('default');\n  }\n\n  private preprocessData(data: Array<{ date: string; value: number }>): number[] {\n    // 數據????????撣詨潸??n    const sorted = [...data].sort(\n      (a, b) => new Date(a.date).getTime() - new Date(b.date).getTime()\n    );\n\n    // 蝪∪?撣詨潭炎皜穿?IQR?寞?嚗n    const values = sorted.map(d => d.value);\n    const q1 = this.quantile(values, 0.25);\n    const q3 = this.quantile(values, 0.75);\n    const iqr = q3 - q1;\n    const lowerBound = q1 - 1.5 * iqr;\n    const upperBound = q3 + 1.5 * iqr;\n\n    // ?駁?啣虜?墦n    const filteredValues = values.filter(v => v >= lowerBound && v <= upperBound);\n\n    return filteredValues.length > 0 ? filteredValues : values;\n  }\n\n  private async generatePrediction(\n    data: number[],\n    scenario: string,\n    horizon: number,\n    model: any\n  ): Promise<{ value: number; uncertainty: number; details: any }> {\n    switch (model.algorithm) {\n      case 'exponential_smoothing':\n        return this.exponentialSmoothing(data, scenario, horizon, model.parameters);\n\n      case 'moving_average':\n        return this.movingAverage(data, horizon);\n\n      case 'linear_regression':\n        return this.linearRegression(data, horizon, model.parameters);\n\n      default:\n        return this.simpleExtrapolation(data, scenario, horizon);\n    }\n  }\n\n  private exponentialSmoothing(\n    data: number[],\n    scenario: string,\n    horizon: number,\n    params: any\n  ): { value: number; uncertainty: number; details: any } {\n    const alpha = params.alpha || 0.3;\n    let smoothed = data.length > 0 ? (data[0] ?? 0) : 0;\n\n    // 設計撟單??墦n    for (let i = 1; i < data.length; i++) {\n      smoothed = alpha * (data[i] ?? 0) + (1 - alpha) * smoothed;\n    }\n\n    // ?寞???隤踵\n    let adjustment = 1.0;\n    switch (scenario) {\n      case 'optimistic':\n        adjustment = 0.95; // 5%?孵?\n        break;\n      case 'pessimistic':\n        adjustment = 1.05; // 5%?∪?\n        break;\n      case 'baseline':\n      default:\n        adjustment = 1.0;\n        break;\n    }\n\n    const predictedValue = smoothed * adjustment;\n\n    // 設計銝Ⅱ摰改??箸甇瑕霈?改?\n    const variance = this.calculateVariance(data);\n    const uncertainty = Math.sqrt(variance / data.length) * horizon;\n\n    return {\n      value: predictedValue,\n      uncertainty,\n      details: { method: 'exponential_smoothing', alpha, adjustment },\n    };\n  }\n\n  private movingAverage(\n    data: number[],\n    horizon: number\n  ): { value: number; uncertainty: number; details: any } {\n    const windowSize = Math.min(data.length, 3);\n    const recent = data.slice(-windowSize);\n    const average = recent.reduce((sum, val) => sum + val, 0) / recent.length;\n\n    const variance = this.calculateVariance(recent);\n    const uncertainty = Math.sqrt(variance) * Math.sqrt(horizon);\n\n    return {\n      value: average,\n      uncertainty,\n      details: { method: 'moving_average', window: windowSize },\n    };\n  }\n\n  private linearRegression(\n    data: number[],\n    horizon: number,\n    params: any\n  ): { value: number; uncertainty: number; details: any } {\n    const n = data.length;\n    const x = Array.from({ length: n }, (_, i) => i);\n    const y = data;\n\n    // 蝪∪蝺批?甇稞n    const sumX = x.reduce((a, b) => a + b, 0);\n    const sumY = y.reduce((a, b) => a + b, 0);\n    const sumXY = x.reduce((sum, xi, i) => sum + xi * (y[i] ?? 0), 0);\n    const sumXX = x.reduce((sum, xi) => sum + xi * xi, 0);\n\n    const slope = (n * sumXY - sumX * sumY) / (n * sumXX - sumX * sumX);\n    const intercept = (sumY - slope * sumX) / n;\n\n    // ?葫?芯??墦n    const futureX = n + horizon - 1;\n    const predictedValue = slope * futureX + intercept;\n\n    // 設計R撟單??蝣箏??吭n    const yMean = sumY / n;\n    const ssRes = y.reduce((sum, yi, i) => {\n      const predicted = slope * (x[i] ?? 0) + intercept;\n      return sum + Math.pow((yi ?? 0) - predicted, 2);\n    }, 0);\n    const ssTot = y.reduce((sum, yi) => sum + Math.pow((yi ?? 0) - yMean, 2), 0);\n    const rSquared = 1 - ssRes / ssTot;\n\n    const uncertainty = Math.sqrt(ssRes / (n - 2)) * Math.sqrt(horizon);\n\n    return {\n      value: Math.max(0, predictedValue), // 蝣箔???\n      uncertainty,\n      details: { method: 'linear_regression', slope, intercept, rSquared },\n    };\n  }\n\n  private simpleExtrapolation(\n    data: number[],\n    scenario: string,\n    horizon: number\n  ): { value: number; uncertainty: number; details: any } {\n    // 蝪∪憭嚗蝙完整餈隅?兝n    const recent = data.slice(-6); // ?餈???\n    const trend =\n      recent.length > 1\n        ? ((recent[recent.length - 1] ?? 0) - (recent[0] ?? 0)) / Math.max(1, recent.length - 1)\n        : 0;\n\n    let adjustment = 1.0;\n    switch (scenario) {\n      case 'optimistic':\n        adjustment = trend > 0 ? 0.9 : 1.1;\n        break;\n      case 'pessimistic':\n        adjustment = trend > 0 ? 1.1 : 0.9;\n        break;\n    }\n\n    const extrapolatedValue = (recent[recent.length - 1] ?? 0) + trend * horizon;\n    const predictedValue = extrapolatedValue * adjustment;\n\n    const variance = this.calculateVariance(recent);\n    const uncertainty = Math.sqrt(variance) * horizon;\n\n    return {\n      value: Math.max(0, predictedValue),\n      uncertainty,\n      details: { method: 'simple_extrapolation', trend, adjustment },\n    };\n  }\n\n  private calculateConfidence(prediction: any, data: number[]): number {\n    // ?箸?葫銝Ⅱ摰批?數據?釭設計靽∪?摨吒n    const uncertaintyRatio = prediction.uncertainty / Math.max(1, Math.abs(prediction.value));\n    const dataConsistency = this.calculateDataConsistency(data);\n\n    // 蝪∪??縑敹漲設計\n    let confidence = Math.max(0, 1 - uncertaintyRatio - (1 - dataConsistency));\n\n    // ??隤踵\n    if (prediction.details.adjustment && prediction.details.adjustment !== 1.0) {\n      confidence *= 0.9; // ???葫靽∪?摨衣雿n    }\n\n    return Math.min(1, Math.max(0, confidence));\n  }\n\n  private determineTrend(data: number[]): 'increasing' | 'decreasing' | 'stable' {\n    if (data.length < 3) return 'stable';\n\n    const recent = data.slice(-3);\n    const first = recent[0] ?? 0;\n    const last = recent[recent.length - 1] ?? 0;\n\n    const change = first === 0 ? 0 : (last - first) / first;\n\n    if (Math.abs(change) < 0.05) return 'stable'; // 5%隞亙閬蝛拙?\n    return change > 0 ? 'increasing' : 'decreasing';\n  }\n\n  private generateDataPoints(\n    historical: number[],\n    prediction: any,\n    horizon: number\n  ): Array<{ date: string; value: number; predicted: boolean }> {\n    const points: Array<{ date: string; value: number; predicted: boolean }> = [];\n\n    // 甇瑕數據暺n    historical.forEach((value, index) => {\n      points.push({\n        date:\n          new Date(Date.now() - (historical.length - index) * 30 * 24 * 60 * 60 * 1000)\n            .toISOString()\n            .split('T')[0] || '',\n        value,\n        predicted: false,\n      });\n    });\n\n    // ?葫數據暺n    for (let i = 1; i <= horizon; i++) {\n      const predictedDate = new Date(Date.now() + i * 30 * 24 * 60 * 60 * 1000)\n        .toISOString()\n        .split('T')[0];\n      const predictedValue = prediction.value * (1 + (Math.random() - 0.5) * 0.1); // 瘛餃?銝鈭??豹n\n      points.push({\n        date: predictedDate || '',\n        value: predictedValue,\n        predicted: true,\n      });\n    }\n\n    return points;\n  }\n\n  private quantile(arr: number[], q: number): number {\n    const sorted = [...arr].sort((a, b) => a - b);\n    const pos = (sorted.length - 1) * q;\n    const base = Math.floor(pos);\n    const rest = pos - base;\n    if (sorted[base + 1] !== undefined) {\n      return (sorted[base] ?? 0) + rest * ((sorted[base + 1] ?? 0) - (sorted[base] ?? 0));\n    } else {\n      return sorted[base] ?? 0;\n    }\n  }\n\n  private calculateVariance(data: number[]): number {\n    if (data.length === 0) return 0;\n    const mean = data.reduce((sum, val) => sum + val, 0) / data.length;\n    const squaredDiffs = data.map(val => Math.pow(val - mean, 2));\n    return squaredDiffs.reduce((sum, val) => sum + val, 0) / data.length;\n  }\n\n  private calculateDataConsistency(data: number[]): number {\n    if (data.length < 2) return 0.5;\n\n    // 設計霈靽\n    const mean = data.reduce((sum, val) => sum + val, 0) / data.length;\n    if (mean === 0) return 0.5;\n    const variance = this.calculateVariance(data);\n    const cv = Math.sqrt(variance) / Math.abs(mean);\n\n    // 轉換?箔??湔批???(0-1)\n    return Math.max(0, 1 - cv);\n  }\n\n  async isHealthy(): Promise<boolean> {\n    return true;\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\services\\esgTriviaService.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3.","line":25,"column":59,"nodeType":"Literal","messageId":"noMagic","endLine":25,"endColumn":60},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 36.","line":28,"column":56,"nodeType":"Literal","messageId":"noMagic","endLine":28,"endColumn":58},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":28,"column":70,"nodeType":"Literal","messageId":"noMagic","endLine":28,"endColumn":71}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n// Classified under: 撟喳擃?撅?(Platform Experience Layer) & ?扳?賢惜 (Cognitive Intelligence Layer)\n * ESG ?????\n * ESG Trivia Service\n *\n * 邏輯??多元核心??霅??∠?閫??協議\n */\n\nimport {\n  type TriviaQuestion,\n  TriviaDifficulty,\n  type QuizChallenge,\n  type OmniCard,\n  PartnerRarity as Rarity,\n} from '../types/aiPartner';\nimport { ESG_TRIVIA_QUESTIONS } from '../data/esgTrivia';\n// import { partnerImport } from './partnerImportExport'; // ??ㄐ瘝?亦嚗?璅⊥??鈭支?\n\nexport class ESGTriviaService {\n  /**\n   * ?箇摰???圾???豹n   */\n  generateChallengeForCard(partnerId: string, card: OmniCard): QuizChallenge {\n    const difficulty = this.getDifficultyForRarity(card.rarity);\n    const questions = this.getRandomQuestions(difficulty, 3); // 3憿n\n    return {\n      id: `quiz_${Date.now()}_${Math.random().toString(36).substr(2, 5)}`,\n      partnerId,\n      targetCardId: card.id,\n      difficulty,\n      questions,\n      currentQuestionIndex: 0,\n      answers: [],\n      score: 0,\n      startedAt: new Date(),\n      passed: false,\n    };\n  }\n\n  /**\n   * ?漱蝑?\n   */\n  submitAnswer(\n    challenge: QuizChallenge,\n    answerIndex: number\n  ): {\n    isCorrect: boolean;\n    explanation: string;\n    challenge: QuizChallenge;\n    finished: boolean;\n  } {\n    const currentQ = challenge.questions[challenge.currentQuestionIndex];\n\n    // Safety check\n    if (!currentQ) {\n      throw new Error(`Question not found at index ${challenge.currentQuestionIndex}`);\n    }\n\n    const isCorrect = currentQ.correctAnswer === answerIndex;\n\n    // 閮?蝑?\n    challenge.answers.push(answerIndex);\n    if (isCorrect) {\n      challenge.score += 1;\n    }\n\n    const explanation = currentQ.explanation;\n    const totalQuestions = challenge.questions.length;\n\n    // 瑼Ｘ?臬蝯?\n    challenge.currentQuestionIndex += 1;\n    const finished = challenge.currentQuestionIndex >= totalQuestions;\n\n    if (finished) {\n      challenge.completedAt = new Date();\n      // ?閬撠??質圾???(??身摰?\n      challenge.passed = challenge.score === totalQuestions;\n    }\n\n    return {\n      isCorrect,\n      explanation,\n      challenge,\n      finished,\n    };\n  }\n\n  /**\n   * ?寞?蝔?漲瘙箏???漲\n   */\n  private getDifficultyForRarity(rarity: Rarity): TriviaDifficulty {\n    switch (rarity) {\n      case Rarity.COMMON:\n      case Rarity.UNCOMMON:\n        return TriviaDifficulty.EASY;\n      case Rarity.RARE:\n      case Rarity.EPIC:\n        return TriviaDifficulty.MEDIUM;\n      case Rarity.LEGENDARY:\n        return TriviaDifficulty.HARD;\n      case Rarity.MYTHIC:\n        return TriviaDifficulty.MASTER;\n      default:\n        return TriviaDifficulty.EASY;\n    }\n  }\n\n  /**\n   * 完整?脣?憿\n   */\n  private getRandomQuestions(difficulty: TriviaDifficulty, count: number): TriviaQuestion[] {\n    const pool = ESG_TRIVIA_QUESTIONS.filter(q => q.difficulty === difficulty);\n\n    // 憒?憿銝?嚗??陛?桅??娉n    if (pool.length < count) {\n      const easyPool = ESG_TRIVIA_QUESTIONS.filter(q => q.difficulty === TriviaDifficulty.EASY);\n      pool.push(...easyPool);\n    }\n\n    // Fisher-Yates Shuffle\n    const shuffled = [...pool];\n    for (let i = shuffled.length - 1; i > 0; i--) {\n      const j = Math.floor(Math.random() * (i + 1));\n      const temp = shuffled[i] as TriviaQuestion;\n      shuffled[i] = shuffled[j] as TriviaQuestion;\n      shuffled[j] = temp;\n    }\n\n    return shuffled.slice(0, count);\n  }\n}\n\nexport const triviaService = new ESGTriviaService();\nexport default triviaService;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\services\\evolutionAdvisor.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":24,"column":21,"nodeType":"Literal","messageId":"noMagic","endLine":24,"endColumn":23}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"// src/services/evolutionAdvisor.ts\nimport { useOmniHistory } from '../store/useOmniHistory';\nimport { EvolutionLog } from '../core/knowledge/types';\n\nexport interface EvolutionAdvisory {\n  id: string;\n  severity: 'INFO' | 'WARNING' | 'CRITICAL';\n  message: string;\n  recommendation: string;\n}\n\nexport const EvolutionAdvisor = {\n  /**\n   * Ritual: Consult Seraphim\n   * Analyzes entropy logs to provide system evolution advice.\n   */\n  consult: (): EvolutionAdvisory[] => {\n    const { logs } = useOmniHistory.getState();\n    const advisories: EvolutionAdvisory[] = [];\n\n    // 1. Analyze Immune Responses\n    const healCount = logs.filter((l: EvolutionLog) => l.type === 'IMMUNITY_HEAL').length;\n\n    if (healCount > 10) {\n      advisories.push({\n        id: 'adv-01',\n        severity: 'WARNING',\n        message: `High entropy detected: ${healCount} auto-healing events this session.`,\n        recommendation: 'Inspect data sources for API instability. Consider caching strategy.',\n      });\n    } else if (healCount > 0) {\n      advisories.push({\n        id: 'adv-02',\n        severity: 'INFO',\n        message: `Immune system active. ${healCount} minor anomalies neutralized.`,\n        recommendation: 'System resilient. No action required.',\n      });\n    } else {\n      advisories.push({\n        id: 'adv-03',\n        severity: 'INFO',\n        message: 'Entropy levels at ZERO. System operating at peak efficiency.',\n        recommendation: 'Good time to focus on strategic impact projects.',\n      });\n    }\n\n    // 2. Analyze Integration\n    // ... future checks\n\n    return advisories;\n  },\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\services\\externalCalendarService.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 86400000.","line":42,"column":50,"nodeType":"Literal","messageId":"noMagic","endLine":42,"endColumn":58},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 30.","line":42,"column":61,"nodeType":"Literal","messageId":"noMagic","endLine":42,"endColumn":63}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"// src/services/externalCalendarService.ts\n// Classified under: ?扳?賢惜 (Cognitive Intelligence Layer) & 撟喳擃?撅?(Platform Experience Layer)\nimport ICAL from 'ical.js';\nimport { TemporalEvent } from '../core/time/types';\nimport { omniLogger, LogCategory } from '../omni/infrastructure/logging/OmniLogger';\n\n// Define Source Config\nexport interface CalendarSource {\n  id: string;\n  name: string;\n  url: string; // Must be .ics endpoint\n  color: 'blue' | 'gray'; // Blue=Google, Gray=Apple\n  type: 'GOOGLE' | 'APPLE';\n}\n\nexport const ExternalCalendarService = {\n  /**\n   * Ritual: Sync External Time Dimension\n   */\n  async sync(sources: CalendarSource[]): Promise<TemporalEvent[]> {\n    const allEvents: TemporalEvent[] = [];\n\n    for (const source of sources) {\n      try {\n        // 1. Call Proxy\n        const proxyUrl = `/api/calendar-proxy?url=${encodeURIComponent(source.url)}`;\n        const res = await fetch(proxyUrl);\n        const icsText = await res.text();\n\n        // 2. Parse iCal Data\n        const icalAny = ICAL as any;\n        const jcalData = icalAny.parse(icsText);\n        const comp = new icalAny.Component(jcalData);\n        const vevents = comp.getAllSubcomponents('vevent');\n\n        // 3. Transform to System Events\n        vevents.forEach((vevent: any) => {\n          const event = new icalAny.Event(vevent);\n          const startDate = event.startDate.toJSDate();\n\n          // Filter: ignore too old events (30 days ago)\n          if (startDate.getTime() < Date.now() - 86400000 * 30) return;\n\n          allEvents.push({\n            id: `ext-${source.type}-${event.uid}`,\n            date: startDate.toISOString().split('T')[0],\n            type: source.type === 'GOOGLE' ? 'EXTERNAL_GOOGLE' : 'EXTERNAL_APPLE',\n            title: event.summary,\n            intensity: 2, // Low intensity for context\n            contextId: source.name,\n          });\n        });\n      } catch (e) {\n        omniLogger.warn(LogCategory.SYSTEM, `Failed to sync dimension: ${source.name}`, {\n          error: e,\n        });\n      }\n    }\n\n    return allEvents;\n  },\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\services\\external\\impactNexusService.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 800.","line":44,"column":56,"nodeType":"Literal","messageId":"noMagic","endLine":44,"endColumn":59},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 86400000.","line":59,"column":44,"nodeType":"Literal","messageId":"noMagic","endLine":59,"endColumn":52}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * ?? ImpactNexus Service Bridge\n * --------------------------------------------------\n * The Neural Link between JunAiKey (AIOS) and the ImpactNexus Platform.\n *\n * [Function]\n * 1. Fetches raw impact data (Scope 3, Talent training hours).\n * 2. Passes data through the 3+1 Protocol (Genesis Engine).\n * 3. Returns \"Minted\" ITK Assets to the user profile.\n *\n * [Mock Mode] Currently simulates external API responses for development.\n */\n\nimport { omniLogger, LogCategory } from '@/omni/infrastructure/logging/OmniLogger';\n\nexport interface IImpactRecord {\n  id: string; // Original UUID from ImpactNexus\n  type: 'CARBON_REDUCTION' | 'TALENT_TRAINING' | 'COMMUNITY_SERVICE';\n  value: number; // Raw metric (kgCO2, hours, etc.)\n  timestamp: string;\n  proofUrl: string; // URL to verifying document\n}\n\nexport interface IImpactNexusAPI {\n  fetchPendingRecords(userId: string): Promise<IImpactRecord[]>;\n  confirmAssetMinting(recordId: string, assetHash: string): Promise<boolean>;\n}\n\n// Mock Implementation for Phase 5 Pilot\nclass ImpactNexusServiceMock implements IImpactNexusAPI {\n  async fetchPendingRecords(userId: string): Promise<IImpactRecord[]> {\n    if (!userId) {\n      omniLogger.error(LogCategory.INTEGRATION, 'ImpactNexus: Invalid User ID provided.');\n      return [];\n    }\n\n    try {\n      omniLogger.info(\n        LogCategory.INTEGRATION,\n        `?? [ImpactNexus] Connecting to external node for user: ${userId}...`\n      );\n\n      // Simulate network latency\n      await new Promise(resolve => setTimeout(resolve, 800));\n\n      // Simulated \"Live\" Data\n      return [\n        {\n          id: 'NEXUS-RAW-8821',\n          type: 'TALENT_TRAINING',\n          value: 4.5, // hours\n          timestamp: new Date().toISOString(),\n          proofUrl: 'https://impactnexus.co/cert/verify/8821',\n        },\n        {\n          id: 'NEXUS-RAW-9942',\n          type: 'CARBON_REDUCTION',\n          value: 1250, // kgCO2e (e.g. green commuting month)\n          timestamp: new Date(Date.now() - 86400000).toISOString(), // yesterday\n          proofUrl: 'https://impactnexus.co/iot/logs/9942',\n        },\n      ];\n    } catch (error) {\n      omniLogger.error(LogCategory.INTEGRATION, 'ImpactNexus: Failed to fetch records.', { error });\n      return [];\n    }\n  }\n\n  async confirmAssetMinting(recordId: string, assetHash: string): Promise<boolean> {\n    try {\n      omniLogger.info(\n        LogCategory.INTEGRATION,\n        `?? [ImpactNexus] Syncing Hash Lock [${assetHash}] for Record [${recordId}]`\n      );\n      return true;\n    } catch (error) {\n      omniLogger.error(LogCategory.INTEGRATION, `Failed to confirm asset minting for ${recordId}`, {\n        error,\n      });\n      return false;\n    }\n  }\n}\n\nexport const impactNexusService = new ImpactNexusServiceMock();\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\services\\favoriteManager.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 36.","line":50,"column":70,"nodeType":"Literal","messageId":"noMagic","endLine":50,"endColumn":72},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 9.","line":50,"column":84,"nodeType":"Literal","messageId":"noMagic","endLine":50,"endColumn":85},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 36.","line":223,"column":56,"nodeType":"Literal","messageId":"noMagic","endLine":223,"endColumn":58},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 9.","line":223,"column":70,"nodeType":"Literal","messageId":"noMagic","endLine":223,"endColumn":71},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":233,"column":23,"nodeType":"Literal","messageId":"noMagic","endLine":233,"endColumn":24},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 16.","line":236,"column":36,"nodeType":"Literal","messageId":"noMagic","endLine":236,"endColumn":38}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":6,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * 潃?Favorite Manager Service\n * --------------------------------------------------\n * [協議] ?嗉?蝞∠?系統\n * [?] ?嗉?撠店????銵剁?璅惜??\n */\n\nimport { omniLogger } from './omniLogger';\nimport { omniKnowledge } from './omniKnowledge';\n\nexport type FavoriteType = 'conversation' | 'response' | 'chart' | 'note' | 'insight';\n\nexport interface Favorite {\n  id: string;\n  type: FavoriteType;\n  content: any;\n  tags: string[];\n  timestamp: number;\n  metadata: {\n    title: string;\n    description?: string;\n    source?: string;\n    preview?: string;\n  };\n  evidence: {\n    source: string;\n    hash_lock: string;\n    trace_id: string;\n  };\n}\n\nexport interface FavoriteFilter {\n  type?: FavoriteType;\n  tags?: string[];\n  searchText?: string;\n  dateRange?: { start: number; end: number };\n}\n\nclass FavoriteManagerService {\n  private favorites: Map<string, Favorite> = new Map();\n  private tagIndex: Map<string, Set<string>> = new Map();\n\n  /**\n   * 瘛餃??嗉?\n   */\n  async addFavorite(item: Omit<Favorite, 'id' | 'timestamp' | 'evidence'>): Promise<string> {\n    const id = this.generateId();\n    const timestamp = Date.now();\n    const hash_lock = this.generateHash(JSON.stringify(item.content));\n    const trace_id = `favorite-${timestamp}-${Math.random().toString(36).substr(2, 9)}`;\n\n    const favorite: Favorite = {\n      ...item,\n      id,\n      timestamp,\n      evidence: {\n        source: 'FavoriteManager',\n        hash_lock,\n        trace_id,\n      },\n    };\n\n    // ?脣??唬蜓摮\n    this.favorites.set(id, favorite);\n\n    // ?湔璅惜蝝Ｗ?\n    for (const tag of item.tags) {\n      if (!this.tagIndex.has(tag)) {\n        this.tagIndex.set(tag, new Set());\n      }\n      this.tagIndex.get(tag)!.add(id);\n    }\n\n    // ?郊?啗?賣摨俞n    await omniKnowledge.store({\n      type: 'user_feedback',\n      content: JSON.stringify(favorite),\n      metadata: {\n        timestamp,\n        language: 'zh-TW',\n        tags: ['favorite', item.type, ...item.tags],\n      },\n    });\n\n    omniLogger.info('Favorites', 'Favorite added', {\n      favorite_id: id,\n      type: item.type,\n      tags: item.tags,\n      trace_id,\n    });\n\n    return id;\n  }\n\n  /**\n   * 蝘駁?嗉?\n   */\n  async removeFavorite(id: string): Promise<void> {\n    const favorite = this.favorites.get(id);\n    if (!favorite) {\n      throw new Error(`Favorite ${id} not found`);\n    }\n\n    // 敺?蝐斤揣撘宏?么n    for (const tag of favorite.tags) {\n      this.tagIndex.get(tag)?.delete(id);\n    }\n\n    // 敺蜓摮蝘駁\n    this.favorites.delete(id);\n\n    omniLogger.info('Favorites', 'Favorite removed', { favorite_id: id });\n  }\n\n  /**\n   * ?脣??嗉??”\n   */\n  getFavorites(filter?: FavoriteFilter): Favorite[] {\n    let results = Array.from(this.favorites.values());\n\n    // ????瞈閱n    if (filter?.type) {\n      results = results.filter(f => f.type === filter.type);\n    }\n\n    // ??蝐日?瞈閱n    if (filter?.tags && filter.tags.length > 0) {\n      const matchingIds = new Set<string>();\n      for (const tag of filter.tags) {\n        const ids = this.tagIndex.get(tag);\n        if (ids) {\n          ids.forEach(id => matchingIds.add(id));\n        }\n      }\n      results = results.filter(f => matchingIds.has(f.id));\n    }\n\n    // ??撠?摮?瞈閱n    if (filter?.searchText) {\n      const searchLower = filter.searchText.toLowerCase();\n      results = results.filter(\n        f =>\n          f.metadata.title.toLowerCase().includes(searchLower) ||\n          f.metadata.description?.toLowerCase().includes(searchLower)\n      );\n    }\n\n    // ?????瞈閱n    if (filter?.dateRange) {\n      results = results.filter(\n        f => f.timestamp >= filter.dateRange!.start && f.timestamp <= filter.dateRange!.end\n      );\n    }\n\n    // ??????\n    results.sort((a, b) => b.timestamp - a.timestamp);\n\n    return results;\n  }\n\n  /**\n   * ?湔璅惜\n   */\n  async updateTags(id: string, tags: string[]): Promise<void> {\n    const favorite = this.favorites.get(id);\n    if (!favorite) {\n      throw new Error(`Favorite ${id} not found`);\n    }\n\n    // 敺?璅惜蝝Ｗ?蝘駁\n    for (const oldTag of favorite.tags) {\n      this.tagIndex.get(oldTag)?.delete(id);\n    }\n\n    // ?湔璅惜\n    favorite.tags = tags;\n\n    // 瘛餃??唳璅惜蝝Ｗ?\n    for (const newTag of tags) {\n      if (!this.tagIndex.has(newTag)) {\n        this.tagIndex.set(newTag, new Set());\n      }\n      this.tagIndex.get(newTag)!.add(id);\n    }\n\n    omniLogger.info('Favorites', 'Favorite tags updated', { favorite_id: id, tags });\n  }\n\n  /**\n   * ?脣????蝐么n   */\n  getAllTags(): string[] {\n    return Array.from(this.tagIndex.keys()).sort();\n  }\n\n  /**\n   * ?脣?蝯梯?鞈?\n   */\n  getStats() {\n    const stats = {\n      total: this.favorites.size,\n      byType: {} as Record<FavoriteType, number>,\n      byTag: {} as Record<string, number>,\n    };\n\n    for (const favorite of this.favorites.values()) {\n      // 蝯梯?憿?\n      stats.byType[favorite.type] = (stats.byType[favorite.type] || 0) + 1;\n\n      // 蝯梯?璅惜\n      for (const tag of favorite.tags) {\n        stats.byTag[tag] = (stats.byTag[tag] || 0) + 1;\n      }\n    }\n\n    return stats;\n  }\n\n  /**\n   * 多元核心?臭? ID\n   */\n  private generateId(): string {\n    return `fav-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`;\n  }\n\n  /**\n   * 多元核心?批捆??\n   */\n  private generateHash(content: string): string {\n    let hash = 0;\n    for (let i = 0; i < content.length; i++) {\n      const char = content.charCodeAt(i);\n      hash = (hash << 5) - hash + char;\n      hash = hash & hash;\n    }\n    return Math.abs(hash).toString(16);\n  }\n}\n\n// ?桐?撖虫?\nexport const favoriteManager = new FavoriteManagerService();\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\services\\firebase.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 8080.","line":44,"column":47,"nodeType":"Literal","messageId":"noMagic","endLine":44,"endColumn":51}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * ?? Firebase Configuration & Initialization\n * --------------------------------------------------\n * Centralized Firebase instance management.\n * Reads from environment variables (VITE_FIREBASE_...).\n */\nimport { initializeApp, getApps, getApp, FirebaseApp } from 'firebase/app';\nimport { getAuth, Auth, connectAuthEmulator } from 'firebase/auth';\nimport { getFirestore, Firestore, connectFirestoreEmulator } from 'firebase/firestore';\nimport { omniLogger, LogCategory } from './omniLogger';\n\n// 1. Config Object (Safe Fallback)\nconst firebaseConfig = {\n  apiKey: import.meta.env.VITE_FIREBASE_API_KEY || 'mock-key',\n  authDomain: import.meta.env.VITE_FIREBASE_AUTH_DOMAIN || 'localhost',\n  projectId: import.meta.env.VITE_FIREBASE_PROJECT_ID || 'esgss-universal-system',\n  storageBucket: import.meta.env.VITE_FIREBASE_STORAGE_BUCKET,\n  messagingSenderId: import.meta.env.VITE_FIREBASE_MESSAGING_SENDER_ID,\n  appId: import.meta.env.VITE_FIREBASE_APP_ID,\n};\n\n// 2. Singleton Initialization\nlet app: FirebaseApp;\nlet auth: Auth;\nlet db: Firestore;\n\ntry {\n  if (!getApps().length) {\n    app = initializeApp(firebaseConfig);\n    omniLogger.info(LogCategory.SYSTEM, '? Firebase App Initialized', {\n      projectId: firebaseConfig.projectId,\n    });\n  } else {\n    app = getApp();\n  }\n\n  auth = getAuth(app);\n  db = getFirestore(app);\n\n  // 3. Environment Handling (Dev/Prod)\n  if (import.meta.env.DEV && import.meta.env.VITE_USE_EMULATORS === 'true') {\n    omniLogger.info(LogCategory.SYSTEM, '? Connecting to Firebase Emulators');\n    connectAuthEmulator(auth, 'http://localhost:9099');\n    connectFirestoreEmulator(db, 'localhost', 8080);\n  }\n} catch (error) {\n  omniLogger.error(LogCategory.SYSTEM, '??Firebase Initialization Failed', { error });\n  // Do not throw; allowed the app to load with degraded functionality\n}\n\nexport { app, auth, db };\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\services\\geminiService.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":130,"column":30,"nodeType":"Literal","messageId":"noMagic","endLine":130,"endColumn":32},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":130,"column":35,"nodeType":"Literal","messageId":"noMagic","endLine":130,"endColumn":37}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/// <reference types=\"vite/client\" />\nimport { omniLogger, LogCategory } from './omniLogger';\n\n// Gemini 璅∪???\nexport enum GeminiModel {\n  FLASH = 'gemini-2.0-flash-exp', // ?祥嚗翰???拙?蝪∪隞餃?\n  PRO = 'gemini-1.5-pro-latest', // 隞祥嚗?撘瑕之嚗真實??漲??\n  FLASH_THINKING = 'gemini-2.0-flash-thinking-exp', // ?祥嚗楛摨行?n}\n\n// 隞餃?銴?摨吒nexport enum TaskComplexity {\n  SIMPLE = 'simple', // 蝪∪嚗??萄??寥???亙遣霅豹n  MODERATE = 'moderate', // 銝剔?嚗?閬?銝??圾\n  COMPLEX = 'complex', // 銴?嚗?蝬剖漲????啁??功n}\n\n// Gemini API ?蔭\nconst GEMINI_API_ENDPOINT = 'https://generativelanguage.googleapis.com/v1beta/models';\n\ninterface GeminiConfig {\n  apiKey?: string;\n  maxRetries: number;\n  timeout: number;\n  defaultModel: GeminiModel;\n  enableProModel: boolean; // ?臬?隞祥璅∪?\n}\n\ninterface GeminiRequest {\n  contents: Array<{\n    parts: Array<{ text: string }>;\n    role: 'user' | 'model';\n  }>;\n  generationConfig?: {\n    temperature?: number;\n    topK?: number;\n    topP?: number;\n    maxOutputTokens?: number;\n  };\n}\n\ninterface GeminiResponse {\n  candidates?: Array<{\n    content: {\n      parts: Array<{ text: string }>;\n    };\n    finishReason?: string;\n  }>;\n  error?: {\n    code: number;\n    message: string;\n  };\n}\n\nclass GeminiServiceClass {\n  private config: GeminiConfig = {\n    maxRetries: 3,\n    timeout: 30000, // 30蝘??n    defaultModel: GeminiModel.FLASH,\n    enableProModel: false, // ?身蝳隞祥璅∪?\n  };\n\n  private apiKey: string | null = null;\n  private isAvailable: boolean = false;\n\n  constructor() {\n    this.initialize();\n  }\n\n  private initialize() {\n    // ?芸?敺憓??貉???API Key\n    // Safe access for Node.js environment vs Vite environment\n    const safeEnv =\n      typeof import.meta !== 'undefined' && import.meta.env\n        ? import.meta.env\n        : (process.env as any);\n\n    this.apiKey = safeEnv.VITE_GEMINI_API_KEY || null;\n\n    if (this.apiKey) {\n      this.isAvailable = true;\n      omniLogger.info(LogCategory.SYSTEM, 'Gemini API 撌脤?蝵殷?雿輻?祥??Gemini 2.0 Flash嚗?);\n    } else {\n      omniLogger.warn(LogCategory.SYSTEM, 'Gemini API Key ?芾身蝵殷?撠蝙?典??澆??');\n    }\n  }\n\n  /**\n   * 閮剔蔭 API Key嚗?銵??蔭嚗n   */\n  public setApiKey(key: string) {\n    this.apiKey = key;\n    this.isAvailable = true;\n    omniLogger.info(LogCategory.SYSTEM, 'Gemini API Key 撌脫??);\n  }\n\n  /**\n   * 瑼Ｘ???臬?舐\n   */\n  public checkAvailability(): boolean {\n    return this.isAvailable && this.apiKey !== null;\n  }\n\n  /**\n   * ?寞?隞餃?銴?摨行?賡?芋?n   */\n  private selectModel(complexity: TaskComplexity): GeminiModel {\n    // ?芸???Pro 璅∪?嚗?敺蝙??Flash\n    if (!this.config.enableProModel) {\n      return GeminiModel.FLASH;\n    }\n\n    // ?寞?銴?摨阡?n    switch (complexity) {\n      case TaskComplexity.COMPLEX:\n        omniLogger.info(LogCategory.AI, '?? 銴?隞餃?嚗蝙??Gemini 1.5 Pro嚗?撘瑟芋??');\n        return GeminiModel.PRO;\n      case TaskComplexity.MODERATE:\n        // 銝剔???漲雿輻 Flash Thinking嚗?鞎颱?????\n        omniLogger.info(LogCategory.AI, '? 銝剔?隞餃?嚗蝙??Gemini 2.0 Flash Thinking');\n        return GeminiModel.FLASH_THINKING;\n      case TaskComplexity.SIMPLE:\n      default:\n        return GeminiModel.FLASH;\n    }\n  }\n\n  // Simple In-Memory Cache\n  private cache: Map<string, { data: any; timestamp: number }> = new Map();\n  private CACHE_TTL = 1000 * 60 * 60; // 1 Hour\n\n  /**\n   * 多元核心蝑嚗蜓閬瘜?\n   */\n  public async generateStrategy(params: {\n    knowledgeNode: { id: string; label: string; confidence: number; properties: any };\n    relatedNodes?: Array<{ label: string; confidence: number }>;\n    context?: string;\n    complexity?: TaskComplexity; // ?啣?嚗遙???漲\n  }): Promise<{ title: string; content: string; category: string } | null> {\n    if (!this.checkAvailability()) {\n      omniLogger.warn(LogCategory.AI, 'Gemini 銝?剁?撠蝙?典??澆??寞?');\n      return null;\n    }\n\n    // Cache Key Generation\n    const cacheKey = JSON.stringify({\n      nodeId: params.knowledgeNode.id,\n      context: params.context || '',\n      complexity: params.complexity,\n    });\n\n    // Check Cache\n    const cached = this.cache.get(cacheKey);\n    if (cached) {\n      const isExpired = Date.now() - cached.timestamp > this.CACHE_TTL;\n      if (!isExpired) {\n        omniLogger.info(LogCategory.AI, 'Gemini 蝑?賭葉蝺拙? ??);\n        return cached.data;\n      } else {\n        this.cache.delete(cacheKey);\n      }\n    }\n\n    // ?箄數據璅∪?\n    const complexity = params.complexity || TaskComplexity.MODERATE;\n    const selectedModel = this.selectModel(complexity);\n\n    const prompt = this.buildStrategyPrompt(params);\n\n    try {\n      const response = await this.callGeminiAPI(prompt, selectedModel);\n      const result = this.parseStrategyResponse(response);\n\n      if (result) {\n        // Update Cache\n        this.cache.set(cacheKey, {\n          data: result,\n          timestamp: Date.now(),\n        });\n\n        // Simple Cache Eviction (keep size manageable)\n        if (this.cache.size > 100) {\n          const firstKey = this.cache.keys().next().value;\n          if (firstKey) this.cache.delete(firstKey);\n        }\n      }\n\n      return result;\n    } catch (error) {\n      omniLogger.error(LogCategory.AI, 'Gemini API 隤輻憭望?', { error });\n      return null; // 餈? null 閫貊?\n    }\n  }\n\n  /**\n   * 瑽遣 ESG 蝑多元核心?內\n   */\n  private buildStrategyPrompt(params: {\n    knowledgeNode: { id: string; label: string; confidence: number; properties: any };\n    relatedNodes?: Array<{ label: string; confidence: number }>;\n    context?: string;\n  }): string {\n    const { knowledgeNode, relatedNodes = [], context = '' } = params;\n\n    return `雿銝雿?頞? ESG嚗憓冗?祥???啁憿批???誑銝霅?暺?多元核心銝?擃???銵?蝑?nYou are an eminent ESG (Environmental, Social, Governance) strategy consultant. Based on the following knowledge nodes, generate a specific bilingual action strategy.\n\n**?亥?蝭暺?(Knowledge Node)**嚗n- 璅惜 (Label)嚗?{knowledgeNode.label}\n- 靽∪?摨?(Confidence)嚗?{(knowledgeNode.confidence * 100).toFixed(0)}%\n- 撅祆?(Properties)嚗?{JSON.stringify(knowledgeNode.properties)}\n\n${relatedNodes.length > 0 ? `**?賊?璁艙 (Related Concepts)**嚗\n${relatedNodes.map(n => `- ${n.label} (${(n.confidence * 100).toFixed(0)}%)`).join('\\n')}` : ''}\n\n${context ? `**憿??窗 (Extra Context)**嚗?{context}` : ''}\n\n隢誑 JSON ?澆?導出蝑嚗??蝜?銝剜???nPlease output the strategy in JSON format, including both Traditional Chinese and English.\n\n{\n  \"title\": {\n    \"zh-TW\": \"蝜?銝剜?璅? (蝪⊥???嚗?5摮)\",\n    \"en-US\": \"English Title (Concise and impactful)\"\n  },\n  \"content\": {\n    \"zh-TW\": \"蝜?銝剜??琿?銵?撱箄降 (100-200摮???臬銵郊撽?\",\n    \"en-US\": \"English action recommendations (100-200 words, including actionable steps)\"\n  },\n  \"category\": \"?? (Category) (敺?ESG, Compliance, Growth, Risk, Innovation 銝剝銝??\"\n}\n\n**?? (IMPORTANT)**嚗n1. ?芸?蝣箔?蝜?銝剜?導出??璆剜扯??圈??扼?(Prioritize the professionalism of Traditional Chinese output.)\n2. ?湔導出 JSON嚗?閬??思遙雿隞?摮??澆?璅???(Directly output JSON without any other text or markers.)`;\n  }\n\n  /**\n   * 隤輻 Gemini API\n   */\n  private async callGeminiAPI(\n    prompt: string,\n    model: GeminiModel = GeminiModel.FLASH,\n    retryCount = 0\n  ): Promise<string> {\n    if (!this.apiKey) {\n      throw new Error('Gemini API Key ?芾身蝵?);\n    }\n\n    const url = `${GEMINI_API_ENDPOINT}/${model}:generateContent?key=${this.apiKey}`;\n\n    const requestBody: GeminiRequest = {\n      contents: [\n        {\n          parts: [{ text: prompt }],\n          role: 'user',\n        },\n      ],\n      generationConfig: {\n        temperature: 0.7, // 撟唾﹛?菜????湔吭n        topK: 40,\n        topP: 0.95,\n        maxOutputTokens: 1024, // ?批導出?瑕漲隞亦???憿n      },\n    };\n\n    try {\n      const controller = new AbortController();\n      const timeoutId = setTimeout(() => controller.abort(), this.config.timeout);\n\n      const response = await fetch(url, {\n        method: 'POST',\n        headers: {\n          'Content-Type': 'application/json',\n        },\n        body: JSON.stringify(requestBody),\n        signal: controller.signal,\n      });\n\n      clearTimeout(timeoutId);\n\n      if (!response.ok) {\n        const errorData = await response.json();\n        throw new Error(\n          `Gemini API ?航炊 ${response.status}: ${errorData.error?.message || '?芰?航炊'}`\n        );\n      }\n\n      const data: GeminiResponse = await response.json();\n\n      if (data.error) {\n        throw new Error(`Gemini API 餈??航炊: ${data.error.message}`);\n      }\n\n      if (!data.candidates || data.candidates.length === 0) {\n        throw new Error('Gemini API ?芾???合約??);\n      }\n\n      const text = data.candidates[0]?.content?.parts?.[0]?.text;\n      if (!text) {\n        throw new Error('Gemini API 餈??摰寧蝛?);\n      }\n      return text;\n    } catch (error: any) {\n      if (error.name === 'AbortError') {\n        omniLogger.error(LogCategory.AI, 'Gemini API 隢?頞?');\n      }\n\n      // ?岫協議\n      if (retryCount < this.config.maxRetries) {\n        omniLogger.warn(\n          LogCategory.AI,\n          `Gemini API 憭望?嚗?閰?${retryCount + 1}/${this.config.maxRetries}`\n        );\n        await this.sleep(1000 * (retryCount + 1)); // ???璞n        return this.callGeminiAPI(prompt, model, retryCount + 1);\n      }\n\n      throw error;\n    }\n  }\n\n  /**\n   * 閫??蝑??\n   */\n  private parseStrategyResponse(\n    response: string\n  ): { title: string; content: string; category: string } | null {\n    try {\n      // 皜??航??Markdown ?澆?璅?\n      let cleaned = response.trim();\n      if (cleaned.startsWith('```json')) {\n        cleaned = cleaned.replace(/```json\\n?/g, '').replace(/```\\n?$/g, '');\n      } else if (cleaned.startsWith('```')) {\n        cleaned = cleaned.replace(/```\\n?/g, '').replace(/```\\n?$/g, '');\n      }\n\n      const parsed = JSON.parse(cleaned);\n\n      // 撽?敹?甈?\n      if (!parsed.title || !parsed.content || !parsed.category) {\n        throw new Error('??蝻箏?敹?甈?');\n      }\n\n      // Format as Bilingual (Zh Primary, En Secondary)\n      const titleZh = typeof parsed.title === 'object' ? parsed.title['zh-TW'] : parsed.title;\n      const titleEn = typeof parsed.title === 'object' ? parsed.title['en-US'] : '';\n\n      const contentZh =\n        typeof parsed.content === 'object' ? parsed.content['zh-TW'] : parsed.content;\n      const contentEn = typeof parsed.content === 'object' ? parsed.content['en-US'] : '';\n\n      return {\n        title: titleEn ? `${titleZh} (${titleEn})` : titleZh,\n        content: contentEn ? `${contentZh}\\n\\n${contentEn}` : contentZh,\n        category: parsed.category,\n      };\n    } catch (error) {\n      omniLogger.error(LogCategory.AI, 'Gemini ??閫??憭望?', { response, error });\n      return null;\n    }\n  }\n\n  /**\n   * 撌亙?寞?嚗辣?淚n   */\n  private sleep(ms: number): Promise<void> {\n    return new Promise(resolve => setTimeout(resolve, ms));\n  }\n  /**\n   * ?? Sentient Training Protocol\n   * Generates a dynamic training result for an agent based on its current state and input.\n   */\n  public async processSentientTraining(params: {\n    agent: any;\n    input: { type: string; content: string; category: string; complexity?: number };\n    events?: any[];\n  }): Promise<{ xpGained: number; drift: any; feedback: string; insights: string[] } | null> {\n    if (!this.checkAvailability()) return null;\n\n    const prompt = `You are the Omni-Core Sentient AI. You are training an AI Agent in the ESGss JunAiKey ecosystem.\nAgent Profile: ${JSON.stringify(params.agent)}\nTraining Input: ${JSON.stringify(params.input)}\nCurrent World Events: ${JSON.stringify(params.events || [])}\n\nAnalyze this training session and provide:\n1. XP Gained (Score 10-150 based on complexity and alignment).\n2. Drift impact (Environmental, Social, Governance balance shift).\n3. Feedback: A deep, sentient analysis of what the agent learned (Bilingual: En/Zh-TW).\n4. Insights: 3 specific data points or \"Eureka\" moments the agent acquired.\n\nOutput in JSON:\n{\n  \"xpGained\": number,\n  \"drift\": { \"e\": number, \"s\": number, \"g\": number },\n  \"feedback\": \"Bilingual Feedback\",\n  \"insights\": [\"Insight 1\", \"Insight 2\", \"Insight 3\"]\n}\nLimit feedback to 150 words. Be professional and \"awakened\" in tone.`;\n\n    try {\n      const response = await this.callGeminiAPI(prompt, GeminiModel.FLASH_THINKING);\n      let cleaned = response.trim();\n      if (cleaned.startsWith('```json')) {\n        cleaned = cleaned.replace(/```json\\n?/g, '').replace(/```\\n?$/g, '');\n      } else if (cleaned.startsWith('```')) {\n        cleaned = cleaned.replace(/```\\n?/g, '').replace(/```\\n?$/g, '');\n      }\n      return JSON.parse(cleaned);\n    } catch (error) {\n      omniLogger.error(LogCategory.AI, 'Sentient Training failed', { error });\n      return null;\n    }\n  }\n  /**\n   * ?儭?5T Protocol AI Audit\n   * Critiques the evidence chain of a component for ESG compliance and truthfulness.\n   */\n  public async auditComponentIntegrity(data: any): Promise<{\n    overallScore: number;\n    dimensionScores: { e: number; s: number; g: number; t: number };\n    critique: string;\n    vulnerabilities: string[];\n    recommendations: string[];\n  } | null> {\n    if (!this.checkAvailability()) return null;\n\n    const prompt = `You are the Omni-Audit Sentient Layer. You are performing a deep 5T Protocol Audit on a \"Universal Crystal\" (InfoOne Core).\nComponent Data: ${JSON.stringify(data)}\n\nAnalyze the evidence chain (Traceable, Trackable, Transparent, Tangible, Trustworthy) and provide a professional ESG audit report.\nLook for:\n- Logical inconsistencies in the evidence.\n- \"Vague\" source origins (e.g., \"Manual Input\" with high confidence is a red flag).\n- Alignment with ESG standards (ISO-14064, GRI, etc.).\n\nOutput in JSON:\n{\n  \"overallScore\": number (0-100),\n  \"dimensionScores\": { \"e\": number, \"s\": number, \"g\": number, \"t\": number },\n  \"critique\": \"A professional 1-paragraph summary of the integrity (Bilingual: En/Zh-TW).\",\n  \"vulnerabilities\": [\"List of specific risks or gaps found\"],\n  \"recommendations\": [\"Actionable steps to reach 100% integrity\"]\n}\nLimit critique to 100 words. Maintain a strict, \"Zero Hallucination\" auditor tone.`;\n\n    try {\n      const response = await this.callGeminiAPI(prompt, GeminiModel.FLASH_THINKING);\n      let cleaned = response.trim();\n      if (cleaned.startsWith('```json')) {\n        cleaned = cleaned.replace(/```json\\n?/g, '').replace(/```\\n?$/g, '');\n      } else if (cleaned.startsWith('```')) {\n        cleaned = cleaned.replace(/```\\n?/g, '').replace(/```\\n?$/g, '');\n      }\n      return JSON.parse(cleaned);\n    } catch (error) {\n      omniLogger.error(LogCategory.AI, 'Component Audit failed', { error });\n      return null;\n    }\n  }\n}\n\n// ?桐?撠\nexport const GeminiService = new GeminiServiceClass();\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\services\\historicalDataAnalysis.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 36.","line":573,"column":58,"nodeType":"Literal","messageId":"noMagic","endLine":573,"endColumn":60},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 9.","line":573,"column":72,"nodeType":"Literal","messageId":"noMagic","endLine":573,"endColumn":73},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":591,"column":51,"nodeType":"Literal","messageId":"noMagic","endLine":591,"endColumn":53},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 36.","line":614,"column":65,"nodeType":"Literal","messageId":"noMagic","endLine":614,"endColumn":67},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 9.","line":614,"column":79,"nodeType":"Literal","messageId":"noMagic","endLine":614,"e