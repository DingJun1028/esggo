t, { useEffect, useRef } from 'react';\nimport { X } from 'lucide-react';\n\ninterface ModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  title: string;\n  children: React.ReactNode;\n}\n\nconst Modal: React.FC<ModalProps> = ({ isOpen, onClose, title, children }) => {\n  const modalRef = useRef<HTMLDivElement>(null);\n  const titleId = `modal-title-${Math.random().toString(36).substr(2, 9)}`;\n\n  // ?阡???嚗璅⊥?獢?多元核心嚗??阡?蝘餉璅⊥?獢n  useEffect(() => {\n    if (isOpen && modalRef.current) {\n      const previousActiveElement = document.activeElement as HTMLElement;\n      modalRef.current.focus();\n\n      return () => {\n        // ?????暺n        previousActiveElement?.focus();\n      };\n    }\n    return undefined;\n  }, [isOpen]);\n\n  if (!isOpen) return null;\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-4\">\n      <div className=\"absolute inset-0 bg-slate-950/80 backdrop-blur-sm\" onClick={onClose} />\n      <div\n        ref={modalRef}\n        className=\"relative bg-slate-900 border border-white/10 rounded-2xl shadow-2xl w-full max-w-lg overflow-hidden animate-in fade-in zoom-in-95 duration-200\"\n        role=\"dialog\"\n        aria-modal=\"true\"\n        aria-labelledby={titleId}\n        tabIndex={-1}\n      >\n        <div className=\"px-6 py-4 border-b border-white/5 flex justify-between items-center bg-white/[0.02]\">\n          <h3 id={titleId} className=\"font-bold text-white text-lg\">\n            {title}\n          </h3>\n          <button\n            onClick={onClose}\n            className=\"p-1 hover:bg-white/10 rounded-lg text-slate-400 hover:text-white transition-colors\"\n            aria-label=\"??撠店獢"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n        <div className=\"p-6\">{children}</div>\n      </div>\n    </div>\n  );\n};\n\nexport default Modal;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta