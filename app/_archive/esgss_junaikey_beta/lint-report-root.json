:"noMagic","endLine":1106,"endColumn":31},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.01.","line":1107,"column":26,"nodeType":"Literal","messageId":"noMagic","endLine":1107,"endColumn":30},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1.5.","line":1108,"column":16,"nodeType":"Literal","messageId":"noMagic","endLine":1108,"endColumn":19},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.05.","line":1108,"column":28,"nodeType":"Literal","messageId":"noMagic","endLine":1108,"endColumn":32},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.1.","line":1109,"column":12,"nodeType":"Literal","messageId":"noMagic","endLine":1109,"endColumn":15},{"ruleId":"no-case-declarations","severity":2,"message":"Unexpected lexical declaration in case block.","line":1122,"column":9,"nodeType":"VariableDeclaration","messageId":"unexpected","endLine":1122,"endColumn":72,"suggestions":[{"messageId":"addBrackets","fix":{"range":[32928,33356],"text":"{ const mean = values.reduce((a, b) => a + b, 0) / values.length;\n        const stdDev = Math.sqrt(\n          values.reduce((sum, val) => sum + Math.pow(val - mean, 2), 0) / values.length\n        );\n\n        values.forEach((value, index) => {\n          const zScore = Math.abs((value - mean) / stdDev);\n          if (zScore > threshold) {\n            outliers.push({ index, value, zScore });\n          }\n        });\n        break; }"},"desc":"Add {} brackets around the case block."}]},{"ruleId":"no-case-declarations","severity":2,"message":"Unexpected lexical declaration in case block.","line":1123,"column":9,"nodeType":"VariableDeclaration","messageId":"unexpected","endLine":1125,"endColumn":11,"suggestions":[{"messageId":"addBrackets","fix":{"range":[32928,33356],"text":"{ const mean = values.reduce((a, b) => a + b, 0) / values.length;\n        const stdDev = Math.sqrt(\n          values.reduce((sum, val) => sum + Math.pow(val - mean, 2), 0) / values.length\n        );\n\n        values.forEach((value, index) => {\n          const zScore = Math.abs((value - mean) / stdDev);\n          if (zScore > threshold) {\n            outliers.push({ index, value, zScore });\n          }\n        });\n        break; }"},"desc":"Add {} brackets around the case block."}]},{"ruleId":"no-case-declarations","severity":2,"message":"Unexpected lexical declaration in case block.","line":1136,"column":9,"nodeType":"VariableDeclaration","messageId":"unexpected","endLine":1136,"endColumn":58,"suggestions":[{"messageId":"addBrackets","fix":{"range":[33384,34034],"text":"{ const sorted = [...values].sort((a, b) => a - b);\n        const q1 = sorted[Math.floor(sorted.length * 0.25)] ?? 0;\n        const q3 = sorted[Math.floor(sorted.length * 0.75)] ?? 0;\n        const iqr = q3 - q1;\n        const lowerBound = q1 - threshold * iqr;\n        const upperBound = q3 + threshold * iqr;\n\n        values.forEach((value, index) => {\n          if (value < lowerBound || value > upperBound) {\n            const median = sorted[Math.floor(sorted.length / 2)] ?? 0;\n            const zScore = (value - median) / (iqr / 1.349); // 餈撮轉換?暢-score\n            outliers.push({ index, value, zScore });\n          }\n        });\n        break; }"},"desc":"Add {} brackets around the case block."}]},{"ruleId":"no-case-declarations","severity":2,"message":"Unexpected lexical declaration in case block.","line":1137,"column":9,"nodeType":"VariableDeclaration","messageId":"unexpected","endLine":1137,"endColumn":66,"suggestions":[{"messageId":"addBrackets","fix":{"range":[33384,34034],"text":"{ const sorted = [...values].sort((a, b) => a - b);\n        const q1 = sorted[Math.floor(sorted.length * 0.25)] ?? 0;\n        const q3 = sorted[Math.floor(sorted.length * 0.75)] ?? 0;\n        const iqr = q3 - q1;\n        const lowerBound = q1 - threshold * iqr;\n        const upperBound = q3 + threshold * iqr;\n\n        values.forEach((value, index) => {\n    