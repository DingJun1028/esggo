         >\n                  <span className=\"text-white text-sm\">{item.task}</span>\n                  <span className=\"text-emerald-400 font-bold text-sm\">{item.reward}</span>\n                </div>\n              ))}\n            </div>\n          </div>\n\n          <div className=\"bg-slate-900/50 border border-cyan-500/20 rounded-2xl p-6 backdrop-blur-sm\">\n            <h3 className=\"text-white font-bold mb-4 flex items-center gap-2\">\n              <Gift className=\"w-5 h-5 text-purple-400\" />\n              {isZh ? '?梢???' : 'Popular Rewards'}\n            </h3>\n            <div className=\"space-y-3\">\n              {rewards.slice(0, 3).map(reward => (\n                <div\n                  key={reward.id}\n                  className=\"flex justify-between items-center p-3 bg-white/5 rounded-lg hover:bg-white/10 transition-colors cursor-pointer\"\n                >\n                  <div>\n                    <p className=\"text-white text-sm font-semibold\">{reward.name}</p>\n                    <p className=\"text-xs text-slate-400\">{reward.category}</p>\n                  </div>\n                  <span className=\"text-amber-400 font-bold text-sm\">{reward.cost} GWC</span>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n      )}\n\n      {selectedTab === 'rewards' && (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n          {rewards.map(reward => (\n            <div\n              key={reward.id}\n              className=\"bg-slate-900/50 border border-cyan-500/20 rounded-2xl p-5 hover:border-amber-500/50 transition-all group hover:shadow-[0_0_20px_rgba(245,158,11,0.1)]\"\n            >\n              <div className=\"flex justify-between items-start mb-4\">\n                <div>\n                  <h3 className=\"text-white font-bold mb-1 group-hover:text-amber-400 transition-colors\">\n                    {reward.name}\n                  </h3>\n                  <span className=\"text-xs text-slate-500 uppercase\">{reward.category}</span>\n                </div>\n              </div>\n              <div className=\"flex justify-between items-center\">\n                <span className=\"text-2xl font-black text-amber-400\">{reward.cost} GWC</span>\n                <button className=\"bg-amber-600/20 hover:bg-amber-600/30 border border-amber-500/30 text-amber-400 px-4 py-2 rounded-xl font-semibold text-sm transition-colors shadow-[0_0_10px_rgba(245,158,11,0.1)]\">\n                  {isZh ? '??' : 'Redeem'}\n                </button>\n              </div>\n            </div>\n          ))}\n        </div>\n      )}\n\n      {selectedTab === 'history' && (\n        <div className=\"bg-slate-900/50 border border-cyan-500/20 rounded-2xl p-6 backdrop-blur-sm\">\n          <h3 className=\"text-white font-bold mb-4\">{isZh ? '鈭斗?閮?' : 'Transaction History'}</h3>\n          <div className=\"space-y-3\">\n            {transactions.map((tx, i) => (\n              <div\n                key={i}\n                className=\"flex items-center justify-between p-4 bg-slate-800/50 rounded-xl hover:bg-slate-800/80 transition-colors border border-transparent hover:border-cyan-500/10\"\n              >\n                <div className=\"flex items-center gap-3\">\n                  <div\n                    className={`w-10 h-10 rounded-full flex items-center justify-center ${\n                      tx.type === 'earn' ? 'bg-emerald-500/10' : 'bg-rose-500/10'\n                    }`}\n                  >\n                    {tx.type === 'earn' ? (\n                      <ArrowUpRight className=\"w-5 h-5 text-emerald-400\" />\n                    ) : (\n                      <ArrowDownRight className=\"w-5 h-5 text-rose-400\" />\n                    )}\n                  </div>\n                  <div>\n                    <p className=\"text-white font-semibold text-sm\">{tx.reason}</p>\n                    <p className=\"text-xs text-slate-500\">{tx.time}</p>\n                  </div>\n                </div>\n                <span\n                  className={`text-lg font-bold ${tx.type === 'earn' ? 'text-emerald-400' : 'text-rose-400'}`}\n                >\n                  {tx.amount > 0 ? '+' : ''}\n                  {tx.amount} GWC\n                </span>\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\GuildHall.tsx","messages":[{"ruleId":"react-hooks/immutability","severity":2,"message":"Error: Cannot access variable before it is declared\n\n`loadGuilds` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\GuildHall.tsx:13:5\n  11 |\n  12 |   useEffect(() => {\n> 13 |     loadGuilds();\n     |     ^^^^^^^^^^ `loadGuilds` accessed before it is declared\n  14 |   }, []);\n  15 |\n  16 |   const loadGuilds = async () => {\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\GuildHall.tsx:16:3\n  14 |   }, []);\n  15 |\n> 16 |   const loadGuilds = async () => {\n     |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 17 |     const allGuilds = await socialEconomyService.getGuilds();\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 18 |     setGuilds(allGuilds);\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 19 |     // Mock check if user is in guild\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 20 |     const userGuild = allGuilds.find(g => g.members.some(m => m.userId === 'partner_1'));\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 21 |     setMyGuild(userGuild || null);\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 22 |   };\n     | ^^^^^ `loadGuilds` is declared here\n  23 |\n  24 |   const handleCreateGuild = async () => {\n  25 |     setLoading(true);","line":13,"column":5,"nodeType":null,"endLine":13,"endColumn":15}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\nimport { socialEconomyService } from '../services/socialEconomyService';\nimport { type Guild, SubscriptionTier } from '@/types';\n\nexport const GuildHall: React.FC = () => {\n  const [guilds, setGuilds] = useState<Guild[]>([]);\n  const [myGuild, setMyGuild] = useState<Guild | null>(null);\n  const [loading, setLoading] = useState(false);\n  const [showCreateModal, setShowCreateModal] = useState(false);\n  const [newGuildName, setNewGuildName] = useState('');\n\n  useEffect(() => {\n    loadGuilds();\n  }, []);\n\n  const loadGuilds = async () => {\n    const allGuilds = await socialEconomyService.getGuilds();\n    setGuilds(allGuilds);\n    // Mock check if user is in guild\n    const userGuild = allGuilds.find(g => g.members.some(m => m.userId === 'partner_1'));\n    setMyGuild(userGuild || null);\n  };\n\n  const handleCreateGuild = async () => {\n    setLoading(true);\n    try {\n      await socialEconomyService.createGuild('partner_1', newGuildName, '??偶蝥飛??);\n      await loadGuilds();\n      setShowCreateModal(false);\n      setNewGuildName('');\n      alert('摮豢??萄遣??嚗?);\n    } catch (err: any) {\n      alert('?萄遣憭望?: ' + err.message);\n    }\n    setLoading(false);\n  };\n\n  const handleJoinGuild = async (guildId: string) => {\n    // Mock join\n    alert('?唾?撌脩??(璅⊥)');\n  };\n\n  return (\n    <div className=\"p-8 h-full overflow-y-auto bg-slate-900 text-white\">\n      <header className=\"flex justify-between items-center mb-8\">\n        <div>\n          <h1 className=\"text-3xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-amber-400 to-orange-400\">\n            永續摮豢?憭批輒 (Guild Hall)\n          </h1>\n          <p className=\"text-slate-400\">???曆犖銋?嚗?菜偶蝥靘?/p>\n        </div>\n        {!myGuild && (\n          <button\n            onClick={() => setShowCreateModal(true)}\n            className=\"px-6 py-3 rounded-xl bg-gradient-to-r from-amber-500 to-orange-600 font-bold shadow-lg shadow-orange-500/20 hover:scale-105 transition-transform\"\n          >\n            ?萄遣摮豢? (PRO Only)\n          </button>\n        )}\n      </header>\n\n      {myGuild ? (\n        <div className=\"bg-slate-800/50 border border-amber-500/30 rounded-2xl p-8 mb-8\">\n          <div className=\"flex items-center gap-6 mb-8\">\n            <div className=\"w-20 h-20 rounded-2xl bg-gradient-to-br from-amber-400 to-orange-500 flex items-center justify-center text-4xl shadow-xl\">\n              ??儭n            </div>\n            <div>\n              <h2 className=\"text-3xl font-bold\">{myGuild.name}</h2>\n              <div className=\"text-amber-400\">\n                Level {myGuild.level} ??? {myGuild.members.length}/50\n              </div>\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6\">\n            <div className=\"bg-slate-900/50 p-4 rounded-xl\">\n              <h3 className=\"text-slate-400 text-sm mb-1\">摮豢?鞈?</h3>\n              <div className=\"text-2xl font-bold text-yellow-400\">{myGuild.treasury.gold} GSC</div>\n            </div>\n            <div className=\"bg-slate-900/50 p-4 rounded-xl\">\n              <h3 className=\"text-slate-400 text-sm mb-1\">蝘??</h3>\n              <div className=\"text-2xl font-bold text-blue-400\">\n                {myGuild.technologies.length} ???潔葉\n              </div>\n            </div>\n            <div className=\"bg-slate-900/50 p-4 rounded-xl\">\n              <h3 className=\"text-slate-400 text-sm mb-1\">?祇梯甜??/h3>\n              <div className=\"text-2xl font-bold text-emerald-400\">Top 5%</div>\n            </div>\n          </div>\n        </div>\n      ) : (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {guilds.map(guild => (\n            <div\n              key={guild.id}\n              className=\"bg-slate-800/50 border border-white/10 rounded-xl p-6 hover:border-amber-500/50 transition-all group\"\n            >\n              <div className=\"flex justify-between items-start mb-4\">\n                <div className=\"w-12 h-12 rounded-lg bg-slate-700 flex items-center justify-center text-2xl group-hover:bg-amber-500 group-hover:text-white transition-colors\">\n                  ??儭n                </div>\n                <span className=\"px-2 py-1 bg-slate-700 rounded text-xs text-slate-300\">\n                  Lv.{guild.level}\n                </span>\n              </div>\n              <h3 className=\"text-xl font-bold mb-2\">{guild.name}</h3>\n              <p className=\"text-slate-400 text-sm mb-4 line-clamp-2\">{guild.description}</p>\n              <div className=\"flex items-center justify-between text-sm text-slate-500 mb-4\">\n                <span>?: {guild.members.length}/50</span>\n                <span>\n                  ?: {guild.members.find(m => m.userId === guild.leaderId)?.userId || 'Unknown'}\n                </span>\n              </div>\n              <button\n                onClick={() => handleJoinGuild(guild.id)}\n                className=\"w-full py-2 rounded-lg bg-slate-700 hover:bg-slate-600 text-slate-200 transition-colors\"\n              >\n                ?唾??\n              </button>\n            </div>\n          ))}\n        </div>\n      )}\n\n      {/* Create Guild Modal */}\n      {showCreateModal && (\n        <div className=\"fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm\">\n          <div className=\"bg-slate-800 p-8 rounded-2xl w-full max-w-md border border-amber-500/30\">\n            <h2 className=\"text-2xl font-bold mb-6\">?萄遣?啣飛??/h2>\n            <input\n              type=\"text\"\n              value={newGuildName}\n              onChange={e => setNewGuildName(e.target.value)}\n              placeholder=\"頛詨摮豢??迂...\"\n              className=\"w-full bg-slate-900 border border-slate-700 rounded-lg px-4 py-3 mb-6 focus:border-amber-500 outline-none text-white\"\n            />\n            <div className=\"flex gap-4\">\n              <button\n                onClick={() => setShowCreateModal(false)}\n                className=\"flex-1 py-3 rounded-lg bg-slate-700 hover:bg-slate-600\"\n              >\n                ??\n              </button>\n              <button\n                onClick={handleCreateGuild}\n                disabled={loading || !newGuildName}\n                className=\"flex-1 py-3 rounded-lg bg-amber-600 hover:bg-amber-500 font-bold disabled:opacity-50\"\n              >\n                {loading ? '?萄遣銝?..' : '蝣箄??萄遣 (? Pro)'}\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\HITLReviewer.tsx","messages":[{"ruleId":"react-hooks/purity","severity":2,"message":"Error: Cannot call impure function during render\n\n`Date.now` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\HITLReviewer.tsx:42:27\n  40 |       parameters: { reportType: 'carbon_analysis', format: 'pdf' },\n  41 |       status: 'pending',\n> 42 |       createdAt: new Date(Date.now() - 3600000),\n     |                           ^^^^^^^^^^ Cannot call impure function\n  43 |     },\n  44 |   ];\n  45 |","line":42,"column":27,"nodeType":null,"endLine":42,"endColumn":37},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3600000.","line":42,"column":40,"nodeType":"Literal","messageId":"noMagic","endLine":42,"endColumn":47},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'mockProposals'. Either include it or remove the dependency array.","line":48,"column":6,"nodeType":"ArrayExpression","endLine":48,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [mockProposals]","fix":{"range":[1213,1215],"text":"[mockProposals]"}}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * HITL Reviewer - 鈭箏極撖拇隞\n * Human-in-the-Loop 撖拇撌乩?瘚?\n */\n\nimport React, { useState, useEffect } from 'react';\n\ninterface Proposal {\n  id: string;\n  skillName: string;\n  proposedBy: string;\n  type: string;\n  description: string;\n  parameters: any;\n  status: 'pending' | 'approved' | 'rejected';\n  createdAt: Date;\n}\n\nexport const HITLReviewer: React.FC = () => {\n  const [proposals, setProposals] = useState<Proposal[]>([]);\n  const [filter, setFilter] = useState<'all' | 'pending' | 'approved' | 'rejected'>('pending');\n\n  const mockProposals: Proposal[] = [\n    {\n      id: '1',\n      skillName: 'email_send',\n      proposedBy: 'ESG Advisor',\n      type: 'execute_skill',\n      description: '?潮?ESG ?勗?蝯西鈭?',\n      parameters: { to: 'board@company.com', subject: 'Q4 ESG Report' },\n      status: 'pending',\n      createdAt: new Date(),\n    },\n    {\n      id: '2',\n      skillName: 'report_generate',\n      proposedBy: 'Data Analyst',\n      type: 'execute_skill',\n      description: '多元核心蝣單??曉????,\n      parameters: { reportType: 'carbon_analysis', format: 'pdf' },\n      status: 'pending',\n      createdAt: new Date(Date.now() - 3600000),\n    },\n  ];\n\n  useEffect(() => {\n    setProposals(mockProposals);\n  }, []);\n\n  const handleApprove = (id: string) => {\n    setProposals(proposals.map(p => (p.id === id ? { ...p, status: 'approved' as const } : p)));\n  };\n\n  const handleReject = (id: string) => {\n    setProposals(proposals.map(p => (p.id === id ? { ...p, status: 'rejected' as const } : p)));\n  };\n\n  const filteredProposals =\n    filter === 'all' ? proposals : proposals.filter(p => p.status === filter);\n\n  return (\n    <div className=\"p-6\">\n      <h1 className=\"text-3xl font-bold text-cosmic mb-6\">?? HITL 撖拇銝剖?</h1>\n\n      {/* ?蕪??*/}\n      <div className=\"flex gap-3 mb-6\">\n        {(['all', 'pending', 'approved', 'rejected'] as const).map(f => (\n          <button\n            key={f}\n            onClick={() => setFilter(f)}\n            className={`px-4 py-2 rounded-lg transition-cosmic ${\n              filter === f ? 'glass-strong glow' : 'glass hover:glass-strong'\n            }`}\n          >\n            {f === 'all' && '?券'}\n            {f === 'pending' && '??敺祟??}\n            {f === 'approved' && '??撌脫??}\n            {f === 'rejected' && '??撌脫?蝯?}\n          </button>\n        ))}\n      </div>\n\n      {/* 蝯梯? */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 mb-6\">\n        <div className=\"nebula-card p-4\">\n          <div className=\"text-3xl font-bold text-yellow-400\">\n            {proposals.filter(p => p.status === 'pending').length}\n          </div>\n          <div className=\"text-indigo-300 text-sm\">敺祟??/div>\n        </div>\n        <div className=\"nebula-card p-4\">\n          <div className=\"text-3xl font-bold text-green-400\">\n            {proposals.filter(p => p.status === 'approved').length}\n          </div>\n          <div className=\"text-indigo-300 text-sm\">撌脫??/div>\n        </div>\n        <div className=\"nebula-card p-4\">\n          <div className=\"text-3xl font-bold text-red-400\">\n            {proposals.filter(p => p.status === 'rejected').length}\n          </div>\n          <div className=\"text-indigo-300 text-sm\">撌脫?蝯?/div>\n        </div>\n      </div>\n\n      {/* ???” */}\n      <div className=\"space-y-4\">\n        {filteredProposals.map(proposal => (\n          <div key={proposal.id} className=\"nebula-card p-6\">\n            <div className=\"flex items-start justify-between mb-4\">\n              <div>\n                <h3 className=\"text-xl font-bold text-cosmic mb-2\">{proposal.skillName}</h3>\n                <p className=\"text-indigo-300\">{proposal.description}</p>\n              </div>\n              <span\n                className={`px-3 py-1 rounded-lg text-sm ${\n                  proposal.status === 'pending'\n                    ? 'glass-strong'\n                    : proposal.status === 'approved'\n                      ? 'bg-green-500/20 text-green-400'\n                      : 'bg-red-500/20 text-red-400'\n                }`}\n              >\n                {proposal.status === 'pending' && '??敺祟??}\n                {proposal.status === 'approved' && '??撌脫??}\n                {proposal.status === 'rejected' && '??撌脫?蝯?}\n              </span>\n            </div>\n\n            <div className=\"glass p-4 rounded-lg mb-4\">\n              <div className=\"text-sm text-indigo-400 mb-2\">?:</div>\n              <pre className=\"text-xs text-indigo-200 overflow-x-auto\">\n                {JSON.stringify(proposal.parameters, null, 2)}\n              </pre>\n            </div>\n\n            <div className=\"flex items-center justify-between text-sm text-indigo-400 mb-4\">\n              <span>??? {proposal.proposedBy}</span>\n              <span>{proposal.createdAt.toLocaleString('zh-TW')}</span>\n            </div>\n\n            {proposal.status === 'pending' && (\n              <div className=\"flex gap-3\">\n                <button\n                  onClick={() => handleApprove(proposal.id)}\n                  className=\"btn-cosmic flex-1 bg-green-500/20 hover:bg-green-500/30\"\n                >\n                  ???孵?\n                </button>\n                <button\n                  onClick={() => handleReject(proposal.id)}\n                  className=\"glass flex-1 hover:bg-red-500/20\"\n                >\n                  ????\n                </button>\n              </div>\n            )}\n          </div>\n        ))}\n\n        {filteredProposals.length === 0 && (\n          <div className=\"text-center text-indigo-300 py-12\">\n            <div className=\"text-6xl mb-4\">?</div>\n            <p>\n              ?桀?瘝?\n              {filter === 'all'\n                ? ''\n                : filter === 'pending'\n                  ? '敺祟?亦?'\n                  : filter === 'approved'\n                    ? '撌脫??'\n                    : '撌脫?蝯?'}\n              ??\n            </p>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\ImpactProject.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 7.","line":81,"column":12,"nodeType":"Literal","messageId":"noMagic","endLine":81,"endColumn":13},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 12.","line":81,"column":15,"nodeType":"Literal","messageId":"noMagic","endLine":81,"endColumn":17},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 13.","line":81,"column":19,"nodeType":"Literal","messageId":"noMagic","endLine":81,"endColumn":21},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 17.","line":81,"column":23,"nodeType":"Literal","messageId":"noMagic","endLine":81,"endColumn":25},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 80.","line":276,"column":43,"nodeType":"Literal","messageId":"noMagic","endLine":276,"endColumn":45},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":278,"column":47,"nodeType":"Literal","messageId":"noMagic","e