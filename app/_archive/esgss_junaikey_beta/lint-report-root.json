id: string;\n  name: string;\n  nameEn: string;\n  category: 'E' | 'S' | 'G';\n  categoryName: string;\n  emoji: string;\n  rarity: 1 | 2 | 3 | 4 | 5;\n  power: number;\n  knowledge: number;\n  effect: string;\n  source: string;\n  illustration: string;\n  owned: boolean;\n}\n\ninterface Achievement {\n  id: string;\n  name: string;\n  emoji: string;\n  unlocked: boolean;\n  unlockedAt?: string;\n  requirement: string;\n  tier: 'bronze' | 'silver' | 'gold' | 'platinum' | 'diamond';\n}\n\ninterface PlayerStats {\n  username: string;\n  level: number;\n  coins: number;\n  streak: number;\n  totalCards: number;\n  ownedCards: number;\n  winRate: number;\n  wins: number;\n  totalBattles: number;\n  dna?: {\n    intelligence: number;\n    precision: number;\n    resilience: number;\n    level?: number;\n    exp?: number;\n  };\n}\n\n// ==================== ?數據 ====================\n\nconst SAMPLE_CARDS: ESGCard[] = [\n  {\n    id: 'E-085',\n    name: '蝣唾雲頝∟蕭頩?,\n    nameEn: 'Carbon Footprint',\n    category: 'E',\n    categoryName: '?啣?',\n    emoji: '??',\n    rarity: 4,\n    power: 85,\n    knowledge: 90,\n    effect: '設計銝西蕭頩斤?蝜４?',\n    source: '?唬?蝵?2025 撟湔?皞?,\n    illustration: 'factory-emissions',\n    owned: true,\n  },\n  {\n    id: 'S-078',\n    name: '?砍像??',\n    nameEn: 'Fair Labor Practice',\n    category: 'S',\n    categoryName: '蝷暹?',\n    emoji: '???',\n    rarity: 4,\n    power: 78,\n    knowledge: 88,\n    effect: '???∪極皛踵?摨西?蝳?',\n    source: 'ILO ???極定義',\n    illustration: 'diverse-workers',\n    owned: true,\n  },\n  {\n    id: 'G-092',\n    name: '???????',\n    nameEn: 'Board Diversity',\n    category: 'G',\n    categoryName: '瘝餌?',\n    emoji: '???',\n    rarity: 5,\n    power: 92,\n    knowledge: 85,\n    effect: '撘瑕?瘙箇??釭??摨?,\n    source: 'OECD ?砍瘝餌???',\n    illustration: 'board-meeting',\n    owned: true,\n  },\n  {\n    id: 'E-101',\n    name: '蝬?賣?',\n    nameEn: 'Green Energy',\n    category: 'E',\n    categoryName: '?啣?',\n    emoji: '???',\n    rarity: 3,\n    power: 70,\n    knowledge: 82,\n    effect: '皜????靘陷',\n    source: 'IPCC 瘞???,\n    illustration: 'renewable-energy',\n    owned: true,\n  },\n  {\n    id: 'E-055',\n    name: '?餅??',\n    nameEn: 'Battery Recycling',\n    category: 'E',\n    categoryName: '?啣?',\n    emoji: '?♀??,\n    rarity: 4,\n    power: 88,\n    knowledge: 75,\n    effect: '靽脣儐?啁?瞈?,\n    source: 'EU 敺芰蝬???',\n    illustration: 'battery-cycle',\n    owned: true,\n  },\n];\n\nconst SAMPLE_ACHIEVEMENTS: Achievement[] = [\n  {\n    id: 'ach-1',\n    name: '永續真實',\n    emoji: '??',\n    unlocked: true,\n    unlockedAt: '2025-01-15',\n    requirement: '摰?擐活蝣喟??,\n    tier: 'gold',\n  },\n  {\n    id: 'ach-2',\n    name: '蝣喃葉??鈭?,\n    emoji: '??',\n    unlocked: true,\n    unlockedAt: '2025-01-10',\n    requirement: '皜? 20% 蝣單???,\n    tier: 'silver',\n  },\n  {\n    id: 'ach-3',\n    name: 'ESG憭批葦',\n    emoji: '??',\n    unlocked: false,\n    requirement: '? Lv.50',\n    tier: 'platinum',\n  },\n  {\n    id: 'ach-4',\n    name: '7?仿??',\n    emoji: '??',\n    unlocked: true,\n    unlockedAt: '2025-01-12',\n    requirement: '????餃 7 憭?,\n    tier: 'bronze',\n  },\n  {\n    id: 'ach-5',\n    name: '?∠??嗉?摰?,\n    emoji: '??',\n    unlocked: true,\n    unlockedAt: '2025-01-08',\n    requirement: '?園? 40 撘萄??,\n    tier: 'gold',\n  },\n  {\n    id: 'ach-6',\n    name: '蝡嗆??渡???,\n    emoji: '??',\n    unlocked: false,\n    requirement: '蝝航? 100 整合??,\n    tier: 'diamond',\n  },\n];\n\n// ==================== 銝駁??脩?隞?====================\n\n// ==================== API Service (Internal) ====================\nconst api = {\n  getPassport: async (id: string) => {\n    const res = await fetch(`/api/passport/${id}`);\n    if (!res.ok) throw new Error('Failed to fetch passport');\n    return res.json();\n  },\n  evolve: async (entityId: string, action: any) => {\n    const res = await fetch('/api/evolution/evolve', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ entityId, action }),\n    });\n    if (!res.ok) throw new Error('Evolution failed');\n    return res.json();\n  },\n};\n\n// ==================== 銝駁??脩?隞?====================\n\nexport const ESGGoGame: React.FC = () => {\n  const [currentView, setCurrentView] = useState<\n    'home' | 'collection' | 'arena' | 'achievements' | 'profile'\n  >('home');\n  const [loading, setLoading] = useState(true);\n  const [playerStats, setPlayerStats] = useState<PlayerStats>({\n    username: '永續?啣ㄚ繚?喳???,\n    level: 1,\n    coins: 0,\n    streak: 1,\n    totalCards: 54,\n    ownedCards: 4,\n    winRate: 0,\n    wins: 0,\n    totalBattles: 0,\n    dna: { intelligence: 0, precision: 0, resilience: 0 }, // Add DNA to stats\n  } as any);\n\n  // Initial Fetch\n  React.useEffect(() => {\n    loadPlayerData();\n  }, []);\n\n  const loadPlayerData = async () => {\n    try {\n      // Hardcoded ID for MVP demo\n      const passport = await api.getPassport('USER-001');\n\n      // Map Passport V2 to PlayerStats\n      setPlayerStats(prev => ({\n        ...prev,\n        level: passport.dna?.level || 1,\n        username: `永續?啣ㄚ (Lv.${passport.dna?.level})`,\n        dna: passport.dna,\n      }));\n      setLoading(false);\n    } catch (e) {\n      console.error('Failed to load player data, using fallback', e);\n      setLoading(false);\n    }\n  };\n\n  const handleTaskComplete = async (taskName: string, reward: number) => {\n    try {\n      const result = await api.evolve('USER-001', {\n        type: 'TASK_COMPLETE',\n        task: taskName,\n        expValue: reward / 10, // Convert coins to EXP roughly\n      });\n\n      if (result.success) {\n        // Update local state\n        setPlayerStats(prev => ({\n          ...prev,\n          coins: prev.coins + reward,\n          level: result.evolution.level,\n          dna: result.dna || prev.dna,\n        }));\n\n        // Notifications\n        if (result.evolution.leveledUp) {\n          alert(`?? ??鈭??曉?舐?蝝?${result.evolution.level}嚗);\n        }\n        if (result.evolution.mutation?.unlocked) {\n          alert(`??DNA 蝒?嚗敺?寡釭嚗?{result.evolution.mutation.trait}`);\n        }\n      }\n    } catch (e) {\n      console.error('Evolution failed', e);\n    }\n  };\n\n  if (loading)\n    return (\n      <div className=\"min-h-screen flex items-center justify-center text-white\">頛銝?..</div>\n    );\n\n  return (\n    <div className=\"min-h-screen bg-gradient-to-br from-slate-900 via-blue-900 to-green-900 text-white p-4\">\n      {/* Header */}\n      <Header playerStats={playerStats} />\n\n      {/* Main Content */}\n      <AnimatePresence mode=\"wait\">\n        {currentView === 'home' && (\n          <HomePage\n            key=\"home\"\n            playerStats={playerStats}\n            onCompleteTask={handleTaskComplete} // Pass handler\n          />\n        )}\n        {currentView === 'collection' && <CollectionPage key=\"collection\" />}\n        {currentView === 'arena' && <ArenaPage key=\"arena\" />}\n        {currentView === 'achievements' && (\n          <AchievementsPage key=\"achievements\" playerStats={playerStats} />\n        )}\n        {currentView === 'profile' && <ProfilePage key=\"profile\" playerStats={playerStats} />}\n      </AnimatePresence>\n\n      {/* Bottom Navigation */}\n      <BottomNav currentView={currentView} setCurrentView={setCurrentView} />\n    </div>\n  );\n};\n\n// ==================== Header 元件 ====================\n\nconst Header: React.FC<{ playerStats: PlayerStats }> = ({ playerStats }) => {\n  return (\n    <motion.div\n      initial={{ y: -20, opacity: 0 }}\n      animate={{ y: 0, opacity: 1 }}\n      className=\"bg-white/10 backdrop-blur-lg rounded-2xl p-4 mb-6 border border-white/20\"\n    >\n      <div className=\"flex justify-between items-center\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-12 h-12 bg-gradient-to-br from-green-400 to-blue-500 rounded-full flex items-center justify-center\">\n            <User className=\"w-6 h-6\" />\n          </div>\n          <div>\n            <h2 className=\"font-bold text-lg\">{playerStats.username}</h2>\n            <p className=\"text-sm text-green-300\">Lv.{playerStats.level}</p>\n          </div>\n        </div>\n        <div className=\"flex items-center gap-4\">\n          <div className=\"flex items-center gap-2 bg-yellow-500/20 px-3 py-1 rounded-lg\">\n            <Trophy className=\"w-4 h-4 text-yellow-400\" />\n            <span className=\"font-bold\">{playerStats.coins.toLocaleString()}</span>\n          </div>\n          <div className=\"flex items-center gap-2 bg-orange-500/20 px-3 py-1 rounded-lg\">\n            <Flame className=\"w-4 h-4 text-orange-400\" />\n            <span className=\"font-bold\">{playerStats.streak}憭?/span>\n          </div>\n        </div>\n      </div>\n    </motion.div>\n  );\n};\n\n// ==================== 擐? ====================\n\nconst HomePage: React.FC<{\n  playerStats: PlayerStats;\n  onCompleteTask: (name: string, reward: number) => void;\n}> = ({ playerStats, onCompleteTask }) => {\n  return (\n    <motion.div\n      initial={{ opacity: 0, y: 20 }}\n      animate={{ opacity: 1, y: 0 }}\n      exit={{ opacity: 0, y: -20 }}\n      className=\"space-y-6\"\n    >\n      {/* 瘥蝎暸?∠? */}\n      <section>\n        <h3 className=\"text-xl font-bold mb-4 flex items-center gap-2\">\n          <Star className=\"w-6 h-6 text-yellow-400\" />\n          瘥蝎暸?∠?\n        </h3>\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n          {SAMPLE_CARDS.slice(0, 3).map((card, index) => (\n            <ESGCardComponent key={card.id} card={card} isNew={index === 0} />\n          ))}\n        </div>\n      </section>\n\n      {/* 隞隞餃? */}\n      <section>\n        <h3 className=\"text-xl font-bold mb-4 flex items-center gap-2\">\n          <BookOpen className=\"w-6 h-6 text-blue-400\" />\n          隞隞餃?\n          <span className=\"text-sm font-normal text-green-400 ml-auto\">暺?隞餃?隞亙?????/span>\n        </h3>\n        <div className=\"bg-white/10 backdrop-blur-lg rounded-2xl p-4 space-y-3 border border-white/20\">\n          <TaskItem task=\"?餃?\" reward={50} completed={true} onClick={() => {}} />\n          <TaskItem\n            task=\"摰? 3 ??ESG 撠葫撽"\n            reward={100}\n            completed={false}\n            onClick={() => onCompleteTask('摰? 3 ??ESG 撠葫撽?, 100)}\n          />\n          <TaskItem\n            task=\"?末????1 ?廄"\n            reward={150}\n            completed={false}\n            onClick={() => onCompleteTask('?末????1 ??, 150)}\n          />\n        </div>\n      </section>\n\n      {/* ?祇望???*/}\n      <section>\n        <div className=\"bg-gradient-to-r from-purple-500/20 to-pink-500/20 backdrop-blur-lg rounded-2xl p-6 border border-purple-400/30\">\n          <h3 className=\"text-lg font-bold mb-2\">?? ?祇望???/h3>\n          <p className=\"text-gray-300 mb-3\">?園? 10 撘萇憓??∠?</p>\n          <div className=\"flex items-center gap-2 mb-2\">\n            <div className=\"flex-1 bg-white/20 rounded-full h-3 overflow-hidden\">\n              <div\n                className=\"bg-gradient-to-r from-green-400 to-emerald-500 h-full\"\n                style={{ width: '80%' }}\n              ></div>\n            </div>\n            <span className=\"text-sm font-bold\">8/10</span>\n          </div>\n          <p className=\"text-xs text-gray-400\">?榆 2 撘萄?臬????嚗?00 ?</p>\n        </div>\n      </section>\n\n      {/* ?圈 */}\n      <motion.div\n        initial={{ scale: 0.9, opacity: 0 }}\n        animate={{ scale: 1, opacity: 1 }}\n        className=\"bg-green-500/20 backdrop-blur-lg rounded-2xl p-4 border border-green-400/30\"\n      >\n        <p className=\"flex items-center gap-2\">\n          <Trophy className=\"w-5 h-5 text-yellow-400\" />\n          <span className=\"font-bold\">?剖?嚗?/span>\n          ?刻圾???偶蝥??噬蝡?\n        </p>\n      </motion.div>\n    </motion.div>\n  );\n};\n\n// ==================== ESG ?∠?元件 ====================\n\nconst ESGCardComponent: React.FC<{ card: ESGCard; isNew?: boolean }> = ({\n  card,\n  isNew = false,\n}) => {\n  const [isHovered, setIsHovered] = useState(false);\n\n  const categoryColors = {\n    E: 'from-green-500 to-emerald-600',\n    S: 'from-blue-500 to-cyan-600',\n    G: 'from-purple-500 to-pink-600',\n  };\n\n  const rarityStars = '潃?.repeat(card.rarity);\n\n  return (\n    <motion.div\n      whileHover={{ scale: 1.05, y: -10 }}\n      whileTap={{ scale: 0.95 }}\n      onHoverStart={() => setIsHovered(true)}\n      onHoverEnd={() => setIsHovered(false)}\n      className=\"relative cursor-pointer\"\n    >\n      {isNew && (\n        <div className=\"absolute -top-2 -right-2 bg-red-500 text-white px-3 py-1 rounded-full text-xs font-bold z-10 animate-pulse\">\n          ??NEW!\n        </div>\n      )}\n\n      <div className={`bg-gradient-to-br ${categoryColors[card.category]} p-0.5 rounded-xl`}>\n        <div className=\"bg-slate-900/90 backdrop-blur-sm rounded-xl p-4 h-full\">\n          {/* ?∠??剝 */}\n          <div className=\"flex justify-between items-start mb-3\">\n            <div className=\"text-xs font-bold opacity-70\">{card.id}</div>\n            <div className=\"text-sm\">{rarityStars}</div>\n          </div>\n\n          {/* ?∠???? */}\n          <div className=\"bg-gradient-to-br from-slate-800 to-slate-700 rounded-lg aspect-square flex items-center justify-center mb-3 text-5xl\">\n            {card.emoji}\n          </div>\n\n          {/* ?∠?璅? */}\n          <h4 className=\"font-bold text-lg mb-1\">{card.name}</h4>\n          <p className=\"text-xs text-gray-400 mb-3\">{card.nameEn}</p>\n\n          {/* ?賢???*/}\n          <div className=\"grid grid-cols-2 gap-2 mb-3\">\n            <div className=\"bg-white/10 rounded-lg p-2 text-center\">\n              <div className=\"flex items-center justify-center gap-1 text-xs text-gray-400\">\n                <Zap className=\"w-3 h-3\" />\n                <span>?賢???/span>\n              </div>\n              <div className=\"text-xl font-bold text-yellow-400\">{card.power}</div>\n            </div>\n            <div className=\"bg-white/10 rounded-lg p-2 text-center\">\n              <div className=\"flex items-center justify-center gap-1 text-xs text-gray-400\">\n                <Brain className=\"w-3 h-3\" />\n                <span>?亥???/span>\n              </div>\n              <div className=\"text-xl font-bold text-blue-400\">{card.knowledge}</div>\n            </div>\n          </div>\n\n          {/* ??隤芣? */}\n          <AnimatePresence>\n            {isHovered && (\n              <motion.div\n                initial={{ opacity: 0, height: 0 }}\n                animate={{ opacity: 1, height: 'auto' }}\n                exit={{ opacity: 0, height: 0 }}\n                className=\"text-xs text-gray-300 space-y-1\"\n              >\n                <p>? {card.effect}</p>\n                <p className=\"text-gray-500\">?? {card.source}</p>\n              </motion.div>\n            )}\n          </AnimatePresence>\n        </div>\n      </div>\n    </motion.div>\n  );\n};\n\n// ==================== 隞餃??元件 ====================\n\nconst TaskItem: React.FC<{\n  task: string;\n  reward: number;\n  completed: boolean;\n  onClick: () => void;\n}> = ({ task, reward, completed, onClick }) => {\n  return (\n    <div\n      className={`flex items-center justify-between p-2 rounded-lg cursor-pointer ${completed ? 'opacity-50' : 'hover:bg-white/10'}`}\n      onClick={!completed ? onClick : undefined}\n    >\n      <div className=\"flex items-center gap-3\">\n        <div\n          className={`w-6 h-6 rounded-full flex items-center justify-center ${\n            completed ? 'bg-green-500' : 'bg-gray-600'\n          }`}\n        >\n          {completed ? '?? : '??}\n        </div>\n        <span className={completed ? 'line-through text-gray-400' : ''}>{task}</span>\n      </div>\n      <div className=\"text-yellow-400 font-bold\">+{reward} ?</div>\n    </div>\n  );\n};\n\n// ==================== ?嗉?擗券???====================\n\nconst CollectionPage: React.FC = () => {\n  const [filter, setFilter] = useState<'all' | 'E' | 'S' | 'G'>('all');\n\n  const filteredCards =\n    filter === 'all' ? SAMPLE_CARDS : SAMPLE_CARDS.filter(card => card.category === filter);\n\n  return (\n    <motion.div\n      initial={{ opacity: 0, y: 20 }}\n      animate={{ opacity: 1, y: 0 }}\n      exit={{ opacity: 0, y: -20 }}\n      className=\"space-y-6\"\n    >\n      <h2 className=\"text-2xl font-bold flex items-center gap-2\">?? ???∠??嗉?擗?/h2>\n\n      {/* 蝭拚??*/}\n      <div className=\"flex gap-2 flex-wrap\">\n        <FilterButton active={filter === 'all'} onClick={() => setFilter('all')}>\n          ?券\n        </FilterButton>\n        <FilterButton active={filter === 'E'} onClick={() => setFilter('E')}>\n          ? ?啣?\n        </FilterButton>\n        <FilterButton active={filter === 'S'} onClick={() => setFilter('S')}>\n          ? 蝷暹?\n        </FilterButton>\n        <FilterButton active={filter === 'G'} onClick={() => setFilter('G')}>\n          ? 瘝餌?\n        </FilterButton>\n      </div>\n\n      {/* ?脣漲璇?*/}\n      <div className=\"bg-white/10 backdrop-blur-lg rounded-2xl p-4 border border-white/20\">\n        <div className=\"flex justify-between items-center mb-2\">\n          <span className=\"font-bold\">?嗉??脣漲</span>\n          <span className=\"text-green-400 font-bold\">45/54 (83%)</span>\n        </div>\n        <div className=\"bg-white/20 rounded-full h-3 overflow-hidden\">\n          <div\n            className=\"bg-gradient-to-r from-green-400 to-emerald-500 h-full\"\n            style={{ width: '83%' }}\n          ></div>\n        </div>\n      </div>\n\n      {/* ?∠?蝬脫 */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 lg:grid-cols-4 gap-4\">\n        {filteredCards.map(card => (\n          <ESGCardComponent key={card.id} card={card} />\n        ))}\n        {/* ?芰敺??*/}\n        {[...Array(9)].map((_, i) => (\n          <div\n            key={`locked-${i}`}\n            className=\"bg-white/5 backdrop-blur-sm rounded-xl p-4 border-2 border-dashed border-white/20\"\n          >\n            <div className=\"aspect-square flex items-center justify-center text-6xl opacity-30\">\n              <Lock className=\"w-16 h-16\" />\n            </div>\n            <p className=\"text-center mt-4 text-gray-500\">?芰敺?/p>\n          </div>\n        ))}\n      </div>\n    </motion.div>\n  );\n};\n\n// ==================== ?停? ====================\n\nconst AchievementsPage: React.FC<{ playerStats: PlayerStats }> = ({ playerStats }) => {\n  return (\n    <motion.div\n      initial={{ opacity: 0, y: 20 }}\n      animate={{ opacity: 1, y: 0 }}\n      exit={{ opacity: 0, y: -20 }}\n      className=\"space-y-6\"\n    >\n      <h2 className=\"text-2xl font-bold flex items-center gap-2\">?? 雿??停畾踹?</h2>\n\n      {/* ?犖蝯梯? */}\n      <div className=\"bg-white/10 backdrop-blur-lg rounded-2xl p-6 border border-white/20\">\n        <h3 className=\"font-bold text-lg mb-4\">?犖蝯梯?</h3>\n        <div className=\"grid grid-cols-2 md:grid-cols-3 gap-4\">\n          <StatItem label=\"蝮賜??" value={`${playerStats.coins.toLocaleString()} ?`} />\n          <StatItem label=\"?嗅?蝑?\" value={`Lv.${playerStats.level} ?︶} />\n          <StatItem label=\"????餃\" value={`? ${playerStats.streak} 憭奈} />\n          <StatItem\n            label=\"?∠??園?\"\n            value={`${playerStats.ownedCards}/${playerStats.totalCards} ?`}\n          />\n          <StatItem label=\"撠??\" value={`${playerStats.winRate}%`} />\n          <StatItem label=\"??稞" value={`${playerStats.wins}?} />\n        </div>\n      </div>\n\n      {/* ?停蝬脫 */}\n      <div className=\"grid grid-cols-2 md:grid-cols-3 gap-4\">\n        {SAMPLE_ACHIEVEMENTS.map(achievement => (\n          <AchievementCard key={achievement.id} achievement={achievement} />\n        ))}\n      </div>\n\n      {/* ?祇望?銵? */}\n      <div className=\"bg-white/10 backdrop-blur-lg rounded-2xl p-6 border border-white/20\">\n        <h3 className=\"font-bold text-lg mb-4 flex items-center gap-2\">\n          <Trophy className=\"w-6 h-6 text-yellow-400\" />\n          ?祇望?銵?\n        </h3>\n        <div className=\"space-y-2\">\n          <RankItem rank={1} name=\"永續銋?\" score={50200} change={2} />\n          <RankItem rank={2} name=\"蝬憟喟?\" score={48900} change={-1} />\n          <RankItem rank={3} name=\"ESG ?啁?\" score={45300} change={0} />\n          <div className=\"text-center text-gray-500 text-sm py-2\">...</div>\n          <RankItem\n            rank={127}\n            name={`雿???{playerStats.username.split('繚')[1]}`}\n            score={playerStats.coins}\n            change={12}\n            highlight\n          />\n        </div>\n      </div>\n    </motion.div>\n  );\n};\n\n// ==================== 蝡嗆??湧???====================\n\nconst ArenaPage: React.FC = () => {\n  return (\n    <motion.div\n      initial={{ opacity: 0, y: 20 }}\n      animate={{ opacity: 1, y: 0 }}\n      exit={{ opacity: 0, y: -20 }}\n      className=\"space-y-6\"\n    >\n      <h2 className=\"text-2xl font-bold flex items-center gap-2\">?? ESG ?∠?蝡嗆???/h2>\n\n      <div className=\"bg-white/10 backdrop-blur-lg rounded-2xl p-8 border border-white/20 text-center\">\n        <Swords className=\"w-24 h-24 mx-auto mb-6 text-yellow-400\" />\n        <h3 className=\"text-2xl font-bold mb-4\">蝡嗆??游撠??橘?</h3>\n        <p className=\"text-gray-300 mb-6\">撠系統甇??銝哨??祈???...</p>\n        <button className=\"bg-gradient-to-r from-blue-500 to-purple-500 px-8 py-3 rounded-xl font-bold hover:scale-105 transition-transform\">\n          ????閱n        </button>\n      </div>\n\n      {/* 撠?汗 */}\n      <div className=\"bg-gradient-to-br from-purple-500/20 to-pink-500/20 backdrop-blur-lg rounded-2xl p-6 border border-purple-400/30\">\n        <h3 className=\"font-bold text-lg mb-4\">?喳??典????/h3>\n        <ul className=\"space-y-2 text-gray-300\">\n          <li className=\"flex items-center gap-2\">??PvP ?單?撠</li>\n          <li className=\"flex items-center gap-2\">?????嗥??亦瘜?/li>\n          <li className=\"flex items-center gap-2\">???寞???賜頂蝯?/li>\n          <li className=\"flex items-center gap-2\">???函???</li>\n          <li className=\"flex items-center gap-2\">??鞈賢迤?</li>\n        </ul>\n      </div>\n    </motion.div>\n  );\n};\n\n// ==================== ?犖? ====================\n\nconst ProfilePage: React.FC<{ playerStats: PlayerStats }> = ({ playerStats }) => {\n  return (\n    <motion.div\n      initial={{ opacity: 0, y: 20 }}\n      animate={{ opacity: 1, y: 0 }}\n      exit={{ opacity: 0, y: -20 }}\n      className=\"space-y-6\"\n    >\n      <h2 className=\"text-2xl font-bold flex items-center gap-2\">? ?犖鞈?</h2>\n\n      {/* ?剖???祈???*/}\n      <div className=\"bg-white/10 backdrop-blur-lg rounded-2xl p-6 border border-white/20\">\n        <div className=\"flex items-center gap-4 mb-6\">\n          <div className=\"w-24 h-24 bg-gradient-to-br from-green-400 to-blue-500 rounded-full flex items-center justify-center text-3xl\">\n            <User className=\"w-12 h-12\" />\n          </div>\n          <div>\n            <h3 className=\"text-2xl font-bold\">{playerStats.username}</h3>\n            <p className=\"text-green-400\">蝑? {playerStats.level}</p>\n            <div className=\"flex items-center gap-2 mt-2\">\n              <div className=\"flex-1 bg-white/20 rounded-full h-2 w-48 overflow-hidden\">\n                <div\n                  className=\"bg-gradient-to-r from-green-400 to-emerald-500 h-full\"\n                  style={{ width: '68%' }}\n                ></div>\n              </div>\n              <span className=\"text-xs text-gray-400\">68%</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* 閰喟敦蝯梯? */}\n      <div className=\"bg-white/10 backdrop-blur-lg rounded-2xl p-6 border border-white/20\">\n        <h3 className=\"font-bold text-lg mb-4\">閰喟敦蝯梯?</h3>\n        <div className=\"space-y-3\">\n          <StatBar label=\"?∠??園??" value={83} color=\"from-green-400 to-emerald-500\" />\n          <StatBar label=\"撠??\" value={playerStats.winRate} color=\"from-blue-400 to-cyan-500\" />\n          <StatBar label=\"?亥??摨吒" value={75} color=\"from-purple-400 to-pink-500\" />\n          <StatBar label=\"瘣餉?摨吒" value={90} color=\"from-yellow-400 to-orange-500\" />\n        </div>\n      </div>\n    </motion.div>\n  );\n};\n\n// ==================== 頛元件 ====================\n\nconst FilterButton: React.FC<{\n  active: boolean;\n  onClick: () => void;\n  children: React.ReactNode;\n}> = ({ active, onClick, children }) => {\n  return (\n    <button\n      onClick={onClick}\n      className={`px-4 py-2 rounded-lg font-bold transition-all ${\n        active\n          ? 'bg-gradient-to-r from-green-500 to-emerald-600 text-white scale-105'\n          : 'bg-white/10 text-gray-300 hover:bg-white/20'\n      }`}\n    >\n      {children}\n    </button>\n  );\n};\n\nconst StatItem: React.FC<{ label: string; value: string }> = ({ label, value }) => {\n  return (\n    <div>\n      <div className=\"text-xs text-gray-400 mb-1\">{label}</div>\n      <div className=\"text-xl font-bold\">{value}</div>\n    </div>\n  );\n};\n\nconst AchievementCard: React.FC<{ achievement: Achievement }> = ({ achievement }) => {\n  const tierColors = {\n    bronze: 'from-orange-700 to-orange-500',\n    silver: 'from-gray-400 to-gray-200',\n    gold: 'from-yellow-500 to-yellow-300',\n    platinum: 'from-purple-500 to-purple-300',\n    diamond: 'from-cyan-500 to-blue-300',\n  };\n\n  return (\n    <motion.div\n      whileHover={{ scale: 1.05 }}\n      className={`rounded-xl p-4 border-2 ${\n        achievement.unlocked\n          ? `bg-gradient-to-br ${tierColors[achievement.tier]} border-white/30`\n          : 'bg-white/5 border-white/10 opacity-50'\n      }`}\n    >\n      <div className=\"text-center\">\n        <div className=\"text-5xl mb-2\">{achievement.unlocked ? achievement.emoji : '??'}</div>\n        <h4 className=\"font-bold mb-1\">{achievement.name}</h4>\n        <p className=\"text-xs text-gray-300 mb-2\">{achievement.requirement}</p>\n        {achievement.unlockedAt && (\n          <p className=\"text-xs text-gray-400\">{achievement.unlockedAt}</p>\n        )}\n      </div>\n    </motion.div>\n  );\n};\n\nconst RankItem: React.FC<{\n  rank: number;\n  name: string;\n  score: number;\n  change: number;\n  highlight?: boolean;\n}> = ({ rank, name, score, change, highlight }) => {\n  const medal = rank === 1 ? '??' : rank === 2 ? '??' : rank === 3 ? '??' : '';\n\n  return (\n    <div\n      className={`flex items-center justify-between p-3 rounded-lg ${\n        highlight ? 'bg-green-500/20 border-2 border-green-400' : 'bg-white/5'\n      }`}\n    >\n      <div className=\"flex items-center gap-3\">\n        <span className=\"w-8 font-bold text-center\">{medal || rank + '.'}</span>\n        <span>{name}</span>\n      </div>\n      <div className=\"flex items-center gap-4\">\n        <span className=\"font-bold\">{score.toLocaleString()} ??/span>\n        <TrendIcon change={change} />\n      </div>\n    </div>\n  );\n};\n\nconst TrendIcon: React.FC<{ change: number }> = ({ change }) => {\n  if (change > 0) return <span className=\"text-green-400\">漎? +{change}</span>;\n  if (change < 0) return <span className=\"text-red-400\">漎? {change}</span>;\n  return <span className=\"text-gray-400\">?∴? 0</span>;\n};\n\nconst StatBar: React.FC<{ label: string; value: number; color: string }> = ({\n  label,\n  value,\n  color,\n}) => {\n  return (\n    <div>\n      <div className=\"flex justify-between text-sm mb-1\">\n        <span>{label}</span>\n        <span className=\"font-bold\">{value}%</span>\n      </div>\n      <div className=\"bg-white/20 rounded-full h-2 overflow-hidden\">\n        <div\n          className={`bg-gradient-to-r ${color} h-full transition-all duration-500`}\n          style={{ width: `${value}%` }}\n        ></div>\n      </div>\n    </div>\n  );\n};\n\n// ==================== 摨撠 ====================\n\nconst BottomNav: React.FC<{\n  currentView: string;\n  setCurrentView: (view: 'home' | 'collection' | 'arena' | 'achievements' | 'profile') => void;\n}> = ({ currentView, setCurrentView }) => {\n  const navItems = [\n    { id: 'home', icon: Home, label: '擐?' },\n    { id: 'collection', icon: BookOpen, label: '?∠?摨? },\n    { id: 'arena', icon: Swords, label: '蝡嗆??? },\n    { id: 'achievements', icon: Award, label: '?停' },\n    { id: 'profile', icon: User, label: '?犖' },\n  ];\n\n  return (\n    <div className=\"fixed bottom-0 left-0 right-0 bg-slate-900/95 backdrop-blur-lg border-t border-white/10 p-4\">\n      <div className=\"max-w-7xl mx-auto flex justify-around\">\n        {navItems.map(item => (\n          <button\n            key={item.id}\n            onClick={() => setCurrentView(item.id as any)}\n            className={`flex flex-col items-center gap-1 transition-all ${\n              currentView === item.id\n                ? 'text-green-400 scale-110'\n                : 'text-gray-400 hover:text-white'\n            }`}\n          >\n            <item.icon className=\"w-6 h-6\" />\n            <span className=\"text-xs font-bold\">{item.label}</span>\n          </button>\n        ))}\n      </div>\n    </div>\n  );\n};\n\nexport default ESGGoGame;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\ESG\\AIDigitalTwin.tsx","messages":[{"ruleId":"react-hooks/purity","severity":2,"message":"Error: Cannot call impure function during render\n\n`Date.now` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\ESG\\AIDigitalTwin.tsx:49:18\n  47 |       role: 'system',\n  48 |       content: 'SYSTEM ONLINE. OMNI-ADAPTIVE PROTOCOL ENGAGED.',\n> 49 |       timestamp: Date.now(),\n     |                  ^^^^^^^^^^ Cannot call impure function\n  50 |       type: 'code',\n  51 |     },\n  52 |     {","line":49,"column":18,"nodeType":null,"endLine":49,"endColumn":28},{"ruleId":"react-hooks/purity","severity":2,"message":"Error: Cannot call impure function during render\n\n`Date.now` is an impure function. Calling an impure function can produce unstable results that update unpredictably when the component happens to re-render. (https://react.dev/reference/rules/components-and-hooks-must-be-pure#components-and-hooks-must-be-idempotent).\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\ESG\\AIDigitalTwin.tsx:56:18\n  54 |       role: 'system',\n  55 |       content: '甇∟???嚗??桀??雿?頨怎頂蝯勗歇?郊撠梁???,\n> 56 |       timestamp: Date.now(),\n     |                  ^^^^^^^^^^ Cannot call impure function\n  57 |       type: 'text',\n  58 |     },\n  59 |   ]);","line":56,"column":18,"nodeType":null,"endLine":56,"endColumn":28},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1500.","line":103,"column":8,"nodeType":"Literal","messageId":"noMagic","endLine":103,"endColumn":12}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * ?? AI Agent - Digital Twin (v4.0 Ultimate)\n * --------------------------------------------------\n * [Feature] E1 - Hacker/Jarvis Style Chat Interface\n * [Style] Matrix / Cyberpunk Terminal\n * [Language] Traditional Chinese (UI), English (Code)\n */\n\nimport React, { useState, useRef, useEffect } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport {\n  Bot,\n  Send,\n  Sparkles,\n  Brain,\n  Cpu,\n  Settings,\n  X,\n  Terminal,\n  Activity,\n  Wifi,\n  Battery,\n  Database,\n  Lock,\n  Shield,\n  Eye,\n  Code,\n  Command,\n  TrendingUp,\n} from 'lucide-react';\nimport { useESGStore } from '@/store/useESGStore';\nimport { useOmniResonance } from '../../5-store/useOmniResonance';\n\n// --- Type Definitions ---\nexport interface ChatMessage {\n  id: string;\n  role: 'user' | 'system';\n  content: string;\n  timestamp: number;\n  type?: 'text' | 'code' | 'alert';\n}\n\nexport const AIDigitalTwin: React.FC = () => {\n  const [messages, setMessages] = useState<ChatMessage[]>([\n    {\n      id: 'init-1',\n      role: 'system',\n      content: 'SYSTEM ONLINE. OMNI-ADAPTIVE PROTOCOL ENGAGED.',\n      timestamp: Date.now(),\n      type: 'code',\n    },\n    {\n      id: 'init-2',\n      role: 'system',\n      content: '甇∟???嚗??桀??雿?頨怎頂蝯勗歇?郊撠梁???,\n      timestamp: Date.now(),\n      type: 'text',\n    },\n  ]);\n  const [inputValue, setInputValue] = useState('');\n  const [isTyping, setIsTyping] = useState(false);\n  const messagesEndRef = useRef<HTMLDivElement>(null);\n\n  // Use global hook (returns resonance instead of resonanceLevel)\n  const { resonance } = useOmniResonance();\n\n  const scrollToBottom = () => {\n    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });\n  };\n\n  useEffect(() => {\n    scrollToBottom();\n  }, [messages]);\n\n  const handleSendMessage = async () => {\n    if (!inputValue.trim()) return;\n\n    const newUserMsg: ChatMessage = {\n      id: Date.now().toString(),\n      role: 'user',\n      content: inputValue,\n      timestamp: Date.now(),\n      type: 'text',\n    };\n\n    setMessages(prev => [...prev, newUserMsg]);\n    setInputValue('');\n    setIsTyping(true);\n\n    // Simulate AI Response\n    setTimeout(() => {\n      const newSystemMsg: ChatMessage = {\n        id: (Date.now() + 1).toString(),\n        role: 'system',\n        content: `甇????誘: \"${newUserMsg.content}\"... \\n設計敶梢璈?: ${(\n          Math.random() * 100\n        ).toFixed(2)}%`,\n        timestamp: Date.now(),\n        type: 'text',\n      };\n      setMessages(prev => [...prev, newSystemMsg]);\n      setIsTyping(false);\n    }, 1500);\n  };\n\n  const handleKeyDown = (e: React.KeyboardEvent) => {\n    if (e.key === 'Enter' && !e.shiftKey) {\n      e.preventDefault();\n      handleSendMessage();\n    }\n  };\n\n  return (\n    <div className=\"flex flex-col h-screen bg-black text-green-500 font-mono p-4 overflow-hidden relative\">\n      {/* Background Effects */}\n      <div className=\"absolute inset-0 bg-[linear-gradient(rgba(0,255,0,0.03)_1px,transparent_1px),linear-gradient(90deg,rgba(0,255,0,0.03)_1px,transparent_1px)] bg-[size:20px_20px] pointer-events-none\"></div>\n      <div className=\"absolute inset-0 bg-black/80 pointer-events-none radial-gradient(circle at center, transparent 0%, black 100%)\"></div>\n\n      {/* Header */}\n      <header className=\"flex justify-between items-center mb-4 border-b border-green-500/30 pb-2 z-10 relative\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"p-2 border border-green-500 rounded bg-green-500/10 animate-pulse\">\n            <Bot size={24} />\n          </div>\n          <div>\n            <h1 className=\"text-xl font-bold tracking-widest text-green-400 drop-shadow-[0_0_5px_rgba(74,222,128,0.5)]\">\n              OMNI-AI TWIN\n            </h1>\n            <div className=\"text-[10px] text-green-600 flex gap-2\">\n              <span>V4.0.1 ULTIMATE</span>\n              <span>|</span>\n              <span>?梢陷?? {resonance?.toFixed(2) || 'OFFLINE'}</span>\n            </div>\n          </div>\n        </div>\n        <div className=\"flex gap-4 text-xs text-green-600/80\">\n          <div className=\"flex flex-col items-end\">\n            <span className=\"flex items-center gap-1\">\n              <Wifi size={10} /> 蝬脰楝: 摰\n            </span>\n            <span className=\"flex items-center gap-1\">\n              <Activity size={10} /> CPU: 12%\n            </span>\n          </div>\n          <div className=\"flex flex-col items-end\">\n            <span className=\"flex items-center gap-1\">\n              <Database size={10} /> 閮擃? 34TB\n            </span>\n            <span className=\"flex items-center gap-1\">\n              <Battery size={10} /> ?賡?: 98%\n            </span>\n          </div>\n        </div>\n      </header>\n\n      {/* Main Chat Area */}\n      <div className=\"flex-1 overflow-y-auto mb-4 border border-green-500/20 rounded bg-black/40 p-4 custom-scrollbar z-10 relative shadow-[inset_0_0_20px_rgba(0,50,0,0.5)]\">\n        <AnimatePresence>\n          {messages.map(msg => (\n            <motion.div\n              key={msg.id}\n              initial={{ opacity: 0, x: -20 }}\n              animate={{ opacity: 1, x: 0 }}\n              className={`mb-4 flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}\n            >\n              <div\n                className={`max-w-[80%] p-3 rounded ${\n                  msg.role === 'user'\n                    ? 'bg-green-900/20 border border-green-500/50 text-green-300'\n                    : 'bg-black/60 border border-green-500/30 text-green-400'\n                }`}\n              >\n                <div className=\"text-[10px] opacity-50 mb-1 flex items-center gap-2\">\n                  {msg.role === 'user' ? (\n                    <>\n                      <span>雿輻??/span> <Command size={10} />\n                    </>\n                  ) : (\n                    <>\n                      <Terminal size={10} /> <span>系統協議</span>\n                    </>\n                  )}\n                  <span>{new Date(msg.timestamp).toLocaleTimeString()}</span>\n                </div>\n                <div className=\"whitespace-pre-wrap leading-relaxed font-mono\">\n                  {msg.type === 'code' ? (\n                    <code className=\"block bg-black/80 p-2 rounded border border-green-900/50 text-xs\">\n                      {msg.content}\n                    </code>\n                  ) : (\n                    msg.content\n                  )}\n                </div>\n              </div>\n            </motion.div>\n          ))}\n          {isTyping && (\n            <motion.div\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              className=\"text-green-500/50 text-xs animate-pulse flex items-center gap-2\"\n            >\n              <Cpu size={12} className=\"animate-spin\" /> 邏輯銝?..\n            </motion.div>\n          )}\n        </AnimatePresence>\n        <div ref={messagesEndRef} />\n      </div>\n\n      {/* Input Area */}\n      <div className=\"flex gap-2 z-10 relative\">\n        <div className=\"flex-1 relative\">\n          <input\n            type=\"text\"\n            value={inputValue}\n            onChange={e => setInputValue(e.target.value)}\n            onKeyDown={handleKeyDown}\n            placeholder=\"隢撓?交?隞斗??亥岷...\"\n            className=\"w-full bg-black/80 border border-green-500/30 text-green-400 p-3 pl-4 rounded focus:outline-none focus:border-green-500 focus:shadow-[0_0_15px_rgba(74,222,128,0.2)] placeholder-green-800 font-mono transition-all\"\n          />\n          <div className=\"absolute right-3 top-1/2 -translate-y-1/2 flex gap-2 text-green-800\">\n            <Code size={16} />\n            <Lock size={16} />\n          </div>\n        </div>\n        <button\n          onClick={handleSendMessage}\n          className=\"bg-green-900/20 border border-green-500/50 text-green-400 px-6 rounded hover:bg-green-500/20 hover:text-green-300 transition-all flex items-center justify-center active:scale-95\"\n        >\n          <Send size={20} />\n        </button>\n      </div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\ESG\\CarbonAssetTrading.tsx","messages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\ESG\\CarbonAssetTrading.tsx:52:5\n  50 |   useEffect(() => {\n  51 |     // 璅⊥頛數據\n> 52 |     setCarbonAssets([\n     |     ^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  53 |       {\n  54 |         id: 'CA-001',\n  55 |         type: 'CarbonCredit', // 蝣單?","line":52,"column":5,"nodeType":null,"endLine":52,"endColumn":20},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 86400000.","line":83,"column":39,"nodeType":"Literal","messageId":"noMagic","endLine":83,"endColumn":47},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 172800000.","line":93,"column":39,"nodeType":"Literal","messageId":"noMagic","endLine":93,"endColumn":48}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * ? 蝣唾??Ｚ?蝣喃漱?頂蝯崤n * --------------------------------------------------\n * [?] 蝣唾??Ｙ恣?４鈭斗?撣?４頞唾楚追蹤\n * [隤?] ?函?擃葉?n */\n\nimport React, { useState, useEffect } from 'react';\nimport { motion } from 'framer-motion';\nimport { Leaf, TrendingUp, ArrowUpDown, DollarSign, BarChart3 } from 'lucide-react';\n\nexport interface CarbonAsset {\n  id: string;\n  type: 'CarbonCredit' | 'CarbonCredit' | 'VCS' | 'GS'; // Using generic English terms where applicable or keeping logic\n  quantity: number;\n  unit: 'tCO2e';\n  price: number;\n  totalValue: number;\n  expiryDate: Date;\n  certificationStandard: string;\n}\n\nexport interface CarbonTransactionRecord {\n  id: string;\n  type: 'Buy' | 'Sell';\n  assetType: string;\n  quantity: number;\n  unitPrice: number;\n  totalAmount: number;\n  transactionTime: number;\n  counterparty: string;\n}\n\nexport interface CarbonFootprintData {\n  period: string;\n  scope1: number;\n  scope2: number;\n  scope3: number;\n  totalEmissions: number;\n  reductionTarget: number;\n  achievementRate: number;\n}\n\nexport const CarbonAssetTrading: React.FC = () => {\n  const [carbonAssets, setCarbonAssets] = useState<CarbonAsset[]>([]);\n  const [transactionRecords, setTransactionRecords] = useState<CarbonTransactionRecord[]>([]);\n  const [carbonFootprint, setCarbonFootprint] = useState<CarbonFootprintData | null>(null);\n  const [currentTab, setCurrentTab] = useState<'Assets' | 'Transactions' | 'Footprint'>('Assets');\n\n  useEffect(() => {\n    // 璅⊥頛數據\n    setCarbonAssets([\n      {\n        id: 'CA-001',\n        type: 'CarbonCredit', // 蝣單?\n        quantity: 1000,\n        unit: 'tCO2e',\n        price: 25,\n        totalValue: 25000,\n        expiryDate: new Date('2025-12-31'),\n        certificationStandard: 'ISO 14064',\n      },\n      {\n        id: 'CA-002',\n        type: 'VCS',\n        quantity: 500,\n        unit: 'tCO2e',\n        price: 30,\n        totalValue: 15000,\n        expiryDate: new Date('2026-06-30'),\n        certificationStandard: 'Verified Carbon Standard',\n      },\n    ]);\n\n    setTransactionRecords([\n      {\n        id: 'TX-001',\n        type: 'Buy',\n        assetType: 'CarbonCredit',\n        quantity: 500,\n        unitPrice: 25,\n        totalAmount: 12500,\n        transactionTime: Date.now() - 86400000,\n        counterparty: '蝬蝘??∩遢???砍',\n      },\n      {\n        id: 'TX-002',\n        type: 'Sell',\n        assetType: 'VCS',\n        quantity: 200,\n        unitPrice: 30,\n        totalAmount: 6000,\n        transactionTime: Date.now() - 172800000,\n        counterparty: '永續鋆賡????,\n      },\n    ]);\n\n    setCarbonFootprint({\n      period: '2024 Q4',\n      scope1: 1200,\n      scope2: 800,\n      scope3: 2000,\n      totalEmissions: 4000,\n      reductionTarget: 5000,\n      achievementRate: 80,\n    });\n  }, []);\n\n  const totalAssetValue = carbonAssets.reduce((sum, asset) => sum + asset.totalValue, 0);\n\n  return (\n    <div className=\"CarbonAssetTradingContainer p-6 bg-gradient-to-br from-green-50 to-emerald-50 min-h-screen\">\n      {/* 璅? */}\n      <motion.div initial={{ opacity: 0, y: -20 }} animate={{ opacity: 1, y: 0 }} className=\"mb-8\">\n        <h1 className=\"text-3xl font-bold text-slate-800 mb-2 flex items-center gap-3\">\n          <Leaf className=\"text-green-600\" size={36} />\n          蝣唾??Ｚ?蝣喃漱?頂蝯崤n        </h1>\n        <p className=\"text-slate-600\">蝞∠?蝣唾??Ｕ蕭頩斤４頞唾楚???４鈭斗?撣</p>\n      </motion.div>\n\n      {/* 蝮質汗?∠? */}\n      <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4 mb-8\">\n        <OverviewCard\n          title=\"蝮質??Ｗ?墦"\n          value={`$${totalAssetValue.toLocaleString()}`}\n          icon={<DollarSign />}\n          color=\"green\"\n        />\n        <OverviewCard\n          title=\"蝣唾??Ｙ蜇?"\n          value={`${carbonAssets.reduce((sum, a) => sum + a.quantity, 0)} tCO2e`}\n          icon={<Leaf />}\n          color=\"emerald\"\n        />\n        <OverviewCard\n          title=\"?祆?鈭斗?\"\n          value={`${transactionRecords.length} 蝑}\n          icon={<ArrowUpDown />}\n          color=\"blue\"\n        />\n        <OverviewCard\n          title=\"皜?體驗?"\n          value={`${carbonFootprint?.achievementRate}%`}\n          icon={<TrendingUp />}\n          color=\"purple\"\n        />\n      </div>\n\n      {/* ?惜 */}\n      <div className=\"flex gap-2 mb-6\">\n        {(['Assets', 'Transactions', 'Footprint'] as const).map(tab => (\n          <button\n            key={tab}\n            onClick={() => setCurrentTab(tab)}\n            className={`px-6 py-3 rounded-lg font-medium transition-all ${\n              currentTab === tab\n                ? 'bg-green-600 text-white shadow-lg'\n                : 'bg-white text-slate-700 hover:bg-slate-100'\n            }`}\n          >\n            {tab === 'Assets' ? '鞈' : tab === 'Transactions' ? '鈭斗?' : '頞唾楚'}蝞∠?\n          </button>\n        ))}\n      </div>\n\n      {/* ?批捆? */}\n      {currentTab === 'Assets' && <CarbonAssetList assets={carbonAssets} />}\n      {currentTab === 'Transactions' && <TransactionRecordList records={transactionRecords} />}\n      {currentTab === 'Footprint' && carbonFootprint && (\n        <CarbonFootprintDashboard data={carbonFootprint} />\n      )}\n    </div>\n  );\n};\n\nconst OverviewCard: React.FC<{\n  title: string;\n  value: string;\n  icon: React.ReactNode;\n  color: string;\n}> = ({ title, value, icon, color }) => {\n  const colorClasses = {\n    green: 'from-green-400 to-green-600',\n    emerald: 'from-emerald-400 to-emerald-600',\n    blue: 'from-blue-400 to-blue-600',\n    purple: 'from-purple-400 to-purple-600',\n  };\n\n  return (\n    <motion.div\n      initial={{ opacity: 0, scale: 0.95 }}\n      animate={{ opacity: 1, scale: 1 }}\n      className=\"bg-white rounded-xl shadow-md p-6\"\n    >\n      <div className=\"flex items-center justify-between mb-3\">\n        <span className=\"text-sm text-slate-600\">{title}</span>\n        <div\n          className={`p-2 rounded-lg bg-gradient-to-r ${colorClasses[color as keyof typeof colorClasses]} text-white`}\n        >\n          {icon}\n        </div>\n      </div>\n      <div className=\"text-2xl font-bold text-slate-800\">{value}</div>\n    </motion.div>\n  );\n};\n\nconst CarbonAssetList: React.FC<{ assets: CarbonAsset[] }> = ({ assets }) => (\n  <div className=\"space-y-4\">\n    {assets.map(asset => (\n      <motion.div\n        key={asset.id}\n        initial={{ opacity: 0, x: -20 }}\n        animate={{ opacity: 1, x: 0 }}\n        className=\"bg-white rounded-xl shadow-md p-6\"\n      >\n        <div className=\"flex items-start justify-between mb-4\">\n          <div>\n            <h3 className=\"text-xl font-semibold text-slate-800 mb-1\">{asset.type}</h3>\n            <p className=\"text-sm text-slate-500\">{asset.id}</p>\n          </div>\n          <span className=\"px-3 py-1 bg-green-100 text-green-800 text-sm rounded-full\">\n            {asset.certificationStandard}\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4 mb-4\">\n          <div>\n            <div className=\"text-sm text-slate-600 mb-1\">?賊?</div>\n            <div className=\"text-lg font-bold text-slate-800\">\n              {asset.quantity} {asset.unit}\n            </div>\n          </div>\n          <div>\n            <div className=\"text-sm text-slate-600 mb-1\">?桀</div>\n            <div className=\"text-lg font-bold text-slate-800\">${asset.price}</div>\n          </div>\n          <div>\n            <div className=\"text-sm text-slate-600 mb-1\">蝮賢?/div>\n            <div className=\"text-lg font-bold text-green-600\">\n              ${asset.totalValue.toLocaleString()}\n            </div>\n          </div>\n          <div>\n            <div className=\"text-sm text-slate-600 mb-1\">?唳???/div>\n            <div className=\"text-lg font-bold text-slate-800\">\n              {asset.expiryDate.toLocaleDateString('zh-TW')}\n            </div>\n          </div>\n        </div>\n      </motion.div>\n    ))}\n  </div>\n);\n\nconst TransactionRecordList: React.FC<{ records: CarbonTransactionRecord[] }> = ({ records }) => (\n  <div className=\"bg-white rounded-xl shadow-md overflow-hidden\">\n    <table className=\"w-full\">\n      <thead className=\"bg-slate-50\">\n        <tr>\n          <th className=\"px-6 py-3 text-left text-sm font-semibold text-slate-700\">鈭斗?憿?</th>\n          <th className=\"px-6 py-3 text-left text-sm font-semibold text-slate-700\">蝣唾???/th>\n          <th className=\"px-6 py-3 text-left text-sm font-semibold text-slate-700\">?賊?</th>\n          <th className=\"px-6 py-3 text-left text-sm font-semibold text-slate-700\">?桀</th>\n          <th className=\"px-6 py-3 text-left text-sm font-semibold text-slate-700\">蝮賡?憿?/th>\n          <th className=\"px-6 py-3 text-left text-sm font-semibold text-slate-700\">鈭斗?撠情</th>\n        </tr>\n      </thead>\n      <tbody>\n        {records.map((record, index) => (\n          <tr key={record.id} className={index % 2 === 0 ? 'bg-white' : 'bg-slate-50'}>\n            <td className=\"px-6 py-4\">\n              <span\n                className={`px-3 py-1 rounded-full text-sm ${\n                  record.type === 'Buy'\n                    ? 'bg-blue-100 text-blue-800'\n                    : 'bg-orange-100 text-orange-800'\n                }`}\n              >\n                {record.type === 'Buy' ? '鞎瑕' : '鞈?'}\n              </span>\n            </td>\n            <td className=\"px-6 py-4 text-slate-800\">{record.assetType}</td>\n            <td className=\"px-6 py-4 text-slate-800\">{record.quantity} tCO2e</td>\n            <td className=\"px-6 py-4 text-slate-800\">${record.unitPrice}</td>\n            <td className=\"px-6 py-4 font-semibold text-slate-800\">\n              ${record.totalAmount.toLocaleString()}\n            </td>\n            <td className=\"px-6 py-4 text-slate-600\">{record.counterparty}</td>\n          </tr>\n        ))}\n      </tbody>\n    </table>\n  </div>\n);\n\nconst CarbonFootprintDashboard: React.FC<{ data: CarbonFootprintData }> = ({ data }) => (\n  <div className=\"space-y-6\">\n    <div className=\"bg-white rounded-xl shadow-md p-8\">\n      <h3 className=\"text-2xl font-bold text-slate-800 mb-6 flex items-center gap-2\">\n        <BarChart3 className=\"text-green-600\" />\n        蝣單??曄蜇閬?- {data.period}\n      </h3>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-4 gap-6 mb-8\">\n        <EmissionCard title=\"蝭?銝\" value={data.scope1} color=\"red\" />\n        <EmissionCard title=\"蝭?鈭" value={data.scope2} color=\"orange\" />\n        <EmissionCard title=\"蝭?銝" value={data.scope3} color=\"yellow\" />\n        <EmissionCard title=\"蝮賣??閱" value={data.totalEmissions} color=\"slate\" />\n      </div>\n\n      <div className=\"bg-gradient-to-r from-green-50 to-emerald-50 rounded-lg p-6\">\n        <div className=\"flex items-center justify-between mb-4\">\n          <div>\n            <h4 className=\"text-lg font-semibold text-slate-800 mb-1\">皜??格?體驗??/h4>\n            <p className=\"text-sm text-slate-600\">?格?: {data.reductionTarget} tCO2e</p>\n          </div>\n          <div className=\"text-4xl font-bold text-green-600\">{data.achievementRate}%</div>\n        </div>\n        <div className=\"w-full bg-slate-200 rounded-full h-4\">\n          <div\n            className=\"h-4 bg-gradient-to-r from-green-400 to-green-600 rounded-full transition-all\"\n            style={{ width: `${data.achievementRate}%` }}\n          />\n        </div>\n      </div>\n    </div>\n  </div>\n);\n\nconst EmissionCard: React.FC<{ title: string; value: number; color: string }> = ({\n  title,\n  value,\n  color,\n}) => {\n  const colorClasses = {\n    red: 'from-red-400 to-red-600',\n    orange: 'from-orange-400 to-orange-600',\n    yellow: 'from-yellow-400 to-yellow-600',\n    slate: 'from-slate-400 to-slate-600',\n  };\n\n  return (\n    <div className=\"text-center\">\n      <div className=\"text-sm text-slate-600 mb-2\">{title}</div>\n      <div\n        className={`text-3xl font-bold bg-gradient-to-r ${\n          colorClasses[color as keyof typeof colorClasses]\n        } bg-clip-text text-transparent mb-1`}\n      >\n        {value}\n      </div>\n      <div className=\"text-xs text-slate-500\">tCO2e</div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\ESG\\CarbonCalculator.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1000000.","line":166,"column":49,"nodeType":"Literal","messageId":"noMagic","endLine":166,"endColumn":56},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.5.","line":167,"column":46,"nodeType":"Literal","messageId":"noMagic","endLine":167,"endColumn":49},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1.5.","line":170,"column":29,"nodeType":"Literal","messageId":"noMagic","endLine":170,"endColumn":32},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1.5.","line":172,"column":42,"nodeType":"Literal","messageId":"noMagic","endLine":172,"endColumn":45},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 8.","line":249,"column":45,"nodeType":"Literal","messageId":"noMagic","endLine":249,"endColumn":46}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * ?? 蝣喟?亥?蝞\n * --------------------------------------------------\n * [?] Scope 1/2/3 ?設計?TR ?葫??蝣唾?頝﹏n * [整合] OS-Climate ITR??+1 驗證\n */\n\nimport React, { useState, useMemo } from 'react';\nimport { motion } from 'framer-motion';\nimport {\n  Factory,\n  Zap,\n  Truck,\n  Calculator,\n  TrendingDown,\n  AlertTriangle,\n  CheckCircle,\n  Info,\n  RefreshCw,\n  Thermometer,\n  Target,\n  Download,\n  Lock,\n  ShieldCheck,\n  Link as LinkIcon,\n  Loader2,\n  ExternalLink,\n} from 'lucide-react';\nimport { omniLogger, LogCategory } from '@/omni/infrastructure/logging/OmniLogger';\nimport { blockchainAnchorService } from '@/services/blockchain/BlockchainAnchorService';\nimport { IBlockchainAnchorResult } from '@/types/blockchain';\nimport { useESGStore } from '@/store/useESGStore';\nimport { v4 as uuidv4 } from 'uuid';\nimport { useEffect } from 'react';\n\n// ============================================================================\n// Types\n// ============================================================================\n\nexport interface ScopeEmission {\n  category: string;\n  source: string;\n  amount: number;\n  unit: string;\n  emissionFactor: number;\n  co2e: number;\n}\n\nexport interface CarbonInventory {\n  scope1: ScopeEmission[];\n  scope2: ScopeEmission[];\n  scope3: ScopeEmission[];\n  totalScope1: number;\n  totalScope2: number;\n  totalScope3: number;\n  grandTotal: number;\n  year: number;\n  verificationStatus: 'pending' | 'verified' | 'certified';\n  calculationMethod: string;\n}\n\nexport interface ITRResult {\n  temperatureScore: number;\n  pathway: string;\n  targetYear: number;\n  requiredReduction: number;\n}\n\n// ============================================================================\n// Emission Factor Data (Taiwan EPA)\n// ============================================================================\n\nconst EMISSION_FACTORS = {\n  scope1: {\n    '?湔硃 (?砍?)': 2.645,\n    '瘙賣硃 (?砍?)': 2.263,\n    '憭拍瘞?(蝡?砍偕)': 1.879,\n    'LPG (?祆)': 3.029,\n  },\n  scope2: {\n    '憭頃?餃? (摨?': 0.494, // Taiwan 2023\n    '憭頃?豢掃 (GJ)': 56.1,\n  },\n  scope3: {\n    '?∪極? (鈭箏??': 0.171,\n    '??撌格? (鈭箏??': 0.255,\n    '撱Ｘ??抵???(?砍)': 21.3,\n    '銝虜?撓 (?詨??': 0.062,\n  },\n};\n\n// ============================================================================\n// Main Component\n// ============================================================================\n\ninterface CarbonCalculatorProps {\n  companyName?: string;\n  year?: number;\n  onCalculate?: (inventory: CarbonInventory) => void;\n}\n\nexport const CarbonCalculator: React.FC<CarbonCalculatorProps> = ({\n  companyName = '鞎游??,\n  year = new Date().getFullYear() - 1,\n  onCalculate,\n}) => {\n  // State for each scope\n  const [scope1Data, setScope1Data] = useState<Record<string, number>>({\n    '?湔硃 (?砍?)': 50000,\n    '瘙賣硃 (?砍?)': 30000,\n    '憭拍瘞?(蝡?砍偕)': 100000,\n    'LPG (?祆)': 5000,\n  });\n\n  const [scope2Data, setScope2Data] = useState<Record<string, number>>({\n    '憭頃?餃? (摨?': 2000000,\n    '憭頃?豢掃 (GJ)': 500,\n  });\n\n  const [scope3Data, setScope3Data] = useState<Record<string, number>>({\n    '?∪極? (鈭箏??': 500000,\n    '??撌格? (鈭箏??': 200000,\n    '撱Ｘ??抵???(?砍)': 100,\n    '銝虜?撓 (?詨??': 1000000,\n  });\n\n  const [verified, setVerified] = useState(false);\n  const [showITR, setShowITR] = useState(false);\n  const [isAnchoring, setIsAnchoring] = useState(false);\n  const [anchorResult, setAnchorResult] = useState<IBlockchainAnchorResult | null>(null);\n  const updateMetrics = useESGStore(state => state.updateMetrics);\n  const addAnchor = useESGStore(state => state.addAnchor);\n\n  useEffect(() => {\n    omniLogger.info(LogCategory.ESG, '蝣喟?亥?蝞??', {\n      companyName,\n      year,\n      source_origin: 'CarbonCalculator.mount',\n    });\n  }, [companyName, year]);\n\n  // Calculate emissions\n  const calculations = useMemo(() => {\n    const calcScope = (data: Record<string, number>, factors: Record<string, number>) => {\n      return Object.entries(data).reduce((sum, [key, amount]) => {\n        return sum + amount * (factors[key] || 0);\n      }, 0);\n    };\n\n    const totalScope1 = calcScope(scope1Data, EMISSION_FACTORS.scope1);\n    const totalScope2 = calcScope(scope2Data, EMISSION_FACTORS.scope2);\n    const totalScope3 = calcScope(scope3Data, EMISSION_FACTORS.scope3);\n    const grandTotal = totalScope1 + totalScope2 + totalScope3;\n\n    return {\n      totalScope1: Math.round(totalScope1 * 100) / 100,\n      totalScope2: Math.round(totalScope2 * 100) / 100,\n      totalScope3: Math.round(totalScope3 * 100) / 100,\n      grandTotal: Math.round(grandTotal * 100) / 100,\n    };\n  }, [scope1Data, scope2Data, scope3Data]);\n\n  // Calculate ITR\n  const itrResult: ITRResult = useMemo(() => {\n    const baseTemp = 2.0;\n    const intensity = calculations.grandTotal / 1000000; // Normalize\n    const tempScore = baseTemp + intensity * 0.5;\n    return {\n      temperatureScore: Math.round(tempScore * 100) / 100,\n      pathway: tempScore <= 1.5 ? '1.5簞C 銝?? : tempScore <= 2.0 ? '2簞C 銝?? : 'NDC',\n      targetYear: 2050,\n      requiredReduction: Math.round((1 - 1.5 / tempScore) * 100),\n    };\n  }, [calculations.grandTotal]);\n\n  // Handle input change\n  const updateScope = (scope: 'scope1' | 'scope2' | 'scope3', key: string, value: number) => {\n    const setter =\n      scope === 'scope1' ? setScope1Data : scope === 'scope2' ? setScope2Data : setScope3Data;\n    setter(prev => ({ ...prev, [key]: value }));\n  };\n\n  // Submit calculation\n  const handleCalculate = () => {\n    const trace_id = uuidv4();\n    const inventory: CarbonInventory = {\n      scope1: Object.entries(scope1Data).map(([source, amount]) => ({\n        category: 'Scope 1',\n        source,\n        amount,\n        unit: source.match(/\\((.*)\\)/)?.[1] || '',\n        emissionFactor:\n          EMISSION_FACTORS.scope1[source as keyof typeof EMISSION_FACTORS.scope1] || 0,\n        co2e:\n          amount * (EMISSION_FACTORS.scope1[source as keyof typeof EMISSION_FACTORS.scope1] || 0),\n      })),\n      scope2: Object.entries(scope2Data).map(([source, amount]) => ({\n        category: 'Scope 2',\n        source,\n        amount,\n        unit: source.match(/\\((.*)\\)/)?.[1] || '',\n        emissionFactor:\n          EMISSION_FACTORS.scope2[source as keyof typeof EMISSION_FACTORS.scope2] || 0,\n        co2e:\n          amount * (EMISSION_FACTORS.scope2[source as keyof typeof EMISSION_FACTORS.scope2] || 0),\n      })),\n      scope3: Object.entries(scope3Data).map(([source, amount]) => ({\n        category: 'Scope 3',\n        source,\n        amount,\n        unit: source.match(/\\((.*)\\)/)?.[1] || '',\n        emissionFactor:\n          EMISSION_FACTORS.scope3[source as keyof typeof EMISSION_FACTORS.scope3] || 0,\n        co2e:\n          amount * (EMISSION_FACTORS.scope3[source as keyof typeof EMISSION_FACTORS.scope3] || 0),\n      })),\n      ...calculations,\n      year,\n      verificationStatus: verified ? 'verified' : 'pending',\n      calculationMethod: 'ISO 14064-1:2018',\n    };\n\n    omniLogger.info(LogCategory.ESG, '摰?蝣喟?亥?蝞?, {\n      trace_id,\n      total_co2e: inventory.grandTotal,\n      itr: itrResult.temperatureScore,\n      source_origin: 'CarbonCalculator.handleCalculate',\n    });\n\n    updateMetrics({ totalCO2e: inventory.grandTotal });\n    onCalculate?.(inventory);\n    setShowITR(true);\n  };\n\n  const handleAnchor = async () => {\n    setIsAnchoring(true);\n    try {\n      const anchorRes = await blockchainAnchorService.anchorAsset(\n        {\n          companyName,\n          year,\n          scope1: scope1Data,\n          scope2: scope2Data,\n          scope3: scope3Data,\n          total: calculations.grandTotal,\n        },\n        {\n          contentType: 'carbon_asset',\n          sourceId: `CC-${uuidv4().slice(0, 8)}`,\n          operator: 'ESG_ADMIN_01',\n        }\n      );\n      setAnchorResult(anchorRes);\n      addAnchor({\n        id: anchorRes.sourceId ?? 'UNKNOWN',\n        type: 'ORGANIZATIONAL_CARBON_ASSET',\n        hash: anchorRes.txHash,\n      });\n      setVerified(true);\n    } catch (error) {\n      omniLogger.error(LogCategory.SEC, '?憛?摮?憭望?', { error });\n    } finally {\n      setIsAnchoring(false);\n    }\n  };\n\n  // Render scope input section\n  const renderScopeSection = (\n    title: string,\n    icon: React.ReactNode,\n    color: string,\n    data: Record<string, number>,\n    factors: Record<string, number>,\n    scope: 'scope1' | 'scope2' | 'scope3',\n    total: number\n  ) => (\n    <div\n      className={`bg-gradient-to-br from-slate-800/50 to-slate-900/50 rounded-xl p-4 border border-${color}-500/20`}\n    >\n      <div className=\"flex items-center gap-2 mb-4\">\n        <div\n          className={`w-8 h-8 rounded-lg bg-${color}-500/20 flex items-center justify-center text-${color}-400`}\n        >\n          {icon}\n        </div>\n        <div>\n          <h3 className=\"text-sm font-semibold text-white\">{title}</h3>\n          <p className={`text-xs text-${color}-400`}>{total.toLocaleString()} tCO?</p>\n        </div>\n      </div>\n      <div className=\"space-y-3\">\n        {Object.entries(data).map(([key, value]) => (\n          <div key={key} className=\"flex items-center gap-3\">\n            <label className=\"flex-1 text-xs text-slate-400\">{key}</label>\n            <input\n              type=\"number\"\n              value={value}\n              onChange={e => updateScope(scope, key, Number(e.target.value))}\n              className=\"w-28 bg-slate-700/50 border border-slate-600 rounded-lg px-2 py-1 text-sm text-white text-right focus:border-cyan-500 outline-none\"\n            />\n            <span className=\"text-xs text-slate-500 w-20\">\n              ? {factors[key as keyof typeof factors]}\n            </span>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n\n  return (\n    <div className=\"frosted-panel rounded-2xl p-6 border border-emerald-500/20 neon-border-green animate-in relative overflow-hidden\">\n      {/* Cyber Grid Background */}\n      <div className=\"absolute inset-0 cyber-grid opacity-5 pointer-events-none\" />\n\n      {/* Header */}\n      <div className=\"relative z-10 flex items-center justify-between mb-8\">\n        <div className=\"flex items-center gap-4\">\n          <div className=\"w-12 h-12 rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-600 flex items-center justify-center shadow-lg shadow-emerald-500/20\">\n            <Calculator size={24} className=\"text-white\" />\n          </div>\n          <div>\n            <h2 className=\"text-2xl font-bold text-white tracking-tight\">蝣喟?亥??Ｘ敹?/h2>\n            <p className=\"text-sm text-slate-400\">\n              {companyName} - {year} 數據?拚\n            </p>\n          </div>\n        </div>\n        <div className=\"flex items-center gap-2 px-3 py-1.5 bg-emerald-500/10 border border-emerald-500/20 rounded-full\">\n          <div className=\"w-2 h-2 bg-emerald-400 rounded-full animate-pulse mr-2\" />\n          <span className=\"text-xs font-bold text-emerald-400 uppercase tracking-widest\">\n            ISO 14064 Verified\n          </span>\n        </div>\n      </div>\n\n      {/* Scope Inputs */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4 mb-6\">\n        {renderScopeSection(\n          'Scope 1 ?湔?',\n          <Factory size={16} />,\n          'red',\n          scope1Data,\n          EMISSION_FACTORS.scope1,\n          'scope1',\n          calculations.totalScope1\n        )}\n        {renderScopeSection(\n          'Scope 2 ??',\n          <Zap size={16} />,\n          'yellow',\n          scope2Data,\n          EMISSION_FACTORS.scope2,\n          'scope2',\n          calculations.totalScope2\n        )}\n        {renderScopeSection(\n          'Scope 3 ?嗡??',\n          <Truck size={16} />,\n          'blue',\n          scope3Data,\n          EMISSION_FACTORS.scope3,\n          'scope3',\n          calculations.totalScope3\n        )}\n      </div>\n\n      {/* Total Summary */}\n      <div className=\"bg-gradient-to-r from-emerald-900/30 to-teal-900/30 rounded-xl p-4 mb-4 border border-emerald-500/30\">\n        <div className=\"flex items-center justify-between\">\n          <div>\n            <p className=\"text-sm text-slate-400\">蝮賣??暸?</p>\n            <p className=\"text-3xl font-bold text-white\">\n              {calculations.grandTotal.toLocaleString()}\n              <span className=\"text-lg text-slate-400 ml-2\">tCO?</span>\n            </p>\n          </div>\n          <div className=\"flex items-center gap-4\">\n            <div className=\"text-center\">\n              <p className=\"text-2xl font-bold text-red-400\">\n                {Math.round((calculations.totalScope1 / calculations.grandTotal) * 100)}%\n              </p>\n              <p className=\"text-xs text-slate-500\">Scope 1</p>\n            </div>\n            <div className=\"text-center\">\n              <p className=\"text-2xl font-bold text-yellow-400\">\n                {Math.round((calculations.totalScope2 / calculations.grandTotal) * 100)}%\n              </p>\n              <p className=\"text-xs text-slate-500\">Scope 2</p>\n            </div>\n            <div className=\"text-center\">\n              <p className=\"text-2xl font-bold text-blue-400\">\n                {Math.round((calculations.totalScope3 / calculations.grandTotal) * 100)}%\n              </p>\n              <p className=\"text-xs text-slate-500\">Scope 3</p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* ITR Result */}\n      {showITR && (\n        <motion.div\n          initial={{ opacity: 0, y: 10 }}\n          animate={{ opacity: 1, y: 0 }}\n          className=\"bg-gradient-to-r from-orange-900/30 to-red-900/30 rounded-xl p-4 mb-4 border border-orange-500/30\"\n        >\n          <div className=\"flex items-center gap-3 mb-3\">\n            <Thermometer size={20} className=\"text-orange-400\" />\n            <h3 className=\"text-sm font-semibold text-white\">?勗皞怠??? (ITR)</h3>\n          </div>\n          <div className=\"flex items-center gap-6\">\n            <div className=\"text-center\">\n              <p className=\"text-4xl font-bold text-orange-400\">{itrResult.temperatureScore}簞C</p>\n              <p className=\"text-xs text-slate-400\">皞怠?頠楚</p>\n            </div>\n            <div className=\"flex-1 space-y-2\">\n              <div className=\"flex items-center gap-2\">\n                <Target size={14} className=\"text-slate-500\" />\n                <span className=\"text-sm text-slate-300\">頝臬?嚗itrResult.pathway}</span>\n              </div>\n              <div className=\"flex items-center gap-2\">\n                <TrendingDown size={14} className=\"text-slate-500\" />\n                <span className=\"text-sm text-slate-300\">\n                  體驗 1.5簞C ?皜? {itrResult.requiredReduction}%嚗 {itrResult.targetYear}嚗n                </span>\n              </div>\n            </div>\n          </div>\n        </motion.div>\n      )}\n\n      {/* Verification Toggle */}\n      <div className=\"flex items-center justify-between mb-4 p-3 bg-slate-800/50 rounded-lg\">\n        <div className=\"flex items-center gap-2\">\n          <Lock size={16} className={verified ? 'text-green-400' : 'text-slate-500'} />\n          <span className=\"text-sm text-slate-300\">蝚砌??寥?霅?摰?/span>\n        </div>\n        <button\n          onClick={() => setVerified(!verified)}\n          className={`px-3 py-1 rounded-lg text-xs transition-all ${\n            verified\n              ? 'bg-green-500/20 text-green-400 border border-green-500/30'\n              : 'bg-slate-700 text-slate-400 border border-slate-600'\n          }`}\n        >\n          {verified ? '撌脤?霅? : '敺?霅?}\n        </button>\n      </div>\n\n      {/* Action Buttons */}\n      <div className=\"relative z-10 flex items-center gap-3 mt-8\">\n        <button\n          onClick={handleCalculate}\n          className=\"flex-1 flex items-center justify-center gap-2 px-6 py-4 rounded-xl bg-gradient-to-r from-emerald-500 to-teal-500 text-white font-bold hover:shadow-xl hover:shadow-emerald-500/40 hover:scale-[1.02] active:scale-[0.98] transition-all duration-300\"\n        >\n          <Calculator size={20} />\n          ?瑁?數據?斗\n        </button>\n\n        <button\n          onClick={handleAnchor}\n          disabled={isAnchoring || !!anchorResult}\n          className={`flex items-center justify-center gap-3 px-6 py-4 rounded-xl font-bold transition-all duration-300 ${\n            anchorResult\n              ? 'bg-indigo-500/10 text-indigo-400 border border-indigo-500/30'\n              : 'bg-slate-800 text-slate-300 border border-slate-700 hover:border-indigo-500/50 hover:text-indigo-400'\n          }`}\n        >\n          {isAnchoring ? (\n            <Loader2 size={18} className=\"animate-spin\" />\n          ) : anchorResult ? (\n            <ShieldCheck size={18} />\n          ) : (\n            <LinkIcon size={18} />\n          )}\n          {anchorResult ? '?勗?撌脣?霅? : '??摮?'}\n        </button>\n\n        <button className=\"p-4 rounded-xl bg-slate-800/50 border border-slate-700 text-slate-400 hover:text-white transition-all\">\n          <Download size={20} />\n        </button>\n      </div>\n\n      {/* Blockchain Evidence Bar */}\n      {anchorResult && (\n        <motion.div\n          initial={{ opacity: 0, y: 10 }}\n          animate={{ opacity: 1, y: 0 }}\n          className=\"relative z-10 mt-6 p-5 bg-indigo-500/10 border border-indigo-500/30 rounded-[24px] flex flex-col gap-4 shadow-[0_0_30px_rgba(99,102,241,0.1)]\"\n        >\n          <div className=\"flex items-center justify-between\">\n            <div className=\"flex items-center gap-4\">\n              <div className=\"w-12 h-12 bg-indigo-500/20 rounded-2xl flex items-center justify-center border border-indigo-500/30\">\n                <ShieldCheck size={24} className=\"text-indigo-400\" />\n              </div>\n              <div>\n                <div className=\"flex items-center gap-2 mb-1\">\n                  <p className=\"text-xs font-bold text-indigo-400 uppercase tracking-[0.2em]\">\n                    Inventory Evidence Anchored\n                  </p>\n                  <span className=\"px-2 py-0.5 bg-indigo-500/20 text-[9px] text-indigo-300 rounded-full font-bold border border-indigo-500/20\">\n                    VERIFIED\n                  </span>\n                </div>\n                <p className=\"text-sm text-slate-400 font-mono truncate max-w-[300px]\">\n                  {anchorResult.txHash}\n                </p>\n              </div>\n            </div>\n            <div className=\"flex gap-2\">\n              <button\n                onClick={() =>\n                  alert(\n                    `[Report Vault]\\nLocation: vault://esg-reports/${year}/${anchorResult.txHash}.pdf`\n                  )\n                }\n                className=\"p-3 bg-slate-800 hover:bg-slate-700 text-indigo-400 rounded-xl border border-indigo-500/20 transition-all\"\n                title=\"摰????勗?\"\n              >\n                <LinkIcon size={20} />\n              </button>\n              <a\n                href={anchorResult.explorerUrl}\n                target=\"_blank\"\n                rel=\"noopener noreferrer\"\n                className=\"p-3 bg-indigo-500/20 hover:bg-indigo-500/30 text-indigo-400 rounded-xl border border-indigo-500/30 transition-all\"\n                title=\"?憛??汗?沔"\n              >\n                <ExternalLink size={20} />\n              </a>\n            </div>\n          </div>\n          <div className=\"flex items-center justify-between pt-4 border-t border-indigo-500/10\">\n            <div className=\"flex items-center gap-4\">\n              <div className=\"text-[10px] text-slate-500 font-mono\">\n                SEALED: {new Date().toISOString()}\n              </div>\n              <div className=\"text-[10px] text-slate-500 font-mono\">ALGORITHM: SHA-256 + ECDSA</div>\n            </div>\n            <button className=\"text-xs font-bold text-indigo-400 hover:text-indigo-300 uppercase tracking-widest flex items-center gap-2 group\">\n              <Download size={14} className=\"group-hover:translate-y-0.5 transition-transform\" />\n              Download Carbon Passport\n            </button>\n          </div>\n        </motion.div>\n      )}\n    </div>\n  );\n};\n