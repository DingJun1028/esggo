me=\"w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_5px_emerald]\"\n                  title=\"Calculable\"\n                />\n                <span\n                  className=\"w-2 h-2 rounded-full bg-red-500 shadow-[0_0_5px_red]\"\n                  title=\"Immutable\"\n                />\n              </div>\n            </div>\n            <p className=\"text-gray-400 text-lg flex items-center gap-2\">\n              系統憿嚗??箏??憭抒? ESG 鞈西撟喳\n              <span className=\"text-xs px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 font-mono\">\n                3+1 PROTOCOL ACTIVE\n              </span>\n            </p>\n          </div>\n        </div>\n        <div className=\"grid grid-cols-5 gap-2 mt-8 px-8\">\n          {[\n            { label: '?萄 (Value)', value: 'A+', icon: Zap, color: 'text-yellow-400' },\n            { label: '受信 (Integrity)', value: '100%', icon: Shield, color: 'text-blue-400' },\n            { label: '?? (Excellence)', value: 'TOP 1%', icon: Target, color: 'text-purple-400' },\n            { label: '?脫 (Wisdom)', value: '??, icon: Brain, color: 'text-emerald-400' },\n            { label: '?格? (Inclusive)', value: 'Global', icon: Users, color: 'text-pink-400' },\n          ].map((item, idx) => (\n            <div\n              key={idx}\n              className=\"flex flex-col items-center p-2 rounded-xl bg-white/5 border border-white/5 hover:bg-white/10 transition-all\"\n            >\n              <item.icon className={`w-5 h-5 ${item.color} mb-1`} />\n              <span className=\"text-xl font-bold text-white\">{item.value}</span>\n              <span className=\"text-[9px] text-gray-500 uppercase tracking-widest\">\n                {item.label}\n              </span>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* ?? Row 1 Right: AI Agent Status */}\n      <div className={`${panelClass} col-span-12 lg:col-span-4 row-span-2`}>\n        <div className=\"flex items-center justify-between mb-6\">\n          <h2 className=\"text-xl font-semibold text-white\">???箸蝢日?</h2>\n          <Brain className=\"w-5 h-5 text-cyan-400\" />\n        </div>\n        <div className=\"space-y-4\">\n          {[\n            { name: 'Aurora', task: '??數據撖拇', status: '?瑁?銝?, pulse: 'bg-green-500' },\n            { name: 'Sentinel', task: '??摰摰風', status: '蝑?', pulse: 'bg-blue-500' },\n            { name: 'Oracle', task: '??頞典?葫', status: '隡?', pulse: 'bg-gray-500' },\n          ].map((agent, i) => (\n            <div\n              key={i}\n              className=\"flex items-center justify-between p-3 rounded-xl bg-white/5 border border-white/5 hover:bg-white/10 transition-colors\"\n            >\n              <div className=\"flex items-center gap-3\">\n                <div className={`w-2 h-2 rounded-full ${agent.pulse} animate-pulse`} />\n                <div>\n                  <div className=\"text-sm font-medium text-gray-200\">{agent.name}</div>\n                  <div className=\"text-[10px] text-gray-500\">{agent.task}</div>\n                </div>\n              </div>\n              <span className=\"text-[10px] px-2 py-0.5 rounded-full bg-white/5 text-gray-400\">\n                {agent.status}\n              </span>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* ?? Row 2: Tactical Commands */}\n      <div className={`${panelClass} col-span-12 lg:col-span-3 row-span-3`}>\n        <h3 className=\"text-lg font-medium text-white mb-4\">??協議?誘</h3>\n        <div className=\"grid grid-cols-1 gap-2\">\n          {['?????郊', '?澆??萄?勗?', '受信摰蝔賣', '??系統??'].map(cmd => (\n            <button\n              key={cmd}\n              className=\"w-full text-left p-4 rounded-xl bg-white/5 border border-white/5 hover:border-blue-500/50 hover:bg-blue-500/10 transition-all group\"\n            >\n              <span className=\"text-sm text-gray-300 group-hover:text-blue-400 font-medium\">\n                {cmd}\n              </span>\n            </button>\n          ))}\n        </div>\n      </div>\n\n      {/* ?儭?Row 2 Center: Impact Map View */}\n      <div\n        className={`${panelClass} col-span-12 lg:col-span-6 row-span-3 overflow-hidden relative`}\n      >\n        <div className=\"absolute inset-x-0 top-6 px-6 flex justify-between items-center z-10\">\n          <h3 className=\"text-lg font-medium text-white\">???函?敶梢??/h3>\n          <div className=\"flex gap-2\">\n            <div className=\"px-2 py-1 rounded bg-black/40 text-[10px] text-cyan-400 border border-cyan-500/30\">\n              LIVE\n            </div>\n          </div>\n        </div>\n        <div className=\"w-full h-full bg-[#050b1a] flex items-center justify-center\">\n          <div className=\"relative\">\n            <div className=\"w-64 h-64 rounded-full border-2 border-cyan-500/20 animate-spin-slow\" />\n            <div className=\"absolute inset-0 m-auto w-48 h-48 rounded-full border border-blue-500/30\" />\n            <Globe className=\"absolute inset-0 m-auto w-12 h-12 text-cyan-500/50\" />\n          </div>\n        </div>\n      </div>\n\n      {/* ? Row 2 Right: Communication & Feeds */}\n      <div className={`${panelClass} col-span-12 lg:col-span-3 row-span-3`}>\n        <div className=\"flex items-center justify-between mb-4\">\n          <h3 className=\"text-lg font-medium text-white\">??敹怨?</h3>\n          <MessageSquare className=\"w-4 h-4 text-gray-500\" />\n        </div>\n        <div className=\"space-y-3 overflow-y-auto max-h-[250px] custom-scrollbar\">\n          {[1, 2, 3, 4].map(i => (\n            <div key={i} className=\"p-3 border-l-2 border-blue-500 bg-white/5\">\n              <div className=\"text-[10px] text-blue-400 mb-1\">SHAN-XIANG ??NOW</div>\n              <p className=\"text-xs text-gray-300\">\n                ??數據??整合?Ｕ?孵??詨歇?芸??湔?單??啁??n              </p>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default NorthStarDashboard;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\OKRDashboard.tsx","messages":[{"ruleId":"react/prop-types","severity":2,"message":"'kr' is missing in props validation","line":9,"column":50,"nodeType":"Property","messageId":"missingPropType","endLine":9,"endColumn":52},{"ruleId":"react/prop-types","severity":2,"message":"'kr.description' is missing in props validation","line":13,"column":40,"nodeType":"Identifier","messageId":"missingPropType","endLine":13,"endColumn":51},{"ruleId":"react/prop-types","severity":2,"message":"'kr.currentValue' is missing in props validation","line":15,"column":26,"nodeType":"Identifier","messageId":"missingPropType","endLine":15,"endColumn":38},{"ruleId":"react/prop-types","severity":2,"message":"'kr.unit' is missing in props validation","line":16,"column":15,"nodeType":"Identifier","messageId":"missingPropType","endLine":16,"endColumn":19},{"ruleId":"react/prop-types","severity":2,"message":"'kr.targetValue' is missing in props validation","line":16,"column":27,"nodeType":"Identifier","messageId":"missingPropType","endLine":16,"endColumn":38},{"ruleId":"react/prop-types","severity":2,"message":"'kr.unit' is missing in props validation","line":17,"column":15,"nodeType":"Identifier","messageId":"missingPropType","endLine":17,"endColumn":19},{"ruleId":"react/prop-types","severity":2,"message":"'kr.progress' is missing in props validation","line":21,"column":19,"nodeType":"Identifier","messageId":"missingPropType","endLine":21,"endColumn":27},{"ruleId":"react/prop-types","severity":2,"message":"'goal' is missing in props validation","line":31,"column":41,"nodeType":"Property","messageId":"missingPropType","endLine":31,"endColumn":45},{"ruleId":"react/prop-types","severity":2,"message":"'goal.type' is missing in props validation","line":32,"column":24,"nodeType":"Identifier","messageId":"mis