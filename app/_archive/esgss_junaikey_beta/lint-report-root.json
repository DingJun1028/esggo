ar-gradient(90deg,rgba(6,182,212,0.05)_1px,transparent_1px)] bg-[size:10px_10px]\" />\n\n      <div className=\"flex items-center gap-2 mb-4 shrink-0 relative z-10\">\n        <TrendingUp className=\"text-cyan-400\" size={18} />\n        <span className=\"font-bold text-white text-lg\">{isZh ? TEXT.TITLE.zh : TEXT.TITLE.en}</span>\n      </div>\n\n      <div className=\"flex-1 grid grid-cols-2 gap-3 relative z-10\">\n        {/* Main Metric: Entropy ROI */}\n        <div className=\"col-span-2 bg-gradient-to-br from-cyan-900/40 to-blue-900/40 border border-cyan-500/30 rounded-xl p-3 flex flex-col justify-center items-center relative overflow-hidden group hover:border-cyan-400 transition-colors\">\n          <div className=\"absolute -right-4 -top-4 w-16 h-16 bg-cyan-500/20 blur-xl rounded-full group-hover:bg-cyan-400/30 transition-all\" />\n\n          <div className=\"text-xs text-cyan-300 font-bold tracking-wider mb-1 flex items-center gap-1\">\n            <Zap size={12} fill=\"currentColor\" /> {isZh ? TEXT.METRICS.ROI.zh : TEXT.METRICS.ROI.en}\n          </div>\n          <div className=\"text-4xl font-black text-white tracking-tighter\">{efficiency}x</div>\n          <div className=\"text-[10px] text-cyan-400/60 mt-1 font-mono\">\n            Based on active projects\n          </div>\n        </div>\n\n        {/* Sub Metrics */}\n        <div className=\"bg-black/40 border border-white/10 rounded-lg p-2\">\n          <div className=\"text-[10px] text-slate-400 mb-1\">\n            {isZh ? TEXT.METRICS.SAVINGS.zh : TEXT.METRICS.SAVINGS.en}\n          </div>\n          <div className=\"text-lg font-bold text-emerald-400 flex items-end gap-1\">\n            {Math.floor(stats.activeEntropyReduction / 10)}{' '}\n            <span className=\"text-[10px] pb-1\">kWh</span>\n          </div>\n        </div>\n\n        <div className=\"bg-black/40 border border-white/10 rounded-lg p-2\">\n          <div className=\"text-[10px] text-slate-400 mb-1\">\n            {isZh ? TEXT.METRICS.TOKEN.zh : TEXT.METRICS.TOKEN.en}\n          </div>\n          <div className=\"text-lg font-bold text-purple-400 flex items-end gap-1\">\n            {(stats.activeEntropyReduction * 0.5).toFixed(0)}{' '}\n            <span className=\"text-[10px] pb-1\">J/K</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Live Ticker */}\n      <div className=\"mt-3 border-t border-white/5 pt-2 flex items-center gap-2 overflow-hidden whitespace-nowrap\">\n        <Activity size={10} className=\"text-cyan-500 shrink-0\" />\n        <div className=\"text-[9px] text-slate-500 font-mono animate-marquee\">\n          POOL_A: STABLE | POOL_B: OPTIMIZING | CARBON_CREDIT: +2.4% | ENTROPY_VAL:{' '}\n          {stats.activeEntropyReduction} |\n        </div>\n      </div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\security\\SecurityNode.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.95.","line":40,"column":20,"nodeType":"Literal","messageId":"noMagic","endLine":40,"endColumn":24},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":48,"column":58,"nodeType":"Literal","messageId":"noMagic","endLine":48,"endColumn":59},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 90.","line":49,"column":45,"nodeType":"Literal","messageId":"noMagic","endLine":49,"endColumn":47},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.3.","line":51,"column":27,"nodeType":"Literal","messageId":"noMagic","endLine":51,"endColumn":30},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3000.","line":54,"column":8,"nodeType":"Literal","messageId":"noMagic","endLine":54,"endColumn":12},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 2000.","line":74,"column":8,"nodeType":"Literal","messageId":"noMagic","endLine":74,"endColumn":12}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":6,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect, useRef } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport {\n  Shield,\n  ShieldCheck,\n  Lock,\n  AlertTriangle,\n  Activity,\n  Zap,\n  Radio,\n  Globe,\n  Verified,\n  AlertOctagon,\n} from 'lucide-react';\nimport { Button, Card, Badge, Progress } from '@/components/ui';\nimport { omniLogger, LogCategory } from '@/services/omniLogger';\n\nexport interface Threat {\n  id: number;\n  type: string;\n  severity: 'LOW' | 'MEDIUM' | 'HIGH';\n  source: string;\n  timestamp: Date;\n}\n\nexport const SecurityNode: React.FC = () => {\n  const [systemIntegrity, setSystemIntegrity] = useState(100);\n  const [threats, setThreats] = useState<Threat[]>([]);\n  const [activeProtocols, setActiveProtocols] = useState<string[]>([\n    'FIREWALL_OMEGA',\n    'DEEP_PACKET_STASIS',\n  ]);\n  const [scanning, setScanning] = useState(false);\n  const purgeTimerRef = useRef<NodeJS.Timeout | null>(null);\n\n  // Simulated Threat Detection\n  useEffect(() => {\n    const interval = setInterval(() => {\n      const random = Math.random();\n      if (random > 0.95) {\n        const newThreat: Threat = {\n          id: Date.now(),\n          type: 'ANOMALY',\n          severity: 'LOW',\n          source: 'EXTERNAL_NET_7',\n          timestamp: new Date(),\n        };\n        setThreats(prev => [newThreat, ...prev].slice(0, 5));\n        setSystemIntegrity(prev => Math.max(90, prev - 2));\n        omniLogger.warn(LogCategory.SECURITY, 'Anomaly Detected', newThreat);\n      } else if (random < 0.3 && systemIntegrity < 100) {\n        setSystemIntegrity(prev => Math.min(100, prev + 1));\n      }\n    }, 3000);\n\n    return () => {\n      clearInterval(interval);\n      if (purgeTimerRef.current) clearTimeout(purgeTimerRef.current);\n    };\n  }, [systemIntegrity]);\n\n  const handlePurge = () => {\n    setScanning(true);\n    omniLogger.info(LogCategory.SECURITY, 'Initiating System Purge Protocol');\n\n    if (purgeTimerRef.current) clearTimeout(purgeTimerRef.current);\n\n    purgeTimerRef.current = setTimeout(() => {\n      setThreats([]);\n      setSystemIntegrity(100);\n      setScanning(false);\n      omniLogger.info(LogCategory.SECURITY, 'System Purge Complete. Integrity Restored.');\n      purgeTimerRef.current = null;\n    }, 2000);\n  };\n\n  return (\n    <div className=\"h-full w-full p-4 lg:p-8 flex flex-col gap-6 animate-in fade-in duration-500\">\n      {/* Header Area */}\n      <div className=\"flex items-center justify-between\">\n        <div>\n          <h2 className=\"text-2xl font-black text-white flex items-center gap-3 tracking-tight\">\n            <ShieldCheck className=\"text-emerald-500\" size={32} />\n            SECURITY NODE{' '}\n            <span className=\"text-emerald-500 text-sm font-mono bg-emerald-500/10 px-2 py-1 rounded border border-emerald-500/20\">\n              ACTIVE\n            </span>\n          </h2>\n          <p className=\"text-gray-500 font-mono text-xs mt-1 tracking-widest uppercase pl-11\">\n            System Defense & Integrity Monitor\n          </p>\n        </div>\n        <div className=\"flex items-center gap-4\">\n          <div className=\"text-right hidden sm:block\">\n            <div className=\"text-[10px] text-gray-500 uppercase tracking-widest\">Global Status</div>\n            <div className=\"text-emerald-400 font-black tracking-widest\">SECURE</div>\n          </div>\n          <Activity className=\"text-emerald-500 animate-pulse\" size={24} />\n        </div>\n      </div>\n\n      {/* Main Grid */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6 flex-1\">\n        {/* 1. Shield Visualization (Center Stage) */}\n        <div className=\"lg:col-span-2 relative\">\n          <Card className=\"h-full bg-black/40 border-emerald-500/20 backdrop-blur-xl p-8 flex flex-col items-center justify-center relative overflow-hidden group\">\n            {/* Background Grid */}\n            <div className=\"absolute inset-0 bg-[linear-gradient(rgba(16,185,129,0.05)_1px,transparent_1px),linear-gradient(90deg,rgba(16,185,129,0.05)_1px,transparent_1px)] bg-[size:40px_40px] [mask-image:radial-gradient(ellipse_at_center,black,transparent_70%)]\" />\n\n            <div className=\"relative z-10 text-center\">\n              <motion.div\n                animate={{\n                  boxShadow: scanning\n                    ? ['0 0 20px #10b981', '0 0 60px #10b981', '0 0 20px #10b981']\n                    : '0 0 30px rgba(16,185,129,0.1)',\n                }}\n                className=\"w-64 h-64 rounded-full border-4 border-emerald-500/30 flex items-center justify-center bg-black/50 relative\"\n              >\n                <div className=\"absolute inset-0 rounded-full border border-emerald-500/10 animate-[spin_10s_linear_infinite]\" />\n                <div className=\"absolute inset-4 rounded-full border border-emerald-500/20 animate-[spin_15s_linear_infinite_reverse]\" />\n\n                <div className=\"flex flex-col items-center\">\n                  <Shield\n                    size={64}\n                    className={`text-emerald-500 mb-2 ${scanning ? 'animate-bounce' : ''}`}\n                  />\n                  <span className=\"text-5xl font-black text-white tracking-tighter\">\n                    {systemIntegrity}%\n                  </span>\n                  <span className=\"text-[10px] text-emerald-400 uppercase tracking-[0.2em] mt-2\">\n                    Integrity\n                  </span>\n                </div>\n              </motion.div>\n            </div>\n\n            {/* Action Bar */}\n            <div className=\"absolute bottom-8 flex gap-4 z-20\">\n              <Button\n                onClick={handlePurge}\n                disabled={scanning}\n                className=\"bg-emerald-600/20 hover:bg-emerald-600/40 text-emerald-400 border border-emerald-500/50 uppercase tracking-widest font-bold backdrop-blur-md\"\n              >\n                {scanning ? <span className=\"animate-pulse\">Purging...</span> : 'System Purge'}\n              </Button>\n              <Button\n                variant=\"outline\"\n                className=\"border-red-500/30 text-red-400 hover:bg-red-500/10 uppercase tracking-widest font-bold\"\n              >\n                Lockdown\n              </Button>\n            </div>\n          </Card>\n        </div>\n\n        {/* 2. Side Panel: Threats & Protocols */}\n        <div className=\"flex flex-col gap-6\">\n          {/* Active Protocols */}\n          <Card className=\"bg-black/40 border-white/10 p-5 backdrop-blur-md\">\n            <h3 className=\"text-xs font-bold text-gray-400 uppercase mb-4 flex items-center gap-2\">\n              <Lock size={14} /> Active Protocols\n            </h3>\n            <div className=\"space-y-2\">\n              {activeProtocols.map(proto => (\n                <div\n                  key={proto}\n                  className=\"flex items-center justify-between p-2 rounded bg-emerald-900/10 border border-emerald-500/20\"\n                >\n                  <span className=\"text-[10px] font-mono text-emerald-300 font-bold\">{proto}</span>\n                  <div className=\"w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse shadow-[0_0_8px_#34d399]\" />\n                </div>\n              ))}\n            </div>\n          </Card>\n\n          {/* Threat Warnings */}\n          <Card className=\"flex-1 bg-red-900/5 border-red-500/10 p-5 backdrop-blur-md overflow-hidden flex flex-col\">\n            <h3 className=\"text-xs font-bold text-red-400 uppercase mb-4 flex items-center gap-2\">\n              <AlertOctagon size={14} /> Detected Threats\n            </h3>\n            <div className=\"flex-1 overflow-y-auto space-y-2 pr-1 custom-scrollbar\">\n              {threats.length === 0 ? (\n                <div className=\"h-full flex flex-col items-center justify-center opacity-40 text-gray-500 text-center\">\n                  <Verified size={32} className=\"mb-2 text-emerald-500\" />\n                  <p className=\"text-[10px] uppercase tracking-widest\">No Active Threats</p>\n                </div>\n              ) : (\n                threats.map(threat => (\n                  <div\n                    key={threat.id}\n                    className=\"p-3 rounded bg-red-900/20 border border-red-500/30 animate-in slide-in-from-right\"\n                  >\n                    <div className=\"flex justify-between items-start\">\n                      <span className=\"text-[10px] font-bold text-red-300 uppercase\">\n                        {threat.type}\n                      </span>\n                      <span className=\"text-[9px] text-red-400/70 font-mono\">\n                        {new Date(threat.timestamp).toLocaleTimeString()}\n                      </span>\n                    </div>\n                    <div className=\"text-[10px] text-gray-400 mt-1 font-mono\">\n                      Source: {threat.source}\n                    </div>\n                  </div>\n                ))\n              )}\n            </div>\n          </Card>\n        </div>\n      </div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\shared\\DashboardComponents.tsx","messages":[{"ruleId":"react/prop-types","severity":2,"message":"'children' is missing in props validation","line":28,"column":52,"nodeType":"Property","messageId":"missingPropType","endLine":28,"endColumn":60},{"ruleId":"react/prop-types","severity":2,"message":"'className' is missing in props validation","line":28,"column":62,"nodeType":"Property","messageId":"missingPropType","endLine":28,"endColumn":76},{"ruleId":"react/prop-types","severity":2,"message":"'icon' is missing in props validat