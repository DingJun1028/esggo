>\n            {isZh ? '?餈?30 憭? : 'Last 30 Days'}\n          </button>\n          <button className=\"bg-gradient-to-r from-cyan-500/20 to-blue-500/20 hover:from-cyan-500/30 hover:to-blue-500/30 border border-cyan-500/30 text-cyan-400 px-4 py-2 rounded-xl font-semibold text-sm flex items-center gap-2 transition-all shadow-[0_0_15px_rgba(6,182,212,0.1)]\">\n            <Download className=\"w-4 h-4\" />\n            {isZh ? '?臬?勗?' : 'Export Report'}\n          </button>\n        </div>\n      </div>\n\n      {/* KPI Cards */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4\">\n        <OmniEsgCell\n          key=\"carbon\"\n          id=\"carbon-intensity\"\n          label={isZh ? '蝣單??曉撥摨? : 'Carbon Intensity'}\n          value={3.2}\n          unit=\"tCO2e/M$\"\n          color=\"cyan\"\n          icon={Activity}\n          trend={{ value: 18, direction: 'down' }}\n          confidence=\"high\"\n        />\n        <OmniEsgCell\n          key=\"energy\"\n          id=\"energy-efficiency\"\n          label={isZh ? '?賣?雿輻合約' : 'Energy Efficiency'}\n          value={87}\n          unit=\"%\"\n          color=\"blue\"\n          icon={Zap}\n          // Generic fix for all trend objects in this file\n          trend={{ value: 5, direction: 'up' }}\n        />\n        <OmniEsgCell\n          key=\"compliance\"\n          id=\"compliance-status\"\n          label={isZh ? '????? : 'ESG Score'}\n          value={94}\n          unit=\"/100\"\n          color=\"purple\"\n          icon={Database}\n          trend={{ value: 3, direction: 'up' }}\n          verified={true}\n        />\n        <OmniEsgCell\n          key=\"social\"\n          id=\"social-impact\"\n          label={isZh ? '蝷暹?敶梢?? : 'Cost Savings'}\n          value={2.4}\n          unit=\"M\"\n          color=\"gold\"\n          icon={DollarSign}\n          trend={{ value: 22, direction: 'up' }}\n        />\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        {/* Emissions Trend Chart */}\n        <div className=\"bg-slate-900/50 border border-cyan-500/20 rounded-3xl p-6 backdrop-blur-sm hover:shadow-[0_0_30px_rgba(6,182,212,0.1)] transition-all\">\n          <div className=\"flex justify-between items-center mb-6\">\n            <h3 className=\"text-lg font-bold text-white flex items-center gap-2\">\n              <LineChart className=\"w-5 h-5 text-cyan-400\" />\n              {isZh ? '蝣單??曇隅?? : 'Emissions Trend'}\n            </h3>\n            <div className=\"flex items-center gap-2 text-cyan-400 text-sm font-bold\">\n              <TrendingUp className=\"w-4 h-4\" />\n              -18%\n            </div>\n          </div>\n\n          <div className=\"space-y-2\">\n            {chartData.emissions.map((item, i) => (\n              <div key={i} className=\"flex items-center gap-3\">\n                <span className=\"text-slate-400 text-xs w-8\">{item.month}</span>\n                <div className=\"flex-1 bg-slate-800 rounded-full h-6 relative overflow-hidden border border-white/5\">\n                  <div\n                    className=\"absolute top-0 left-0 h-full bg-gradient-to-r from-cyan-600 to-blue-500 rounded-full transition-all duration-500 shadow-[0_0_10px_rgba(34,211,238,0.3)]\"\n                    style={{ width: `${(item.value / 450) * 100}%` }}\n                  />\n                  <span className=\"absolute inset-0 flex items-center px-3 text-xs font-bold text-white\">\n                    {item.value} tCO2e\n                  </span>\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* ESG Breakdown */}\n        <div className=\"bg-slate-900/50 border border-cyan-500/20 rounded-3xl p-6 backdrop-blur-sm\">\n          <div className=\"flex justify-between items-center mb-6\">\n            <h3 className=\"text-lg font-bold text-white flex items-center gap-2\">\n              <PieChart className=\"w-5 h-5 text-blue