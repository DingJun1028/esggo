  0x{anchor.hash.substring(0, 16)}...\n                      </div>\n                    </div>\n                    <div className=\"px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 text-[9px] font-bold border border-emerald-500/20 group-hover:bg-emerald-500/20 transition-all\">\n                      VERIFIED\n                    </div>\n                  </div>\n                </motion.div>\n              ))\n            ) : (\n              <div className=\"flex flex-col items-center justify-center py-12 text-slate-600 border border-dashed border-slate-800 rounded-3xl\">\n                <Zap size={48} className=\"mb-4 opacity-20\" />\n                <p className=\"text-xs font-mono tracking-widest uppercase\">\n                  Waiting for first anchor event...\n                </p>\n              </div>\n            )}\n          </div>\n        </div>\n      </motion.div>\n    </div>\n  );\n};\n\n// ============================================================================\n// 銝餅??函?隞跚n// ============================================================================\n\nexport const ESGSunshineJAK: React.FC = () => {\n  const [?嗅?璅∠?, 閮剖??嗅?璅∠?] = useState<璅∠?憿?>('擐?');\n  const [?唳?摰方?閫? 閮剖??唳?摰方?閫 = useState<?唳?摰文?璅∠?>('銵??琿?');\n  const [?湧?甈??? 閮剖??湧?甈?? = useState(true);\n  const [language, setLanguage] = useState<Language>('zh-TW');\n  const [currentView, setCurrentView] = useState<View>(View.TACTICAL);\n\n  const 撠? = [\n    { 霅蝣? '擐?' as const, 璅?: '擐?', ?內: Home },\n    { 霅蝣? '閮箇?摰? as const, 璅?: '永續閮箇?摰?, ?內: FileText },\n    { 霅蝣? '?唳?摰? as const, 璅?: '永續?唳?摰?, ?內: Radar },\n    { 霅蝣? '鋆策蝡? as const, 璅?: '鞈?鋆策蝡?, ?內: Newspaper },\n    { 霅蝣? '皜祈?' as const, 璅?: '?其犖?皜祈?', ?內: GraduationCap },\n    { 霅蝣? 'AI?拍?' as const, 璅?: 'AI ?訾??澈', ?內: Bot },\n  ];\n\n  const 皜脫??批捆 = () => {\n    switch (?嗅?璅∠?) {\n      case '閮箇?摰?:\n        return <SustainabilityReport />;\n      case '?唳?摰?:\n        return (\n          <div className=\"h-full flex flex-col\">\n            <div className=\"bg-slate-900 text-white p-4 border-b border-slate-700 flex items-center gap-4\">\n              <h2 className=\"font-bold text-xl tracking-wider text-cyan-400 flex items-center gap-2\">\n                <Radar size={24} /> WAR ROOM\n              </h2>\n              <div className=\"h-8 w-[1px] bg-slate-700\" />\n              <div className=\"flex gap-2\">\n                {[\n                  { id: '銵??琿?', label: 'B3 銵??琿? (Impact Radar)' },\n                  { id: '靘???, label: 'B2 靘???? },\n                  { id: '???菜葫', label: 'B1 ???菜葫' },\n                ].map(item => (\n                  <button\n                    key={item.id}\n                    onClick={() => 閮剖??唳?摰方?閫?item.id as ?唳?摰文?璅∠?)}\n                    className={`px-4 py-1.5 rounded-full text-sm font-medium transition-all ${\n                      ?唳?摰方?閫?=== item.id\n                        ? 'bg-cyan-600 text-white shadow-[0_0_10px_rgba(8,145,178,0.5)]'\n                        : 'text-slate-400 hover:text-white hover:bg-slate-800'\n                    }`}\n                  >\n                    {item.label}\n                  </button>\n                ))}\n              </div>\n            </div>\n            <div className=\"flex-1 overflow-auto bg-slate-900\">\n              {?唳?摰方?閫?=== '銵??琿?' && <ImpactRadar />}\n              {?唳?摰方?閫?=== '靘??? && <SupplyChainRadar />}\n              {?唳?摰方?閫?=== '???菜葫' && (\n                <div className=\"flex items-center justify-center h-full text-slate-500\">\n                  <div className=\"text-center\">\n                    <Grip size={48} className=\"mx-auto mb-4 opacity-50\" />\n                    <p>???菜葫璅∠? (Coming Soon)</p>\n                  </div>\n                </div>\n              )}\n            </div>\n          </div>\n        );\n      case '鋆策蝡?:\n        return <DailyESGNews />;\n      case '皜祈?':\n        return <HolisticEducationAssessment />;\n      case 'AI?拍?':\n        return <AIDigitalTwin />;\n      case '蝣單?鈭斗?':\n        return <CarbonAssetTrading />;\n      case '瘜???':\n        return <RegulatoryAlerts />;\n      case '蝮暹??拚':\n        return <SustainabilityMatrix />;\n      default:\n        return <擐??銵冽 ??璅∠?={閮剖??嗅?璅∠?} ???唳?摰?{閮剖??唳?摰方?閫 />;\n    }\n  };\n\n  return (\n    <div className=\"flex h-screen bg-[#020617] font-sans selection:bg-cyan-500/30 overflow-hidden\">\n      <SideNavBar\n        currentView={currentView}\n        onNavigate={v => setCurrentView(v as View)}\n        language={language}\n        onToggleLanguage={() => setLanguage(l => (l === 'zh-TW' ? 'en-US' : 'zh-TW'))}\n      />\n\n      <div className=\"flex-1 overflow-hidden relative bg-[#020617]\">\n        <div className=\"absolute inset-0 pointer-events-none opacity-30\">\n          <div className=\"absolute top-0 left-1/4 w-[500px] h-[500px] bg-cyan-600/10 blur-[120px] rounded-full\" />\n          <div className=\"absolute bottom-0 right-1/4 w-[500px] h-[500px] bg-blue-600/10 blur-[120px] rounded-full\" />\n        </div>\n        {皜脫??批捆()}\n      </div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\ESG\\EnterpriseGraph.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 30.","line":223,"column":38,"nodeType":"Literal","messageId":"noMagic","endLine":223,"endColumn":40},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 45.","line":223,"column":43,"nodeType":"Literal","messageId":"noMagic","endLine":223,"endColumn":45},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 50.","line":225,"column":10,"nodeType":"Literal","messageId":"noMagic","endLine":225,"endColumn":12},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 50.","line":226,"column":10,"nodeType":"Literal","messageId":"noMagic",