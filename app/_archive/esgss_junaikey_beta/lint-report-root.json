olor: 'bg-green-500' },\n  { id: 7, name: '?航??皞?, color: 'bg-yellow-400' },\n  { id: 12, name: '鞎痊隞餅?鞎?, color: 'bg-orange-500' },\n  { id: 13, name: '瘞????, color: 'bg-red-600' },\n  { id: 17, name: '憭乩撈??', color: 'bg-pink-500' },\n];\n\ninterface ImpactProjectProps {\n  project?: ImpactProjectData;\n  compact?: boolean;\n}\n\nexport const ImpactProject: React.FC<ImpactProjectProps> = ({ project, compact = false }) => {\n  const [selectedProject, setSelectedProject] = useState<ImpactProjectData | null>(project || null);\n\n  // 蝷箔??數據\n  const sampleProject: ImpactProjectData = {\n    id: 'esg-impact-001',\n    title: '2026 ESG 靘???????,\n    description: '?靘??丰隡游祕?曄４銝剖??格?嚗??擃???永續銵函',\n    status: 'active',\n    progress: 75,\n    impactXP: 2500,\n    sdgs: [7, 12, 13, 17],\n    sroi: 3.2,\n    milestones: [\n      {\n        id: 'm1',\n        title: '靘??４?斗摰?',\n        status: 'completed',\n        xpReward: 500,\n        description: '摰? 50 摰嗡蜓閬????４頞唾楚?斗',\n      },\n      {\n        id: 'm2',\n        title: '蝭?賣?銵???,\n        status: 'in_progress',\n        xpReward: 800,\n        description: '撠 AI ?芸??賣?蝞∠?系統',\n      },\n      {\n        id: 'm3',\n        title: '靘???霅???,\n        status: 'pending',\n        xpReward: 1200,\n        description: '撱箇?靘??偶蝥?霅摨?,\n      },\n    ],\n    impactMetrics: [\n      {\n        label: '皜４??,\n        current: 12500,\n        target: 20000,\n        unit: '??CO?',\n        proxy_value: 62.5,\n      },\n      {\n        label: '靘?????',\n        current: 45,\n        target: 80,\n        unit: '%',\n        proxy_value: 56.25,\n      },\n      {\n        label: 'SROI ?',\n        current: 3.2,\n        target: 4.0,\n        unit: '??,\n        proxy_value: 80,\n      },\n    ],\n    financials: {\n      budget: 5000000,\n      spent: 3200000,\n      revenue_projected: 12000000,\n      roi_projected: 2.4,\n    },\n  };\n\n  const currentProject = selectedProject || sampleProject;\n\n  if (compact) {\n    return (\n      <div className=\"bg-slate-900/50 border border-slate-700 rounded-xl p-4 hover:border-slate-600 transition-colors\">\n        <div className=\"flex justify-between items-start mb-3\">\n          <h4 className=\"text-white font-bold text-sm\">{currentProject.title}</h4>\n          <div\n            className={`px-2 py-1 rounded-full text-xs font-bold ${\n              currentProject.status === 'active'\n                ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20'\n                : currentProject.status === 'completed'\n                  ? 'bg-blue-500/10 text-blue-400 border border-blue-500/20'\n                  : 'bg-amber-500/10 text-amber-400 border border-amber-500/20'\n            }`}\n          >\n            {currentProject.status === 'active'\n              ? '?脰?銝?\n              : currentProject.status === 'completed'\n                ? '已完成\n                : '撌脫??}\n          </div>\n        </div>\n\n        <div className=\"space-y-2\">\n          <div className=\"flex justify-between text-xs text-slate-400\">\n            <span>?脣漲</span>\n            <span>{currentProject.progress}%</span>\n          </div>\n          <div className=\"w-full bg-slate-700 rounded-full h-2\">\n            <div\n              className=\"bg-gradient-to-r from-emerald-500 to-blue-500 h-2 rounded-full transition-all duration-500\"\n              style={{ width: `${currentProject.progress}%` }}\n            />\n          </div>\n\n          <div className=\"flex justify-between items-center text-xs\">\n            <span className=\"text-slate-400\">SROI: {currentProject.sroi}x</span>\n            <span className=\"text-slate-400\">XP: {currentProject.impactXP}</span>\n          </div>\n        </div>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"bg-slate-900/50 border border-cyan-500/20 rounded-2xl p-6 flex flex-col h-full backdrop-blur-sm shadow-[0_0_20px_rgba(34,211,238,0.1)]\">\n      <div className=\"flex justify-between items-start mb-6\">\n        <div>\n          <h3 className=\"text-xl font-bold text-white flex items-center gap-2 mb-2\">\n            <Target className=\"text-emerald-400\" />\n            {currentProject.title}\n          </h3>\n          <p className=\"text-slate-400 text-sm\">{currentProject.description}</p>\n        </div>\n\n        <div\n          className={`px-3 py-1 rounded-full text-sm font-bold border ${\n            currentProject.status === 'active'\n              ? 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20 shadow-[0_0_10px_rgba(16,185,129,0.2)]'\n              : currentProject.status === 'completed'\n                ? 'bg-blue-500/10 text-blue-400 border-blue-500/20 shadow-[0_0_10px_rgba(59,130,246,0.2)]'\n                : 'bg-amber-500/10 text-amber-400 border-amber-500/20 shadow-[0_0_10px_rgba(245,158,11,0.2)]'\n          }`}\n        >\n          {currentProject.status === 'active'\n            ? '?脰?銝?\n            : currentProject.status === 'completed'\n              ? '已完成\n              : '撌脫??}\n        </div>\n      </div>\n\n      {/* SDG 撠? */}\n      <div className=\"mb-6\">\n        <h4 className=\"text-sm font-bold text-slate-300 mb-3 flex items-center gap-2\">\n          <Globe className=\"w-4 h-4\" />\n          SDG ?格?撠?\n        </h4>\n        <div className=\"flex flex-wrap gap-2\">\n          {currentProject.sdgs.map(sdgId => {\n            const sdg = SDG_TARGETS.find(s => s.id === sdgId);\n            return sdg ? (\n              <div\n                key={sdgId}\n                className={`flex items-center gap-2 px-3 py-1 rounded-full text-xs font-bold text-white ${sdg.color}`}\n              >\n                <span className=\"font-mono\">{sdgId}</span>\n                <span>{sdg.name}</span>\n              </div>\n            ) : null;\n          })}\n        </div>\n      </div>\n\n      {/* ?脣漲??SROI */}\n      <div className=\"grid grid-cols-2 gap-4 mb-6\">\n        <div className=\"bg-slate-800/50 border border-white/5 rounded-lg p-4\">\n          <div className=\"flex justify-between items-center mb-2\">\n            <span className=\"text-slate-400 text-sm\">撠??脣漲</span>\n            <span className=\"text-white font-bold\">{currentProject.progress}%</span>\n          </div>\n          <div className=\"w-full bg-slate-700 rounded-full h-2\">\n            <div\n              className=\"bg-gradient-to-r from-emerald-500 to-blue-500 h-2 rounded-full transition-all duration-500\"\n              style={{ width: `${currentProject.progress}%` }}\n            />\n          </div>\n        </div>\n\n        <div className=\"bg-slate-800/50 border border-white/5 rounded-lg p-4\">\n          <div className=\"flex justify-between items-center mb-2\">\n            <span className=\"text-slate-400 text-sm\">蝷暹????梢??/span>\n            <span className=\"text-emerald-400 font-bold text-lg\">{currentProject.sroi}x</span>\n          </div>\n          <div className=\"text-xs text-slate-500\">\n            瘥???1 ???{currentProject.sroi} ?冗??墦n          </div>\n        </div>\n      </div>\n\n      {/* 敶梢??璅?*/}\n      <div className=\"mb-6\">\n        <h4 className=\"text-sm font-bold text-slate-300 mb-3 flex items-center gap-2\">\n          <TrendingUp className=\"w-4 h-4\" />\n          敶梢??璅蕭頩么n        </h4>\n        <div className=\"space-y-3\">\n          {currentProject.impactMetrics.map((metric, index) => (\n            <div key={index} className=\"bg-slate-800/30 border border-white/5 rounded-lg p-3\">\n              <div className=\"flex justify-between items-center mb-2\">\n                <span className=\"text-slate-300 text-sm\">{metric.label}</span>\n                <span className=\"text-white font-bold\">\n                  {metric.current} / {metric.target} {metric.unit}\n                </span>\n              </div>\n              <div className=\"w-full bg-slate-700/50 rounded-full h-2\">\n                <div\n                  className={`h-2 rounded-full transition-all duration-500 ${\n                    metric.proxy_value >= 80\n                      ? 'bg-emerald-500 shadow-[0_0_5px_rgba(16,185,129,0.5)]'\n                      : metric.proxy_value >= 60\n                        ? 'bg-amber-500 shadow-[0_0_5px_rgba(245,158,11,0.5)]'\n                        : 'bg-rose-500 shadow-[0_0_5px_rgba(244,63,94,0.5)]'\n                  }`}\n                  style={{ width: `${metric.proxy_value}%` }}\n                />\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* ??蝣?*/}\n      <div className=\"mb-6\">\n        <h4 className=\"text-sm font-bold text-slate-300 mb-3 flex items-center gap-2\">\n          <Award className=\"w-4 h-4\" />\n          撠???蝣n        </h4>\n        <div className=\"space-y-3\">\n          {currentProject.milestones.map(milestone => (\n            <div\n              key={milestone.id}\n              className=\"flex items-start gap-3 p-3 bg-slate-800/30 rounded-lg\"\n            >\n              <div className=\"mt-0.5\">\n                {milestone.status === 'completed' ? (\n                  <CheckCircle className=\"w-5 h-5 text-emerald-400\" />\n                ) : milestone.status === 'in_progress' ? (\n                  <Clock className=\"w-5 h-5 text-blue-400\" />\n                ) : (\n                  <AlertTriangle className=\"w-5 h-5 text-slate-500\" />\n                )}\n              </div>\n              <div className=\"flex-1\">\n                <div className=\"flex justify-between items-start\">\n                  <h5 className=\"text-white font-medium text-sm\">{milestone.title}</h5>\n                  <span className=\"text-xs text-slate-400\">XP: {milestone.xpReward}</span>\n                </div>\n                <p className=\"text-slate-400 text-xs mt-1\">{milestone.description}</p>\n              </div>\n            </div>\n          ))}\n 