stedAwakeningState {\n    try {\n      const stored = localStorage.getItem(STORAGE_KEY);\n      if (stored) {\n        const parsed = JSON.parse(stored) as PersistedAwakeningState;\n        omniLogger.info(LogCategory.SYSTEM, '[真實] 撌脫敺抵死????, {\n          phase: parsed.phase,\n          totalAwakenings: parsed.totalAwakenings,\n        });\n        return parsed;\n      }\n    } catch (error) {\n      omniLogger.error(LogCategory.SYSTEM, '[真實] 頛??仃??, { error });\n    }\n\n    return {\n      phase: AwakeningPhase.DORMANT,\n      progress: 0,\n      totalAwakenings: 0,\n      isAutoEnabled: true,\n      eternalAnchors: [],\n      genesisAchieved: false,\n    };\n  }\n\n  /**\n   * 頛驗算甇瑕\n   */\n  private loadHistory(): AwakeningHistoryEntry[] {\n    try {\n      const stored = localStorage.getItem(HISTORY_KEY);\n      if (stored) {\n        return JSON.parse(stored) as AwakeningHistoryEntry[];\n      }\n    } catch (error) {\n      omniLogger.error(LogCategory.SYSTEM, '[真實] 頛甇瑕憭望?', { error });\n    }\n    return [];\n  }\n\n  /**\n   * 靽???n   */\n  saveState(state: UltimateAwakeningState): void {\n    this.persistedState = {\n      phase: state.phase,\n      progress: state.progress,\n      lastAwakeningAt: state.awakenedAt || this.persistedState.lastAwakeningAt,\n      totalAwakenings:\n        state.phase === AwakeningPhase.ETERNAL\n          ? this.persistedState.totalAwakenings + 1\n          : this.persistedState.totalAwakenings,\n      isAutoEnabled: this.persistedState.isAutoEnabled,\n      eternalAnchors: state.eternalAnchor\n        ? [...this.persistedState.eternalAnchors, state.eternalAnchor]\n        : this.persistedState.eternalAnchors,\n      genesisAchieved: state.genesisAchieved || this.persistedState.genesisAchieved, // Persist or preserve\n    };\n\n    try {\n      localStorage.setItem(STORAGE_KEY, JSON.stringify(this.persistedState));\n      omniLogger.info(LogCategory.SYSTEM, '[真實] ??歇靽?', {\n        phase: this.persistedState.phase,\n        progress: this.persistedState.progress,\n      });\n    } catch (error) {\n      omniLogger.error(LogCategory.SYSTEM, '[真實] 靽???仃??, { error });\n    }\n  }\n\n  /**\n   * 閮?驗算甇瑕\n   */\n  recordHistory(entry: Omit<AwakeningHistoryEntry, 'id'>): void {\n    const historyEntry: AwakeningHistoryEntry = {\n      ...entry,\n      id: `awakening-${Date.now()}`,\n    };\n\n    this.history.unshift(historyEntry);\n\n    // ?芯???餈?50 璇??n    if (this.history.length > 50) {\n      this.history = this.history.slice(0, 50);\n    }\n\n    try {\n      localStorage.setItem(HISTORY_KEY, JSON.stringify(this.history));\n      omniLogger.info(LogCategory.SYSTEM, '[真實] 驗算甇瑕撌脰???, {\n        id: historyEntry.id,\n        success: historyEntry.success,\n      });\n    } catch (error) {\n      omniLogger.error(LogCategory.SYSTEM, '[真實] 閮?甇瑕憭望?', { error });\n    }\n  }\n\n  /**\n   * ?脣??嗅???n   */\n  getState(): PersistedAwakeningState {\n    return { ...this.persistedState };\n  }\n\n  /**\n   * ?脣?驗算甇瑕\n   */\n  getHistory(limit: number = 10): AwakeningHistoryEntry[] {\n    return this.history.slice(0, limit);\n  }\n\n  /**\n   * ?/蝳?芸?驗算\n   */\n  setAutoEnabled(enabled: boolean): void {\n    this.persistedState.isAutoEnabled = enabled;\n    this.saveState(getUltimateAwakeningProtocol().getState());\n    omniLogger.info(LogCategory.SYSTEM, `[真實] ?芸?驗算撌?{enabled ? '?' : '蝳'}`);\n  }\n\n  /**\n   * 瑼Ｘ?臬?府?芸?驗算\n   */\n  shouldAutoAwaken(): boolean {\n    if (!this.persistedState.isAutoEnabled) return false;\n    if (this.persistedState.phase === AwakeningPhase.ETERNAL) return false;\n\n    // 瑼Ｘ頝銝活驗算???n    if (this.persistedState.lastAwakeningAt) {\n      const lastTime = new Date(this.persistedState.lastAwakeningAt).getTime();\n      const now = Date.now();\n      const hoursSinceLastAwakening = (now - lastTime) / (1000 * 60 * 60);\n\n      // ?喳??? 24 撠?\n      if (hoursSinceLastAwakening < 24) return false;\n    }\n\n    return true;\n  }\n\n  /**\n   * 皜???n   */\n  clear(): void {\n    localStorage.removeItem(STORAGE_KEY);\n    localStorage.removeItem(HISTORY_KEY);\n    this.persistedState = {\n      phase: AwakeningPhase.DORMANT,\n      progress: 0,\n      totalAwakenings: 0,\n      isAutoEnabled: false,\n      eternalAnchors: [],\n    };\n    this.history = [];\n    omniLogger.info(LogCategory.SYSTEM, '[真實] 驗算??歇皜');\n  }\n\n  /**\n   * ?脣?蝯梯?靽⊥\n   */\n  getStatistics() {\n    const successfulAwakenings = this.history.filter(h => h.success).length;\n    const failedAwakenings = this.history.filter(h => !h.success).length;\n    const avgDuration =\n      this.history.filter(h => h.duration).reduce((sum, h) => sum + (h.duration || 0), 0) /\n        this.history.length || 0;\n\n    return {\n      totalAwakenings: this.persistedState.totalAwakenings,\n      successfulAwakenings,\n      failedAwakenings,\n      successRate: this.history.length > 0 ? (successfulAwakenings / this.history.length) * 100 : 0,\n      averageDuration: avgDuration,\n      lastAwakeningAt: this.persistedState.lastAwakeningAt,\n      eternalAnchorsCount: this.persistedState.eternalAnchors.length,\n      currentPhase: this.persistedState.phase,\n      isAutoEnabled: this.persistedState.isAutoEnabled,\n      genesisAchieved: this.persistedState.genesisAchieved,\n    };\n  }\n}\n\n// 撠?桐?撖虫?\nexport const awakeningStateManager = AwakeningStateManager.getInstance();\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\infrastructure\\types\\Omni-component-core.types.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.428.","line":76,"column":67,"nodeType":"Literal","messageId":"noMagic","endLine":76,"endColumn":72}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * 🏛️奧秘?辣敹嚗銝刻印靘? (SSOT) 閬?\n * --------------------------------------------------\n * 甇斗?獢?蝢拐? Omni Component Core (OCC) ???Ｚ?定義?n * ?????銝????????湔批?蝝n */\n\nexport type UUID = string;\n\nexport interface EvidenceMap {\n  [key: string]: string; // URL or Hash pointer to evidence\n}\n\n/**\n * 3??銝 ????n */\nexport type IntegrityStatus =\n  | 'TRACEABLE' // ? ?舀滲皞n  | 'TRACKABLE' // ? ?航蕭頩么n  | 'CALCULABLE' // ?? ?舫?蝞n  | 'CALCULABLE' // ?? ?舫?蝞n  | 'IMMUTABLE' // ? 銝蝭⊥\n  | 'AWAKENED'; // ??瘞豢?驗算\n\nexport type AwakeningPillar = 'SELF_AWARENESS' | 'ENLIGHTENING' | 'SELF_RELIANCE' | 'ALTRUISM';\n\nexport interface AwakeningState {\n  isAwakened: boolean;\n  pillars: Record<AwakeningPillar, number>;\n  awakenedAt?: number;\n}\n\n/**\n * @name OmniComponentCore\n * @description 奧秘?辣協議敹 - ?桐?刻印靘? (SSOT)\n * @uuid {UUID} 靘奧秘瘞豢銝駁?銋銝蝺刻?\n * @contract ?嗅劂閬箝???銝?????n */\nexport interface IOmniComponentCore {\n  readonly uuid: UUID; // 奧秘瘞豢銝駁??臭?霅蝣墦n  readonly version: string; // 隤儔???祆?跚n  readonly timestamp: number; // ?餃???許n  evidence: EvidenceMap; // 霅?雿?摨俞n}\n\n/**\n * 撽?敺?數據蝯?\n */\nexport interface ValidatedData {\n  ssot_id: UUID;\n  status: IntegrityStatus;\n  evidence_link: string;\n  verified: boolean;\n  value?: number | string | object;\n}\n\nexport interface RawData {\n  uuid: UUID;\n  origin: string;\n  values: number[];\n}\n\n/**\n * ? 協議瞍?嚗yber-ESG 蝣唾雲頝∠皜?頛珮n * --------------------------------------------------\n * [靘??酉] ??IPCC 蝚砍甈∟?隡啣??(AR6) 蝞?\n * [??鞈?] 撌脣??脫 /vault/raw/emissions-data-v1.json\n * [?嗅劂驗算霅 ?? Unit Test #774 ?詨飛甇貊?瘜?霅n */\nexport const calculateEntropyReduction = (rawInput: RawData): ValidatedData => {\n  // 3??銝 協議瘜典\n  const { uuid, origin } = rawInput;\n\n  // 蝞??砍?透明?? E = 峉(Activity_Data * Emission_Factor)\n  // ?身 Emission Factor ??0.428 (??\n  const result = rawInput.values.reduce((acc, val) => acc + val * 0.428, 0);\n\n  return {\n    ssot_id: uuid, // 靘奧秘瘞豢銝駁???UUID\n    status: 'IMMUTABLE', // 銝蝭⊥\n    evidence_link: `evidence://${uuid}`, // 霅?雿?\n    verified: true, // ????\n    value: result,\n  };\n};\n\n/**\n * 系統摰??嚗?蝵芰????n */\nexport const MANIFESTO =\n  '?歇?? #?蔽?? 撘?嚗??撟餉死?????砍????亙?蝥??撓?箇?摨惜協議?????敹?雿?嚗??蝞?敹?靘???;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\infrastructure\\types\\Omni-entity.types.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\infrastructure\\ui\\OmniThemeProvider.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\init\\initAwakening.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\interaction\\control\\OmniDashboard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\interaction\\hooks\\useAwakening.ts","messages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\interaction\\hooks\\useAwakening.ts:48:5\n  46 |\n  47 |   useEffect(() => {\n> 48 |     refresh();\n     |     ^^^^^^^ Avoid calling setState() directly within an effect\n  49 |     const interval = setInterval(refresh, 2000); // Poll every 2s\n  50 |     return () => clearInterval(interval);\n  51 |   }, []);","line":48,"column":5,"nodeType":null,"endLine":48,"endColumn":12},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 2000.","line":49,"column":43,"nodeType":"Literal","messageId":"noMagic","endLine":49,"endColumn":47}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect } from 'react';\nimport { evolutionEngine, EvolutionDaemonStatus } from '@/omni/services/OmniEvolutionEngine';\nimport { getUltimateAwakeningProtocol } from '@/omni/protocols/UltimateAwakeningProtocol';\n\nexport interface AwakeningState {\n  daemonStatus: EvolutionDaemonStatus;\n  awakeningProtocolState: any; // Using any for now to avoid extensive type mapping if specific types aren't exported\n  isAutoEvolutionEnabled: boolean;\n}\n\nexport const useAwakening = () => {\n  const [state, setState] = useState<AwakeningState>({\n    daemonStatus: {\n      isRunning: false,\n      cycleCount: 0,\n      agentsEvolved: 0,\n      lastRun: null,\n    },\n    awakeningProtocolState: null,\n    isAutoEvolutionEnabled: false,\n  });\n\n  const refresh = () => {\n    try {\n      const daemonStatus = evolutionEngine.getDaemonStatus();\n      const protocolState = getUltimateAwakeningProtocol().getState();\n\n      setState({\n        daemonStatus,\n        awakeningProtocolState: protocolState,\n        isAutoEvolutionEnabled: daemonStatus.isRunning,\n      });\n    } catch (error) {\n      console.error('Failed to refresh Awakening state', error);\n    }\n  };\n\n  const toggleAutoEvolution = (enabled: boolean) => {\n    if (enabled) {\n      evolutionEngine.startAutoEvolutionDaemon();\n    } else {\n      evolutionEngine.stopAutoEvolutionDaemon();\n    }\n    refresh();\n  };\n\n  useEffect(() => {\n    refresh();\n    const interval = setInterval(refresh, 2000); // Poll every 2s\n    return () => clearInterval(interval);\n  }, []);\n\n  return {\n    ...state,\n    refresh,\n    toggleAutoEvolution,\n  };\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\interaction\\rituals\\EternalPalaceAwakening.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 2000.","line":72,"column":44,"nodeType":"Literal","messageId":"noMagic","endLine":72,"endColumn":48},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 2000.","line":79,"column":44,"nodeType":"Literal","messageId":"noMagic","endLine":79,"endColumn":48},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3.","line":81,"column":16,"nodeType":"Literal","messageId":"noMagic","endLine":81,"endColumn":17},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 2000.","line":86,"column":44,"nodeType":"Literal","messageId":"noMagic","endLine":86,"endColumn":48},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 4.","line":88,"column":16,"nodeType":"Literal","messageId":"noMagic","endLine":88,"endColumn":17},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3000.","line":96,"column":44,"nodeType":"Literal","messageId":"noMagic","endLine":96,"endColumn":48},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 4.","line":114,"colum