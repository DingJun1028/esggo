]); // Dependency on isExecuting to prevent double fire\n\n  const executeUltimate = async () => {\n    if (isExecuting) return;\n\n    omniLogger.info(LogCategory.UI, '?冽閫貊憟抒儔: 代稱??', {\n      source_origin: 'OmniCrystal',\n    });\n\n    setIsExecuting(true);\n    setShowResult(false);\n\n    try {\n      const executionResult = await executeAgentUnityUltimate();\n      setResult(executionResult);\n      setShowResult(true);\n\n      // Auto-hide result after 10 seconds\n      setTimeout(() => {\n        setShowResult(false);\n      }, 10000);\n    } catch (error) {\n      omniLogger.error(LogCategory.UI, '憟抒儔?瑁?憭望?', {\n        error: String(error),\n        source_origin: 'OmniCrystal',\n      });\n    } finally {\n      setIsExecuting(false);\n    }\n  };\n\n  return {\n    isUnlocked,\n    isExecuting,\n    showResult,\n    result,\n    executeUltimate,\n    setShowResult, // Allow manual dismiss\n    skillInfo: AGENT_UNITY_ULTIMATE,\n  };\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\hooks\\useUniversalRectification.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\hooks\\useVirtualScroll.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3.","line":28,"column":14,"nodeType":"Literal","messageId":"noMagic","endLine":28,"endColumn":15}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect, useRef, useMemo } from 'react';\n\ninterface VirtualScrollOptions {\n  itemHeight: number;\n  containerHeight: number;\n  itemCount: number;\n  overscan?: number;\n}\n\ninterface VirtualScrollResult {\n  virtualItems: Array<{\n    index: number;\n    start: number;\n    size: number;\n  }>;\n  totalHeight: number;\n  scrollToIndex: (index: number) => void;\n}\n\n/**\n * ?皛曉? Hook - ?芸??瑕?銵冽扯\n * ?芣葡?閬????,憭批???皛曉??扯\n */\nexport function useVirtualScroll({\n  itemHeight,\n  containerHeight,\n  itemCount,\n  overscan = 3,\n}: VirtualScrollOptions): VirtualScrollResult {\n  const [scrollTop, setScrollTop] = useState(0);\n  const scrollElementRef = useRef<HTMLElement | null>(null);\n\n  // 設計?航?蝭?\n  const { virtualItems, totalHeight } = useMemo(() => {\n    const rangeStart = Math.floor(scrollTop / itemHeight);\n    const rangeEnd = Math.ceil((scrollTop + containerHeight) / itemHeight);\n\n    // 瘛餃? overscan 隞交?靘撟單??遝??撽n    const start = Math.max(0, rangeStart - overscan);\n    const end = Math.min(itemCount - 1, rangeEnd + overscan);\n\n    const items = [];\n    for (let i = start; i <= end; i++) {\n      items.push({\n        index: i,\n        start: i * itemHeight,\n        size: itemHeight,\n      });\n    }\n\n    return {\n      virtualItems: items,\n      totalHeight: itemCount * itemHeight,\n    };\n  }, [scrollTop, itemHeight, containerHeight, itemCount, overscan]);\n\n  // 皛曉??唳?摰揣撘n  const scrollToIndex = (index: number) => {\n    if (scrollElementRef.current) {\n      const targetScrollTop = index * itemHeight;\n      scrollElementRef.current.scrollTop = targetScrollTop;\n      setScrollTop(targetScrollTop);\n    }\n  };\n\n  // ??皛曉?鈭辣\n  useEffect(() => {\n    const handleScroll = (e: Event) => {\n      const target = e.target as HTMLElement;\n      setScrollTop(target.scrollTop);\n    };\n\n    const element = scrollElementRef.current;\n    if (element) {\n      element.addEventListener('scroll', handleScroll, { passive: true });\n      return () => element.removeEventListener('scroll', handleScroll);\n    }\n\n    return undefined;\n  }, []);\n\n  // ?湧 ref 閮剔蔭?寞?\n  useEffect(() => {\n    const setRef = (element: HTMLElement | null) => {\n      scrollElementRef.current = element;\n    };\n    (useVirtualScroll as any).setScrollElement = setRef;\n  }, []);\n\n  return {\n    virtualItems,\n    totalHeight,\n    scrollToIndex,\n  };\n}\n\n/**\n * 閮剔蔭皛曉?摰孵??\n */\nexport function setVirtualScrollElement(element: HTMLElement | null) {\n  if ((useVirtualScroll as any).setScrollElement) {\n    (useVirtualScroll as any).setScrollElement(element);\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\hooks\\useWorldEvents.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10000.","line":21,"column":8,"nodeType":"Literal","messageId":"noMagic","endLine":21,"endColumn":13},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3.","line":29,"column":27,"nodeType":"Literal","messageId":"noMagic","endLine":29,"endColumn":28},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.8.","line":29,"column":48,"nodeType":"Literal","messageId":"noMagic","endLine":29,"endColumn":51},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60000.","line":37,"column":8,"nodeType":"Literal","messageId":"noMagic","endLine":37,"endColumn":13},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: -2.","line":44,"column":38,"nodeType":"UnaryExpression","messageId":"noMagic","endLine":44,"endColumn":40}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { useState, useEffect, useCallback } from 'react';\nimport { EventEngine, WorldEvent } from '../services/EventEngine';\n\nexport const useWorldEvents = () => {\n  const [events, setEvents] = useState<WorldEvent[]>(() => {\n    const saved = localStorage.getItem('omni_world_events');\n    return saved ? JSON.parse(saved) : [];\n  });\n\n  // Cleanup expired events\n  useEffect(() => {\n    const interval = setInterval(() => {\n      const now = Date.now();\n      setEvents(prev => {\n        const updated = prev.filter(ev => ev.startTime + ev.duration > now);\n        if (updated.length !== prev.length) {\n          localStorage.setItem('omni_world_events', JSON.stringify(updated));\n        }\n        return updated;\n      });\n    }, 10000); // Check every 10s\n\n    return () => clearInterval(interval);\n  }, []);\n\n  // Randomly trigger new events\n  useEffect(() => {\n    const trigger = setInterval(() => {\n      if (events.length < 3 && Math.random() > 0.8) {\n        const newEvent = EventEngine.generateWorldEvent();\n        setEvents(prev => {\n          const next = [...prev, newEvent];\n          localStorage.setItem('omni_world_events', JSON.stringify(next));\n          return next;\n        });\n      }\n    }, 60000); // Try every minute\n\n    return () => clearInterval(trigger);\n  }, [events.length]);\n\n  const forceTriggerEvent = useCallback(() => {\n    const newEvent = EventEngine.generateWorldEvent();\n    setEvents(prev => [...prev.slice(-2), newEvent]);\n  }, []);\n\n  const resolveEvent = useCallback((id: string) => {\n    setEvents(prev => prev.filter(ev => ev.id !== id));\n  }, []);\n\n  const globalModifiers = EventEngine.getActiveModifiers(events);\n\n  return {\n    events,\n    globalModifiers,\n    forceTriggerEvent,\n    resolveEvent,\n  };\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\index.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\lib\\utils.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\main.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\adapters\\AwakeningAdapters.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 90.","line":91,"column":27,"nodeType":"Literal","messageId":"noMagic","endLine":91,"endColumn":29},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 20.","line":91,"column":36,"nodeType":"Literal","messageId":"noMagic","endLine":91,"endColumn":38},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 300.","line":93,"column":56,"nodeType":"Literal","messageId":"noMagic","endLine":93,"endColumn":59}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * 驗算???拚??沔n *\n * 撠??Omni ???拚??箏驗算??\n */\n\nimport type {\n  IAwakenable,\n  ServiceAwakeningStatus,\n  AwakeningResult,\n} from '../protocols/UltimateAwakeningProtocol';\nimport { AwakeningPhase } from '../protocols/UltimateAwakeningProtocol';\nimport { omniLogger, LogCategory } from '../infrastructure/logging/OmniLogger';\n\n/**\n * ?箇?驗算?拚??沔n * ?箔??舀驗算?亙????靘?隤祕雿n */\nexport class BaseAwakeningAdapter implements IAwakenable {\n  protected status: ServiceAwakeningStatus;\n\n  constructor(\n    public readonly name: string,\n    private awakeningLogic?: () => Promise<void>\n  ) {\n    this.status = {\n      serviceName: name,\n      status: 'pending',\n      progress: 0,\n    };\n  }\n\n  async awaken(): Promise<AwakeningResult> {\n    try {\n      omniLogger.info(LogCategory.SYSTEM, `[驗算] ${this.name} ??驗算...`);\n\n      this.status.status = 'awakening';\n      this.status.progress = 30;\n\n      // ?瑁??芸?蝢抵死??頛珮n      if (this.awakeningLogic) {\n        await this.awakeningLogic();\n      } else {\n        // 暺?驗算協議\n        await this.defaultAwakeningSequence();\n      }\n\n      this.status.status = 'awakened';\n      this.status.progress = 100;\n      this.status.awakenedAt = new Date().toISOString();\n\n      omniLogger.info(LogCategory.SYSTEM, `[驗算] ??${this.name} 驗算摰?`);\n\n      return {\n        success: true,\n        phase: AwakeningPhase.AWAKENED,\n        servicesAwakened: 1,\n        totalServices: 1,\n        message: `${this.name} 撌脫??死?,\n      };\n    } catch (error) {\n      this.status.status = 'failed';\n      this.status.error = (error as Error).message;\n\n      omniLogger.error(LogCategory.SYSTEM, `[驗算] ??${this.name} 驗算憭望?`, { error });\n\n      return {\n        success: false,\n        phase: AwakeningPhase.AWAKENING,\n        servicesAwakened: 0,\n        totalServices: 1,\n        message: `${this.name} 驗算憭望?: ${(error as Error).message}`,\n      };\n    }\n  }\n\n  getAwakeningState(): ServiceAwakeningStatus {\n    return { ...this.status };\n  }\n\n  async prepareForEternity(): Promise<void> {\n    omniLogger.info(LogCategory.SYSTEM, `[驗算] ${this.name} 皞??脣瘞豢????..`);\n    // 暺?撖虫?嚗?寞?皞?\n  }\n\n  /**\n   * 暺?驗算摨?\n   */\n  protected async defaultAwakeningSequence(): Promise<void> {\n    // 璅⊥驗算??\n    for (let i = 30; i <= 90; i += 20) {\n      this.status.progress = i;\n      await new Promise(resolve => setTimeout(resolve, 300));\n    }\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\components\\EvidenceBrowser.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 12.","line":16,"column":43,"nodeType":"Literal","messageId":"noMagic","endLine":16,"endColumn":45},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 6.","line":23,"column":63,"nodeType":"Literal","messageId":"noMagic","endLine":23,"endColumn":64},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 12.","line":36,"column":54,"nodeType":"Literal","messageId":"noMagic","endLine":36,"endColumn":56},{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\components\\EvidenceBrowser.tsx:55:5\n  53 |     // In a real app, this would be an API call.\n  54 |     // For now, we are using the in-memory EvidenceVault.\n> 55 |     setEvidenceList(EvidenceVault.getAllEvidence());\n     |     ^^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  56 |   }, []);\n  57 |\n  58 |   const filteredEvidence = searchQuery ? EvidenceVault.search(searchQuery) : evidenceList;","line":55,"column":5,"nodeType":null,"endLine":55,"endColumn":20}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\n// Assuming EvidenceVault will be in src/services. The path from src/omni/components is ../../services\nimport { EvidenceVault } from '@/services/EvidenceVault';\nimport { EvidenceMetadata } from '@/types/omni-report.types';\n\nconst EvidenceCard: React.FC<{ evidence: EvidenceMetadata }> = ({ evidence }) => (\n  <div className=\"border border-gray-700 rounded-lg p-4 bg-gray-800/50 shadow-md hover:shadow-lg transition-shadow\">\n    <div className=\"flex items-center mb-2\">\n      <span className=\"text-2xl mr-3\">??</span>\n      <h4 className=\"font-bold text-lg truncate\">{evidence.originalFileName}</h4>\n    </div>\n    <div className=\"text-sm text-gray-400 space-y-1\">\n      <p>\n        <span className=\"font-semibold\">Hash:</span>{' '}\n        <code className=\"text-xs bg-gray-700 p-1 rounded\">\n          {evidence.fileHash.substring(0, 12)}...\n        </code>\n      </p>\n      {evidence.linkedTruthClaims && evidence.linkedTruthClaims.length > 0 ? (\n        <p>\n          <span className=\"font-semibold\">Linked Truth:</span>{' '}\n          <code className=\"text-xs bg-blue-900 text-blue-200 p-1 rounded\">\n            #TR-{evidence.linkedTruthClaims![0]?.substring(0, 6)}\n          </code>\n        </p>\n      ) : (\n        <p>\n          <span className=\"font-semibold\">Linked Truth:</span> <span>Not linked</span>\n        </p>\n      )}\n\n      {evidence.blockchainTxHash ? (\n        <p className=\"text-green-400\">\n          <span className=\"font-semibold\">?? Anchored:</span>{' '}\n          <code className=\"text-xs bg-green-900 text-green-300 p-1 rounded\">\n            {evidence.blockchainTxHash?.substring(0, 12)}...\n          </code>\n        </p>\n      ) : (\n        <p className=\"text-yellow-400\">\n          <span className=\"font-semibold\">??Not anchored</span>\n        </p>\n      )}\n    </div>\n  </div>\n);\n\nexport const EvidenceBrowser: React.FC = () => {\n  const [evidenceList, setEvidenceList] = useState<EvidenceMetadata[]>([]);\n  const [searchQuery, setSearchQuery] = useState('');\n\n  useEffect(() => {\n    // In a real app, this would be an API call.\n    // For now, we are using the in-memory EvidenceVault.\n    setEvidenceList(EvidenceVault.getAllEvidence());\n  }, []);\n\n  const filteredEvidence = searchQuery ? EvidenceVault.search(searchQuery) : evidenceList;\n\n  return (\n    <div className=\"frosted-panel p-6 max-w-4xl mx-auto\">\n      <h2 className=\"text-3xl font-bold mb-6 text-white flex items-center\">\n        <span className=\"text-4xl mr-4\">🏛️/span>\n        雿?摨?Evidence Vault\n      </h2>\n      <input\n        type=\"search\"\n        placeholder=\"Search for evidence by name, hash, or content...\"\n        value={searchQuery}\n        onChange={e => setSearchQuery(e.target.value)}\n        className=\"w-full p-3 mb-6 bg-gray-900 border border-gray-700 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 transition-colors\"\n      />\n\n      {filteredEvidence.length > 0 ? (\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n          {filteredEvidence.map(evidence => (\n            <EvidenceCard key={evidence.id} evidence={evidence} />\n          ))}\n        </div>\n      ) : (\n        <div className=\"text-center py-10\">\n          <p className=\"text-gray-400\">No evidence found.</p>\n          {searchQuery && <p className=\"text-gray-500\">Try a different search term.</p>}\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default EvidenceBrowser;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\core\\GoodwardCore.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\core\\InfoOneCore.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\core\\OmniConstitution.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\core\\OmniCrystal.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"w