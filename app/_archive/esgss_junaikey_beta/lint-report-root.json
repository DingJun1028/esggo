=\"text-[10px] font-black text-[#0ab8b2] uppercase tracking-widest\">\n                  鞎∪? FNC\n                </span>\n                <div className=\"flex justify-between w-full\">\n                  <span className=\"text-[10px] font-black text-[#0ab8b2] uppercase tracking-widest\">\n                    撣 MKT\n                  </span>\n                  <span className=\"text-[10px] font-black text-[#0ab8b2] uppercase tracking-widest\">\n                    ?菜 INN\n                  </span>\n                </div>\n                <div className=\"flex justify-between w-full\">\n                  <span className=\"text-[10px] font-black text-[#0ab8b2] uppercase tracking-widest\">\n                    ?∪極 HR\n                  </span>\n                  <span className=\"text-[10px] font-black text-[#0ab8b2] uppercase tracking-widest\">\n                    ?啣? ENV\n                  </span>\n                </div>\n                <span className=\"text-[10px] font-black text-[#0ab8b2] uppercase tracking-widest\">\n                  瘝餌? GVN\n                </span>\n              </div>\n            </div>\n\n            {/* Vital Metrics Grid */}\n            <div className=\"grid grid-cols-2 gap-5\">\n              {[\n                { label: '鞎∪?蝛拙摨?Stability', val: '92%', positive: true },\n                { label: 'ESG 符合摨?Compliance', val: '84%', positive: true },\n              ].map((metric, i) => (\n                <div\n                  key={i}\n                  className=\"backdrop-blur-3xl bg-white/5 border border-white/5 p-5 rounded-2xl border-l-[6px] border-l-[#0ab8b2] shadow-inner\"\n                >\n                  <p className=\"text-[9px] font-black uppercase tracking-widest text-white/30 italic leading-none mb-2\">\n                    {metric.label}\n                  </p>\n                  <p className=\"text-2xl font-black italic text-white tracking-tighter\">\n                    {metric.val}\n                  </p>\n                </div>\n              ))}\n            </div>\n          </motion.div>\n        </section>\n      </main>\n\n      {/* Floating Strategy Action Button */}\n      <button className=\"fixed bottom-28 right-6 size-16 bg-[#0ab8b2] text-[#102222] rounded-full shadow-[0_15px_40px_rgba(10,184,178,0.4)] flex items-center justify-center z-40 active:scale-95 border-4 border-[#102222] transition-transform animate-bounce-slow\">\n        <RebaseEdit style={{ fontSize: '28px' }} />\n      </button>\n\n      {/* Bottom Navigation Dock */}\n      <nav className=\"fixed bottom-0 left-1/2 -translate-x-1/2 w-full max-w-[480px] h-24 backdrop-blur-3xl bg-[#0a1b1b]/90 border-t border-[#0ab8b2]/20 px-8 flex justify-between items-center z-50 rounded-t-[2.5rem] shadow-[0_-20px_50px_rgba(0,0,0,0.5)]\">\n        {[\n          { icon: Home, label: '擐?' },\n          { icon: Insights, label: '?啁', active: true },\n          { icon: MedicalServices, label: '閮箸' },\n          { icon: Settings, label: '閮剖?' },\n        ].map((item, i) => (\n          <button\n            key={i}\n            className={`flex flex-col items-center gap-1.5 transition-all ${item.active ? 'text-[#0ab8b2] scale-110 active:scale-95' : 'text-white/20 hover:text-white'}`}\n          >\n            <item.icon\n              style={{ fontSize: '26px' }}\n              className={item.active ? 'drop-shadow-[0_0_8px_#0ab8b2]' : ''}\n            />\n            <span className=\"text-[10px] font-black uppercase tracking-widest leading-none\">\n              {item.label}\n            </span>\n          </button>\n        ))}\n      </nav>\n\n      <style>{`\n        .no-scrollbar::-webkit-scrollbar { display: none; }\n        .font-display { font-family: 'Space Grotesk', 'Noto Sans TC', sans-serif; }\n        @keyframes pulse-slow {\n           0%, 100% { opacity: 1; transform: rotate(-18deg) scale(1); }\n           50% { opacity: 0.8; transform: rotate(-18deg) scale(0.98); }\n        }\n        .animate-pulse-slow { animation: pulse-slow 4s infinite ease-in-out; }\n        @keyframes bounce-slow {\n           0%, 100% { transform: translateY(0); }\n           50% { transform: translateY(-10px); }\n        }\n        .animate-bounce-slow { animation: bounce-slow 3s infinite ease-in-out; }\n      `}</style>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\mobile\\SustainabilityAchievementMobile.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\omni\\CardArena.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":140,"column":53,"nodeType":"Literal","messageId":"noMagic","endLine":140,"endColumn":55},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":148,"column":53,"nodeType":"Literal","messageId":"noMagic","endLine":148,"endColumn":55}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from 'react';\nimport { EsgCard, getEsgCards, Language } from '@/types';\nimport { Sparkles, Trophy, Target } from '../icons';\n\ninterface CardArenaProps {\n  onCardAction?: (cardId: string, action: string) => void;\n}\n\nconst CardArena: React.FC<CardArenaProps> = ({ onCardAction }) => {\n  const [selectedCard, setSelectedCard] = useState<EsgCard | null>(null);\n  const [language] = useState<Language>('zh-TW');\n  const cards = getEsgCards(language);\n\n  const rarityColors: Record<string, string> = {\n    Basic: 'from-slate-500 to-slate-700', // ?箇?\n    Common: 'from-slate-500 to-slate-700', // ? (Fallback)\n    Rare: 'from-blue-500 to-blue-700', // 蝔?n    Epic: 'from-purple-500 to-purple-700', // ?脰帘\n    Legendary: 'from-amber-400 to-orange-600', // ?唾牧\n    Zenith: 'from-rose-500 to-red-800', // 撌陸\n    Emergent: 'from-indigo-400 to-cyan-500', // 皝抒\n  };\n\n  const rarityLabels: Record<string, string> = {\n    Basic: '?箇? (Basic)',\n    Common: '? (Common)',\n    Rare: '蝔??(Rare)',\n    Epic: '?脰帘 (Epic)',\n    Legendary: '?唾牧 (Legendary)',\n    Zenith: '撌陸 (Zenith)',\n    Emergent: '皝抒 (Emergent)',\n  };\n\n  const attributeIcons = {\n    Vision: '🏛️,\n    Governance: '??',\n    Knowledge: '??',\n    Impact: '?',\n    Virtue: '??',\n  };\n\n  return (\n    <div className=\"p-6 space-y-6 animate-in fade-in duration-500\">\n      {/* Header */}\n      <div className=\"flex justify-between items-end\">\n        <div>\n          <h1 className=\"text-3xl font-black text-white tracking-tight flex items-center gap-3\">\n            <Trophy className=\"text-[#FFD700] w-8 h-8\" />\n            Impact Nexus : ?∠?蝡嗆??廄n            <span className=\"bg-[#FFD700]/10 text-[#FFD700] border-[#FFD700]/30 text-[10px] uppercase font-mono px-2 py-0.5 rounded\">\n              v8.4.0_10_Point_Scale\n            </span>\n          </h1>\n          <p className=\"text-slate-400 mt-1 text-sm font-medium\">\n            ?園??飛蝧奎? - 奧秘永續?∠?系統 (5T ?嗅劂驗算霅?\n          </p>\n        </div>\n        <div className=\"bg-[#FFD700]/10 border border-[#FFD700]/20 px-4 py-2 rounded-full flex items-center gap-2\">\n          <Sparkles className=\"w-4 h-4 text-[#FFD700]\" />\n          <span className=\"text-[#FFD700] text-xs font-bold\">{cards.length} 撘萄??/span>\n        </div>\n      </div>\n\n      {/* Stats Bar */}\n      <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4\">\n        {[\n          { label: '?嗉??脣漲', value: '18/50', color: 'emerald' },\n          { label: '蝔?漲蝛?', value: '1,240', color: 'amber' },\n          { label: '10??啣?', value: '8.4', color: 'blue' },\n          { label: '靽∟亳蝑?', value: '10/10', color: 'purple' },\n        ].map((stat, i) => (\n          <div\n            key={i}\n            className=\"bg-slate-900/50 border border-white/5 rounded-2xl p-4 premium-panel-glow\"\n          >\n            <div className=\"text-slate-500 text-[10px] font-black uppercase mb-1 tracking-widest\">\n              {stat.label}\n            </div>\n            <div className={`text-2xl font-black text-${stat.color}-400`}>{stat.value}</div>\n          </div>\n        ))}\n      </div>\n\n      {/* Card Grid */}\n      <div>\n        <h2 className=\"text-lg font-bold text-white mb-4 flex items-center gap-2\">\n          <Target className=\"w-5 h-5 text-blue-400\" />\n          雿??∠??嗉? (SSOT 憟?撠)\n        </h2>\n        <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n          {cards.map(card => (\n            <div\n              key={card.id}\n              onClick={() => setSelectedCard(card)}\n              className={`relative bg-slate-950/80 backdrop-blur-md rounded-3xl p-6 border-2 transition-all duration-300 cursor-pointer group hover:scale-[1.02] ${\n                selectedCard?.id === card.id\n                  ? 'border-[#FFD700] shadow-[0_0_30px_rgba(255,215,0,0.2)]'\n                  : 'border-white/5 hover:border-white/20 shadow-xl'\n              }`}\n            >\n              {/* Rarity Gradient Header */}\n              <div\n                className={`absolute top-0 left-0 right-0 h-1.5 bg-gradient-to-r ${rarityColors[card.rarity] || rarityColors.Basic} rounded-t-3xl`}\n              />\n\n              {/* Card Content */}\n              <div className=\"mt-2\">\n                <div className=\"flex justify-between items-start mb-4\">\n                  <div className=\"flex items-center gap-4\">\n                    <div className=\"w-12 h-12 rounded-2xl bg-white/5 flex items-center justify-center text-2xl group-hover:rotate-12 transition-transform\">\n                      {attributeIcons[card.attribute] || '??'}\n                    </div>\n                    <div>\n                      <h3 className=\"text-gray-100 font-black text-lg group-hover:text-[#FFD700] transition-colors\">\n                        {card.title}\n                      </h3>\n                      <p className=\"text-[10px] text-slate-500 font-mono tracking-tighter uppercase\">\n                        {card.term}\n                      </p>\n                    </div>\n                  </div>\n                  <span\n                    className={`px-2 py-0.5 rounded-md text-[9px] font-black uppercase bg-gradient-to-r ${rarityColors[card.rarity] || rarityColors.BASIC} text-white border-0 shadow-lg`}\n                  >\n                    {rarityLabels[card.rarity] || card.rarity}\n                  </span>\n                </div>\n\n                <p className=\"text-xs text-slate-400 mb-6 line-clamp-2 leading-relaxed h-10\">\n                  {card.definition}\n                </p>\n\n                {/* 10-Point Combat Stats */}\n                <div className=\"grid grid-cols-2 gap-3 mb-4\">\n                  <div className=\"bg-white/[0.03] rounded-2xl p-3 border border-white/5 flex flex-col items-center group-hover:bg-white/[0.05] transition-colors\">\n                    <div className=\"text-[8px] text-red-500/80 font-black uppercase tracking-[0.2em] mb-1\">\n                      ?? ATK\n                    </div>\n                    <div className=\"text-xl font-black text-red-400\">\n                      {(card.stats?.offense || 0) / 10}\n                    </div>\n                  </div>\n                  <div className=\"bg-white/[0.03] rounded-2xl p-3 border border-white/5 flex flex-col items-center group-hover:bg-white/[0.05] transition-colors\">\n                    <div className=\"text-[8px] text-blue-500/80 font-black uppercase tracking-[0.2em] mb-1\">\n                      ?儭?DEF\n                    </div>\n                    <div className=\"text-xl font-black text-blue-400\">\n                      {(card.stats?.defense || 0) / 10}\n                    </div>\n                  </div>\n                </div>\n\n                {/* Collection Set */}\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"text-[10px] text-slate-500 uppercase\">\n                    蝟餃?: {card.collectionSet}\n                  </span>\n                  <span className=\"text-[10px] text-slate-500\">{card.cardType}</span>\n                </div>\n              </div>\n\n              {/* Hover Effect */}\n              <div className=\"absolute inset-0 bg-gradient-to-br from-white/0 to-white/5 opacity-0 group-hover:opacity-100 transition-opacity rounded-2xl pointer-events-none\" />\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Selected Card Detail Modal */}\n      {selectedCard && (\n        <div\n          className=\"fixed inset-0 bg-black/50 backdrop-blur-sm z-50 flex items-center justify-center p-4\"\n          onClick={() => setSelectedCard(null)}\n        >\n          <div\n            className=\"bg-slate-900 border border-white/10 rounded-3xl p-6 max-w-md w-full\"\n            onClick={e => e.stopPropagation()}\n          >\n            <div\n              className={`h-2 bg-gradient-to-r ${rarityColors[selectedCard.rarity]} rounded-full mb-4`}\n            />\n            <div className=\"flex items-center gap-3 mb-4\">\n              <span className=\"text-4xl\">{attributeIcons[selectedCard.attribute]}</span>\n              <div>\n                <h2 className=\"text-2xl font-black text-white\">{selectedCard.title}</h2>\n                <p className=\"text-sm text-slate-400\">{selectedCard.term}</p>\n              </div>\n            </div>\n            <div className=\"space-y-4\">\n              <div>\n                <h3 className=\"text-xs font-bold text-slate-500 uppercase mb-1\">實作</h3>\n                <p className=\"text-white\">{selectedCard.definition}</p>\n              </div>\n              <div>\n                <h3 className=\"text-xs font-bold text-slate-500 uppercase mb-1\">隤芣?</h3>\n                <p className=\"text-slate-300\">{selectedCard.description}</p>\n              </div>\n              <div className=\"grid grid-cols-2 gap-3\">\n                <div className=\"bg-white/5 rounded-xl p-3 text-center\">\n                  <div className=\"text-xs text-slate-500 uppercase mb-1\">?餅???/div>\n                  <div className=\"text-3xl font-black text-red-400\">\n                    {selectedCard.stats?.offense || 0}\n                  </div>\n                </div>\n                <div className=\"bg-white/5 rounded-xl p-3 text-center\">\n                  <div className=\"text-xs text-slate-500 uppercase mb-1\">?脩戌??/div>\n                  <div className=\"text-3xl font-black text-blue-400\">\n                    {selectedCard.stats?.defense || 0}\n                  </div>\n                </div>\n              </div>\n              <button\n                onClick={() => setSelectedCard(null)}\n                className=\"w-full bg-gradient-to-r from-emerald-600 to-blue-600 text-white py-3 rounded-xl font-bold hover:shadow-lg transition-all\"\n              >\n                ??\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default CardArena;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\onboarding\\NoviceGuideOverlay.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\onboarding\\WelcomePackModal.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\operations\\IpmsModule.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\passport\\TalentPassport.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":228,"column":32,"nodeType":"Literal","messageId":"noMagic","endLine":228,"endColumn":33}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport {\n  Award,\n  ShieldCheck,\n  Zap,\n  Globe,\n  Cpu,\n  Users,\n  Briefcase,\n  Lock,\n  Fingerprint,\n  Coins,\n} from 'lucide-react';\nimport {\n  ResponsiveContainer,\n  RadarChart,\n  PolarGrid,\n  PolarAngleAxis,\n  PolarRadiusAxis,\n  Radar,\n  Tooltip,\n} from 'recharts';\n\n/**\n * ? 奧秘 UI ?辣嚗偶蝥犖?風??(Sustainability Talent Passport)\n * --------------------------------------------------\n * [驗證] 整合 Berkeley 隤??mpactNexus ??3+1 驗證\n * [閬死] Credit-Score Style / Glassmorphism\n */\n\ninterface Badge {\n  id: string;\n  name: string;\n  icon?: React.ReactNode;\n  color?: string;\n  date: string;\n  lockedHash: string;\n}\n\ninterface TalentPassportProps {\n  user: {\n    name: string;\n    title: string;\n    avatar?: string;\n    uuid: string;\n    berkeleyId?: string;\n    evolutionLevel?: number;\n    masteryLevel?: number;\n    digitalSignature?: string;\n  };\n  stats: {\n    governance: number;\n    innovation: number;\n    traceability: number;\n    impact: number;\n    technical: number;\n  };\n  assets: {\n    itkBalance: number;\n    lockedSroiValue: number;\n  };\n  badges: Badge[];\n}\n\n// 3+1 驗證撽?璅?\nconst ProtocolBadge = ({ type }: { type: 'immutable' | 'traceable' | 'calculable' }) => {\n  const config = {\n    immutable: {\n      label: 'Immutable',\n      color: 'text-red-500',\n      bg: 'bg-red-500/10',\n      border: 'border-red-500/20',\n    },\n    traceable: {\n      label: 'Traceable',\n      color: 'text-emerald-500',\n      bg: 'bg-emerald-500/10',\n      border: 'border-emerald-500/20',\n    },\n    calculable: {\n      label: 'Calculable',\n      color: 'text-amber-500',\n      bg: 'bg-amber-500/10',\n      border: 'border-amber-500/20',\n    },\n  }[type];\n\n  return (\n    <div\n      className={`flex items-center gap-1.5 px-2 py-1 rounded border ${config.bg} ${config.border}`}\n    >\n      <div\n        className={`w-1.5 h-1.5 rounded-full ${config.color.replace('text', 'bg')} animate-pulse`}\n      />\n      <span className={`text-[9px] font-black uppercase tracking-wider ${config.color}`}>\n        {config.label}\n      </span>\n    </div>\n  );\n};\n\nexport const TalentPassport: React.FC<TalentPassportProps> = ({ user, stats, assets, badges }) => {\n  const radarData = [\n    { subject: 'Strategy', A: stats.governance, fullMark: 100 },\n    { subject: 'Innovation', A: stats.innovation, fullMark: 100 },\n    { subject: 'Traceability', A: stats.traceability, fullMark: 100 },\n    { subject: 'Impact', A: stats.impact, fullMark: 100 },\n    { subject: 'Technical', A: stats.technical, fullMark: 100 },\n    { subject: 'Value', A: (stats.impact + stats.innovation) / 2, fullMark: 100 },\n  ];\n\n  return (\n    <div className=\"w-full max-w-[800px] bg-[#0A0A0A] rounded-[24px] overflow-hidden border border-white/10 shadow-[0_40px_80px_-20px_rgba(0,0,0,0.8)] relative font-sans\">\n      {/* Glossy Overlay */}\n      <div className=\"absolute inset-0 bg-gradient-to-br from-white/5 to-transparent pointer-events-none\" />\n\n      <div className=\"flex flex-col md:flex-row h-full relative z-10\">\n        {/* 1. 撌血嚗D 蝬剖漲 (Identity Core) */}\n        <div className=\"md:w-[280px] p-6 bg-[#050505] border-r border-white/5 flex flex-col justify-between relative overflow-hidden\">\n          {/* Background Pattern */}\n          <div className=\"absolute top-0 right-0 w-32 h-32 bg-emerald-500/10 rounded-full blur-[60px] pointer-events-none\" />\n\n          <div>\n            <div className=\"mb-6\">\n              <h3 className=\"text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em] mb-4\">\n                Identity Core\n              </h3>\n              <div className=\"w-24 h-24 rounded-2xl bg-gradient-to-br from-slate-800 to-black p-[1px] shadow-2xl mb-4 group cursor-pointer relative\">\n                <div className=\"absolute inset-0 bg-emerald-500/20 blur-xl opacity-0 group-hover:opacity-100 transition-opacity\" />\n                <div className=\"w-full h-full rounded-[15px] bg-slate-900 overflow-hidden relative\">\n                  {user.avatar ? (\n                    <img\n                      src={user.avatar}\n                      alt={user.name}\n                      className=\"w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500\"\n                    />\n                  ) : (\n                    <div className=\"w-full h-full flex items-center justify-center text-3xl font-black text-slate-700\">\n                      {user.name[0]}\n                    </div>\n                  )}\n                </div>\n                <div className=\"absolute -bottom-2 -right-2 bg-emerald-500 text-black text-[10px] font-black px-2 py-0.5 rounded border border-black shadow-lg\">\n                  Lv.{user.evolutionLevel || 1}\n                </div>\n              </div>\n\n              <h2 className=\"text-2xl font-bold text-white tracking-tight mb-1\">{user.name}</h2>\n              <p className=\"text-emerald-500 text-xs font-bold uppercase tracking-widest mb-4\">\n                {user.title}\n              </p>\n\n              <div className=\"space-y-2\">\n                <div className=\"p-2 bg-white/5 rounded border border-white/5\">\n                  <p className=\"text-[8px] text-slate-500 uppercase mb-1\">Universal UUID</p>\n                  <p className=\"text-[10px] font-mono text-slate-300 break-all leading-tight\">\n                    {user.uuid}\n                  </p>\n                </div>\n                <div className=\"p-2 bg-white/5 rounded border border-white/5\">\n                  <p className=\"text-[8px] text-slate-500 uppercase mb-1\">Digital Signature</p>\n                  <p className=\"text-[10px] font-mono text-emerald-500/80 break-all leading-tight\">\n                    {user.digitalSignature || '0xSIGNED_BY_JUNAIKEY_PROTOCOL'}\n                  </p>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            <div className=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\" />\n            <span className=\"text-[10px] font-bold text-emerald-500 uppercase tracking-wider\">\n              Pass-3+1 Verified\n            </span>\n          </div>\n        </div>\n\n        {/* 2. 銝剖亢嚗?雁摨?(Capability Matrix) */}\n        <div className=\"flex-1 p-6 relative flex flex-col\">\n          <div className=\"absolute inset-0 bg-[url('https://grainy-gradients.vercel.app/noise.svg')] opacity-20 pointer-events-none\" />\n\n          <div className=\"flex justify-between items-start mb-4\">\n            <h3 className=\"text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em]\">\n              Capability Matrix\n            </h3>\n            <ProtocolBadge type=\"traceable\" />\n          </div>\n\n          <div className=\"flex-1 min-h-[240px] relative\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <RadarChart cx=\"50%\" cy=\"50%\" outerRadius=\"70%\" data={radarData}>\n                <PolarGrid stroke=\"#334155\" strokeDasharray=\"3 3\" opacity={0.3} />\n                <PolarAngleAxis\n                  dataKey=\"subject\"\n                  tick={{ fill: '#64748b', fontSize: 10, fontWeight: 700 }}\n                />\n                <PolarRadiusAxis angle={30} domain={[0, 100]} tick={false} axisLine={false} />\n                <Radar\n                  name=\"Skills\"\n                  dataKey=\"A\"\n                  stroke=\"#10b981\"\n                  strokeWidth={2}\n                  fill=\"#10b981\"\n                  fillOpacity={0.1}\n                />\n                <Tooltip\n                  cursor={false}\n                  content={({ active, payload }) => {\n                    if (active && payload && payload.length) {\n                      return (\n                        <div className=\"bg-black/90 border border-white/10 p-2 rounded text-xs backdrop-blur-md\">\n                          <span className=\"text-emerald-400 font-mono font-bold\">\n                            {payload[0].value}\n                          </span>\n                        </div>\n                      );\n                    }\n                    return null;\n                  }}\n                />\n              </RadarChart>\n            </ResponsiveContainer>\n          </div>\n\n          {/* Badge Strip */}\n          <div className=\"mt-4 pt-4 border-t border-white/5\">\n            <div className=\"flex gap-2\">\n              {badges.slice(0, 5).map(b => (\n                <div\n                  key={b.id}\n                  className=\"w-8 h-8 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 group relative\"\n                >\n                  {b.icon || <Award size={14} />}\n                  <div className=\"absolute bottom-full mb-2 bg-black text-white text-[9px] px-2 py-1 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap z-50\">\n                    {b.name}\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </div>\n\n        {/* 3. ?喳嚗??Ｙ雁摨?(Asset Vault) */}\n        <div className=\"md:w-[220px] p-6 bg-[#080808] border-l border-white/5 flex flex-col gap-6\">\n          <h3 className=\"text-[10px] font-bold text-slate-500 uppercase tracking-[0.2em]\">\n            Asset Vault\n          </h3>\n\n          {/* ITK Balance */}\n          <div className=\"p-4 rounded-xl bg-gradient-to-br from-indigo-500/10 to-purple-500/10 border border-indigo-500/20 relative overflow-hidden group\">\n            <div className=\"absolute -right-4 -top-4 text-indigo-500/10 group-hover:text-indigo-500/20 transition-colors\">\n              <Coins size={64} />\n            </div>\n            <div className=\"relative z-10\">\n              <p className=\"text-[9px] text-indigo-400 font-bold uppercase mb-1\">\n                Impact Tokens (ITK)\n              </p>\n              <p className=\"text-2xl font-black text-white tracking-tight\">\n                {assets.itkBalance.toLocaleString()}\n              </p>\n              <p className=\"text-[9px] text-slate-500 mt-1\">Available to trade</p>\n            </div>\n          </div>\n\n          {/* Locked SROI */}\n          <div className=\"p-4 rounded-xl bg-gradient-to-br from-emerald-500/10 to-teal-500/10 border border-emerald-500/20 relative overflow-hidden group\">\n            <div className=\"absolute -right-4 -top-4 text-emerald-500/10 group-hover:text-emerald-500/20 transition-colors\">\n              <Lock size={64} />\n            </div>\n            <div className=\"relative z-10\">\n              <p className=\"text-[9px] text-emerald-400 font-bold uppercase mb-1\">\n                Locked SROI Value\n              </p>\n              <p className=\"text-2xl font-black text-white tracking-tight\">\n                ${assets.lockedSroiValue.toLocaleString()}k\n              </p>\n              <div className=\"flex items-center gap-1 mt-1\">\n                <ProtocolBadge type=\"immutable\" />\n              </div>\n            </div>\n          </div>\n\n          <div className=\"mt-auto\">\n            <div className=\"flex items-center gap-2 mb-2\">\n              <Fingerprint size={12} className=\"text-slate-600\" />\n              <span className=\"text-[9px] text-slate-600 font-mono\">Hash: 0x8F...3A2</span>\n            </div>\n            <div className=\"h-0.5 w-full bg-slate-900 rounded-full overflow-hidden\">\n              <div className=\"h-full w-full bg-gradient-to-r from-transparent via-slate-700 to-transparent animate-shimmer\" />\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Bottom Bar: 3+1 Status */}\n      <div className=\"h-8 bg-[#030303] border-t border-white/5 flex items-center justify-between px-6\">\n        <div className=\"flex gap-4\">\n          <span className=\"text-[9px] text-slate-600 font-mono flex items-center gap-1\">\n            <div className=\"w-1 h-1 bg-red-500 rounded-full\" /> Immutable\n          </span>\n          <span className=\"text-[9px] text-slate-600 font-mono flex items-center gap-1\">\n            <div className=\"w-1 h-1 bg-emerald-500 rounded-full\" /> Traceable\n          </span>\n        </div>\n        <div className=\"text-[9px] text-slate-700 font-black tracking-widest uppercase\">\n          ESGss JunAiKey Engine v2.0\n        </div>\n      </div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\platform\\SubscriptionPlan.tsx","messages":[{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`\"` can be escaped with `&quot;`, `&ldquo;`, `&#34;`, `&rdquo;`.","line":150,"column":15,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&quot;"},"fix":{"range":[7959,8063],"text":"\n              &quot;Only those who have truly impacted the world may enter the Golden Genesis.\"\n            "},"desc":"Replace with `&quot;`."},{"messageId":"replaceWithAlt","data":{"alt":"&ldquo;"},"fix":{"range":[7959,8063],"text":"\n             