us('SUCCESS');\n      omniLogger.info(LogCategory.SYSTEM, '?? System anchored in Eternal Palace.');\n    } catch (error) {\n      setStatus('IDLE');\n      omniLogger.error(LogCategory.SYSTEM, 'Failed to anchor in Eternal Palace', { error });\n    }\n  };\n\n  return (\n    <div className=\"h-full relative overflow-hidden flex flex-col items-center justify-center p-8 bg-neutral-950 rounded-3xl border border-white/5 shadow-2xl\">\n      {/* Background Ambient Glows */}\n      <div className=\"absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[800px] h-[800px] bg-purple-500/10 rounded-full blur-[120px] pointer-events-none\" />\n      <div className=\"absolute top-0 right-0 w-[400px] h-[400px] bg-blue-500/10 rounded-full blur-[100px] pointer-events-none\" />\n      <div className=\"absolute bottom-0 left-0 w-[400px] h-[400px] bg-amber-500/5 rounded-full blur-[100px] pointer-events-none\" />\n\n      {/* Ritual Header */}\n      <div className=\"text-center z-10 mb-12\">\n        <motion.div\n          initial={{ scale: 0.8, opacity: 0 }}\n          animate={{ scale: 1, opacity: 1 }}\n          className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 text-[10px] font-black tracking-widest uppercase mb-4\"\n        >\n          <Infinity size={12} /> Eternal Connection Protocol\n        </motion.div>\n        <h2 className=\"text-5xl font-black text-white tracking-tighter mb-4\">\n          瘞豢?摰格挪{' '}\n          <span className=\"text-transparent bg-clip-text bg-gradient-to-r from-purple-400 to-amber-400 font-serif italic\">\n            Eternal Palace\n          </span>\n        </h2>\n        <p className=\"max-w-xl mx-auto text-gray-400 text-sm font-medium leading-relaxed\">\n          完整蝛箇?蝯?嚗霅?蝬??航?????閮?????孵?撘?嚗??嗅?驗算?頂蝯梁??偶銋?啣摰???撅斗瑽葉?n        </p>\n      </div>\n\n      {/* Main Ritual Interface */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-8 w-full max-w-6xl z-10\">\n        {/* Left Panel: The Laws */}\n        <div className=\"p-6 rounded-2xl bg-black/40 border border-white/10 backdrop-blur-xl\">\n          <div className=\"flex items-center gap-2 text-purple-400 text-[10px] font-black uppercase tracking-widest mb-6 border-b border-purple-500/20 pb-4\">\n            <Shield size={14} /> Active Universal Laws\n          </div>\n          <div className=\"space-y-4\">\n            {laws.map((law, idx) => (\n              <motion.div\n                key={law.id}\n                initial={{ opacity: 0, x: -20 }}\n                animate={{ opacity: 1, x: 0 }}\n                transition={{ delay: idx * 0.1 }}\n                className=\"group p-3 rounded-xl bg-white/5 border border-white/5 hover:border-purple-500/30 transition-all cursor-crosshair\"\n              >\n                <div className=\"text-[10px] font-bold text-gray-300 mb-1\">{law.name}</div>\n                <div className=\"text-[9px] text-gray-500 font-mono leading-tight\">\n                  {law.id} // ACTIVE\n                </div>\n              </motion.div>\n            ))}\n          </div>\n        </div>\n\n        {/* Center: The Committal Hub */}\n        <div className=\"flex flex-col items-center justify-center p-8\">\n          <AnimatePresence mode=\"wait\">\n            {status === 'IDLE' ? (\n              <motion.button\n                key=\"idle\"\n                whileHover={{ scale: 1.05 }}\n                whileTap={{ scale: 0.95 }}\n                onClick={handleEternalCommittal}\n                className=\"group relative w-48 h-48 rounded-full flex flex-col items-center justify-center gap-4 bg-gradient-to-tr from-purple-600 to-blue-600 shadow-2xl shadow-purple-500/40 p-1\"\n              >\n                <div className=\"w-full h-full rounded-full bg-black/20 backdrop-blur-md flex flex-col items-center justify-center gap-3 border border-white/20\">\n                  <Castle size={48} className=\"text-white group-hover:animate-pulse\" />\n                  <div className=\"text-[10px] font-black text-white tracking-[0.2em] uppercase\">\n                    ?脣摰格挪\n                  </div>\n                </div>\n                {/* Ornamental Orbits */}\n                <div className=\"absolute -inset-4 border border-white/5 rounded-full animate-[spin_10s_linear_infinite]\" />\n                <div className=\"absolute -inset-8 border border-white/5 rounded-full animate-[spin_15s_linear_infinite_reverse]\" />\n              </motion.button>\n            ) : status === 'CONNECTING' ? (\n              <motion.div\n                key=\"connecting\"\n                initial={{ opacity: 0 }}\n                animate={{ opacity: 1 }}\n                className=\"flex flex-col items-center gap-6\"\n              >\n                <div className=\"w-24 h-24 rounded-full border-4 border-purple-500/20 border-t-purple-500 animate-spin\" />\n                <div className=\"text-sm font-black text-purple-400 animate-pulse tracking-widest uppercase\">\n                  Connecting to NCB Apex...\n                </div>\n              </motion.div>\n            ) : status === 'ANCHORING' ? (\n              <motion.div\n                key=\"anchoring\"\n                initial={{ opacity: 0 }}\n                animate={{ opacity: 1 }}\n                className=\"w-full space-y-4\"\n              >\n                <div className=\"text-center text-xs font-black text-blue-400 tracking-widest uppercase\">\n                  COMMITTING AWAKENED STATE: {syncProgress}%\n                </div>\n                <div className=\"w-full h-2 bg-white/5 rounded-full overflow-hidden border border-white/10\">\n                  <motion.div\n                    className=\"h-full bg-gradient-to-r from-blue-500 to-purple-500 shadow-[0_0_20px_rgba(168,85,247,0.5)]\"\n                    initial={{ width: 0 }}\n                    animate={{ width: `${syncProgress}%` }}\n                  />\n                </div>\n                <div className=\"grid grid-cols-2 gap-2\">\n                  <div className=\"text-[8px] text-gray-500 font-mono\">\n                    ENCRYPTING_SOVEREIGN_ENGINE\n                  </div>\n                  <div className=\"text-[8px] text-emerald-500 font-mono text-right\">DONE</div>\n                  <div className=\"text-[8px] text-gray-500 font-mono\">SEALING_BEST_PRACTICES</div>\n                  <div className=\"text-[8px] text-emerald-500 font-mono text-right\">\n                    IN_PROGRESS\n                  </div>\n                </div>\n              </motion.div>\n            ) : (\n              <motion.div\n                key=\"success\"\n                initial={{ scale: 0.8, opacity: 0 }}\n                animate={{ scale: 1, opacity: 1 }}\n                className=\"flex flex-col items-center gap-6\"\n              >\n                <div className=\"w-24 h-24 rounded-full bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shadow-[0_0_40px_rgba(16,185,129,0.2)]\">\n                  <Sparkles size={40} />\n                </div>\n                <div className=\"text-center\">\n                  <div className=\"text-lg font-black text-emerald-400 tracking-tight mb-2 uppercase\">\n                    ANCHORED IN ETERNITY\n                  </div>\n                  <div className=\"text-[10px] text-gray-500 font-mono italic\">\n                    \"The wisdom has found its permanent home.\"\n                  </div>\n                </div>\n                <button\n                  onClick={() => setStatus('IDLE')}\n                  className=\"px-6 py-2 rounded-full border border-white/10 hover:bg-white/5 text-[10px] font-black tracking-widest text-gray-400 uppercase transition-all\"\n                >\n                  Return to Dashboard\n                </button>\n              </motion.div>\n            )}\n          </AnimatePresence>\n        </div>\n\n        {/* Right Panel: Palace Stats */}\n        <div className=\"p-6 rounded-2xl bg-black/40 border border-white/10 backdrop-blur-xl\">\n          <div className=\"flex items-center gap-2 text-blue-400 text-[10px] font-black uppercase tracking-widest mb-6 border-b border-blue-500/20 pb-4\">\n            <History size={14} /> Palace Evolution Metadata\n          </div>\n          <div className=\"space-y-6\">\n            <div className=\"flex justify-between items-end border-b border-white/5 pb-2\">\n              <div className=\"text-[9px] text-gray-500 uppercase font-black\">Memory Integrity</div>\n              <div className=\"text-sm font-black text-white tracking-widest\">99.9%</div>\n            </div>\n            <div className=\"flex justify-between items-end border-b border-white/5 pb-2\">\n              <div className=\"text-[9px] text-gray-500 uppercase font-black\">Sync Latency</div>\n              <div className=\"text-sm font-black text-emerald-400 tracking-widest\">0.04 MS</div>\n            </div>\n            <div className=\"flex justify-between items-end border-b border-white/5 pb-2\">\n              <div className=\"text-[9px] text-gray-500 uppercase font-black\">NCB ID</div>\n              <div className=\"text-sm font-black text-gray-300 tracking-widest font-mono\">\n                JUNAIKEY_V1\n              </div>\n            </div>\n            <div className=\"space-y-2 mt-4\">\n              <div className=\"text-[8px] text-blue-500/60 font-black uppercase tracking-widest\">\n                Active Resonance\n              </div>\n              <div className=\"p-3 rounded-xl bg-blue-500/5 border border-blue-500/10 flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <Gem size={12} className=\"text-blue-400\" />\n                  <div className=\"text-[10px] font-bold text-gray-400\">AMBER-GLOW_HARDENED</div>\n                </div>\n                <ArrowUpRight size={10} className=\"text-blue-500/40\" />\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Footer Ritual Footer */}\n      <motion.div\n        initial={{ opacity: 0 }}\n        animate={{ opacity: 1 }}\n        transition={{ delay: 1 }}\n        className=\"mt-12 text-[8px] text-gray-600 font-mono tracking-[0.4em] uppercase z-10\"\n      >\n        // OMNI-RESONANCE_ESTABLISHED // ETERNAL_PALACE_V1.0_ONLINE //\n      </motion.div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\EvidenceBrowser.tsx","messages":[{"ruleId":"react-hooks/immutability","severity":2,"message":"Error: Cannot access variable before it is declared\n\n`loadEvidence` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\EvidenceBrowser.tsx:35:5\n  33 |\n  34 |   useEffect(() => {\n> 35 |     loadEvidence();\n     |     ^^^^^^^^^^^^ `loadEvidence` accessed before it is declared\n  36 |     omniLogger.info(LogCategory.UI, 'EvidenceBrowser mounted', {\n  37 |       source_origin: 'EvidenceBrowser.useEffect',\n  38 |     });\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\EvidenceBrowser.tsx:41:3\n  39 |   }, []);\n  40 |\n> 41 |   const loadEvidence = () => {\n     |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 42 |     const allEvidence = EvidenceVault.getAllEvidence();\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 43 |     setEvidenceList(allEvidence);\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 44 |     omniLogger.info(LogCategory.KNOWLEDGE, `Loaded ${allEvidence.length} evidence items`, {\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 45 |       source_origin: 'EvidenceBrowser.loadEvidence',\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 46 |     });\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 47 |   };\n     | ^^^^^ `loadEvidence` is declared here\n  48 |\n  49 |   const filteredEvidence = evidenceList.filter(evidence => {\n  50 |     const matchesSearch = searchQuery","line":35,"column":5,"nodeType":null,"endLine":35,"endColumn":17},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 8.","line":153,"column":88,"nodeType":"Literal","messageId":"noMagic","endLine":153,"endColumn":89}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * 🏛️Evidence Browser Component\n * --------------------------------------------------\n * [?] 雿?摨怎汗??- ?冽?亦???歇銝???n * [整合] EvidenceVault, TruthEngine\n * [驗證] 3+1 Protocol (Traceable, Immutable)\n */\n\nimport React, { useState, useEffect } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport {\n  FileText,\n  Search,\n  Download,\n  Shield,\n  Link as LinkIcon,\n  Clock,\n  Hash,\n  User,\n  Filter,\n  CheckCircle,\n  XCircle,\n} from 'lucide-react';\nimport { EvidenceVault } from '@/services/EvidenceVault';\nimport { EvidenceMetadata } from '@/types/omni-report.types';\nimport { omniLogger, LogCategory } from '@/omni/infrastructure/logging/OmniLogger';\n\nexport const EvidenceBrowser: React.FC = () => {\n  const [evidenceList, setEvidenceList] = useState<EvidenceMetadata[]>([]);\n  const [searchQuery, setSearchQuery] = useState('');\n  const [selectedEvidence, setSelectedEvidence] = useState<EvidenceMetadata | null>(null);\n  const [filterWitness, setFilterWitness] = useState<string>('');\n\n  useEffect(() => {\n    loadEvidence();\n    omniLogger.info(LogCategory.UI, 'EvidenceBrowser mounted', {\n      source_origin: 'EvidenceBrowser.useEffect',\n    });\n  }, []);\n\n  const loadEvidence = () => {\n    const allEvidence = EvidenceVault.getAllEvidence();\n    setEvidenceList(allEvidence);\n    omniLogger.info(LogCategory.KNOWLEDGE, `Loaded ${allEvidence.length} evidence items`, {\n      source_origin: 'EvidenceBrowser.loadEvidence',\n    });\n  };\n\n  const filteredEvidence = evidenceList.filter(evidence => {\n    const matchesSearch = searchQuery\n      ? evidence.originalFileName.toLowerCase().includes(searchQuery.toLowerCase())\n      : true;\n    const matchesWitness = filterWitness ? evidence.witness === filterWitness : true;\n    return matchesSearch && matchesWitness;\n  });\n\n  const uniqueWitnesses = Array.from(new Set(evidenceList.map(e => e.witness)));\n\n  const getFileIcon = (mimeType: string) => {\n    if (mimeType.includes('pdf')) return '??';\n    if (mimeType.includes('image')) return '?儭?;\n    if (mimeType.includes('spreadsheet') || mimeType.includes('excel')) return '??';\n    if (mimeType.includes('word') || mimeType.includes('document')) return '??';\n    return '??';\n  };\n\n  return (\n    <div className=\"w-full min-h-screen bg-slate-950 p-6\">\n      {/* Header */}\n      <div className=\"frosted-panel rounded-2xl p-6 mb-6 border border-cyan-500/20 neon-border-cyan\">\n        <div className=\"flex items-center justify-between mb-4\">\n          <div className=\"flex items-center gap-3\">\n            <div className=\"w-14 h-14 rounded-2xl bg-gradient-to-br from-cyan-500 to-blue-600 flex items-center justify-center shadow-lg shadow-cyan-500/30\">\n              <Shield size={28} className=\"text-white\" />\n            </div>\n            <div>\n              <h1 className=\"text-3xl font-bold text-white tracking-tight\">\n                🏛️雿?摨?Evidence Vault\n              </h1>\n              <p className=\"text-sm text-slate-400\">\n                ???嗡??喟??格???舫?霅???靘? (3+1 Protocol)\n              </p>\n            </div>\n          </div>\n          <div className=\"text-right\">\n            <p className=\"text-2xl font-bold text-cyan-400\">{filteredEvidence.length}</p>\n            <p className=\"text-xs text-slate-500\">Total Evidence</p>\n          </div>\n        </div>\n\n        {/* Search & Filter */}\n        <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n          <div className=\"relative\">\n            <Search className=\"absolute left-3 top-1/2 -translate-y-1/2 text-slate-500\" size={18} />\n            <input\n              type=\"search\"\n              placeholder=\"??霅??辣?迂...\"\n              value={searchQuery}\n              onChange={e => setSearchQuery(e.target.value)}\n              className=\"w-full pl-10 pr-4 py-3 bg-slate-800/50 border border-slate-700 rounded-xl text-white placeholder-slate-500 focus:border-cyan-500 focus:outline-none transition-colors\"\n            />\n          </div>\n          <div className=\"relative\">\n            <Filter className=\"absolute left-3 top-1/2 -translate-y-1/2 text-slate-500\" size={18} />\n            <select\n              value={filterWitness}\n              onChange={e => setFilterWitness(e.target.value)}\n              className=\"w-full pl-10 pr-4 py-3 bg-slate-800/50 border border-slate-700 rounded-xl text-white focus:border-cyan-500 focus:outline-none transition-colors appearance-none\"\n            >\n              <option value=\"\">????(All Witnesses)</option>\n              {uniqueWitnesses.map(witness => (\n                <option key={witness} value={witness}>\n                  {witness}\n                </option>\n              ))}\n            </select>\n          </div>\n        </div>\n      </div>\n\n      {/* Evidence Timeline */}\n      <div className=\"space-y-4\">\n        {filteredEvidence.length === 0 ? (\n          <div className=\"frosted-panel rounded-2xl p-12 text-center border border-slate-800\">\n            <FileText size={48} className=\"text-slate-600 mx-auto mb-4\" />\n            <p className=\"text-slate-400\">\n              {searchQuery || filterWitness ? '?芣?啣??霅?' : '撠銝霅?'}\n            </p>\n          </div>\n        ) : (\n          filteredEvidence.map(evidence => (\n            <motion.div\n              key={evidence.id}\n              initial={{ opacity: 0, y: 20 }}\n              animate={{ opacity: 1, y: 0 }}\n              className=\"frosted-panel rounded-2xl p-5 border border-slate-800 hover:border-cyan-500/30 transition-all cursor-pointer group\"\n              onClick={() => setSelectedEvidence(evidence)}\n            >\n              <div className=\"flex items-start gap-4\">\n                {/* File Icon */}\n                <div className=\"w-14 h-14 rounded-xl bg-slate-800 flex items-center justify-center text-3xl group-hover:scale-110 transition-transform\">\n                  {getFileIcon(evidence.mimeType)}\n                </div>\n\n                {/* Evidence Info */}\n                <div className=\"flex-1 min-w-0\">\n                  <h3 className=\"text-lg font-semibold text-white truncate group-hover:text-cyan-400 transition-colors\">\n                    {evidence.originalFileName}\n                  </h3>\n                  <div className=\"grid grid-cols-2 md:grid-cols-4 gap-3 mt-2 text-sm\">\n                    <div className=\"flex items-center gap-2 text-slate-400\">\n                      <Hash size={14} className=\"text-cyan-500\" />\n                      <span className=\"font-mono truncate\">{evidence.fileHash.slice(0, 8)}...</span>\n                    </div>\n                    <div className=\"flex items-center gap-2 text-slate-400\">\n                      <User size={14} className=\"text-green-500\" />\n                      <span>{evidence.witness}</span>\n                    </div>\n                    <div className=\"flex items-center gap-2 text-slate-400\">\n                      <Clock size={14} className=\"text-purple-500\" />\n                      <span>{new Date(evidence.uploadedAt).toLocaleDateString('zh-TW')}</span>\n                    </div>\n                    <div className=\"flex items-center gap-2 text-slate-400\">\n                      <LinkIcon size={14} className=\"text-indigo-500\" />\n                      <span>{evidence.linkedTruthClaims?.length || 0} Truth Claims</span>\n                    </div>\n                  </div>\n\n                  {/* Vault Path */}\n                  <div className=\"mt-2 px-3 py-1.5 bg-slate-800/50 rounded-lg inline-block\">\n                    <p className=\"text-xs text-slate-500 font-mono truncate max-w-md\">\n                      ? {evidence.vaultPath}\n                    </p>\n                  </div>\n                </div>\n\n                {/* Status Badge */}\n                <div>\n                  {evidence.blockchainTxHash ? (\n                    <div className=\"flex items-center gap-1.5 px-3 py-1.5 bg-green-500/10 border border-green-500/30 rounded-lg\">\n                      <CheckCircle size={14} className=\"text-green-400\" />\n                      <span className=\"text-xs text-green-400 font-medium\">Anchored</span>\n                    </div>\n                  ) : (\n                    <div className=\"flex items-center gap-1.5 px-3 py-1.5 bg-slate-800/50 border border-slate-700 rounded-lg\">\n                      <XCircle size={14} className=\"text-slate-500\" />\n                      <span className=\"text-xs text-slate-500 font-medium\">Local Only</span>\n                    </div>\n                  )}\n                </div>\n              </div>\n            </motion.div>\n          ))\n        )}\n      </div>\n\n      {/* Detail Modal */}\n      <AnimatePresence>\n        {selectedEvidence && (\n          <motion.div\n            initial={{ opacity: 0 }}\n            animate={{ opacity: 1 }}\n            exit={{ opacity: 0 }}\n            className=\"fixed inset-0 bg-black/70 flex items-center justify-center z-50 p-4 backdrop-blur-sm\"\n            onClick={() => setSelectedEvidence(null)}\n          >\n            <motion.div\n              initial={{ scale: 0.9, y: 20 }}\n              animate={{ scale: 1, y: 0 }}\n              exit={{ scale: 0.9, y: 20 }}\n              className=\"frosted-panel rounded-2xl p-6 max-w-2xl w-full border border-cyan-500/30 neon-border-cyan\"\n              onClick={e => e.stopPropagation()}\n            >\n              <div className=\"flex items-center justify-between mb-4\">\n                <h2 className=\"text-xl font-bold text-white\">霅?閰單? Evidence Details</h2>\n                <button\n                  onClick={() => setSelectedEvidence(null)}\n                  className=\"p-2 hover:bg-slate-800 rounded-lg transition-colors text-slate-400\"\n                >\n                  ?n                </button>\n              </div>\n\n              <div className=\"space-y-4\">\n                {/* File Name */}\n                <div>\n                  <label className=\"text-xs text-slate-500 mb-1 block\">?辣?迂</label>\n                  <p className=\"text-white font-medium\">{selectedEvidence.originalFileName}</p>\n                </div>\n\n                {/* Hash Lock */}\n                <div>\n                  <label className=\"text-xs text-slate-500 mb-1 block\">\n                    ?? Hash Lock (Immutable)\n                  </label>\n                  <p className=\"text-cyan-400 font-mono text-sm bg-slate-900/50 px-3 py-2 rounded-lg break-all\">\n                    {selectedEvidence.fileHash}\n                  </p>\n                </div>\n\n                {/* Metadata */}\n                <div className=\"grid grid-cols-2 gap-4\">\n                  <div>\n                    <label className=\"text-xs text-slate-500 mb-1 block\">銝??Witness</label>\n                    <p className=\"text-white\">{selectedEvidence.witness}</p>\n                  </div>\n                  <div>\n                    <label className=\"text-xs text-slate-500 mb-1 block\">銝??</label>\n                    <p className=\"text-white\">\n                      {new Date(selectedEvidence.uploadedAt).toLocaleString('zh-TW')}\n                    </p>\n                  </div>\n                </div>\n\n                {/* Vault Path */}\n                <div>\n                  <label className=\"text-xs text-slate-500 mb-1 block\">摮頝臬? Vault Path</label>\n                  <p className=\"text-slate-400 font-mono text-sm bg-slate-900/50 px-3 py-2 rounded-lg break-all\">\n                    {selectedEvidence.vaultPath}\n                  </p>\n                </div>\n\n                {/* Linked Truth Claims */}\n                {selectedEvidence.linkedTruthClaims &&\n                  selectedEvidence.linkedTruthClaims.length > 0 && (\n                    <div>\n                      <label className=\"text-xs text-slate-500 mb-1 block\">\n                        ???摰?迂 Linked Truth Claims\n                      </label>\n                      <div className=\"space-y-2\">\n                        {selectedEvidence.linkedTruthClaims.map((claimId: string) => (\n                          <div\n                            key={claimId}\n                            className=\"px-3 py-2 bg-indigo-500/10 border border-indigo-500/30 rounded-lg\"\n                          >\n                            <p className=\"text-indigo-400 font-mono text-sm\">{claimId}</p>\n                          </div>\n                        ))}\n                      </div>\n                    </div>\n                  )}\n\n                {/* Blockchain Status */}\n                <div>\n                  <label className=\"text-xs text-slate-500 mb-1 block\">?憛??典????/label>\n                  {selectedEvidence.blockchainTxHash ? (\n                    <div className=\"flex items-center gap-2 px-3 py-2 bg-green-500/10 border border-green-500/30 rounded-lg\">\n                      <CheckCircle size={16} className=\"text-green-400\" />\n                      <span className=\"text-green-400 font-mono text-sm\">\n                        {selectedEvidence.blockchainTxHash}\n                      </span>\n                    </div>\n                  ) : (\n                    <div className=\"flex items-center gap-2 px-3 py-2 bg-slate-800/50 border border-slate-700 rounded-lg\">\n                      <XCircle size={16} className=\"text-slate-500\" />\n                      <span className=\"text-slate-400 text-sm\">?芷摰?(Local Storage Only)</span>\n                    </div>\n                  )}\n                </div>\n\n                {/* Action Buttons */}\n                <div className=\"flex gap-3 pt-4 border-t border-slate-800\">\n                  <button className=\"flex-1 flex items-center justify-center gap-2 px-4 py-3 bg-cyan-500/20 border border-cyan-500/30 rounded-xl text-cyan-400 hover:bg-cyan-500/30 transition-colors\">\n                    <Download size={16} />\n                    銝????辣\n                  </button>\n                  <button className=\"flex-1 flex items-center justify-center gap-2 px-4 py-3 bg-indigo-500/20 border border-indigo-500/30 rounded-xl text-indigo-400 hover:bg-indigo-500/30 transition-colors\">\n                    <Shield size={16} />\n                    撽?摰?吭n                  </button>\n                </div>\n              </div>\n            </motion.div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n};\n\nexport default EvidenceBrowser;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\EvidenceVault.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\EvidenceVaultDashboard.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5000.","line":35,"column":46,"nodeType":"Literal","messageId":"noMagic","endLine":35,"endColumn":50},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 8.","line":117,"column":44,"nodeType":"Literal","messageId":"noMagic","endLine":117,"endColumn":45}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport { evidenceVault } from '../../omni/services/EvidenceVaultService';\nimport { IComponentCore, Language } from '@/types/core';\nimport { ShieldCheck, Hash, GitCommit, Activity, Search, Database, Lock, Eye } from 'lucide-react';\n\ninterface EvidenceVaultDashboardProps {\n  language?: Language;\n}\n\n/**\n * ?儭?雿?摨怠?銵冽 (Evidence Vault Dashboard)\n * --------------------------------------------------\n * ?航????暹?????5T 撽???Immutable Assets?n * 憸冽嚗yber-Security / Digital Vault / Blockchain Ledger\n */\nexport const EvidenceVaultDashboard: React.FC<EvidenceVaultDashboardProps> = ({\n  language = 'zh-TW',\n}) => {\n  const isZh = language === 'zh-TW';\n  const [assets, setAssets] = useState<IComponentCore[]>([]);\n  const [selectedAsset, setSelectedAsset] = useState<IComponentCore | null>(null);\n  const [searchTerm, setSearchTerm] = useState('');\n\n  // Load assets from service\n  useEffect(() => {\n    const loadAssets = () => {\n      const all = evidenceVault.getAllAssets();\n      // Sort by latest\n      setAssets([...all].sort((a, b) => (b.timestamp || 0) - (a.timestamp || 0)));\n    };\n\n    loadAssets();\n    // Set up interval for live updates\n    const interval = setInterval(loadAssets, 5000);\n    return () => clearInterval(interval);\n  }, []);\n\n  const filteredAssets = assets.filter(\n    a =>\n      a.uuid.toLowerCase().includes(searchTerm.toLowerCase()) ||\n      a.evidence.source_origin.toLowerCase().includes(searchTerm.toLowerCase())\n  );\n\n  return (\n    <div className=\"w-full h-full min-h-screen p-4 md:p-8 space-y-8\">\n      {/* Header */}\n      <div className=\"flex flex-col md:flex-row justify-between items-start md:items-end gap-4\">\n        <div>\n          <h1 className=\"text-3xl md:text-4xl font-extralight text-transparent bg-clip-text bg-gradient-to-r from-emerald-300 via-cyan-200 to-slate-400 mb-2\">\n            EVIDENCE <span className=\"font-bold text-emerald-400\">VAULT</span>\n          </h1>\n          <p className=\"text-slate-400 text-sm md:text-base flex items-center gap-2\">\n            <ShieldCheck className=\"w-4 h-4 text-emerald-500\" />\n            {isZh ? '撌脤?霅??舐砥?寞?澈' : 'Verified Immutable Ledger'}\n          </p>\n        </div>\n\n        {/* Stats */}\n        <div className=\"flex gap-4\">\n          <div className=\"glass-panel-premium px-6 py-3 flex items-center gap-4\">\n            <div className=\"p-2 bg-emerald-500/10 rounded-lg\">\n              <Database className=\"w-6 h-6 text-emerald-400\" />\n            </div>\n            <div>\n              <p className=\"text-xs text-slate-400 uppercase tracking-wider\">\n                {isZh ? '蝮質??? : 'Total Assets'}\n              </p>\n              <p className=\"text-2xl font-bold text-slate-200\">{assets.length}</p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Search & Filter */}\n      <div className=\"glass-panel-premium p-4 flex items-center gap-3\">\n        <Search className=\"w-5 h-5 text-slate-500\" />\n        <input\n          type=\"text\"\n          placeholder={isZh ? '??鞈 UUID ??皞?..' : 'Search asset UUID or origin...'}\n          className=\"bg-transparent border-none outline-none text-slate-200 placeholder-slate-600 flex-1\"\n          value={searchTerm}\n          onChange={e => setSearchTerm(e.target.value)}\n        />\n      </div>\n\n      {/* Main Content: Split View */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-12 gap-6 h-[600px]\">\n        {/* Left: Asset List (Ledger) */}\n        <div className=\"lg:col-span-5 glass-panel-premium overflow-hidden flex flex-col\">\n          <div className=\"p-4 border-b border-white/5 bg-slate-900/50 backdrop-blur-md\">\n            <h3 className=\"text-sm font-medium text-slate-300 flex items-center gap-2\">\n              <Activity className=\"w-4 h-4 text-cyan-400\" />\n              {isZh ? '?餈漱??(Recent Transactions)' : 'Recent Transactions'}\n            </h3>\n          </div>\n          <div className=\"flex-1 overflow-y-auto p-2 space-y-2 custom-scrollbar\">\n            {filteredAssets.length === 0 ? (\n              <div className=\"h-full flex flex-col items-center justify-center text-slate-500\">\n                <Search className=\"w-8 h-8 mb-2 opacity-50\" />\n                <p>{isZh ? '?亦符合鞈' : 'No assets found'}</p>\n              </div>\n            ) : (\n              filteredAssets.map(asset => (\n                <motion.div\n                  key={asset.uuid}\n                  layoutId={asset.uuid}\n                  onClick={() => setSelectedAsset(asset)}\n                  className={`p-4 rounded-xl cursor-pointer border transition-all duration-300 ${\n                    selectedAsset?.uuid === asset.uuid\n                      ? 'bg-emerald-900/20 border-emerald-500/50 shadow-[0_0_15px_rgba(16,185,129,0.1)]'\n                      : 'bg-white/5 border-transparent hover:bg-white/10 hover:border-white/10'\n                  }`}\n                >\n                  <div className=\"flex justify-between items-start mb-2\">\n                    <span className=\"text-[10px] bg-slate-800 text-slate-400 px-2 py-0.5 rounded-full font-mono\">\n                      {asset.uuid.slice(0, 8)}\n                    </span>\n                    <span className=\"text-[10px] text-slate-500\">\n                      {new Date(asset.timestamp).toLocaleTimeString(isZh ? 'zh-TW' : 'en-US')}\n                    </span>\n                  </div>\n                  <h4 className=\"text-sm font-medium text-slate-200 mb-1\">\n                    {asset.evidence.source_origin}\n                  </h4>\n                  <div className=\"flex gap-2 mt-2\">\n                    <span className=\"text-[10px] flex items-center gap-1 text-emerald-400/80 bg-emerald-900/20 px-1.5 py-0.5 rounded\">\n                      <ShieldCheck className=\"w-3 h-3\" /> 5T-Verified\n                    </span>\n                    {asset.evidence.hash_lock && (\n                      <span className=\"text-[10px] flex items-center gap-1 text-amber-400/80 bg-amber-900/20 px-1.5 py-0.5 rounded\">\n                        <Lock className=\"w-3 h-3\" /> Sealed\n                      </span>\n                    )}\n                  </div>\n                </motion.div>\n              ))\n            )}\n          </div>\n        </div>\n\n        {/* Right: Asset Detail (Inspector) */}\n        <div className=\"lg:col-span-7\">\n          <AnimatePresence mode=\"wait\">\n            {selectedAsset ? (\n              <motion.div\n                key={selectedAsset.uuid}\n                initial={{ opacity: 0, scale: 0.95 }}\n                animate={{ opacity: 1, scale: 1 }}\n                exit={{ opacity: 0, scale: 0.9 }}\n                className=\"h-full glass-panel-premium p-8 relative overflow-hidden flex flex-col\"\n              >\n                {/* Decorative BG */}\n                <div className=\"absolute top-0 right-0 w-64 h-64 bg-emerald-500/5 rounded-full blur-[80px] pointer-events-none\" />\n\n                <div className=\"flex items-center gap-4 mb-8\">\n                  <div className=\"w-16 h-16 rounded-full bg-gradient-to-br from-emerald-500/20 to-cyan-500/20 border border-emerald-500/30 flex items-center justify-center\">\n                    <ShieldCheck className=\"w-8 h-8 text-emerald-400\" />\n                  </div>\n                  <div>\n                    <h2 className=\"text-xl font-bold text-slate-200\">\n                      {(selectedAsset as any).asset_type || (isZh ? '?鞈' : 'Generic Asset')}\n                    </h2>\n                    <p className=\"text-emerald-400 font-mono text-sm\">{selectedAsset.uuid}</p>\n                  </div>\n                </div>\n\n                {/* 5T Grid */}\n                <div className=\"grid grid-cols-2 gap-4 mb-8\">\n                  <div className=\"bg-slate-900/50 p-4 rounded-xl border border-white/5\">\n                    <h4 className=\"text-xs text-slate-500 uppercase mb-2 flex items-center gap-2\">\n                      <GitCommit className=\"w-3 h-3\" /> {isZh ? '?舀滲皞? : 'Traceability'}\n                    </h4>\n                    <p className=\"text-sm text-slate-300\">{selectedAsset.evidence.source_origin}</p>\n                  </div>\n                  <div className=\"bg-slate-900/50 p-4 rounded-xl border border-white/5\">\n                    <h4 className=\"text-xs text-slate-500 uppercase mb-2 flex items-center gap-2\">\n                      <Activity className=\"w-3 h-3\" /> {isZh ? '?航蕭頦芣? : 'Trackability'}\n                    </h4>\n                    <p className=\"text-sm text-slate-300\">\n                      ID: {selectedAsset.evidence.lifecycle_hooks.length} Hooks\n                    </p>\n                  </div>\n                  <div className=\"bg-slate-900/50 p-4 rounded-xl border border-white/5\">\n                    <h4 className=\"text-xs text-slate-500 uppercase mb-2 flex items-center gap-2\">\n                      <Eye className=\"w-3 h-3\" /> {isZh ? '透明摨? : 'Transparency'}\n                    </h4>\n                    <p className=\"text-sm text-slate-300 font-mono text-xs truncate\">\n                      {selectedAsset.evidence.logic_formula ||\n                        (isZh ? '定義驗證' : 'Standard Protocol')}\n                    </p>\n                  </div>\n                  <div className=\"bg-slate-900/50 p-4 rounded-xl border border-emerald-500/20 relative overflow-hidden\">\n                 