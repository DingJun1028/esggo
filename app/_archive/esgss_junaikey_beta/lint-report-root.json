: e.target.value }))}\n                  className=\"w-full pl-12 pr-4 py-4 bg-slate-950/50 border border-slate-800 rounded-2xl text-white placeholder-slate-600 focus:outline-none focus:border-cyan-500/50 focus:ring-4 focus:ring-cyan-500/10 transition-all\"\n                  placeholder=\"agent@esgss.com\"\n                  required\n                />\n              </div>\n            </div>\n\n            <div className=\"space-y-2\">\n              <label className=\"text-xs font-bold text-slate-500 uppercase ml-1 tracking-widest\">\n                Passphrase\n              </label>\n              <div className=\"relative group\">\n                <div className=\"absolute left-4 top-1/2 transform -translate-y-1/2 text-slate-500 group-focus-within:text-cyan-400 transition-colors\">\n                  <Lock size={18} />\n                </div>\n                <input\n                  type=\"password\"\n                  value={formData.password}\n                  onChange={e => setFormData(prev => ({ ...prev, password: e.target.value }))}\n                  className=\"w-full pl-12 pr-4 py-4 bg-slate-950/50 border border-slate-800 rounded-2xl text-white placeholder-slate-600 focus:outline-none focus:border-cyan-500/50 focus:ring-4 focus:ring-cyan-500/10 transition-all\"\n                  placeholder=\"?ＴＴＴＴＴＴＴ兝"\n                  required\n                />\n              </div>\n            </div>\n\n            <button\n              type=\"submit\"\n              disabled={loading}\n              className=\"w-full py-4 mt-4 bg-white text-slate-950 font-bold rounded-2xl hover:bg-cyan-50 transition-all active:scale-[0.98] disabled:opacity-50 shadow-[0_0_20px_rgba(255,255,255,0.1)] group overflow-hidden relative\"\n            >\n              <span className=\"relative z-10 flex items-center justify-center gap-2\">\n                {loading ? 'AUTHENTICATING...' : 'JACK IN'}\n              </span>\n            </button>\n          </form>\n\n          <div className=\"mt-8 pt-6 border-t border-slate-800\">\n            <button\n              type=\"button\"\n              onClick={quickAccess}\n              disabled={loading}\n              className=\"w-full py-3 bg-gradient-to-r from-cyan-600/20 to-blue-600/20 border border-cyan-500/30 text-cyan-400 font-bold rounded-2xl hover:from-cyan-600/30 hover:to-blue-600/30 transition-all flex items-center justify-center gap-3 group relative overflow-hidden\"\n            >\n              <div className=\"absolute inset-0 bg-gradient-to-r from-transparent via-white/5 to-transparent translate-x-[-100%] group-hover:translate-x-[100%] transition-transform duration-1000\" />\n              <span className=\"text-sm tracking-widest\">??Quick Access (DEMO)</span>\n            </button>\n            <p className=\"text-slate-600 text-[10px] text-center mt-3 font-mono tracking-widest uppercase\">\n              Direct access for inspection purposes\n            </p>\n          </div>\n        </div>\n\n        {/* Footer Credits */}\n        <div className=\"mt-10 flex flex-col items-center gap-4 text-slate-500\">\n          <p className=\"text-[10px] tracking-[0.4em] font-light uppercase\">\n            穢 2026 ESGss JunAiKey System 繚 All Rights Reserved\n          </p>\n        </div>\n      </motion.div>\n\n      <style>{`\n                @keyframes pulse-slow {\n                    0%, 100% { opacity: 0.1; }\n                    50% { opacity: 0.3; }\n                }\n                .animate-pulse-slow {\n                    animation: pulse-slow 8s ease-in-out infinite;\n                }\n            `}</style>\n    </div>\n  );\n};\n\nexport const UserPassportPage: React.FC = () => {\n  const { user, updatePassport } = useAuth();\n  const [isEditing, setIsEditing] = useState(false);\n  const [formData, setFormData] = useState(user);\n\n  if (!user) return null;\n\n  const saveChanges = () => {\n    if (formData) {\n      updatePassport(formData);\n      setIsEditing(false);\n    }\n  };\n\n  return (\n    <div className=\"p-6 bg-gradient-to-br from-slate-50 to-slate-100 min-h-screen\">\n      <motion.div\n        initial={{ opacity: 0, y: 20 }}\n        animate={{ opacity: 1, y: 0 }}\n        className=\"max-w-4xl mx-auto\"\n      >\n        <h1 className=\"text-3xl font-bold text-slate-800 mb-8\">User Passport</h1>\n\n        <div className=\"bg-white rounded-2xl shadow-lg p-8 mb-6\">\n          <div className=\"flex items-start justify-between mb-6\">\n            <div className=\"flex items-center gap-4\">\n              <div className=\"w-20 h-20 bg-gradient-to-br from-blue-400 to-green-400 rounded-full flex items-center justify-center text-white text-2xl font-bold\">\n                {user.name[0]}\n              </div>\n              <div>\n                <h2 className=\"text-2xl font-bold text-slate-800\">{user.name}</h2>\n                <p className=\"text-slate-600\">{user.title}</p>\n              </div>\n            </div>\n            <button\n              type=\"button\"\n              onClick={() => (isEditing ? saveChanges() : setIsEditing(true))}\n              className=\"px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700\"\n            >\n              {isEditing ? 'Save' : 'Edit'}\n            </button>\n          </div>\n\n          <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n            <DataField\n              icon={<Mail />}\n              label=\"Email\"\n              content={user.email}\n              isEditing={isEditing}\n              onChange={value => setFormData(prev => (prev ? { ...prev, email: value } : null))}\n            />\n            <DataField\n              icon={<Phone />}\n              label=\"Phone\"\n              content={user.phone}\n              isEditing={isEditing}\n              onChange={value => setFormData(prev => (prev ? { ...prev, phone: value } : null))}\n            />\n            <DataField\n              icon={<Building />}\n              label=\"Company\"\n              content={user.company}\n              isEditing={isEditing}\n              onChange={value => setFormData(prev => (prev ? { ...prev, company: value } : null))}\n            />\n            <DataField\n              icon={<MapPin />}\n              label=\"Address\"\n              content={user.address}\n              isEditing={isEditing}\n              onChange={value => setFormData(prev => (prev ? { ...prev, address: value } : null))}\n            />\n          </div>\n        </div>\n\n        <div className=\"bg-white rounded-2xl shadow-lg p-8\">\n          <h3 className=\"text-xl font-bold text-slate-800 mb-4\">ESG Profile</h3>\n          <div className=\"space-y-4\">\n            <div>\n              <div className=\"flex items-center justify-between mb-2\">\n                <span className=\"text-slate-700\">Knowledge Level</span>\n                <span className=\"text-2xl font-bold text-blue-600\">\n                  {user.esgProfile.knowledgeLevel}\n                </span>\n              </div>\n              <div className=\"w-full bg-slate-200 rounded-full h-3\">\n                <div\n                  className=\"h-3 bg-gradient-to-r from-blue-400 to-green-400 rounded-full\"\n                  style={{ width: `${user.esgProfile.knowledgeLevel}%` }}\n                />\n              </div>\n            </div>\n            <div>\n              <span className=\"text-slate-700 block mb-2\">Interest Tags</span>\n              <div className=\"flex flex-wrap gap-2\">\n                {user.esgProfile.interests.map((tag, index) => (\n                  <span\n                    key={index}\n                    className=\"px-3 py-1 bg-blue-100 text-blue-800 rounded-full text-sm\"\n                  >\n                    #{tag}\n                  </span>\n                ))}\n              </div>\n            </div>\n          </div>\n        </div>\n      </motion.div>\n    </div>\n  );\n};\n\nconst DataField: React.FC<{\n  icon: React.ReactNode;\n  label: string;\n  content: string;\n  isEditing: boolean;\n  onChange: (value: string) => void;\n}> = ({ icon, label, content, isEditing, onChange }) => (\n  <div className=\"flex items-start gap-3\">\n    <div className=\"p-2 bg-slate-100 rounded-lg text-slate-600\">{icon}</div>\n    <div className=\"flex-1\">\n      <div className=\"text-sm text-slate-600 mb-1\">{label}</div>\n      {isEditing ? (\n        <input\n          type=\"text\"\n          value={content}\n          onChange={e => onChange(e.target.value)}\n          className=\"w-full px-3 py-2 border border-slate-300 rounded-lg\"\n        />\n      ) : (\n        <div className=\"text-slate-800 font-medium\">{content}</div>\n      )}\n    </div>\n  </div>\n);\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\automation\\AuditExceptionPanel.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":29,"column":53,"nodeType":"Literal","messageId":"noMagic","endLine":29,"endColumn":54}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport { AlertTriangle, RefreshCw, Edit3, ArrowRight, Activity } from 'lucide-react';\n\n/**\n * ? 奧秘 UI ?辣嚗里?貊撣貉那?琿?璞n * --------------------------------------------------\n * [驗證] ?? ?舫?蝞?(Calculable) ?啣虜邏輯\n */\ninterface AuditExceptionProps {\n  indicator: string; // 靘?: GRI 305-1\n  expectedValue: number; // 系統?寞??砍?蝞?迤蝣箏墦n  aiValue: number; // AI 完整鈭葉撖怠??墦n  unit: string;\n  formula: string; // 雿輻??蝞撘n  sourceRef: string; // ??數據撘頝臬?\n  onResolve?: (action: 'auto' | 'manual') => void;\n}\n\nexport const AuditExceptionPanel: React.FC<AuditExceptionProps> = ({\n  indicator,\n  expectedValue,\n  aiValue,\n  unit,\n  formula,\n  sourceRef,\n  onResolve,\n}) => {\n  const delta = (((aiValue - expectedValue) / expectedValue) * 100).toFixed(2);\n  const isHighDelta = Math.abs(parseFloat(delta)) > 5;\n\n  return (\n    <div className=\"bg-slate-900/90 border-2 border-red-500/30 rounded-2xl p-6 backdrop-blur-xl shadow-2xl max-w-2xl w-full overflow-hidden relative\">\n      {/* 鋆ˇ?扯??舀???*/}\n      <div className=\"absolute top-0 right-0 w-32 h-32 bg-red-500/5 rounded-full blur-3xl -mr-16 -mt-16\"></div>\n\n      {/* ?啣虜璅 */}\n      <div className=\"flex items-center gap-4 mb-8\">\n        <div className=\"bg-red-500/20 p-3 rounded-2xl border border-red-500/40\">\n          <AlertTriangle className=\"text-red-500\" size={28} />\n        </div>\n        <div>\n          <div className=\"flex items-center gap-2\">\n            <h4 className=\"text-xl font-black text-slate-100 italic tracking-tighter\">\n              AUDIT EXCEPTION\n            </h4>\n            <span className=\"bg-red-500/20 text-red-400 text-[10px] px-2 py-0.5 rounded-full font-bold border border-red-500/20 underline decoration-red-500/40\">\n              CALCULATION_BREACH\n            </span>\n          </div>\n          <p className=\"text-sm text-slate-500 font-mono mt-0.5\">\n            {indicator} | {sourceRef}\n          </p>\n        </div>\n      </div>\n\n      {/* 數據撠?蝬脫 */}\n      <div className=\"grid grid-cols-2 gap-6 mb-8\">\n        <div className=\"relative group\">\n          <div className=\"absolute inset-0 bg-emerald-500/10 rounded-2xl blur-xl group-hover:bg-emerald-500/20 transition-all opacity-0 group-hover:opacity-100\"></div>\n          <div className=\"relative bg-slate-800/50 p-5 rounded-2xl border border-slate-700/50 hover:border-emerald-500/30 transition-all\">\n            <div className=\"flex justify-between items-start mb-2\">\n              <span className=\"text-[10px] text-slate-500 font-bold uppercase tracking-widest\">\n                系統????(Truth)\n              </span>\n              <Activity size={12} className=\"text-emerald-500\" />\n            </div>\n            <div className=\"flex items-baseline gap-2\">\n              <div className=\"text-3xl font-mono font-black text-emerald-400 tracking-tighter\">\n                {expectedValue}\n              </div>\n              <span className=\"text-xs text-emerald-500/70 font-bold\">{unit}</span>\n            </div>\n            <div className=\"mt-4 p-2 bg-slate-900/50 rounded-lg text-[10px] text-slate-500 font-mono leading-relaxed border border-slate-800\">\n              Logic: {formula}\n            </div>\n          </div>\n        </div>\n\n        <div className=\"relative group\">\n          <div className=\"absolute inset-0 bg-red-500/10 rounded-2xl blur-xl group-hover:bg-red-500/20 transition-all opacity-0 group-hover:opacity-100\"></div>\n          <div className=\"relative bg-slate-800/50 p-5 rounded-2xl border border-red-900/20 hover:border-red-500/30 transition-all\">\n            <div className=\"flex justify-between items-start mb-2\">\n              <span className=\"text-[10px] text-slate-500 font-bold uppercase tracking-widest\">\n                AI 多元核心撟餉死 (Delta)\n              </span>\n              <span\n                className={`text-[10px] font-black px-1.5 py-0.5 rounded ${isHighDelta ? 'bg-red-500 text-white' : 'bg-orange-500/20 text-orange-400'}`}\n              >\n                {delta}%\n              </span>\n            </div>\n            <div className=\"flex items-baseline gap-2\">\n              <div className=\"text-3xl font-mono font-black text-red-500 tracking-tighter\">\n                {aiValue}\n              </div>\n              <span className=\"text-xs text-red-500/70 font-bold\">{unit}</span>\n            </div>\n            <div className=\"mt-4 flex flex-col gap-1\">\n              <div className=\"h-1 w-full bg-slate-700 rounded-full overflow-hidden\">\n                <div\n                  className=\"h-full bg-red-500 animate-pulse\"\n                  style={{ width: `${Math.min(Math.abs(parseFloat(delta)), 100)}%` }}\n                ></div>\n              </div>\n              <span className=\"text-[9px] text-red-400 italic font-medium\">\n                Critical verification failure detected.\n              </span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* ?芰?銵????*/}\n      <div className=\"space-y-3\">\n        <button\n          onClick={() => onResolve?.('auto')}\n          className=\"w-full bg-emerald-600 hover:bg-emerald-500 text-white py-4 rounded-2xl font-black text-sm flex items-center justify-center gap-3 transition-all shadow-[0_4px_20px_rgba(16,185,129,0.25)] group\"\n        >\n          <RefreshCw\n            size={18}\n            className=\"group-hover:rotate-180 transition-transform duration-500\"\n          />\n          銝?菔??撘瑕?郊???潔蒂靽格迤??\n          <ArrowRight\n            size={14}\n            className=\"opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all\"\n          />\n        </button>\n\n        <div className=\"grid grid-cols-2 gap-3\">\n          <button\n            onClick={() => onResolve?.('manual')}\n            className=\"bg-slate-800 hover:bg-slate-700 text-slate-200 py-3 rounded-2xl font-bold text-xs flex items-center justify-center gap-2 border border-slate-700 transition-all\"\n          >\n            <Edit3 size={14} /> ?脣 LangGraph ??撟脤?\n          </button>\n          <button className=\"bg-slate-800/50 text-slate-500 py-3 rounded-2xl font-bold text-xs flex items-center justify-center gap-2 border border-slate-700/50 cursor-not-allowed\">\n            ?急?敹賜 (Risk+1)\n          </button>\n        </div>\n      </div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\automation\\AuditProgressBar.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\awakening\\AwakeningEventTimeline.tsx","messages":[{"ruleId":"react-hooks/immutability","severity":2,"message":"Error: Cannot access variable before it is declared\n\n`addEvent` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\awakening\\AwakeningEventTimeline.tsx:27:7\n  25 |     // 閮撖行?鈭辣\n  26 |     const unsubscribeEvents = awakeningBroadcaster.subscribe(event => {\n> 27 |       addEvent({\n     |       ^^^^^^^^ `addEvent` accessed before it is declared\n  28 |         id: crypto.randomUUID(),\n  29 |         type: event.type,\n  30 |         timestamp: event.timestamp,\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\awakening\\AwakeningEventTimeline.tsx:87:3\n  85 |   };\n  86 |\n> 87 |   const addEvent = (event: TimelineEvent) => {\n     |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 88 |     setEvents(prev => [event, ...prev].slice(0, 15));\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 89 |   };\n     | ^^^^^ `addEvent` is declared here\n  90 |\n  91 |   const getEventIcon = (type: string) => {\n  92 |     switch (type) {","line":27,"column":7,"nodeType":null,"endLine":27,"endColumn":15},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 500.","line":38,"column":42,"nodeType":"Literal","messageId":"noMagic","endLine":38,"endColumn":45},{"ruleId":"react-hooks/immutability","severity":2,"message":"Error: Cannot access variable before it is declared\n\n`loadHistoricalEvents` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\awakening\\AwakeningEventTimeline.tsx:52:5\n  50 |\n  51 |     // 頛甇瑕鈭辣\n> 52 |     loadHistoricalEvents();\n     |     ^^^^^^^^^^^^^^^^^^^^ `loadHistoricalEvents` accessed before it is declared\n  53 |\n  54 |     return () => {\n  55 |       unsubscribeEvents();\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\awakening\\AwakeningEventTimeline.tsx:60:3\n  58 |   }, []);\n  59 |\n> 60 |   const loadHistoricalEvents = () => {\n     |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 61 |     try {\n     | ^^^^^^^^^\n> 62 |       const history = awakeningBroadcaster.getEventHistory(10);\n     ?吒n     | ^^^^^^^^^\n> 84 |     }\n     | ^^^^^^^^^\n> 85 |   };\n     | ^^^^^ `loadHistoricalEvents` is declared here\n  86 |\n  87 |   const addEvent = (event: TimelineEvent) => {\n  88 |     setEvents(prev => [event, ...prev].slice(0, 15));","line":52,"column":5,"nodeType":null,"endLine":52,"endColumn":25},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":62,"column":60,"nodeType":"Literal","messageId":"noMagic","endLine":62,"endColumn":62},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":63,"column":57,"nodeType":"Literal","messageId":"noMagic","endLine":63,"endColumn":58},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 15.","line":81,"column":35,"nodeType":"Literal","messageId":"noMagic","endLine":81,"endColumn":37},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 15.","line":88,"column":49,"nodeType":"Literal","messageId":"noMagic","endLine":88,"endColumn":51},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.5.","line":156,"column":39,"nodeType":"Literal","messageId":"noMagic","endLine":156,"endColumn":42},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.05.","line":178,"column":46,"nodeType":"Literal","messageId":"noMagic","endLine":178,"endColumn":50}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":7,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * 驗算鈭辣??蝺n * Awakening Event Timeline Visualization\n */\n\nimport React, { useState, useEffect } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport { Clock, CheckCircle, AlertCircle, Radio, Zap } from 'lucide-react';\nimport { awakeningBroadcaster } from '@/omni/infrastructure/broadcast/AwakeningBroadcaster';\n\ninterface TimelineEvent {\n  id: string;\n  type: string;\n  timestamp: string;\n  phase?: string;\n  message?: string;\n  priority?: string;\n}\n\nexport const AwakeningEventTimeline: React.FC = () => {\n  const [events, setEvents] = useState<TimelineEvent[]>([]);\n  const [isLive, setIsLive] = useState(false);\n\n  useEffect(() => {\n    // 閮撖行?鈭辣\n    const unsubscribeEvents = awakeningBroadcaster.subscribe(event => {\n      addEvent({\n        id: crypto.randomUUID(),\n        type: event.type,\n        timestamp: event.timestamp,\n        phase: event.data?.phase,\n        message:\n          event.data.error ||\n          (event.data.serviceName ? `Service: ${event.data.serviceName}` : undefined) ||\n          (event.data.phase ? `Phase: ${event.data.phase}` : 'System Event'),\n      });\n      setIsLive(true);\n      setTimeout(() => setIsLive(false), 500);\n    });\n\n    const unsubscribeInsights = awakeningBroadcaster.subscribeToInsights(insight => {\n      addEvent({\n        id: crypto.randomUUID(),\n        type: 'insight',\n        timestamp: new Date().toISOString(),\n        message: `${insight.title}: ${insight.message}`,\n        priority: insight.priority,\n      });\n    });\n\n    // 頛甇瑕鈭辣\n    loadHistoricalEvents();\n\n    return () => {\n      unsubscribeEvents();\n      unsubscribeInsights();\n    };\n  }, []);\n\n  const loadHistoricalEvents = () => {\n    try {\n      const history = awakeningBroadcaster.getEventHistory(10);\n      const insights = awakeningBroadcaster.getInsights(5);\n\n      const combined = [\n        ...history.map(h => ({\n          id: crypto.randomUUID(),\n          type: h.type,\n          timestamp: h.timestamp,\n          phase: h.data?.phase,\n        })),\n        ...insights.map(i => ({\n          id: i.id,\n          type: 'insight',\n          timestamp: i.timestamp,\n          message: `${i.title}: ${i.message}`,\n          priority: i.priority,\n        })),\n      ].sort((a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime());\n\n      setEvents(combined.slice(0, 15));\n    } catch (error) {\n      console.error('Failed to load historical events:', error);\n    }\n  };\n\n  const addEvent = (event: TimelineEvent) => {\n    setEvents(prev => [event, ...prev].slice(0, 15));\n  };\n\n  const getEventIcon = (type: string) => {\n    switch (type) {\n      case 'phase-changed':\n        return <Radio className=\"w-4 h-4\" />;\n      case 'awakening-completed':\n        return <CheckCircle className=\"w-4 h-4\" />;\n      case 'service-awakened':\n        return <Zap className=\"w-4 h-4\" />;\n      case 'insight':\n        return <AlertCircle className=\"w-4 h-4\" />;\n      default:\n        return <Clock className=\"w-4 h-4\" />;\n    }\n  };\n\n  const getEventColor = (type: string, priority?: string) => {\n    if (type === 'insight') {\n      switch (priority) {\n        case 'critical':\n          return 'text-red-400 bg-red-500/10 border-red-500/20';\n        case 'high':\n          return 'text-orange-400 bg-orange-500/10 border-orange-500/20';\n        case 'medium':\n          return 'text-yellow-400 bg-yellow-500/10 border-yellow-500/20';\n        default:\n          return 'text-blue-400 bg-blue-500/10 border-blue-500/20';\n      }\n    }\n\n    switch (type) {\n      case 'awakening-completed':\n        return 'text-emerald-400 bg-emerald-500/10 border-emerald-500/20';\n      case 'phase-changed':\n        return 'text-purple-400 bg-purple-500/10 border-purple-500/20';\n      case 'service-awakened':\n        return 'text-cyan-400 bg-cyan-500/10 border-cyan-500/20';\n      default:\n        return 'text-slate-400 bg-slate-500/10 border-slate-500/20';\n    }\n  };\n\n  const formatTime = (timestamp: string) => {\n    const date = new Date(timestamp);\n    return date.toLocaleTimeString('zh-TW', {\n      hour: '2-digit',\n      minute: '2-digit',\n      second: '2-digit',\n    });\n  };\n\n  return (\n    <div className=\"glass-panel-premium p-6 rounded-xl\">\n      <div className=\"flex items-center justify-between mb-4\">\n        <h3 className=\"text-xl font-bold text-white flex items-center gap-2\">\n          <Clock className=\"w-5 h-5\" />\n          鈭辣??蝺n        </h3>\n        {isLive && (\n          <motion.div\n            initial={{ scale: 0 }}\n            animate={{ scale: 1 }}\n            className=\"flex items-center gap-2 px-3 py-1 bg-red-500/10 border border-red-500/20 rounded-full\"\n          >\n            <motion.div\n              className=\"w-2 h-2 bg-red-500 rounded-full\"\n              animate={{ opacity: [1, 0.5, 1] }}\n              transition={{ duration: 1, repeat: Infinity }}\n            />\n            <span className=\"text-xs text-red-400 font-medium\">LIVE</span>\n          </motion.div>\n        )}\n      </div>\n\n      <div className=\"relative space-y-2 max-h-96 overflow-y-auto\">\n        {/* ??蝺蜓蝺?*/}\n        <div className=\"absolute left-6 top-0 bottom-0 w-0.5 bg-gradient-to-b from-purple-500/50 via-blue-500/50 to-transparent\" />\n\n        <AnimatePresence>\n          {events.length === 0 ? (\n            <div className=\"text-center text-slate-500 py-8\">?怎鈭辣閮?</div>\n          ) : (\n            events.map((event, index) => (\n              <motion.div\n                key={event.id}\n                initial={{ opacity: 0, x: -20 }}\n                animate={{ opacity: 1, x: 0 }}\n                exit={{ opacity: 0, x: 20 }}\n                transition={{ delay: index * 0.05 }}\n                className=\"relative pl-16 pr-4 py-3\"\n              >\n                {/* ??蝺?暺?*/}\n                <div\n                  className={`absolute left-4 top-1/2 -translate-y-1/2 p-2 rounded-full border ${getEventColor(event.type, event.priority)}`}\n                >\n                  {getEventIcon(event.type)}\n                </div>\n\n                {/* 鈭辣?批捆 */}\n                <div\n                  className={`p-3 rounded-lg border ${getEventColor(event.type, event.priority)}`}\n                >\n                  <div className=\"flex items-start justify-between gap-2 mb-1\">\n                    <span className=\"text-sm font-medium text-white\">\n                      {event.type.replace(/-/g, ' ').toUpperCase()}\n                    </span>\n                    <span className=\"text-xs text-slate-500 font-mono\">\n                      {formatTime(event.timestamp)}\n                    </span>\n                  </div>\n                  {event.phase && (\n                    <div className=\"text-xs text-slate-400 mb-1\">Phase: {event.phase}</div>\n                  )}\n                  {event.message && (\n                    <div className=\"text-xs text-slate-300 mt-2\">{event.message}</div>\n                  )}\n                </div>\n              </motion.div>\n            ))\n          )}\n        </AnimatePresence>\n      </div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\awakening\\AwakeningHistoryViewer.tsx","messages":[{"ruleId":"react-hooks/immutability","severity":2,"message":"Error: Cannot access variable before it is declared\n\n`loadHistory` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\awakening\\AwakeningHistoryViewer.tsx:28:5\n  26 |\n  27 |   useEffect(() => {\n> 28 |     loadHistory();\n     |     ^^^^^^^^^^^ `loadHistory` accessed before it is declared\n  29 |   }, []);\n  30 |\n  31 |   const loadHistory = () => {\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\awakening\\AwakeningHistoryViewer.tsx:31:3\n  29 |   }, []);\n  30 |\n> 31 |   const loadHistory = () => {\n     |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 32 |     try {\n     | ^^^^^^^^^\n> 33 |       const stored = localStorage.getItem('bsa_awakening_history');\n     ?吒n     | ^^^^^^^^^\n> 41 |     }\n     | ^^^^^^^^^\n> 42 |   };\n     | ^^^^^ `loadHistory` is declared here\n  43 |\n  44 |   const calculateStats = (entries: AwakeningHistoryEntry[]) => {\n  45 |     const total = entries.length;","line":28,"column":5,"nodeType":null,"endLine":28,"endColumn":16},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'loadHistory'. Either include it or remove the dependency array.","line":29,"column":6,"nodeType":"ArrayExpression","endLine":29,"endColumn":8,"suggestions":[{"desc":"Update the dependencies array to be: [loadHistory]","fix":{"range":[678,680],"text":"[loadHistory]"}}]},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.05.","line":139,"column":48,"nodeType":"Literal","messageId":"noMagic","endLine":139,"endColumn":52}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * 驗算甇瑕?亦??函?隞跚n * Awakening History Viewer\n */\n\nimport React, { useState, useEffect } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport { Calendar, Clock, CheckCircle, XCircle, Activity } from 'lucide-react';\n\ninterface AwakeningHistoryEntry {\n  id: string;\n  timestamp: string;\n  success: boolean;\n  duration: string;\n  servicesAwakened: number;\n  phase: string;\n}\n\nexport const AwakeningHistoryViewer: React.FC = () => {\n  const [history, setHistory] = useState<AwakeningHistoryEntry[]>([]);\n  const [stats, setStats] = useState({\n    totalExecutions: 0,\n    successRate: 0,\n    avgDuration: 0,\n  });\n\n  useEffect(() => {\n    loadHistory();\n  }, []);\n\n  const loadHistory = () => {\n    try {\n      const stored = localStorage.getItem('bsa_awakening_history');\n      if (stored) {\n        const entries = JSON.parse(stored);\n        setHistory(entries);\n        calculateStats(entries);\n      }\n    } catch (error) {\n      console.error('Failed to load awakening history:', error);\n    }\n  };\n\n  const calculateStats = (entries: AwakeningHistoryEntry[]) => {\n    const total = entries.length;\n    const successful = entries.filter(e => e.success).length;\n    const successRate = total > 0 ? (successful / total) * 100 : 0;\n\n    const durations = entries.filter(e => e.duration).map(e => parseFloat(e.duration));\n    const avgDuration =\n      durations.length > 0 ? durations.reduce((a, b) => a + b, 0) / durations.length : 0;\n\n    setStats({\n      totalExecutions: total,\n      successRate: Math.round(successRate),\n      avgDuration: parseFloat(avgDuration.toFixed(2)),\n    });\n  };\n\n  const clearHistory = () => {\n    if (confirm('蝣箏?閬??斗??死?風?脰???嚗?)) {\n      localStorage.removeItem('bsa_awakening_history');\n      setHistory([]);\n      setStats({ totalExecutions: 0, successRate: 0, avgDuration: 0 });\n    }\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* 蝯梯??∠? */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n        <motion.div\n          initial={{ opacity: 0, y: 20 }}\n          animate={{ opacity: 1, y: 0 }}\n          className=\"glass-panel-premium p-6 rounded-xl\"\n        >\n          <div className=\"flex items-center gap-3 mb-2\">\n            <Activity className=\"w-5 h-5 text-blue-400\" />\n            <span className=\"text-sm text-slate-400\">蝮賢銵活??/span>\n          </div>\n          <div className=\"text-3xl font-bold text-white\">{stats.totalExecutions}</div>\n        </motion.div>\n\n        <motion.div\n          initial={{ opacity: 0, y: 20 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ delay: 0.1 }}\n          className=\"glass-panel-premium p-6 rounded-xl\"\n        >\n          <div className=\"flex items-center gap-3 mb-2\">\n            <CheckCircle className=\"w-5 h-5 text-emerald-400\" />\n            <span className=\"text-sm text-slate-400\">????/span>\n          </div>\n          <div className=\"text-3xl font-bold text-emerald-400\">{stats.successRate}%</div>\n        </motion.div>\n\n        <motion.div\n          initial={{ opacity: 0, y: 20 }}\n          animate={{ opacity: 1, y: 0 }}\n          transition={{ delay: 0.2 }}\n          className=\"glass-panel-premium p-6 rounded-xl\"\n        >\n          <div className=\"flex items-center gap-3 mb-2\">\n            <Clock className=\"w-5 h-5 text-purple-400\" />\n            <span className=\"text-sm text-slate-400\">撟喳??瑁???</span>\n          </div>\n          <div className=\"text-3xl font-bold text-purple-400\">{stats.avgDuration}s</div>\n        </motion.div>\n      </div>\n\n      {/* 甇瑕閮??” */}\n      <div className=\"glass-panel-premium p-6 rounded-xl\">\n        <div className=\"flex items-center justify-between mb-4\">\n          <h3 className=\"text-xl font-bold text-white flex items-center gap-2\">\n            <Calendar className=\"w-5 h-5\" />\n            驗算甇瑕閮?\n          </h3>\n          {history.length > 0 && (\n            <button\n              onClick={clearHistory}\n              className=\"px-4 py-2 text-sm bg-red-500/10 hover:bg-red-500/20 text-red-400 rounded-lg transition-colors\"\n            >\n              皜甇瑕\n            </button>\n          )}\n        </div>\n\n        <div className=\"space-y-3 max-h-96 overflow-y-auto\">\n          <AnimatePresence>\n            {history.length === 0 ? (\n              <div className=\"text-center text-slate-500 py-8\">?怎驗算甇瑕閮?</div>\n            ) : (\n              history.map((entry, index) => (\n                <motion.div\n                  key={entry.id}\n                  initial={{ opacity: 0, x: -20 }}\n                  animate={{ opacity: 1, x: 0 }}\n                  exit={{ opacity: 0, x: 20 }}\n                  transition={{ delay: index * 0.05 }}\n                  className=\"flex items-center justify-between p-4 bg-slate-800/50 rounded-lg hover:bg-slate-800/70 transition-colors\"\n                >\n                  <div className=\"flex items-center gap-4\">\n                    {entry.success ? (\n                      <CheckCircle className=\"w-6 h-6 text-emerald-400\" />\n                    ) : (\n                      <XCircle className=\"w-6 h-6 text-red-400\" />\n                    )}\n                    <div>\n                      <div className=\"text-white font-medium\">\n                        {new Date(entry.timestamp).toLocaleString('zh-TW')}\n                      </div>\n                      <div className=\"text-sm text-slate-400\">\n                        Phase: {entry.phase} | ??: {entry.servicesAwakened}\n                      </div>\n                    </div>\n                  </div>\n                  <div className=\"text-right\">\n                    <div className=\"text-sm font-mono text-purple-400\">{entry.duration}s</div>\n                    <div className=\"text-xs text-slate-500\">?瑁???</div>\n                  </div>\n                </motion.div>\n              ))\n            )}\n          </AnimatePresence>\n        </div>\n      </div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\cards\\OmniCard.tsx","messages":[{"ruleId":"react/jsx-no-comment-textnodes","severity":2,"message":"Comments inside children section of tag should be placed inside braces","line":84,"column":43,"nodeType":"JSXText","messageId":"putCommentInBraces","endLine":84,"endColumn":47}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useMemo } from 'react';\nimport { IESCardCore } from '../../types/cards';\nimport { useWorldEvents } from '../../hooks/useWorldEvents';\nimport { motion, AnimatePresence } from 'framer-motion';\n\ninterface OmniCardProps {\n  data: IESCardCore;\n  className?: string;\n  onClick?: () => void;\n}\n\nexport const OmniCard: React.FC<OmniCardProps> = ({ data, className, onClick }) => {\n  const { events } = useWorldEvents();\n\n  // 1. Nexus Resonance Detection\n  const isResonating = useMemo(() => {\n    const cat = data.category.toUpperCase();\n    return events.some(\n      e => e.category.startsWith(cat) || (cat === 'ENVIRONMENTAL' && e.category === 'ENVIRONMENTAL')\n    );\n  }, [data.category, events]);\n\n  const themeColor = useMemo(() => {\n    switch (data.category.toUpperCase()) {\n      case 'ENVIRONMENTAL':\n        return '#10b981';\n      case 'SOCIAL':\n        return '#f472b6';\n      case 'GOVERNANCE':\n        return '#3b82f6';\n      default:\n        return '#6366f1';\n    }\n  }, [data.category]);\n\n  const cardStyle = useMemo(\n    () =>\n      ({\n        '--card-theme': themeColor,\n        '--card-glow': isResonating ? `${themeColor}66` : 'transparent',\n      }) as React.CSSProperties,\n    [themeColor, isResonating]\n  );\n\n  if (!data.uuid || !data.stats) {\n    return <div className=\"p-4 border border-red-500 text-red-500\">Data Integrity Error</div>;\n  }\n\n  return (\n    <motion.div\n      layout\n      whileHover={{ scale: 1.02, y: -5 }}\n      className={`\n                group relative flex flex-col overflow-hidden rounded-2xl border transition-all duration-500\n                bg-slate-950/90 backdrop-blur-2xl cursor-pointer\n                ${isResonating ? 'border-[var(--card-theme)] shadow-[0_0_30px_var(--card-glow)]' : 'border-white/10 shadow-2xl'}\n                ${className}\n            `}\n      style={cardStyle}\n      onClick={onClick}\n    >\n      {/* Vibe Layer: ??? (Nexus Resonance) */}\n      <AnimatePresence>\n        {isResonating && (\n          <motion.div\n            initial={{ opacity: 0 }}\n            animate={{ opacity: 0.15 }}\n            exit={{ opacity: 0 }}\n            className=\"absolute inset-0 bg-[var(--card-theme)] animate-pulse pointer-events-none\"\n          />\n        )}\n      </AnimatePresence>\n\n      {/* Holographic Overlay */}\n      <div className=\"absolute inset-0 bg-gradient-to-br from-white/5 via-transparent to-black/40 mix-blend-overlay pointer-events-none\" />\n      <div className=\"absolute -inset-full bg-gradient-to-r from-transparent via-white/5 to-transparent skew-x-12 animate-[shimmer_5s_infinite] pointer-events-none\" />\n\n      {/* Core Layer: ?找?撅蝯? */}\n      <div className=\"relative z-10 flex flex-col h-full p-5\">\n        {/* Header Slot */}\n        <div className=\"flex justify-between items-start mb-2\">\n          <div className=\"flex flex-col\">\n            <span className=\"text-xs font-mono text-[var(--card-theme)] opacity-80 tracking-wider\">\n              {data.uuid.split('-').pop()} // {data.category.toUpperCase()}\n            </span>\n            <h3\n              className=\"text-xl font-bold text-white leading-tight line-clamp-1\"\n              title={data.metadata.title}\n            >\n              {data.metadata.title}\n            </h3>\n          </div>\n          {/* Hash Lock Indicator */}\n          <div\n            className=\"w-2 h-2 rounded-full bg-[var(--card-theme)] animate-pulse\"\n            title=\"Hash Locked\"\n          />\n        </div>\n\n        {/* Subtitle Slot (Fixed Height) */}\n        <div className=\"h-6 mb-4\">\n          <p className=\"text-xs text-slate-400 font-medium truncate\">{data.metadata.subTitle}</p>\n        </div>\n\n        {/* Stats Matrix Slot (Grid Locked) */}\n        <div className=\"grid grid-cols-3 gap-2 mb-4 p-2 bg-white/5 rounded-lg border border-white/5\">\n          <StatBox label=\"E\" value={data.stats.E} color=\"text-emerald-400\" />\n          <StatBox label=\"S\" value={data.stats.S} color=\"text-blue-400\" />\n          <StatBox label=\"G\" value={data.stats.G} color=\"text-purple-400\" />\n        </div>\n\n        {/* Event Specific Info or Logic Gate */}\n        {data.category === 'Event' && data.evidence ? (\n          <div className=\"mb-2 p-2 bg-amber-500/10 border border-amber-500/20 rounded-md\">\n            <div className=\"text-[10px] text-amber-500 uppercase font-bold tracking-wider mb-1\">\n              IMPACT VERIFIED\n            </div>\n            <div\n              className=\"text-xs text-amber-100 font-mono truncate\"\n              title={data.evidence.verification_status}\n            >\n              {data.evidence.verification_status}\n            </div>\n          </div>\n        ) : null}\n\n        {/* Logic Gate & Origin Slot */}\n        <div className=\"mt-auto pt-4 border-t border-white/5 flex justify-between items-end text-[9px] text-slate-600 font-mono tracking-tighter\">\n          <div className=\"flex flex-col gap-0.5\">\n            <span className=\"opacity-60 uppercase\">Origin: {data.logicGate.source_origin}</span>\n            <span\n              className=\"truncate max-w-[120px] opacity-40 italic\"\n              title={data.logicGate.formula_ref}\n            >\n              Formula: {data.logicGate.formula_ref}\n            </span>\n          </div>\n          <div className=\"flex items-center gap-1.5 p-1 px-2 rounded-full bg-black/40 border border-white/5\">\n            <span className=\"text-[var(--card-theme)] font-black\">\n              {data.category === 'Event' ? 'EXECUTED' : 'VERIFIED'}\n            </span>\n            <div className=\"w-1.5 h-1.5 rounded-full bg-[var(--card-theme)] shadow-[0_0_5px_var(--card-theme)]\" />\n          </div>\n        </div>\n      </div>\n    </motion.div>\n  );\n};\n\n// 頛元件嚗Ⅱ靽?潮＊蝷箔??湔吭nconst StatBox = ({ label, value, color }: { label: string; value: number; color: string }) => (\n  <div className=\"flex flex-col items-center justify-center\">\n    <span className={`text-[10px] font-bold ${color} opacity-80`}>{label}</span>\n    <span className=\"text-lg font-bold text-white tracking-widest\">{value}</span>\n  </div>\n);\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\cards\\ProjectCard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\common\\ErrorBoundary.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\common\\GlobalErrorBoundary.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\common\\ImpactTrustBadge.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":132,"column":56,"nodeType":"Literal","messageId":"noMagic","endLine":132,"endColumn":57},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 4.","line":132,"column":69,"nodeType":"Literal","messageId":"noMagic","endLine":132,"endColumn":70},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":159,"column":62,"nodeType":"Literal","messageId":"noMagic","endLine":159,"endColumn":64},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":187,"column":57,"nodeType":"Literal","messageId":"noMagic","endLine":187,"endColumn":59}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from 'react';\nimport { QRCodeSVG } from 'qrcode.react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport {\n  ShieldCheck,\n  ExternalLink,\n  Hexagon,\n  Fingerprint,\n  Sparkles,\n  Zap,\n  Lock,\n  Calculator,\n  X,\n} from 'lucide-react';\nimport type { ImpactTrustBadgeProps, IMeritProfile10 } from '@/types/core/index.ts';\n\n/**\n * ? Impact Trust Badge (受信璅?)\n * --------------------------------------------------\n * A premium, interactive UI element representing an Immutable Proof of Impact (5T Protocol).\n * Now features: Crystallization Animation, Entropy Glow, and Transparent Logic Popup.\n */\nconst ImpactTrustBadge: React.FC<ImpactTrustBadgeProps> = ({\n  proof,\n  size = 'md',\n  variant = 'premium',\n  onVerifyClick,\n}) => {\n  const [showFormula, setShowFormula] = useState(false);\n  const { tangible_manifest, logic_formula, hash_lock } = proof.evidence;\n  const verifyUrl = `${globalThis.location.origin}/verify/${proof.uuid}`;\n\n  const sizeClasses = {\n    sm: 'w-48 p-4',\n    md: 'w-72 p-6',\n    lg: 'w-88 p-8',\n  };\n\n  const qrSizes = {\n    sm: 80,\n    md: 112,\n    lg: 144,\n  };\n\n  const tLabels = [\n    'Traceable (皞舀?)',\n    'Trackable (追蹤)',\n    'Transparent (透明)',\n    'Tangible (?)',\n    'Trustworthy (靽∪祕)',\n  ];\n\n  const gradeStyles = {\n    GOLD: 'border-yellow-500/30 shadow-yellow-500/10',\n    PLATINUM: 'border-cyan-400/30 shadow-cyan-500/10',\n    SOVEREIGN: 'border-purple-500/30 shadow-purple-500/20',\n  };\n\n  const virtueLabels: Record<keyof IMeritProfile10, { zh: string; en: string; color: string }> = {\n    intelligence: { zh: '??, en: 'Int', color: 'bg-blue-400' },\n    benevolence: { zh: '隞?, en: 'Ben', color: 'bg-emerald-400' },\n    integrity: { zh: '隤?, en: 'Intg', color: 'bg-rose-400' },\n    courage: { zh: '??, en: 'Cou', color: 'bg-orange-400' },\n    temperance: { zh: '蝭', en: 'Tem', color: 'bg-indigo-400' },\n    harmony: { zh: '??, en: 'Har', color: 'bg-purple-400' },\n  };\n\n  // Dynamic Entropy Glow based on crystallization\n  const glowColor = tangible_manifest?.is_crystallized\n    ? 'shadow-celestial-blue/50'\n    : 'shadow-slate-500/20';\n  const glowAnimation = tangible_manifest?.is_crystallized ? 'animate-pulse-slow' : 'animate-none';\n\n  return (\n    <motion.div\n      initial={{ opacity: 0, scale: 0.9, y: 10, filter: 'blur(10px)' }}\n      animate={{\n        opacity: 1,\n        scale: 1,\n        y: 0,\n        filter: tangible_manifest?.is_crystallized ? 'blur(0px)' : 'blur(2px)', // ? Tangible: Crystallization Effect\n      }}\n      whileHover={{ y: -5 }}\n      transition={{ duration: 0.8, ease: 'easeOut' }}\n      className={`relative ${sizeClasses[size]} bg-slate-900/60 backdrop-blur-2xl border border-white/10 rounded-[2.5rem] overflow-hidden shadow-2xl ${glowColor} ${glowAnimation} group`}\n    >\n      {/* 1. BACKGROUND EFFECTS */}\n      <div className=\"absolute top-0 right-0 w-40 h-40 bg-blue-500/10 blur-[60px] rounded-full -mr-20 -mt-20 group-hover:bg-blue-500/20 transition-all duration-700\" />\n      <div className=\"absolute bottom-0 left-0 w-40 h-40 bg-emerald-500/10 blur-[60px] rounded-full -ml-20 -mb-20 group-hover:bg-emerald-500/20 transition-all duration-700\" />\n\n      {/* 2. HEADER: 5T PROTOCOL IDENTITY */}\n      <div className=\"relative z-10 flex items-center justify-between mb-5\">\n        <div\n          className=\"flex items-center gap-2 cursor-help\"\n          title=\"5T: Traceable, Trackable, Transparent, Tangible, Trustworthy\"\n        >\n          <div className=\"p-2 bg-emerald-500/20 rounded-xl border border-emerald-500/30\">\n            <Lock className=\"w-4 h-4 text-emerald-400\" />\n          </div>\n          <div>\n            <span className=\"block text-[10px] font-mono text-emerald-400 tracking-tighter uppercase font-bold leading-none\">\n              5T Sentinel\n            </span>\n            <span className=\"text-[8px] text-slate-500 font-mono\">Verified Proof</span>\n          </div>\n        </div>\n        <div className=\"px-3 py-1 bg-white/5 rounded-full border border-white/10 flex items-center gap-1.5\">\n          <div\n            className={`w-1.5 h-1.5 rounded-full ${proof.meridian === 'INWARD_REN' ? 'bg-blue-500' : 'bg-emerald-500'} animate-pulse shadow-[0_0_8px_rgba(59,130,246,0.8)]`}\n          />\n          <span className=\"text-[9px] font-mono text-blue-300 font-bold uppercase tracking-wider\">\n            {proof.meridian === 'INWARD_REN' ? '隞餉?' : '???'}\n          </span>\n        </div>\n      </div>\n\n      {/* 3. CORE VISUAL: QR CODE & 5T LIGHTS (Clickable for Logic) */}\n      <div className=\"relative z-10 flex flex-col items-center mb-6\">\n        <button\n          onClick={() => setShowFormula(true)}\n          className=\"relative p-2.5 bg-white/90 rounded-3xl shadow-2xl group-hover:scale-105 transition-transform duration-500 cursor-zoom-in\"\n        >\n          <QRCodeSVG value={verifyUrl} size={qrSizes[size]} level=\"H\" includeMargin={false} />\n          {/* Scan Line Animation */}\n          <div className=\"absolute inset-x-0 top-0 h-0.5 bg-blue-500/50 shadow-[0_0_12px_rgba(59,130,246,0.6)] animate-scan pointer-events-none\" />\n        </button>\n\n        <div className=\"mt-5 flex gap-1.5 items-center\">\n          {['t1', 't2', 't3', 't4', 't5'].map((t, idx) => (\n            <div\n              key={t}\n              className={`w-2 h-2 rounded-full ${idx < 5 ? (idx === 4 ? 'bg-rose-500' : 'bg-emerald-500') : 'bg-slate-700'} shadow-[0_0_8px_rgba(16,185,129,0.5)] cursor-help`}\n              title={tLabels[idx]}\n            />\n          ))}\n          {tangible_manifest?.is_crystallized && (\n            <Sparkles className=\"w-3 h-3 text-yellow-400 animate-pulse ml-1\" />\n          )}\n        </div>\n        <p className=\"mt-2 text-[8px] text-slate-500 font-mono uppercase tracking-[0.3em]\">\n          5T Sentinel Integrity Verified\n        </p>\n      </div>\n\n      {/* 4. SIX VIRTUES RADAR (Linear Representation for space) */}\n      <div className=\"relative z-10 space-y-2 mb-6\">\n        <div className=\"flex justify-between items-center mb-1\">\n          <span className=\"text-[10px] text-slate-400 font-bold uppercase tracking-wider flex items-center gap-1\">\n            <Hexagon className=\"w-3 h-3 text-emerald-400\" /> Six Virtues (?剖噸)\n          </span>\n          <span className=\"text-[10px] font-mono text-emerald-400\">Score: 1-10</span>\n        </div>\n        <div className=\"grid grid-cols-6 gap-1.5\">\n          {(Object.keys(virtueLabels) as Array<keyof IMeritProfile10>).map(key => (\n            <div key={key} className=\"flex flex-col items-center gap-1\">\n              <div className=\"w-full h-12 bg-white/5 rounded-full relative overflow-hidden\">\n                <motion.div\n                  initial={{ height: 0 }}\n                  animate={{ height: `${proof.virtues[key] * 10}%` }}\n                  className={`absolute bottom-0 inset-x-0 ${virtueLabels[key].color} opacity-60`}\n                  transition={{ delay: 0.5, duration: 1 }}\n                />\n                <div className=\"absolute inset-0 flex items-center justify-center pointer-events-none\">\n                  <span className=\"text-[9px] font-bold text-white/50\">{virtueLabels[key].zh}</span>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* 5. FOOTER: VERIFICATION & HASH */}\n      <div className=\"relative z-10 pt-5 border-t border-white/5\">\n        <button\n          type=\"button\"\n          onClick={() => onVerifyClick?.(proof.uuid)}\n          className=\"w-full py-2.5 bg-gradient-to-r from-emerald-600 to-blue-600 hover:from-emerald-500 hover:to-blue-500 text-white text-[11px] font-bold rounded-2xl shadow-xl shadow-blue-900/30 flex items-center justify-center gap-2 transition-all active:scale-95 group/btn\"\n        >\n          <ExternalLink className=\"w-3.5 h-3.5 group-hover/btn:translate-x-0.5 group-hover/btn:-translate-y-0.5 transition-transform\" />\n          VERIFY IMMUTABILITY\n        </button>\n\n        <div className=\"mt-4 flex items-center justify-between\">\n          <div className=\"flex items-center gap-1.5\">\n            <Fingerprint className=\"w-3.5 h-3.5 text-slate-500\" />\n            <span className=\"text-[9px] font-mono text-slate-500 tracking-tighter\">\n              HASH: {hash_lock ? hash_lock.substring(0, 10) : 'PENDING'}\n            </span>\n          </div>\n        </div>\n      </div>\n\n      {/* Glossy Overlay */}\n      <div className=\"absolute inset-0 pointer-events-none bg-gradient-to-tr from-transparent via-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-1000\" />\n\n      {/* ?? Transparent: Logic Formula Popup */}\n      <AnimatePresence>\n        {showFormula && (\n          <motion.div\n            initial={{ opacity: 0, scale: 0.95 }}\n            animate={{ opacity: 1, scale: 1 }}\n            exit={{ opacity: 0, scale: 0.95 }}\n            className=\"absolute inset-0 bg-slate-900/95 backdrop-blur-xl z-20 flex flex-col items-center justify-center p-6 text-center\"\n          >\n            <div className=\"w-12 h-12 bg-blue-500/20 rounded-full flex items-center justify-center mb-4\">\n              <Calculator className=\"w-6 h-6 text-blue-400\" />\n            </div>\n            <h4 className=\"text-sm font-bold text-blue-300 mb-2\">Transparent Logic (T3)</h4>\n            <p className=\"text-[10px] text-slate-400 mb-4 font-mono\">\n              This metric is calculated using the following transparent protocol formula:\n            </p>\n            <div className=\"bg-black/50 p-3 rounded-lg border border-white/10 w-full mb-4\">\n              <code className=\"text-[10px] text-emerald-400 font-mono break-all font-bold\">\n                {logic_formula || 'S_reduction = 峉(E_base - E_actual) * ?_i'}\n              </code>\n            </div>\n            <button\n              onClick={() => setShowFormula(false)}\n              className=\"p-2 hover:bg-white/10 rounded-full transition-colors\"\n            >\n              <X className=\"w-5 h-5 text-slate-400\" />\n            </button>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </motion.div>\n  );\n};\n\nexport default ImpactTrustBadge;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\community\\OmniVillage.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3.","line":106,"column":23,"nodeType":"Literal","messageId":"noMagic","endLine":106,"endColumn":24},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3.","line":129,"column":23,"nodeType":"Literal","messageId":"noMagic","endLine":129,"endColumn":24},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 4.","line":129,"column":26,"nodeType":"Literal","messageId":"noMagic","endLine":129,"endColumn":27}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"// src/components/community/OmniVillage.tsx\nimport React, { useState } from 'react';\nimport {\n  Globe,\n  Sun,\n  Users,\n  ArrowRight,\n  Star,\n  Building2,\n  Sprout,\n  Landmark,\n  Network,\n} from 'lucide-react';\nimport { useNavigate } from 'react-router-dom';\n\nexport const OmniVillage: React.FC = () => {\n  const navigate = useNavigate();\n  const [activeDistrict, setActiveDistrict] = useState<'genesis' | 'global'>('genesis');\n\n  return (\n    <div className=\"min-h-screen bg-slate-950 p-4 md:p-8 pb-32 animate-in fade-in\">\n      {/* 🏛️Hero Section: The Global View */}\n      <div className=\"text-center mb-12\">\n        <div className=\"inline-flex items-center gap-2 bg-blue-900/30 px-4 py-2 rounded-f