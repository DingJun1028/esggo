.05)' }}\n            />\n            <Bar dataKey=\"value\" fill=\"#3b82f6\" radius={[4, 4, 0, 0]}>\n              {data.map((entry, index) => (\n                <Cell\n                  key={`cell-${index}`}\n                  fill={\n                    dateRange.start &&\n                    Object.values(entry).includes('Mar') &&\n                    dateRange.start.includes('03')\n                      ? '#8b5cf6'\n                      : '#3b82f6'\n                  }\n                />\n              ))}\n            </Bar>\n          </BarChart>\n        </ResponsiveContainer>\n      </div>\n    </div>\n  );\n};\n\nexport default TrendBox;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\calendar\\EventModal.tsx","messages":[{"ruleId":"react/prop-types","severity":2,"message":"'isOpen' is missing in props validation","line":15,"column":52,"nodeType":"Property","messageId":"missingPropType","endLine":15,"endColumn":58},{"ruleId":"react/prop-types","severity":2,"message":"'onClose' is missing in props validation","line":15,"column":60,"nodeType":"Property","messageId":"missingPropType","endLine":15,"endColumn":67},{"ruleId":"react/prop-types","severity":2,"message":"'event' is missing in props validation","line":15,"column":69,"nodeType":"Property","messageId":"missingPropType","endLine":15,"endColumn":74},{"ruleId":"react/prop-types","severity":2,"message":"'onSave' is missing in props validation","line":15,"column":76,"nodeType":"Property","messageId":"missingPropType","endLine":15,"endColumn":82},{"ruleId":"react/prop-types","severity":2,"message":"'event.title' is missing in props validation","line":70,"column":85,"nodeType":"Identifier","messageId":"missingPropType","endLine":70,"endColumn":90},{"ruleId":"react/prop-types","severity":2,"message":"'event.start' is missing in props validation","line":88,"column":35,"nodeType":"Identifier","messageId":"missingPropType","endLine":88