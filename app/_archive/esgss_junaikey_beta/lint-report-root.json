 is missing in props validation","line":81,"column":20,"nodeType":"Identifier","messageId":"missingPropType","endLine":81,"endColumn":33},{"ruleId":"react/prop-types","severity":2,"message":"'equipment.specialEffect' is missing in props validation","line":83,"column":69,"nodeType":"Identifier","messageId":"missingPropType","endLine":83,"endColumn":82},{"ruleId":"react/prop-types","severity":2,"message":"'type' is missing in props validation","line":93,"column":55,"nodeType":"Property","messageId":"missingPropType","endLine":93,"endColumn":59},{"ruleId":"react/prop-types","severity":2,"message":"'type.toLowerCase' is missing in props validation","line":95,"column":40,"nodeType":"Identifier","messageId":"missingPropType","endLine":95,"endColumn":51},{"ruleId":"react/prop-types","severity":2,"message":"'type' is missing in props validation","line":103,"column":6,"nodeType":"Property","messageId":"missingPropType","endLine":103,"endColumn":10},{"ruleId":"react/prop-types","severity":2,"message":"'equipment' is missing in props validation","line":103,"column":12,"nodeType":"Property","messageId":"missingPropType","endLine":103,"endColumn":21},{"ruleId":"react/prop-types","severity":2,"message":"'onClick' is missing in props validation","line":103,"column":23,"nodeType":"Property","messageId":"missingPropType","endLine":103,"endColumn":30},{"ruleId":"react/prop-types","severity":2,"message":"'className' is missing in props validation","line":103,"column":32,"nodeType":"Property","messageId":"missingPropType","endLine":103,"endColumn":46},{"ruleId":"react/prop-types","severity":2,"message":"'isActive' is missing in props validation","line":103,"column":48,"nodeType":"Property","messageId":"missingPropType","endLine":103,"endColumn":64},{"ruleId":"react/prop-types","severity":2,"message":"'equipment.rarity' is missing in props validation","line":116,"column":46,"nodeType":"Identifier","messageId":"missingPropType","endLine":116,"endColumn":52},{"ruleId":"react/prop-types","severity":2,"message":"'equipment.rarity' is missing in props validation","line":117,"column":38,"nodeType":"Identifier","messageId":"missingPropType","endLine":117,"endColumn":44},{"ruleId":"react/prop-types","severity":2,"message":"'equipment.rarity' is missing in props validation","line":118,"column":69,"nodeType":"Identifier","messageId":"missingPropType","endLine":118,"endColumn":75},{"ruleId":"react/prop-types","severity":2,"message":"'equipment.name' is missing in props validation","line":135,"column":67,"nodeType":"Identifier","messageId":"missingPropType","endLine":135,"endColumn":71}],"suppressedMessages":[],"errorCount":22,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { memo, useMemo } from 'react';\nimport { Sword, Shield, Gem, Zap } from 'lucide-react';\nimport { AgentEquipment, EquipmentType, Rarity } from '@/types';\nimport { Tooltip, TooltipContent, TooltipProvider, TooltipTrigger } from '@/components/ui';\n\n// ==================== CONSTANTS ====================\nconst RARITY_COLORS: Readonly<Record<Rarity, string>> = {\n  COMMON: '#9CA3AF',\n  UNCOMMON: '#10B981',\n  RARE: '#3B82F6',\n  EPIC: '#A855F7',\n  LEGENDARY: '#F59E0B',\n  MYTHIC: '#EF4444',\n} as const;\n\nconst RARITY_BG: Readonly<Record<Rarity, string>> = {\n  COMMON: 'bg-gray-500/10',\n  UNCOMMON: 'bg-emerald-500/10',\n  RARE: 'bg-blue-500/10',\n  EPIC: 'bg-purple-500/10',\n  LEGENDARY: 'bg-orange-500/10',\n  MYTHIC: 'bg-red-500/10',\n} as const;\n\nconst TYPE_ICONS: Readonly<Record<EquipmentType, React.ReactElement>> = {\n  WEAPON: <Sword size={18} />,\n  ARMOR: <Shield size={18} />,\n  ACCESSORY: <Gem size={18} />,\n  ARTIFACT: <Zap size={18} />,\n} as const;\n\n// ==================== TYPE DEFINITIONS ====================\ninterface EquipmentSlotProps {\n  readonly type: EquipmentType;\n  readonly equipment?: AgentEquipment;\n  readonly onClick?: () => void;\n  readonly className?: string;\n  readonly isActive?: boolean;\n}\n\ninterface SlotStyles {\n  readonly rarityColor: string;\n  readonly bgColor: string;\n  readonly borderColor: string;\n}\n\n// ==================== SUB-COMPONENTS ====================\ninterface EquipmentTooltipProps {\n  readonly equipment: AgentEquipment;\n}\n\nconst EquipmentTooltip = memo<EquipmentTooltipProps>(({ equipment }) => {\n  const rarityColor = RARITY_COLORS[equipment.rarity];\n\n  return (\n    <TooltipContent className=\"bg-[#0E0E0E] border-gray-800 p-0 overflow-hidden w-64 shadow-xl\">\n      <header\n        className=\"p-3 border-b border-white/10\"\n        style={{ backgroundColor: `${rarityColor}1A` }}\n      >\n        <h4 className=\"font-bold text-sm\" style={{ color: rarityColor }}>\n          {equipment.name}\n        </h4>\n        <span className=\"text-[10px] uppercase tracking-wider text-gray-400\">\n          {equipment.rarity} {equipment.type}\n        </span>\n      </header>\n\n      <div className=\"p-3 space-y-2\">\n        <p className=\"text-xs text-gray-300 italic\">\"{equipment.description}\"</p>\n\n        <div className=\"space-y-1 pt-2 border-t border-white/5\">\n          {Object.entries(equipment.stats).map(([stat, val]) => (\n            <div key={stat} className=\"flex justify-between text-xs\">\n              <span className=\"text-gray-500 capitalize\">{stat}</span>\n              <span className=\"text-cyan-400 font-mono\">+{val}</span>\n            </div>\n          ))}\n        </div>\n\n        {equipment.specialEffect && (\n          <div className=\"mt-2 pt-2 border-t border-white/10 text-xs text-yellow-500\">\n            <span className=\"font-bold\">??Effect:</span> {equipment.specialEffect}\n          </div>\n        )}\n      </div>\n    </TooltipContent>\n  );\n});\n\nEquipmentTooltip.displayName = 'EquipmentTooltip';\n\nconst EmptyTooltip = memo<{ type: EquipmentType }>(({ type }) => (\n  <TooltipContent>\n    <p className=\"text-xs\">Empty {type.toLowerCase()} slot</p>\n  </TooltipContent>\n));\n\nEmptyTooltip.displayName = 'EmptyTooltip';\n\n// ==================== MAIN COMPONENT ====================\nexport const EquipmentSlot = memo<EquipmentSlotProps>(\n  ({ type, equipment, onClick, className = '', isActive = false }) => {\n    const isEmpty = !equipment;\n\n    const styles = useMemo<SlotStyles>(() => {\n      if (!equipment) {\n        return {\n          rarityColor: '#374151',\n          bgColor: 'bg-[#1A1A1A]',\n          borderColor: isActive ? '#06B6D4' : '#1F2937',\n        };\n      }\n\n      return {\n        rarityColor: RARITY_COLORS[equipment.rarity],\n        bgColor: RARITY_BG[equipment.rarity],\n        borderColor: isActive ? '#06B6D4' : RARITY_COLORS[equipment.rarity],\n      };\n    }, [equipment, isActive]);\n\n    const icon = useMemo(() => TYPE_ICONS[type], [type]);\n\n    return (\n      <TooltipProvider>\n        <Tooltip>\n          <TooltipTrigger\n            onClick={onClick}\n            className={`\n                        relative w-16 h-16 rounded-xl border-2 flex items-center justify-center transition-all duration-300\n                        ${styles.bgColor} ${className}\n                        hover:border-white/50 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:ring-offset-2 focus:ring-offset-black\n                    `}\n            style={{ borderColor: styles.borderColor }}\n            aria-label={`${type} slot${equipment ? `: ${equipment.name}` : ' (empty)'}`}\n          >\n            <div\n              className={`transition-colors duration-300 ${isEmpty ? 'text-gray-700' : 'text-white'}`}\n              aria-hidden=\"true\"\n            >\n              {icon}\n            </div>\n\n            {!isEmpty && (\n              <div\n                className=\"absolute inset-0 rounded-xl blur-md opacity-20\"\n                style={{ backgroundColor: styles.rarityColor }}\n                aria-hidden=\"true\"\n              />\n            )}\n\n            <div className=\"absolute -bottom-2 bg-black px-1.5 rounded text-[8px] font-bold text-gray-500 uppercase tracking-wider\">\n              {type}\n            </div>\n          </TooltipTrigger>\n\n          {equipment ? <EquipmentTooltip equipment={equipment} /> : <EmptyTooltip type={type} />}\n        </Tooltip>\n      </TooltipProvider>\n    );\n  }\n);\n\nEquipmentSlot.displayName = 'EquipmentSlot';\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\panels\\OSClimatePanel.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1500.","line":36,"column":10,"nodeType":"Literal","messageId":"noMagic","endLine":36,"endColumn":14}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from 'react';\nimport { motion } from 'framer-motion';\nimport { FileUp, ShieldCheck, Thermometer, TrendingUp, Search, Lock } from 'lucide-react';\nimport { osClimateService } from '@/services/integration/OSClimateService';\nimport { IDataCommonsRecord } from '@/types/os-climate';\n\nexport const OSClimatePanel: React.FC = () => {\n  const [status, setStatus] = useState<'idle' | 'ingesting' | 'calculating' | 'verified'>('idle');\n  const [result, setResult] = useState<{\n    protocol?: { traceable?: { origin?: string }; immutable?: { hash_lock?: string } };\n    itr?: { temperatureScore?: number; pathway?: string };\n  } | null>(null);\n\n  const handleIngest = async () => {\n    setStatus('ingesting');\n    try {\n      // Simulate ingestion\n      const mockRecord: IDataCommonsRecord = {\n        entityName: 'TSMC',\n        data: { scope1: 1500, scope2: 3200, scope3: 8900 },\n        meta: {\n          source_url: 'TSMC_2025_ESG_Report.pdf',\n          page_number: 42,\n          extraction_method: 'NLP_AUTOMATED',\n        },\n      };\n      const packet = await osClimateService.ingestFromDataCommons(mockRecord);\n      setResult(packet);\n      setStatus('calculating');\n\n      // Simulate ITR\n      setTimeout(async () => {\n        const itr = await osClimateService.calculateITR(mockRecord.data);\n        setResult(prev => (prev ? { ...prev, itr } : { itr }));\n        setStatus('verified');\n      }, 1500);\n    } catch (e) {\n      console.error(e);\n      setStatus('idle');\n    }\n  };\n\n  return (\n    <div className=\"w-full bg-slate-900/80 backdrop-blur-md rounded-xl border border-slate-700 p-6 shadow-2xl\">\n      <div className=\"flex items-center justify-between mb-6\">\n        <div className=\"flex items-center space-x-3\">\n          <div className=\"p-2 bg-emerald-500/20 rounded-lg\">\n            <ShieldCheck className=\"w-6 h-6 text-emerald-400\" />\n          </div>\n          <div>\n            <h2 className=\"text-xl font-bold text-white\">OS-Climate Data Bridge</h2>\n            <div className=\"flex space-x-2 text-xs\">\n              <span className=\"text-slate-400 font-mono\">PROT: 3+1</span>\n              <span className=\"text-emerald-400 font-mono\">STATUS: ONLINE</span>\n            </div>\n          </div>\n        </div>\n        <button\n          onClick={handleIngest}\n          disabled={status !== 'idle'}\n          className={`px-4 py-2 rounded-lg flex items-center space-x-2 font-semibold transition-all ${\n            status === 'idle'\n              ? 'bg-blue-600 hover:bg-blue-500 text-white shadow-lg shadow-blue-500/30'\n              : 'bg-slate-700 text-slate-400 cursor-not-allowed'\n          }`}\n        >\n          <FileUp className=\"w-4 h-4\" />\n          <span>{status === 'idle' ? 'Ingest Data Commons' : 'Processing...'}</span>\n        </button>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n        {/* 1. Traceable Source */}\n        <div className=\"bg-slate-800/50 p-4 rounded-lg border border-slate-700\">\n          <div className=\"flex items-center justify-between mb-2\">\n            <span className=\"text-slate-400 text-xs uppercase tracking-wider\">Source Origin</span>\n            <Search className=\"w-4 h-4 text-slate-500\" />\n          </div>\n          <div className=\"font-mono text-sm text-blue-300 truncate\">\n            {result?.protocol?.traceable?.origin ?? '---'}\n          </div>\n          {result && (\n            <div className=\"mt-2 text-xs text-green-400 flex items-center\">\n              <ShieldCheck className=\"w-3 h-3 mr-1\" /> Verified PDF Source\n            </div>\n          )}\n        </div>\n\n        {/* 2. ITR Result */}\n        <div className=\"bg-slate-800/50 p-4 rounded-lg border border-slate-700\">\n          <div className=\"flex items-center justify-between mb-2\">\n            <span className=\"text-slate-400 text-xs uppercase tracking-wider\">ITR Temp Rise</span>\n            <Thermometer className=\"w-4 h-4 text-orange-500\" />\n          </div>\n          <div className=\"text-2xl font-bold text-white\">\n            {result?.itr ? `${result.itr.temperatureScore}簞C` : '---'}\n          </div>\n          {result?.itr && (\n            <div className=\"text-xs text-slate-400 mt-1\">Target: 1.5簞C | {result.itr.pathway}</div>\n          )}\n        </div>\n\n        {/* 3. Immutable Hash */}\n        <div className=\"bg-slate-800/50 p-4 rounded-lg border border-slate-700\">\n          <div className=\"flex items-center justify-between mb-2\">\n            <span className=\"text-slate-400 text-xs uppercase tracking-wider\">Block Hash</span>\n            <Lock className=\"w-4 h-4 text-purple-500\" />\n          </div>\n          <div className=\"font-mono text-xs text-slate-400 break-all\">\n            {result?.protocol?.immutable?.hash_lock ?? 'WAITING_FOR_DATA'}\n          </div>\n          {result && (\n            <div className=\"mt-2 text-xs text-purple-400 flex items-center\">\n              <Lock className=\"w-3 h-3 mr-1\" /> Ledger Locked\n            </div>\n          )}\n        </div>\n      </div>\n\n      {/* Protocol Visualization */}\n      {status !== 'idle' && (\n        <div className=\"mt-6\">\n          <div className=\"h-1 w-full bg-slate-800 rounded-full overflow-hidden\">\n            <motion.div\n              className=\"h-full bg-gradient-to-r from-blue-500 via-emerald-400 to-purple-500\"\n              initial={{ width: '0%' }}\n              animate={{\n                width: status === 'verified' ? '100%' : status === 'calculating' ? '66%' : '33%',\n              }}\n              transition={{ duration: 0.5 }}\n            />\n          </div>\n          <div className=\"flex justify-between text-xs text-slate-400 mt-2 font-mono\">\n            <span\n              className={\n                status === 'ingesting' || status === 'calculating' || status === 'verified'\n                  ? 'text-blue-400'\n                  : ''\n              }\n            >\n              INGESTION\n            </span>\n            <span\n              className={\n                status === 'calculating' || status === 'verified' ? 'text-emerald-400' : ''\n              }\n            >\n              CALCULATION\n            </span>\n            <span className={status === 'verified' ? 'text-purple-400' : ''}>IMMUTABLE LOCK</span>\n          </div>\n        </div>\n      )}\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\quadrants\\ArjunaAssembly.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":35,"column":20,"nodeType":"Literal","messageId":"noMagic","endLine":35,"endColumn":21},{"ruleId":"react-hooks/purity","severity":2,"message":"Error