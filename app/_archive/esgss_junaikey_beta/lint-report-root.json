         </div>\n              ))}\n            </div>\n          </div>\n        </div>\n\n        {/* 30-Day Learning Blueprint (New v8.4.0) */}\n        <div className=\"space-y-16 py-12\">\n          <div className=\"text-center space-y-4\">\n            <h2 className=\"text-5xl font-black italic tracking-tighter uppercase\">\n              30-Day <span className=\"text-[#0df2df]\">ESG Blueprint</span>\n            </h2>\n            <p className=\"text-slate-500 text-sm font-black tracking-[0.2em] italic uppercase\">\n              ?訾?頧?撠???嚗?數據?斗?唳??死?n            </p>\n          </div>\n\n          <div className=\"grid md:grid-cols-4 gap-6\">\n            {[\n              {\n                day: 'Day 0',\n                title: '????撠?,\n                icon: 'flag',\n                color: 'slate-400',\n                desc: '4T 驗證隤?SOT ?啣?撱箇蔭??,\n              },\n              {\n                day: 'Day 1-7',\n                title: '數據霅?摨?,\n                icon: 'evidence_base',\n                color: 'cyan-400',\n                desc: 'OCR ?芸?霅??憛?數據?典???,\n              },\n              {\n                day: 'Day 8-14',\n                title: 'AI ?箸設計',\n                icon: 'psychology',\n                color: '#0df2df',\n                desc: 'Scope 1/2/3 ?芸???閬那?瑯?,\n              },\n              {\n                day: 'Day 15-30',\n                title: '靽∩遙???,\n                icon: 'verified',\n                color: 'white',\n                desc: 'ZKP 撽?蝣潦??萇???閬??,\n              },\n            ].map((phase, i) => (\n              <motion.div\n                key={i}\n                whileHover={{ y: -10 }}\n                className=\"bg-white/5 border border-white/10 rounded-3xl p-8 space-y-6 relative overflow-hidden group cursor-pointer hover:border-[#0df2df]/40 transition-all\"\n              >\n                <div className=\"size-12 rounded-xl bg-[#0df2df]/10 flex items-center justify-ce