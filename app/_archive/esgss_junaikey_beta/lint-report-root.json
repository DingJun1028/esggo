th Zustand store\n    logoutFromStore();\n  };\n\n  const updatePassport = (data: Partial<UserPassport>) => {\n    if (user) {\n      const updatedUser = { ...user, ...data };\n      setUser(updatedUser);\n      // Also update the store if relevant fields change\n      loginToStore({\n        name: updatedUser.name,\n        role: updatedUser.position,\n        organization: updatedUser.company,\n      });\n    }\n  };\n\n  return (\n    <AuthContext.Provider\n      value={{\n        user,\n        isAuthenticated: !!user,\n        login,\n        logout,\n        updatePassport,\n      }}\n    >\n      {children}\n    </AuthContext.Provider>\n  );\n};\n\nexport const useAuth = () => {\n  const context = useContext(AuthContext);\n  if (!context) throw new Error('Must be used within AuthProvider');\n  return context;\n};\n\nexport const LoginPage: React.FC<{\n  onLoginSuccess?: (userData: any) => void;\n  language?: string;\n  onToggleLanguage?: () => void;\n}> = ({ onLoginSuccess, language, onToggleLanguage }) => {\n  const [email, setEmail] = useState('');\n  const [password, setPassword] = useState('');\n  const [isLoading, setIsLoading] = useState(false);\n  const { login } = useAuth();\n\n  const handleLogin = async (e?: React.FormEvent) => {\n    if (e) e.preventDefault();\n    setIsLoading(true);\n    const success = await login(email || 'demo@esgss.com', password || 'demo1234');\n    setIsLoading(false);\n    if (success) {\n      if (onLoginSuccess) onLoginSuccess({ name: 'Demo User', role: 'Developer' });\n    } else {\n      alert('?餃憭望?嚗?瑼Ｘ?函??餃??萎辣??蝣潦?);\n    }\n  };\n\n  const quickEntry = async () => {\n    setIsLoading(true);\n    // Simulate delay for ritualistic feel\n    await new Promise(resolve => setTimeout(resolve, 800));\n    await login('demo@esgss.com', 'demo1234');\n    setIsLoading(false);\n  };\n\n  return (\n    <div className=\"min-h-screen bg-[#020617] flex items-center justify-center p-6 relative overflow-hidden font-sans select