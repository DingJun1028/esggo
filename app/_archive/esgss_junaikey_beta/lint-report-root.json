nt: responseContent,\n        meta: {\n          resonance: calibration.wisdomResonance,\n          entropy: calibration.entropyReductionScore,\n          signature: calibration.signature,\n        },\n      };\n\n      setMessages(prev => [...prev, thothMsg]);\n      setIsTyping(false);\n    }, 1500);\n  };\n\n  return (\n    <Card className=\"h-full flex flex-col bg-slate-950/80 border-amber-900/30 overflow-hidden relative\">\n      {/* Background Ambience */}\n      <div className=\"absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-amber-900/10 via-slate-950 to-slate-950 pointer-events-none\" />\n\n      {/* Header */}\n      <div className=\"p-4 border-b border-amber-900/20 flex items-center justify-between bg-slate-900/50 backdrop-blur-sm relative z-10\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-10 h-10 rounded-full bg-amber-900/20 border border-amber-500/30 flex items-center justify-center\">\n            <span className=\"text-2xl\">??</span>\n          </div>\n          <div>\n            <h3 className=\"font-bold text-amber-100/90 text-sm\">\n              {isZh ? 'Thoth ?ㄚ?訾?摮輻?' : 'Dr. Thoth Digital Twin'}\n            </h3>\n            <p className=\"text-[10px] text-amber-500/60 font-mono tracking-widest\">\n              WISDOM.CORE.ACTIVE\n            </p>\n          </div>\n        </div>\n        <div className=\"flex items-center gap-2\">\n          <span className=\"flex h-2 w-2\">\n            <span className=\"animate-ping absolute inline-flex h-2 w-2 rounded-full bg-amber-400 opacity-75\"></span>\n            <span className=\"relative inline-flex rounded-full h-2 w-2 bg-amber-500\"></span>\n          </span>\n          <span className=\"text-[10px] text-amber-500 font-mono\">{isZh ? '?函?' : 'ONLINE'}</span>\n        </div>\n      </div>\n\n      {/* Chat Area */}\n      <div className=\"flex-1 overflow-hidden relative z-10\">\n        <ScrollArea className=\"h-full p-4\" ref={scrollRef}>\n          <div className=\"space-y-6\">\n            {messages.map(msg => (\n              <motion.div\n                key={msg.id}\n                initial={{ opacity: 0, y: 10 }}\n                animate={{ opacity: 1, y: 0 }}\n                className={`flex ${msg.role === 'user' ? 'justify-end' : 'justify-start'}`}\n              >\n                <div\n                  className={`max-w-[85%] ${\n                    msg.role === 'user'\n                      ? 'bg-slate-800 text-slate-200 rounded-2xl rounded-tr-none'\n                      : 'bg-amber-950/30 border border-amber-900/30 text-amber-100/80 rounded-2xl rounded-tl-none'\n                  } p-4 shadow-xl`}\n                >\n                  <p className=\"text-sm leading-relaxed\">{msg.content}</p>\n\n                  {msg.meta && (\n                    <div className=\"mt-3 pt-3 border-t border-amber-900/20 flex items-center gap-4 text-[10px] font-mono text-amber-500/70\">\n                      <div className=\"flex items-center gap-1\">\n                        <Sparkles size={10} />\n                        Resonance: {(msg.meta.resonance * 100).toFixed(1)}%\n                      </div>\n                      <div className=\"flex items-center gap-1\">\n                        <ShieldCheck size={10} />\n                        {isZh ? '?萄潭?撠? : 'Entropy'}: -{msg.meta.entropy}\n                      </div>\n                      <div className=\"ml-auto flex items-center gap-1 opacity-50\">\n                        <Fingerprint size={10} />\n                        {msg.meta.signature}\n                      </div>\n                    </div>\n                  )}\n                </div>\n              </motion.div>\n            ))}\n            {isTyping && (\n              <div className=\"flex justify-start\">\n                <div className=\"bg-amber-950/10 border border-amber-900/10 p-3 rounded-2xl rounded-tl-none flex items-center gap-1\">\n                