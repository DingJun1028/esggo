bel: isZh ? '撠??' : 'Project Board', icon: Layers },\n      // 7. Agent Hub (Intelligence)\n      { id: View.OMNI_AGENT, label: isZh ? 'AI 代稱銝剖?' : 'Agent Hub', icon: Globe },\n      // 8. Celestial Chat (Intelligence)\n      { id: View.CELESTIAL_CHAT, label: isZh ? '?箸撠店' : 'Celestial Chat', icon: MessageSquare },\n      // 9. Talent Passport (Domains)\n      { id: View.TALENT, label: isZh ? '鈭箸?霅瑞' : 'Talent Passport', icon: User },\n      // 10. Settings (System)\n      { id: View.SETTINGS, label: isZh ? '系統閮剖?' : 'Settings', icon: Settings },\n    ],\n    [isZh]\n  );\n\n  return (\n    <div className=\"flex flex-col md:flex-row h-screen bg-gradient-to-br from-slate-950 via-slate-900 to-slate-950 text-slate-200 overflow-hidden font-sans\">\n      <MobileNavBar\n        currentView={currentView}\n        onNavigate={onNavigate}\n        language={language}\n        onToggleLanguage={onToggleLanguage}\n      />\n\n      {/* ??蝡臬?? (Drawer) */}\n      <MobileSidebar\n        isOpen={isMobileSidebarOpen}\n        onClose={() => setIsMobileSidebarOpen(false)}\n        currentView={currentView}\n        onNavigate={onNavigate}\n        language={language}\n        onToggleLanguage={onToggleLanguage}\n      />\n\n      {/* ??蝡舀帖?????*/}\n      <MobileHorizontalNav\n        currentView={currentView}\n        onNavigate={onNavigate}\n        language={language}\n        onOpenSidebar={() => setIsMobileSidebarOpen(true)}\n      />\n\n      <SideNavBar\n        currentView={currentView}\n        onNavigate={onNavigate}\n        language={language}\n        onToggleLanguage={onToggleLanguage}\n      />\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 relative overflow-hidden pt-16 md:pt-0\">\n        {/* Global Background Particles - Decentralized Feel */}\n        <div className=\"absolute inset-0 pointer-events-none overflow-hidden\">\n          <div className=\"absolute top-[-20%] right-[-10%] w-[800px] h-[800px] bg-purple-500/5 rounded-ful