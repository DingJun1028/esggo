\">\n                ??敶梢?膩 (Service Impact Narrative)\n              </h3>\n              <p className=\"text-[#0ab8b2] text-[10px] font-black uppercase tracking-widest bg-[#0ab8b2]/10 px-3 py-1 rounded-full inline-block\">\n                ?脩???銝?摰?(DingJun Hong)\n              </p>\n            </div>\n          </div>\n\n          <div className=\"space-y-6 text-white/70 leading-loose text-lg font-light relative z-10\">\n            <p>\n              甇文蝡情敺菔?撠?ESGss 5T\n              驗證?扔?湔隢整?靽?合約?具??????憭扳敹?潔葉撅鈭?頞?撖西??賢????芸???閬皜祈?瘨脫??餌?生態系統???祥???嗅祕頦??箏歇體驗\n              100% ??霅唳?皞n            </p>\n            <p>\n              ?券??餌?閰摯?望?銝哨?銝?多元核心????啣?鞈???合約?n              42%嚗蒂?函冗蝢方甜?颱葉撅鈭?摨衣?透明?扯?鞎砌遙?迨?喟?銝??舀旨霅踝??湔?嗅 JunAiKey\n              多元核心銝凋??箸偶蝥?霅瑁?撖阡??澈?n            </p>\n          </div>\n\n          <div className=\"mt-12 pt-8 border-t border-white/5 flex flex-wrap gap-4 relative z-10\">\n            {[\n              { label: '永續瘝餌?', icon: ShieldIcon },\n              { label: '蝬頞唾楚', icon: LeafIcon },\n              { label: '5T Alpha 隤?', icon: AwardIcon },\n            ].map((tag, i) => (\n              <div\n                key={i}\n                className=\"flex items-center gap-3 bg-white/5 px-5 py-2 rounded-full text-xs font-black text-[#0ab8b2] border border-[#0ab8b2]/20 uppercase tracking-widest shadow-sm\"\n              >\n                <tag.icon className=\"w-3.5 h-3.5\" />\n                <span>{tag.label}</span>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* Action Area */}\n        <div className=\"w-full max-w-[960px] flex flex-col items-center gap-8 relative z-10\">\n          <button className=\"w-full md:w-auto min-w-[320px] flex items-center justify-center gap-4 bg-[#0ab8b2] hover:brightness-110 text-[#102222] font-black text-xl py-5 px-12 rounded-2xl transition-all shadow-[0_0_30px_rgba(10,184,178,0.4)] hover:shadow-[0_0_50px_rgba(10,184,178,0.6)] active:scale-95 group\">\n            <ShareIcon className=\"w-6 h-6 group-hover:rotate-12 transition-transform\" />\n            <span>?澈?喟冗蝢?Share Award</span>\n          </button>\n\n          <div className=\"flex flex-wrap items-center justify-center gap-12 text-white/40 text-sm font-bold uppercase tracking-widest\">\n            <button className=\"flex items-center gap-3 hover:text-white transition-colors\">\n              <Link2 className=\"w-5 h-5\" />\n              <span>銴ˊ?訾?????? Copy Link</span>\n            </button>\n            <button className=\"flex items-center gap-3 hover:text-white transition-colors\">\n              <DownloadIcon className=\"w-5 h-5\" />\n              <span>銝?高品質霅 Download HQ</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Footer Metadata */}\n        <footer className=\"w-full max-w-[960px] mt-24 pb-12 border-t border-white/5 pt-10 text-center opacity-40\">\n          <p className=\"text-[#0ab8b2] text-[10px] font-black uppercase tracking-[0.4em] mb-4\">\n            Blockchain Verified ??Hash: 0x8a2f44c688887b1e...f9e2\n          </p>\n          <p className=\"text-white text-[10px] font-medium tracking-widest\">\n            穢 2024 ESGss JunAiKey Ecosystem for DingJun Hong. All Rights Reserved.\n          </p>\n        </footer>\n      </main>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\MentorshipPanel.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\MicroCourseLibrary.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3.","line":174,"column":32,"nodeType":"Literal","messageId":"noMagic","endLine":174,"endColumn":33}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from 'react';\nimport { motion } from 'framer-motion';\n\n/**\n * ?? 敺株玨蝔?瞉勗澈 (Micro Course Library)\n * --------------------------------------------------\n * ?萄? \"Tiffany Blue Liquid Glass\" 蝢飛閬??n * 協議?嚗?瞉梯?摨扼?摰園?閰?T 隤??脣漲?n */\nexport const MicroCourseLibrary = () => {\n  const [activeTab, setActiveTab] = useState('?券隤脩?');\n\n  const courses = [\n    {\n      id: 1,\n      title: '隡平蝣喟?伐?敺?敹萄撖虫??洵銝甇?,\n      level: 'T1 LEVEL',\n      duration: '12 ??',\n      desc: '閫?? ISO 14064-1 ?箇??嗆?嚗??拐?璆剖翰???４???瘚???,\n      image:\n        'https://images.unsplash.com/photo-1460925895917-afdab827c52f?auto=format&fit=crop&q=80&w=2426',\n      students: 8,\n    },\n    {\n      id: 2,\n      title: 'ESG 永續?勗??貊楊?啣祕?啣?憿?,\n      level: 'T2 LEVEL',\n      duration: '18 ??',\n      desc: 'GRI 皞? 2021 ?湔??閫??嚗??∠楊?唳偶蝥??敹?銵?,\n      image:\n        'https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&q=80&w=2301',\n      students: 12,\n    },\n    {\n      id: 3,\n      title: '靘???蝣喉?數據撽??捱蝑極??,\n      level: 'T3 LEVEL',\n      duration: '15 ??',\n      desc: '??訾?撟喳?脰?靘??４?恣??撖衣?迤?憓楊?嗥璅?,\n      image:\n        'https://images.unsplash.com/photo-1551288049-bbdac8626ad1?auto=format&fit=crop&q=80&w=2340',\n      students: 5,\n    },\n  ];\n\n  const mentorFeedback = [\n    {\n      id: 1,\n      name: '?之銵??葦',\n      title: 'ESG 蝑鞈楛憿批?',\n      quote:\n        '? T1 隤脩?銝剜??啁４?斗????品牌???摮見?虜蝎曉蔗嚗飛?⊥?閰脫撠釣?函???數據?移皞漲?芸?銝?,\n      avatar: 'https://i.pravatar.cc/150?u=mentor1',\n    },\n    {\n      id: 2,\n      name: '?喲?憍??葦',\n      title: '隡平永續?勗?蝺冽撠振',\n      quote:\n        '?祕?啣?憿葉??拙拿??鈭箸???獢?閫???虜?唬?嚗迤?航迂憭?甈∠楊?啣??隡平?摰寞?敹賜??暺?,\n      avatar: 'https://i.pravatar.cc/150?u=mentor2',\n    },\n  ];\n\n  return (\n    <div className=\"bg-[#051110] text-white min-h-screen font-display selection:bg-[#0df2df]/20 flex flex-col relative overflow-hidden\">\n      {/* Ambient Background */}\n      <div className=\"fixed inset-0 pointer-events-none z-0 opacity-20\">\n        <div className=\"absolute top-[-20%] left-[-10%] w-[60%] h-[60%] rounded-full bg-[#0df2df]/10 blur-[120px]\" />\n        <div className=\"absolute bottom-[-10%] right-[-10%] w-[50%] h-[50%] rounded-full bg-cyan-500/10 blur-[120px]\" />\n      </div>\n\n      <header className=\"sticky top-0 z-50 w-full border-b border-white/5 bg-[#051110]/60 backdrop-blur-xl\">\n        <div className=\"max-w-[1400px] mx-auto px-8 h-20 flex items-center justify-between\">\n          <div className=\"flex items-center gap-6\">\n            <div className=\"size-10 bg-[#0df2df]/20 rounded-xl flex items-center justify-center border border-[#0df2df]/30 ring-4 ring-[#0df2df]/5\">\n              <span className=\"material-symbols-outlined text-[#0df2df] text-[24px]\">school</span>\n            </div>\n            <div>\n              <h2 className=\"text-xl font-black tracking-tight italic\">\n                ESGss <span className=\"text-[#0df2df]\">JunAiKey</span>\n              </h2>\n              <p className=\"text-[10px] text-[#0df2df]/60 tracking-[0.4em] font-black uppercase italic\">\n                Micro Course Library v1.0\n              </p>\n            </div>\n          </div>\n        </div>\n      </header>\n\n      <main className=\"flex-1 max-w-[1400px] w-full mx-auto px-8 py-16 space-y-16 z-10\">\n        {/* Hero Section */}\n        <div className=\"flex flex-col md:flex-row justify-between items-start md:items-end gap-8\">\n          <div className=\"space-y-6 max-w-2xl\">\n            <div className=\"flex items-center gap-2 px-3 py-1 rounded-full bg-[#0df2df]/10 border border-[#0df2df]/20 w-fit\">\n              <span className=\"material-symbols-outlined text-[#0df2df] text-xs\">auto_awesome</span>\n              <span className=\"text-[#0df2df] text-[10px] font-black tracking-widest uppercase italic\">\n                ?ˊ?喟????撅內\n              </span>\n            </div>\n            <h1 className=\"text-6xl font-black italic tracking-tighter uppercase leading-[0.9]\">\n              摮賊瘝勳嚗n              <br />\n              <span className=\"text-[#0df2df]\">5T 隤?</span>敺株玨蝔澈\n            </h1>\n            <p className=\"text-slate-400 text-lg italic border-l-2 border-[#0df2df]/30 pl-8\">\n              系統??瞉望?銝?渲?摨抒移?荔?撠祕?啁?撽???舫??蝧?敺株玨蝔??n            </p>\n          </div>\n          <button className=\"h-14 px-8 bg-[#0df2df] text-[#051110] rounded-2xl font-black italic uppercase tracking-widest hover:scale-105 transition-all shadow-[0_20px_40px_rgba(13,242,223,0.3)] active:scale-95 flex items-center gap-3\">\n            <span className=\"material-symbols-outlined\">analytics</span>\n            ?亦?隤??脣漲\n          </button>\n        </div>\n\n        {/* Filters */}\n        <div className=\"flex gap-4 overflow-x-auto pb-4 scrollbar-hide\">\n          {[\n            '?券隤脩?',\n            'T1 ?箇?撠',\n            'T2 蝑撖西?',\n            'T3 數據?亥?',\n            'T4 永續蝞∠?',\n            'T5 撠振憿批?',\n          ].map(tab => (\n            <button\n              key={tab}\n              onClick={() => setActiveTab(tab)}\n              className={`h-12 px-8 rounded-xl font-black italic uppercase tracking-widest transition-all whitespace-nowrap ${\n                activeTab === tab\n                  ? 'bg-[#0df2df] text-[#051110]'\n                  : 'bg-white/5 border border-white/10 text-white hover:bg-white/10'\n              }`}\n            >\n              {tab}\n            </button>\n          ))}\n        </div>\n\n        {/* Course Grid */}\n        <div className=\"grid md:grid-cols-2 lg:grid-cols-3 gap-8\">\n          {courses.map(course => (\n            <motion.div\n              key={course.id}\n              whileHover={{ y: -10 }}\n              className=\"bg-white/[0.03] border border-white/10 rounded-[2.5rem] overflow-hidden group flex flex-col backdrop-blur-3xl\"\n            >\n              <div className=\"relative aspect-video overflow-hidden\">\n                <div className=\"absolute inset-0 bg-gradient-to-t from-[#051110]/80 to-transparent z-10\" />\n                <div className=\"absolute top-6 right-6 z-20 px-3 py-1 rounded-full bg-[#0df2df] text-[#051110] text-[9px] font-black tracking-widest shadow-xl\">\n                  {course.level}\n                </div>\n                <img\n                  src={course.image}\n                  alt={course.title}\n                  className=\"w-full h-full object-cover group-hover:scale-110 transition-transform duration-700\"\n                />\n              </div>\n              <div className=\"p-8 flex flex-col flex-1 gap-4\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"material-symbols-outlined text-[#0df2df] text-xs\">schedule</span>\n                  <span className=\"text-[10px] text-slate-500 font-black uppercase tracking-widest italic\">\n                    {course.duration} 隤脩?\n                  </span>\n                </div>\n                <h4 className=\"text-xl font-black italic tracking-tighter uppercase leading-tight group-hover:text-[#0df2df] transition-colors\">\n                  {course.title}\n                </h4>\n                <p className=\"text-xs text-slate-500 italic leading-relaxed line-clamp-2\">\n                  {course.desc}\n                </p>\n                <div className=\"mt-auto pt-6 border-t border-white/5 flex items-center justify-between\">\n                  <div className=\"flex -space-x-2\">\n                    {[...Array(3)].map((_, i) => (\n                      <div\n                        key={i}\n                        className=\"size-8 rounded-full border-2 border-[#051110] bg-slate-800\"\n                      />\n                    ))}\n                    <div className=\"size-8 rounded-full border-2 border-[#051110] bg-white/10 flex items-center justify-center text-[10px] font-bold\">\n                      +{course.students}\n                    </div>\n                  </div>\n                  <button className=\"text-[#0df2df] text-xs font-black italic uppercase tracking-widest flex items-center gap-2 group/btn\">\n                    ??摮貊?\n                    <span className=\"material-symbols-outlined text-sm group-hover/btn:translate-x-1 transition-transform\">\n                      arrow_forward\n                    </span>\n                  </button>\n                </div>\n              </div>\n            </motion.div>\n          ))}\n        </div>\n\n        {/* Mentor Feedback */}\n        <div className=\"space-y-10 py-12\">\n          <div className=\"flex items-center gap-4\">\n            <span className=\"material-symbols-outlined text-[#0df2df] text-[32px]\">psychology</span>\n            <h2 className=\"text-3xl font-black italic tracking-tighter uppercase\">璆剖葦??暺?</h2>\n            <div className=\"h-px flex-1 bg-gradient-to-r from-white/10 to-transparent\" />\n          </div>\n          <div className=\"grid lg:grid-cols-2 gap-8\">\n            {mentorFeedback.map(feedback => (\n              <div\n                key={feedback.id}\n                className=\"p-8 rounded-[2.5rem] bg-white/[0.02] border border-white/5 border-l-4 border-l-[#0df2df] relative group hover:bg-[#0df2df]/5 transition-all\"\n              >\n                <span className=\"material-symbols-outlined absolute right-8 top-8 text-[#0df2df]/10 text-[64px] group-hover:opacity-30 transition-opacity\">\n                  format_quote\n                </span>\n                <div className=\"flex items-center gap-6 mb-6\">\n                  <div className=\"size-14 rounded-full border-2 border-[#0df2df]/30 overflow-hidden\">\n                    <img\n                      src={feedback.avatar}\n                      alt={feedback.name}\n                      className=\"w-full h-full object-cover\"\n                    />\n                  </div>\n                  <div className=\"space-y-1\">\n                    <h5 className=\"text-lg font-black italic uppercase tracking-tight\">\n                      {feedback.name}\n                    </h5>\n                    <p className=\"text-[10px] text-slate-500 font-bold uppercase tracking-widest\">\n                      {feedback.title}\n                    </p>\n                  </div>\n                </div>\n                <p className=\"text-slate-300 italic leading-relaxed relative z-10\">\n                  {feedback.quote}\n                </p>\n              </div>\n            ))}\n          </div>\n        </div>\n      </main>\n\n      <footer className=\"max-w-[1400px] w-full mx-auto px-8 py-16 border-t border-white/5 flex flex-col md:flex-row justify-between items-center gap-8 opacity-40\">\n        <div className=\"flex items-center gap-3\">\n          <span className=\"material-symbols-outlined\">verified</span>\n          <p className=\"text-[10px] font-black uppercase tracking-[0.4em] italic\">\n            穢 2024 ESGss JunAiKey Academia. 5T CERTIFIED.\n          </p>\n        </div>\n        <div className=\"flex gap-10 text-[10px] font-black uppercase tracking-[0.2em] italic\">\n          <a className=\"hover:text-[#0df2df] transition-colors cursor-pointer\">Learning Progress</a>\n          <a className=\"hover:text-[#0df2df] transition-colors cursor-pointer\">\n            Certification Path\n          </a>\n          <a className=\"hover:text-[#0df2df] transition-colors cursor-pointer\">Mentor Portal</a>\n        </div>\n      </footer>\n\n      <style>{`\n                .font-display { font-family: 'Lexend', 'Manrope', 'Noto Sans TC', sans-serif; }\n                .scrollbar-hide::-webkit-scrollbar { display: none; }\n                .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }\n            `}</style>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\MissionCenter.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":62,"column":63,"nodeType":"Literal","messageId":"noMagic","endLine":62,"endColumn":65},{"ruleId":"react-hooks/immutability","severity":2,"message":"Error: Cannot access variable before it is declared\n\n`handleMissionComplete` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\MissionCenter.tsx:65:13\n  63 |           if (next >= 100) {\n  64 |             clearInterval(interval);\n> 65 |             handleMissionComplete();\n     |             ^^^^^^^^^^^^^^^^^^^^^ `handleMissionComplete` accessed before it is declared\n  66 |             return 100;\n  67 |           }\n  68 |           return next;\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\MissionCenter.tsx:82:3\n  80 |   };\n  81 |\n> 82 |   const handleMissionComplete = () => {\n     |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 83 |     if (!activeMissionId) return;\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 84 |     const result = completeMission(activeMissionId);\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 85 |     setLastResult(result);\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 86 |     setIsExecuting(false);\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 87 |   };\n     | ^^^^^ `handleMissionComplete` is declared here\n  88 |\n  89 |   const togglePartyMember = (agentId: string) => {\n  90 |     if (party.includes(agentId)) {","line":65,"column":13,"nodeType":null,"endLine":65,"endColumn":34},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'handleMissionComplete'. Either include it or remove the dependency array.","line":73,"column":6,"nodeType":"ArrayExpression","endLine":73,"endColumn":34,"suggestions":[{"desc":"Update the dependencies array to be: [isExecuting, activeMission, handleMissionComplete]","fix":{"range":[1870,1898],"text":"[isExecuting, activeMission, handleMissionComplete]"}}]},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3.","line":92,"column":31,"nodeType":"Literal","messageId":"noMagic","endLine":92,"endColumn":32},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":129,"column":48,"nodeType":"Literal","messageId":"noMagic","endLine":129,"endColumn":49},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 33.3.","line":323,"column":67,"nodeType":"Literal","messageId":"noMagic","endLine":323,"endColumn":71}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\nimport {\n  Card,\n  CardContent,\n  CardHeader,\n  CardTitle,\n  CardDescription,\n  Button,\n  Badge,\n  ScrollArea,\n  Progress,\n} from '@/components/ui';\nimport {\n  Flag,\n  Users,\n  Activity,\n  Clock,\n  Shield,\n  Globe,\n  Zap,\n  ChevronRight,\n  Play,\n  Loader2,\n  CheckCircle2,\n  Lock,\n  Sparkles,\n  AlertCircle,\n} from 'lucide-react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport { useMissionSystem, Mission } from '../../hooks/useMissionSystem';\nimport { useAgentRpg } from '../../hooks/useAgentRpg';\nimport { OMNI_AGENTS } from '../../data/omni-agents';\nimport { ImpactCertificate } from './ImpactCertificate';\n\nexport const MissionCenter: React.FC = () => {\n  const { profile } = useAgentRpg();\n  const {\n    activeMissionId,\n    missionStartTime,\n    party,\n    setParty,\n    startMission,\n    completeMission,\n    calculateSynergy,\n    availableMissions,\n  } = useMissionSystem();\n\n  const [selectedMissionId, setSelectedMissionId] = useState<string | null>(null);\n  const [isExecuting, setIsExecuting] = useState(false);\n  const [progress, setProgress] = useState(0);\n  const [lastResult, setLastResult] = useState<any>(null);\n\n  const selectedMission = availableMissions.find(m => m.id === selectedMissionId);\n  const activeMission = availableMissions.find(m => m.id === activeMissionId);\n\n  // Simulation logic\n  useEffect(() => {\n    let interval: any;\n    if (isExecuting && activeMission) {\n      interval = setInterval(() => {\n        setProgress(prev => {\n          const next = prev + 100 / (activeMission.duration * 10); // 10 updates per second\n          if (next >= 100) {\n            clearInterval(interval);\n            handleMissionComplete();\n            return 100;\n          }\n          return next;\n        });\n      }, 100);\n    }\n    return () => clearInterval(interval);\n  }, [isExecuting, activeMission]);\n\n  const handleStart = () => {\n    if (!selectedMissionId) return;\n    startMission(selectedMissionId);\n    setIsExecuting(true);\n    setProgress(0);\n  };\n\n  const handleMissionComplete = () => {\n    if (!activeMissionId) return;\n    const result = completeMission(activeMissionId);\n    setLastResult(result);\n    setIsExecuting(false);\n  };\n\n  const togglePartyMember = (agentId: string) => {\n    if (party.includes(agentId)) {\n      setParty((prev: string[]) => prev.filter(id => id !== agentId));\n    } else if (party.length < 3) {\n      setParty((prev: string[]) => [...prev, agentId]);\n    }\n  };\n\n  if (lastResult) {\n    return (\n      <div className=\"py-12\">\n        <ImpactCertificate {...lastResult} onClose={() => setLastResult(null)} />\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"space-y-8 animate-in fade-in duration-700\">\n      {/* HEADER */}\n      <div className=\"flex justify-between items-end\">\n        <div className=\"space-y-1\">\n          <Badge\n            variant=\"outline\"\n            className=\"text-[10px] font-bold tracking-widest text-primary border-primary/20 bg-primary/5 px-3 py-0.5 rounded-full mb-2\"\n          >\n            Strategic Command\n          </Badge>\n          <h2 className=\"text-3xl font-black text-white tracking-tight flex items-center gap-3\">\n            <Flag className=\"w-8 h-8 text-primary\" />\n            Omni-Mission Center\n          </h2>\n          <p className=\"text-slate-400 text-sm\">\n            Deploy evolved agent clusters to solve global systemic challenges.\n          </p>\n        </div>\n\n        <div className=\"flex items-center gap-4 bg-slate-900/50 p-3 rounded-2xl border border-white/5\">\n          <div className=\"text-right\">\n            <div className=\"text-[10px] text-slate-500 font-bold uppercase\">Impact Authority</div>\n            <div className=\"text-sm font-black text-white\">\n              Tier {Math.floor(profile.level / 5) + 1}\n            </div>\n          </div>\n          <div className=\"h-8 w-px bg-white/5\" />\n          <div className=\"p-2 bg-primary/10 rounded-xl\">\n            <Shield className=\"w-5 h-5 text-primary\" />\n          </div>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-8\">\n        {/* MISSION BOARD */}\n        <div className=\"lg:col-span-2 space-y-6\">\n          <Card className=\"bg-slate-950/40 border-white/5 shadow-2xl backdrop-blur-xl h-[650px] flex flex-col overflow-hidden\">\n            <CardHeader className=\"border-b border-white/5 bg-white/5\">\n              <div className=\"flex justify-between items-center\">\n                <div>\n                  <CardTitle className=\"text-lg font-bold\">Active Mission Board</CardTitle>\n                  <CardDescription>Available ESG strategic directives</CardDescription>\n                </div>\n                <Badge variant=\"secondary\" className=\"bg-slate-800 text-slate-300\">\n                  {availableMissions.length} Missions Open\n                </Badge>\n              </div>\n            </CardHeader>\n            <CardContent className=\"flex-grow p-0\">\n              <ScrollArea className=\"h-full p-6\">\n                <div className=\"space-y-4\">\n                  {availableMissions.map(m => {\n                    const isLocked =\n                      m.requirements?.minLevel && profile.level < m.requirements.minLevel;\n                    const isSelected = selectedMissionId === m.id;\n\n                    return (\n                      <motion.div\n                        key={m.id}\n                        whileHover={!isLocked ? { scale: 1.01, x: 5 } : {}}\n                        className={`group relative p-5 rounded-2xl border transition-all duration-300 cursor-pointer ${\n                          isSelected\n                            ? 'bg-primary/10 border-primary ring-1 ring-primary/30'\n                            : isLocked\n                              ? 'bg-black/20 border-white/5 opacity-60 cursor-not-allowed'\n                              : 'bg-white/5 border-white/10 hover:border-white/20'\n                        }`}\n                        onClick={() => !isLocked && !isExecuting && setSelectedMissionId(m.id)}\n                      >\n                        <div className=\"flex gap-5\">\n                          <div\n                            className={`w-14 h-14 rounded-xl flex items-center justify-center shrink-0 ${\n                              m.type === 'E'\n                                ? 'bg-emerald-500/10 text-emerald-500'\n                                : m.type === 'S'\n                                  ? 'bg-rose-500/10 text-rose-500'\n                                  : m.type === 'G'\n                                    ? 'bg-blue-500/10 text-blue-500'\n                                    : 'bg-amber-500/10 text-amber-500'\n                            }`}\n                          >\n                            {m.type === 'E' ? (\n                              <Globe className=\"w-7 h-7\" />\n                            ) : m.type === 'S' ? (\n                              <Users className=\"w-7 h-7\" />\n                            ) : m.type === 'G' ? (\n                              <Shield className=\"w-7 h-7\" />\n                            ) : (\n                              <Sparkles className=\"w-7 h-7\" />\n                            )}\n                          </div>\n\n                          <div className=\"flex-grow space-y-2\">\n                            <div className=\"flex justify-between items-start\">\n                              <div className=\"flex items-center gap-2\">\n                                <h3 className=\"font-black text-white group-hover:text-primary transition-colors\">\n                                  {m.title}\n                                </h3>\n                                {isLocked && <Lock className=\"w-3 h-3 text-slate-600\" />}\n                              </div>\n                              <Badge\n                                variant=\"outline\"\n                                className=\"text-[9px] uppercase tracking-tighter border-white/10 text-slate-500\"\n                              >\n                                Diff {m.difficulty}\n                              </Badge>\n                            </div>\n                            <p className=\"text-xs text-slate-400 line-clamp-1\">{m.description}</p>\n\n                            <div className=\"flex items-center gap-6 pt-1\">\n                              <div className=\"flex items-center gap-1.5 text-[10px] font-bold text-slate-500\">\n                                <Zap className=\"w-3 h-3 text-yellow-500\" />\n                                {m.rewards.xp} XP\n                              </div>\n                              <div className=\"flex items-center gap-1.5 text-[10px] font-bold text-slate-500\">\n                                <Activity className=\"w-3 h-3 text-emerald-500\" />\n                                {m.rewards.impactScore} Impact\n                              </div>\n                              <div className=\"flex items-center gap-1.5 text-[10px] font-bold text-slate-500\">\n                                <Clock className=\"w-3 h-3 text-blue-500\" />\n                                {m.duration}s\n                              </div>\n                            </div>\n                          </div>\n                        </div>\n                      </motion.div>\n                    );\n                  })}\n                </div>\n              </ScrollArea>\n            </CardContent>\n          </Card>\n        </div>\n\n        {/* PARTY & ACTION PANEL */}\n        <div className=\"space-y-6\">\n          <Card className=\"bg-slate-900 border-white/10 shadow-2xl relative overflow-hidden\">\n            <CardHeader className=\"pb-4\">\n              <CardTitle className=\"text-sm font-black flex items-center gap-2 text-primary uppercase tracking-widest\">\n                <Users className=\"w-4 h-4\" />\n                Cluster Assembly\n              </CardTitle>\n            </CardHeader>\n            <CardContent className=\"space-y-6\">\n              {/* SELECTED PARTY */}\n              <div className=\"grid grid-cols-3 gap-2\">\n                {[0, 1, 2].map(i => {\n                  const agentId = party[i];\n                  const agent = OMNI_AGENTS.find(a => a.id === agentId);\n                  return (\n                    <div\n                      key={i}\n                      className={`aspect-square rounded-2xl border-2 border-dashed flex flex-col items-center justify-center p-2 text-center transition-all ${\n                        agent ? 'border-primary bg-primary/5' : 'border-white/5 bg-black/20'\n                      }`}\n                    >\n                      {agent ? (\n                        <>\n                          <div className=\"w-10 h-10 rounded-full bg-slate-950 flex items-center justify-center mb-1 border border-white/10\">\n                            <Activity className=\"w-5 h-5 text-primary\" />\n                          </div>\n                          <div className=\"text-[9px] font-bold text-white truncate w-full\">\n                            {agent.alias}\n                          </div>\n                        </>\n                      ) : (\n                        <div className=\"text-[8px] font-bold text-slate-700 uppercase tracking-tighter\">\n                          Empty Slot\n                        </div>\n                      )}\n                    </div>\n                  );\n                })}\n              </div>\n\n              {/* AGENT SELECTOR */}\n              <div className=\"space-y-3\">\n                <div className=\"text-[10px] font-bold text-slate-500 uppercase tracking-widest\">\n                  Available Archetypes\n                </div>\n                <ScrollArea className=\"h-48 border border-white/5 rounded-xl bg-black/20 p-2\">\n                  <div className=\"space-y-2\">\n                    {OMNI_AGENTS.map(a => {\n                      const isActive = party.includes(a.id);\n                      return (\n                        <div\n                          key={a.id}\n                          className={`p-2 rounded-lg border text-[11px] font-bold cursor-pointer flex justify-between items-center transition-all ${\n                            isActive\n                              ? 'bg-primary border-primary text-white'\n                              : 'bg-white/5 border-white/5 text-slate-400 hover:border-primary/50'\n                          }`}\n                          onClick={() => !isExecuting && togglePartyMember(a.id)}\n                        >\n                          <span className=\"truncate\">\n                            {a.alias} ({a.type})\n                          </span>\n                          {isActive && <CheckCircle2 className=\"w-3 h-3\" />}\n                        </div>\n                      );\n                    })}\n                  </div>\n                </ScrollArea>\n              </div>\n\n              {/* MISSION SUMMARY & SYNERGY */}\n              {selectedMission && (\n                <div className=\"p-4 bg-primary/5 rounded-2xl border border-primary/20 space-y-3 animate-in fade-in zoom-in-95 duration-300\">\n                  <div className=\"flex justify-between items-center\">\n                    <div className=\"text-[10px] font-bold text-primary uppercase\">\n                      Cluster Synergy\n                    </div>\n                    <div className=\"text-xl font-black text-white\">\n                      x{calculateSynergy(selectedMissionId!).toFixed(2)}\n                    </div>\n                  </div>\n                  <Progress\n                    value={calculateSynergy(selectedMissionId!) * 33.3}\n                    className=\"h-1 bg-white/5\"\n                  />\n                  <p className=\"text-[10px] text-slate-500 italic\">\n                    Party synergy amplifies XP and Impact yield.\n                  </p>\n                </div>\n              )}\n\n              {/* EXECUTION BUTTON */}\n              <div className=\"space-y-4\">\n                <Button\n                  className=\"w-full h-14 rounded-2xl bg-primary hover:bg-primary/90 text-white font-black text-lg shadow-xl shadow-primary/20 transition-all active:scale-95 group\"\n                  disabled={!selectedMissionId || isExecuting}\n                  onClick={handleStart}\n                >\n                  {isExecuting ? (\n                    <>\n                      <Loader2 className=\"w-6 h-6 mr-3 animate-spin\" />\n                      EXECUTING