 readonly agent: Agent;\n  readonly onBack: () => void;\n  readonly onUpdate?: (id: string, updates: Partial<Agent>) => Promise<void>;\n  readonly language?: Language;\n}\n\ntype TabType = 'OVERVIEW' | 'NEURAL' | 'GENES' | 'PROTOCOLS' | 'SETTINGS';\n\nexport const AgentDetailView = memo<AgentDetailViewProps>(\n  ({ agent, onBack, onUpdate, language = 'zh-TW' }) => {\n    const isZh = language === 'zh-TW';\n    const [activeTab, setActiveTab] = useState<TabType>('OVERVIEW');\n    const [isEditing, setIsEditing] = useState(false);\n    const [editedName, setEditedName] = useState(agent.name);\n\n    // Transformations for Chart Data\n    const dnaData = Object.entries(agent.dna).map(([key, value]) => ({\n      subject: isZh ? getStatLabelZh(key) : key.charAt(0).toUpperCase() + key.slice(1),\n      A: value,\n      fullMark: 100,\n    }));\n\n    // Mock Activity Data\n    const activityData = [\n      { time: '08:00', value: 30 },\n      { time: '10:00', value: 65 },\n      { time: '12:00', value: 45 },\n      { time: '14:00', value: 80 },\n      { time: '16:00', value: 55 },\n      { time: '18:00', value: 90 },\n    ];\n\n    const handleSave = async () => {\n      if (onUpdate) {\n        await onUpdate(agent.id, { name: editedName });\n      }\n      setIsEditing(false);\n    };\n\n    return (\n      <div className=\"h-full flex flex-col gap-4 bg-gray-950/50 rounded-xl overflow-hidden\">\n        {/* Header */}\n        <header className=\"flex items-center justify-between p-6 bg-gray-900 border-b border-gray-800\">\n          <div className=\"flex items-center gap-4\">\n            <Button\n              variant=\"ghost\"\n              size=\"icon\"\n              onClick={onBack}\n              className=\"text-gray-400 hover:text-white\"\n              aria-label={isZh ? '餈?' : 'Back'}\n            >\n              <ArrowLeft size={20} />\n            </Button>\n            <div className=\"flex items-center gap-3\">\n              <div\n                className={`w-12 h-12 rounded-lg flex items-center justify-center bg-gradient-to-br ${getRoleGradient(agent.role)}`}\n              >\n                <Bot size={24} className=\"text-white\" />\n              </div>\n              <div>\n                {isEditing ? (\n                  <div className=\"flex items-center gap-2\">\n                    <Input\n                      value={editedName}\n                      onChange={e => setEditedName(e.target.value)}\n                      className=\"h-8 bg-black/50 border-gray-700\"\n                    />\n                    <Button\n                      size=\"icon\"\n                      variant=\"ghost\"\n                      onClick={handleSave}\n                      className=\"h-8 w-8 text-green-400\"\n                    >\n                      <Save size={16} />\n                    </Button>\n                  </div>\n                ) : (\n                  <h2 className=\"text-2xl font-bold text-white flex items-center gap-2\">\n                    {agent.name}\n                    <Button\n                      size=\"icon\"\n                      variant=\"ghost\"\n                      onClick={() => setIsEditing(true)}\n                      className=\"h-6 w-6 text-gray-600 hover:text-white opacity-0 group-hover:opacity-100 transition-opacity\"\n                    >\n                      <Settings size={14} />\n                    </Button>\n                  </h2>\n                )}\n                <div className=\"flex items-center gap-2 mt-1\">\n                  <Badge\n                    variant=\"outline\"\n                    className=\"bg-gray-800 text-gray-300 border-gray-700 text-xs\"\n                  >\n                    {isZh ? getRoleLabelZh(agent.role) : agent.role}\n                  </Badge>\n                  <Badge\n                    variant=\"outline\"\n                    className=\"bg-cyan-950 text-cyan-400 border-cyan-800 text-xs\"\n                  >\n                    Lv.{agent.level}\n                  </Badge>\n                  <span\n                    className={`text-xs ml-2 flex items-center gap-1 ${agent.status === 'ACTIVE' ? 'text-green-400' : 'text-gray-500'}`}\n                  >\n                    <div\n                      className={`w-2 h-2 rounded-full ${agent.status === 'ACTIVE' ? 'bg-green-400 animate-pulse' : 'bg-gray-500'}`}\n                    />\n                    {isZh ? getStatusLabelZh(agent.status) : agent.status}\n                  </span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Navigation Tabs */}\n          <div className=\"flex bg-black/30 p-1 rounded-lg border border-gray-800\">\n            <TabButton\n              active={activeTab === 'OVERVIEW'}\n              onClick={() => setActiveTab('OVERVIEW')}\n              icon={Activity}\n              label={isZh ? '璁汗' : 'Overview'}\n            />\n            <TabButton\n              active={activeTab === 'NEURAL'}\n              onClick={() => setActiveTab('NEURAL')}\n              icon={Brain}\n              label={isZh ? '蟡??? : 'Neural'}\n            />\n            <TabButton\n              active={activeTab === 'GENES'}\n              onClick={() => setActiveTab('GENES')}\n              icon={Dna}\n              label={isZh ? '?箏?' : 'Genes'}\n            />\n            <TabButton\n              active={activeTab === 'PROTOCOLS'}\n              onClick={() => setActiveTab('PROTOCOLS')}\n              icon={Shield}\n              label={isZh ? '驗證' : 'Protocols'}\n            />\n            <TabButton\n              active={activeTab === 'SETTINGS'}\n              onClick={() => setActiveTab('SETTINGS')}\n              icon={Settings}\n              label={isZh ? '?蔭' : 'Config'}\n            />\n          </div>\n        </header>\n\n        {/* Content Area */}\n        <div className=\"flex-1 p-6 overflow-y-auto custom-scrollbar\">\n          <AnimatePresence mode=\"wait\">\n            <motion.div\n              key={activeTab}\n              initial={{ opacity: 0, y: 10 }}\n              animate={{ opacity: 1, y: 0 }}\n              exit={{ opacity: 0, y: -10 }}\n              transition={{ duration: 0.2 }}\n              className=\"h-full\"\n            >\n              {activeTab === 'OVERVIEW' && (\n                <div className=\"grid grid-cols-1 md:grid-cols-3 gap-6 h-full\">\n                  {/* Stats Cards */}\n                  <div className=\"col-span-1 space-y-4\">\n                    <StatCard\n                      icon={Zap}\n                      title={isZh ? '?賡?' : 'Energy'}\n                      value={`${agent.quantumState?.energy ?? 100}%`}\n                      color=\"text-yellow-400\"\n                    />\n                    <StatCard\n                      icon={Shield}\n                      title={isZh ? '?? : 'Resilience'}\n                      value={agent.dna.resilience}\n                      color=\"text-blue-400\"\n                    />\n                    <StatCard\n                      icon={Swords}\n                      title={isZh ? '?啣?' : 'Power'}\n                      value={Math.round((agent.dna.intelligence + agent.dna.speed) / 2)}\n                      color=\"text-red-400\"\n                    />\n                    <StatCard\n                      icon={Award}\n                      title={isZh ? '蝬?' : 'Exp'}\n                      value={`${agent.experience}/${agent.nextLevelExp}`}\n                      color=\"text-purple-400\"\n                      subValue={`${Math.floor((agent.experience / agent.nextLevelExp) * 100)}%`}\n                    />\n                  </div>\n\n                  {/* Activity Graph */}\n                  <div className=\"col-span-2 bg-gray-900/50 rounded-xl p-6 border border-gray-800\">\n                    <h3 className=\"text-lg font-semibold text-gray-300 mb-6 flex items-center gap-2\">\n                      <Activity size={18} className=\"text-cyan-400\" />\n                      {isZh ? '蟡????亥?' : 'Neural Activity Log'}\n                    </h3>\n                    <div className=\"h-[300px] w-full\">\n                      <ResponsiveContainer width=\"100%\" height=\"100%\">\n                        <LineChart data={activityData}>\n                          <CartesianGrid strokeDasharray=\"3 3\" stroke=\"#333\" />\n                          <XAxis dataKey=\"time\" stroke=\"#666\" />\n                          <YAxis stroke=\"#666\" />\n                          <Tooltip\n                            contentStyle={{ backgroundColor: '#111', border: '1px solid #333' }}\n                            itemStyle={{ color: '#fff' }}\n                          />\n                          <Line\n                            type=\"monotone\"\n                            dataKey=\"value\"\n                            stroke=\"#06b6d4\"\n                            strokeWidth={2}\n                            dot={{ fill: '#06b6d4' }}\n                          />\n                        </LineChart>\n                      </ResponsiveContainer>\n                    </div>\n                  </div>\n                </div>\n              )}\n\n              {activeTab === 'NEURAL' && (\n                <div className=\"h-full flex items-center justify-center bg-gray-900/30 rounded-xl border border-gray-800 p-8\">\n                  <div className=\"w-full max-w-2xl h-[500px]\">\n                    <ResponsiveContainer width=\"100%\" height=\"100%\">\n                      <RadarChart cx=\"50%\" cy=\"50%\" outerRadius=\"80%\" data={dnaData}>\n                        <PolarGrid stroke=\"#333\" />\n                        <PolarAngleAxis\n                          dataKey=\"subject\"\n                          tick={{ fill: '#9ca3af', fontSize: 12 }}\n                        />\n                        <PolarRadiusAxis angle={30} domain={[0, 100]} stroke=\"#4b5563\" />\n                        <Radar\n                          name={isZh ? '代稱 DNA' : 'Agent DNA'}\n                          dataKey=\"A\"\n                          stroke=\"#8b5cf6\"\n                          strokeWidth={2}\n                          fill=\"#8b5cf6\"\n                          fillOpacity={0.3}\n                        />\n                        <Tooltip\n                          contentStyle={{ backgroundColor: '#111', border: '1px solid #8b5cf6' }}\n                          itemStyle={{ color: '#d8b4fe' }}\n                        />\n                      </RadarChart>\n                    </ResponsiveContainer>\n                  </div>\n                </div>\n              )}\n\n              {activeTab === 'GENES' && (\n                <div className=\"grid grid-cols-2 md:grid-cols-4 gap-4\">\n                  {Object.entries(agent.dna).map(([trait, value]) => (\n                    <Card\n                      key={trait}\n                      className=\"bg-gray-900 border-gray-800 p-4 hover:border-cyan-500/50 transition-colors\"\n                    >\n                      <div className=\"flex justify-between items-start mb-2\">\n                        <span className=\"text-gray-400\">\n                          {isZh ? getStatLabelZh(trait) : trait}\n                        </span>\n                        <span\n                          className={`text-sm font-mono ${value > 80 ? 'text-green-400' : 'text-cyan-400'}`}\n                        >\n                          {value}\n                        </span>\n                      </div>\n                      <div className=\"h-1.5 w-full bg-gray-800 rounded-full overflow-hidden\">\n                        <div\n                          className=\"h-full bg-cyan-500 rounded-full transition-all duration-1000\"\n                          style={{ width: `${value}%` }}\n                        />\n                      </div>\n                    </Card>\n                  ))}\n\n                  {/* Placeholder for Genetic Slots */}\n                  <div className=\"col-span-full mt-8\">\n                    <h3 className=\"text-lg font-semibold text-gray-300 mb-4 flex items-center gap-2\">\n                      <Dna size={18} className=\"text-purple-400\" />\n                      {isZh ? '?箏?摨?' : 'Genetic Sequence'}\n                    </h3>\n                    <div className=\"flex gap-2 overflow-x-auto pb-4\">\n                      {[...Array(6)].map((_, i) => (\n                        <div\n                          key={i}\n                          className=\"min-w-[100px] h-[120px] rounded-lg border-2 border-dashed border-gray-800 flex items-center justify-center bg-black/20 text-gray-700 font-mono text-xs\"\n                        >\n                          {isZh ? '蝛箸?瑽? : 'EMPTY SLOT'}\n                        </div>\n                      ))}\n                    </div>\n                  </div>\n                </div>\n              )}\n\n              {activeTab === 'PROTOCOLS' && (\n                <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6 h-full animate-in fade-in\">\n                  {/* Governance Card */}\n                  <Card className=\"bg-gray-900/50 border-gray-800 p-6 flex flex-col gap-4\">\n                    <div className=\"flex items-center gap-3 border-b border-gray-800 pb-4\">\n                      <div className=\"p-2 bg-amber-500/10 rounded-lg\">\n                        <Shield className=\"text-amber-400\" size={24} />\n                      </div>\n                      <div>\n                        <h3 className=\"text-lg font-bold text-gray-200\">\n                          {isZh ? '瘝餌?驗證' : 'Governance Protocols'}\n                        </h3>\n                        <p className=\"text-xs text-gray-500\">\n                          {isZh ? '銝霈敹??? : 'Immutable Core Constraints'}\n                        </p>\n                      </div>\n                    </div>\n                    <div className=\"space-y-3\">\n                      {GOVERNANCE_PROTOCOLS.IMMUTABLE_CONSTRAINTS.map((constraint, idx) => (\n                        <div\n                          key={idx}\n                          className=\"flex items-center gap-3 p-3 bg-black/40 rounded border border-gray-800/50\"\n                        >\n                          <Lock size={16} className=\"text-emerald-500\" />\n                          <span className=\"text-xs font-mono text-gray-300\">{constraint}</span>\n                          <CheckCircle2 size={14} className=\"ml-auto text-emerald-500/50\" />\n                        </div>\n                      ))}\n                    </div>\n                    <div className=\"mt-auto pt-4 border-t border-gray-800/50\">\n                      <div className=\"flex items-center justify-between\">\n                        <span className=\"text-xs text-gray-500 uppercase tracking-widest\">\n                          {isZh ? '??閰?' : 'Compliance Score'}\n                        </span>\n                        <span className=\"text-lg font-mono text-emerald-400\">100%</span>\n                      </div>\n                    </div>\n                  </Card>\n\n                  {/* Evolution / Logic Gate Card */}\n                  <Card className=\"bg-gray-900/50 border-gray-800 p-6 flex flex-col gap-4\">\n                    <div className=\"flex items-center gap-3 border-b border-gray-800 pb-4\">\n                      <div className=\"p-2 bg-purple-500/10 rounded-lg\">\n                        <FileText className=\"text-purple-400\" size={24} />\n                      </div>\n                      <div>\n                        <h3 className=\"text-lg font-bold text-gray-200\">\n                          {isZh ? '?脣?協議?' : 'Evolution Logic Gate'}\n                        </h3>\n                        <p className=\"text-xs text-gray-500\">\n                          {isZh ? '蝑???定義' : 'Tier Ascension Criteria'}\n                        </p>\n                      </div>\n                    </div>\n                    <div className=\"space-y-6\">\n                      <div>\n                        <div className=\"flex justify-between text-xs mb-2\">\n                          <span className=\"text-gray-400\">\n                            {isZh ? '蝬??曉? : 'Experience Threshold'}\n                          </span>\n                          <span className=\"text-cyan-400\">\n                            {agent.experience} / {EVOLUTION_THRESHOLDS.TIER_1_TO_2.XP_REQUIRED} XP\n                          </span>\n                        </div>\n                        <div className=\"h-1.5 w-full bg-gray-800 rounded-full overflow-hidden\">\n                          <div\n                            className=\"h-full bg-cyan-500 rounded-full\"\n                            style={{\n                              width: `${Math.min(100, (agent.experience / EVOLUTION_THRESHOLDS.TIER_1_TO_2.XP_REQUIRED) * 100)}%`,\n                            }}\n                          />\n                        </div>\n                      </div>\n                      <div>\n                        <div className=\"flex justify-between text-xs mb-2\">\n                          <span className=\"text-gray-400\">\n                            {isZh ? '?梢陷蝛拙??? : 'Resonance Stability'}\n                          </span>\n                          <span className=\"text-purple-400\">\n                            {isZh ? '蝑?' : 'Level'} {Math.ceil(agent.level / 2)} /{' '}\n                            {EVOLUTION_THRESHOLDS.TIER_1_TO_2.RESONANCE_LEVEL}\n                          </span>\n                        </div>\n                        <div className=\"h-1.5 w-full bg-gray-800 rounded-full overflow-hidden\">\n                          <div\n                            className=\"h-full bg-purple-500 rounded-full\"\n                            style={{\n                              width: `${Math.min(100, (agent.level / (EVOLUTION_THRESHOLDS.TIER_1_TO_2.RESONANCE_LEVEL * 2)) * 100)}%`,\n                            }}\n                          />\n                        </div>\n                      </div>\n\n                      <div className=\"p-4 bg-black/40 rounded border border-gray-700/30 flex items-start gap-3\">\n                        <AlertTriangle size={18} className=\"text-yellow-500 shrink-0 mt-0.5\" />\n                        <div className=\"space-y-1\">\n                          <h4 className=\"text-xs font-bold text-yellow-500 uppercase\">\n                            {isZh ? '???????' : 'Ascension Status: LOCKED'}\n                          </h4>\n                          <p className=\"text-[10px] text-gray-400 leading-relaxed\">\n                            {isZh\n                              ? '代稱敹?皛輯雲???頛舫?定義?閫?? Tier 2 ?脣?????湔扳炎?亙歇??嚗?蝬?蝛敞銝雲??\n                              : 'Agent must meet all Logic Gate criteria to unlock Tier 2 evolution. Current integrity checks are passing, but experience accumulation is insufficient.'}\n                          </p>\n                        </div>\n                      </div>\n                    </div>\n                  </Card>\n                </div>\n              )}\n\n              {activeTab === 'SETTINGS' && (\n                <div className=\"space-y-6 max-w-2xl mx-auto\">\n                  <Card className=\"bg-gray-900 border-gray-800 p-6 space-y-4\">\n                    <h3 className=\"text-lg font-semibold text-white border-b border-gray-800 pb-2\">\n                      {isZh ? '協議?' : 'Core Parameters'}\n                    </h3>\n                    <div className=\"space-y-4\">\n                      <div className=\"flex items-center justify-between\">\n                        <span className=\"text-gray-400\">\n                          {isZh ? '蝞??' : 'Processing Power Limit'}\n                        </span>\n                        <span className=\"text-cyan-400 font-mono\">85%</span>\n                      </div>\n                      <Slider defaultValue={[85]} max={100} step={1} className=\"w-full\" />\n\n                      <div className=\"flex items-center justify-between pt-4\">\n                        <span className=\"text-gray-400\">\n                          {isZh ? '?批???' : 'Memory Allocation'}\n                        </span>\n                        <span className=\"text-cyan-400 font-mono\">16GB</span>\n                      </div>\n                      <Slider defaultValue={[60]} max={100} step={1} className=\"w-full\" />\n                    </div>\n                  </Card>\n\n                  <Card className=\"bg-gray-900 border-red-900/30 p-6 space-y-4\">\n                    <h3 className=\"text-lg font-semibold text-red-400 border-b border-red-900/50 pb-2\">\n                      {isZh ? '?梢??? : 'Danger Zone'}\n                    </h3>\n                    <Button variant=\"danger\" className=\"w-full justify-start\">\n                      {isZh ? '?身蟡?甈?' : 'Reset Neural Weights'}\n                    </Button>\n                    <Button\n                      variant=\"danger\"\n                      className=\"w-full justify-start bg-red-950 hover:bg-red-900 border border-red-900\"\n                    >\n                      {isZh ? '?代稱' : 'Deactivate Agent'}\n                    </Button>\n                  </Card>\n                </div>\n              )}\n            </motion.div>\n          </AnimatePresence>\n        </div>\n      </div>\n    );\n  }\n);\n\nAgentDetailView.displayName = 'AgentDetailView';\n\n// Helper Components\n\nconst TabButton = ({\n  active,\n  onClick,\n  icon: Icon,\n  label,\n}: {\n  active: boolean;\n  onClick: () => void;\n  icon: ElementType;\n  label: string;\n}) => (\n  <button\n    onClick={onClick}\n    className={`flex items-center gap-2 px-4 py-2 rounded-md text-sm font-medium transition-all ${\n      active\n        ? 'bg-gray-800 text-white shadow-lg'\n        : 'text-gray-500 hover:text-gray-300 hover:bg-gray-900/50'\n    }`}\n  >\n    <Icon size={16} className={active ? 'text-cyan-400' : ''} />\n    {label}\n  </button>\n);\n\nconst StatCard = ({\n  icon: Icon,\n  title,\n  value,\n  color,\n  subValue,\n}: {\n  icon: ElementType;\n  title: string;\n  value: string | number;\n  color: string;\n  subValue?: string;\n}) => (\n  <div className=\"bg-gray-900/50 border border-gray-800 p-4 rounded-xl flex items-center justify-between\">\n    <div className=\"flex items-center gap-3\">\n      <div className={`p-2 rounded-lg bg-gray-950 ${color} bg-opacity-10`}>\n        <Icon size={20} className={color} />\n      </div>\n      <span className=\"text-sm text-gray-400\">{title}</span>\n    </div>\n    <div className=\"text-right\">\n      <div className=\"text-xl font-bold text-white font-mono\">{value}</div>\n      {subValue && <div className=\"text-xs text-gray-500\">{subValue}</div>}\n    </div>\n  </div>\n);\n\nconst getRoleGradient = (role: string) => {\n  switch (role) {\n    case 'ANALYST':\n      return 'from-blue-500 to-cyan-500';\n    case 'EXECUTOR':\n      return 'from-red-500 to-orange-500';\n    case 'STRATEGIST':\n      return 'from-purple-500 to-pink-500';\n    case 'AUDITOR':\n      return 'from-green-500 to-emerald-500';\n    default:\n      return 'from-gray-500 to-slate-500';\n  }\n};\n\nconst getRoleLabelZh = (role: string) => {\n  switch (role) {\n    case 'ANALYST':\n      return '??撣?;\n    case 'EXECUTOR':\n      return '?瑁???;\n    case 'STRATEGIST':\n      return '蝑摰?;\n    case 'AUDITOR':\n      return '撖抵?撣?;\n    default:\n      return role;\n  }\n};\n\nconst getStatusLabelZh = (status: string) => {\n  switch (status) {\n    case 'ACTIVE':\n      return '??銝?;\n    case 'TRAINING':\n      return '閮毀銝?;\n    case 'INACTIVE':\n      return '?';\n    default:\n      return status;\n  }\n};\n\nconst getStatLabelZh = (stat: string) => {\n  switch (stat) {\n    case 'intelligence':\n      return '?箏?';\n    case 'creativity':\n      return '?菟?';\n    case 'empathy':\n      return '?望???;\n    case 'resilience':\n      return '??;\n    case 'precision':\n      return '蝎曄Ⅱ摨?;\n    case 'speed':\n      return '?漲';\n    default:\n      return stat;\n  }\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\forge\\AgentList.tsx","messages":[{"ruleId":"react/prop-types","severity":2,"message":"'onClick' is missing in props validation","line":26,"column":49,"nodeType":"Property","messageId":"missingPropType","endLine":26,"endColumn":56},{"ruleId":"react/prop-types","severity":2,"message":"'language' is missing in props validation","line":26,"column":58,"nodeType":"Property","messageId":"missingPropType","endLine":26,"endColumn":76},{"ruleId":"react/prop-types","severity":2,"message":"'agent' is missing in props validation","line":60,"column":6,"nodeType":"Property","messageId":"missingPropType","endLine":60,"endColumn":11},{"ruleId":"react/prop-types","severity":2,"message":"'isSelected' is missing in props validation","line":60,"column":13,"nodeType":"Property","messageId":"missingPropType","endLine":60,"endColumn":23},{"ruleId":"react/prop-types","severity":2,"message":"'onSelect' is missing in props validation","line":60,"column":25,"nodeType":"Property","messageId":"missingPropType","endLine":60,"endColumn":33},{"ruleId":"react/prop-types","severity":2,"message":"'onViewDetails' is missing in props validation","line":60,"column":35,"nodeType":"Property","messageId":"missingPropType","endLine":60,"endColumn":48},{"ruleId":"react/prop-types","severity":2,"message":"'onAwaken' is missing in props validation","line":60,"column":50,"nodeType":"Property","messageId":"missingPropType","endLine":60,"endColumn":58},{"ruleId":"react/prop-types","severity":2,"message":"'language' is missing in props