ize={16} className=\"mr-2\" /> {isZh ? '餈?' : 'Back'}\n              </Button>\n            )}\n\n            {step < steps.length - 1 ? (\n              <Button\n                onClick={nextStep}\n                disabled={!canProceed}\n                className=\"bg-cyan-600 hover:bg-cyan-500 text-white min-w-[120px] focus:outline-none focus:ring-2 focus:ring-cyan-500\"\n              >\n                {isZh ? '銝?甇? : 'Next'} <ArrowRight size={16} className=\"ml-2\" />\n              </Button>\n            ) : (\n              <Button\n                onClick={handleCreate}\n                disabled={isLoading}\n                className=\"bg-emerald-600 hover:bg-emerald-500 text-white min-w-[150px] shadow-[0_0_20px_rgba(16,185,129,0.3)] focus:outline-none focus:ring-2 focus:ring-emerald-500\"\n              >\n                {isLoading ? (\n                  <>\n                    <Loader2 size={16} className=\"mr-2 animate-spin\" />\n                    {isZh ? '驗算銝?..' : 'Awakening...'}\n                  </>\n                ) : (\n                  <>\n                    <Save size={16} className=\"mr-2\" />\n                    {isZh ? '驗算代稱' : 'Awaken Agent'}\n                  </>\n                )}\n              </Button>\n            )}\n          </footer>\n        </div>\n      </div>\n    );\n  }\n);\n\nAgentBuilder.displayName = 'AgentBuilder';\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\forge\\AgentDetailView.tsx","messages":[{"ruleId":"react/prop-types","severity":2,"message":"'agent' is missing in props validation","line":52,"column":6,"nodeType":"Property","messageId":"missingPropType","endLine":52,"endColumn":11},{"ruleId":"react/prop-types","severity":2,"message":"'onBack' is missing in props validation","line":52,"column":13,"nodeType":"Property","messageId":"missingPropType","endLine":52,"endColumn":19},{"ruleId":"react/prop-types","severity":2,"message"