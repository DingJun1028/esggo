t.search(query);\n          const allEvidence = EvidenceVault.getAllEvidence();\n          const otherMatches = allEvidence.filter(\n            e =>\n              e.id.toLowerCase().includes(query) ||\n              (e.witness && e.witness.toLowerCase().includes(query))\n          );\n\n          const uniqueIds = new Set(filenameMatches.map(e => e.id));\n          const combinedMatches = [...filenameMatches];\n\n          otherMatches.forEach(e => {\n            if (!uniqueIds.has(e.id)) {\n              combinedMatches.push(e);\n            }\n          });\n\n          result = { count: combinedMatches.length, matches: combinedMatches.slice(0, 5) };\n          break; }"},"desc":"Add {} brackets around the case block."}]},{"ruleId":"no-case-declarations","severity":2,"message":"Unexpected lexical declaration in case block.","line":444,"column":11,"nodeType":"VariableDeclaration","messageId":"unexpected","endLine":444,"endColumn":63,"suggestions":[{"messageId":"addBrackets","fix":{"range":[12125,12881],"text":"{ const query = (args.query || '').toLowerCase();\n          const filenameMatches = EvidenceVault.search(query);\n          const allEvidence = EvidenceVault.getAllEvidence();\n          const otherMatches = allEvidence.filter(\n            e =>\n              e.id.toLowerCase().includes(query) ||\n              (e.witness && e.witness.toLowerCase().includes(query))\n          );\n\n          const uniqueIds = new Set(filenameMatches.map(e => e.id));\n          const combinedMatches = [...filenameMatches];\n\n          otherMatches.forEach(e => {\n            if (!uniqueIds.has(e.id)) {\n              combinedMatches.push(e);\n            }\n          });\n\n          result = { count: combinedMatches.length, matches: combinedMatches.slice(0, 5) };\n          break; }"},"desc":"Add {} brackets around the case block."}]},{"ruleId":"no-case-declarations","severity":2,"message":"Unexpected lexical declaration in case block.","line":445,"column":11,"nodeType":