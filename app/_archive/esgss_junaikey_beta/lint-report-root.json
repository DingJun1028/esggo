slate-900 border border-cyan-500/30 rounded-2xl p-6 hover:border-cyan-400 transition-all hover:-translate-y-1\">\n            <div className=\"flex items-center justify-between mb-4\">\n              <div className=\"bg-cyan-900/30 p-2 rounded-lg text-cyan-400\">\n                <Building2 className=\"w-6 h-6\" />\n              </div>\n              <span className=\"text-xs font-bold text-slate-500\">APAC NODE</span>\n            </div>\n            <h3 className=\"text-lg font-bold text-white mb-1\">鈭云?菜皜?/h3>\n            <p className=\"text-slate-400 text-sm mb-4\">撠釣?潛??鞈西????頧???/p>\n            <div className=\"flex -space-x-2\">\n              {[1, 2, 3].map(i => (\n                <div\n                  key={i}\n                  className=\"w-6 h-6 rounded-full bg-slate-700 border border-slate-900\"\n                ></div>\n              ))}\n              <div className=\"w-6 h-6 rounded-full bg-slate-800 border border-slate-900 flex items-center justify-center text-[10px] text-white\">\n                +120\n              </div>\n            </div>\n          </div>\n\n          {/* Node 2 */}\n          <div className=\"bg-slate-900 border border-emerald-500/30 rounded-2xl p-6 hover:border-emerald-400 transition-all hover:-translate-y-1\">\n            <div className=\"flex items-center justify-between mb-4\">\n              <div className=\"bg-emerald-900/30 p-2 rounded-lg text-emerald-400\">\n                <Sprout className=\"w-6 h-6\" />\n              </div>\n              <span className=\"text-xs font-bold text-slate-500\">EU NODE</span>\n            </div>\n            <h3 className=\"text-lg font-bold text-white mb-1\">甇散蝬摮賊</h3>\n            <p className=\"text-slate-400 text-sm mb-4\">蝣喃葉?蝑?蝛嗉???典誨銝剖???/p>\n            <div className=\"flex -space-x-2\">\n              {[1, 2, 3, 4].map(i => (\n                <div\n                  key={i}\n                  className=\"w-6 h-6 rounded-full bg-slate-700 border border-slate-900\"\n                ></div>\n              ))}\n              <div className=\"w-6 h-6 rounded-full bg-slate-800 border border-slate-900 flex items-center justify-center text-[10px] text-white\">\n                +85\n              </div>\n            </div>\n          </div>\n\n          {/* Node 3 */}\n          <div className=\"bg-slate-900 border border-purple-500/30 rounded-2xl p-6 hover:border-purple-400 transition-all hover:-translate-y-1\">\n            <div className=\"flex items-center justify-between mb-4\">\n              <div className=\"bg-purple-900/30 p-2 rounded-lg text-purple-400\">\n                <Landmark className=\"w-6 h-6\" />\n              </div>\n              <span className=\"text-xs font-bold text-slate-500\">NA NODE</span>\n            </div>\n            <h3 className=\"text-lg font-bold text-white mb-1\">??敶梢?葉敹?/h3>\n            <p className=\"text-slate-400 text-sm mb-4\">SROI 閰摯定義???砍??交?蝝?/p>\n            <div className=\"flex -space-x-2\">\n              {[1, 2].map(i => (\n                <div\n                  key={i}\n                  className=\"w-6 h-6 rounded-full bg-slate-700 border border-slate-900\"\n                ></div>\n              ))}\n              <div className=\"w-6 h-6 rounded-full bg-slate-800 border border-slate-900 flex items-center justify-center text-[10px] text-white\">\n                +200\n              </div>\n            </div>\n          </div>\n\n          {/* Join Card */}\n          <div\n            onClick={() => navigate('/alliance')}\n            className=\"bg-gradient-to-br from-blue-900/20 to-slate-900 border border-dashed border-blue-400/50 rounded-2xl p-6 flex flex-col items-center justify-center text-center cursor-pointer hover:bg-blue-900/30 transition-colors group\"\n          >\n            <div className=\"w-12 h-12 bg-blue-500/20 rounded-full flex items-center justify-center text-blue-400 mb-3 group-hover:scale-110 transition-transform\">\n              <Users className=\"w-6 h-6\" />\n            </div>\n            <h3 className=\"font-bold text-white mb-1\">?銝???暺?/h3>\n            <p className=\"text-blue-200/60 text-xs mb-3\">????舐?嚗撅?蔣?踹?</p>\n            <div className=\"text-blue-400 text-sm font-bold flex items-center gap-1\">\n              蝡? <ArrowRight className=\"w-4 h-4\" />\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\compliance\\ESGReportGenFull.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.2.","line":80,"column":34,"nodeType":"Literal","messageId":"noMagic","endLine":80,"endColumn":37},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3.","line":128,"column":44,"nodeType":"Literal","messageId":"noMagic","endLine":128,"endColumn":45},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3.","line":173,"column":21,"nodeType":"Literal","messageId":"noMagic","endLine":173,"endColumn":22},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3.","line":281,"column":40,"nodeType":"Literal","messageId":"noMagic","endLine":281,"endColumn":41}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\nimport { useLanguage } from '../../contexts/LanguageContext'; // Assuming context exists\nimport {\n  reportingService,\n  ReportType,\n  IGeneratedReport,\n  IEvidenceNode,\n} from '../../services/reportingService';\nimport {\n  FileText,\n  Shield,\n  Link,\n  Activity,\n  CheckCircle,\n  Download,\n  FileCheck,\n  BrainCircuit,\n} from 'lucide-react';\nimport { motion, AnimatePresence } from 'framer-motion';\n\n// ==================== BILINGUAL TEXT MAPPING ====================\nconst TEXT = {\n  TITLE: { zh: 'ESG ?勗???閬?隞?, en: 'ESG Reporting & Compliance Suite' },\n  SUBTITLE: {\n    zh: '銝銝銝嚗餈賣滲?追蹤?設計???舐砥??,\n    en: \"Three Do's One Don't: Traceable, Trackable, Calculable, Immutable\",\n  },\n  STEPS: {\n    CONFIG: { zh: '?勗?閮剖?', en: 'Configuration' },\n    GENERATING: { zh: '多元核心??', en: 'Processing' },\n    EVIDENCE: { zh: '霅?真實霅?, en: 'Evidence Chain' },\n    COMPLETE: { zh: '摰??Ｗ', en: 'Completion' },\n  },\n  ACTIONS: {\n    START: { zh: '??多元核心?勗?', en: 'Start Generation' },\n    NEXT: { zh: '銝?甇?, en: 'Next Step' },\n    DOWNLOAD: { zh: '銝??勗?', en: 'Download Report' },\n    VERIFY: { zh: '撽??憛???', en: 'Verify Blockchain Hash' },\n  },\n  LABELS: {\n    PERIOD: { zh: '?勗???', en: 'Reporting Period' },\n    TEMPLATE: { zh: '數據模式', en: 'Select Template' },\n    AI_ENHANCE: { zh: '? AI 瘛勗漲??', en: 'Enable AI Deep Analysis' },\n    INTEGRITY: { zh: '?勗?摰?折?皝?, en: 'Report Integrity Hash' },\n  },\n};\n\nconst TEMPLATES = [\n  {\n    id: 'esg-annual',\n    name: { zh: 'ESG 撟游漲蝬??勗?', en: 'ESG Annual Comprehensive Report' },\n    icon: '??',\n  },\n  {\n    id: 'carbon',\n    name: { zh: 'ISO 14064 皞怠恕瘞???斗', en: 'ISO 14064 GHG Inventory' },\n    icon: 'bf',\n  },\n  {\n    id: 'gri',\n    name: { zh: 'GRI 皞?永續?勗?', en: 'GRI Standards Sustainability Report' },\n    icon: '??',\n  },\n];\n\n// ==================== COMPONENTS ====================\n\nconst EvidenceNode = ({\n  node,\n  index,\n  isZh,\n}: {\n  node: IEvidenceNode;\n  index: number;\n  isZh: boolean;\n}) => (\n  <motion.div\n    initial={{ opacity: 0, x: -20 }}\n    animate={{ opacity: 1, x: 0 }}\n    transition={{ delay: index * 0.2 }}\n    className=\"flex items-start gap-4 p-4 bg-white/5 border border-white/10 rounded-xl mb-4 relative overflow-hidden\"\n  >\n    {/* Source Icon */}\n    <div\n      className={`\n            p-3 rounded-lg flex items-center justify-center shrink-0\n            ${\n              node.sourceType === 'BLOCKCHAIN'\n                ? 'bg-purple-500/20 text-purple-400'\n                : node.sourceType === 'IOT'\n                  ? 'bg-cyan-500/20 text-cyan-400'\n                  : 'bg-slate-500/20 text-slate-400'\n            }\n        `}\n    >\n      {node.sourceType === 'BLOCKCHAIN' && <Link size={20} />}\n      {node.sourceType === 'IOT' && <Activity size={20} />}\n      {node.sourceType === 'SYSTEM' && <FileText size={20} />}\n    </div>\n\n    <div className=\"flex-1\">\n      <div className=\"flex justify-between items-start\">\n        <h4 className=\"font-bold text-white text-sm\">{node.description}</h4>\n        {node.verified && (\n          <span className=\"flex items-center gap-1 text-[10px] text-emerald-400 bg-emerald-900/30 px-2 py-0.5 rounded border border-emerald-900\">\n            <Shield size={10} /> {isZh ? '撌脤?霅? : 'VERIFIED'}\n          </span>\n        )}\n      </div>\n      <div className=\"text-xs text-slate-500 mt-1 font-mono\">\n        ID: {node.id} | TS: {node.timestamp}\n      </div>\n      <div className=\"mt-2 p-2 bg-black/40 rounded text-[10px] text-slate-600 font-mono break-all border border-white/5\">\n        HASH: {node.rawHash}\n      </div>\n    </div>\n\n    {/* Connector Line */}\n    {index < 2 && <div className=\"absolute left-[2.25rem] -bottom-6 w-0.5 h-6 bg-white/10 z-0\" />}\n  </motion.div>\n);\n\nexport const ESGReportGenFull = () => {\n  const { language } = useLanguage();\n  const isZh = language === 'zh-TW';\n\n  // State\n  const [step, setStep] = useState<1 | 2 | 3>(1);\n  const [config, setConfig] = useState({\n    period: '2025-Q4',\n    templateId: 'esg-annual',\n    aiEnhanced: true,\n  });\n  const [report, setReport] = useState<IGeneratedReport | null>(null);\n  const [isProcessing, setIsProcessing] = useState(false);\n\n  const handleGenerate = async () => {\n    setIsProcessing(true);\n    try {\n      const result = await reportingService.generateReport({\n        ...config,\n        language: isZh ? 'zh-TW' : 'en-US',\n      });\n      setReport(result);\n      setStep(2); // Go to Evidence\n    } catch (e) {\n      console.error(e);\n    } finally {\n      setIsProcessing(false);\n    }\n  };\n\n  return (\n    <div className=\"w-full h-full flex flex-col p-6 text-white overflow-hidden relative\">\n      {/* Header */}\n      <div className=\"mb-8 text-center shrink-0\">\n        <h2 className=\"text-3xl font-black bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent\">\n          {isZh ? TEXT.TITLE.zh : TEXT.TITLE.en}\n        </h2>\n        <div className=\"flex items-center justify-center gap-2 mt-2 text-slate-400 text-sm font-mono\">\n          <Shield size={14} className=\"text-emerald-500\" />\n          {isZh ? TEXT.SUBTITLE.zh : TEXT.SUBTITLE.en}\n        </div>\n      </div>\n\n      {/* Main Content Area */}\n      <div className=\"flex-1 flex gap-8 min-h-0\">\n        {/* Left Panel: Controls / Wizard */}\n        <div className=\"w-1/3 bg-slate-900/50 border border-white/10 rounded-2xl p-6 flex flex-col\">\n          {/* Stepper */}\n          <div className=\"flex items-center justify-between mb-8 px-2 relative\">\n            <div className=\"absolute top-1/2 left-0 w-full h-0.5 bg-white/10 -z-10\" />\n            {[1, 2, 3].map(s => (\n              <div\n                key={s}\n                className={`w-8 h-8 rounded-full flex items-center justify-center text-xs font-bold transition-all\n                                    ${step >= s ? 'bg-emerald-500 text-black shadow-[0_0_15px_rgba(16,185,129,0.5)]' : 'bg-slate-800 text-slate-500 border border-slate-700'}\n                                `}\n              >\n                {s}\n              </div>\n            ))}\n          </div>\n\n          {step === 1 && (\n            <div className=\"space-y-6 animate-in slide-in-from-left duration-300\">\n              <div>\n                <label className=\"block text-sm font-bold text-emerald-400 mb-2\">\n                  {isZh ? TEXT.LABELS.TEMPLATE.zh : TEXT.LABELS.TEMPLATE.en}\n                </label>\n                <div className=\"space-y-2\">\n                  {TEMPLATES.map(t => (\n                    <button\n                      key={t.id}\n                      onClick={() => setConfig({ ...config, templateId: t.id })}\n                      className={`w-full p-3 rounded-xl border flex items-center gap-3 transition-all text-left\n                                                ${config.templateId === t.id ? 'bg-emerald-900/20 border-emerald-500 ml-2' : 'bg-slate-800/50 border-white/5 hover:bg-slate-800'}\n                                            `}\n                    >\n                      <span className=\"text-2xl\">{t.icon}</span>\n                      <span className=\"text-sm font-medium\">{isZh ? t.name.zh : t.name.en}</span>\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block text-sm font-bold text-emerald-400 mb-2\">\n                  {isZh ? TEXT.LABELS.PERIOD.zh : TEXT.LABELS.PERIOD.en}\n                </label>\n                <select\n                  className=\"w-full bg-black/40 border border-white/10 rounded-lg p-2 text-sm focus:border-emerald-500 outline-none\"\n                  value={config.period}\n                  onChange={e => setConfig({ ...config, period: e.target.value })}\n                >\n                  <option value=\"2025-FY\">2025 Full Year</option>\n                  <option value=\"2025-Q4\">2025 Q4</option>\n                  <option value=\"2025-Q3\">2025 Q3</option>\n                </select>\n              </div>\n\n              <div className=\"flex items-center justify-between p-3 bg-indigo-900/10 border border-indigo-500/20 rounded-xl\">\n                <div className=\"flex items-center gap-2\">\n                  <BrainCircuit className=\"text-indigo-400\" size={18} />\n                  <span className=\"text-sm text-indigo-100\">\n                    {isZh ? TEXT.LABELS.AI_ENHANCE.zh : TEXT.LABELS.AI_ENHANCE.en}\n                  </span>\n                </div>\n                <div\n                  className={`w-10 h-6 rounded-full p-1 transition-colors cursor-pointer ${config.aiEnhanced ? 'bg-indigo-500' : 'bg-slate-700'}`}\n                  onClick={() => setConfig({ ...config, aiEnhanced: !config.aiEnhanced })}\n                >\n                  <div\n                    className={`w-4 h-4 bg-white rounded-full shadow-sm transition-transform ${config.aiEnhanced ? 'translate-x-4' : ''}`}\n                  />\n                </div>\n              </div>\n\n              <button\n                onClick={handleGenerate}\n                disabled={isProcessing}\n                className=\"w-full py-4 mt-auto bg-emerald-500 hover:bg-emerald-400 text-black font-bold rounded-xl flex items-center justify-center gap-2 transition-all disabled:opacity-50 disabled:cursor-not-allowed\"\n              >\n                {isProcessing ? <Activity className=\"animate-spin\" /> : <FileCheck />}\n                {isProcessing\n                  ? isZh\n                    ? TEXT.STEPS.GENERATING.zh\n                    : TEXT.STEPS.GENERATING.en\n                  : isZh\n                    ? TEXT.ACTIONS.START.zh\n                    : TEXT.ACTIONS.START.en}\n              </button>\n            </div>\n          )}\n\n          {step === 2 && (\n            <div className=\"space-y-6 animate-in slide-in-from-right duration-300 h-full flex flex-col\">\n              <div className=\"text-center py-8\">\n                <div className=\"w-20 h-20 bg-emerald-500/10 rounded-full flex items-center justify-center mx-auto mb-4 border border-emerald-500/30\">\n                  <CheckCircle className=\"w-10 h-10 text-emerald-400\" />\n                </div>\n                <h3 className=\"text-xl font-bold text-white mb-2\">\n                  {isZh ? '?勗?撌脩??? : 'Report Generated'}\n                </h3>\n                <p className=\"text-xs text-slate-400 font-mono\">{report?.generatedAt}</p>\n              </div>\n\n              <div className=\"bg-black/40 border border-white/10 rounded-xl p-4\">\n                <label className=\"block text-xs font-mono text-slate-500 mb-1\">\n                  {isZh ? TEXT.LABELS.INTEGRITY.zh : TEXT.LABELS.INTEGRITY.en}\n                </label>\n                <div className=\"flex items-center gap-2\">\n                  <code className=\"text-xs text-emerald-400 break-all\">\n                    {report?.integrityHash}\n                  </code>\n                  <Shield size={14} className=\"text-emerald-500 shrink-0\" />\n                </div>\n              </div>\n\n              <button\n                onClick={() => setStep(3)}\n                className=\"w-full py-4 mt-auto border border-emerald-500/50 text-emerald-400 hover:bg-emerald-500/10 font-bold rounded-xl flex items-center justify-center gap-2 transition-all\"\n              >\n                {isZh ? '?亦?摰?勗?' : 'View Full Report'}\n              </button>\n            </div>\n          )}\n        </div>\n\n        {/* Right Panel: Visualization / Evidence Chain */}\n        <div className=\"flex-1 bg-black/60 border border-white/10 rounded-2xl p-6 relative overflow-hidden backdrop-blur-md\">\n          {/* Background Grid */}\n          <div className=\"absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:20px_20px]\" />\n\n          {step === 1 && (\n            <div className=\"h-full flex flex-col items-center justify-center text-slate-500\">\n              <div className=\"w-32 h-32 border-2 border-dashed border-slate-700 rounded-full flex items-center justify-center mb-4\">\n                <FileText size={48} className=\"opacity-20\" />\n              </div>\n              <p>{isZh ? '蝑?閮剖??...' : 'Waiting for configuration...'}</p>\n            </div>\n          )}\n\n          {step === 2 && report && (\n            <div className=\"relative h-full overflow-y-auto pr-2 custom-scrollbar\">\n              <div className=\"flex items-center justify-between mb-6\">\n                <h3 className=\"font-bold text-lg flex items-center gap-2\">\n                  <Link className=\"text-emerald-400\" />\n                  {isZh ? TEXT.STEPS.EVIDENCE.zh : TEXT.STEPS.EVIDENCE.en}\n                </h3>\n                <span className=\"text-xs px-2 py-1 rounded bg-white/5 border border-white/10 text-slate-400\">\n                  {report.evidenceChain.length} Nodes\n                </span>\n              </div>\n\n              <div className=\"relative pl-4 border-l border-white/10 ml-2\">\n                {report.evidenceChain.map((node, i) => (\n                  <EvidenceNode key={node.id} node={node} index={i} isZh={isZh} />\n                ))}\n              </div>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\AchievementGallery.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.05.","line":280,"column":46,"nodeType":"Literal","messageId":"noMagic","endLine":280,"endColumn":50}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from 'react';\nimport {\n  Trophy,\n  Leaf,\n  Users2 as Users,\n  History as HistoryIcon,\n  CheckCircle2,\n  Lock as LockIcon,\n  Info as InfoIcon,\n  Zap,\n  ShieldCheck,\n  Waves,\n  Search as SearchIcon,\n  Gem,\n  Award,\n  Star as StarIcon,\n  ShieldAlert,\n  CloudMoon,\n  Shield,\n  Heart,\n  Trees,\n  Scale,\n  RotateCw,\n  ChevronRight,\n  ArrowRight,\n} from 'lucide-react';\nimport { motion, AnimatePresence } from 'framer-motion';\n\n/**\n * ?? Achievement Gallery (Final Premium Version)\n * --------------------------------------------------\n * \"Sustainability Medal Gallery\" design for 瘣芷?蝡?(DingJun Hong).\n * Features categorized medals, liquid glass hover panels, and XP sphere integration.\n */\nexport const AchievementGallery = () => {\n  const [activeTab, setActiveTab] = useState('all');\n  const [searchQuery, setSearchQuery] = useState('');\n\n  const medals = [\n    {\n      id: 'm1',\n      name: '蝣喃葉??摰?,\n      enName: 'Carbon Neutral Master',\n      category: 'environmental',\n      icon: CloudMoon, // Representing CO2/Carbon\n      desc: '銵典蔑?函?蝜完整??蒂體驗撟游漲蝣喃葉?????思??鞎Ｙ??,\n      date: '2023.08.15',\n      earned: true,\n      color: '#0de7f2',\n    },\n    {\n      id: 'm2',\n      name: '5T 摰風??,\n      enName: '5T Guardian',\n      category: 'governance',\n      icon: ShieldCheck,\n      desc: '蝬剛風生態系統??憭折?摨行?璅?(5T)嚗Ⅱ靽偶蝥???祕???湔扼?,\n      date: '2023.05.20',\n      earned: true,\n      color: '#0de7f2',\n    },\n    {\n      id: 'm3',\n      name: '蝷曉?????,\n      enName: 'Community Healer',\n      category: 'social',\n      icon: Heart,\n      desc: '整合?潛冗??澆??摹?ａ??瘀???撱箇??瑕??扯??望旨???典蝬脰楝??,\n      date: '2023.03.12',\n      earned: true,\n      color: '#0de7f2',\n    },\n    {\n      id: 'm4',\n      name: '蝬頞唾楚??',\n      enName: 'Green Footprint Leader',\n      category: 'environmental',\n      icon: Trees,\n      desc: '撘????冽撣賊?雿葉?券撠皜????賣?踝?憿航????啣?鞎???,\n      date: '2022.11.30',\n      earned: true,\n      color: '#0de7f2',\n    },\n    {\n      id: 'm5',\n      name: '透明瘝餌?真實',\n      enName: 'Governance Pioneer',\n      category: 'governance',\n      icon: Scale,\n      desc: '整合?潭???祥??蝔?蝣箔?數據??銝撅斤??賢??摨血靽∪???,\n      date: '2022.09.15',\n      earned: true,\n      color: '#0de7f2',\n    },\n    {\n      id: 'm6',\n      name: '敺芰蝬?完整',\n      enName: 'Circular Expert',\n      category: 'environmental',\n      icon: RotateCw,\n      desc: '?刻?皞儐?啣?刻?撱Ｘ??拇??葉撅???????芸???望??孵潦?,\n      date: '2022.07.01',\n      earned: true,\n      color: '#0de7f2',\n    },\n    { name: '???', date: '撠閫??', earned: false },\n    { name: '???', date: '撠閫??', earned: false },\n  ];\n\n  const filteredMedals = medals.filter(m => {\n    if (activeTab === 'all') return true;\n    return m.category === activeTab;\n  });\n\n  return (\n    <div className=\"bg-[#102122] text-white min-h-screen font-display selection:bg-[#0de7f2]/20 overflow-x-hidden\">\n      {/* Floating Background Elements */}\n      <div className=\"fixed inset-0 pointer-events-none -z-10 overflow-hidden\">\n        <div className=\"absolute top-[10%] left-[5%] size-96 bg-[#0de7f2]/5 rounded-full blur-[120px]\" />\n        <div className=\"absolute bottom-[20%] right-[10%] size-[500px] bg-[#0de7f2]/10 rounded-full blur-[150px]\" />\n        <div className=\"absolute top-[40%] right-[20%] size-64 bg-[#0de7f2]/5 rounded-full blur-[100px]\" />\n      </div>\n\n      <div className=\"relative flex flex-col min-h-screen\">\n        {/* Main Header / Profile Header */}\n        <header className=\"sticky top-0 z-50 w-full border-b border-white/10 bg-[#102122]/80 backdrop-blur-md px-6 md:px-20 lg:px-40 py-4\">\n          <div className=\"mx-auto flex max-w-[1200px] items-center justify-between\">\n            <div className=\"flex items-center gap-10\">\n              <div className=\"flex items-center gap-3 text-[#0de7f2]\">\n                <Award className=\"w-8 h-8\" />\n                <h2 className=\"text-xl font-bold tracking-tight\">\n                  JunAiKey <span className=\"text-white/80 font-medium tracking-normal\">ESGss</span>\n                </h2>\n              </div>\n              <nav className=\"hidden md:flex items-center gap-8\">\n                <a\n                  className=\"text-[#0de7f2] hover:text-[#0de7f2] transition-colors text-sm font-bold\"\n                  href=\"#\"\n                >\n                  ?停?怠?\n                </a>\n                <a\n                  className=\"text-white/40 hover:text-[#0de7f2] transition-colors text-sm font-bold\"\n                  href=\"#\"\n                >\n                  永續?勗?\n                </a>\n                <a\n                  className=\"text-white/40 hover:text-[#0de7f2] transition-colors text-sm font-bold\"\n                  href=\"#\"\n                >\n                  ?犖撠?\n                </a>\n              </nav>\n            </div>\n            <div className=\"flex items-center gap-6\">\n              <div className=\"hidden sm:flex items-center bg-white/5 border border-white/10 rounded-2xl px-4 py-2 gap-3 group focus-within:border-[#0de7f2]/50 transition-all\">\n                <SearchIcon className=\"text-[#0de7f2] w-4 h-4\" />\n                <input\n                  value={searchQuery}\n                  onChange={e => setSearchQuery(e.target.value)}\n                  className=\"bg-transparent border-none focus:ring-0 text-sm text-white placeholder:text-white/30 w-32 lg:w-48 outline-none\"\n                  placeholder=\"???停...\"\n                  type=\"text\"\n                />\n              </div>\n              <div className=\"size-10 rounded-full border-2 border-[#0de7f2]/50 p-0.5 overflow-hidden\">\n                <div\n                  className=\"size-full rounded-full bg-cover bg-center\"\n                  style={{\n                    backgroundImage:\n                      \"url('https://lh3.googleusercontent.com/a/ACg8ocL_U0YV6m_XzW_G_y_W_s_x_x_x=s96-c')\",\n                  }}\n                />\n              </div>\n            </div>\n          </div>\n        </header>\n\n        <main className=\"flex-1 px-6 md:px-20 lg:px-40 py-12\">\n          <div className=\"mx-auto max-w-[1200px]\">\n            {/* Profile Summary Header */}\n            <motion.div\n              initial={{ opacity: 0, y: 20 }}\n              animate={{ opacit