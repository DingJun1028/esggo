n                d=\"M5 13l4 4L19 7\"\n              />\n            </svg>\n          </div>\n          <div className=\"text-white font-bold mb-1\">Verified on Chain</div>\n          <div className=\"text-gray-500 text-[10px] font-mono mb-3 break-all px-4\">\n            {anchorData.tx}\n          </div>\n          <a\n            href={`https://polygonscan.com/tx/${anchorData.tx}`}\n            target=\"_blank\"\n            rel=\"noreferrer\"\n            className=\"inline-block px-3 py-1 bg-gray-700 hover:bg-gray-600 rounded text-xs text-blue-300 transition-colors\"\n          >\n            View on PolygonScan\n          </a>\n        </div>\n      ) : (\n        <div className=\"text-gray-600 text-sm\">\n          {selectedEvidenceId\n            ? 'This item is not anchored yet.'\n            : 'Select an item to verify T4 proof.'}\n        </div>\n      )}\n    </div>\n  );\n};\n\nexport default AnchorVerifier;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\bento\\BloodlineBox.tsx","messages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\bento\\BloodlineBox.tsx:18:7\n  16 |   useEffect(() => {\n  17 |     if (selectedEvidenceId) {\n> 18 |       setLoading(true);\n     |       ^^^^^^^^^^ Avoid calling setState() directly within an effect\n  19 |       // Simulate API Fetch\n  20 |       fetch(`/api/evidence/${selectedEvidenceId}/history`, {\n  21 |         headers: { Authorization: `Bearer ${localStorage.getItem('token')}` },","line":18,"column":7,"nodeType":null,"endLine":18,"endColumn":17}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useEffect, useState } from 'react';\nimport { useDashboard } from '../../../contexts/DashboardContext';\n\ninterface AuditLog {\n  timestamp: string;\n  action: string;\n  details: string;\n  user_email: string;\n}\n\nconst BloodlineBox: React.FC = () => {\n  const { selectedEvidenceId } = useDashboard();\n  const [logs, setLogs] = useState<AuditLog[]>([]);\n  const [loading, setLoading] = useState(false);\n\n  useEffect(() => {\n    if (selectedEvidenceId) {\n      setLoading(true);\n      // Simulate API Fetch\n      fetch(`/api/evidence/${selectedEvidenceId}/history`, {\n        headers: { Authorization: `Bearer ${localStorage.getItem('token')}` },\n      })\n        .then(res => res.json())\n        .then(data => {\n          if (Array.isArray(data)) setLogs(data);\n          else setLogs([]); // Handle error\n        })\n        .catch(err => console.error(err))\n        .finally(() => setLoading(false));\n    } else {\n      // Default global logs (mock for now or fetch global)\n      setLogs([\n        {\n          timestamp: new Date().toISOString(),\n          action: 'SYSTEM_READY',\n          details: 'Dashboard Initialized',\n          user_email: 'system',\n        },\n      ]);\n    }\n  }, [selectedEvidenceId]);\n\n  return (\n    <div className=\"h-full p-4 overflow-hidden flex flex-col\">\n      <h3 className=\"text-gray-400 text-xs font-bold uppercase mb-2 flex items-center justify-between\">\n        <span>Bloodline Tracker (T2)</span>\n        {selectedEvidenceId && <span className=\"text-blue-400\">ID: #{selectedEvidenceId}</span>}\n      </h3>\n      <div className=\"flex-1 overflow-y-auto pr-2 space-y-3\">\n        {loading ? (\n          <div className=\"text-center text-gray-500 text-xs mt-4\">Tracing provenance...</div>\n        ) : logs.length === 0 ? (\n          <div className=\"text-center text-gray-600 text-xs mt-4\">No audit trail found.</div>\n        ) : (\n          logs.map((log, i) => (\n            <div key={i} className=\"flex gap-3 text-xs\">\n              <div className=\"flex flex-col items-center\">\n                <div className=\"w-1.5 h-1.5 rounded-full bg-blue-500\"></div>\n                {i < logs.length - 1 && <div className=\"w-px h-full bg-gray-700 my-1\"></div>}\n              </div>\n              <div className=\"pb-2\">\n                <div className=\"text-gray-300 font-medium\">\n                  {new Date(log.timestamp).toLocaleTimeString([], {\n                    hour: '2-digit',\n                    minute: '2-digit',\n                  })}\n                </div>\n                <div className=\"text-gray-400\">{log.action.replace(/_/g, ' ')}</div>\n                <div className=\"text-gray-500 text-[10px]\">{log.user_email}</div>\n              </div>\n            </div>\n          ))\n        )}\n      </div>\n    </div>\n  );\n};\n\nexport default BloodlineBox;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\bento\\DrillDownExplorer.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\bento\\KpiBox.tsx","messages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\bento\\KpiBox.tsx:14:7\n  12 |     // Simulate fetch\n  13 |     if (dateRange.start) {\n> 14 |       setStats(prev => ({ ...prev, co2e: 3450.1 })); // Demo value\n     |       ^^^^^^^^ Avoid calling setState() directly within an effect\n  15 |     } else {\n  16 |       setStats({ co2e: 15789.5, t1: true, t2: true, t3: true, t4: true });\n  17 |     }","line":14,"column":7,"nodeType":null,"endLine":14,"endColumn":15}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useEffect, useState } from 'react';\nimport { useDashboard } from '../../../contexts/DashboardContext';\n// import { motion } from 'framer-motion';\n\nconst KpiBox: React.FC = () => {\n  const { dateRange } = useDashboard();\n  const [stats, setStats] = useState({ co2e: 15789.5, t1: true, t2: true, t3: true, t4: true });\n\n  useEffect(() => {\n    // Here we would fetch data based on dateRange\n    console.log('KpiBox: Fetching data for', dateRange);\n    // Simulate fetch\n    if (dateRange.start) {\n      setStats(prev => ({ ...prev, co2e: 3450.1 })); // Demo value\n    } else {\n      setStats({ co2e: 15789.5, t1: true, t2: true, t3: true, t4: true });\n    }\n  }, [dateRange]);\n\n  return (\n    <div className=\"p-6 h-full flex flex-col justify-between relative bg-gradient-to-br from-gray-800 to-gray-900\">\n      <div className=\"absolute top-4 right-4 flex space-x-2\">\n        {['T1', 'T2', 'T3', 'T4', 'T5'].map(t => (\n          <div\n            key={t}\n            className={`px-2 py-1 rounded text-xs font-bold ${stats.t1 ? 'bg-green-500/20 text-green-400 border border-green-500/30' : 'bg-gray-700'}`}\n          >\n            {t}\n          </div>\n        ))}\n      </div>\n\n      <div>\n        <h3 className=\"text-gray-400 text-sm font-medium uppercase tracking-wider\">\n          Total Scope 2 Emissions\n        </h3>\n        <div className=\"mt-2 text-5xl font-extrabold text-white flex items-baseline\">\n          {stats.co2e.toLocaleString(undefined, {\n            minimumFractionDigits: 1,\n            maximumFractionDigits: 1,\n          })}\n          <span className=\"ml-2 text-lg text-gray-500 font-normal\">kgCO2e</span>\n        </div>\n      </div>\n\n      <div className=\"grid grid-cols-2 gap-4 mt-4 text-xs text-gray-400\">\n        <div className=\"flex items-center\">\n          <span className=\"w-2 h-2 rounded-full bg-green-500 mr-2\"></span> 100% Traceable to\n          Taipower\n        </div>\n        <div className=\"flex items-center\">\n          <span className=\"w-2 h-2 rounded-full bg-green-500 mr-2\"></span> 100% Locked on Polygon\n        </div>\n        <div className=\"flex items-center col-span-2\">\n          <span className=\"w-2 h-2 rounded-full bg-rose-500 mr-2\"></span> 5T Trustworthy (銝蝭⊥)\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default KpiBox;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\bento\\TrendBox.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 4.","line":45,"column":58,"nodeType":"Literal","messageId":"noMagic","endLine":45,"endColumn":59},{"