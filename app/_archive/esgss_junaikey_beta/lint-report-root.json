g'\n            }`}\n          >\n            <span className=\"text-xl mr-2\">{tab.icon}</span>\n            {tab.label}\n          </button>\n        ))}\n      </div>\n\n      {/* ?批捆? */}\n      {activeTab === 'overview' && <OverviewTab partner={partner} />}\n      {activeTab === 'skills' && <SkillsTab partner={partner} />}\n      {activeTab === 'starchart' && <StarChartTab partner={partner} />}\n      {activeTab === 'cards' && <CardsTab partner={partner} />}\n      {activeTab === 'equipment' && <EquipmentTab partner={partner} />}\n    </div>\n  );\n};\n\n// ========== 蝮質汗璅惜 ==========\nconst OverviewTab: React.FC<{ partner: AIPartner }> = ({ partner }) => (\n  <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n    {/* 撌血嚗丰隡渲?閮?*/}\n    <div className=\"lg:col-span-2 space-y-6\">\n      {/* ?箸鞈? */}\n      <div className=\"nebula-card p-6\">\n        <div className=\"flex items-start gap-6\">\n          <div className=\"w-32 h-32 rounded-full glass-strong flex items-center justify-center text-6xl\">\n            ??\n          </div>\n          <div className=\"flex-1\">\n            <h2 className=\"text-3xl font-bold text-cosmic mb-2\">{partner.name}</h2>\n            <div className=\"flex items-center gap-4 mb-4\">\n              <span className=\"text-2xl font-bold text-yellow-400\">Lv.{partner.level}</span>\n              <div className=\"flex-1\">\n                <div className=\"h-3 glass rounded-full overflow-hidden\">\n                  <div\n                    className=\"h-full bg-gradient-to-r from-purple-500 to-blue-500 glow\"\n                    style={{ width: `${(partner.experience / partner.experienceToNext) * 100}%` }}\n                  />\n                </div>\n                <div className=\"text-xs text-indigo-400 mt-1\">\n                  {partner.experience} / {partner.experienceToNext} EXP\n                </div>\n              </div>\n            </div>\n            <div className=\"grid grid-cols-2 gap-3 text-sm\">\n              <div className=\"glass p-2 rounded\">\n                <span className=\"text-indigo-400\">憭抵釵暺:</span>\n                <span className=\"ml-2 font-bold text-yellow-400\">\n                  {partner.talentPoints.available}\n                </span>\n              </div>\n              <div className=\"glass p-2 rounded\">\n                <span className=\"text-indigo-400\">?∠??園?:</span>\n                <span className=\"ml-2 font-bold text-green-400\">\n                  {partner.growth.cardsCollected}\n                </span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* 撅祆折??*/}\n      <div className=\"nebula-card p-6\">\n        <h3 className=\"text-xl font-bold text-cosmic mb-4\">協議撅祆?/h3>\n        <div className=\"grid grid-cols-2 gap-4\">\n          {Object.entries(partner.attributes).map(([key, value]) => (\n            <div key={key} className=\"glass p-3 rounded-lg\">\n              <div className=\"flex justify-between items-center mb-2\">\n                <span className=\"text-indigo-300 capitalize\">{key}</span>\n                <span className=\"font-bold text-cosmic\">{value}</span>\n              </div>\n              <div className=\"h-2 glass-strong rounded-full overflow-hidden\">\n                <div\n                  className=\"h-full bg-gradient-to-r from-blue-500 to-purple-500\"\n                  style={{ width: `${value}%` }}\n                />\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </div>\n\n    {/* ?喳嚗絞閮?*/}\n    <div className=\"space-y-6\">\n      <div className=\"nebula-card p-6\">\n        <h3 className=\"text-xl font-bold text-cosmic mb-4\">?蝯梯?</h3>\n        <div className=\"space-y-3\">\n          <StatItem icon=\"??\" label=\"??賭蝙?沔" value={partner.growth.totalSkillsUsed} />\n          <StatItem icon=\"??\" label=\"隞餃?摰?\" value={partner.growth.questsCompleted} />\n          <StatItem icon=\"??\" label=\"?∠??園?\" value={partner.growth.cardsCollected} />\n          <StatItem icon=\"??\" label=\"?脰帘憟抒儔\" value={partner.growth.epicAbilitiesUnlocked} />\n          <StatItem icon=\"?﹏" label=\"?唾牧憟抒儔\" value={partner.growth.legendaryAbilitiesUnlocked} />\n        </div>\n      </div>\n    </div>\n  </div>\n);\n\nconst StatItem: React.FC<{ icon: string; label: string; value: number }> = ({\n  icon,\n  label,\n  value,\n}) => (\n  <div className=\"flex items-center justify-between glass p-3 rounded-lg\">\n    <div className=\"flex items-center gap-2\">\n      <span className=\"text-2xl\">{icon}</span>\n      <span className=\"text-indigo-300\">{label}</span>\n    </div>\n    <span className=\"font-bold text-cosmic\">{value}</span>\n  </div>\n);\n\n// ========== ??賣?蝐?==========\nconst SkillsTab: React.FC<{ partner: AIPartner }> = ({ partner }) => {\n  const [skills, setSkills] = useState<Skill[]>([]);\n\n  useEffect(() => {\n    const res = OmniStore.getItem<Skill[]>(OmniNamespace.PARTNER, `${partner.id}_skills`);\n    if (res.success && res.data) {\n      setSkills(res.data);\n    }\n  }, [partner.id]);\n\n  return (\n    <div>\n      <h2 className=\"text-2xl font-bold text-cosmic mb-6\">?? ??賣邦</h2>\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4\">\n        {skills.length > 0 ? (\n          skills.map(skill => (\n            <div\n              key={skill.id}\n              className=\"nebula-card p-6 relative overflow-hidden hover:glass-strong transition-all\"\n            >\n              <div className=\"flex justify-between items-start mb-4\">\n                <div className=\"text-2xl bg-glass p-2 rounded-lg\">??/div>\n                <span className=\"text-xs font-bold px-2 py-1 rounded bg-indigo-900 text-indigo-200\">\n                  Lv.{skill.level}\n                </span>\n              </div>\n              <h3 className=\"font-bold text-lg text-cosmic mb-2\">{skill.name}</h3>\n              <p className=\"text-sm text-indigo-300\">{skill.description}</p>\n              <div className=\"mt-4 pt-4 border-t border-white/10 flex justify-between text-xs text-indigo-400\">\n                <span>鋡怠?: {skill.type}</span>\n                <span>蝔?漲: {skill.rarity}</span>\n              </div>\n            </div>\n          ))\n        ) : (\n          <div className=\"col-span-full text-center py-12 text-indigo-400\">\n            <div className=\"text-4xl mb-2\">?</div>\n            <p>撠??賣??隢?蝥??誑驗算?賢?</p>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n\n// ========== ?璅惜 ==========\nconst StarChartTab: React.FC<{ partner: AIPartner }> = ({ partner }) => (\n  <div>\n    <h2 className=\"text-2xl font-bold text-cosmic mb-6\">潃?憭抵釵?</h2>\n    <div className=\"nebula-card p-8\">\n      <div className=\"text-center\">\n        <div className=\"text-6xl mb-4 twinkle\">??</div>\n        <h3 className=\"text-xl font-bold text-cosmic mb-2\">銝之?頂</h3>\n        <p className=\"text-indigo-300 mb-6\">?亥? ??銵? ???咩</p>\n        <div className=\"grid grid-cols-3 gap-4\">\n          <div className=\"glass p-4 rounded-lg\">\n            <div className=\"text-3xl mb-2\">??</div>\n            <div className=\"font-bold text-cosmic\">?亥??頂</div>\n          </div>\n          <div className=\"glass p-4 rounded-lg\">\n            <div className=\"text-3xl mb-2\">??/div>\n            <div className=\"font-bold text-cosmic\">銵??頂</div>\n          </div>\n          <div className=\"glass p-4 rounded-lg\">\n            <div className=\"text-3xl mb-2\">??</div>\n            <div className=\"font-bold text-cosmic\">?咩?頂</div>\n          </div>\n        </div>\n      </div>\n    </div>\n  </div>\n);\n\n// ========== ?∠?璅惜 ==========\nconst CardsTab: React.FC<{ partner: AIPartner }> = ({ partner }) => {\n  const [cards, setCards] = useState<OmniCard[]>([]);\n\n  useEffect(() => {\n    const res = OmniStore.getItem<OmniCard[]>(OmniNamespace.PARTNER, `${partner.id}_cards`);\n    if (res.success && res.data) {\n      setCards(res.data);\n    }\n  }, [partner.id]);\n\n  return (\n    <div>\n      <h2 className=\"text-2xl font-bold text-cosmic mb-6\">?? 奧秘?∠???/h2>\n      <div className=\"grid grid-cols-2 md:grid-cols-4 lg:grid-cols-6 gap-4\">\n        {cards.length > 0 ? (\n          cards.map(card => (\n            <div\n              key={card.id}\n              className=\"nebula-card p-4 aspect-[2/3] flex flex-col items-center justify-center relative overflow-hidden group hover:scale-105 transition-transform\"\n            >\n              <div className=\"absolute top-1 right-2 text-xs font-bold text-yellow-400\">\n                {card.rarity}\n              </div>\n              <div className=\"text-4xl mb-2\">{card.type === CardType.SKILL ? '??' : '?儭?}</div>\n              <div className=\"text-xs text-indigo-400 text-center font-bold\">{card.name}</div>\n              <div className=\"text-[10px] text-indigo-300 mt-1 text-center\">\n                {card.effects[0]?.description || ''}\n              </div>\n            </div>\n          ))\n        ) : (\n          <div className=\"col-span-full text-center py-12 text-indigo-400\">\n            <div className=\"text-4xl mb-2\">?</div>\n            撠?∠?數據\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n\n// ========== 鋆?璅惜 ==========\nconst EquipmentTab: React.FC<{ partner: AIPartner }> = ({ partner }) => (\n  <div>\n    <h2 className=\"text-2xl font-bold text-cosmic mb-6\">?儭?鋆?系統</h2>\n    <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n      {/* 鋆?瑽賭? */}\n      <div className=\"nebula-card p-6\">\n        <h3 className=\"text-xl font-bold text-cosmic mb-4\">鋆?瑽賭?</h3>\n        <div className=\"space-y-3\">\n          {['weapon', 'armor', 'accessory_1', 'accessory_2', 'artifact'].map(slot => (\n            <div key={slot} className=\"glass p-4 rounded-lg flex items-center gap-4\">\n              <div className=\"w-16 h-16 glass-strong rounded-lg flex items-center justify-center text-3xl\">\n                {slot === 'weapon' && '??'}\n                {slot === 'armor' && '?儭?}\n                {slot.startsWith('accessory') && '??'}\n                {slot === 'artifact' && '??'}\n              </div>\n              <div className=\"flex-1\">\n                <div className=\"font-bold text-cosmic capitalize\">{slot.replace('_', ' ')}</div>\n                <div className=\"text-sm text-indigo-400\">蝛箸局雿?/div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* 鋆??” */}\n      <div className=\"nebula-card p-6\">\n        <h3 className=\"text-xl font-bold text-cosmic mb-4\">鋆??澈</h3>\n        <div className=\"text-center text-indigo-300 py-12\">\n          <div className=\"text-6xl mb-4\">?</div>\n          <p>摰?隞餃??脣?鋆?</p>\n        </div>\n      </div>\n    </div>\n  </div>\n);\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\SystemLogConsole.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\TacticalDashboard.test.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\TacticalDashboard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\TalentPassport.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1250.","line":165,"column":22,"nodeType":"Literal","messageId":"noMagic","endLine":165,"endColumn":26},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 350.","line":165,"column":37,"nodeType":"Literal","messageId":"noMagic","endLine":165,"endColumn":40}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport { User, Award, Briefcase, Zap, Star, TrendingUp, ShieldCheck, Activity } from 'lucide-react';\nimport {\n  Radar,\n  RadarChart,\n  PolarGrid,\n  PolarAngleAxis,\n  PolarRadiusAxis,\n  ResponsiveContainer,\n} from 'recharts';\nimport { ITalentPassport, SourceTaxonomy } from '../types/esgss_schema';\n\n// Mock Data Wrapper (In real app, this would come from props or store)\n// For now, we default to a mock if no data is provided.\nconst MOCK_PASSPORT_DATA: ITalentPassport = {\n  userUuid: 'USR-888-999',\n  alias: 'Dr. Omni',\n  skillsRadar: {\n    strategic: 95,\n    execution: 88,\n    innovation: 92,\n    compliance: 85,\n    leadership: 78,\n  },\n  impactHistory: ['LG-001', 'LG-002', 'LG-003', 'LG-004', 'LG-005'],\n  integrityScore: 0.98,\n};\n\ninterface TalentPassportProps {\n  data?: ITalentPassport;\n}\n\nexport const TalentPassport: React.FC<TalentPassportProps> = ({ data = MOCK_PASSPORT_DATA }) => {\n  // Transform radar data for Recharts\n  const radarData = [\n    { subject: 'Strategic', A: data.skillsRadar.strategic, fullMark: 100 },\n    { subject: 'Execution', A: data.skillsRadar.execution, fullMark: 100 },\n    { subject: 'Innovation', A: data.skillsRadar.innovation, fullMark: 100 },\n    { subject: 'Compliance', A: data.skillsRadar.compliance, fullMark: 100 },\n    { subject: 'Leadership', A: data.skillsRadar.leadership, fullMark: 100 },\n  ];\n\n  return (\n    <div className=\"h-full w-full p-4 grid grid-cols-1 lg:grid-cols-12 gap-4 font-sans text-slate-100 overflow-y-auto\">\n      {/* --- IDENTITY MODULE (Glassmorphism + Static Identity) --- */}\n      {/* Bento Box: Top Left - 4 cols */}\n      <div className=\"lg:col-span-4 bg-slate-900/40 backdrop-blur-md border border-white/10 rounded-3xl p-6 shadow-[0_8px_32px_0_rgba(31,38,135,0.37)] flex flex-col items-center justify-center relative overflow-hidden group\">\n        <div className=\"absolute inset-0 bg-gradient-to-br from-cyan-500/10 via-transparent to-purple-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-700\" />\n\n        {/* Holographic Ring */}\n        <div className=\"relative w-32 h-32 mb-4\">\n          <div className=\"absolute inset-0 rounded-full border-2 border-dashed border-cyan-400/50 animate-[spin_10s_linear_infinite]\" />\n          <div className=\"absolute inset-2 rounded-full border border-purple-400/50 animate-[spin_15s_linear_infinite_reverse]\" />\n          <div className=\"absolute inset-0 flex items-center justify-center\">\n            <div className=\"w-24 h-24 rounded-full bg-slate-800 border-2 border-white/20 flex items-center justify-center overflow-hidden\">\n              <User className=\"w-12 h-12 text-slate-400\" />\n            </div>\n          </div>\n          {/* Status Indicator */}\n          <div className=\"absolute bottom-1 right-2 w-6 h-6 bg-emerald-500 rounded-full border-4 border-slate-900 flex items-center justify-center\">\n            <ShieldCheck className=\"w-3 h-3 text-white\" />\n          </div>\n        </div>\n\n        <h2 className=\"text-2xl font-bold bg-clip-text text-transparent bg-gradient-to-r from-white to-slate-400 tracking-tight\">\n          {data.alias}\n        </h2>\n        <div className=\"font-mono text-xs text-cyan-400 mt-1 bg-cyan-950/30 px-2 py-1 rounded border border-cyan-500/20\">\n          UUID: {data.userUuid}\n        </div>\n\n        <div className=\"mt-6 w-full grid grid-cols-2 gap-2\">\n          <div className=\"bg-white/5 rounded-xl p-3 text-center border border-white/5 hover:border-emerald-500/30 transition-colors\">\n            <div className=\"text-xs text-slate-400 uppercase tracking-wider\">Integrity</div>\n            <div className=\"text-xl font-bold text-emerald-400\">\n              {(data.integrityScore * 100).toFixed(1)}%\n            </div>\n          </div>\n          <div className=\"bg-white/5 rounded-xl p-3 text-center border border-white/5 hover:border-purple-500/30 transition-colors\">\n            <div className=\"text-xs text-slate-400 uppercase tracking-wider\">Impact Assets</div>\n            <div className=\"text-xl font-bold text-purple-400\">{data.impactHistory.length}</div>\n          </div>\n        </div>\n      </div>\n\n      {/* --- RADAR VISUALIZATION (Dynamic Assets) --- */}\n      {/* Bento Box: Top Right - 8 cols */}\n      <div className=\"lg:col-span-8 bg-slate-900/40 backdrop-blur-md border border-white/10 rounded-3xl p-4 shadow-[0_8px_32px_0_rgba(31,38,135,0.37)] flex flex-col\">\n        <div className=\"flex justify-between items-center mb-2 px-2\">\n          <h3 className=\"text-lg font-semibold text-slate-200 flex items-center gap-2\">\n            <Activity className=\"w-5 h-5 text-amber-400\" />\n            Source Taxonomy Profiling\n          </h3>\n          <span className=\"text-xs text-slate-500 border border-slate-700 px-2 py-1 rounded-full\">\n            Live Monitor\n          </span>\n        </div>\n\n        <div className=\"flex-1 w-full min-h-[250px] relative\">\n          <ResponsiveContainer width=\"100%\" height=\"100%\">\n            <RadarChart cx=\"50%\" cy=\"50%\" outerRadius=\"80%\" data={radarData}>\n              <PolarGrid stroke=\"#334155\" />\n              <PolarAngleAxis dataKey=\"subject\" tick={{ fill: '#94a3b8', fontSize: 12 }} />\n              <PolarRadiusAxis angle={30} domain={[0, 100]} tick={false} axisLine={false} />\n              <Radar\n                name=\"Proficiency\"\n                dataKey=\"A\"\n                stroke=\"#06b6d4\"\n                strokeWidth={2}\n                fill=\"#06b6d4\"\n                fillOpacity={0.2}\n              />\n            </RadarChart>\n          </ResponsiveContainer>\n\n          {/* Overlay Stats */}\n          <div className=\"absolute top-0 right-0 p-2 space-y-2\">\n            <div className=\"flex items-center gap-2 text-xs\">\n              <span className=\"w-2 h-2 rounded-full bg-cyan-400\"></span>\n              <span className=\"text-slate-400\">S1 Sensor Data</span>\n            </div>\n            <div className=\"flex items-center gap-2 text-xs\">\n              <span className=\"w-2 h-2 rounded-full bg-purple-400\"></span>\n              <span className=\"text-slate-400\">S5 Inferred Logic</span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* --- ASSET LEDGER (Consolidated Timeline) --- */}\n      {/* Bento Box: Bottom - Full Width */}\n      <div className=\"lg:col-span-12 bg-slate-900/40 backdrop-blur-md border border-white/10 rounded-3xl p-6 shadow-[0_8px_32px_0_rgba(31,38,135,0.37)]\">\n        <h3 className=\"text-lg font-semibold text-slate-200 mb-4 flex items-center gap-2\">\n          <Briefcase className=\"w-5 h-5 text-emerald-400\" />\n          Impact Asset Ledger (Chain of Custody)\n        </h3>\n\n        <div className=\"overflow-x-auto\">\n          <table className=\"w-full text-left border-collapse\">\n            <thead>\n              <tr className=\"border-b border-white/10 text-xs text-slate-500 uppercase tracking-wider\">\n                <th className=\"p-3\">Asset ID</th>\n                <th className=\"p-3\">Type</th>\n                <th className=\"p-3\">Verification</th>\n                <th className=\"p-3 text-right\">Credits</th>\n              </tr>\n            </thead>\n            <tbody className=\"text-sm\">\n              {data.impactHistory.map((id, index) => (\n                <tr key={id} className=\"border-b border-white/5 hover:bg-white/5 transition-colors\">\n                  <td className=\"p-3 font-mono text-cyan-300\">{id}</td>\n                  <td className=\"p-3 text-slate-300\">Carbon Reduction Project #{index + 1}</td>\n                  <td className=\"p-3\">\n                    <span\n                      className={`px-2 py-1 rounded text-xs border ${\n                        index % 2 === 0\n                          ? 'border-emerald-500/30 text-emerald-400 bg-emerald-500/10'\n                          : 'border-amber-500/30 text-amber-400 bg-amber-500/10'\n                      }`}\n                    >\n                      {index % 2 === 0 ? 'S3 Verified' : 'S4 Reported'}\n                    </span>\n                  </td>\n                  <td className=\"p-3 text-right font-mono text-white\">\n                    {1250 + index * 350} <span className=\"text-slate-500 text-xs\">ITK</span>\n                  </td>\n                </tr>\n              ))}\n              {/* Empty State / Filler */}\n              {data.impactHistory.length === 0 && (\n                <tr>\n                  <td colSpan={4} className=\"p-8 text-center text-slate-500\">\n                    No impact assets recorded. Initialize S1-S5 protocols.\n                  </td>\n                </tr>\n              )}\n            </tbody>\n          </table>\n        </div>\n      </div>\n    </div>\n  );\n};\n\n// Default export for lazy loading\nexport default TalentPassport;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\ThinkingChain.tsx","messages":[{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`\"` can be escaped with `&quot;`, `&ldquo;`, `&#34;`, `&rdquo;`.","line":56,"column":76,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&quot;"},"fix":{"range":[2125,2126],"text":"&quot;"},"desc":"Replace with `&quot;`."},{"messageId":"replaceWithAlt","data":{"alt":"&ldquo;"},"fix":{"range":[2125,2126],"text":"&ldquo;"},"desc":"Replace with `&ldquo;`."},{"me