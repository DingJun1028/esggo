e {\n  hotActions: string[];\n  isPending: boolean;\n  recommendations: string[];\n}\n\n/**\n * ?芷????Hook\n *\n * ?芸?追蹤元件鈭支?,???勗漲????遣霅豹n */\nexport function useEvolution(componentId: string): EvolutionState {\n  const [hotActions, setHotActions] = useState<string[]>([]);\n  const [recommendations, setRecommendations] = useState<string[]>([]);\n  const [isPending, startTransition] = useTransition();\n\n  useEffect(() => {\n    // 雿合約?湔 (React 18 Concurrent)\n    startTransition(() => {\n      // ?脣??勗漲??\n      const actions = EvolutionEngine.getHotActions(componentId, 5);\n      setHotActions(actions);\n\n      // 多元核心?芸?撱箄降\n      const suggestions = generateRecommendations(actions);\n      setRecommendations(suggestions);\n    });\n  }, [componentId]);\n\n  return {\n    hotActions,\n    isPending,\n    recommendations,\n  };\n}\n\n/**\n * 多元核心?芸?撱箄降\n */\nfunction generateRecommendations(hotActions: string[]): string[] {\n  const recommendations: string[] = [];\n\n  if (hotActions.length > 0) {\n    recommendations.push(`High-frequency action: ${hotActions[0]}`);\n  }\n\n  if (hotActions.includes('onAiAnalyze')) {\n    recommendations.push('Consider pre-loading AI insights');\n  }\n\n  return recommendations;\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\5-hooks\\useOmniRectification.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\5-hooks\\useSyncDomain.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\5-store\\useOmniResonance.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.8.","line":47,"column":54,"nodeType":"Literal","messageId":"noMagic","endLine":47,"endColumn":57},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":47,"column":60,"nodeType":"Literal","messageId":"noMagic","endLine":47,"endColumn":61},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":58,"column":67,"nodeType":"Literal","messageId":"noMagic","endLine":58,"endColumn":69}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * ?? L5 Omni State Store: useOmniResonance\n * --------------------------------------------------\n * [甈痊] ?? L1 撘???L3 隞??蝬楝敺n * [?寞吞 ?踵?撘銝刻印靘???雿萇?芸?\n */\n\nimport { useState, useEffect } from 'react';\nimport { OmniResonance } from '@infra/index';\n\n// ?桐?撖虫?蝞∠? (Singleton for Engine)\nconst resonanceEngine = new OmniResonance();\n\nexport interface IOmniState {\n  resonance: number;\n  entropy: number;\n  itkTotal: number;\n  pillarStatus: Record<string, 'healthy' | 'syncing'>;\n}\n\nexport const useOmniResonance = () => {\n  // 協議??翰?吭n  const [state, setState] = useState<IOmniState>({\n    resonance: resonanceEngine.getResonance(),\n    entropy: 0.05, // Initial low entropy\n    itkTotal: 0,\n    pillarStatus: {\n      soul: 'healthy',\n      memory: 'healthy',\n      intelligence: 'healthy',\n      tags: 'healthy',\n      crystal: 'healthy',\n    },\n  });\n\n  useEffect(() => {\n    // ?? 撱箇?蟡??郊??? (璅⊥?單?撘???)\n    const syncInterval = setInterval(() => {\n      // ?脣???啣???n      const currentRes = resonanceEngine.getResonance();\n\n      // ?湔??翰??(Object.freeze 蝣箔?銝蝭⊥?批??\n      setState(prevState => ({\n        ...prevState,\n        resonance: currentRes,\n        // 甇方??芯??臬??亦?撖衣? ITK ?????賡???葫\n        itkTotal: prevState.itkTotal + (currentRes > 0.8 ? 5 : 1),\n      }));\n    }, 1000);\n\n    return () => clearInterval(syncInterval);\n  }, []);\n\n  // ?湧 API 靘?L3 元件隤輻\n  return {\n    ...state,\n    // 瘜典??閫貊?梢陷?郊?瘜n    triggerSync: (activity: number) => resonanceEngine.syncIntent(10, activity),\n  };\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\AgentTasks.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\App.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\AppNew.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\agents\\OmniScoutAgent.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3000.","line":20,"column":34,"nodeType":"Literal","messageId":"noMagic","endLine":20,"endColumn":38},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":54,"column":43,"nodeType":"Literal","messageId":"noMagic","endLine":54,"endColumn":44}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * ?儭?奧秘代稱嚗???⊿?驗證 (OmniScout Agent)\n * --------------------------------------------------\n * 協議?瑁嚗???(Auto-Mining)\n * 甇詨惇閫嚗??偶蝥?繚 ????(COO)\n * 協議嚗芋??24/7 ?芸??? ESG ?亥?暺?(KP)\n */\n\nexport interface KnowledgePoint {\n  id: string;\n  domain: 'Environment' | 'Social' | 'Governance';\n  title: string;\n  value: number; // 1-10\n  timestamp: number;\n  source: string;\n}\n\nexport class OmniScoutAgent {\n  private isRunning: boolean = false;\n  private miningRateMs: number = 3000; // Mining speed\n  private accumulatedKP: number = 0;\n\n  constructor(private onKpMined: (kp: KnowledgePoint) => void) {}\n\n  public startMining() {\n    if (this.isRunning) return;\n    this.isRunning = true;\n    console.log('?? OmniScout Agent: Auto-Mining Protocol Activated.');\n\n    this.mineLoop();\n  }\n\n  public stopMining() {\n    this.isRunning = false;\n    console.log('?? OmniScout Agent: Protocol Paused.');\n  }\n\n  private mineLoop() {\n    if (!this.isRunning) return;\n\n    setTimeout(() => {\n      if (!this.isRunning) return;\n\n      const domains = ['Environment', 'Social', 'Governance'] as const;\n      const domain = domains[Math.floor(Math.random() * domains.length)] as\n        | 'Environment'\n        | 'Social'\n        | 'Governance';\n\n      const newKp: KnowledgePoint = {\n        id: crypto.randomUUID(),\n        domain,\n        title: `Auto-Mined ${domain} Intel #${Math.floor(Math.random() * 1000)}`,\n        value: Math.floor(Math.random() * 5) + 1,\n        timestamp: Date.now(),\n        source: 'Deep Web Scraper (COO-Auth)',\n      };\n\n      this.accumulatedKP += newKp.value;\n      this.onKpMined(newKp);\n\n      // Re-trigger loop\n      this.mineLoop();\n    }, this.miningRateMs);\n  }\n\n  public getStatus() {\n    return {\n      isRunning: this.isRunning,\n      totalMined: this.accumulatedKP,\n    };\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\ai\\EvolutionEngine.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.05.","line":24,"column":34,"nodeType":"Literal","messageId":"noMagic","endLine":24,"endColumn":38},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":58,"column":44,"nodeType":"Literal","messageId":"noMagic","endLine":58,"endColumn":45},{"ruleId":"no-useless-catch","severity":2,"message":"Unnecessary try/catch wrapper.","line":79,"column":5,"nodeType":"TryStatement","messageId":"unnecessaryCatch","endLine":98,"endColumn":6}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * 瞍?撘? (Evolution Engine)\n *\n * ?箸奧秘?辣實作?勗? V1.2 蝚砌?蝡n * 撖衣自律?璈 (??銵唳? + ?餌?追蹤)\n */\n\nimport { NCB_CONFIG } from '../types';\nimport { AIOSKernel, KernelEvent } from './core/AIOSKernel';\nimport { omniLogger, LogCategory } from '../services/omniLogger';\n\ninterface InteractionMetric {\n  component: string;\n  event: string;\n  frequency: number;\n  lastUsed: number;\n}\n\n/**\n * 瞍?撘??? (蝎曄陛??\n */\nclass EvolutionEngineService {\n  private metrics = new Map<string, InteractionMetric>();\n  private readonly decayFactor = 0.05; // 弇 銵唳?撣豢 (?勗??砍?)\n\n  /**\n   * 閮?鈭支? (??銵唳??砍?)\n   *\n   * Score_t = Score_{t-1} ? e^(-弇?t) + NewInteraction\n   */\n  track(component: string, event: string): void {\n    const key = `${component}:${event}`;\n    const now = Date.now();\n\n    const metric = this.metrics.get(key) || {\n      component,\n      event,\n      frequency: 0,\n      lastUsed: 0,\n    };\n\n    // ??銵唳?設計\n    const timeDelta = (now - metric.lastUsed) / 1000; // 蝘n    metric.frequency = metric.frequency * Math.exp(-this.decayFactor * timeDelta) + 1;\n    metric.lastUsed = now;\n\n    this.metrics.set(key, metric);\n\n    // ?唳郊?郊??NCB (銝憛蜓蝺?)\n    this.syncToNCB(metric).catch(err => {\n      omniLogger.error(LogCategory.AI, '[EvolutionEngine] Sync failed', { error: err });\n    });\n  }\n\n  /**\n   * ?脣??勗漲?? (Top-K)\n   */\n  getHotActions(component: string, limit = 5): string[] {\n    return Array.from(this.metrics.values())\n      .filter(m => m.component === component)\n      .sort((a, b) => b.frequency - a.frequency)\n      .slice(0, limit)\n      .map(m => m.event);\n  }\n\n  /**\n   * ?脣????璅?(?冽??)\n   */\n  getAllMetrics(): InteractionMetric[] {\n    return Array.from(this.metrics.values());\n  }\n\n  /**\n   * ?郊??NoCodeBackend\n   */\n  private async syncToNCB(metric: InteractionMetric): Promise<void> {\n    if (typeof fetch === 'undefined') return; // SSR 靽風\n\n    try {\n      await fetch(`${NCB_CONFIG.baseUrl}/${NCB_CONFIG.instanceId}/omni_memories`, {\n        method: 'POST',\n        headers: {\n          'xc-auth': NCB_CONFIG.token,\n          'Content-Type': 'application/json',\n        },\n        body: JSON.stringify({\n          key: `evolution:${metric.component}:${metric.event}`,\n          data: JSON.stringify({\n            frequency: metric.frequency,\n            lastUsed: metric.lastUsed,\n          }),\n          timestamp: new Date().toISOString(),\n        }),\n      });\n    } catch (error) {\n      // ??憭望?,銝蔣?踵平??蝔n      throw error;\n    }\n  }\n}\n\nexport const EvolutionEngine = new EvolutionEngineService();\n\n// Initialize: Subscribe to Kernel\nAIOSKernel.subscribe('INTERACTION', (event: KernelEvent) => {\n  const { component, event: action } = event.payload;\n  EvolutionEngine.track(component, action);\n});\n\n// Legacy window integration\nif (typeof window !== 'undefined') {\n  window.addEventListener('omni-interaction', (event: Event) => {\n    const detail = (event as CustomEvent).detail;\n    AIOSKernel.dispatch({\n      type: 'INTERACTION',\n      source: 'DOM_BRIDGE',\n      timestamp: Date.now(),\n      payload: detail,\n    });\n  });\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\ai\\core\\AIOSKernel.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\api\\omniClient.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\api\\verificationClient.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\Academy.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\AdminPanel.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\AgentForge.tsx","messages":[{"ruleId":"react-hooks/immutability","severity":2,"message":"Error: Cannot access variable before it is declared\n\n`loadAgents` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\AgentForge.tsx:23:5\n  21 |\n  22 |   useEffect(() => {\n> 23 |     loadAgents();\n     |     ^^^^^^^^^^ `loadAgents` accessed before it is declared\n  24 |   }, []);\n  25 |\n  26 |   const loadAgents = async () => {\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\AgentForge.tsx:26:3\n  24 |   }, []);\n  25 |\n> 26 |   const loadAgents = async () => {\n     |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 27 |     // Load agents from OmniStore\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 28 |     const agentKeys = OmniStore.listKeys(OmniNamespace.AGENT);\n     ?吒n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 37 |     setAgents(loadedAgents);\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 38 |   };\n     | ^^^^^ `loadAgents` is declared here\n  39 |\n  40 |   const handleCreate = async () => {\n  41 |     try {","line":23,"column":5,"nodeType":null,"endLine":23,"endColumn":15},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.7.","line":49,"column":46,"nodeType":"Literal","messageId":"noMagic","endLine":49,"endColumn":49}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * Agent Forge - 真實?\n * Agent 蝞∠?隞\n */\n\nimport React, { useState, useEffect } from 'react';\nimport { omniClient } from '../api/omniClient';\nimport { OmniStore, OmniNamespace } from '../services/OmniStore';\nimport type { AgentInfo, AgentConfig } from '../../shared/types';\n\nexport const AgentForge: React.FC = () => {\n  const [agents, setAgents] = useState<AgentInfo[]>([]);\n  const [isCreating, setIsCreating] = useState(false);\n  const [newAgent, setNewAgent] = useState<AgentConfig>({\n    name: '',\n    description: '',\n    systemPrompt: '',\n    baseModel: 'gemini-1.5-flash',\n    temperature: 0.7,\n  });\n\n  useEffect(() => {\n    loadAgents();\n  }, []);\n\n  const loadAgents = async () => {\n    // Load agents from OmniStore\n    const agentKeys = OmniStore.listKeys(OmniNamespace.AGENT);\n    const loadedAgents: AgentInfo[] = [];\n\n    agentKeys.forEach(key => {\n      const res = OmniStore.getItem<AgentInfo>(OmniNamespace.AGENT, key);\n      if (res.success && res.data) {\n        loadedAgents.push(res.data);\n      }\n    });\n    setAgents(loadedAgents);\n  };\n\n  const handleCreate = async () => {\n    try {\n      // Local persistence via OmniStore\n      const agentId = `agent_${Date.now()}`;\n      const createdAgent: AgentInfo = {\n        id: agentId,\n        name: newAgent.name,\n        description: newAgent.description,\n        baseModel: newAgent.baseModel || 'gemini-1.5-flash',\n        temperature: newAgent.temperature || 0.7,\n        skills: [],\n        createdAt: new Date(),\n        updatedAt: new Date(),\n      };\n\n      const result = OmniStore.setItem(OmniNamespace.AGENT, agentId, createdAgent);\n      if (result.success) {\n        setIsCreating(false);\n        loadAgents();\n      } else {\n        console.error('?萄遣憭望?:', result.error);\n      }\n    } catch (error) {\n      console.error('?萄遣憭望?:', error);\n    }\n  };\n\n  return (\n    <div className=\"p-6\">\n      <div className=\"flex justify-between items-center mb-6\">\n        <h1 className=\"text-3xl font-bold text-cosmic\">? 真實?</h1>\n        <button onClick={() => setIsCreating(true)} className=\"btn-cosmic px-6 py-3\">\n          ???萄遣??Agent\n        </button>\n      </div>\n\n      {isCreating && (\n        <div className=\"nebula-card p-6 mb-6\">\n          <h2 className=\"text-xl font-bold mb-4 text-cosmic\">?萄遣??Agent</h2>\n          <div className=\"space-y-4\">\n            <input\n              type=\"text\"\n              placeholder=\"Agent ?迂\"\n              value={newAgent.name}\n              onChange={e => setNewAgent({ ...newAgent, name: e.target.value })}\n              className=\"input-cosmic w-full\"\n            />\n            <textarea\n              placeholder=\"?膩\"\n              value={newAgent.description}\n              onChange={e => setNewAgent({ ...newAgent, description: e.target.value })}\n              className=\"input-cosmic w-full\"\n              rows={3}\n            />\n            <textarea\n              placeholder=\"系統?內閰"\n              value={newAgent.systemPrompt}\n              onChange={e => setNewAgent({ ...newAgent, systemPrompt: e.target.value })}\n              className=\"input-cosmic w-full\"\n              rows={5}\n            />\n            <div className=\"flex gap-4\">\n              <button onClick={handleCreate} className=\"btn-cosmic flex-1\">\n                ?萄遣\n              </button>\n              <button\n                onClick={() => setIsCreating(false)}\n                className=\"glass px-6 py-3 rounded-lg flex-1\"\n              >\n                ??\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6\">\n        {agents.map(agent => (\n          <div key={agent.id} className=\"nebula-card p-6\">\n            <h3 className=\"text-xl font-bold text-cosmic mb-2\">{agent.name}</h3>\n            <p className=\"text-indigo-300 text-sm mb-4\">{agent.description}</p>\n            <div className=\"text-xs text-indigo-400\">\n              <div>璅∪?: {agent.baseModel}</div>\n              <div>??? {agent.skills.length} ??/div>\n            </div>\n          </div>\n        ))}\n      </div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\AmbassadorProgram.tsx","messages":[{"ruleId":"react-hooks/immutability","severity":2,"message":"Error: Cannot access variable before it is declared\n\n`loadData` is accessed before it is declared, which prevents the earlier access from updating when this value changes over time.\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\AmbassadorProgram.tsx:11:5\n   9 |\n  10 |   useEffect(() => {\n> 11 |     loadData();\n     |     ^^^^^^^^ `loadData` accessed before it is declared\n  12 |   }, []);\n  13 |\n  14 |   const loadData = async () => {\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\AmbassadorProgram.tsx:14:3\n  12 |   }, []);\n  13 |\n> 14 |   const loadData = async () => {\n     |   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 15 |     const p = await socialEconomyService.getAmbassadorProfile('partner_1');\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 16 |     setProfile(p);\n     | ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\n> 17 |   };\n     | ^^^^^ `loadData` is declared here\n  18 |\n  19 |   const handleJoinFaction = async (faction: Faction) => {\n  20 |     setLoading(true);","line":11,"column":5,"nodeType":null,"endLine":11,"endColumn":13},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":181,"column":76,"nodeType":"Literal","messageId":"noMagic","endLine":181,"endColumn":78},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":203,"column":29,"nodeType":"Literal","messageId":"noMagic","endLine":203,"endColumn":30}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\nimport { socialEconomyService } from '../services/socialEconomyService';\nimport { type AmbassadorProfile, Faction } from '@/types';\nimport { omniClient } from '../api/omniClient';\n\nexport const AmbassadorProgram: React.FC = () => {\n  const [profile, setProfile] = useState<AmbassadorProfile | null>(null);\n  const [loading, setLoading] = useState(false);\n\n  useEffect(() => {\n    loadData();\n  }, []);\n\n  const loadData = async () => {\n    const p = await socialEconomyService.getAmbassadorProfile('partner_1');\n    setProfile(p);\n  };\n\n  const handleJoinFaction = async (faction: Faction) => {\n    setLoading(true);\n    try {\n      await socialEconomyService.joinFaction('partner_1', faction);\n      await loadData();\n      // Trigger animation or sound here\n    } catch (e: any) {\n      alert(e.message);\n    }\n    setLoading(false);\n  };\n\n  const handleSimulateReferral = async () => {\n    if (!profile) return;\n    setLoading(true);\n    await new Promise(r => setTimeout(r, 1000)); // fake delay\n    await socialEconomyService.simulateReferralSuccess('partner_1');\n    await loadData();\n    alert('?? ?剖?嚗?雿憭乩撈雿輻鈭??隢Ⅳ閮餃???嚗?脣?鈭?200 GSC嚗?);\n    setLoading(false);\n  };\n\n  const factionInfo = {\n    [Faction.TERRA_GUARDIANS]: {\n      name: '憭批摰風??,\n      desc: '撠釣?潛憓?霅?(E)嚗?霅瑟ㄝ??瘚瑟?',\n      color: 'from-emerald-500 to-