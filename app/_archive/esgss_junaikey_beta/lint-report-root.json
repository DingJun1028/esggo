n  46 |       evidenceType: 'BLOCKCHAIN_ANCHOR',","line":43,"column":27,"nodeType":null,"endLine":43,"endColumn":37},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 30.","line":43,"column":47,"nodeType":"Literal","messageId":"noMagic","endLine":43,"endColumn":49},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.1.","line":74,"column":42,"nodeType":"Literal","messageId":"noMagic","endLine":74,"endColumn":45}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":5,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from 'react';\nimport { motion } from 'framer-motion';\nimport { Database, Shield, FileText, Activity, Lock, ChevronRight } from 'lucide-react';\n\ninterface AuditLog {\n  id: string;\n  timestamp: string;\n  entityType: 'AGENT' | 'USER' | 'SYSTEM';\n  entityId: string;\n  evidenceType: 'ZKP_COMMITMENT' | 'BLOCKCHAIN_ANCHOR' | 'SWARM_RESULT';\n  summary: string;\n  hash: string;\n  verified: boolean;\n}\n\nconst DataVaultExplorer: React.FC = () => {\n  const [selectedLog, setSelectedLog] = useState<AuditLog | null>(null);\n\n  // Mock Data based on VaultService schema\n  const logs: AuditLog[] = [\n    {\n      id: 'log_001',\n      timestamp: new Date(Date.now() - 1000 * 60 * 5).toISOString(),\n      entityType: 'AGENT',\n      entityId: 'Arvo_Planner',\n      evidenceType: 'SWARM_RESULT',\n      summary: 'Executed strategic planning for \"Carbon Reduction 2026\"',\n      hash: '0x7f83...a2b1',\n      verified: true,\n    },\n    {\n      id: 'log_002',\n      timestamp: new Date(Date.now() - 1000 * 60 * 2).toISOString(),\n      entityType: 'SYSTEM',\n      entityId: 'ZKP_Service',\n      evidenceType: 'ZKP_COMMITMENT',\n      summary: 'Committed sensitive supplier emission data (Scope 3)',\n      hash: '0xabc1...9988',\n      verified: true,\n    },\n    {\n      id: 'log_003',\n      timestamp: new Date(Date.now() - 1000 * 30).toISOString(),\n      entityType: 'SYSTEM',\n      entityId: 'Blockchain_Anchor',\n      evidenceType: 'BLOCKCHAIN_ANCHOR',\n      summary: 'Anchored Batch #4421 to Polygon Amoy',\n      hash: '0x1234...5678',\n      verified: true,\n    },\n  ];\n\n  return (\n    <div className=\"bg-slate-900/50 border border-slate-700/50 rounded-xl p-4 w-full h-full flex flex-col\">\n      <div className=\"flex items-center justify-between mb-4 border-b border-white/5 pb-2\">\n        <h3 className=\"text-sm font-bold text-emerald-300 flex items-center gap-2\">\n          <Database className=\"w-4 h-4\" />\n          DATA VAULT EXPLORER\n        </h3>\n        <div className=\"flex items-center gap-1 text-[10px] bg-emerald-900/30 text-emerald-400 px-2 py-0.5 rounded-full border border-emerald-500/20\">\n          <Shield className=\"w-3 h-3\" />\n          AUDIT TRAIL SECURE\n        </div>\n      </div>\n\n      <div className=\"flex-1 flex gap-4 overflow-hidden\">\n        {/* Timeline List */}\n        <div className=\"flex-1 overflow-y-auto space-y-3 pr-2\">\n          {logs.map((log, idx) => (\n            <motion.div\n              key={log.id}\n              initial={{ opacity: 0, x: -10 }}\n              animate={{ opacity: 1, x: 0 }}\n              transition={{ delay: idx * 0.1 }}\n              onClick={() => setSelectedLog(log)}\n              className={`p-3 rounded-lg border cursor-pointer transition-all ${\n                selectedLog?.id === log.id\n                  ? 'bg-indigo-600/20 border-indigo-500/50'\n                  : 'bg-white/5 border-white/10 hover:bg-white/10'\n              }`}\n            >\n              <div className=\"flex items-center justify-between mb-1\">\n                <span\n                  className={`text-[10px] font-bold px-1.5 py-0.5 rounded ${\n                    log.evidenceType === 'ZKP_COMMITMENT'\n                      ? 'bg-purple-500/20 text-purple-300'\n                      : log.evidenceType === 'BLOCKCHAIN_ANCHOR'\n                        ? 'bg-emerald-500/20 text-emerald-300'\n                        : 'bg-blue-500/20 text-blue-300'\n                  }`}\n                >\n                  {log.evidenceType.replace('_', ' ')}\n                </span>\n                <span className=\"text-[10px] text-slate-500\">\n                  {new Date(log.timestamp).toLocaleTimeString()}\n                </span>\n              </div>\n              <p className=\"text-xs text-slate-300 line-clamp-2\">{log.summary}</p>\n            </motion.div>\n          ))}\n        </div>\n\n        {/* Detail View */}\n        <div className=\"w-1/2 bg-black/20 rounded-lg p-3 border border-white/5 font-mono text-xs text-slate-400\">\n          {selectedLog ? (\n            <div className=\"space-y-3\">\n              <div>\n                <label className=\"block text-[10px] text-slate-600 uppercase\">Entity</label>\n                <div className=\"text-white flex items-center gap-2\">\n                  {selectedLog.entityType === 'AGENT' && <Activity className=\"w-3 h-3\" />}\n                  {selectedLog.entityType === 'SYSTEM' && <Lock className=\"w-3 h-3\" />}\n                  {selectedLog.entityId}\n                </div>\n              </div>\n              <div>\n                <label className=\"block text-[10px] text-slate-600 uppercase\">\n                  Cryptographic Hash\n                </label>\n                <div className=\"text-emerald-400 break-all\">{selectedLog.hash}</div>\n              </div>\n              <div>\n                <label className=\"block text-[10px] text-slate-600 uppercase\">\n                  Verification Status\n                </label>\n                <div className=\"flex items-center gap-1 text-emerald-400\">\n                  <Shield className=\"w-3 h-3\" /> Verified Immutable\n                </div>\n              </div>\n            </div>\n          ) : (\n            <div className=\"h-full flex flex-col items-center justify-center text-center opacity-50\">\n              <Database className=\"w-8 h-8 mb-2\" />\n              <p>Select an event to inspect cryptographic evidence</p>\n            </div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default DataVaultExplorer;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\DebugDashboard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\DisclosureDashboard.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":47,"column":23,"nodeType":"Literal","messageId":"noMagic","endLine":47,"endColumn":24},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 428.","line":53,"column":38,"nodeType":"Literal","messageId":"noMagic","endLine":53,"endColumn":41},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 15000.","line":54,"column":38,"nodeType":"Literal","messageId":"noMagic","endLine":54,"endColumn":43},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 8.","line":162,"column":51,"nodeType":"Literal","messageId":"noMagic","endLine":162,"endColumn":52}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * 🏛️?剔內?銵冽 (Disclosure Dashboard)\n * --------------------------------------------------\n * [協議隞餃?] 靽∩遙??嚗?數據????5T 霅??脰??雿?蝞晞n * [5T HUD] T1(皞舀?), T2(頩方楚), T3(透明), T4(?舀?), T5(靽∪祕)\n */\n\nimport React from 'react';\nimport { DisclosureWrapper } from '../ui/DisclosureWrapper';\nimport { OmniBase } from '../../core/OmniBase';\nimport { LogCategory, omniLogger } from '../../omni/infrastructure/logging/OmniLogger';\n\n// 璅⊥銝??蝷箄??元件協議\nclass MockEsgData extends OmniBase {\n  public value: number;\n  public unit: string;\n\n  constructor(value: number, unit: string) {\n    super('7.0.0', 'IoT_Sensor_Gateway_01');\n    this.value = value;\n    this.unit = unit;\n\n    // 璅⊥??望??曉?瘜典\n    this.addLifecycleHook('anchored', 'IoT_Sensor_Gateway_01', {\n      standard: 'ISO-14064-1',\n      path: 'Sensor -> Edge -> Core',\n    });\n  }\n}\n\nexport const DisclosureDashboard: React.FC = () => {\n  const [isGenerating, setIsGenerating] = React.useState(false);\n  const [progress, setProgress] = React.useState(0);\n  const [showDownload, setShowDownload] = React.useState(false);\n\n  const startGeneration = () => {\n    setIsGenerating(true);\n    setProgress(0);\n    const interval = setInterval(() => {\n      setProgress(prev => {\n        if (prev >= 100) {\n          clearInterval(interval);\n          setIsGenerating(false);\n          setShowDownload(true);\n          return 100;\n        }\n        return prev + 5;\n      });\n    }, 100);\n  };\n\n  // 璅⊥撖行?數據\n  const carbonData = new MockEsgData(428, 'TonCO2e');\n  const energyData = new MockEsgData(15000, 'kWh');\n\n  // T1: Formula Expansion (Mock)\n  const renderFormula = () => (\n    <div className=\"bg-slate-900 p-4 rounded-lg border border-slate-700 font-mono text-xs text-slate-300\">\n      <div className=\"text-amber-400 mb-2\">[T1] Calculable (?舫?蝞?</div>\n      <div>E = 峉(Activity_Data ? Emission_Factor)</div>\n      <div className=\"text-slate-500 mt-1\">Ref: [IPCC-2006-V2]</div>\n    </div>\n  );\n\n  // T2: Traceability Topology (Mock)\n  const renderTopology = () => (\n    <div className=\"bg-slate-900 p-4 rounded-lg border border-slate-700 font-mono text-xs text-slate-300\">\n      <div className=\"text-blue-400 mb-2\">[T2] Traceable (?舀滲皞?</div>\n      <div className=\"flex items-center gap-2\">\n        <span className=\"bg-slate-800 px-2 py-1 rounded\">IoT Sensor</span>\n        <span>??/span>\n        <span className=\"bg-slate-800 px-2 py-1 rounded\">Edge Gateway</span>\n        <span>??/span>\n        <span className=\"bg-emerald-900/50 px-2 py-1 rounded text-emerald-300\">Omni Core</span>\n      </div>\n    </div>\n  );\n\n  return (\n    <div className=\"p-6 bg-slate-950 min-h-screen text-slate-200\" id=\"disclosure-dashboard\">\n      <header className=\"mb-8 border-b border-slate-800 pb-4 flex justify-between items-end\">\n        <div>\n          <h1 className=\"text-3xl font-bold bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent\">\n            永續?勗??豢撖怠像??(銝?萄???\n          </h1>\n          <p className=\"text-slate-400 mt-2 text-sm max-w-2xl\">\n            To Reveal is to Be. 瘥?蝑??舫???蝝n          </p>\n        </div>\n\n        <div className=\"flex flex-col items-end gap-3\">\n          {isGenerating ? (\n            <div className=\"w-64 space-y-2\">\n              <div className=\"flex justify-between text-[10px] font-mono text-emerald-400\">\n                <span>GENERATING REPORT...</span>\n                <span>{progress}%</span>\n              </div>\n              <div className=\"h-1 bg-slate-800 rounded-full overflow-hidden\">\n                <div\n                  className=\"h-full bg-emerald-500 transition-all duration-300\"\n                  style={{ width: `${progress}%` }}\n                />\n              </div>\n            </div>\n          ) : showDownload ? (\n            <button\n              onClick={() => setShowDownload(false)}\n              className=\"px-6 py-2 bg-emerald-600 hover:bg-emerald-500 text-white rounded-lg text-sm font-bold shadow-lg shadow-emerald-900/20 transition-all\"\n            >\n              銝?撌脣????(PDF)\n            </button>\n          ) : (\n            <button\n              onClick={startGeneration}\n              className=\"px-6 py-2 bg-gradient-to-r from-emerald-600 to-cyan-600 hover:from-emerald-500 hover:to-cyan-500 text-white rounded-lg text-sm font-bold shadow-lg shadow-cyan-900/20 transition-all animate-pulse\"\n            >\n              銝?萄????芸??啣神?勗?\n            </button>\n          )}\n        </div>\n      </header>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-8\">\n        {/* Left Column: 4T HUD Visualizations */}\n        <div className=\"space-y-6\">\n          <h2 className=\"text-xl font-semibold text-slate-100 mb-4\">?儭?5T Trust Foundry</h2>\n          {renderFormula()}\n          {renderTopology()}\n\n          {/* T3 & T4 Status */}\n          <div className=\"grid grid-cols-2 gap-4\">\n            <div className=\"bg-slate-900 p-4 rounded-lg border border-slate-700\">\n              <div className=\"text-purple-400 text-xs mb-1\">[T3] Trackable</div>\n              <div className=\"text-2xl font-bold\">100%</div>\n              <div className=\"text-[10px] text-slate-500\">Lifecycle Coverage</div>\n            </div>\n            <div className=\"bg-slate-900 p-4 rounded-lg border border-slate-700\">\n              <div className=\"text-red-400 text-xs mb-1\">[T4] Immutable</div>\n              <div className=\"text-2xl font-bold\">LOCKED</div>\n              <div className=\"text-[10px] text-slate-500\">Hash Verified</div>\n            </div>\n          </div>\n        </div>\n\n        {/* Right Column: Live Data with Disclosure Wrapper */}\n        <div className=\"space-y-6\">\n          <h2 className=\"text-xl font-semibold text-slate-100 mb-4\">\n            ??Omni-Components (Hover to Reveal)\n          </h2>\n\n          <DisclosureWrapper data={carbonData}>\n            <div className=\"bg-gradient-to-br from-emerald-900/20 to-slate-900 p-6 rounded-xl border border-emerald-500/30\">\n              <h3 className=\"text-sm uppercase tracking-wider text-slate-400 mb-2\">\n                Total Carbon Emission\n              </h3>\n              <div className=\"text-5xl font-bold text-white tracking-tight\">\n                {carbonData.value}{' '}\n                <span className=\"text-lg text-emerald-400 font-normal\">{carbonData.unit}</span>\n              </div>\n              <div className=\"mt-4 flex gap-2\">\n                <span className=\"text-[10px] px-2 py-1 bg-slate-800 rounded text-slate-400\">\n                  UUID: {carbonData.uuid.slice(0, 8)}\n                </span>\n                <span className=\"text-[10px] px-2 py-1 bg-emerald-900/50 rounded text-emerald-300\">\n                  VERIFIED\n                </span>\n              </div>\n            </div>\n          </DisclosureWrapper>\n\n          <DisclosureWrapper data={energyData}>\n            <div className=\"bg-gradient-to-br from-blue-900/20 to-slate-900 p-6 rounded-xl border border-blue-500/30\">\n              <h3 className=\"text-sm uppercase tracking-wider text-slate-400 mb-2\">\n                Energy Consumption\n              </h3>\n              <div className=\"text-5xl font-bold text-white tracking-tight\">\n                {energyData.value.toLocaleString()}{' '}\n                <span className=\"text-lg text-blue-400 font-normal\">{energyData.unit}</span>\n              </div>\n            </div>\n          </DisclosureWrapper>\n        </div>\n      </div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\EduDashboard.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.05.","line":121,"column":42,"nodeType":"Literal","messageId":"noMagic","endLine":121,"endColumn":46},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.1.","line":121,"column":48,"nodeType":"Literal","messageId":"noMagic","endLine":121,"endColumn":51},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.05.","line":121,"column":53,"nodeType":"Literal","messageId":"noMagic","endLine":121,"endColumn":57}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React from 'react';\nimport { useAuth } from '../../contexts/AuthContext';\nimport {\n  Key,\n  School,\n  Hub,\n  Description,\n  Monitoring,\n  VerifiedUser,\n  MenuBook,\n  PlayCircle,\n  ShieldWithHeart,\n  Layers,\n  Link as LinkIcon,\n  Verified,\n  Route,\n  Visibility,\n  AccountTree,\n  Lightbulb,\n  SupportAgent,\n  TrendingUp,\n  Activity,\n  Clock,\n  CheckCircle2,\n} from 'lucide-react';\nimport { motion } from 'framer-motion';\n\n/**\n * ?? My ESG Dashboard (1.1) - Education-Oriented Service Portal\n * --------------------------------------------------\n * Entry point for new users to learn the 5T Logic and ESG workflow.\n * Features a guiding tone and visual 5T architecture.\n */\nexport const EduDashboard = () => {\n  const { profile } = useAuth();\n  const isZh = true; // Defaulting to Zh for this specific layout\n\n  return (\n    <div className=\"bg-[#050d0d] text-white min-h-screen font-display overflow-x-hidden relative selection:bg-[#0ABAB5]/30\">\n      {/* Background Glows */}\n      <div className=\"fixed top-[-5%] left-[-5%] w-[50%] h-[50%] bg-[#0ABAB5]/5 rounded-full blur-[140px] pointer-events-none -z-10\" />\n      <div className=\"fixed bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-[#0ABAB5]/10 rounded-full blur-[120px] pointer-events-none -z-10\" />\n      <div className=\"fixed inset-0 bg-[radial-gradient(circle_at_50%_-20%,_#0a2e2d_0%,_#050d0d_100%)] -z-20\" />\n\n      <main className=\"flex-1 overflow-y-auto scroll-smooth\">\n        {/* Header */}\n        <header className=\"sticky top-0 z-30 backdrop-blur-md bg-[#050d0d]/60 border-b border-white/5 px-8 py-4 flex items-center justify-between\">\n          <div className=\"flex items-center gap-6\">\n            <h2 className=\"text-lg font-bold flex items-center gap-2 uppercase tracking-tight\">\n              <MenuBook className=\"text-[#0ABAB5] w-5 h-5\" />\n              1.1 ?犖ESG?銵冽 (?飛??????\n            </h2>\n            <div className=\"h-4 w-px bg-white/10 hidden md:block\" />\n            <div className=\"hidden lg:flex gap-6 text-sm text-white/60\">\n              <a\n                className=\"hover:text-[#0ABAB5] transition-colors text-white font-medium border-b-2 border-[#0ABAB5] pb-4 -mb-[18px]\"\n                href=\"#\"\n              >\n                ??璁汗\n              </a>\n              <a className=\"hover:text-[#0ABAB5] transition-colors\" href=\"#\">\n                5T 協議閫??\n              </a>\n              <a className=\"hover:text-[#0ABAB5] transition-colors\" href=\"#\">\n                ??撘?\n              </a>\n            </div>\n          </div>\n          <div className=\"flex items-center gap-4\">\n            <div className=\"flex items-center gap-3 bg-white/5 rounded-full pl-2 pr-4 py-1 border border-white/10\">\n              <div\n                className=\"w-8 h-8 rounded-full bg-cover bg-center border border-[#0ABAB5]/40\"\n                style={{\n                  backgroundImage: `url('https://lh3.googleusercontent.com/aida-public/AB6AXuDdkmUJEj75FAwy5PCCpnK2ghFTO7TdV3GBEPi5HYcCFH9NAMigqu_wvLSrmAoiVuXEl5WS8hBByoFAnHwtK8oSkmqnn6G6trpkmfpuc5isUN1NI_B9hqwv3seINAtA_pq_YNx786pWvq20xnlY_tD6Eth5MaivRvfvFuSa2jYENb-JAjwuYuvTRDh1_UZyCzJjgtUDMolYR62-Q-U6JQr2kawHnqY2-bR353q1rfeKbHj5rd2DgI_3MyvhcO-bjt4V0YhWBHtB5Gg')`,\n                }}\n              />\n              <span className=\"text-sm font-bold truncate max-w-[100px]\">\n                {profile?.displayName || 'DingJun Hong'}\n              </span>\n            </div>\n          </div>\n        </header>\n\n        <div className=\"p-8 max-w-7xl mx-auto relative z-10 space-y-10\">\n          {/* Welcome Hero Section */}\n          <section className=\"backdrop-blur-2xl bg-white/[0.04] rounded-3xl p-10 relative overflow-hidden group border border-[#0ABAB5]/20 shadow-2xl\">\n            <div className=\"absolute -right-20 -top-20 w-96 h-96 bg-[#0ABAB5]/10 rounded-full blur-[100px]\" />\n            <div className=\"relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center\">\n              <div>\n                <div className=\"flex items-center gap-2 mb-4\">\n                  <span className=\"px-3 py-1 bg-[#0ABAB5]/20 text-[#0ABAB5] text-[10px] font-bold rounded-full tracking-widest uppercase\">\n                    Service Introduction\n                  </span>\n                </div>\n                <h1 className=\"text-4xl font-black mb-6 leading-tight\">\n                  甇∟?雿輻{' '}\n                  <span className=\"text-[#0ABAB5] brightness-125 [text-shadow:0_0_15px_rgba(10,186,181,0.6)]\">\n                    JunAiKey\n                  </span>\n                  <br />\n                  ESG ?訾?頧???系統\n                </h1>\n                <p className=\"text-white/70 text-lg leading-relaxed mb-8\">\n                  ?銝???箸???撠? ESG\n                  ?銵冽????銴??偶蝥??頧??箸??潛?閫????T\n                  協議合約??撟怠?典?鞈撖阡??批?潘?瑽遣透明銝追蹤???脣?潮?蝟颯n                </p>\n                <div className=\"flex gap-4\">\n                  <button className=\"bg-[#0ABAB5] text-[#050d0d] px-8 py-3 rounded-xl font-bold hover:shadow-[0_0_20px_rgba(10,186,181,0.4)] transition-all flex items-center gap-2\">\n                    <PlayCircle className=\"w-5 h-5\" />\n                    ??撘??飛\n                  </button>\n                  <button className=\"bg-white/5 border border-white/10 px-8 py-3 rounded-xl font-bold hover:bg-white/10 transition-all\">\n                    系統??銝?\n                  </button>\n                </div>\n              </div>\n              <div className=\"relative flex justify-center\">\n                <div className=\"w-72 h-72 rounded-full border-2 border-[#0ABAB5]/30 flex items-center justify-center relative\">\n                  <motion.div\n                    animate={{ opacity: [0.05, 0.1, 0.05] }}\n                    transition={{ repeat: Infinity, duration: 4 }}\n                    className=\"absolute inset-0 bg-[#0ABAB5]/5 rounded-full\"\n                  />\n                  <div className=\"w-60 h-60 rounded-full border border-[#0ABAB5]/40 flex flex-col items-center justify-center text-center p-6 backdrop-blur-sm bg-white/5\">\n                    <ShieldWithHeart className=\"text-[#0ABAB5] w-12 h-12 mb-2\" />\n                    <p className=\"text-[#0ABAB5] font-bold\">協議?孵?/p>\n                    <p className=\"text-[10px] text-white/50 mt-1 uppercase tracking-widest leading-none\">\n                      Trust & Transparency\n                    </p>\n                  </div>\n                  <div className=\"absolute -top-4 bg-[#050d0d] border border-[#0ABAB5]/40 p-2 rounded-lg text-[10px] font-bold text-[#0ABAB5] shadow-xl\">\n                    TANGIBLE\n                  </div>\n                  <div className=\"absolute -right-8 top-1/2 bg-[#050d0d] border border-[#0ABAB5]/40 p-2 rounded-lg text-[10px] font-bold text-[#0ABAB5] shadow-xl\">\n                    TRACEABLE\n                  </div>\n                  <div className=\"absolute -bottom-4 bg-[#050d0d] border border-[#0ABAB5]/40 p-2 rounded-lg text-[10px] font-bold text-[#0ABAB5] shadow-xl\">\n                    TRANSPARENT\n                  </div>\n                </div>\n              </div>\n            </div>\n          </section>\n\n          {/* 5T Logic Cards Section */}\n          <section className=\"space-y-6\">\n            <div className=\"flex items-center justify-between\">\n              <div>\n                <h2 className=\"text-2xl font-bold\">\n                  5T 協議?閫??{' '}\n                  <span className=\"text-[#0ABAB5] font-mono text-lg ml-2\">\n                    / 5T Logic Architecture\n                  </span>\n                </h2>\n                <p className=\"text-white/50 text-sm mt-1\">?圾數據???偶蝥?頛荔??航???蝚砌?甇?/p>\n              </div>\n              <div className=\"flex items-center gap-2 text-xs font-mono text-[#0ABAB5]\">\n                <span className=\"w-2 h-2 rounded-full bg-[#0ABAB5] animate-pulse\" />\n                LIVE NODES ACTIVE\n              </div>\n            </div>\n            <div className=\"grid grid-cols-1 md:grid-cols-5 gap-4 relative\">\n              <div className=\"absolute top-1/2 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-[#0ABAB5]/50 to-transparent opacity-20 hidden md:block\" />\n              {[\n                {\n                  name: '1. 撖阡???(Tangible)',\n                  desc: '撠４甈?蝬鞈頧??箏霅?雿?霅?,\n                  icon: Layers,\n                  status: 'STATUS: SYNCED',\n                },\n                {\n                  name: '2. ?舀滲皞?(Traceable)',\n                  desc: '閮?靘???銝?啁?嚗Ⅱ靽??皞?撖血??,\n                  icon: LinkIcon,\n                  status: 'NODES: 128',\n                },\n                {\n                  name: '3. 可信鞈?(Trustworthy)',\n                  desc: '???憛?????嚗?????舐砥?寞扼?,\n                  icon: Verified,\n                  status: 'HASH-LOCKED',\n                  active: true,\n                },\n                {\n                  name: '4. 可追蹤(Trackable)',\n                  desc: '?典予??抒４???隅?ｇ?蝎暹?????????,\n                  icon: Route,\n                  status: 'REAL-TIME',\n                },\n                {\n                  name: '5. 透明??(Transparent)',\n                  desc: '?祇????祟閮???撱箇?撣??曆縑隞颯?,\n                  icon: Visibility,\n                  status: 'AUDIT READY',\n                },\n              ].map((item, i) => (\n                <div\n                  key={i}\n                  className={`backdrop-blur-xl bg-white/[0.04] rounded-2xl p-6 relative group border transition-all cursor-help ${item.active ? 'border-[#0ABAB5]/60 bg-[#0ABAB5]/5 shadow-[0_0_15px_rgba(10,186,181,0.2)]' : 'border-white/10 hover:border-[#0ABAB5]/50 hover:bg-[#0ABAB5]/5'}`}\n                >\n                  <div