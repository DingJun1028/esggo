 { useState, useMemo } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport {\n  Flame,\n  Trophy,\n  Star,\n  Target,\n  CheckCircle,\n  Clock,\n  Gift,\n  Users,\n  TrendingUp,\n  Zap,\n  Medal,\n  Crown,\n  Calendar,\n  Award,\n  Sparkles,\n  ChevronRight,\n  Play,\n  Lock,\n  RefreshCw,\n} from 'lucide-react';\nimport { omniLogger, LogCategory } from '@/omni/infrastructure/logging/OmniLogger';\nimport { v4 as uuidv4 } from 'uuid';\nimport { useEffect } from 'react';\n\n// ============================================================================\n// Types\n// ============================================================================\n\nexport interface ITKScore {\n  total: number;\n  breakdown: {\n    insight: number; // I - 瘣??n    trustworthiness: number; // T - 可信摨吒n    kindness: number; // K - ??敶梢\n  };\n  level: number;\n  title: string;\n  nextLevelXP: number;\n  currentXP: number;\n}\n\nexport interface Quest {\n  id: string;\n  title: string;\n  description: string;\n  type: 'daily' | 'weekly' | 'achievement' | 'challenge';\n  category: 'learning' | 'action' | 'social' | 'reporting';\n  xpReward: number;\n  progress: number;\n  target: number;\n  isCompleted: boolean;\n  deadline?: Date;\n  icon: React.ReactNode;\n}\n\nexport interface Badge {\n  id: string;\n  name: string;\n  description: string;\n  icon: string;\n  rarity: 'common' | 'rare' | 'epic' | 'legendary';\n  unlockedAt?: Date;\n  isUnlocked: boolean;\n  requirement: string;\n}\n\nexport interface LeaderboardEntry {\n  rank: number;\n  userId: string;\n  name: string;\n  avatar: string;\n  itkScore: number;\n  level: number;\n  title: string;\n  isCurrentUser: boolean;\n}\n\n// ============================================================================\n// Constants\n// ============================================================================\n\n// Custom icons (to avoid hoisting issues)\nconst BookOpenIcon = ({ size }: { size: number }) => (\n  <svg\n    width={size}\n    height={size}\n    viewBox=\"0 0 24 24\"\n    fill=\"none\"\n    stroke=\"currentColor\"\n    strokeWidth=\"2\"\n  >\n    <path d=\"M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z\" />\n    <path d=\"M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z\" />\n  </svg>\n);\n\nconst CalculatorIcon = ({ size }: { size: number }) => (\n  <svg\n    width={size}\n    height={size}\n    viewBox=\"0 0 24 24\"\n    fill=\"none\"\n    stroke=\"currentColor\"\n    strokeWidth=\"2\"\n  >\n    <rect x=\"4\" y=\"2\" width=\"16\" height=\"20\" rx=\"2\" />\n    <line x1=\"8\" y1=\"6\" x2=\"16\" y2=\"6\" />\n  </svg>\n);\n\nconst LEVEL_TITLES = [\n  { level: 1, title: '永續?唳?', minXP: 0 },\n  { level: 2, title: '?唬?摮詨?', minXP: 100 },\n  { level: 3, title: '蝣唾雲頝∠鈭?, minXP: 300 },\n  { level: 4, title: 'ESG ?Ｙ揣??, minXP: 600 },\n  { level: 5, title: '永續撖西?摰?, minXP: 1000 },\n  { level: 6, title: '蝬真實', minXP: 1500 },\n  { level: 7, title: '敶梢?之雿?, minXP: 2200 },\n  { level: 8, title: '永續??', minXP: 3000 },\n  { level: 9, title: '?啁?摰風??, minXP: 4000 },\n  { level: 10, title: '?喳??貊?', minXP: 5500 },\n] as const;\n\nconst MOCK_QUESTS: Quest[] = [\n  {\n    id: 'daily-1',\n    title: '摰?蝣唾雲頝∟?蝞?,\n    description: '雿輻蝣喟?亙極?瑁?蝞??暑邏輯蝣單???,\n    type: 'daily',\n    category: 'action',\n    xpReward: 20,\n    progress: 1,\n    target: 1,\n    isCompleted: true,\n    icon: <CalculatorIcon size={16} />,\n  },\n  {\n    id: 'daily-2',\n    title: '?梯? ESG ?啗?',\n    description: '?梯? 3 蝭???ESG ?啗?',\n    type: 'daily',\n    category: 'learning',\n    xpReward: 15,\n    progress: 2,\n    target: 3,\n    isCompleted: false,\n    icon: <BookOpenIcon size={16} />,\n  },\n  {\n    id: 'daily-3',\n    title: '???亥???',\n    description: '摰?隞永續?亥?皜祇?',\n    type: 'daily',\n    category: 'learning',\n    xpReward: 25,\n    progress: 0,\n    target: 1,\n    isCompleted: false,\n    icon: <Zap size={16} />,\n  },\n  {\n    id: 'weekly-1',\n    title: '靘???ESG 撖拇',\n    description: '摰? 5 摰嗡?????ESG 閰?撖拇',\n    type: 'weekly',\n    category: 'action',\n    xpReward: 100,\n    progress: 3,\n    target: 5,\n    isCompleted: false,\n    deadline: new Date(Date.now() + 3 * 24 * 60 * 60 * 1000),\n    icon: <Target size={16} />,\n  },\n  {\n    id: 'weekly-2',\n    title: '?澈永續??',\n    description: '?函冗蝢文?鈭?3 蝭偶蝥撠?,\n    type: 'weekly',\n    category: 'social',\n    xpReward: 50,\n    progress: 1,\n    target: 3,\n    isCompleted: false,\n    deadline: new Date(Date.now() + 3 * 24 * 60 * 60 * 1000),\n    icon: <Users size={16} />,\n  },\n  {\n    id: 'achieve-1',\n    title: '蝣喃葉????,\n    description: '摰??砍擐活摰蝣喟??,\n    type: 'achievement',\n    category: 'reporting',\n    xpReward: 500,\n    progress: 1,\n    target: 1,\n    isCompleted: true,\n    icon: <Award size={16} />,\n  },\n];\n\nconst MOCK_BADGES: Badge[] = [\n  {\n    id: 'b1',\n    name: '擐活?餃',\n    description: '??永續??',\n    icon: '?',\n    rarity: 'common',\n    isUnlocked: true,\n    unlockedAt: new Date('2024-01-01'),\n    requirement: '摰?撣唾?閮餃?',\n  },\n  {\n    id: 'b2',\n    name: '蝣唾雲頝⊿?鈭?,\n    description: '摰? 10 甈∠４??蝞?,\n    icon: '?',\n    rarity: 'common',\n    isUnlocked: true,\n    unlockedAt: new Date('2024-02-15'),\n    requirement: '蝝航?設計 10 甈∠４??,\n  },\n  {\n    id: 'b3',\n    name: '?亥?瘛萄?',\n    description: '?梯? 50 蝭?ESG ?啗?',\n    icon: '??',\n    rarity: 'rare',\n    isUnlocked: true,\n    unlockedAt: new Date('2024-03-01'),\n    requirement: '蝝航??梯? 50 蝭??,\n  },\n  {\n    id: 'b4',\n    name: '蝷曄黎敶梢??,\n    description: '?澈?批捆?脣? 100 甈∩???,\n    icon: '??',\n    rarity: 'rare',\n    isUnlocked: false,\n    requirement: '?脣? 100 甈⊥?霈??澈',\n  },\n  {\n    id: 'b5',\n    name: '永續?勗?憭批葦',\n    description: '摰?摰永續?勗?',\n    icon: '??',\n    rarity: 'epic',\n    isUnlocked: false,\n    requirement: '?澆?蝬?霅?永續?勗?',\n  },\n  {\n    id: 'b6',\n    name: '瘛券真實',\n    description: '體驗蝣喃葉?璅?,\n    icon: '??',\n    rarity: 'legendary',\n    isUnlocked: false,\n    requirement: '?砍體驗蝣喃葉??,\n  },\n];\n\nconst MOCK_LEADERBOARD: LeaderboardEntry[] = [\n  {\n    rank: 1,\n    userId: 'u1',\n    name: '?偶蝥?,\n    avatar: '????,\n    itkScore: 4850,\n    level: 9,\n    title: '?啁?摰風??,\n    isCurrentUser: false,\n  },\n  {\n    rank: 2,\n    userId: 'u2',\n    name: '?靽?,\n    avatar: '????,\n    itkScore: 3920,\n    level: 8,\n    title: '永續??',\n    isCurrentUser: false,\n  },\n  {\n    rank: 3,\n    userId: 'u3',\n    name: '?喟４甈?,\n    avatar: '?????,\n    itkScore: 3450,\n    level: 8,\n    title: '永續??',\n    isCurrentUser: false,\n  },\n  {\n    rank: 4,\n    userId: 'u4',\n    name: '????,\n    avatar: '????,\n    itkScore: 2890,\n    level: 7,\n    title: '敶梢?之雿?,\n    isCurrentUser: true,\n  },\n  {\n    rank: 5,\n    userId: 'u5',\n    name: '撘萄???,\n    avatar: '????,\n    itkScore: 2540,\n    level: 7,\n    title: '敶梢?之雿?,\n    isCurrentUser: false,\n  },\n];\n\n// ============================================================================\n// Main Component\n// ============================================================================\n\ninterface GamificationSystemProps {\n  userId?: string;\n  onQuestComplete?: (quest: Quest) => void;\n}\n\nexport const GamificationSystem: React.FC<GamificationSystemProps> = ({\n  userId = 'u4',\n  onQuestComplete,\n}) => {\n  const [activeTab, setActiveTab] = useState<'quests' | 'badges' | 'leaderboard'>('quests');\n  const [quests, setQuests] = useState<Quest[]>(MOCK_QUESTS);\n  const [showXpAnimation, setShowXpAnimation] = useState(false);\n\n  useEffect(() => {\n    omniLogger.info(LogCategory.GROWTH, '??頂蝯勗歇??', {\n      userId,\n      source_origin: 'GamificationSystem.mount',\n    });\n  }, [userId]);\n\n  // Calculate ITK Score\n  const itkScore = useMemo<ITKScore>(() => {\n    const total = 2890;\n    // LEVEL_TITLES is a non-empty const array, so fallback is always defined\n    const levelInfo =\n      LEVEL_TITLES.slice()\n        .reverse()\n        .find(l => total >= l.minXP) ?? LEVEL_TITLES[0];\n    const nextLevel = LEVEL_TITLES.find(l => l.minXP > total);\n\n    return {\n      total,\n      breakdown: {\n        insight: 980,\n        trustworthiness: 1120,\n        kindness: 790,\n      },\n      level: levelInfo.level,\n      title: levelInfo.title,\n      nextLevelXP: nextLevel?.minXP || levelInfo.minXP,\n      currentXP: total,\n    };\n  }, []);\n\n  // Progress to next level\n  const levelProgress = useMemo(() => {\n    const currentLevelXP = LEVEL_TITLES.find(l => l.level === itkScore.level)?.minXP || 0;\n    const xpInLevel = itkScore.currentXP - currentLevelXP;\n    const xpNeeded = itkScore.nextLevelXP - currentLevelXP;\n    return (xpInLevel / xpNeeded) * 100;\n  }, [itkScore]);\n\n  // Daily quest completion stats\n  const dailyStats = useMemo(() => {\n    const dailyQuests = quests.filter(q => q.type === 'daily');\n    const completed = dailyQuests.filter(q => q.isCompleted).length;\n    return { completed, total: dailyQuests.length };\n  }, [quests]);\n\n  // Complete a quest\n  const completeQuest = (questId: string) => {\n    const trace_id = uuidv4();\n    const quest = quests.find(q => q.id === questId);\n\n    omniLogger.info(LogCategory.GROWTH, `?冽摰?隞餃?: ${quest?.title || questId}`, {\n      trace_id,\n      quest_id: questId,\n      xp_reward: quest?.xpReward,\n      source_origin: 'GamificationSystem.completeQuest',\n    });\n\n    setQuests(prev =>\n      prev.map(q => (q.id === questId ? { ...q, isCompleted: true, progress: q.target } : q))\n    );\n    setShowXpAnimation(true);\n    setTimeout(() => setShowXpAnimation(false), 1500);\n\n    if (quest) {\n      onQuestComplete?.(quest);\n    }\n  };\n\n  const getRarityColor = (rarity: string) => {\n    switch (rarity) {\n      case 'legendary':\n        return 'from-yellow-500 to-orange-500 text-yellow-300';\n      case 'epic':\n        return 'from-purple-500 to-pink-500 text-purple-300';\n      case 'rare':\n        return 'from-blue-500 to-cyan-500 text-blue-300';\n      default:\n        return 'from-slate-500 to-slate-600 text-slate-300';\n    }\n  };\n\n  return (\n    <div className=\"frosted-panel rounded-2xl p-6 border border-amber-500/20 neon-border-amber animate-in\">\n      {/* Header with ITK Score */}\n      <div className=\"flex items-start justify-between mb-6\">\n        <div className=\"flex items-center gap-4\">\n          <div className=\"relative\">\n            <div className=\"w-16 h-16 rounded-full bg-gradient-to-br from-amber-400 to-orange-600 flex items-center justify-center text-3xl shadow-lg shadow-amber-500/20 animate-pulse\">\n              ???枯n            </div>\n            <div className=\"absolute -bottom-1 -right-1 w-7 h-7 rounded-full bg-slate-900 border-2 border-amber-500 flex items-center justify-center text-xs font-bold text-amber-500 shadow-md\">\n              {itkScore.level}\n            </div>\n          </div>\n          <div>\n            <h2 className=\"text-2xl font-bold text-white tracking-tight\">{itkScore.title}</h2>\n            <div className=\"flex items-center gap-3 mt-1\">\n              <span className=\"text-sm font-semibold text-amber-400 uppercase tracking-wider\">\n                ITK ?\n              </span>\n              <span className=\"text-2xl font-black text-white\">{itkScore.total}</span>\n            </div>\n            <div className=\"flex gap-4 mt-2 text-[10px] font-bold text-slate-500 uppercase tracking-widest bg-slate-800/50 px-2 py-1 rounded-md w-fit\">\n              <span>\n                I: <span className=\"text-amber-400\">{itkScore.breakdown.insight}</span>\n              </span>\n              <span>\n                T: <span className=\"text-orange-400\">{itkScore.breakdown.trustworthiness}</span>\n              </span>\n              <span>\n                K: <span className=\"text-emerald-400\">{itkScore.breakdown.kindness}</span>\n              </span>\n            </div>\n          </div>\n        </div>\n        <div className=\"text-right\">\n          <div className=\"flex items-center gap-1 text-amber-400\">\n            <Flame size={16} />\n            <span className=\"text-sm font-medium\">7 憭拚??</span>\n          </div>\n          <p className=\"text-xs text-slate-500 mt-1\">\n            頝 Lv.{itkScore.level + 1} ?? {itkScore.nextLevelXP - itkScore.currentXP} XP\n          </p>\n        </div>\n      </div>\n\n      {/* Level Progress Bar */}\n      <div className=\"mb-6\">\n        <div className=\"h-3 bg-slate-700 rounded-full overflow-hidden\">\n          <motion.div\n            className=\"h-full bg-gradient-to-r from-amber-500 to-orange-500\"\n            initial={{ width: 0 }}\n            animate={{ width: `${levelProgress}%` }}\n            transition={{ duration: 1, ease: 'easeOut' }}\n          />\n        </div>\n      </div>\n\n      {/* XP Animation */}\n      <AnimatePresence>\n        {showXpAnimation && (\n          <motion.div\n            initial={{ opacity: 0, y: 0 }}\n            animate={{ opacity: 1, y: -20 }}\n            exit={{ opacity: 0 }}\n            className=\"fixed top-1/2 left-1/2 -translate-x-1/2 text-2xl font-bold text-amber-400\"\n          >\n            +20 XP! ??\n          </motion.div>\n        )}\n      </AnimatePresence>\n\n      {/* Tabs */}\n      <div className=\"flex gap-2 mb-4\">\n        {[\n          { id: 'quests', label: '隞餃?', icon: <Target size={14} /> },\n          { id: 'badges', label: '敺賜?', icon: <Medal size={14} /> },\n          { id: 'leaderboard', label: '??璁?, icon: <Trophy size={14} /> },\n        ].map(tab => (\n          <button\n            key={tab.id}\n            onClick={() => setActiveTab(tab.id as typeof activeTab)}\n            className={`flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm transition-all ${\n              activeTab === tab.id\n                ? 'bg-amber-500/20 text-amber-400 border border-amber-500/30'\n                : 'bg-slate-800 text-slate-400 hover:bg-slate-700'\n            }`}\n          >\n            {tab.icon}\n            {tab.label}\n          </button>\n        ))}\n      </div>\n\n      {/* Content */}\n      <AnimatePresence mode=\"wait\">\n        {activeTab === 'quests' && (\n          <motion.div\n            key=\"quests\"\n            initial={{ opacity: 0, x: 10 }}\n            animate={{ opacity: 1, x: 0 }}\n            exit={{ opacity: 0, x: -10 }}\n            className=\"space-y-3\"\n          >\n            {/* Daily Progress */}\n            <div className=\"p-4 bg-gradient-to-r from-amber-900/30 to-orange-900/30 rounded-xl border border-amber-500/30 mb-4\">\n              <div className=\"flex items-center justify-between mb-2\">\n                <span className=\"text-sm text-amber-400\">瘥隞餃??脣漲</span>\n                <span className=\"text-lg font-bold text-white\">\n                  {dailyStats.completed}/{dailyStats.total}\n                </span>\n              </div>\n              <div className=\"h-2 bg-slate-700 rounded-full overflow-hidden\">\n                <div\n                  className=\"h-full bg-gradient-to-r from-amber-500 to-orange-500\"\n                  style={{ width: `${(dailyStats.completed / dailyStats.total) * 100}%` }}\n                />\n              </div>\n            </div>\n\n            {/* Quest List */}\n            {quests.map(quest => (\n              <div\n                key={quest.id}\n                className={`p-4 rounded-xl transition-all ${\n                  quest.isCompleted\n                    ? 'bg-green-500/10 border border-green-500/20'\n                    : 'bg-slate-800/50 hover:bg-slate-800'\n                }`}\n              >\n                <div className=\"flex items-center justify-between\">\n                  <div className=\"flex items-center gap-3\">\n                    <div\n                      className={`w-10 h-10 rounded-lg flex items-center justify-center ${\n                        quest.isCompleted\n                          ? 'bg-green-500/20 text-green-400'\n                          : 'bg-slate-700 text-slate-400'\n                      }`}\n                    >\n                      {quest.isCompleted ? <CheckCircle size={20} /> : quest.icon}\n                    </div>\n                    <div>\n                      <h4\n                        className={`font-medium ${quest.isCompleted ? 'text-green-400' : 'text-white'}`}\n                      >\n                        {quest.title}\n                      </h4>\n                      <p className=\"text-xs text-slate-500\">{quest.description}</p>\n                    </div>\n                  </div>\n                  <div className=\"text-right\">\n                    <div className=\"flex items-center gap-1 text-amber-400\">\n                      <Star size={12} />\n                      <span className=\"text-sm font-medium\">+{quest.xpReward} XP</span>\n                    </div>\n                    {!quest.isCompleted && (\n                      <p className=\"text-xs text-slate-500\">\n                        {quest.progress}/{quest.target}\n                      </p>\n                    )}\n                  </div>\n                </div>\n                {!quest.isCompleted && quest.progress > 0 && (\n                  <div className=\"mt-3 h-1.5 bg-slate-700 rounded-full overflow-hidden\">\n                    <div\n                      className=\"h-full bg-amber-500\"\n                      style={{ width: `${(quest.progress / quest.target) * 100}%` }}\n                    />\n                  </div>\n                )}\n              </div>\n            ))}\n          </motion.div>\n        )}\n\n        {activeTab === 'badges' && (\n          <motion.div\n            key=\"badges\"\n            initial={{ opacity: 0, x: 10 }}\n            animate={{ opacity: 1, x: 0 }}\n            exit={{ opacity: 0, x: -10 }}\n            className=\"grid grid-cols-3 gap-3\"\n          >\n            {MOCK_BADGES.map(badge => (\n              <div\n                key={badge.id}\n                className={`p-4 rounded-xl text-center transition-all ${\n                  badge.isUnlocked ? 'bg-slate-800/50' : 'bg-slate-800/20 opacity-50'\n                }`}\n              >\n                <div\n                  className={`w-12 h-12 mx-auto rounded-full flex items-center justify-center text-2xl mb-2 ${\n                    badge.isUnlocked\n                      ? `bg-gradient-to-r ${getRarityColor(badge.rarity)}`\n                      : 'bg-slate-700'\n                  }`}\n                >\n                  {badge.isUnlocked ? badge.icon : <Lock size={20} />}\n                </div>\n                <h4 className=\"text-sm font-medium text-white\">{badge.name}</h4>\n                <p className=\"text-xs text-slate-500 mt-1\">{badge.description}</p>\n                {!badge.isUnlocked && (\n                  <p className=\"text-xs text-amber-400 mt-2\">{badge.requirement}</p>\n                )}\n              </div>\n            ))}\n          </motion.div>\n        )}\n\n        {activeTab === 'leaderboard' && (\n          <motion.div\n            key=\"leaderboard\"\n            initial={{ opacity: 0, x: 10 }}\n            animate={{ opacity: 1, x: 0 }}\n            exit={{ opacity: 0, x: -10 }}\n            className=\"space-y-2\"\n          >\n            {MOCK_LEADERBOARD.map(entry => (\n              <div\n                key={entry.userId}\n                className={`flex items-center gap-3 p-3 rounded-xl ${\n                  entry.isCurrentUser\n                    ? 'bg-amber-500/20 border border-amber-500/30'\n                    : 'bg-slate-800/30'\n                }`}\n              >\n                <div\n                  className={`w-8 h-8 rounded-full flex items-center justify-center font-bold text-sm ${\n                    entry.rank === 1\n                      ? 'bg-yellow-500 text-black'\n                      : entry.rank === 2\n                        ? 'bg-slate-400 text-black'\n                        : entry.rank === 3\n                          ? 'bg-amber-700 text-white'\n                          : 'bg-slate-700 text-slate-300'\n                  }`}\n                >\n                  {entry.rank <= 3 ? ['??', '??', '??'][entry.rank - 1] : entry.rank}\n                </div>\n                <div className=\"text-2xl\">{entry.avatar}</div>\n                <div className=\"flex-1\">\n                  <h4 className=\"font-medium text-white\">\n                    {entry.name} {entry.isCurrentUser && '(雿?'}\n                  </h4>\n                  <p className=\"text-xs text-slate-500\">\n                    Lv.{entry.level} {entry.title}\n                  </p>\n                </div>\n                <div className=\"text-right\">\n                  <p className=\"font-bold text-amber-400\">{entry.itkScore}</p>\n                  <p className=\"text-xs text-slate-500\">ITK</p>\n                </div>\n              </div>\n            ))}\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n};\n\nexport default GamificationSystem;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\ESG\\GuidedWritingFlow.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\ESG\\HolisticEducationAssessment.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\ESG\\ITCarbonCalculator.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 16.","line":117,"column":44,"nodeType":"Literal","messageId":"noMagic","endLine":117,"endColumn":46},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 64.","line":120,"column":44,"nodeType":"Literal","messageId":"noMagic","endLine":120,"endColumn":46},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 24.","line":121,"column":42,"nodeType":"Literal","messageId":"noMagic","endLine":121,"endColumn":44},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.8.","line":122,"column":50,"nodeType":"Literal","messageId":"noMagic","endLine":122,"endColumn":53},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1.2.","line":123,"column":34,"nodeType":"Literal","messageId":"noMagic","endLine":123,"endColumn":37},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 436.","line":141,"column":75,"nodeType":"Literal","messageId":"noMagic","endLine":141,"endColumn":78},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.21.","line":157,"column":43,"nodeType":"Literal","messageId":"noMagic","endLine":157,"endColumn":47},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 90.","line":158,"column":46,"nodeType":"Literal","messageId":"noMagic","endLine":158,"endColumn":48},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.06.","line":159,"column":41,"nodeType":"Literal","messageId":"noMagic","endLine":159,"endColumn":45},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":166,"column":65,"nodeType":"Literal","messageId":"noMagic","endLine":166,"endColumn":67},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":166,"column":71,"nodeType":"Literal","messageId":"noMagic","endLine":166,"endColumn":73},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 8.","line":182,"column":47,"nodeType":"Literal","messageId":"noMagic","endLine":182,"endColumn":48},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 436.","line":393,"column":66,"nodeType":"Literal","messageId":"noMagic","endLine":393,"endColumn":69}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":13,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * ? IT 蝣單??曇?蝞 (Green Algorithms ?寞?隢?\n * --------------------------------------------------\n * [?] AI/?脩垢??蝣唾雲頝∩摯蝞n * [靘?] Lannelongue et al. 2021, Adv. Sci.\n * [? https://www.green-algorithms.org/\n */\n\nimport React, { useState, useMemo } from 'react';\nimport { motion } from 'framer-motion';\nimport {\n  Cpu,\n  Server,\n  Zap,\n  Cloud,\n  Calculator,\n  Leaf,\n  Car,\n  Plane,\n  TreeDeciduous,\n  Info,\n  ExternalLink,\n  RefreshCw,\n  ShieldCheck,\n  Link as LinkIcon,\n  Loader2,\n  Download,\n} from 'lucide-react';\nimport { omniLogger, LogCategory } from '@/omni/infrastructure/logging/OmniLogger';\nimport { blockchainAnchorService } from '@/services/blockchain/BlockchainAnchorService';\nimport { IBlockchainAnchorResult } from '@/types/blockchain';\nimport { useESGStore } from '@/store/useESGStore';\nimport { v4 as uuidv4 } from 'uuid';\nimport { useEffect } from 'react';\n\n// ============================================================================\n// Types & Constants (Based on Green Algorithms)\n// ============================================================================\n\nexport interface ComputeConfig {\n  cpuModel: string;\n  cpuCores: number;\n  cpuTdp: number; // Watts\n  gpuModel: string;\n  gpuCount: number;\n  gpuTdp: number; // Watts\n  memoryGB: number;\n  runtime: number; // hours\n  usageFactor: number; // 0-1\n  pue: number; // Power Usage Effectiveness (data center)\n  region: string;\n  carbonIntensity: number; // gCO2e/kWh\n}\n\nexport interface CarbonResult {\n  energyKWh: number;\n  carbonGrams: number;\n  carbonKg: number;\n  equivalentKmDriven: number;\n  equivalentFlightHours: number;\n  treeDaysToOffset: number;\n}\n\n// TDP values from Green Algorithms database (sample)\nconst CPU_TDP_DATABASE: Record<string, number> = {\n  'Intel Xeon E5-2680 v4': 120,\n  'Intel Core i9-13900K': 253,\n  'Intel Core i7-12700K': 190,\n  'AMD EPYC 7763': 280,\n  'AMD Ryzen 9 7950X': 170,\n  'Apple M2 Pro': 30,\n  'Apple M3 Max': 40,\n  'Other (Manual)': 100,\n};\n\nconst GPU_TDP_DATABASE: Record<string, number> = {\n  'NVIDIA A100 (80GB)': 400,\n  'NVIDIA A100 (40GB)': 300,\n  'NVIDIA H100': 700,\n  'NVIDIA RTX 4090': 450,\n  'NVIDIA RTX 3090': 350,\n  'NVIDIA V100': 300,\n  'NVIDIA T4': 70,\n  'AMD MI250X': 500,\n  None: 0,\n  'Other (Manual)': 200,\n};\n\n// Carbon intensity by region (gCO2e/kWh) - 2023 data\nconst REGION_CARBON_INTENSITY: Record<string, { name: string; intensity: number }> = {\n  tw: { name: '?啁', intensity: 494 },\n  jp: { name: '?交', intensity: 471 },\n  cn: { name: '銝剖?', intensity: 555 },\n  us: { name: '蝢?', intensity: 379 },\n  'us-ca': { name: '蝢? (??)', intensity: 210 },\n  eu: { name: '甇?撟喳?', intensity: 231 },\n  de: { name: '敺瑕?', intensity: 350 },\n  fr: { name: '瘜?', intensity: 56 },\n  uk: { name: '?勗?', intensity: 207 },\n  world: { name: '?函?撟喳?', intensity: 436 },\n};\n\n// Memory power consumption (Watts per GB)\nconst MEMORY_POWER_PER_GB = 0.3725; // W/GB (from Green Algorithms)\n\n// ============================================================================\n// Main Component\n// ============================================================================\n\ninterface ITCarbonCalculatorProps {\n  onCalculate?: (result: CarbonResult) => void;\n}\n\nexport const ITCarbonCalculator: React.FC<ITCarbonCalculatorProps> = ({ onCalculate }) => {\n  // Form state\n  const [cpuModel, setCpuModel] = useState('Intel Xeon E5-2680 v4');\n  const [cpuCores, setCpuCores] = useState(16);\n  const [gpuModel, setGpuModel] = useState('NVIDIA A100 (40GB)');\n  const [gpuCount, setGpuCount] = useState(1);\n  const [memoryGB, setMemoryGB] = useState(64);\n  const [runtime, setRuntime] = useState(24);\n  const [usageFactor, setUsageFactor] = useState(0.8);\n  const [pue, setPue] = useState(1.2);\n  const [region, setRegion] = useState('tw');\n  const [customTdp, setCustomTdp] = useState({ cpu: 100, gpu: 200 });\n  const [isAnchoring, setIsAnchoring] = useState(false);\n  const [anchorResult, setAnchorResult] = useState<IBlockchainAnchorResult | null>(null);\n  const updateMetrics = useESGStore(state => state.updateMetrics);\n  const addAnchor = useESGStore(state => state.addAnchor);\n\n  useEffect(() => {\n    omniLogger.info(LogCategory.ESG, 'IT 蝣單??曇?蝞已完成, {\n      source_origin: 'ITCarbonCalculator.mount',\n    });\n  }, []);\n\n  // Calculate carbon footprint\n  const result = useMemo<CarbonResult>(() => {\n    const cpuTdp = CPU_TDP_DATABASE[cpuModel] || customTdp.cpu;\n    const gpuTdp = GPU_TDP_DATABASE[gpuModel] || customTdp.gpu;\n    const carbonIntensity = REGION_CARBON_INTENSITY[region]?.intensity || 436;\n\n    // Power consumption (W)\n    const cpuPower = cpuTdp * usageFactor;\n    const gpuPower = gpuTdp * gpuCount * usageFactor;\n    const memoryPower = memoryGB * MEMORY_POWER_PER_GB;\n    const totalPower = (cpuPower + gpuPower + memoryPower) * pue;\n\n    // Energy (kWh)\n    const energyKWh = (totalPower / 1000) * runtime;\n\n    // Carbon emissions\n    const carbonGrams = energyKWh * carbonIntensity;\n    const carbonKg = carbonGrams / 1000;\n\n    // Equivalents (from Green Algorithms)\n    const equivalentKmDriven = carbonKg / 0.21; // ~210 gCO2/km average car\n    const equivalentFlightHours = carbonKg / 90; // ~90 kgCO2/hour flight\n    const treeDaysToOffset = carbonKg / 0.06; // ~22 kgCO2/year/tree = 60g/day\n\n    return {\n      energyKWh: Math.round(energyKWh * 100) / 100,\n      carbonGrams: Math.round(carbonGrams),\n      carbonKg: Math.round(carbonKg * 100) / 100,\n      equivalentKmDriven: Math.round(equivalentKmDriven),\n      equivalentFlightHours: Math.round(equivalentFlightHours * 10) / 10,\n      treeDaysToOffset: Math.round(treeDaysToOffset),\n    };\n  }, [cpuModel, gpuModel, gpuCount, memoryGB, runtime, usageFactor, pue, region, customTdp]);\n\n  // Handle blockchain anchoring\n  const handleAnchor = async () => {\n    setIsAnchoring(true);\n    try {\n      const anchorRes = await blockchainAnchorService.anchorAsset(\n        {\n          computation: { cpuModel, gpuModel, runtime },\n          result,\n        },\n        {\n          contentType: 'carbon_asset',\n          sourceId: `ITCC-${uuidv4().slice(0, 8)}`,\n          operator: 'ESG_ADMIN_01',\n        }\n      );\n      setAnchorResult(anchorRes);\n      addAnchor({\n        id: anchorRes.sourceId ?? 'UNKNOWN',\n        type: 'IT_CARBON_ASSET',\n        hash: anchorRes.txHash,\n      });\n    } catch (error) {\n      omniLogger.error(LogCategory.SEC, '?憛?摮?憭望?', { error });\n    } finally {\n      setIsAnchoring(false);\n    }\n  };\n\n  return (\n    <div className=\"frosted-panel rounded-2xl p-6 border border-green-500/20 neon-border-green animate-slide-up\">\n      {/* Header */}\n      <div className=\"flex items-center justify-between mb-6\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-12 h-12 rounded-2xl bg-gradient-to-br from-green-500 to-emerald-600 flex items-center justify-center shadow-lg shadow-green-500/20\">\n            <Cpu size={24} className=\"text-white\" />\n          </div>\n          <div>\n            <h2 className=\"text-2xl font-bold text-white tracking-tight\">IT 蝣單??曇?蝞</h2>\n            <p className=\"text-sm text-slate-400\">?箸 Green Algorithms ?寞?隢?瘛勗漲??</p>\n          </div>\n        </div>\n        <a\n          href=\"https://www.green-algorithms.org/\"\n          target=\"_blank\"\n          rel=\"noopener noreferrer\"\n          className=\"flex items-center gap-1 text-xs text-green-400 hover:text-green-300 transition-colors\"\n        >\n          <ExternalLink size={12} />\n          ??皞n        </a>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n        {/* Input Form */}\n        <div className=\"space-y-4\">\n          {/* CPU */}\n          <div className=\"p-4 bg-slate-800/50 rounded-xl\">\n            <div className=\"flex items-center gap-2 mb-3 text-slate-300\">\n              <Cpu size={16} />\n              <span className=\"font-medium\">CPU ?蔭</span>\n            </div>\n            <div className=\"grid grid-cols-2 gap-3\">\n              <div>\n                <label className=\"text-xs text-slate-500 mb-1 block\">邏輯?典???/label>\n                <select\n                  value={cpuModel}\n                  onChange={e => setCpuModel(e.target.value)}\n                  className=\"w-full bg-slate-700/50 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white focus:border-green-500 outline-none\"\n                >\n                  {Object.keys(CPU_TDP_DATABASE).map(cpu => (\n                    <option key={cpu} value={cpu}>\n                      {cpu}\n                    </option>\n                  ))}\n                </select>\n              </div>\n              <div>\n                <label className=\"text-xs text-slate-500 mb-1 block\">協議??/label>\n                <input\n                  type=\"number\"\n                  value={cpuCores}\n                  onChange={e => setCpuCores(Number(e.target.value))}\n                  className=\"w-full bg-slate-700/50 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white focus:border-green-500 outline-none\"\n                />\n              </div>\n            </div>\n            {cpuModel === 'Other (Manual)' && (\n              <div className=\"mt-2\">\n                <label className=\"text-xs text-slate-500 mb-1 block\">TDP (Watts)</label>\n                <input\n                  type=\"number\"\n                  value={customTdp.cpu}\n                  onChange={e => setCustomTdp(prev => ({ ...prev, cpu: Number(e.target.value) }))}\n                  className=\"w-full bg-slate-700/50 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white focus:border-green-500 outline-none\"\n                />\n              </div>\n            )}\n          </div>\n\n          {/* GPU */}\n          <div className=\"p-4 bg-slate-800/50 rounded-xl\">\n            <div className=\"flex items-center gap-2 mb-3 text-slate-300\">\n              <Server size={16} />\n              <span className=\"font-medium\">GPU ?蔭</span>\n            </div>\n            <div className=\"grid grid-cols-2 gap-3\">\n              <div>\n                <label className=\"text-xs text-slate-500 mb-1 block\">GPU ??</label>\n                <select\n                  value={gpuModel}\n                  onChange={e => setGpuModel(e.target.value)}\n                  className=\"w-full bg-slate-700/50 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white focus:border-green-500 outline-none\"\n                >\n                  {Object.keys(GPU_TDP_DATABASE).map(gpu => (\n                    <option key={gpu} value={gpu}>\n                      {gpu}\n                    </option>\n                  ))}\n                </select>\n              </div>\n              <div>\n                <label className=\"text-xs text-slate-500 mb-1 block\">GPU ?賊?</label>\n                <input\n                  type=\"number\"\n                  value={gpuCount}\n                  onChange={e => setGpuCount(Number(e.target.value))}\n                  min={0}\n                  className=\"w-full bg-slate-700/50 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white focus:border-green-500 outline-none\"\n                />\n              </div>\n            </div>\n          </div>\n\n          {/* Memory & Runtime */}\n          <div className=\"p-4 bg-slate-800/50 rounded-xl\">\n            <div className=\"grid grid-cols-2 gap-3\">\n              <div>\n                <label className=\"text-xs text-slate-500 mb-1 block\">閮擃?(GB)</label>\n                <input\n                  type=\"number\"\n                  value={memoryGB}\n                  onChange={e => setMemoryGB(Number(e.target.value))}\n                  className=\"w-full bg-slate-700/50 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white focus:border-green-500 outline-none\"\n                />\n              </div>\n              <div>\n                <label className=\"text-xs text-slate-500 mb-1 block\">???? (撠?)</label>\n                <input\n                  type=\"number\"\n                  value={runtime}\n                  onChange={e => setRuntime(Number(e.target.value))}\n                  className=\"w-full bg-slate-700/50 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white focus:border-green-500 outline-none\"\n                />\n              </div>\n            </div>\n          </div>\n\n          {/* Advanced Settings */}\n          <div className=\"p-4 bg-slate-800/50 rounded-xl\">\n            <div className=\"grid grid-cols-3 gap-3\">\n              <div>\n                <label className=\"text-xs text-slate-500 mb-1 block\">雿輻??/label>\n                <input\n                  type=\"number\"\n                  value={usageFactor}\n                  onChange={e => setUsageFactor(Number(e.target.value))}\n                  step={0.1}\n                  min={0}\n                  max={1}\n                  className=\"w-full bg-slate-700/50 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white focus:border-green-500 outline-none\"\n                />\n              </div>\n              <div>\n                <label className=\"text-xs text-slate-500 mb-1 block\">PUE</label>\n                <input\n                  type=\"number\"\n                  value={pue}\n                  onChange={e => setPue(Number(e.target.value))}\n                  step={0.1}\n                  min={1}\n                  className=\"w-full bg-slate-700/50 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white focus:border-green-500 outline-none\"\n                />\n              </div>\n              <div>\n                <label className=\"text-xs text-slate-500 mb-1 block\">?啣?</label>\n                <select\n                  value={region}\n                  onChange={e => setRegion(e.target.value)}\n                  className=\"w-full bg-slate-700/50 border border-slate-600 rounded-lg px-3 py-2 text-sm text-white focus:border-green-500 outline-none\"\n                >\n                  {Object.entries(REGION_CARBON_INTENSITY).map(([key, val]) => (\n                    <option key={key} value={key}>\n                      {val.name} ({val.intensity} g)\n                    </option>\n                  ))}\n                </select>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Results */}\n        <div className=\"space-y-4\">\n          {/* Main Result */}\n          <div className=\"p-6 bg-gradient-to-r from-green-900/30 to-emerald-900/30 rounded-xl border border-green-500/30\">\n            <div className=\"flex items-center gap-2 mb-4 text-green-400\">\n              <Leaf size={20} />\n              <span className=\"font-medium\">蝣單??曆摯蝞?/span>\n            </div>\n            <div className=\"text-center mb-4\">\n              <p className=\"text-5xl font-bold text-white\">\n                {result.carbonKg < 1 ? `${result.carbonGrams} g` : `${result.carbonKg} kg`}\n              </p>\n              <p className=\"text-sm text-slate-400 mt-1\">CO?</p>\n            </div>\n            <div className=\"grid grid-cols-2 gap-3 text-center\">\n              <div className=\"p-3 bg-slate-800/50 rounded-lg\">\n                <p className=\"text-lg font-bold text-emerald-400\">{result.energyKWh}</p>\n                <p className=\"text-xs text-slate-500\">kWh ?賣?</p>\n              </div>\n              <div className=\"p-3 bg-slate-800/50 rounded-lg\">\n                <p className=\"text-lg font-bold text-blue-400\">\n                  {REGION_CARBON_INTENSITY[region]?.intensity || 436}\n                </p>\n                <p className=\"text-xs text-slate-500\">gCO??kWh</p>\n              </div>\n            </div>\n          </div>\n\n          {/* Equivalents */}\n          <div className=\"p-4 bg-slate-800/50 rounded-xl\">\n            <h4 className=\"text-sm font-medium text-slate-300 mb-3\">?貊??..</h4>\n            <div className=\"space-y-3\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-2 text-slate-400\">\n                  <Car size={16} />\n                  <span className=\"text-sm\">瘙質?銵?</span>\n                </div>\n                <span className=\"text-white font-medium\">{result.equivalentKmDriven} km</span>\n              </div>\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-2 text-slate-400\">\n                  <Plane size={16} />\n                  <span className=\"text-sm\">憌???</span>\n                </div>\n                <span className=\"text-white font-medium\">{result.equivalentFlightHours} 撠?</span>\n              </div>\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-2 text-slate-400\">\n                  <TreeDeciduous size={16} />\n                  <span className=\"text-sm\">璅寞?豢憭拇</span>\n                </div>\n                <span className=\"text-white font-medium\">{result.treeDaysToOffset} 憭?/span>\n              </div>\n            </div>\n          </div>\n\n          {/* Info Box */}\n          <div className=\"p-4 bg-blue-500/10 rounded-xl border border-blue-500/20\">\n            <div className=\"flex items-start gap-2\">\n              <Info size={16} className=\"text-blue-400 mt-0.5\" />\n              <div className=\"text-xs text-slate-400\">\n                <p className=\"mb-1\">\n                  <strong className=\"text-blue-400\">?寞?隢?皞?</strong>\n                </p>\n                <p>\n                  Lannelongue, L., Grealey, J., Inouye, M. (2021). Green Algorithms: Quantifying the\n                  Carbon Footprint of Computation.\n                  <em>Adv. Sci.</em> 2100707.\n                </p>\n              </div>\n            </div>\n          </div>\n\n          {/* Action Buttons */}\n          <div className=\"flex gap-3 mt-6\">\n            <button\n              onClick={() => {\n                const trace_id = uuidv4();\n                omniLogger.info(LogCategory.ESG, 'IT 蝣單??曇?蝞???, {\n                  trace_id,\n                  result,\n                  source_origin: 'ITCarbonCalculator.onCalculate',\n                });\n                updateMetrics({ itEnergyKWh: result.energyKWh });\n                onCalculate?.(result);\n              }}\n              className=\"flex-1 flex items-center justify-center gap-2 px-4 py-3 rounded-xl bg-gradient-to-r from-green-500 to-emerald-500 text-white font-bold hover:shadow-xl hover:shadow-green-500/40 hover:scale-[1.02] active:scale-[0.98] transition-all duration-300\"\n            >\n              <Calculator size={18} />\n              ?撟游漲蝣喟?功n            </button>\n\n            <button\n              onClick={handleAnchor}\n              disabled={isAnchoring || !!anchorResult}\n              className={`flex items-center justify-center gap-2 px-6 py-3 rounded-xl font-bold transition-all duration-300 ${\n                anchorResult\n                  ? 'bg-indigo-500/10 text-indigo-400 border border-indigo-500/30'\n                  : 'bg-slate-800 text-slate-300 border border-slate-700 hover:border-indigo-500/50 hover:text-indigo-400'\n              }`}\n            >\n              {isAnchoring ? (\n                <Loader2 size={18} className=\"animate-spin\" />\n              ) : anchorResult ? (\n                <ShieldCheck size={18} />\n              ) : (\n                <LinkIcon size={18} />\n              )}\n              {anchorResult ? '撌脣?霅? : '??摮?'}\n            </button>\n          </div>\n\n          {/* Blockchain Evidence Bar */}\n          {anchorResult && (\n            <motion.div\n              initial={{ opacity: 0, y: 10 }}\n              animate={{ opacity: 1, y: 0 }}\n              className=\"mt-6 p-4 bg-indigo-500/10 border border-indigo-500/30 rounded-2xl flex flex-col gap-4 shadow-[0_0_20px_rgba(99,102,241,0.1)]\"\n            >\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-3\">\n                  <div className=\"p-2 bg-indigo-500/20 rounded-xl\">\n                    <ShieldCheck size={20} className=\"text-indigo-400\" />\n                  </div>\n                  <div>\n                    <p className=\"text-[10px] font-bold text-indigo-400 uppercase tracking-[0.2em] mb-1\">\n                      Immutable Evidence Anchored\n                    </p>\n                    <p className=\"text-xs text-slate-400 font-mono truncate max-w-[200px]\">\n                      {anchorResult.txHash}\n                    </p>\n                  </div>\n                </div>\n                <div className=\"flex gap-2\">\n                  <button\n                    onClick={() =>\n                      alert(\n                        `[Evidence Path]\\nfile:///C:/Project/ESGss_JunAiKey_Beta/storage/anchors/${anchorResult.txHash}.json`\n                      )\n                    }\n                    className=\"p-2 bg-slate-800 hover:bg-slate-700 text-indigo-400 rounded-lg border border-indigo-500/20 transition-all\"\n                    title=\"摰?霅瑼?\"\n                  >\n                    <LinkIcon size={16} />\n                  </button>\n                  <a\n                    href={anchorResult.explorerUrl}\n                    target=\"_blank\"\n                    rel=\"noopener noreferrer\"\n                    className=\"p-2 bg-indigo-500/20 hover:bg-indigo-500/30 text-indigo-400 rounded-lg border border-indigo-500/30 transition-all\"\n                    title=\"?憛??汗?沔"\n                  >\n                    <ExternalLink size={16} />\n                  </a>\n                </div>\n              </div>\n              <div className=\"flex items-center gap-2 pt-3 border-t border-indigo-500/10\">\n                <div className=\"text-[10px] text-slate-500 font-mono flex-1\">\n                  STATUS: SEVER-SIDE SEALED & GLOBALLY NOTARIZED\n                </div>\n                <button className=\"text-[10px] font-bold text-indigo-400 hover:text-indigo-300 uppercase tracking-widest flex items-center gap-1\">\n                  <Download size={10} /> Download Certificate\n                </button>\n              </div>\n            </motion.div>\n          )}\n        </div>\n      </div>\n    </div>\n  );\n};\n\nexport default ITCarbonCalculator;\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\ESG\\ImpactRadar.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 6.","line":139,"column":78,"nodeType":"Literal","messageId":"noMagic","endLine":139,"endColumn":79},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.1.","line":147,"column":32,"nodeType":"Literal","messageId":"noMagic","endLine":147,"endColumn":35},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.3.","line":147,"column":37,"nodeType":"Literal","messageId":"noMagic","endLine":147,"endColumn":40},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.1.","line":147,"column":42,"nodeType":"Literal","messageId":"noMagic","endLine":147,"endColumn":45},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1.2.","line":147,"column":59,"nodeType":"Literal","messageId":"noMagic","endLine":147,"endColumn":62},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 80.","line":329,"column":18,"nodeType":"Literal","messageId":"noMagic","endLine":329,"endColumn":20},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":330,"column":18,"nodeType":"Literal","messageId":"noMagic","endLine":330,"endColumn":20}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":7,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * ? Sustainability War Room - Impact Radar (B3)\n * --------------------------------------------------\n * [Function] Multi-factor External Risk Analysis (PESTEL) & Strategic Advice\n * [Style] High-end Futuristic\n * [Interaction] PESTEL Factor Interaction, Impact Index Dashboard\n */\n\nimport React, { useState, useEffect } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport {\n  Radar,\n  ShieldAlert,\n  Zap,\n  Globe,\n  Scale,\n  TrendingUp,\n  Activity,\n  Cpu,\n  Leaf,\n  AlertTriangle,\n  ChevronRight,\n  Crosshair,\n  Terminal,\n  Bot,\n} from 'lucide-react';\n\n// --- Type Definitions ---\n\ninterface RiskFactor {\n  id: string;\n  name: string;\n  score: number; // 0-100\n  description: string;\n  trend: 'up' | 'down' | 'stable';\n  details: string[];\n}\n\ninterface Strategy {\n  id: string;\n  factorId: string;\n  title: string;\n  type: '?脩戌' | '頧?' | '璈?';\n  content: string;\n  aiInsight: string;\n  confidence: number;\n}\n\n// --- Mock Data ---\n\nconst MOCK_FACTORS: Record<string, RiskFactor> = {\n  political: {\n    id: 'political',\n    name: '?踵祥 (Political)',\n    score: 75,\n    description: '?啁楠?踵祥蝺撐撅?Ｗ?皞恬?CBAM 蝣喲?蝔蝑撠祕??,\n    trend: 'up',\n    details: ['甇? CBAM ?喳閬?霈', '靘??蝺?瘝駁◢自律?訾???],\n  },\n  economic: {\n    id: 'economic',\n    name: '蝬? (Economic)',\n    score: 62,\n    description: '?函??憯?頞函楨嚗?蝬???隞?',\n    trend: 'stable',\n    details: ['蝣單?鈭斗??寞瘜Ｗ???', '蝬?萄?潸??拍?霈?'],\n  },\n  social: {\n    id: 'social',\n    name: '蝷暹? (Social)',\n    score: 45,\n    description: 'DEI (憭??梯?) ???祇嚗??釣?∪極蝳?',\n    trend: 'down',\n    details: ['Z 銝誨撠?璆剜偶蝥耦鞊∟?瘙?擃?, '?極甈?瘜??湔'],\n  },\n  technological: {\n    id: 'technological',\n    name: '?銵?(Technological)',\n    score: 88,\n    description: 'AI 蝞??質?憓??訾?頧?餈怠?',\n    trend: 'up',\n    details: ['多元核心撘?AI ??桀?', 'IoT ?賣?蝞∠?系統?瘙???],\n  },\n  environmental: {\n    id: 'environmental',\n    name: '?啣? (Environmental)',\n    score: 92,\n    description: '璆萇垢瘞??隞園?潘?瘞渲?皞恣?◢?芣扔擃?,\n    trend: 'up',\n    details: ['璆萇垢?撠??銝剜憸券', '?憭見?扳?脰?瘙?(TNFD)'],\n  },\n  legal: {\n    id: 'legal',\n    name: '瘜? (Legal)',\n    score: 68,\n    description: 'IFRS S1/S2 皞??亥?嚗?閬??砌???,\n    trend: 'up',\n    details: ['??恣?僑?梁楊?嗆閬?', '??靽風瘜?靽株?'],\n  },\n};\n\nconst MOCK_STRATEGIES: Strategy[] = [\n  {\n    id: 's1',\n    factorId: 'environmental',\n    title: '瘞???批撥????,\n    type: '?脩戌',\n    content: '撱箇?璆萇垢瘞??霅行??塚?撘瑕?撱??脫揪閮剜????TCFD 獢?脰?鞎∪?銵???????,\n    aiInsight: '?寞?甇瑕瘞?情數據璅⊥嚗府??靘?5 撟游撥?璈?憓? 30%嚗遣霅啣?楊?瘣芷?蝞?,\n    confidence: 95,\n  },\n  {\n    id: 's2',\n    factorId: 'legal',\n    title: '靘??４數據???芸???,\n    type: '頧?',\n    content: '?函蔡?芸??４?斗系統嚗??乩?銝虜靘????蝣箔? CBAM ?喳鞈????扼?,\n    aiInsight: '?芸???? 80% 鈭箏極?喳?航炊??銝衣葬??60% 皞?????,\n    confidence: 88,\n  },\n  {\n    id: 's3',\n    factorId: 'technological',\n    title: 'AI ?賣??芸??函蔡',\n    type: '璈?',\n    content: '?拍 AI 瞍?瘜?征隤輯?鋆賜??券嚗?雿?Scope 2 ?銝衣??皞??研?,\n    aiInsight: '?摯?舐???12-15% 撟游漲?餃??臬嚗OI ????1.5 撟游???,\n    confidence: 92,\n  },\n];\n\n// --- Components ---\n\nexport const ImpactRadar: React.FC = () => {\n  const [selectedFactor, setSelectedFactor] = useState<RiskFactor>(MOCK_FACTORS.environmental!);\n\n  // Calculate Overall Impact Index (Average)\n  const impactIndex = Math.round(\n    Object.values(MOCK_FACTORS).reduce((acc, curr) => acc + curr.score, 0) / 6\n  );\n\n  return (\n    <div className=\"min-h-screen bg-slate-900 text-slate-100 p-6 overflow-hidden relative font-sans\">\n      {/* Background Ambience */}\n      <div className=\"absolute top-0 left-0 w-full h-full overflow-hidden pointer-events-none z-0\">\n        <motion.div\n          animate={{ opacity: [0.1, 0.3, 0.1], scale: [1, 1.2, 1] }}\n          transition={{ duration: 10, repeat: Infinity }}\n          className=\"absolute -top-1/2 -left-1/2 w-[200%] h-[200%] bg-[radial-gradient(circle,rgba(56,189,248,0.1)_0%,rgba(0,0,0,0)_60%)]\"\n        />\n      </div>\n\n      <div className=\"relative z-10 max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-6 h-full\">\n        {/* Left: Dashboard & Factor Selection */}\n        <div className=\"lg:col-span-4 space-y-6\">\n          {/* Overall Impact Index Dashboard */}\n          <GlassCard className=\"p-8 text-center relative overflow-hidden group\">\n            <motion.div className=\"absolute inset-0 bg-gradient-to-br from-red-500/10 to-blue-500/10 opacity-0 group-hover:opacity-100 transition-opacity\" />\n            <h2 className=\"text-slate-400 text-sm font-bold tracking-widest mb-4 flex items-center justify-center gap-2\">\n              <Activity size={16} className=\"text-cyan-400\" />\n              GLOBAL IMPACT INDEX\n            </h2>\n            <div className=\"relative inline-flex items-center justify-center\">\n              <svg className=\"w-48 h-48 transform -rotate-90\">\n                <circle cx=\"96\" cy=\"96\" r=\"88\" fill=\"none\" stroke=\"#1e293b\" strokeWidth=\"12\" />\n                <motion.circle\n                  initial={{ pathLength: 0 }}\n                  animate={{ pathLength: impactIndex / 100 }}\n                  transition={{ duration: 2, ease: 'easeOut' }}\n                  cx=\"96\"\n                  cy=\"96\"\n                  r=\"88\"\n                  fill=\"none\"\n                  stroke=\"url(#impact-gradient)\"\n                  strokeWidth=\"12\"\n                  strokeLinecap=\"round\"\n                  strokeDasharray=\"1 1\"\n                />\n                <defs>\n                  <linearGradient id=\"impact-gradient\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"0%\">\n                    <stop offset=\"0%\" stopColor=\"#22d3ee\" />\n                    <stop offset=\"100%\" stopColor=\"#f472b6\" />\n                  </linearGradient>\n                </defs>\n              </svg>\n              <div className=\"absolute inset-0 flex flex-col items-center justify-center\">\n                <span className=\"text-6xl font-black text-white tracking-tighter drop-shadow-[0_0_15px_rgba(34,211,238,0.5)]\">\n                  {impactIndex}\n                </span>\n                <span className=\"text-xs text-cyan-300 font-bold bg-cyan-950/50 px-2 py-1 rounded border border-cyan-800/50 mt-1\">\n                  CRITICAL LEVEL\n                </span>\n              </div>\n            </div>\n          </GlassCard>\n\n          {/* PESTEL ??數據??*/}\n          <div className=\"grid grid-cols-2 gap-3\">\n            {Object.values(MOCK_FACTORS).map(factor => (\n              <FactorButton\n                key={factor.id}\n                factor={factor}\n                isSelected={selectedFactor.id === factor.id}\n                onClick={() => setSelectedFactor(factor)}\n              />\n            ))}\n          </div>\n        </div>\n\n        {/* Center: Factor Details & AI Analysis */}\n        <div className=\"lg:col-span-5 space-y-6\">\n          <AnimatePresence mode=\"wait\">\n            <motion.div\n              key={selectedFactor.id}\n              initial={{ opacity: 0, x: 20 }}\n              animate={{ opacity: 1, x: 0 }}\n              exit={{ opacity: 0, x: -20 }}\n              transition={{ duration: 0.3 }}\n            >\n              <GlassCard className=\"p-6 h-full border-t-4 border-t-cyan-500\">\n                <div className=\"flex items-center justify-between mb-6\">\n                  <div className=\"flex items-center gap-3\">\n                    <div className=\"p-3 bg-cyan-950/50 rounded-lg border border-cyan-800/50 text-cyan-400\">\n                      {getIcon(selectedFactor.id)}\n                    </div>\n                    <div>\n                      <h3 className=\"text-2xl font-bold text-white\">{selectedFactor.name}</h3>\n                      <p className=\"text-slate-400 text-sm\">Risk Assessment Protocol</p>\n                    </div>\n                  </div>\n                  <div className=\"text-right\">\n                    <div className=\"text-3xl font-bold text-cyan-400\">{selectedFactor.score}</div>\n                    <div className=\"text-xs text-slate-500\">RISK SCORE</div>\n                  </div>\n                </div>\n\n                <div className=\"mb-8\">\n                  <h4 className=\"text-cyan-200 text-sm font-bold mb-2 flex items-center gap-2\">\n                    <Crosshair size={14} /> SITUATION ANALYSIS\n                  </h4>\n                  <p className=\"text-slate-300 leading-relaxed text-lg\">\n                    {selectedFactor.description}\n                  </p>\n                </div>\n\n                <div className=\"space-y-4\">\n                  <h4 className=\"text-cyan-200 text-sm font-bold flex items-center gap-2\">\n                    <Terminal size={14} /> KEY INDICATORS\n                  </h4>\n                  {selectedFactor.details.map((detail, idx) => (\n                    <div\n                      key={idx}\n                      className=\"bg-slate-800/50 p-3 rounded border-l-2 border-cyan-500/50 flex items-start gap-3\"\n                    >\n                      <AlertTriangle size={16} className=\"text-yellow-500 mt-1 shrink-0\" />\n                      <span className=\"text-slate-300 text-sm\">{detail}</span>\n                    </div>\n                  ))}\n                </div>\n              </GlassCard>\n            </motion.div>\n          </AnimatePresence>\n        </div>\n\n        {/* Right: Strategic Response */}\n        <div className=\"lg:col-span-3 space-y-4\">\n          <div className=\"flex items-center justify-between mb-2\">\n            <h3 className=\"text-white font-bold flex items-center gap-2\">\n              <Zap size={18} className=\"text-yellow-400\" />\n              STRATEGIC RESPONSE\n            </h3>\n            <span className=\"text-xs bg-yellow-400/10 text-yellow-400 px-2 py-1 rounded border border-yellow-400/20\">\n              AI GENERATED\n            </span>\n          </div>\n\n          <div className=\"space-y-4 h-[calc(100vh-200px)] overflow-y-auto pr-2 custom-scrollbar\">\n            {MOCK_STRATEGIES.filter(s => s.factorId === selectedFactor.id).map(strategy => (\n              <StrategyCard key={strategy.id} strategy={strategy} />\n            ))}\n\n            {MOCK_STRATEGIES.filter(s => s.factorId === selectedFactor.id).length === 0 && (\n              <div className=\"p-8 text-center border border-dashed border-slate-700 rounded-xl text-slate-500\">\n                No specific strategies generated for this factor yet.\n              </div>\n            )}\n\n            {/* Global Strategy */}\n            <div className=\"pt-4 border-t border-slate-800\">\n              <h4 className=\"text-slate-500 text-xs font-bold mb-3 uppercase\">\n                Recommended Cross-Domain Actions\n              </h4>\n              <StrategyCard strategy={MOCK_STRATEGIES[2]!} />\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n\n// --- Subcomponents ---\n\nconst GlassCard = ({\n  children,\n  className = '',\n}: {\n  children: React.ReactNode;\n  className?: string;\n}) => (\n  <div\n    className={`bg-slate-900/40 backdrop-blur-xl border border-slate-700/50 rounded-2xl shadow-2xl ${className}`}\n  >\n    {children}\n  </div>\n);\n\nconst FactorButton = ({\n  factor,\n  isSelected,\n  onClick,\n}: {\n  factor: RiskFactor;\n  isSelected: boolean;\n  onClick: () => void;\n}) => {\n  // Determine color based on score\n  const getScoreColor = (score: number) => {\n    if (score >= 80) return 'text-red-400';\n    if (score >= 60) return 'text-yellow-400';\n    return 'text-green-400';\n  };\n\n  return (\n    <motion.button\n      whileHover={{ scale: 1.02 }}\n      whileTap={{ scale: 0.98 }}\n      onClick={onClick}\n      className={`p-4 rounded-xl border text-left transition-all relative overflow-hidden group ${\n        isSelected\n          ? 'bg-cyan-950/40 border-cyan-500 shadow-[0_0_20px_rgba(6,182,212,0.15)]'\n          : 'bg-slate-800/30 border-slate-700/50 hover:bg-slate-800/50 hover:border-slate-600'\n      }`}\n    >\n      <div className=\"flex justify-between items-start mb-2\">\n        <span\n          className={`text-xs font-bold px-1.5 py-0.5 rounded ${\n            factor.trend === 'up'\n              ? 'bg-red-500/20 text-red-400'\n              : factor.trend === 'down'\n                ? 'bg-green-500/20 text-green-400'\n                : 'bg-slate-500/20 text-slate-400'\n          }`}\n        >\n          {factor.trend === 'up' ? '??RISING' : factor.trend === 'down' ? '??FALLING' : '??STABLE'}\n        </span>\n        <span className={`font-mono font-bold ${getScoreColor(factor.score)}`}>{factor.score}</span>\n      </div>\n      <div className=\"flex items-center gap-2\">\n        <div className=\"text-slate-400 group-hover:text-cyan-400 transition-colors\">\n          {getIcon(factor.id)}\n        </div>\n        <span\n          className={`font-bold transition-colors ${isSelected ? 'text-white' : 'text-slate-300'}`}\n        >\n          {factor.name.split(' ')[0]}\n        </span>\n      </div>\n\n      {isSelected && (\n        <motion.div\n          layoutId=\"outline\"\n          className=\"absolute inset-0 border-2 border-cyan-500 rounded-xl\"\n          initial={false}\n          transition={{ type: 'spring', stiffness: 500, damping: 30 }}\n        />\n      )}\n    </motion.button>\n  );\n};\n\nconst StrategyCard = ({ strategy }: { strategy: Strategy }) => (\n  <GlassCard className=\"p-4 border-l-4 border-l-yellow-400 hover:bg-slate-800/50 transition-colors cursor-pointer group\">\n    <div className=\"flex justify-between items-center mb-2\">\n      <span className=\"text-xs font-bold text-yellow-400 px-2 py-0.5 bg-yellow-400/10 rounded border border-yellow-400/20\">\n        {strategy.type} STRATEGY\n      </span>\n      <span className=\"text-xs text-slate-500 font-mono\">CONF: {strategy.confidence}%</span>\n    </div>\n    <h4 className=\"font-bold text-white mb-2 group-hover:text-yellow-200 transition-colors\">\n      {strategy.title}\n    </h4>\n    <p className=\"text-slate-400 text-xs mb-3 line-clamp-2\">{strategy.content}</p>\n    <div className=\"bg-slate-950/50 p-2 rounded text-xs text-cyan-300 border border-cyan-900/30 flex gap-2\">\n      <Bot size={14} className=\"shrink-0 mt-0.5\" />\n      <span>{strategy.aiInsight}</span>\n    </div>\n  </GlassCard>\n);\n\nconst getIcon = (id: string) => {\n  switch (id) {\n    case 'political':\n      return <Globe size={18} />;\n    case 'economic':\n      return <TrendingUp size={18} />;\n    case 'social':\n      return <Activity size={18} />;\n    case 'technological':\n      return <Cpu size={18} />;\n    case 'environmental':\n      return <Leaf size={18} />;\n    case 'legal':\n      return <Scale size={18} />;\n    default:\n      return <AlertTriangle size={18} />;\n  }\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\ESG\\KeywordAnalyzer.tsx","messages":[{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has a missing dependency: 'watchList'. Either include it or remove the dependency array.","line":200,"column":6,"nodeT