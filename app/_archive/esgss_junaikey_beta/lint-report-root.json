</h4>\n                      <span className=\"text-[9px] font-black text-white/30 uppercase tracking-widest border border-white/5 px-3 py-1 rounded-lg\">\n                        {item.sector}\n                      </span>\n                    </div>\n                    <div className=\"text-right\">\n                      <p className=\"text-2xl font-black italic text-[#0ABAB5] tracking-tighter\">\n                        {item.performance}\n                      </p>\n                      <p className=\"text-[9px] font-black text-emerald-400/60 uppercase tracking-widest\">\n                        ANNUAL ROI\n                      </p>\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center gap-10 mb-8\">\n                    <div className=\"flex-1 space-y-3\">\n                      <div className=\"flex justify-between items-center text-[9px] font-black uppercase tracking-widest text-white/20\">\n                        <span>?蔭甈? Allocation</span>\n                        <span className=\"text-white\">{item.allocation}</span>\n                      </div>\n                      <div className=\"w-full bg-white/5 h-1.5 rounded-full overflow-hidden p-[1px]\">\n                        <motion.div\n                          initial={{ width: 0 }}\n                          whileInView={{ width: item.allocation }}\n                          transition={{ duration: 1.5 }}\n                          className=\"h-full bg-white/40 rounded-full\"\n                        />\n                      </div>\n                    </div>\n                    <div className=\"size-20 rounded-full border-4 border-[#0ABAB5]/20 flex flex-col items-center justify-center backdrop-blur-3xl bg-[#0ABAB5]/5 shadow-2xl\">\n                      <span className=\"text-xl font-black text-[#0ABAB5] tracking-tighter italic\">\n                        {item.score}\n                      </span>\n                      <span className=\"text-[7px] font-black text-white/40 uppercase tracking-widest\">\n                        ESG SCORE\n                      </span>\n                    </div>\n                  </div>\n\n                  <div className=\"pt-6 border-t border-white/5 flex items-center justify-between opacity-0 group-hover:opacity-100 transition-opacity\">\n                    <span className=\"text-[9px] font-black text-[#0ABAB5] uppercase tracking-[0.2em] italic\">\n                      ?亦?瘛勗漲?? Insight\n                    </span>\n                    <ArrowForwardIos fontSize=\"inherit\" className=\"text-[#0ABAB5] size-3\" />\n                  </div>\n                </motion.div>\n              ))}\n\n              {/* Add more strategy asset placeholder */}\n              <div className=\"p-10 rounded-[3rem] border border-dashed border-white/10 flex flex-col items-center justify-center gap-4 group hover:bg-[#0ABAB5]/5 hover:border-[#0ABAB5]/40 transition-all cursor-pointer opacity-30 hover:opacity-100\">\n                <Target\n                  size={32}\n                  className=\"text-white/20 group-hover:text-[#0ABAB5] transition-all\"\n                />\n                <p className=\"text-[10px] font-black text-white/30 uppercase tracking-[0.4em] group-hover:text-white transition-colors\">\n                  ?芸?鞈?蔭 Strategy Optimization\n                </p>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Global Disclosure Excellence Section */}\n        <motion.section\n          initial={{ opacity: 0, y: 50 }}\n          whileInView={{ opacity: 1, y: 0 }}\n          viewport={{ once: true }}\n          className=\"backdrop-blur-3xl bg-gradient-to-br from-[#102222] to-[#050d0d] border border-[#0ABAB5]/20 rounded-[5rem] p-24 shadow-3xl relative overflow-hidden group\"\n        >\n          <div className=\"absolute -top-20 -right-20 size-[600px] bg-[#0ABAB5]/5 rounded-full blur-[150px] pointer-events-none\" />\n\n          <div className=\"flex flex-col xl:flex-row items-center gap-24 relative z-10\">\n            <div className=\"flex-1 space-y-12\">\n              <div className=\"space-y-6\">\n                <div className=\"inline-flex items-center gap-4 px-6 py-2 rounded-full bg-[#0ABAB5]/10 border border-[#0ABAB5]/20\">\n                  <Globe size={16} className=\"text-[#0ABAB5]\" />\n                  <span className=\"text-[10px] font-black text-[#0ABAB5] uppercase tracking-[0.4em]\">\n                    Global Compliance Readiness\n                  </span>\n                </div>\n                <h2 className=\"text-6xl font-black italic tracking-tighter text-white leading-tight uppercase italic\">\n                  ?Ｗ??函?????\n                  <br />\n                  ?恍??銝剖? Disclosure Excellence\n                </h2>\n                <p className=\"text-[#9cbab9] text-2xl font-light italic leading-relaxed tracking-tight max-w-3xl\">\n                  ?拍{' '}\n                  <span className=\"text-[#0ABAB5] font-black not-italic underline decoration-[#0ABAB5]/30\">\n                    SSOT ?桐?鈭祕靘?\n                  </span>{' '}\n                  ?銵?蝣箔?瘥?隞?ESG 數據?賢?祟設計?亦??祕?扼遛頞?GRI?ASB ??TCFD\n                  蝑?????皞?蝮桀???瑽?鞈?鞈?銝?蝔晞n                </p>\n              </div>\n\n              <div className=\"flex gap-8\">\n                <button className=\"bg-[#0ABAB5] text-[#050d0d] px-16 py-6 rounded-[2.5rem] font-black italic text-xl uppercase tracking-tighter shadow-[0_20px_60px_rgba(10,186,181,0.3)] hover:translate-y-[-5px] transition-all active:scale-95 group\">\n                  多元核心 Q4 摮?漲?恍?勗? Generate Q4{' '}\n                  <DownloadIcon\n                    size={24}\n                    className=\"ml-4 inline group-hover:translate-y-1 transition-transform\"\n                  />\n                </button>\n                <button className=\"bg-white/5 border border-white/10 px-16 py-6 rounded-[2.5rem] font-black text-[12px] uppercase tracking-[0.2em] hover:bg-white/10 transition-all shadow-2xl active:scale-95\">\n                  ?舐鼠 ESG 撖抵?撠振 Specialist\n                </button>\n              </div>\n            </div>\n\n            <div className=\"xl:w-1/3 grid grid-cols-1 gap-6 w-full\">\n              {[\n                { label: '透明摨行???Transparency', val: '99.9%', icon: ShieldCheck, active: true },\n                { label: '??????Compliance', val: '100%', icon: Globe },\n                { label: '?恍合約 Efficiency', val: '2s Instant', icon: Zap, active: true },\n              ].map((card, i) => (\n                <div\n                  key={i}\n                  className={`p-10 rounded-[3.5rem] flex items-center gap-10 border transition-all hover:scale-105 shadow-2xl ${card.active ? 'bg-[#0ABAB5]/10 border-[#0ABAB5]/30' : 'bg-white/5 border-white/10'}`}\n                >\n                  <div className=\"size-16 rounded-[2rem] bg-white/5 flex items-center justify-center text-[#0ABAB5] shadow-inner group-hover/card:scale-110\">\n                    <card.icon size={32} />\n                  </div>\n                  <div className=\"space-y-1\">\n                    <p className=\"text-white/30 text-[10px] font-black uppercase tracking-[0.3em]\">\n                      {card.label}\n                    </p>\n                    <p className=\"text-3xl font-black italic text-white tracking-tighter\">\n                      {card.val}\n                    </p>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </div>\n        </motion.section>\n      </main>\n\n      <footer className=\"mt-40 border-t border-white/5 p-20 text-center space-y-12 backdrop-blur-3xl bg-black/20\">\n        <div className=\"flex justify-center gap-20\">\n          {['GRI Standards', 'SASB Certified', 'TCFD Compliant', 'UN PRI Signatory'].map(\n            (logo, i) => (\n              <span\n                key={i}\n                className=\"text-white/10 text-xl font-black italic tracking-tighter grayscale hover:grayscale-0 hover:text-[#0ABAB5] transition-all cursor-default\"\n              >\n                {logo}\n              </span>\n            )\n          )}\n        </div>\n        <p className=\"text-[10px] font-black uppercase tracking-[0.5em] text-white/30 italic\">\n          穢 2024 ESGss JunAiKey ??DingJun Hong ??Capital Management & Disclosure Engine v6.1\n        </p>\n        <div className=\"flex justify-center gap-12 text-[#0ABAB5]/40 text-[9px] font-black uppercase tracking-widest\">\n          <a href=\"#\" className=\"hover:text-[#0ABAB5] transition-colors\">\n            ?梁??輻? Policy\n          </a>\n          <a href=\"#\" className=\"hover:text-[#0ABAB5] transition-colors\">\n            ??驗證 Terms\n          </a>\n          <a href=\"#\" className=\"hover:text-[#0ABAB5] transition-colors\">\n            撖抵??亥? Logs\n          </a>\n        </div>\n      </footer>\n\n      <style>{`\n        .custom-scrollbar::-webkit-scrollbar {\n          width: 5px;\n        }\n        .custom-scrollbar::-webkit-scrollbar-track {\n          background: #051414;\n        }\n        .custom-scrollbar::-webkit-scrollbar-thumb {\n          background: #0ABAB540;\n          border-radius: 20px;\n        }\n      `}</style>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\IpmsDashboard.tsx","messages":[{"ruleId":"react-hooks/set-state-in-effect","severity":2,"message":"Error: Calling setState synchronously within an effect can trigger cascading renders\n\nEffects are intended to synchronize state between React and external systems such as manually updating the DOM, state management libraries, or other platform APIs. In general, the body of an effect should do one or both of the following:\n* Update external systems with the latest state from React.\n* Subscribe for updates from some external system, calling setState in a callback function when external state changes.\n\nCalling setState synchronously within an effect body causes cascading renders that can hurt performance, and is not recommended. (https://react.dev/learn/you-might-not-need-an-effect).\n\nC:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\IpmsDashboard.tsx:111:5\n  109 |     const healthSub = service.getSystemHealthStream().subscribe(setHealthData);\n  110 |     const trendSub = service.getESGTrendData().subscribe(setEsgTrend);\n> 111 |     setProjectDist(service.getProjectDistribution());\n      |     ^^^^^^^^^^^^^^ Avoid calling setState() directly within an effect\n  112 |\n  113 |     return () => {\n  114 |       healthSub.unsubscribe();","line":111,"column":5,"nodeType":null,"endLine":111,"endColumn":19},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":189,"column":28,"nodeType":"Literal","messageId":"noMagic","endLine":189,"endColumn":30},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 4.","line":345,"column":50,"nodeType":"Literal","messageId":"noMagic","endLine":345,"endColumn":51},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 4.","line":345,"column":53,"nodeType":"Literal","messageId":"noMagic","endLine":345,"endColumn":54}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect } from 'react';\nimport {\n  LayoutGrid,\n  Leaf,\n  Activity,\n  Zap,\n  Clock,\n  Target,\n  Users,\n  TrendingUp,\n  AlertTriangle,\n  Globe,\n  Droplets,\n  Wind,\n} from 'lucide-react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport {\n  DashboardDataService,\n  SystemHealthData,\n  ESGScoreData,\n  ProjectStatusData,\n} from '../../services/mock/DashboardDataService';\nimport {\n  AreaChart,\n  Area,\n  XAxis,\n  YAxis,\n  CartesianGrid,\n  Tooltip,\n  ResponsiveContainer,\n  RadialBarChart,\n  RadialBar,\n  Legend,\n  BarChart,\n  Bar,\n  Cell,\n} from 'recharts';\n\n// --- Components ---\n\nconst GlassCard: React.FC<{\n  children: React.ReactNode;\n  className?: string;\n  delay?: number;\n}> = ({ children, className = '', delay = 0 }) => (\n  <motion.div\n    initial={{ opacity: 0, y: 20 }}\n    animate={{ opacity: 1, y: 0 }}\n    transition={{ duration: 0.5, delay }}\n    className={`glass-panel-premium p-6 relative overflow-hidden group ${className}`}\n  >\n    {/* Dynamic Background Glow */}\n    <div className=\"absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-white/10 to-transparent rounded-full blur-2xl -translate-y-1/2 translate-x-1/2 group-hover:scale-150 transition-transform duration-700 ease-out\" />\n    <div className=\"relative z-10 h-full\">{children}</div>\n  </motion.div>\n);\n\nconst MetricValue: React.FC<{\n  label: string;\n  value: string | number;\n  unit?: string;\n  trend?: 'up' | 'down' | 'neutral';\n  trendValue?: string;\n  icon?: React.ElementType;\n  color?: string;\n}> = ({ label, value, unit, trend, trendValue, icon: Icon, color = 'text-slate-200' }) => (\n  <div className=\"flex flex-col h-full justify-between\">\n    <div className=\"flex items-start justify-between mb-2\">\n      <span className=\"text-slate-400 text-xs font-medium tracking-wider uppercase\">{label}</span>\n      {Icon && <Icon className={`w-5 h-5 ${color} opacity-80`} />}\n    </div>\n    <div className=\"flex items-end gap-2\">\n      <span className={`text-3xl font-light tracking-tight ${color}`}>\n        {value}\n        {unit && <span className=\"text-sm font-normal text-slate-500 ml-1\">{unit}</span>}\n      </span>\n    </div>\n    {trend && (\n      <div\n        className={`flex items-center gap-1 text-xs mt-2 ${\n          trend === 'up'\n            ? 'text-emerald-400'\n            : trend === 'down'\n              ? 'text-rose-400'\n              : 'text-slate-400'\n        }`}\n      >\n        {trend === 'up' ? (\n          <TrendingUp className=\"w-3 h-3\" />\n        ) : trend === 'down' ? (\n          <TrendingUp className=\"w-3 h-3 rotate-180\" />\n        ) : null}\n        <span>{trendValue}</span>\n      </div>\n    )}\n  </div>\n);\n\nexport const IpmsDashboard: React.FC = () => {\n  // Data State\n  const [healthData, setHealthData] = useState<SystemHealthData | null>(null);\n  const [esgTrend, setEsgTrend] = useState<ESGScoreData[]>([]);\n  const [projectDist, setProjectDist] = useState<ProjectStatusData[]>([]);\n\n  useEffect(() => {\n    const service = DashboardDataService.getInstance();\n\n    // Subscribe to streams\n    const healthSub = service.getSystemHealthStream().subscribe(setHealthData);\n    const trendSub = service.getESGTrendData().subscribe(setEsgTrend);\n    setProjectDist(service.getProjectDistribution());\n\n    return () => {\n      healthSub.unsubscribe();\n      trendSub.unsubscribe();\n    };\n  }, []);\n\n  return (\n    <div className=\"w-full h-full min-h-screen\">\n      {/* Header Section (Mobile Optimized) */}\n      <div className=\"mb-6 md:mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4\">\n        <div>\n          <h1 className=\"text-3xl md:text-4xl font-extralight tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-slate-100 to-slate-400 mb-2\">\n            IPMS <span className=\"font-bold text-cyan-400\">NEXUS</span>\n          </h1>\n          <p className=\"text-slate-400 text-sm md:text-base max-w-xl\">\n            整合撘?獢恣?頂蝯?v7.0 ??<span className=\"text-emerald-400\">系統???雿喳?</span>\n          </p>\n        </div>\n\n        {/* Quick Actions / Status */}\n        <div className=\"flex gap-3 overflow-x-auto pb-2 md:pb-0 scrollbar-hide\">\n          <GlassCard className=\"!p-3 !min-w-[120px] flex items-center gap-3\">\n            <div className=\"relative\">\n              <div className=\"w-2 h-2 rounded-full bg-emerald-500 animate-pulse\" />\n              <div className=\"absolute inset-0 rounded-full bg-emerald-500 blur-sm animate-pulse\" />\n            </div>\n            <div className=\"flex flex-col\">\n              <span className=\"text-[10px] text-slate-400 uppercase\">蝬脰楝撱園</span>\n              <span className=\"text-xs font-bold text-emerald-400\">\n                {healthData?.network ?? '--'} ms\n              </span>\n            </div>\n          </GlassCard>\n          <GlassCard className=\"!p-3 !min-w-[120px] flex items-center gap-3\">\n            <div className=\"w-2 h-2 rounded-full bg-cyan-500\" />\n            <div className=\"flex flex-col\">\n              <span className=\"text-[10px] text-slate-400 uppercase\">CPU 鞎?</span>\n              <span className=\"text-xs font-bold text-cyan-400\">{healthData?.cpu ?? '--'}%</span>\n            </div>\n          </GlassCard>\n        </div>\n      </div>\n\n      {/* Main Bento Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 auto-rows-[minmax(180px,auto)] md:auto-rows-[160px]\">\n        {/* 1. ESG Score Trend (Large Chart) */}\n        <GlassCard className=\"col-span-1 md:col-span-8 md:row-span-2 relative\">\n          <div className=\"absolute top-6 left-6 z-10\">\n            <h3 className=\"text-lg font-medium text-slate-200 flex items-center gap-2\">\n              <Leaf className=\"w-5 h-5 text-emerald-400\" />\n              ESG 蝮暹??\n            </h3>\n            <p className=\"text-slate-400 text-xs mt-1\">E, S, G 銝雁摨血?蔣?踹?追蹤</p>\n          </div>\n\n          <div className=\"w-full h-full pt-12\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <AreaChart data={esgTrend}>\n                <defs>\n                  <linearGradient id=\"colorTotal\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n                    <stop offset=\"5%\" stopColor=\"#10b981\" stopOpacity={0.3} />\n                    <stop offset=\"95%\" stopColor=\"#10b981\" stopOpacity={0} />\n                  </linearGradient>\n                </defs>\n                <CartesianGrid\n                  strokeDasharray=\"3 3\"\n                  stroke=\"rgba(255,255,255,0.05)\"\n                  vertical={false}\n                />\n                <XAxis\n                  dataKey=\"timestamp\"\n                  tick={{ fill: '#94a3b8', fontSize: 10 }}\n                  axisLine={false}\n                  tickLine={false}\n                />\n                <YAxis\n                  domain={[60, 100]}\n                  tick={{ fill: '#94a3b8', fontSize: 10 }}\n                  axisLine={false}\n                  tickLine={false}\n                  width={30}\n                />\n                <Tooltip\n                  contentStyle={{\n                    backgroundColor: 'rgba(15, 23, 42, 0.9)',\n                    borderColor: 'rgba(255,255,255,0.1)',\n                    borderRadius: '12px',\n                  }}\n                  itemStyle={{ color: '#e2e8f0' }}\n                />\n                <Area\n                  type=\"monotone\"\n                  dataKey=\"total\"\n                  stroke=\"#10b981\"\n                  strokeWidth={3}\n                  fillOpacity={1}\n                  fill=\"url(#colorTotal)\"\n                />\n                <Area\n                  type=\"monotone\"\n                  dataKey=\"environmental\"\n                  stroke=\"#34d399\"\n                  strokeWidth={1}\n                  strokeDasharray=\"5 5\"\n                  fill=\"none\"\n                  opacity={0.5}\n                />\n              </AreaChart>\n            </ResponsiveContainer>\n          </div>\n        </GlassCard>\n\n        {/* 2. System Intelligence (Radial) */}\n        <GlassCard className=\"col-span-1 md:col-span-4 md:row-span-2 flex flex-col items-center justify-center\">\n          <h3 className=\"absolute top-6 left-6 text-sm font-medium text-slate-300 flex items-center gap-2\">\n            <Zap className=\"w-4 h-4 text-amber-400\" /> 系統?\n          </h3>\n          <div className=\"w-full h-full mt-4\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <RadialBarChart\n                innerRadius=\"60%\"\n                outerRadius=\"100%\"\n                barSize={10}\n                data={[\n                  { name: 'Energy', value: healthData?.energyEfficiency ?? 0, fill: '#f59e0b' },\n                  { name: 'Memory', value: 100 - (healthData?.memory ?? 0), fill: '#3b82f6' },\n                  { name: 'Stability', value: 98, fill: '#10b981' },\n                ]}\n                startAngle={180}\n                endAngle={0}\n              >\n                <RadialBar\n                  label={{ position: 'insideStart', fill: '#fff' }}\n                  background\n                  dataKey=\"value\"\n                  cornerRadius={10}\n                />\n                <Legend\n                  iconSize={8}\n                  layout=\"vertical\"\n                  verticalAlign=\"middle\"\n                  wrapperStyle={{ right: 8, top: '20%' }}\n                  formatter={value => <span className=\"text-slate-400 text-xs\">{value}</span>}\n                />\n              </RadialBarChart>\n            </ResponsiveContainer>\n            {/* Center Metric */}\n            <div className=\"absolute inset-0 flex items-center justify-center pt-8 pointer-events-none\">\n              <div className=\"text-center\">\n                <span className=\"text-3xl font-bold text-slate-200\">\n                  {healthData?.energyEfficiency.toFixed(1)}%\n                </span>\n                <p className=\"text-[10px] text-slate-500 uppercase tracking-widest\">?賣?合約</p>\n              </div>\n            </div>\n          </div>\n        </GlassCard>\n\n        {/* 3. Key Metrics Row */}\n        <GlassCard className=\"col-span-1 md:col-span-3\">\n          <MetricValue\n            label=\"瘣餉?撠?\"\n            value=\"12\"\n            unit=\"?脰?銝苒"\n            trend=\"up\"\n            trendValue=\"+2 ?祇望憓"\n            icon={Target}\n            color=\"text-blue-400\"\n          />\n        </GlassCard>\n\n        <GlassCard className=\"col-span-1 md:col-span-3\">\n          <MetricValue\n            label=\"蝣單??\"\n            value=\"854\"\n            unit=\"tCO2e\"\n            trend=\"up\"\n            trendValue=\"頛?????15%\"\n            icon={Wind}\n            color=\"text-emerald-400\"\n          />\n        </GlassCard>\n\n        <GlassCard className=\"col-span-1 md:col-span-3 bg-gradient-to-br from-indigo-500/10 to-purple-500/10 border-indigo-500/20\">\n          <MetricValue\n            label=\"AI 代稱\"\n            value=\"48\"\n            unit=\"瘣餉?銝苒"\n            trend=\"neutral\"\n            trendValue=\"鞎??雿喳?\"\n            icon={Activity}\n            color=\"text-indigo-400\"\n          />\n        </GlassCard>\n\n        <GlassCard className=\"col-span-1 md:col-span-3\">\n          <MetricValue\n            label=\"?拙拿??鈭暝"\n            value=\"3.2k\"\n            unit=\"鈭暝"\n            trend=\"up\"\n            trendValue=\"+128 ?啣?\"\n            icon={Users}\n            color=\"text-amber-400\"\n          />\n        </GlassCard>\n\n        {/* 4. Project Status Distribution */}\n        <GlassCard className=\"col-span-1 md:col-span-6\">\n          <div className=\"flex items-center justify-between mb-4\">\n            <h3 className=\"text-sm font-medium text-slate-300\">撠??亙熒摨血?雿?/h3>\n            <span className=\"text-xs text-slate-500\">?單????/span>\n          </div>\n          <div className=\"h-24\">\n            <ResponsiveContainer width=\"100%\" height=\"100%\">\n              <BarChart layout=\"vertical\" data={projectDist} barSize={12}>\n                <XAxis type=\"number\" hide />\n                <YAxis\n                  dataKey=\"name\"\n                  type=\"category\"\n                  width={80}\n                  tick={{ fill: '#94a3b8', fontSize: 10 }}\n                  axisLine={false}\n                  tickLine={false}\n                />\n                <Tooltip\n                  cursor={{ fill: 'transparent' }}\n                  contentStyle={{\n                    backgroundColor: 'rgba(15, 23, 42, 0.9)',\n                    borderColor: 'rgba(255,255,255,0.1)',\n                  }}\n                />\n                <Bar dataKey=\"value\" radius={[0, 4, 4, 0]}>\n                  {projectDist.map((entry, index) => (\n                    <Cell key={`cell-${index}`} fill={entry.fill} />\n                  ))}\n                </Bar>\n              </BarChart>\n            </ResponsiveContainer>\n          </div>\n        </GlassCard>\n\n        {/* 5. Alerts / Feed */}\n        <GlassCard className=\"col-span-1 md:col-span-6 overflow-y-auto custom-scrollbar\">\n          <div className=\"flex items-center justify-between mb-4\">\n            <h3 className=\"text-sm font-medium text-slate-300\">?箸閮?皞?/h3>\n            <Clock className=\"w-4 h-4 text-slate-500\" />\n          </div>\n          <div className=\"space-y-3\">\n            <div className=\"flex gap-3 items-start p-2 rounded-lg hover:bg-white/5 transition-colors\">\n              <div className=\"mt-1 w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399]\" />\n              <div>\n                <p className=\"text-xs text-slate-300\">Q1 撠?撌脤??４?菜??格???/p>\n                <span className=\"text-[10px] text-slate-500\">2 ???????芸?撽?</span>\n              </div>\n            </div>\n            <div className=\"flex gap-3 items-start p-2 rounded-lg hover:bg-white/5 transition-colors\">\n              <div className=\"mt-1 w-2 h-2 rounded-full bg-amber-400\" />\n              <div>\n                <p className=\"text-xs text-slate-300\">B?隡箸??典皜砍擃?撣詻?/p>\n                <span className=\"text-[10px] text-slate-500\">15 ???????啣虜?菜葫</span>\n              </div>\n            </div>\n          </div>\n        </GlassCard>\n      </div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\JunAiKeyDashboard.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":153,"column":42,"nodeType":"Literal","messageId":"noMagic","endLine":153,"endColumn":43},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":153,"column":63,"nodeType":"Literal","messageId":"noMagic","endLine":153,"endColumn":65},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3.","line":153,"column":81,"nodeType":"Literal","messageId":"noMagic","endLine":153,"endColumn":82},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 15.","line":153,"column":85,"nodeType":"Literal","messageId":"noMagic","endLine":153,"endColumn":87},{"ruleId":"react-hooks/exhaustive-deps","severity":1,"message":"React Hook useEffect has missing dependencies: 'isZh' and 'rpgProfile'. Either include them or remove the dependency array.","line":195,"column":6,"nodeType":"ArrayExpression","endLine":195,"endColumn":24,"suggestions":[{"desc":"Update the dependencies array to be: [isZh, rpgProfile, rpgProfile.level]","fix":{"range":[6767,6785],"text":"[isZh, rpgProfile, rpgProfile.level]"}}]},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 2000.","line":202,"column":49,"nodeType":"Literal","messageId":"noMagic","endLine":202,"endColumn":53},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 140.","line":244,"column":67,"nodeType":"Literal","messageId":"noMagic","endLine":244,"endColumn":70},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 110.","line":244,"column":73,"nodeType":"Literal","messageId":"noMagic","endLine":244,"endColumn":76},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 125.","line":244,"column":80,"nodeType":"Literal","messageId":"noMagic","endLine":244,"endColumn":83},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 150.","line":245,"column":47,"nodeType":"Literal","messageId":"noMagic","endLine":245,"endColumn":50},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":245,"column":76,"nodeType":"Literal","messageId":"noMagic","endLine":245,"endColumn":78},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 130.","line":245,"column":82,"nodeType":"Literal","messageId":"noMagic","endLine":245,"endColumn":85},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 150.","line":247,"column":34,"nodeType":"Literal","messageId":"noMagic","endLine":247,"endColumn":37},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":247,"column":62,"nodeType":"Literal","messageId":"noMagic","endLine":247,"endColumn":64},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 150.","line":248,"column":37,"nodeType":"Literal","messageId":"noMagic","endLine":248,"endColumn":40},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 110.","line":248,"column":42,"nodeType":"Literal","messageId":"noMagic","endLine":248,"endColumn":45},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 20.","line":248,"column":70,"nodeType":"Literal","messageId":"noMagic","endLine":248,"endColumn":72},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: -20.","line":296,"column":32,"nodeType":"UnaryExpression","messageId":"noMagic","endLine":296,"endColumn":35},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 800.","line":303,"column":46,"nodeType":"Literal","messageId":"noMagic","endLine":303,"endColumn":49},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5000.","line":317,"column":45,"nodeType":"Literal","messageId":"noMagic","endLine":317,"endColumn":49},{"ruleId":"react/jsx-no-un