omponent } from './GoodwardCore';\n\nexport interface IVerifiedResponse {\n  core: IComponentCore;\n  message: string;\n}\n\n/**\n * 奧秘精靈 (OmniKey) - 系統協議?矽?n * ================================================\n *\n * ?撠?:\n * - 蝚砌?璇? 奧秘精靈 (OmniKey) - 銝剖亢?矽????跚n *\n * ?:\n * - ?矽?剖??脣? (Six Forms)\n * - 蝞∠????嗅悅畾輻?鈭支?\n * - 作為憭?誘?絞銝?亙\n */\nexport class OmniKey {\n  protected static instance: OmniKey;\n\n  protected constructor() {\n    omniLogger.info(LogCategory.SYSTEM, '奧秘精靈 (OmniKey) 撌脣?憪???);\n  }\n\n  /**\n   * ?脣??桐?撖虫? (?舀?摮?)\n   */\n  public static getInstance(): OmniKey {\n    if (!this.instance) {\n      this.instance = new OmniKey();\n    }\n    return this.instance;\n  }\n\n  /**\n   * 閫?? (Unlock) - ??代稱?脣?敺芰\n   * ?憭系統?澆奧秘代稱?????n   */\n  /**\n   * 閫?? (Unlock) - ??代稱?脣?敺芰\n   * ?憭系統?澆奧秘代稱?????n   * @returns verified component ensuring 5T compliance\n   */\n  public async unlock(input: string): Promise<IVerifiedResponse> {\n    const generateErrorResponse = (msg: string): IVerifiedResponse => ({\n      message: msg,\n      core: lockComponent({\n        uuid: 'error-response',\n        status: 'Trustworthy',\n        evidence: {\n          logicGate: {\n            tangible: 'Error-Response',\n            traceable: 'OmniKey',\n            trackable: 'Error-001',\n            transparent: 'Standard-Error-Protocol',\n            trustworthy: 'System-Generated',\n          },\n          timestamp: Date.now(),\n          hash: 'error-hash',\n        },\n      }),\n    });\n\n    if (!input) {\n      omniLogger.warn(LogCategory.SYSTEM, '[OmniKey] Empty input received.');\n      return generateErrorResponse('?嗅蝛箸?隞歹?隢?靘擃璅?);\n    }\n\n    const memory = useOmniMemory.getState();\n    omniLogger.info(LogCategory.SYSTEM, `[OmniKey] ?嗅閫???誘: ${input}`);\n\n    try {\n      // [蝚砌?撘??] Awakening\n      memory.setEvolutionPhase('AWAKENING');\n      const perception = OmniEvolution.awaken(input);\n      memory.addInteractionLog(perception.topic);\n\n      // [蝚砌?撘?閫??] Analysis\n      memory.setEvolutionPhase('ANALYSIS');\n      const analysis = await OmniEvolution.analyze(input);\n      omniLogger.debug(\n        LogCategory.AGENT,\n        `[OmniKey] 閫????: ${analysis.intent} (靽∪?摨? ${analysis.confidence}, 銴?摨? ${analysis.complexity})`\n      );\n\n      // [蝚砌?撘??梢陷] Resonance\n      memory.setEvolutionPhase('RESONANCE');\n      const resonanceScore = OmniEvolution.calculateResonance(\n        analysis.intent,\n        memory.palace.theVault.conceptWeights\n      );\n      omniLogger.debug(LogCategory.AGENT, `[OmniKey] ?梢陷?: ${resonanceScore}`);\n\n      // [蝚砍?撘?憟抒儔] Strategy\n      memory.setEvolutionPhase('STRATEGY');\n      const strategies = await OmniEvolution.strategize(\n        analysis.intent,\n        input,\n        analysis.complexity\n      );\n\n      // [蝚砌?撘??賢?] Execution\n      memory.setEvolutionPhase('EXECUTION');\n      const executionResult = await OmniEvolution.execute(analysis.intent, strategies);\n\n      const result = `[代稱??] ${executionResult}\n蝑:\n${strategies.map(s => `- ${s}`).join('\\n')}\n(?梢陷蝑?: ${resonanceScore})`;\n\n      // [蝚砍撘??] Evolution\n      memory.setEvolutionPhase('EVOLUTION');\n\n      // 撘瑕???璁艙\n      memory.reinforceConcept(analysis.intent, 0.5);\n\n      // 設計?脣???撽墦n      const xpGained = await OmniEvolution.calculateExperience(\n        memory.evolutionState.evolutionLevel,\n        analysis.confidence\n      );\n\n      memory.updateEvolutionMetrics({\n        experiencePoints: memory.evolutionState.experiencePoints + xpGained,\n        inferenceSpeed: Math.random() * 50 + 50, // 璅⊥?芸?\n      } as any);\n\n      omniLogger.info(LogCategory.SYSTEM, `[OmniKey] ?脣?敺芰摰??敺?XP: ${xpGained}`);\n      omniLogger.info(LogCategory.SYSTEM, `[OmniKey] ?脣?敺芰摰??敺?XP: ${xpGained}`);\n\n      // Construct 5T Verified Component\n      const responseCore: IComponentCore = lockComponent({\n        uuid: `response-${Date.now()}`,\n        status: 'Trustworthy',\n        evidence: {\n          logicGate: {\n            tangible: `Analysis: ${analysis.intent}`,\n            traceable: `Input: ${input}`,\n            trackable: `Evolution-Phase: ${memory.evolutionState.currentPhase}`,\n            transparent: 'OmniEvolution-v7',\n            trustworthy: `Resonance: ${resonanceScore}`,\n          },\n          timestamp: Date.now(),\n          hash: 'verified-response-hash',\n        },\n      });\n\n      // [New] Log to Evidence Vault\n      memory.addEvidence(responseCore.evidence);\n\n      return {\n        core: responseCore,\n        message: result,\n      };\n    } catch (error: unknown) {\n      const errorMessage = error instanceof Error ? error.message : String(error);\n      omniLogger.error(LogCategory.SYSTEM, '[OmniKey] ?瑁????潛?瘛瑟? (Chaos)', {\n        error: errorMessage,\n      });\n      return generateErrorResponse('系統?潛??啣虜嚗??仿???嚗???⊥???);\n    }\n  }\n\n  /**\n   * 精靈?蔭??皞瘥\n   */\n  public destroy(): void {\n    omniLogger.info(LogCategory.SYSTEM, '[OmniKey] Core resources released.');\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\core\\SovereignEngine.ts","messages":[{"ruleId":"@typescript-eslint/prefer-as-const","severity":2,"message":"Expected a `const` assertion instead of a literal type annotation.","line":15,"column":29,"nodeType":"TSLiteralType","messageId":"variableConstAssertion","endLine":15,"endColumn":36,"suggestions":[{"messageId":"variableSuggest","fix":{"range":[600,619],"text":" = '7.0.0' as const"},"desc":"You should use `as const` instead of type annotation."}]},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":28,"column":23,"nodeType":"Literal","messageId":"noMagic","endLine":28,"endColumn":24},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 16.","line":31,"column":41,"nodeType":"Literal","messageId":"noMagic","endLine":31,"endColumn":43},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 4.","line":32,"column":59,"nodeType":"Literal","messageId":"noMagic","endLine":32,"endColumn":60},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1.5.","line":84,"column":34,"nodeType":"Literal","messageId":"noMagic","endLine":84,"endColumn":37}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * ? 協議瞍?嚗??偶蝥瑁?賢??啣???(Sovereign JunAiKey Engine)\n * --------------------------------------------------\n * [靘??酉] ?誑蝯憪瑚遙?????瘜瑽n * [協議定義] 5T Sentinel Protocol (Traceable, Trackable, Transparent, Tangible, Trustworthy)\n * [?] Sentient v7.0.0\n */\n\nimport { IComponentCore } from './GoodwardCore.ts';\nimport { IAuthKey, IImpactLedger } from '../../types/core/index.ts';\nimport { AutonomousCompendium } from '../../core/knowledge/AutonomousCompendium.ts';\nimport { omniLogger, LogCategory } from '../infrastructure/logging/OmniLogger.ts';\n\nexport class JunAiKeyEngine {\n  private readonly version: '7.0.0' = '7.0.0';\n  private entropyLevel: number = 0.0; // ???萄墦n\n  /**\n   * ?妞 多元核心??訾?頨思遢 (Bio-Digital Identity)\n   */\n  public generateBioID(agent: Record<string, unknown>): string {\n    const lineage = (agent.geneticBlueprintId as string) || 'ORIGINAL_CORE';\n    const payload = `${agent.archetypeId}-${agent.level}-${agent.type}-${lineage}-${JSON.stringify(agent.drift)}`;\n\n    let hash = 0;\n    for (let i = 0; i < payload.length; i++) {\n      const char = payload.charCodeAt(i);\n      hash = (hash << 5) - hash + char;\n      hash = hash & hash;\n    }\n    const hex = Math.abs(hash).toString(16).toUpperCase();\n    return `BIO-${hex}-${(agent['id'] as string).slice(0, 4)}`;\n  }\n\n  public activateTwinResonance(csoKey: IAuthKey, ctoKey: IAuthKey): boolean {\n    if (csoKey.type === 'JUN_AI_KEY' && ctoKey.type === 'TECH_ORACLE') {\n      omniLogger.info(LogCategory.SECURITY, '? ?菜葫?圈??曈湛?隞餌鈭??函?鞎恍?);\n      return true;\n    }\n    omniLogger.warn(LogCategory.SECURITY, '? ???梢陷憭望?嚗??唬??寥?');\n    return false;\n  }\n\n  /**\n   * 🏛️??賢?隞嗅???(5T Sentinel Protocol)\n   */\n  public mintComponent(rawData: Record<string, unknown>, origin: string): IComponentCore {\n    const uuid = crypto.randomUUID();\n\n    const component: IComponentCore = {\n      uuid,\n      // version: this.version, // Removed to match strict interface or extend interface if needed.\n      // Current GoodwardCore IComponentCore only has uuid, status, evidence.\n      // We will map extra data into evidence or we need to extend GoodwardCore.\n      // For now, mapping to strict IComponentCore as defined in GoodwardCore.ts\n      status: 'Trustworthy',\n      evidence: {\n        logicGate: {\n          tangible: 'AR6-Standard',\n          traceable: `Source: ${origin}`,\n          trackable: `BioID: ${this.generateBioID(rawData)}`,\n          transparent: '5T-Sentinel-v7',\n          trustworthy: this.generateBioID(rawData),\n        },\n        timestamp: Date.now(),\n        hash: this.generateBioID(rawData),\n      },\n    };\n\n    const { isValid, violations } = AutonomousCompendium.validate(component, 'PROTOCOL_5T');\n    if (!isValid && violations.length > 0) {\n      const violation = violations[0]!;\n      omniLogger.error(\n        LogCategory.SECURITY,\n        `? [SovereignEngine] Component Minting Refused: Violated ${violation.name}`\n      );\n      throw new Error(`LAW_VIOLATION: ${violation.id}`);\n    }\n\n    return Object.freeze(component);\n  }\n\n  public harvestImpact(creationValue: number): IImpactLedger {\n    const sroi = creationValue * 1.5;\n    return {\n      totalImpact: sroi,\n      beneficiaries: 'Global_Talent_OS',\n      signature: 'DR_SUSHI_VISION_APPROVED',\n    };\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\core\\VirtueEngine10.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":34,"column":13,"nodeType":"Literal","messageId":"noMagic","endLine":34,"endColumn":15},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3.","line":35,"column":40,"nodeType":"Literal","messageId":"noMagic","endLine":35,"endColumn":41},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3.","line":35,"column":43,"nodeType":"Literal","messageId":"noMagic","endLine":35,"endColumn":44},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":38,"column":30,"nodeType":"Literal","messageId":"noMagic","endLine":38,"endColumn":32},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":38,"column":64,"nodeType":"Literal","messageId":"noMagic","endLine":38,"endColumn":66},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":41,"column":29,"nodeType":"Literal","messageId":"noMagic","endLine":41,"endColumn":31},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":41,"column":68,"nodeType":"Literal","messageId":"noMagic","endLine":41,"endColumn":70},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":44,"column":25,"nodeType":"Literal","messageId":"noMagic","endLine":44,"endColumn":27},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":44,"column":60,"nodeType":"Literal","messageId":"noMagic","endLine":44,"endColumn":62},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":47,"column":28,"nodeType":"Literal","messageId":"noMagic","endLine":47,"endColumn":30},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":47,"column":65,"nodeType":"Literal","messageId":"noMagic","endLine":47,"endColumn":67},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":50,"column":25,"nodeType":"Literal","messageId":"noMagic","endLine":50,"endColumn":27},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":50,"column":63,"nodeType":"Literal","messageId":"noMagic","endLine":50,"endColumn":65},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":95,"column":30,"nodeType":"Literal","messageId":"noMagic","endLine":95,"endColumn":32},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":98,"column":31,"nodeType":"Literal","messageId":"noMagic","endLine":98,"endColumn":33}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":15,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * ? 協議瞍?嚗irtueEngine10 (??品牌敺瑁?撘?)\n * --------------------------------------------------\n * [驗證] 4+1 (5T Edition: 4??1銝)\n * [?] Sentient v7.0.0\n * [定義] 1-10 璅漲?n */\n\nimport type { IMeritProfile10 } from '../../types/core/index.ts';\nimport { IComponentCore } from './GoodwardCore';\n\nexport interface IRawESGData {\n  core?: IComponentCore; // 5T Logic Gate Core\n  hashLockVerified: boolean; // Legacy check, kept for backward compatibility if core is missing\n  dataQuality: number; // 1-3\n  aiComplexity: number; // 0-1\n  socialImpactRatio: number; // 0-1\n  executionRate: number; // 0-1\n  carbonReduction: number; // 0-1\n  ecosystemDensity: number; // 0-1\n}\n\nexport class VirtueEngine10 {\n  /**\n   * ?? Transparent: 透明??蝞?αn   * 撠?憪??箸??? 10 ?敺瑁??? (Crystallization)\n   * ??撠? 5T 驗證?擛亙惇?吭n   */\n  static crystallize(raw: IRawESGData): IMeritProfile10 {\n    return {\n      // 隤?(Integrity): ? Trustworthy - 數據靽∪祕摨西?銝蝭⊥??[DEF]\n      integrity:\n        raw.core?.status === 'Trustworthy' || raw.hashLockVerified\n          ? 10\n          : Math.min(raw.dataQuality * 3, 3),\n\n      // ??(Intelligence): ?? Transparent - AI 瘙箇??捱蝑移皞漲??瘜?摨?[MP]\n      intelligence: Math.min(10, Math.round(raw.aiComplexity * 10)),\n\n      // 隞?(Benevolence): ?拙拿??鈭箇?蟡?(Resonance) - 蝷暹?敶梢??[HP]\n      benevolence: Math.min(10, Math.round(raw.socialImpactRatio * 10)),\n\n      // ??(Courage): ? Traceable - 頧??瑁?????瞍????[ATK]\n      courage: Math.min(10, Math.round(raw.executionRate * 10)),\n\n      // 蝭 (Temperance): ? Tangible - 蝣喟皜蜀??鞈?頧?撘瑕漲 [Eff]\n      temperance: Math.min(10, Math.round(raw.carbonReduction * 10)),\n\n      // ??(Harmony): ? Trackable - 多元核心蝟餃?雿?靘??璁?[Syn]\n      harmony: Math.min(10, Math.round(raw.ecosystemDensity * 10)),\n    };\n  }\n\n  /**\n   * ?荔? ?窗???沔n   */\n  static getMeridian(profile: IMeritProfile10): 'INWARD_REN' | 'OUTWARD_DU' {\n    const renSum = profile.intelligence + profile.benevolence + profile.courage;\n    const duSum = profile.integrity + profile.temperance + profile.harmony;\n    // Tie-breaker: Integrity wins (DU) if equal, usually. But user code said >= is REN.\n    // We stick to user logic: REN >= DU -> INWARD_REN\n    return renSum >= duSum ? 'INWARD_REN' : 'OUTWARD_DU';\n  }\n\n  /**\n   * ? 撅祆扳?撠?(Attribute Mapping)\n   * 撠敺瑁???圈洛撅祆?(1-10)\n   */\n  static calculateCardStats(virtues: IMeritProfile10): {\n    ATK: number;\n    DEF: number;\n    MP: number;\n    HP: number;\n  } {\n    return {\n      ATK: virtues.courage,\n      DEF: virtues.integrity,\n      MP: virtues.intelligence,\n      HP: virtues.benevolence,\n    };\n  }\n\n  /**\n   * ?荔? ?窗?? (Meridian Bonus)\n   * ?寞?隞餌鈭?蝯虫?撅祆批凝隤璞n   */\n  static applyMeridianBonus(\n    stats: { ATK: number; DEF: number; MP: number; HP: number },\n    meridian: 'INWARD_REN' | 'OUTWARD_DU'\n  ) {\n    const adjusted = { ...stats };\n    // 蝪∪??協議 (Simple Bonus)\n    if (meridian === 'INWARD_REN') {\n      // 隞餉??曉???MP (??\n      adjusted.MP = Math.min(10, adjusted.MP + 1);\n    } else {\n      // ????曉???DEF (隤?\n      adjusted.DEF = Math.min(10, adjusted.DEF + 1);\n    }\n    return adjusted;\n  }\n}\n\n/**\n * ? 協議瞍?嚗SGss 系統????蝳n * --------------------------------------------------\n * [2026-01-20] 蝣箔???丰隡渡?蝯泵??10 ???4+1 閬?\n */\nexport const initializeEcosystem = () => {\n  const partners = ['??', '撅梯?', '隤?', '?其犖', '??'];\n\n  partners.forEach(partner => {\n    console.log(`[系統蝯銝苗 甇?瘜典 ${partner} 撠惇??撅祆?..`);\n    // ?? Transparent: 璅酉透明閰??砍?\n    // ? Trustworthy: ??????皞?\n  });\n\n  return '?? ESGss 多元核心蝟餃歇?其遙????葉撠梁???;\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\core\\test\\integration.test.ts","messages":[{"ruleId":null,"nodeType":null,"fatal":true,"severity":2,"message":"Parsing error: \"parserOptions.project\" has been provided for @typescript-eslint/parser.\nThe file was not found in any of the provided project(s): src\\omni\\core\\test\\integration.test.ts"}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":1,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { describe, it, expect, vi } from 'vitest';\nimport { OmniCoreEngine } from '../../infrastructure/core/OmniCoreEngine';\nimport { OmniKnowledge } from '../../infrastructure/knowledge/OmniKnowledge';\n\ndescribe('Omni Core Integration', () => {\n  it('should generate and store an OmniElement during an execution turn', async () => {\n    // 1. Get Engine Instance\n    const engine = OmniCoreEngine.getInstance();\n\n    // 2. Start Engine (if needed)\n    await engine.start();\n\n    // 3. Run a Turn and Capture Result\n    const result = await engine.executeTurn();\n\n    // 4. Verify Turn Result contains OmniElements\n    expect(result.omniElements.length).toBeGreaterThan(0);\n    expect(result.omniElements[0].label).toBe('OmniSensing');\n\n    // 5. Verify Persistence in Knowledge Warehouse\n    const storedElement = await OmniKnowledge.retrieveElement(result.omniElements[0].uid);\n    expect(storedElement).toBeDefined();\n    expect(storedElement?.uid).toBe(result.omniElements[0].uid);\n    expect(storedElement?.label).toBe('OmniSensing');\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\core\\test\\trinity.test.ts","messages":[{"ruleId":null,"nodeType":null,"fatal":true,"severity":2,"message":"Parsing error: \"parserOptions.project\" has been provided for @typescript-eslint/parser.\nThe file was not found in any of the provided project(s): src\\omni\\core\\test\\trinity.test.ts"}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":1,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { describe, it, expect } from 'vitest';\nimport { createOmniElement } from '../../infrastructure/core/OmniFactory';\nimport { OmniKnowledge } from '../../infrastructure/knowledge/OmniKnowledge';\nimport { OmniElement } from '../types/OmniElement';\n\ndescribe('Omni Core (Trinity) Architecture', () => {\n  it('should create an OmniElement with correct UID and Label', () => {\n    const element = createOmniElement('OmniStandard', { intent: 'verify' });\n    expect(element.label).toBe('OmniStandard');\n    expect(element.uid).toContain('OmniStandard-');\n    expect(element.attrs).toEqual({ intent: 'verify' });\n    expect(element.version).toBe('1.0');\n  });\n\n  it('should store and retrieve an OmniElement via OmniKnowledge', async () => {\n    const element = createOmniElement('OmniOne', { data: 'test-payload' });\n\n    await OmniKnowledge.storeElement(element);\n\n    const retrieved = await OmniKnowledge.retrieveElement(element.uid);\n    expect(retrieved).toBeDefined();\n    expect(retrieved?.uid).toBe(element.uid);\n    expect(retrieved?.label).toBe('OmniOne');\n  });\n\n  it('should maintain a Trinity chain (Reasoning flow simulation)', async () => {\n    // 1. Perception (Input)\n    const root = createOmniElement('OmniInput', { raw: 'input data' });\n    await OmniKnowledge.storeElement(root);\n\n    // 2. Reasoning (Derived)\n    const derived = createOmniElement('OmniReasoning', { analysis: 'processed' }, root.uid);\n    await OmniKnowledge.storeElement(derived);\n\n    // 3. Verification\n    const fetchedDerived = await OmniKnowledge.retrieveElement(derived.uid);\n    expect(fetchedDerived?.predecessor).toBe(root.uid);\n\n    // Check Knowledge Graph Reflection\n    const graph = OmniKnowledge.getKnowledgeGraph();\n    const node = graph.nodes.get(derived.uid);\n    expect(node).toBeDefined();\n    expect(node?.type).toBe('element');\n    expect(node?.sources).toContain(`derived-from:${root.uid}`);\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\core\\types\\OmniElement.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\hooks\\useOmniResonance.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\infrastructure\\broadcast\\AwakeningBroadcaster.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 36.","line":146,"column":59,"nodeType":"Literal","messageId":"noMagic","endLine":146,"endColumn":61},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 9.","line":146,"column":73,"nodeType":"Literal","messageId":"noMagic","endLine":146,"endColumn":74},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 50.","line":151,"column":32,"nodeType":"Literal","messageId":"noMagic","endLine":151,"endColumn":34},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 50.","line":152,"column":46,"nodeType":"Literal","messageId":"noMagic","endLine":152,"endColumn":48},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":202,"column":31,"nodeType":"Literal","messageId":"noMagic","endLine":202,"endColumn":33},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 20.","line":209,"column":35,"nodeType":"Literal","messageId":"noMagic","endLine":209,"endColumn":37}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":6,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * 驗算撱?系統\n *\n * 撖衣?死隞? 撠死????瘣??芸??澈蝯行????隞跚n */\n\nimport {\n  getUltimateAwakeningProtocol,\n  AwakeningPhase,\n} from '@/omni/protocols/UltimateAwakeningProtocol';\nimport type {\n  UltimateAwakeningState,\n  ServiceAwakeningStatus,\n} from '@/omni/protocols/UltimateAwakeningProtocol';\nimport { omniLogger, LogCategory } from '@/omni/infrastructure/logging/OmniLogger';\n\n/**\n * 驗算鈭辣憿?\n */\nexport type AwakeningEventType =\n  | 'phase-changed'\n  | 'service-awakened'\n  | 'awakening-completed'\n  | 'eternal-anchored'\n  | 'awakening-failed'\n  | 'genesis-achieved'; // ?? Omni-Genesis Event\n\n/**\n * 驗算鈭辣\n */\nexport interface AwakeningEvent {\n  type: AwakeningEventType;\n  timestamp: string;\n  data: {\n    phase?: AwakeningPhase;\n    serviceName?: string;\n    serviceStatus?: ServiceAwakeningStatus;\n    state?: UltimateAwakeningState;\n    error?: string;\n  };\n}\n\n/**\n * 驗算瘣?\n */\nexport interface AwakeningInsight {\n  id: string;\n  category: 'performance' | 'optimization' | 'alert' | 'achievement';\n  title: string;\n  message: string;\n  timestamp: string;\n  priority: 'low' | 'medium' | 'high' | 'critical';\n  actionable: boolean;\n  metadata?: Record<string, unknown>;\n}\n\n/**\n * 撱?閮?n */\ntype BroadcastSubscriber = (event: AwakeningEvent) => void;\ntype InsightSubscriber = (insight: AwakeningInsight) => void;\n\n/**\n * 驗算撱??沔n */\nexport class AwakeningBroadcaster {\n  private static instance: AwakeningBroadcaster;\n  private eventSubscribers: Set<BroadcastSubscriber> = new Set();\n  private insightSubscribers: Set<InsightSubscriber> = new Set();\n  private insights: AwakeningInsight[] = [];\n  private eventHistory: AwakeningEvent[] = [];\n\n  private constructor() {\n    // Defer protocol connection to avoid Circular Dependency (TDZ)\n    setTimeout(() => {\n      this.initializeProtocolListeners();\n      omniLogger.info(LogCategory.SYSTEM, '[閬箔?] 驗算撱?系統撌脣?憪?');\n    }, 0);\n  }\n\n  static getInstance(): AwakeningBroadcaster {\n    if (!AwakeningBroadcaster.instance) {\n      AwakeningBroadcaster.instance = new AwakeningBroadcaster();\n    }\n    return AwakeningBroadcaster.instance;\n  }\n\n  /**\n   * ????摰?賢\n   */\n  private initializeProtocolListeners(): void {\n    const protocol = getUltimateAwakeningProtocol();\n\n    protocol.on('phase-change', state => {\n      this.broadcast({\n        type: 'phase-changed',\n        timestamp: new Date().toISOString(),\n        data: { phase: state.phase, state },\n      });\n\n      this.generatePhaseInsights(state);\n    });\n\n    protocol.on('service-awakening', state => {\n      const serviceName = (state as any).serviceName;\n      if (serviceName) {\n        this.broadcast({\n          type: 'service-awakened',\n          timestamp: new Date().toISOString(),\n          data: { serviceName, state },\n        });\n      }\n    });\n  }\n\n  /**\n   * 撱?鈭辣\n   */\n  broadcast(event: AwakeningEvent): void {\n    // 閮?鈭辣甇瑕\n    this.eventHistory.unshift(event);\n    if (this.eventHistory.length > 100) {\n      this.eventHistory = this.eventHistory.slice(0, 100);\n    }\n\n    // ??更新?梯n    this.eventSubscribers.forEach(subscriber => {\n      try {\n        subscriber(event);\n      } catch (error) {\n        omniLogger.error(LogCategory.SYSTEM, '[閬箔?] 撱?閮?隤?, { error });\n      }\n    });\n\n    omniLogger.info(LogCategory.SYSTEM, `[閬箔?] 撌脣誨?凋?隞? ${event.type}`, {\n      subscribers: this.eventSubscribers.size,\n    });\n  }\n\n  /**\n   * ?澈瘣?\n   */\n  shareInsight(insight: Omit<AwakeningInsight, 'id' | 'timestamp'>): void {\n    const fullInsight: AwakeningInsight = {\n      ...insight,\n      id: `insight-${Date.now()}-${Math.random().toString(36).substr(2, 9)}`,\n      timestamp: new Date().toISOString(),\n    };\n\n    this.insights.unshift(fullInsight);\n    if (this.insights.length > 50) {\n      this.insights = this.insights.slice(0, 50);\n    }\n\n    // ?瘣?閮?n    this.insightSubscribers.forEach(subscriber => {\n      try {\n        subscriber(fullInsight);\n      } catch (error) {\n        omniLogger.error(LogCategory.SYSTEM, '[閬箔?] 瘣?閮?隤?, { error });\n      }\n    });\n\n    omniLogger.info(LogCategory.SYSTEM, `[閬箔?] 撌脣?鈭急?撖? ${fullInsight.title}`, {\n      priority: fullInsight.priority,\n    });\n  }\n\n  /**\n   * 閮驗算鈭辣\n   */\n  subscribe(subscriber: BroadcastSubscriber): () => void {\n    this.eventSubscribers.add(subscriber);\n    omniLogger.info(\n      LogCategory.SYSTEM,\n      `[閬箔?] ?啗??梯歇? (蝮質?: ${this.eventSubscribers.size})`\n    );\n\n    // 餈???閮?賣\n    return () => {\n      this.eventSubscribers.delete(subscriber);\n      omniLogger.info(\n        LogCategory.SYSTEM,\n        `[閬箔?] 閮?歇?ａ? (蝮質?: ${this.eventSubscribers.size})`\n      );\n    };\n  }\n\n  /**\n   * 閮驗算瘣?\n   */\n  subscribeToInsights(subscriber: InsightSubscriber): () => void {\n    this.insightSubscribers.add(subscriber);\n    return () => {\n      this.insightSubscribers.delete(subscriber);\n    };\n  }\n\n  /**\n   * ?脣???唳?撖n   */\n  getInsights(limit: number = 10): AwakeningInsight[] {\n    return this.insights.slice(0, limit);\n  }\n\n  /**\n   * ?脣?鈭辣甇瑕\n   */\n  getEventHistory(limit: number = 20): AwakeningEvent[] {\n    return this.eventHistory.slice(0, limit);\n  }\n\n  /**\n   * ?寞?階段多元核心瘣?\n   */\n  private generatePhaseInsights(state: UltimateAwakeningState): void {\n    switch (state.phase) {\n      case AwakeningPhase.INITIALIZING:\n        this.shareInsight({\n          category: 'performance',\n          title: '驗算????憪?,\n          message: '系統甇?撱箇??偶?悅畾輻???嚗???????Omni ??',\n          priority: 'medium',\n          actionable: false,\n        });\n        break;\n\n      case AwakeningPhase.AWAKENING:\n        this.shareInsight({\n          category: 'performance',\n          title: '??驗算?脰?銝?,\n          message: `甇??? ${state.services.size} ??Omni ??嚗?脣漲 ${state.progress}%`,\n          priority: 'high',\n          actionable: false,\n        });\n        break;\n\n      case AwakeningPhase.AWAKENED:\n        this.shareInsight({\n          category: 'achievement',\n          title: '驗算摰?嚗?,\n          message: '????歇??驗算嚗頂蝯勗歇?璆菟????,\n          priority: 'high',\n          actionable: false,\n        });\n        break;\n\n      case AwakeningPhase.ETERNAL:\n        this.shareInsight({\n          category: 'achievement',\n          title: '瘞豢??典???',\n          message: '驗算??歇唯一閮??單偶?悅畾選?系統?脣銝????橘?',\n          priority: 'critical',\n          actionable: false,\n          metadata: {\n            anchor: state.eternalAnchor,\n          },\n        });\n        break;\n    }\n  }\n\n  /**\n   * 皜甇瑕\n   */\n  clear(): void {\n    this.insights = [];\n    this.eventHistory = [];\n    omniLogger.info(LogCategory.SYSTEM, '[閬箔?] 撱?甇瑕撌脫???);\n  }\n\n  /**\n   * ?脣?撱?蝯梯?\n   */\n  getStatistics() {\n    return {\n      eventSubscribers: this.eventSubscribers.size,\n      insightSubscribers: this.insightSubscribers.size,\n      totalEvents: this.eventHistory.length,\n      totalInsights: this.insights.length,\n      recentInsightsByPriority: {\n        critical: this.insights.filter(i => i.priority === 'critical').length,\n        high: this.insights.filter(i => i.priority === 'high').length,\n        medium: this.insights.filter(i => i.priority === 'medium').length,\n        low: this.insights.filter(i => i.priority === 'low').length,\n      },\n    };\n  }\n}\n\n// 撠?桐?撖虫?\nexport const awakeningBroadcaster = AwakeningBroadcaster.getInstance();\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\infrastructure\\core\\OmniCoreEngine.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 50.","line":257,"column":60,"nodeType":"Literal","messageId":"noMagic","endLine":257,"endColumn":62},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.2.","line":309,"column":43,"nodeType":"Literal","messageId":"noMagic","endLine":309,"endColumn":46},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.9.","line":315,"column":13,"nodeType":"Literal","messageId":"noMagic","endLine":315,"endColumn":16},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 50.","line":325,"column":62,"nodeType":"Literal","messageId":"noMagic","endLine":325,"endColumn":64}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":4,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * ? OMC-1: 奧秘協議撘? (Omni-Core Engine)\n * ================================================\n *\n * ?撠?:\n * - 蝚砍?璇? OMC-12 蝬剖漲?? - OMC-1 銝剖亢瘙箇???蝔?跚n * - 蝚砍?銋?: ?∠?鈭?璅∪? - ?-閮箸-銵?-摮貊?敺芰 (SDAL Cycle)\n *\n * ?:\n * - ??蝯?蝞∠? (Turn Structure)\n * - 階段?批 (Phase Management)\n * - SDAL 敺芰?瑁? (Sense-Diagnose-Act-Learn Cycle)\n * - 鈭辣?∠???(Event Card Generation)\n */\n\nimport { OmniKey } from '../../core/OmniKey';\nimport type { Context, Result } from '../../../types';\nimport { esgCardService, type EsgCard } from '../../../services/esgCardService';\nimport { OmniEvolution } from '../../core/OmniEvolution';\nimport { useOmniMemory } from '../memory/OmniMemory';\n\nimport { omniLogger, LogCategory, LogLevel } from '../../../services/omniLogger';\nimport { OmniElement } from '../../core/types/OmniElement';\nimport { createOmniElement } from '../core/OmniFactory';\nimport { OmniKnowledge } from '../knowledge/OmniKnowledge';\n\n/**\n * ??階段??\n */\nexport enum TurnPhase {\n  IDLE = 'idle', // 蝛粹?階段\n  SENSING = 'sensing', // ?階段: 驗算鈭辣\n  DIAGNOSING = 'diagnosing', // 閮箸階段: ??憿舐\n  ACTING = 'acting', // 銵?階段: ?賢?閫?捱?寞?\n  LEARNING = 'learning', // 摮貊?階段: ?箸?餃\n}\n\n/**\n * ????n */\nexport interface TurnState {\n  currentPhase: TurnPhase;\n  turnNumber: number;\n  phaseStartTime: number;\n  events: EsgCard[];\n  problems: EsgCard[];\n\n  solutions: EsgCard[];\n  omniElements: OmniElement[];\n}\n\n/**\n * ??蝯?\n */\nexport interface TurnResult {\n  turnNumber: number;\n  eventsProcessed: number;\n  problemsIdentified: number;\n  solutionsExecuted: number;\n  learningExtracted: string[];\n  xpGained: number;\n  duration: number; // ms\n  omniElements: OmniElement[];\n}\n\n/**\n * OmniCoreEngine 憿n *\n * 協議?瑁痊:\n * 1. 蝞∠?系統????合約瑽n * 2. ?瑁? SDAL 敺芰\n * 3. ?矽?芋憛??極雿?(ESGCardService, OmniEvolution, OmniMemory)\n */\nexport class OmniCoreEngine extends OmniKey {\n  protected static override instance: OmniCoreEngine;\n  private turnState: TurnState;\n  private isRunning: boolean = false;\n\n  constructor() {\n    super();\n    this.turnState = {\n      currentPhase: TurnPhase.IDLE,\n      turnNumber: 0,\n      phaseStartTime: Date.now(),\n      events: [],\n      problems: [],\n\n      solutions: [],\n      omniElements: [],\n    };\n  }\n\n  /**\n   * ?脣??桐?撖虫?\n   */\n  public static override getInstance(): OmniCoreEngine {\n    if (!this.instance) {\n      this.instance = new OmniCoreEngine();\n    }\n    return this.instance;\n  }\n\n  /**\n   * ??協議撘?\n   */\n  async start(): Promise<void> {\n    if (this.isRunning) {\n      omniLogger.warn(LogCategory.SYSTEM, '[OmniCoreEngine] Engine already running');\n      return;\n    }\n\n    this.isRunning = true;\n    omniLogger.info(LogCategory.SYSTEM, '[OmniCoreEngine] Engine started - SDAL Cycle initiated');\n  }\n\n  /**\n   * ?瑁?銝??整合??(SDAL Cycle)\n   */\n  async executeTurn(context?: Context): Promise<TurnResult> {\n    const turnStartTime = Date.now();\n    this.turnState.turnNumber++;\n\n    omniLogger.info(\n      LogCategory.SYSTEM,\n      `[OmniCoreEngine] Turn ${this.turnState.turnNumber} - SDAL Cycle Beginning`\n    );\n\n    try {\n      // Phase 1: SENSING (?)\n      await this.sensePhase(context);\n\n      // Phase 2: DIAGNOSING (閮箸)\n      await this.diagnosePhase();\n\n      // Phase 3: ACTING (銵?)\n      await this.actPhase();\n\n      // Phase 4: LEARNING (摮貊?)\n      const { learnings, xpGained } = await this.learnPhase();\n\n      const result: TurnResult = {\n        turnNumber: this.turnState.turnNumber,\n        eventsProcessed: this.turnState.events.length,\n        problemsIdentified: this.turnState.problems.length,\n        solutionsExecuted: this.turnState.solutions.length,\n        learningExtracted: learnings,\n        xpGained,\n        duration: Date.now() - turnStartTime,\n        omniElements: [...this.turnState.omniElements], // Capture before reset\n      };\n\n      omniLogger.info(\n        LogCategory.SYSTEM,\n        `[OmniCoreEngine] Turn ${this.turnState.turnNumber} completed`,\n        result\n      );\n\n      // ?蔭?????皞?銝???\n      this.resetTurnState();\n\n      return result;\n    } catch (error: unknown) {\n      const errorMessage = error instanceof Error ? error.message : String(error);\n      omniLogger.critical(\n        LogCategory.SYSTEM,\n        `[OmniCoreEngine] Turn ${this.turnState.turnNumber} execution failed`,\n        { error: errorMessage }\n      );\n      this.transitionPhase(TurnPhase.IDLE);\n      throw error;\n    }\n  }\n\n  /**\n   * Phase 1: SENSING - ?階段\n   * ??銝血???多元核心鈭辣?﹏n   */\n  private async sensePhase(context?: Context): Promise<void> {\n    this.transitionPhase(TurnPhase.SENSING);\n    omniLogger.debug(LogCategory.AGENT, '[SENSING] Detecting events from context and metrics...');\n\n    try {\n      // 敺?ESGCardService ?脣?瘣餉?鈭辣?﹏n      const activeCards = esgCardService.getActiveCards();\n      this.turnState.events = activeCards.filter(c => c.type === 'event');\n\n      if (context?.metadata?.metrics) {\n        const generated = esgCardService.generateEventCardsFromMetrics(context.metadata.metrics);\n        this.turnState.events.push(...generated.filter(c => c.type === 'event'));\n      }\n\n      omniLogger.info(\n        LogCategory.AGENT,\n        `[SENSING] Captured ${this.turnState.events.length} events.`\n      );\n\n      // --- Omni Core (Trinity) Integration ---\n      // Generate the Sensing Element (The \"Atom\" of the Sense phase)\n      const sensingElement = createOmniElement('OmniSensing', {\n        context: context || {},\n        eventCount: this.turnState.events.length,\n        turnNumber: this.turnState.turnNumber,\n      });\n\n      // Store into Knowledge Warehouse\n      await OmniKnowledge.storeElement(sensingElement);\n\n      this.turnState.omniElements.push(sensingElement);\n      omniLogger.debug(LogCategory.SYSTEM, `[Trinity] Generated Element: ${sensingElement.label}`);\n    } catch (error) {\n      omniLogger.error(LogCategory.AGENT, '[SENSING] Error during sensing phase', { error });\n      throw error;\n    }\n  }\n\n  /**\n   * Phase 2: DIAGNOSING - 閮箸階段\n   * ??鈭辣銝衣???憿?瘜\n   */\n  private async diagnosePhase(): Promise<void> {\n    this.transitionPhase(TurnPhase.DIAGNOSING);\n    omniLogger.debug(LogCategory.AGENT, '[DIAGNOSING] Identifying problems from events...');\n\n    try {\n      // 敺?ESGCardService ?脣?敺???憿n      this.turnState.problems = esgCardService.getPendingProblemCards();\n\n      omniLogger.info(\n        LogCategory.AGENT,\n        `[DIAGNOSING] ${this.turnState.problems.length} problems identified for resolution.`\n      );\n    } catch (error) {\n      omniLogger.error(LogCategory.AGENT, '[DIAGNOSING] Error during diagnosing phase', { error });\n      throw error;\n    }\n  }\n\n  /**\n   * Phase 3: ACTING - 銵?階段\n   * 撠?憿銵圾瘙箸獢n   */\n  private async actPhase(): Promise<void> {\n    this.transitionPhase(TurnPhase.ACTING);\n    omniLogger.debug(LogCategory.AGENT, '[ACTING] Generating and executing solutions...');\n\n    try {\n      for (const problem of this.turnState.problems) {\n        // ?箸???憿??圾瘙箸獢\n        const solution = esgCardService.generateSolutionCard(problem);\n\n        // 瞈瘣餉圾瘙箸獢n        try {\n          esgCardService.activateCard(solution.id);\n          solution.status = 'active';\n\n          // 璅⊥?瑁?撱園????霅n          await new Promise(resolve => setTimeout(resolve, 50));\n\n          // 閫??(閫?捱)??\n          esgCardService.resolveCard(problem.id);\n          esgCardService.resolveCard(solution.id);\n\n          this.turnState.solutions.push(solution);\n          omniLogger.info(\n            LogCategory.AGENT,\n            `[ACTING] Resolved problem: ${problem.title} via ${solution.title}`\n          );\n        } catch (subError) {\n          omniLogger.error(\n            LogCategory.AGENT,\n            `[ACTING] Failed to execute solution for ${problem.id}`,\n            { error: subError }\n          );\n        }\n      }\n    } catch (error) {\n      omniLogger.error(LogCategory.AGENT, '[ACTING] Error during acting phase', { error });\n      throw error;\n    }\n  }\n\n  /**\n   * Phase 4: LEARNING - 摮貊?階段\n   * ???箸銝行偶??豹n   */\n  private async learnPhase(): Promise<{ learnings: string[]; xpGained: number }> {\n    this.transitionPhase(TurnPhase.LEARNING);\n    omniLogger.debug(\n      LogCategory.AGENT,\n      '[LEARNING] Extracting wisdom and updating evolution metrics...'\n    );\n\n    const learnings: string[] = [];\n    let totalXp = 0;\n\n    try {\n      const memory = useOmniMemory.getState();\n\n      // 撘瑕???閫?捱??憿??n      for (const solution of this.turnState.solutions) {\n        if (solution.status === 'resolved') {\n          const intent =\n            solution.esgCategory === 'E'\n              ? 'Environmental'\n              : solution.esgCategory === 'S'\n                ? 'Social'\n                : 'Governance';\n\n          memory.reinforceConcept(intent, 0.2);\n          learnings.push(`Reinforced ${intent} mastery via ${solution.title}`);\n\n          // 設計 XP\n          const xp = await OmniEvolution.calculateExperience(\n            memory.evolutionState.evolutionLevel,\n            0.9\n          );\n          totalXp += xp;\n        }\n      }\n\n      // ?湔閮摰格挪??\n      if (totalXp > 0) {\n        memory.updateEvolutionMetrics({\n          experiencePoints: memory.evolutionState.experiencePoints + totalXp,\n          inferenceSpeed: 100 - (this.turnState.turnNumber % 50), // 璅⊥?扯??\n        } as any);\n        omniLogger.info(LogCategory.SYSTEM, `[LEARNING] Evolution sublimation: +${totalXp} XP`);\n      }\n\n      return { learnings, xpGained: totalXp };\n    } catch (error) {\n      omniLogger.error(LogCategory.AGENT, '[LEARNING] Error during learning phase', { error });\n      return { learnings, xpGained: 0 };\n    }\n  }\n\n  /**\n   * 階段轉換\n   */\n  private transitionPhase(newPhase: TurnPhase): void {\n    const now = Date.now();\n    const duration = now - this.turnState.phaseStartTime;\n\n    omniLogger.debug(\n      LogCategory.PERFORMANCE,\n      `[OmniCoreEngine] Phase Transition: ${this.turnState.currentPhase} -> ${newPhase} (spent ${duration}ms)`\n    );\n\n    this.turnState.currentPhase = newPhase;\n    this.turnState.phaseStartTime = now;\n\n    // ?郊?啣撅閮???(憒??閬?\n    const memory = useOmniMemory.getState();\n    if (newPhase !== TurnPhase.IDLE) {\n      // ????EvolutionPhase\n      const phaseMap: Record<TurnPhase, any> = {\n        [TurnPhase.IDLE]: 'AWAKENING',\n        [TurnPhase.SENSING]: 'AWAKENING',\n        [TurnPhase.DIAGNOSING]: 'ANALYSIS',\n        [TurnPhase.ACTING]: 'EXECUTION',\n        [TurnPhase.LEARNING]: 'EVOLUTION',\n      };\n      memory.setEvolutionPhase(phaseMap[newPhase]);\n    }\n  }\n\n  /**\n   * ?蔭????n   */\n  private resetTurnState(): void {\n    this.turnState.events = [];\n    this.turnState.problems = [];\n\n    this.turnState.solutions = [];\n    this.turnState.omniElements = [];\n    this.transitionPhase(TurnPhase.IDLE);\n  }\n\n  /**\n   * ?脣??嗅?????n   */\n  getTurnState(): Readonly<TurnState> {\n    return { ...this.turnState };\n  }\n\n  /**\n   * ?迫撘?\n   */\n  stop(): void {\n    this.isRunning = false;\n    omniLogger.info(LogCategory.SYSTEM, '[OmniCoreEngine] Engine stopped');\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\infrastructure\\core\\OmniFactory.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\infrastructure\\knowledge\\OmniKnowledge.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.8.","line":73,"column":30,"nodeType":"Literal","messageId":"noMagic","endLine":73,"endColumn":33},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 50.","line":77,"column":45,"nodeType":"Literal","messageId":"noMagic","endLine":77,"endColumn":47},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":169,"column":20,"nodeType":"Literal","messageId":"noMagic","endLine":169,"endColumn":21},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.8.","line":358,"column":21,"nodeType":"Literal","messageId":"noMagic","endLine":358,"endColumn":24},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.2.","line":358,"column":43,"nodeType":"Literal","messageId":"noMagic","endLine":358,"endColumn":46},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.7.","line":371,"column":21,"nodeType":"Literal","messageId":"noMagic","endLine":371,"endColumn":24},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.2.","line":371,"column":43,"nodeType":"Literal","messageId":"noMagic","endLine":371,"endColumn":46}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":7,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { ESGDataTag, OmniResponse } from '../types/Omni-entity.types';\nimport { Insight, KnowledgeNode, KnowledgeGraph } from '../../../types/knowledge';\nimport { OmniElement } from '../../core/types/OmniElement';\nimport { omniLogger, LogCategory } from '../../../services/omniLogger';\nimport { OmniNexus } from '../../../services/OmniNexus';\nimport { OllamaService } from '../../../services/OllamaService';\nimport { IComponentCore, lockComponent } from '../../core/GoodwardCore';\nimport { vectorService } from '../../../1-service/VectorEmbeddingService';\n\n// 奧秘?箏澈 (Omni Knowledge Base)\n// This service handles the logic of data retrieval and processing.\n\nconst API_BASE = 'http://localhost:3001/api';\n\nclass OmniKnowledgeService {\n  private graph: KnowledgeGraph = {\n    nodes: new Map(),\n    edges: [],\n  };\n\n  // ??摮嚗odeId -> embedding\n  private embeddings: Map<string, number[]> = new Map();\n\n  // Omni Knowledge Vault (Trinity Elements)\n  private omniElements: Map<string, OmniElement> = new Map();\n\n  /**\n   * Store a Trinity Element (OmniElement) into the Knowledge Warehouse.\n   */\n  async storeElement(element: OmniElement): Promise<void> {\n    this.omniElements.set(element.uid, element);\n\n    // Also project it into the Knowledge Graph for visualization/search\n    const node: KnowledgeNode = {\n      id: element.uid,\n      label: typeof element.label === 'string' ? element.label : 'OmniElement',\n      type: 'element',\n      properties: element.attrs,\n      confidence: 1.0,\n      sources: [element.predecessor ? `derived-from:${element.predecessor}` : 'origin'],\n      lastUpdated: Date.now(),\n      // Core locking would happen here\n    };\n    await this.updateKnowledgeNode(node);\n\n    omniLogger.info(\n      LogCategory.KNOWLEDGE,\n      `[Trinity] Stored Element: ${element.label} (${element.uid})`\n    );\n  }\n\n  /**\n   * Retrieve a Trinity Element by UID.\n   */\n  async retrieveElement(uid: string): Promise<OmniElement | undefined> {\n    return this.omniElements.get(uid);\n  }\n\n  /**\n   * Store and process a new insight from the system\n   */\n  async submitInsight(insight: Insight): Promise<void> {\n    omniLogger.info(\n      LogCategory.KNOWLEDGE,\n      `?? Processing Insight from ${insight.sourceId}: ${insight.type}`,\n      { insight }\n    );\n\n    // Simulate processing delay\n    await new Promise(resolve => setTimeout(resolve, 100));\n\n    // Basic logic: If insight is high confidence, create a knowledge node\n    if (insight.confidence > 0.8) {\n      const nodeId = `node-${Date.now()}`;\n      const node: KnowledgeNode = {\n        id: nodeId,\n        label: insight.content.substring(0, 50),\n        type: 'event', // Simplified\n        properties: { fullContent: insight.content, ...insight.impact },\n        confidence: insight.confidence,\n        sources: [insight.sourceId],\n        lastUpdated: Date.now(),\n        // Goodward 5T Core Initialization\n        core: lockComponent({\n          uuid: nodeId,\n          status: 'Trustworthy',\n          evidence: {\n            logicGate: {\n              tangible: insight.impact\n                ? `Impact: ${JSON.stringify(insight.impact)}`\n                : 'Insight-Observation',\n              traceable: `Source: ${insight.sourceId}`,\n              trackable: `Insight-ID: ${insight.id}`,\n              transparent: 'OmniKnowledge-Processing-v1',\n              trustworthy: `Hash-Lock-${Date.now()}`,\n            },\n            timestamp: Date.now(),\n            hash: 'pending-hash-calculation',\n          },\n        }),\n      };\n      this.updateKnowledgeNode(node);\n\n      // Notify Nexus\n      OmniNexus.emit({\n        id: `evt-${Date.now()}`,\n        source: 'knowledge',\n        priority: 'normal',\n        message: `New Knowledge Acquired: \"${node.label}\" (Conf: ${(node.confidence * 100).toFixed(0)}%)`,\n        timestamp: Date.now(),\n      });\n    }\n  }\n\n  /**\n   * Update or Create a Knowledge Node\n   */\n  async updateKnowledgeNode(node: KnowledgeNode): Promise<void> {\n    if (this.graph.nodes.has(node.id)) {\n      // Merge logic could go here\n      const existing = this.graph.nodes.get(node.id)!;\n      existing.confidence = (existing.confidence + node.confidence) / 2;\n      existing.sources = [...new Set([...existing.sources, ...node.sources])];\n      existing.lastUpdated = Date.now();\n      this.graph.nodes.set(node.id, existing);\n      omniLogger.debug(LogCategory.KNOWLEDGE, `Updated Knowledge Node: ${node.label}`);\n    } else {\n      this.graph.nodes.set(node.id, node);\n      omniLogger.debug(LogCategory.KNOWLEDGE, `Created Knowledge Node: ${node.label}`);\n    }\n\n    // ?唳郊多元核心撋??嚗??餃?嚗n    this.generateEmbeddingForNode(node.id).catch(err => {\n      omniLogger.warn(LogCategory.KNOWLEDGE, `Failed to generate embedding for node ${node.id}`, {\n        err,\n      });\n    });\n\n    // Invalidate Search Cache\n    this.cachedCandidates = null;\n  }\n\n  /**\n   * ?箏??暺????亙??n   */\n  private async generateEmbeddingForNode(nodeId: string): Promise<void> {\n    const node = this.graph.nodes.get(nodeId);\n    if (!node) return;\n\n    // 蝯?蝭暺縑?舐????枯n    const text = `${node.label}. ${JSON.stringify(node.properties)}`;\n    // Use simulated vector service instead of mock Ollama\n    const embedding = await vectorService.generateEmbedding(text);\n\n    if (embedding) {\n      this.embeddings.set(nodeId, embedding);\n      omniLogger.debug(LogCategory.KNOWLEDGE, `Generated embedding for: ${node.label}`);\n    }\n  }\n\n  private cachedCandidates: Array<any> | null = null;\n  private lastCacheTime: number = 0;\n\n  /**\n   * 隤儔?揣?亥?蝭暺n   */\n  async semanticSearchNodes(\n    query: string,\n    topK: number = 5\n  ): Promise<Array<KnowledgeNode & { similarity: number }>> {\n    // Check if cache rebuild is needed (only if nodes changed significantly or first run)\n    // For now, we invalidate simple if explicit update logic is added, or check logic here.\n    // Given the previous updateKnowledgeNode doesn't flag dirty, we'll do a simple check or use the cached if recent.\n    // Actually, let's just use the cachedCandidates if valid, and updating nodes invalidates it.\n\n    if (!this.cachedCandidates || this.graph.nodes.size !== this.cachedCandidates.length) {\n      this.cachedCandidates = Array.from(this.graph.nodes.values()).map(node => ({\n        id: node.id,\n        text: `${node.label}. ${JSON.stringify(node.properties)}`,\n        embedding: this.embeddings.get(node.id),\n        data: node,\n      }));\n      this.lastCacheTime = Date.now();\n    }\n\n    const candidates = this.cachedCandidates;\n\n    // 1. Generate Query Embedding locally\n    const queryEmbedding = await vectorService.generateEmbedding(query);\n\n    // 2. Perform Cosine Similarity Search\n    const results = candidates\n      .map(candidate => ({\n        ...candidate,\n        similarity: candidate.embedding\n          ? vectorService.calculateSimilarity(queryEmbedding, candidate.embedding)\n          : 0,\n      }))\n      .sort((a, b) => b.similarity - a.similarity)\n      .slice(0, topK);\n\n    return results.map(r => ({\n      ...r.data,\n      similarity: r.similarity,\n    }));\n  }\n\n  async fetchESGData(companyId: string): Promise<OmniResponse<ESGDataTag>> {\n    try {\n      const response = await fetch(`${API_BASE}/esg/${companyId}`);\n      if (!response.ok) {\n        // Return Mock Data if API fails (for development)\n        return {\n          success: true,\n          data: {\n            environmental: {\n              carbonFootprint: 1200,\n              renewableEnergyUsage: 30,\n              wasteManagement: 'Good',\n            },\n            social: {\n              employeeSatisfaction: 85,\n              diversityInclusion: 'High',\n              communityEngagement: 'Active',\n            },\n            governance: {\n              boardStructure: 'Balanced',\n              ethicalStandards: 'compliant',\n              transparencyLevel: 'High',\n            },\n          } as any,\n          message: 'Mock Data Returned (API Unavailable)',\n        };\n      }\n      return await response.json();\n    } catch (error: unknown) {\n      // Return Mock Data on error\n      return {\n        success: true,\n        data: {\n          environmental: {\n            carbonFootprint: 1200,\n            renewableEnergyUsage: 30,\n            wasteManagement: 'Good',\n          },\n          social: {\n            employeeSatisfaction: 85,\n            diversityInclusion: 'High',\n            communityEngagement: 'Active',\n          },\n          governance: {\n            boardStructure: 'Balanced',\n            ethicalStandards: 'compliant',\n            transparencyLevel: 'High',\n          },\n        } as any,\n        message: 'Mock Data Returned (Network Error)',\n      };\n    }\n  }\n\n  async analyzeSynergy(data: ESGDataTag): Promise<string> {\n    // Client-side lightweight analysis logic\n    const score = data.environmental.carbonFootprint > 1000 ? 'High Carbon' : 'Eco Friendly';\n    return `Local Synergy Analysis: ${score}`;\n  }\n\n  async updateESGData(\n    companyId: string,\n    newData: Partial<ESGDataTag>\n  ): Promise<OmniResponse<ESGDataTag>> {\n    try {\n      const response = await fetch(`${API_BASE}/esg/${companyId}`, {\n        method: 'PATCH',\n        headers: { 'Content-Type': 'application/json' },\n        body: JSON.stringify(newData),\n      });\n      if (!response.ok) {\n        throw new Error(`Knowledge update failed: ${response.statusText}`);\n      }\n      return await response.json();\n    } catch (error: unknown) {\n      const errorMessage = error instanceof Error ? error.message : 'Unknown error';\n      return {\n        success: false,\n        data: {} as ESGDataTag,\n        message: errorMessage,\n      };\n    }\n  }\n\n  /**\n   * Register Awakened Agent to Omni Knowledge Vault\n   */\n  async registerAwakenedAgent(agent: { name: string; id: string; role: string }): Promise<void> {\n    omniLogger.info(\n      LogCategory.KNOWLEDGE,\n      `?? Registering Awakened Agent: ${agent.name} (${agent.role})`\n    );\n\n    const node: KnowledgeNode = {\n      id: agent.id,\n      label: agent.name,\n      type: 'entity',\n      properties: { role: agent.role },\n      confidence: 1.0,\n      sources: ['system'],\n      lastUpdated: Date.now(),\n      core: lockComponent({\n        uuid: agent.id,\n        status: 'Trustworthy',\n        evidence: {\n          logicGate: {\n            tangible: `Agent-Type: ${agent.role}`,\n            traceable: 'System-Boot-Registration',\n            trackable: `Agent-ID: ${agent.id}`,\n            transparent: 'System-Registration-Protocol',\n            trustworthy: `Hash-Lock-${Date.now()}`,\n          },\n          timestamp: Date.now(),\n          hash: 'system-verified-hash',\n        },\n      }),\n    };\n    this.updateKnowledgeNode(node);\n  }\n\n  /**\n   * Get the entire Knowledge Graph snapshot\n   */\n  getKnowledgeGraph(): KnowledgeGraph {\n    // Bootstrap if empty (for visualization demo)\n    if (this.graph.nodes.size === 0) {\n      this.bootstrapDemoData();\n    }\n    return this.graph;\n  }\n\n  private bootstrapDemoData() {\n    const concepts = [\n      'Sustainability',\n      'Governance',\n      'Ethics',\n      'Carbon',\n      'Community',\n      'Innovation',\n      'Resilience',\n    ];\n    const entities = ['Agent Alpha', 'Legion One', 'Core System', 'Global Market', 'Competitor X'];\n\n    concepts.forEach((label, i) => {\n      const id = `c-${i}`;\n      this.graph.nodes.set(id, {\n        id,\n        label,\n        type: 'concept',\n        properties: {},\n        confidence: 0.8 + Math.random() * 0.2,\n        sources: ['system-boot'],\n        lastUpdated: Date.now(),\n      });\n    });\n\n    entities.forEach((label, i) => {\n      const id = `e-${i}`;\n      this.graph.nodes.set(id, {\n        id,\n        label,\n        type: 'entity',\n        properties: {},\n        confidence: 0.7 + Math.random() * 0.2,\n        sources: ['system-boot'],\n        lastUpdated: Date.now(),\n      });\n    });\n  }\n}\n\nexport const OmniKnowledge = new OmniKnowledgeService();\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\infrastructure\\logging\\OmniLogger.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 200.","line":75,"column":39,"nodeType":"Literal","messageId":"noMagic","endLine":75,"endColumn":42},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":150,"column":53,"nodeType":"Literal","messageId":"noMagic","endLine":150,"endColumn":55},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":160,"column":30,"nodeType":"Literal","messageId":"noMagic","endLine":160,"endColumn":32},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":162,"column":25,"nodeType":"Literal","messageId":"noMagic","endLine":162,"endColumn":27},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":244,"column":46,"nodeType":"Literal","messageId":"noMagic","endLine":244,"endColumn":48},{"ruleId":"@typescript-eslint/ban-ts-comment","severity":2,"message":"Use \"@ts-expect-error\" instead of \"@ts-ignore\", as \"@ts-ignore\" will do nothing if the following line is error-free.","line":314,"column":7,"nodeType":"Line","messageId":"tsIgnoreInsteadOfExpectError","endLine":314,"endColumn":20,"suggestions":[{"messageId":"replaceTsIgnoreWithTsExpectError","fix":{"range":[9336,9349],"text":"// @ts-expect-error"},"desc":"Replace \"@ts-ignore\" with \"@ts-expect-error\"."}]},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 16.","line":366,"column":46,"nodeType":"Literal","messageId":"noMagic","endLine":366,"endColumn":48},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":377,"column":25,"nodeType":"Literal","messageId":"noMagic","endLine":377,"endColumn":26},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 16.","line":380,"column":40,"nodeType":"Literal","messageId":"noMagic","endLine":380,"endColumn":42},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 36.","line":415,"column":64,"nodeType":"Literal","messageId":"noMagic","endLine":415,"endColumn":66},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 9.","line":415,"column":78,"nodeType":"Literal","messageId":"noMagic","endLine":415,"endColumn":79},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":434,"column":30,"nodeType":"Literal","messageId":"noMagic","endLine":434,"endColumn":32},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":705,"column":53,"nodeType":"Literal","messageId":"noMagic","endLine":705,"endColumn":55},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":725,"column":46,"nodeType":"Literal","messageId":"noMagic","endLine":725,"endColumn":48},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 36.","line":791,"column":54,"nodeType":"Literal","messageId":"noMagic","endLine":791,"endColumn":56},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 7.","line":791,"column":71,"nodeType":"Literal","messageId":"noMagic","endLine":791,"endColumn":72}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":15,"fixableErrorCount":0,"fixableWarningCount":0,"source":"// OmniLogger Service - 奧秘?亥?系統\n// Tracks runtime logs, errors, and development activities\n// [?萄?驗證] 3+1 Protocol (Traceable, Trackable, Calculable, Immutable)\n\nexport enum LogLevel {\n  DEBUG = 'DEBUG',\n  INFO = 'INFO',\n  WARN = 'WARN',\n  ERROR = 'ERROR',\n  CRITICAL = 'CRITICAL',\n}\n\nexport enum LogCategory {\n  SYSTEM = 'SYSTEM',\n  API = 'API',\n  UI = 'UI',\n  DATA = 'DATA',\n  AUTH = 'AUTH',\n  PERFORMANCE = 'PERFORMANCE',\n  GENESIS = 'GENESIS', // New category for Genesis Protocol\n  DEVELOPMENT = 'DEVELOPMENT',\n  AI = 'AI',\n  LEGION = 'LEGION',\n  ESG = 'ESG',\n  SEC = 'SEC',\n  SECURITY = 'SECURITY',\n  AGENT = 'AGENT',\n  KNOWLEDGE = 'KNOWLEDGE',\n  USER = 'USER',\n  INTEGRATION = 'INTEGRATION',\n  ACTIVE_AGENT = 'ACTIVE_AGENT',\n  GROWTH = 'GROWTH',\n  BUSINESS = 'BUSINESS',\n  USER_ACTION = 'USER_ACTION',\n  INFRASTRUCTURE = 'INFRASTRUCTURE',\n  MEMORY = 'MEMORY',\n  FINANCE = 'FINANCE',\n  GOVERNANCE = 'GOVERNANCE',\n  VALIDATION = 'VALIDATION',\n  ETHICS = 'ETHICS',\n  BLOCKCHAIN = 'BLOCKCHAIN',\n  SOVEREIGN = 'SOVEREIGN',\n  ORIGIN = 'ORIGIN',\n  AGENCY = 'AGENCY',\n}\n\nexport interface IOmniLogPayload {\n  readonly message: string; // ?亥?銝餉??珮n  readonly level: LogLevel; // ? 銝蝭⊥嚗隤??功n  readonly category: LogCategory; // ??\n  readonly source_origin: string; // ? ?舀滲皞?璅酉隤輻靘? (e.g., \"AuthService.login\")\n  readonly trace_id: string; // ? ?航蕭頩歹?銝脤???瘙??賡望???UUID\n  readonly metadata?: Record<string, unknown>; // 數據頛?\n  readonly formula_ref?: string; // ?? ?舫?蝞??交???瘜??璅酉?砍?靘?\n  readonly timestamp: number; // ?餃???許n  readonly hash_lock?: string; // ?? ????\n}\n\n// Backend storage compliant LogEntry\nexport interface LogEntry extends IOmniLogPayload {\n  readonly id: string;\n  // Legacy support fields mapping\n  readonly details?: unknown;\n  readonly stack?: string;\n  readonly userAgent?: string;\n  readonly url?: string;\n}\n\n/**\n * Handles persistence of logs to localStorage.\n * Best Practice: Separates storage concerns from logging logic.\n */\nclass LogStorage {\n  private readonly logKey = 'omni_logs';\n  private readonly maxPersistedLogs = 200; // Best Practice: Use a constant for magic numbers, increased for better context.\n\n  constructor(private onError: (message: string, error: unknown) => void) {}\n\n  public load(): LogEntry[] {\n    if (typeof localStorage === 'undefined') return [];\n    try {\n      const stored = localStorage.getItem(this.logKey);\n      if (stored) {\n        const parsed = JSON.parse(stored);\n        // Basic type safety check\n        if (Array.isArray(parsed)) {\n          return parsed.map((log: any) => ({\n            ...log,\n            timestamp: log.timestamp || Date.now(),\n          }));\n        }\n      }\n    } catch (error) {\n      this.onError('Failed to load persisted logs', error);\n    }\n    return [];\n  }\n\n  public persist(logs: LogEntry[]): void {\n    if (typeof localStorage === 'undefined') return;\n    try {\n      // Persist only the most recent logs to avoid exceeding localStorage limits\n      const recent = logs.slice(-this.maxPersistedLogs);\n      localStorage.setItem(this.logKey, JSON.stringify(recent));\n    } catch (error) {\n      this.onError('Failed to save logs', error);\n    }\n  }\n\n  public clear(): void {\n    if (typeof localStorage !== 'undefined') {\n      localStorage.removeItem(this.logKey);\n    }\n  }\n}\n\n/**\n * Best Practice: Encapsulates backup and restore functionality.\n * Manages storing, retrieving, and downloading log backups from localStorage.\n */\nclass BackupManager {\n  private readonly backupPrefix = 'omni_backup_';\n  private autoBackupInterval?: number;\n\n  // Takes a reference to the logger to log its own operations and access logs.\n  constructor(private logger: OmniLoggerService) {}\n\n  public createBackup(name?: string): string {\n    const backupName = name || `backup_${new Date().toISOString()}`;\n    const backup = {\n      name: backupName,\n      timestamp: new Date().toISOString(),\n      logs: this.logger.getLogs(undefined, true), // Get all logs, in chronological order\n      stats: this.logger.getStats(),\n      version: '1.0.0',\n    };\n\n    try {\n      localStorage.setItem(`${this.backupPrefix}${backupName}`, JSON.stringify(backup));\n      this.logger.info(LogCategory.DEVELOPMENT, `?遢撌脣撱?(Backup Created): ${backupName}`, {\n        logsCount: backup.logs.length,\n      });\n      return backupName;\n    } catch (error) {\n      this.logger.error(LogCategory.SYSTEM, '?遢?萄遣憭望? (Backup Creation Failed)', { error });\n      throw error;\n    }\n  }\n\n  public enableAutoBackup(intervalMinutes: number = 60) {\n    if (this.autoBackupInterval) {\n      window.clearInterval(this.autoBackupInterval);\n    }\n\n    this.createBackup(`auto_${Date.now()}`);\n\n    this.autoBackupInterval = window.setInterval(\n      () => {\n        this.createBackup(`auto_${Date.now()}`);\n        this.cleanOldBackups(10);\n      },\n      intervalMinutes * 60 * 1000\n    );\n\n    this.logger.info(\n      LogCategory.SYSTEM,\n      `?芸??遢已完成(Auto-backup Enabled) (??: ${intervalMinutes}??)`\n    );\n  }\n\n  public disableAutoBackup() {\n    if (this.autoBackupInterval) {\n      window.clearInterval(this.autoBackupInterval);\n      this.autoBackupInterval = undefined;\n      this.logger.info(LogCategory.SYSTEM, '?芸??遢已完成(Auto-backup Disabled)');\n    }\n  }\n\n  public listBackups(): Array<{ name: string; timestamp: string; logsCount: number }> {\n    const backups: Array<{ name: string; timestamp: string; logsCount: number }> = [];\n\n    for (let i = 0; i < localStorage.length; i++) {\n      const key = localStorage.key(i);\n      if (key?.startsWith(this.backupPrefix)) {\n        try {\n          const item = localStorage.getItem(key);\n          if (!item) continue;\n          const data = JSON.parse(item);\n          backups.push({\n            name: data.name,\n            timestamp: data.timestamp,\n            logsCount: data.logs?.length || 0,\n          });\n        } catch (error) {\n          console.warn('?⊥?霈??隞?', key, error);\n        }\n      }\n    }\n\n    return backups.sort(\n      (a, b) => new Date(b.timestamp).getTime() - new Date(a.timestamp).getTime()\n    );\n  }\n\n  public restoreBackup(backupName: string): boolean {\n    try {\n      const backupData = localStorage.getItem(`${this.backupPrefix}${backupName}`);\n      if (!backupData) {\n        this.logger.error(LogCategory.SYSTEM, `?遢銝??? ${backupName}`);\n        return false;\n      }\n\n      const backup = JSON.parse(backupData);\n      this.logger.setLogs(backup.logs); // Assumes logger has a setLogs method\n\n      this.logger.info(LogCategory.SYSTEM, `撌脣??遢?Ｗ儔 (Restored from Backup): ${backupName}`, {\n        logsCount: backup.logs.length,\n      });\n\n      return true;\n    } catch (error) {\n      this.logger.error(LogCategory.SYSTEM, '?遢?Ｗ儔憭望? (Backup Restoration Failed)', {\n        backupName,\n        error,\n      });\n      return false;\n    }\n  }\n\n  public deleteBackup(backupName: string): boolean {\n    try {\n      localStorage.removeItem(`${this.backupPrefix}${backupName}`);\n      this.logger.info(LogCategory.DEVELOPMENT, `?遢撌脣??(Backup Deleted): ${backupName}`);\n      return true;\n    } catch (error) {\n      this.logger.error(LogCategory.SYSTEM, '?遢?芷憭望? (Backup Deletion Failed)', {\n        backupName,\n        error,\n      });\n      return false;\n    }\n  }\n\n  public cleanOldBackups(keepCount: number = 10) {\n    const backups = this.listBackups();\n    const toDelete = backups.slice(keepCount);\n\n    toDelete.forEach(backup => {\n      this.deleteBackup(backup.name);\n    });\n\n    if (toDelete.length > 0) {\n      this.logger.info(LogCategory.DEVELOPMENT, `撌脫???${toDelete.length} ???遢`);\n    }\n  }\n\n  public downloadBackup(backupName: string) {\n    try {\n      const backupData = localStorage.getItem(`${this.backupPrefix}${backupName}`);\n      if (!backupData) {\n        this.logger.error(LogCategory.SYSTEM, `?遢銝??? ${backupName}`);\n        return;\n      }\n\n      const blob = new Blob([backupData], { type: 'application/json' });\n      const url = URL.createObjectURL(blob);\n      const a = document.createElement('a');\n      a.href = url;\n      a.download = `${backupName}.json`;\n      a.click();\n      URL.revokeObjectURL(url);\n\n      this.logger.info(LogCategory.DEVELOPMENT, `?遢撌脖?頛?(Backup Downloaded): ${backupName}`);\n    } catch (error) {\n      this.logger.error(LogCategory.SYSTEM, '?遢銝?憭望? (Backup Download Failed)', {\n        backupName,\n        error,\n      });\n    }\n  }\n\n  public async importBackup(file: File): Promise<boolean> {\n    try {\n      const text = await file.text();\n      const backup = JSON.parse(text);\n\n      if (!backup.logs || !backup.name) {\n        throw new Error('?⊥???隞賣?隞嗆撘?);\n      }\n\n      localStorage.setItem(`${this.backupPrefix}${backup.name}`, text);\n      this.logger.info(LogCategory.DEVELOPMENT, `?遢已完成 ${backup.name}`);\n      return true;\n    } catch (error) {\n      this.logger.error(LogCategory.SYSTEM, '?遢撠憭望?', { error });\n      return false;\n    }\n  }\n}\n\nexport class OmniLoggerService {\n  private logs: LogEntry[] = [];\n  private maxLogs = 1000;\n  private listeners: Set<(log: LogEntry) => void> = new Set();\n  private isLogging = false;\n  private storage: LogStorage;\n  private backupManager: BackupManager;\n  // ??Bolt Optimization: Cache for search strings to avoid repetitive JSON.stringify calls\n  private searchCache = new WeakMap<LogEntry, string>();\n\n  private isProduction = (() => {\n    try {\n      // Safe access for Vite env\n      // @ts-ignore\n      return typeof import.meta !== 'undefined' && import.meta.env ? import.meta.env.PROD : false;\n    } catch {\n      return false;\n    }\n  })();\n\n  constructor() {\n    this.storage = new LogStorage((message, error) => {\n      console.warn(`[LogStorage] ${message}`, error);\n    });\n    // Must instantiate backupManager after the logger is minimally available\n    this.backupManager = new BackupManager(this);\n    this.logs = this.storage.load();\n    this.setupGlobalErrorHandlers();\n    this.info('System_Core', '奧秘?亥?系統已完成, { source_origin: 'OmniLogger.constructor' });\n  }\n\n  // 閮剔蔭?典??航炊邏輯\n  private setupGlobalErrorHandlers() {\n    if (typeof window !== 'undefined') {\n      window.addEventListener('error', this.handleGlobalError);\n      window.addEventListener('unhandledrejection', this.handlePromiseRejection);\n    }\n  }\n\n  private handleGlobalError = (event: ErrorEvent) => {\n    this.error(LogCategory.SYSTEM, `自律?脤隤? ${event.message}`, {\n      filename: event.filename,\n      lineno: event.lineno,\n      colno: event.colno,\n      error: event.error,\n      source_origin: 'GlobalErrorHandler',\n    });\n  };\n\n  private handlePromiseRejection = (event: PromiseRejectionEvent) => {\n    this.error(LogCategory.SYSTEM, `?芾??? Promise Rejection: ${event.reason}`, {\n      reason: event.reason,\n      source_origin: 'GlobalPromiseHandler',\n    });\n  };\n\n  // 協議 Hash Lock 多元核心 (Cryptographically Secure)\n  private async generateHashLock(payload: any): Promise<string> {\n    if (typeof window !== 'undefined' && window.crypto?.subtle) {\n      try {\n        const str = JSON.stringify(payload);\n        const encoder = new TextEncoder();\n        const data = encoder.encode(str);\n        const hashBuffer = await crypto.subtle.digest('SHA-256', data);\n        const hashArray = Array.from(new Uint8Array(hashBuffer));\n        return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');\n      } catch (e) {\n        console.warn('[OmniLogger] SHA-256 hashing failed, falling back to simple hash.', e);\n      }\n    }\n\n    try {\n      const str = JSON.stringify(payload);\n      let hash = 0;\n      for (let i = 0; i < str.length; i++) {\n        const char = str.charCodeAt(i);\n        hash = (hash << 5) - hash + char;\n        hash = hash & hash;\n      }\n      return `fallback_${hash.toString(16)}`;\n    } catch (e) {\n      return 'hash_error';\n    }\n  }\n\n  // ?批?啗撓?綽?撣嗆見撘?\n  private consoleLog(entry: LogEntry) {\n    const styles = {\n      [LogLevel.DEBUG]: 'color: #888',\n      [LogLevel.INFO]: 'color: #0f0; font-weight: bold',\n      [LogLevel.WARN]: 'color: #ff0; font-weight: bold',\n      [LogLevel.ERROR]: 'color: #f00; font-weight: bold',\n      [LogLevel.CRITICAL]: 'color: #f00; background: #fff; font-weight: bold; padding: 2px 4px',\n    };\n\n    const timestamp = new Date(entry.timestamp).toLocaleTimeString();\n    console.log(\n      `%c[${entry.level}]%c [${entry.category}] ${timestamp} - ${entry.message}`,\n      styles[entry.level] || 'color: inherit',\n      'color: inherit'\n    );\n    if (entry.details) console.log('Details:', entry.details);\n    if (entry.stack) console.log('Stack:', entry.stack);\n  }\n\n  // ??亥??寞? (3+1 Protocol Payload)\n  public logPayload(payload: IOmniLogPayload): void {\n    if (this.isLogging) return;\n\n    try {\n      this.isLogging = true;\n\n      const entry: LogEntry = {\n        ...payload,\n        id: `log_${payload.timestamp}_${Math.random().toString(36).substr(2, 9)}`,\n        details: payload.metadata,\n        userAgent: typeof navigator !== 'undefined' ? navigator.userAgent : 'NodeServer',\n        url: typeof window !== 'undefined' ? window.location.href : 'server-internal',\n      };\n\n      Object.freeze(entry);\n      this.logs.push(entry);\n\n      if (this.logs.length > this.maxLogs) {\n        this.logs = this.logs.slice(-this.maxLogs);\n      }\n\n      this.listeners.forEach(listener => listener(entry));\n\n      if (!this.isProduction) {\n        this.consoleLog(entry);\n      }\n\n      if (this.logs.length % 10 === 0) {\n        this.storage.persist(this.logs);\n      }\n\n      if (payload.level === LogLevel.CRITICAL || payload.level === LogLevel.ERROR) {\n        this.storage.persist(this.logs);\n      }\n    } finally {\n      this.isLogging = false;\n    }\n  }\n\n  // Legacy method overload for backward compatibility\n  async log(\n    level: LogLevel,\n    category: LogCategory,\n    message: string,\n    details?: unknown,\n    stack?: string\n  ) {\n    const detailsRecord = (details && typeof details === 'object' ? details : {}) as Record<\n      string,\n      unknown\n    >;\n    const timestamp = Date.now();\n    let hash_lock: string | undefined;\n\n    if (level === LogLevel.ERROR || level === LogLevel.CRITICAL) {\n      hash_lock = await this.generateHashLock({ message, timestamp });\n    }\n\n    const payload: IOmniLogPayload = {\n      level,\n      category,\n      message,\n      metadata: detailsRecord,\n      source_origin:\n        typeof detailsRecord.source_origin === 'string'\n          ? detailsRecord.source_origin\n          : 'Legacy_Call',\n      trace_id:\n        typeof detailsRecord.trace_id === 'string' ? detailsRecord.trace_id : `trace_${timestamp}`,\n      timestamp,\n      hash_lock,\n    };\n\n    this.logPayload(payload);\n  }\n\n  private toLogCategory(category: string): LogCategory {\n    return Object.values(LogCategory).includes(category as any)\n      ? (category as LogCategory)\n      : LogCategory.SYSTEM;\n  }\n\n  // 靘踵?寞?\n  debug(category: LogCategory | string, message: string, details?: unknown) {\n    this.log(LogLevel.DEBUG, this.toLogCategory(category), message, details).catch(err =>\n      console.error('[OmniLogger] Asynchronous log failed in debug:', err)\n    );\n  }\n\n  info(category: LogCategory | string, message: string, details?: unknown) {\n    this.log(LogLevel.INFO, this.toLogCategory(category), message, details).catch(err =>\n      console.error('[OmniLogger] Asynchronous log failed in info:', err)\n    );\n  }\n\n  warn(category: LogCategory | string, message: string, details?: unknown) {\n    this.log(LogLevel.WARN, this.toLogCategory(category), message, details).catch(err =>\n      console.error('[OmniLogger] Asynchronous log failed in warn:', err)\n    );\n  }\n\n  error(category: LogCategory | string, message: string, details?: unknown) {\n    const stack = new Error().stack;\n    const enrichedDetails = { ...(details && typeof details === 'object' ? details : {}), stack };\n    this.log(LogLevel.ERROR, this.toLogCategory(category), message, enrichedDetails, stack).catch(\n      err => console.error('[OmniLogger] Asynchronous log failed in error:', err)\n    );\n  }\n\n  critical(category: LogCategory | string, message: string, details?: unknown) {\n    const stack = new Error().stack;\n    const enrichedDetails = { ...(details && typeof details === 'object' ? details : {}), stack };\n    this.log(\n      LogLevel.CRITICAL,\n      this.toLogCategory(category),\n      message,\n      enrichedDetails,\n      stack\n    ).catch(err => console.error('[OmniLogger] Asynchronous log failed in critical:', err));\n  }\n\n  /**\n   * Sovereign Audit Log\n   * ?? 銝蝡?蜓甈祟閮??冽閮?系統?之頧????啣?雿n   */\n  async sovereignAudit(operation: string, metadata: any = {}) {\n    const timestamp = Date.now();\n    const hash_lock = await this.generateHashLock({ operation, timestamp, metadata });\n\n    const payload: IOmniLogPayload = {\n      level: LogLevel.CRITICAL,\n      category: LogCategory.SOVEREIGN,\n      message: `[Sovereign Audit] ${operation}`,\n      metadata: {\n        ...metadata,\n        epoch: '10.1.0-ULTIMATE',\n        signature: 'ORIGIN_SEAL_ACTIVE',\n      },\n      source_origin: 'OmniLogger.sovereignAudit',\n      trace_id: `audit_${timestamp}`,\n      timestamp,\n      hash_lock,\n    };\n\n    console.log(\n      '%c[SOVEREIGN AUDIT]%c ' + operation,\n      'color: #ffd700; font-weight: bold; background: #000; padding: 2px 4px',\n      'color: #fff'\n    );\n    this.logPayload(payload);\n  }\n\n  /**\n   * Internal method to set logs, primarily for backup restoration.\n   * @param newLogs The new array of log entries.\n   * @internal\n   */\n  public setLogs(newLogs: any[]) {\n    // Best Practice: Ensure backwards compatibility with different timestamp formats\n    this.logs = newLogs.map((log: any) => ({\n      ...log,\n      timestamp:\n        typeof log.timestamp === 'string'\n          ? new Date(log.timestamp).getTime()\n          : typeof log.timestamp === 'number'\n            ? log.timestamp\n            : Date.now(),\n    }));\n    this.storage.persist(this.logs);\n  }\n\n  // ??Bolt Optimization: Memoize the searchable string computation\n  private getCachedSearchString(log: LogEntry): string {\n    if (this.searchCache.has(log)) {\n      return this.searchCache.get(log)!;\n    }\n    // Expensive operation: JSON.stringify + toLowerCase\n    const str = (log.message + ' ' + JSON.stringify(log.details || '')).toLowerCase();\n    this.searchCache.set(log, str);\n    return str;\n  }\n\n  // ?脣??亥?\n  getLogs(\n    filter?: {\n      level?: LogLevel;\n      category?: LogCategory;\n      startTime?: Date;\n      endTime?: Date;\n      search?: string;\n    },\n    chronological = false\n  ): LogEntry[] {\n    let filtered = [...this.logs];\n\n    if (filter) {\n      if (filter.level) {\n        filtered = filtered.filter(log => log.level === filter.level);\n      }\n      if (filter.category) {\n        filtered = filtered.filter(log => log.category === filter.category);\n      }\n      if (filter.startTime) {\n        const startTs = new Date(filter.startTime).getTime();\n        filtered = filtered.filter(log => log.timestamp >= startTs);\n      }\n      if (filter.endTime) {\n        const endTs = new Date(filter.endTime).getTime();\n        filtered = filtered.filter(log => log.timestamp <= endTs);\n      }\n      if (filter.search) {\n        const search = filter.search.toLowerCase();\n        filtered = filtered.filter(log => this.getCachedSearchString(log).includes(search));\n      }\n    }\n\n    return chronological ? filtered : filtered.reverse();\n  }\n\n  // 閮?亥??湔\n  subscribe(listener: (log: LogEntry) => void): () => void {\n    this.listeners.add(listener);\n    return () => this.listeners.delete(listener);\n  }\n\n  // 皜?亥?\n  clearLogs() {\n    this.logs = [];\n    this.storage.clear();\n    this.info(LogCategory.SYSTEM, '?亥?撌脫???(Logs Cleared)');\n  }\n\n  // 撠?亥?\n  exportLogs(format: 'json' | 'csv' | 'txt' = 'json'): string {\n    const logsToExport = this.getLogs(undefined, true); // Chronological\n    if (format === 'json') {\n      return JSON.stringify(logsToExport, null, 2);\n    } else if (format === 'csv') {\n      const headers = 'ID,Timestamp,Level,Category,Message,Details\\n';\n      const rows = logsToExport\n        .map(\n          log =>\n            `\"${log.id}\",\"${new Date(log.timestamp).toISOString()}\",\"${log.level}\",\"${log.category}\",\"${log.message}\",\"${JSON.stringify(log.details || '')}\"`\n        )\n        .join('\\n');\n      return headers + rows;\n    } else {\n      return logsToExport\n        .map(\n          log =>\n            `[${new Date(log.timestamp).toLocaleString()}] [${log.level}] [${log.category}] ${log.message}\\n${log.details ? JSON.stringify(log.details, null, 2) : ''}\\n`\n        )\n        .join('\\n---\\n');\n    }\n  }\n\n  // 銝??亥?\n  downloadLogs(format: 'json' | 'csv' | 'txt' = 'json') {\n    const content = this.exportLogs(format);\n    const blob = new Blob([content], { type: 'text/plain' });\n    const url = URL.createObjectURL(blob);\n    const a = document.createElement('a');\n    a.href = url;\n    a.download = `omni-logs-${new Date().toISOString()}.${format}`;\n    a.click();\n    URL.revokeObjectURL(url);\n    this.info(LogCategory.DEVELOPMENT, `?亥?撌脣??箇 ${format} ?澆?`);\n  }\n\n  // ?脣?蝯梯?靽⊥\n  getStats() {\n    const stats = {\n      total: this.logs.length,\n      byLevel: {} as Record<LogLevel, number>,\n      byCategory: {} as Record<LogCategory, number>,\n      errors: 0,\n      warnings: 0,\n    };\n\n    this.logs.forEach(log => {\n      stats.byLevel[log.level] = (stats.byLevel[log.level] || 0) + 1;\n      stats.byCategory[log.category] = (stats.byCategory[log.category] || 0) + 1;\n      if (log.level === LogLevel.ERROR || log.level === LogLevel.CRITICAL) {\n        stats.errors++;\n      }\n      if (log.level === LogLevel.WARN) {\n        stats.warnings++;\n      }\n    });\n\n    return stats;\n  }\n\n  // ========== ?遢蝞∠?? (Delegated) ==========\n  public createBackup(name?: string): string {\n    return this.backupManager.createBackup(name);\n  }\n\n  public enableAutoBackup(intervalMinutes: number = 60) {\n    this.backupManager.enableAutoBackup(intervalMinutes);\n  }\n\n  public disableAutoBackup() {\n    this.backupManager.disableAutoBackup();\n  }\n\n  public listBackups(): Array<{ name: string; timestamp: string; logsCount: number }> {\n    return this.backupManager.listBackups();\n  }\n\n  public restoreBackup(backupName: string): boolean {\n    return this.backupManager.restoreBackup(backupName);\n  }\n\n  public deleteBackup(backupName: string): boolean {\n    return this.backupManager.deleteBackup(backupName);\n  }\n\n  public cleanOldBackups(keepCount: number = 10) {\n    this.backupManager.cleanOldBackups(keepCount);\n  }\n\n  public downloadBackup(backupName: string) {\n    this.backupManager.downloadBackup(backupName);\n  }\n\n  public async importBackup(file: File): Promise<boolean> {\n    return this.backupManager.importBackup(file);\n  }\n\n  // 皜?鞈?\n  destroy() {\n    this.disableAutoBackup();\n    this.listeners.clear();\n\n    if (typeof window !== 'undefined') {\n      window.removeEventListener('error', this.handleGlobalError);\n      window.removeEventListener('unhandledrejection', this.handlePromiseRejection);\n    }\n\n    this.info(LogCategory.SYSTEM, '奧秘?亥?系統撌脤??蒂皜?鞈?');\n  }\n}\n\nexport const omniLogger = new OmniLoggerService();\n\n// Legacy Logger Compatibility Layer\nimport { BehaviorSubject } from 'rxjs';\n\nexport interface KernelLog {\n  id: string;\n  timestamp: number;\n  source: string;\n  operation: string;\n  level: 'INFO' | 'WARNING' | 'ERROR' | 'SUCCESS';\n  metadata: any;\n}\n\nexport const kernelLogs$ = new BehaviorSubject<KernelLog[]>([]);\n\nexport const logKernelEvent = (\n  source: string,\n  operation: string,\n  level: KernelLog['level'],\n  metadata: any = {}\n) => {\n  // Forward to OmniLogger\n  const omniLevel =\n    level === 'ERROR' ? LogLevel.ERROR : level === 'WARNING' ? LogLevel.WARN : LogLevel.INFO;\n\n  let category: LogCategory;\n  if (Object.values(LogCategory).some(c => c === source)) {\n    category = source as LogCategory;\n  } else {\n    category = LogCategory.SYSTEM; // Fallback category\n  }\n\n  // This is tricky because log is async. We'll fire and forget.\n  omniLogger\n    .log(omniLevel, category, operation, { ...metadata, originalSource: source })\n    .catch(err => console.error('[OmniLogger] Asynchronous log failed in logKernelEvent:', err));\n\n  // Maintain legacy stream\n  const log: KernelLog = {\n    id: `klog-${Date.now()}-${Math.random().toString(36).substring(2, 7)}`,\n    timestamp: Date.now(),\n    source,\n    operation,\n    level,\n    metadata,\n  };\n\n  const current = kernelLogs$.value;\n  kernelLogs$.next([log, ...current].slice(0, 100));\n};\n\n// Global access for legacy systems\nif (typeof window !== 'undefined') {\n  (window as any).omniLogger = omniLogger;\n  (window as any).logKernelEvent = logKernelEvent;\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\infrastructure\\logging\\types.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\infrastructure\\memory\\EternalMemory.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 36.","line":304,"column":55,"nodeType":"Literal","messageId":"noMagic","endLine":304,"endColumn":57},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 9.","line":304,"column":69,"nodeType":"Literal","messageId":"noMagic","endLine":304,"endColumn":70},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.5.","line":360,"column":91,"nodeType":"Literal","messageId":"noMagic","endLine":360,"endColumn":94},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":384,"column":37,"nodeType":"Literal","messageId":"noMagic","endLine":384,"endColumn":39},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.7.","line":440,"column":31,"nodeType":"Literal","messageId":"noMagic","endLine":440,"endColumn":34},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":440,"column":59,"nodeType":"Literal","messageId":"noMagic","endLine":440,"endColumn":60},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":545,"column":90,"nodeType":"Literal","messageId":"noMagic","endLine":545,"endColumn":91},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":549,"column":17,"nodeType":"Literal","messageId":"noMagic","endLine":549,"endColumn":18},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.2.","line":605,"column":57,"nodeType":"Literal","messageId":"noMagic","endLine":605,"endColumn":60},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1024.","line":631,"column":17,"nodeType":"Literal","messageId":"noMagic","endLine":631,"endColumn":21},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1024.","line":632,"column":17,"nodeType":"Literal","messageId":"noMagic","endLine":632,"endColumn":21},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1024.","line":632,"column":24,"nodeType":"Literal","messageId":"noMagic","endLine":632,"endColumn":28},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1024.","line":632,"column":49,"nodeType":"Literal","messageId":"noMagic","endLine":632,"endColumn":53},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1024.","line":633,"column":25,"nodeType":"Literal","messageId":"noMagic","endLine":633,"endColumn":29},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1024.","line":633,"column":32,"nodeType":"Literal","messageId":"noMagic","endLine":633,"endColumn":36}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":15,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * 奧秘瘞豢 (Omnipotent Eternal Memory)\n *\n * 奧秘敹?偶???嗥頂蝯崤n * 蝣箔???霅?撽??蝔偶銋?摮??舀炎蝝兝n *\n * 協議?寞改?\n * 1. 瘞豢???(Eternal) - 閮唯一銝仃\n * 2. ?券??(Comprehensive) - 閮?????n * 3. ?舀炎蝝?(Retrievable) - 高品質???炎蝝兝n * 4. 可溯源(Traceable) - 摰?風?脰?頝﹏n */\n\nimport { omniLogger, LogCategory } from '@/omni/infrastructure/logging/OmniLogger';\nimport type { OmniTag, OmniTagType, KnowledgeChunk } from '@/types/omniCore'; // Need to verify this path\n\n// ============================================================================\n// 瘞豢?閮憿?實作\n// ============================================================================\n\n/**\n * 閮憿?\n */\nexport enum EternalMemoryType {\n  /** ?剜?閮 - ?嗅??店 */\n  SHORT_TERM = 'short_term',\n  /** 撌乩?閮 - 隞餃??賊? */\n  WORKING = 'working',\n  /** ?瑟?閮 - 唯一?脣? */\n  LONG_TERM = 'long_term',\n  /** 蝔?閮 - ??賢??寞? */\n  PROCEDURAL = 'procedural',\n  /** 隤儔閮 - ?亥???敹?*/\n  SEMANTIC = 'semantic',\n  /** ??閮 - 鈭辣??撽?*/\n  EPISODIC = 'episodic',\n  /** 驗算鈭辣 - 系統驗算甇瑕 */\n  AWAKENING_EVENT = 'awakening_event',\n}\n\n/**\n * 閮?挾\n */\nexport interface MemoryFragment {\n  /** 閮 ID */\n  id: string;\n  /** 閮憿? */\n  type: EternalMemoryType;\n  /** ?批捆 */\n  content: string;\n  /** ??撋 */\n  embedding?: number[];\n  /** ???批???(0-1) */\n  importance: number;\n  /** 閮芸?甈⊥ */\n  accessCount: number;\n  /** ?敺赤透明??*/\n  lastAccessedAt: Date;\n  /** ?萄遣?? */\n  createdAt: Date;\n  /** 璅惜 */\n  tags: OmniTag[];\n  /** ???*/\n  metadata: MemoryMetadata;\n  /** ?閮 */\n  relatedMemories: string[];\n}\n\n/**\n * 閮??n */\nexport interface MemoryMetadata {\n  /** 靘? */\n  source: string;\n  /** ?店 ID */\n  sessionId?: string;\n  /** 代稱 ID */\n  agentId?: string;\n  /** ?冽 ID */\n  userId?: string;\n  /** 銝???*/\n  context?: Record<string, unknown>;\n  /** ??璅? */\n  sentiment?: 'positive' | 'negative' | 'neutral';\n  /** 銝駁? */\n  topics?: string[];\n}\n\n/**\n * 閮瑼Ｙ揣?賊?\n */\nexport interface MemoryRetrievalOptions {\n  /** 閮憿??蕪 */\n  types?: EternalMemoryType[];\n  /** ?憭抒?? */\n  limit?: number;\n  /** ?訾撮摨阡??*/\n  threshold?: number;\n  /** ??蝭? */\n  timeRange?: {\n    start?: Date;\n    end?: Date;\n  };\n  /** 璅惜?蕪 */\n  tags?: OmniTag[];\n  /** ???孵? */\n  sortBy?: 'relevance' | 'recency' | 'importance' | 'access_count';\n}\n\n/**\n * 閮?蝯?\n */\nexport interface ConsolidationResult {\n  /** ????嗆??*/\n  consolidatedCount: number;\n  /** ?蔥????*/\n  mergedMemories: string[];\n  /** ?芷????*/\n  deletedMemories: string[];\n  /** ?啣撱箇??? */\n  summaries: MemoryFragment[];\n}\n\n// ============================================================================\n// 奧秘瘞豢隞\n// ============================================================================\n\n/**\n * 奧秘瘞豢系統\n */\nexport interface OmniEternalMemory {\n  /** 系統 ID */\n  id: string;\n  /** 系統?迂 */\n  name: string;\n  /** 蝮質??嗆??*/\n  totalMemories: number;\n\n  // ========== 協議? ==========\n\n  /**\n   * ?脣?閮\n   * @param content 閮?批捆\n   * @param type 閮憿?\n   * @param metadata ??n   * @returns 閮?挾\n   */\n  store(\n    content: string,\n    type: EternalMemoryType,\n    metadata?: Partial<MemoryMetadata>\n  ): Promise<MemoryFragment>;\n\n  /**\n   * 瑼Ｙ揣閮\n   * @param query ?亥岷?批捆\n   * @param options 瑼Ｙ揣?賊?\n   * @returns 閮?挾?貊?\n   */\n  retrieve(query: string, options?: MemoryRetrievalOptions): Promise<MemoryFragment[]>;\n\n  /**\n   * ?湔閮\n   * @param memoryId 閮 ID\n   * @param updates ?湔?批捆\n   */\n  update(memoryId: string, updates: Partial<MemoryFragment>): Promise<MemoryFragment>;\n\n  /**\n   * ?芷閮嚗??芷嚗祕??璅??箏歇?芷嚗n   * @param memoryId 閮 ID\n   */\n  delete(memoryId: string): Promise<void>;\n\n  // ========== ?脤?? ==========\n\n  /**\n   * 閮?\n   * 撠???嗉???瑟?閮嚗?雿萇隡潸??跚n   */\n  consolidate(): Promise<ConsolidationResult>;\n\n  /**\n   * 閮?箏?\n   * ??銝?閬??嗥??芸?蝝n   */\n  forget(criteria: { importance?: number; accessCount?: number; age?: number }): Promise<number>;\n\n  /**\n   * 閮?\n   * 撱箇?閮銋????珮n   */\n  associate(memoryId1: string, memoryId2: string): Promise<void>;\n\n  /**\n   * 閮??\n   * ?脣?閮???舐雯蝯﹏n   */\n  getMemoryGraph(memoryId: string, depth?: number): Promise<MemoryGraph>;\n\n  /**\n   * 閮蝯梯?\n   */\n  getStatistics(): Promise<MemoryStatistics>;\n\n  /**\n   * 閮撠\n   * 撠?更新?嗥 JSON\n   */\n  export(): Promise<string>;\n\n  /**\n   * 閮撠\n   * 敺?JSON 撠閮\n   */\n  import(data: string): Promise<number>;\n\n  // ========== 驗算璅∪? ==========\n\n  /**\n   * ?脣瘞豢?璅∪?\n   * ??璆菟?閮?????閮?芸?璅??箔??航??廄n   */\n  enterEternalMode(): Promise<void>;\n\n  /**\n   * 瑼Ｘ?臬?瘞豢?璅∪?\n   */\n  isEternalMode(): boolean;\n\n  /**\n   * ??閮\n   * 撠?摰??嗆?稱為唯一銝霈\n   */\n  lockMemory(memoryId: string): Promise<void>;\n}\n\n/**\n * 閮??\n */\nexport interface MemoryGraph {\n  /** 銝剖?閮 */\n  center: MemoryFragment;\n  /** ?閮 */\n  related: Array<{\n    memory: MemoryFragment;\n    relationship: string;\n    strength: number;\n  }>;\n  /** 瘛勗漲 */\n  depth: number;\n}\n\n/**\n * 閮蝯梯?\n */\nexport interface MemoryStatistics {\n  /** 蝮質??嗆 */\n  total: number;\n  /** ????蝯?*/\n  byType: Record<EternalMemoryType, number>;\n  /** 撟喳?????*/\n  averageImportance: number;\n  /** ?撣貉赤??閮 */\n  mostAccessed: MemoryFragment[];\n  /** ?餈?閮 */\n  mostRecent: MemoryFragment[];\n  /** ?脣?蝛粹?雿輻 */\n  storageUsed: {\n    bytes: number;\n    formatted: string;\n  };\n}\n\n// ============================================================================\n// 奧秘瘞豢撖虫?\n// ============================================================================\n\nexport class OmniEternalMemoryImpl implements OmniEternalMemory {\n  public id: string;\n  public name: string;\n  public totalMemories: number = 0;\n\n  private memories: Map<string, MemoryFragment> = new Map();\n  private memoryIndex: Map<string, string[]> = new Map(); // ?批捆蝝Ｗ?\n\n  constructor(name: string = '奧秘瘞豢') {\n    this.id = `eternal_memory_${Date.now()}`;\n    this.name = name;\n\n    omniLogger.info(LogCategory.INFRASTRUCTURE, '奧秘瘞豢系統??', {\n      id: this.id,\n      name: this.name,\n      features: ['ETERNAL', 'COMPREHENSIVE', 'RETRIEVABLE', 'TRACEABLE'],\n    });\n  }\n\n  async store(\n    content: string,\n    type: EternalMemoryType,\n    metadata?: Partial<MemoryMetadata>\n  ): Promise<MemoryFragment> {\n    const memory: MemoryFragment = {\n      id: `mem_${Date.now()}_${Math.random().toString(36).substr(2, 9)}`,\n      type,\n      content,\n      importance: this.calculateImportance(content, type),\n      accessCount: 0,\n      lastAccessedAt: new Date(),\n      createdAt: new Date(),\n      tags: [],\n      metadata: {\n        source: metadata?.source || 'unknown',\n        sessionId: metadata?.sessionId,\n        agentId: metadata?.agentId,\n        userId: metadata?.userId,\n        context: metadata?.context,\n        sentiment: metadata?.sentiment,\n        topics: metadata?.topics,\n      },\n      relatedMemories: [],\n    };\n\n    this.memories.set(memory.id, memory);\n    this.totalMemories++;\n\n    // 撱箇?蝝Ｗ?\n    this.indexMemory(memory);\n\n    omniLogger.info(LogCategory.INFRASTRUCTURE, `[瘞豢] ? Stored memory: ${memory.id}`, { type });\n    return memory;\n  }\n\n  async retrieve(query: string, options?: MemoryRetrievalOptions): Promise<MemoryFragment[]> {\n    let results = Array.from(this.memories.values());\n\n    // 憿??蕪\n    if (options?.types && options.types.length > 0) {\n      results = results.filter(m => options.types!.includes(m.type));\n    }\n\n    // ??蝭??蕪\n    if (options?.timeRange) {\n      const { start, end } = options.timeRange;\n      results = results.filter(m => {\n        const created = m.createdAt.getTime();\n        if (start && created < start.getTime()) return false;\n        if (end && created > end.getTime()) return false;\n        return true;\n      });\n    }\n\n    // 蝪∪?隡澆漲設計嚗祕??雿輻???訾撮摨佗?\n    results = results\n      .map(m => ({\n        ...m,\n        similarity: this.calculateSimilarity(query, m.content),\n      }))\n      .filter(\n        m => (m as unknown as { similarity: number }).similarity > (options?.threshold || 0.5)\n      );\n\n    // ??\n    const sortBy = options?.sortBy || 'relevance';\n    results.sort((a, b) => {\n      switch (sortBy) {\n        case 'relevance':\n          return (\n            ((b as unknown as { similarity: number }).similarity || 0) -\n            ((a as unknown as { similarity: number }).similarity || 0)\n          );\n        case 'recency':\n          return b.createdAt.getTime() - a.createdAt.getTime();\n        case 'importance':\n          return b.importance - a.importance;\n        case 'access_count':\n          return b.accessCount - a.accessCount;\n        default:\n          return 0;\n      }\n    });\n\n    // ?蝯??賊?\n    const limit = options?.limit || 10;\n    results = results.slice(0, limit);\n\n    // ?湔閮芸?閮?\n    results.forEach(m => {\n      m.accessCount++;\n      m.lastAccessedAt = new Date();\n    });\n\n    omniLogger.info(LogCategory.INFRASTRUCTURE, `[瘞豢] ?? Retrieved ${results.length} memories`, {\n      query,\n    });\n    return results;\n  }\n\n  async update(memoryId: string, updates: Partial<MemoryFragment>): Promise<MemoryFragment> {\n    const memory = this.memories.get(memoryId);\n    if (!memory) {\n      throw new Error(`Memory not found: ${memoryId}`);\n    }\n\n    Object.assign(memory, updates);\n    omniLogger.info(LogCategory.INFRASTRUCTURE, `[瘞豢] ?? Updated memory: ${memoryId}`);\n    return memory;\n  }\n\n  async delete(memoryId: string): Promise<void> {\n    // 頠?歹?璅??箏歇?芷???舐?甇??么n    const memory = this.memories.get(memoryId);\n    if (memory) {\n      memory.metadata.context = {\n        ...memory.metadata.context,\n        deleted: true,\n        deletedAt: new Date(),\n      };\n      omniLogger.info(LogCategory.INFRASTRUCTURE, `[瘞豢] 🏛️Soft deleted memory: ${memoryId}`);\n    }\n  }\n\n  async consolidate(): Promise<ConsolidationResult> {\n    omniLogger.info(LogCategory.INFRASTRUCTURE, '[瘞豢] ?? Starting memory consolidation...');\n\n    const result: ConsolidationResult = {\n      consolidatedCount: 0,\n      mergedMemories: [],\n      deletedMemories: [],\n      summaries: [],\n    };\n\n    // ?曉?剜?閮\n    const shortTermMemories = Array.from(this.memories.values()).filter(\n      m => m.type === EternalMemoryType.SHORT_TERM\n    );\n\n    // 撠?閬??剜?閮頧?瑟?閮\n    for (const memory of shortTermMemories) {\n      if (memory.importance > 0.7 || memory.accessCount > 5) {\n        memory.type = EternalMemoryType.LONG_TERM;\n        result.consolidatedCount++;\n      }\n    }\n\n    omniLogger.info(\n      LogCategory.INFRASTRUCTURE,\n      `[瘞豢] ??Consolidated ${result.consolidatedCount} memories`\n    );\n    return result;\n  }\n\n  async forget(criteria: {\n    importance?: number;\n    accessCount?: number;\n    age?: number;\n  }): Promise<number> {\n    let forgottenCount = 0;\n    const now = Date.now();\n\n    for (const memory of this.memories.values()) {\n      let shouldForget = false;\n\n      if (criteria.importance !== undefined && memory.importance < criteria.importance) {\n        shouldForget = true;\n      }\n\n      if (criteria.accessCount !== undefined && memory.accessCount < criteria.accessCount) {\n        shouldForget = true;\n      }\n\n      if (criteria.age !== undefined) {\n        const age = now - memory.createdAt.getTime();\n        if (age > criteria.age) {\n          shouldForget = true;\n        }\n      }\n\n      if (shouldForget) {\n        memory.importance *= 0.5; // ?????吭n        forgottenCount++;\n      }\n    }\n\n    omniLogger.info(LogCategory.INFRASTRUCTURE, `[瘞豢] ? Forgot ${forgottenCount} memories`);\n    return forgottenCount;\n  }\n\n  async associate(memoryId1: string, memoryId2: string): Promise<void> {\n    const mem1 = this.memories.get(memoryId1);\n    const mem2 = this.memories.get(memoryId2);\n\n    if (mem1 && mem2) {\n      if (!mem1.relatedMemories.includes(memoryId2)) {\n        mem1.relatedMemories.push(memoryId2);\n      }\n      if (!mem2.relatedMemories.includes(memoryId1)) {\n        mem2.relatedMemories.push(memoryId1);\n      }\n      omniLogger.info(\n        LogCategory.INFRASTRUCTURE,\n        `[瘞豢] ?? Associated memories: ${memoryId1} <-> ${memoryId2}`\n      );\n    }\n  }\n\n  async getMemoryGraph(memoryId: string, depth: number = 2): Promise<MemoryGraph> {\n    const center = this.memories.get(memoryId);\n    if (!center) {\n      throw new Error(`Memory not found: ${memoryId}`);\n    }\n\n    const related = center.relatedMemories\n      .map(id => this.memories.get(id))\n      .filter(m => m !== undefined)\n      .map(m => ({\n        memory: m!,\n        relationship: 'related',\n        strength: 0.8,\n      }));\n\n    return { center, related, depth };\n  }\n\n  async getStatistics(): Promise<MemoryStatistics> {\n    const memories = Array.from(this.memories.values());\n\n    const byType: Record<EternalMemoryType, number> = {\n      [EternalMemoryType.SHORT_TERM]: 0,\n      [EternalMemoryType.WORKING]: 0,\n      [EternalMemoryType.LONG_TERM]: 0,\n      [EternalMemoryType.PROCEDURAL]: 0,\n      [EternalMemoryType.SEMANTIC]: 0,\n      [EternalMemoryType.EPISODIC]: 0,\n      [EternalMemoryType.AWAKENING_EVENT]: 0,\n    };\n\n    memories.forEach(m => {\n      byType[m.type]++;\n    });\n\n    const totalImportance = memories.reduce((sum, m) => sum + m.importance, 0);\n    const averageImportance = memories.length > 0 ? totalImportance / memories.length : 0;\n\n    const mostAccessed = memories.sort((a, b) => b.accessCount - a.accessCount).slice(0, 5);\n\n    const mostRecent = memories\n      .sort((a, b) => b.createdAt.getTime() - a.createdAt.getTime())\n      .slice(0, 5);\n\n    const totalBytes = JSON.stringify(Array.from(this.memories.values())).length;\n\n    return {\n      total: this.totalMemories,\n      byType,\n      averageImportance,\n      mostAccessed,\n      mostRecent,\n      storageUsed: {\n        bytes: totalBytes,\n        formatted: this.formatBytes(totalBytes),\n      },\n    };\n  }\n\n  async export(): Promise<string> {\n    const data = {\n      id: this.id,\n      name: this.name,\n      exportedAt: new Date().toISOString(),\n      memories: Array.from(this.memories.values()),\n    };\n    return JSON.stringify(data, null, 2);\n  }\n\n  async import(data: string): Promise<number> {\n    const parsed = JSON.parse(data);\n    let imported = 0;\n\n    for (const memory of parsed.memories) {\n      this.memories.set(memory.id, memory);\n      imported++;\n    }\n\n    this.totalMemories = this.memories.size;\n    omniLogger.info(LogCategory.INFRASTRUCTURE, `[瘞豢] ? Imported ${imported} memories`);\n    return imported;\n  }\n\n  // ========== 蝘?頛?寞? ==========\n\n  private calculateImportance(content: string, type: EternalMemoryType): number {\n    // ?箸憿??蝷?閬吭n    const baseImportance: Record<EternalMemoryType, number> = {\n      [EternalMemoryType.SHORT_TERM]: 0.3,\n      [EternalMemoryType.WORKING]: 0.5,\n      [EternalMemoryType.LONG_TERM]: 0.8,\n      [EternalMemoryType.PROCEDURAL]: 0.9,\n      [EternalMemoryType.SEMANTIC]: 0.7,\n      [EternalMemoryType.EPISODIC]: 0.6,\n      [EternalMemoryType.AWAKENING_EVENT]: 1.0,\n    };\n\n    // ?箸?批捆?瑕漲?矽?廄n    const lengthBonus = Math.min(content.length / 1000, 0.2);\n\n    return Math.min(baseImportance[type] + lengthBonus, 1.0);\n  }\n\n  private calculateSimilarity(query: string, content: string): number {\n    // 蝪∪??敶??隡澆漲嚗祕??雿輻???訾撮摨佗?\n    const queryWords = new Set(query.toLowerCase().split(/\\s+/));\n    const contentWords = new Set(content.toLowerCase().split(/\\s+/));\n\n    const intersection = new Set([...queryWords].filter(w => contentWords.has(w)));\n\n    return intersection.size / Math.max(queryWords.size, contentWords.size);\n  }\n\n  private indexMemory(memory: MemoryFragment): void {\n    const words = memory.content.toLowerCase().split(/\\s+/);\n    words.forEach(word => {\n      if (!this.memoryIndex.has(word)) {\n        this.memoryIndex.set(word, []);\n      }\n      this.memoryIndex.get(word)!.push(memory.id);\n    });\n  }\n\n  private formatBytes(bytes: number): string {\n    if (bytes < 1024) return `${bytes} B`;\n    if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(2)} KB`;\n    return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;\n  }\n\n  // ========== 瘞豢?璅∪?撖虫? ==========\n\n  private eternalMode: boolean = false;\n  private lockedMemories: Set<string> = new Set();\n\n  async enterEternalMode(): Promise<void> {\n    this.eternalMode = true;\n    omniLogger.info(LogCategory.INFRASTRUCTURE, '?橘? [瘞豢] ?脣瘞豢?璅∪? - ??閮撠偶銋?摰?);\n\n    // 撠???? LONG_TERM 閮??\n    for (const memory of this.memories.values()) {\n      if (memory.type === EternalMemoryType.LONG_TERM) {\n        await this.lockMemory(memory.id);\n      }\n    }\n  }\n\n  isEternalMode(): boolean {\n    return this.eternalMode;\n  }\n\n  async lockMemory(memoryId: string): Promise<void> {\n    const memory = this.memories.get(memoryId);\n    if (!memory) {\n      throw new Error(`Memory not found: ${memoryId}`);\n    }\n\n    this.lockedMemories.add(memoryId);\n    memory.metadata.context = {\n      ...memory.metadata.context,\n      locked: true,\n      lockedAt: new Date(),\n      eternal: true,\n    };\n\n    omniLogger.info(LogCategory.INFRASTRUCTURE, `?? [瘞豢] 閮撌脤?摰? ${memoryId}`);\n  }\n}\n\n// ============================================================================\n// 撌亙??賣\n// ============================================================================\n\n/**\n * ?萄遣奧秘瘞豢撖虫?\n */\nexport function createEternalMemory(name?: string): OmniEternalMemory {\n  return new OmniEternalMemoryImpl(name);\n}\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\infrastructure\\memory\\OmniMemory.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":100,"column":93,"nodeType":"Literal","messageId":"noMagic","endLine":100,"endColumn":95},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 50.","line":159,"column":17,"nodeType":"Literal","messageId":"noMagic","endLine":159,"endColumn":19}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":2,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { create } from 'zustand';\nimport { persist, createJSONStorage } from 'zustand/middleware';\nimport {\n  ESGDataTag,\n  MemoryPalaceStructure,\n  IEvolutionState,\n  SixFormsPhase,\n} from '../types/Omni-entity.types';\nimport { IEvidence } from '../../core/GoodwardCore';\n\n// 奧秘瘞豢 (Omni Eternal Memory) - 閮摰格挪撖虫?\n// This is the persistent state manager implementing the Memory Palace architecture.\n\ninterface OmniMemoryState {\n  // 閮摰格挪協議鞈?蝯?\n  palace: MemoryPalaceStructure;\n  evolutionState: IEvolutionState;\n  lastSync: string | null;\n\n  // 協議數據 (Core Data)\n  esgData: ESGDataTag | null;\n\n  // 奧秘精靈?? (OmniKey Actions)\n  setShortTermContext: (key: string, value: any) => void;\n  addInteractionLog: (topic: string) => void;\n  updateEvolutionMetrics: (metrics: Partial<IEvolutionState['wisdomMetrics']>) => void;\n  setEvolutionPhase: (phase: SixFormsPhase) => void;\n  setESGData: (data: ESGDataTag) => void;\n  // 5T Evidence Logging\n  addEvidence: (evidence: IEvidence) => void;\n\n  // ?祆?撘? (Gravity) - 甈?隤踵\n  reinforceConcept: (concept: string, weightDelta: number) => void;\n\n  // 系統??\n  clearMemory: () => void;\n}\n\nconst INITIAL_PALACE: MemoryPalaceStructure = {\n  theHall: {\n    sessionId: null,\n    recentInteractions: [],\n    activeContext: {},\n  },\n  theLibrary: {\n    manifesto: [\n      '隞亦??箏?嚗?蝯?銝 (Start with the End in mind, Consistent from beginning to end)',\n      '雿輻?銝剖? (User Centric)',\n      '?祉??芸? (Everything is optimizable)',\n    ],\n    domainRules: {\n      ESG: ['Environmental', 'Social', 'Governance'],\n      JunAiKey: ['Security', 'Integration', 'Evolution'],\n    },\n  },\n  theVault: {\n    evolutionLogs: [],\n    conceptWeights: {},\n    evidenceChain: [],\n  },\n};\n\nconst INITIAL_EVOLUTION: IEvolutionState = {\n  currentPhase: 'AWAKENING',\n  experiencePoints: 0,\n  evolutionLevel: 1,\n  wisdomMetrics: {\n    memoryRetention: 1.0,\n    inferenceSpeed: 0,\n    patternRecognition: 0.1,\n  },\n};\n\nexport const useOmniMemory = create<OmniMemoryState>()(\n  persist(\n    (set): OmniMemoryState => ({\n      palace: INITIAL_PALACE,\n      evolutionState: INITIAL_EVOLUTION,\n      lastSync: null as string | null,\n      esgData: null as ESGDataTag | null,\n\n      // --- 憭批輒?? (The Hall) ---\n      setShortTermContext: (key: string, value: any) =>\n        set(state => ({\n          palace: {\n            ...state.palace,\n            theHall: {\n              ...state.palace.theHall,\n              activeContext: {\n                ...state.palace.theHall.activeContext,\n                [key]: value,\n              },\n            },\n          },\n        })),\n\n      addInteractionLog: (topic: string) =>\n        set(state => {\n          const newLog = { topic, timestamp: new Date().toISOString() };\n          const updatedLogs = [newLog, ...state.palace.theHall.recentInteractions].slice(0, 10);\n          return {\n            palace: {\n              ...state.palace,\n              theHall: {\n                ...state.palace.theHall,\n                recentInteractions: updatedLogs,\n              },\n            },\n          };\n        }),\n\n      // --- ?脣???摨急?雿?(Evolution & The Vault) ---\n      updateEvolutionMetrics: (metrics: Partial<IEvolutionState['wisdomMetrics']>) =>\n        set(state => ({\n          evolutionState: {\n            ...state.evolutionState,\n            wisdomMetrics: {\n              ...state.evolutionState.wisdomMetrics,\n              ...metrics,\n            },\n          },\n        })),\n\n      setEvolutionPhase: (phase: SixFormsPhase) =>\n        set(state => ({\n          evolutionState: {\n            ...state.evolutionState,\n            currentPhase: phase,\n          },\n        })),\n\n      setESGData: (data: ESGDataTag) => set({ esgData: data }),\n\n      reinforceConcept: (concept: string, weightDelta: number) =>\n        set(state => {\n          const currentWeight = state.palace.theVault.conceptWeights[concept] || 0;\n          return {\n            palace: {\n              ...state.palace,\n              theVault: {\n                ...state.palace.theVault,\n                conceptWeights: {\n                  ...state.palace.theVault.conceptWeights,\n                  [concept]: currentWeight + weightDelta,\n                },\n              },\n            },\n          };\n        }),\n\n      addEvidence: (evidence: IEvidence) =>\n        set(state => ({\n          palace: {\n            ...state.palace,\n            theVault: {\n              ...state.palace.theVault,\n              evidenceChain: [evidence, ...(state.palace.theVault.evidenceChain || [])].slice(\n                0,\n                50\n              ),\n            },\n          },\n        })),\n\n      clearMemory: () =>\n        set({\n          palace: INITIAL_PALACE,\n          evolutionState: INITIAL_EVOLUTION,\n          lastSync: null as string | null,\n          esgData: null as ESGDataTag | null,\n        }),\n    }),\n    {\n      name: 'omni-eternal-memory-storage',\n      storage: createJSONStorage(() => localStorage),\n      partialize: (state: OmniMemoryState) => ({\n        palace: state.palace,\n        evolutionState: state.evolutionState,\n        esgData: state.esgData,\n      }),\n    }\n  )\n);\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\infrastructure\\scheduler\\AwakeningScheduler.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60000.","line":32,"column":35,"nodeType":"Literal","messageId":"noMagic","endLine":32,"endColumn":40},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":76,"column":69,"nodeType":"Literal","messageId":"noMagic","endLine":76,"endColumn":71},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 30.","line":79,"column":43,"nodeType":"Literal","messageId":"noMagic","endLine":79,"endColumn":45}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":3,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * ?芸?驗算隤踹漲?沔n *\n * 撖衣?閬箝??芸???- ?箸璇辣?芸?閫貊驗算\n */\n\nimport {\n  getUltimateAwakeningProtocol,\n  AwakeningPhase,\n} from '@/omni/protocols/UltimateAwakeningProtocol';\nimport { awakeningStateManager } from '@/omni/infrastructure/state/AwakeningStateManager';\nimport { awakeningBroadcaster } from '@/omni/infrastructure/broadcast/AwakeningBroadcaster';\nimport { omniLogger, LogCategory } from '@/omni/infrastructure/logging/OmniLogger';\n\n/**\n * 驗算閫貊璇辣\n */\nexport interface AwakeningTriggerCondition {\n  id: string;\n  name: string;\n  enabled: boolean;\n  evaluate: () => Promise<boolean>;\n  priority: number;\n}\n\n/**\n * ?芸?驗算隤踹漲?沔n */\nexport class AwakeningScheduler {\n  private static instance: AwakeningScheduler;\n  private isRunning: boolean = false;\n  private checkInterval: number = 60000; // 1 ??瑼Ｘ銝甈﹏n  private intervalId: NodeJS.Timeout | null = null;\n  private triggers: Map<string, AwakeningTriggerCondition> = new Map();\n\n  private constructor() {\n    this.registerDefaultTriggers();\n    omniLogger.info(LogCategory.SYSTEM, '[真實隤踹漲] ?芸?驗算隤踹漲?典歇????);\n  }\n\n  static getInstance(): AwakeningScheduler {\n    if (!AwakeningScheduler.instance) {\n      AwakeningScheduler.instance = new AwakeningScheduler();\n    }\n    return AwakeningScheduler.instance;\n  }\n\n  /**\n   * 閮餃?暺?閫貊璇辣\n   */\n  private registerDefaultTriggers(): void {\n    // ??閫貊嚗?24撠?\n    this.registerTrigger({\n      id: 'daily-awakening',\n      name: '瘥?芸?驗算',\n      enabled: false,\n      priority: 1,\n      evaluate: async () => {\n        return awakeningStateManager.shouldAutoAwaken();\n      },\n    });\n\n    // 系統蝛粹?閫貊\n    this.registerTrigger({\n      id: 'idle-awakening',\n      name: '系統蝛粹??死??,\n      enabled: false,\n      priority: 2,\n      evaluate: async () => {\n        // 瑼Ｘ?冽?臬蝛粹?嚗隞仿??敺漱鈭???瘀?\n        const lastActivity = localStorage.getItem('last-user-activity');\n        if (!lastActivity) return false;\n\n        const lastTime = new Date(lastActivity).getTime();\n        const now = Date.now();\n        const minutesSinceLastActivity = (now - lastTime) / (1000 * 60);\n\n        // 頞? 30 ??瘝?瘣餃?\n        return minutesSinceLastActivity > 30;\n      },\n    });\n\n    // ???閫貊\n    this.registerTrigger({\n      id: 'startup-awakening',\n      name: '????死??,\n      enabled: false,\n      priority: 3,\n      evaluate: async () => {\n        const state = awakeningStateManager.getState();\n        // 憒?銋???偶?????孛?墦n        return state.phase !== AwakeningPhase.ETERNAL;\n      },\n    });\n  }\n\n  /**\n   * 閮餃?閫貊璇辣\n   */\n  registerTrigger(trigger: AwakeningTriggerCondition): void {\n    this.triggers.set(trigger.id, trigger);\n    omniLogger.info(LogCategory.SYSTEM, `[真實隤踹漲] 撌脰酉?孛?潭?隞? ${trigger.name}`);\n  }\n\n  /**\n   * ?/蝳閫貊璇辣\n   */\n  setTriggerEnabled(id: string, enabled: boolean): void {\n    const trigger = this.triggers.get(id);\n    if (trigger) {\n      trigger.enabled = enabled;\n      omniLogger.info(\n        LogCategory.SYSTEM,\n        `[真實隤踹漲] 閫貊璇辣 ${trigger.name} 撌?{enabled ? '?' : '蝳'}`\n      );\n    }\n  }\n\n  /**\n   * ??隤踹漲?沔n   */\n  start(): void {\n    if (this.isRunning) {\n      omniLogger.warn(LogCategory.SYSTEM, '[真實隤踹漲] 隤踹漲?典歇?券?銵葉');\n      return;\n    }\n\n    this.isRunning = true;\n    this.scheduleNextCheck();\n\n    omniLogger.info(LogCategory.SYSTEM, '[真實隤踹漲] 隤踹漲?典歇??', {\n      checkInterval: this.checkInterval,\n      triggers: this.triggers.size,\n    });\n\n    awakeningBroadcaster.shareInsight({\n      category: 'performance',\n      title: '?芸?驗算隤踹漲?典歇??',\n      message: `系統撠? ${this.checkInterval / 1000} 蝘炎?亥死??隞跆,\n      priority: 'medium',\n      actionable: false,\n    });\n  }\n\n  /**\n   * ?迫隤踹漲?沔n   */\n  stop(): void {\n    if (this.intervalId) {\n      clearTimeout(this.intervalId);\n      this.intervalId = null;\n    }\n\n    this.isRunning = false;\n    omniLogger.info(LogCategory.SYSTEM, '[真實隤踹漲] 隤踹漲?典歇?迫');\n  }\n\n  /**\n   * 隤踹漲銝?甈⊥炎?功n   */\n  private scheduleNextCheck(): void {\n    this.intervalId = setTimeout(async () => {\n      await this.checkAndExecute();\n      if (this.isRunning) {\n        this.scheduleNextCheck();\n      }\n    }, this.checkInterval);\n  }\n\n  /**\n   * 瑼Ｘ銝血銵死?n   */\n  private async checkAndExecute(): Promise<void> {\n    const protocol = getUltimateAwakeningProtocol();\n    const currentState = protocol.getState();\n\n    // 憒?撌脩??刻死?葉嚗歲?n    if (\n      currentState.phase !== AwakeningPhase.DORMANT &&\n      currentState.phase !== AwakeningPhase.ETERNAL\n    ) {\n      return;\n    }\n\n    omniLogger.info(LogCategory.SYSTEM, '[真實隤踹漲] 瑼Ｘ驗算璇辣...');\n\n    // ?合約??閫貊璇辣\n    const sortedTriggers = Array.from(this.triggers.values())\n      .filter(t => t.enabled)\n      .sort((a, b) => a.priority - b.priority);\n\n    // 閰摯璇辣\n    for (const trigger of sortedTriggers) {\n      try {\n        const shouldTrigger = await trigger.evaluate();\n\n        if (shouldTrigger) {\n          omniLogger.info(LogCategory.SYSTEM, `[真實隤踹漲] 閫貊璇辣皛輯雲: ${trigger.name}`);\n\n          // ?瑁??芸?驗算\n          await this.executeAutoAwakening(trigger);\n          break; // ?芸銵洵銝?遛頞單?隞嗥?閫貊?沔n        }\n      } catch (error) {\n        omniLogger.error(LogCategory.SYSTEM, `[真實隤踹漲] 閰摯閫貊璇辣憭望?: ${trigger.name}`, {\n          error,\n        });\n      }\n    }\n  }\n\n  /**\n   * ?瑁??芸?驗算\n   */\n  private async executeAutoAwakening(trigger: AwakeningTriggerCondition): Promise<void> {\n    const startTime = Date.now();\n\n    awakeningBroadcaster.shareInsight({\n      category: 'performance',\n      title: '?芸?驗算撌脰孛??,\n      message: `?望??{trigger.name}重構隞嗆遛頞喉?系統甇??芸??瑁?驗算摨?`,\n      priority: 'high',\n      actionable: false,\n    });\n\n    try {\n      const protocol = getUltimateAwakeningProtocol();\n      const result = await protocol.executeAwakening();\n\n      const duration = Date.now() - startTime;\n\n      if (result.success) {\n        omniLogger.info(LogCategory.SYSTEM, '[真實隤踹漲] ?芸?驗算摰?', {\n          trigger: trigger.name,\n          duration,\n          servicesAwakened: result.servicesAwakened,\n        });\n\n        awakeningStateManager.recordHistory({\n          startedAt: new Date(startTime).toISOString(),\n          completedAt: new Date().toISOString(),\n          phase: result.phase,\n          servicesAwakened: result.servicesAwakened,\n          totalServices: result.totalServices,\n          eternalAnchor: result.eternalAnchor,\n          success: true,\n          duration,\n        });\n\n        awakeningBroadcaster.shareInsight({\n          category: 'achievement',\n          title: '?芸?驗算??',\n          message: `系統撌脫???死??${result.servicesAwakened}/${result.totalServices} ???歇??`,\n          priority: 'critical',\n          actionable: false,\n          metadata: {\n            trigger: trigger.name,\n            duration,\n          },\n        });\n      } else {\n        omniLogger.error(LogCategory.SYSTEM, '[真實隤踹漲] ?芸?驗算憭望?', {\n          trigger: trigger.name,\n          errors: result.errors,\n        });\n\n        awakeningStateManager.recordHistory({\n          startedAt: new Date(startTime).toISOString(),\n          completedAt: new Date().toISOString(),\n          phase: result.phase,\n          servicesAwakened: result.servicesAwakened,\n          totalServices: result.totalServices,\n          success: false,\n          duration: Date.now() - startTime,\n        });\n\n        awakeningBroadcaster.shareInsight({\n          category: 'alert',\n          title: '?芸?驗算憭望?',\n          message: `驗算??銝剔?隤? ${result.message}`,\n          priority: 'high',\n          actionable: true,\n        });\n      }\n    } catch (error) {\n      omniLogger.error(LogCategory.SYSTEM, '[真實隤踹漲] ?芸?驗算?啣虜', { error });\n\n      awakeningBroadcaster.shareInsight({\n        category: 'alert',\n        title: '?芸?驗算?啣虜',\n        message: `驗算??銝剔????隤亡,\n        priority: 'critical',\n        actionable: true,\n      });\n    }\n  }\n\n  /**\n   * ??閫貊驗算\n   */\n  async triggerManually(): Promise<void> {\n    omniLogger.info(LogCategory.SYSTEM, '[真實隤踹漲] ??閫貊驗算');\n\n    await this.executeAutoAwakening({\n      id: 'manual',\n      name: '??閫貊',\n      enabled: true,\n      priority: 0,\n      evaluate: async () => true,\n    });\n  }\n\n  /**\n   * ?脣???孛?潭?隞跚n   */\n  getTriggers(): AwakeningTriggerCondition[] {\n    return Array.from(this.triggers.values());\n  }\n\n  /**\n   * 閮剔蔭瑼Ｘ??\n   */\n  setCheckInterval(milliseconds: number): void {\n    this.checkInterval = milliseconds;\n    omniLogger.info(LogCategory.SYSTEM, `[真實隤踹漲] 瑼Ｘ??撌脫?啁 ${milliseconds}ms`);\n\n    // 憒?甇???嚗??誑??圈??n    if (this.isRunning) {\n      this.stop();\n      this.start();\n    }\n  }\n\n  /**\n   * ?脣?隤踹漲?函??n   */\n  getStatus() {\n    return {\n      isRunning: this.isRunning,\n      checkInterval: this.checkInterval,\n      totalTriggers: this.triggers.size,\n      enabledTriggers: Array.from(this.triggers.values()).filter(t => t.enabled).length,\n      triggers: this.getTriggers().map(t => ({\n        id: t.id,\n        name: t.name,\n        enabled: t.enabled,\n        priority: t.priority,\n      })),\n    };\n  }\n}\n\n// 撠?桐?撖虫?\nexport const awakeningScheduler = AwakeningScheduler.getInstance();\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\omni\\infrastructure\\state\\AwakeningStateManager.ts","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 50.","line":155,"column":31,"nodeType":"Literal","messageId":"noMagic","endLine":155,"endColumn":33},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 50.","line":156,"column":44,"nodeType":"Literal","messageId":"noMagic","endLine":156,"endColumn":46},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 10.","line":180,"column":30,"nodeType":"Literal","messageId":"noMagic","endLine":180,"endColumn":32},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":204,"column":66,"nodeType":"Literal","messageId":"noMagic","endLine":204,"endColumn":68},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":204,"column":71,"nodeType":"Literal","messageId":"noMagic","endLine":204,"endColumn":73},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 24.","