ext-2xl font-black text-white tracking-tight flex items-center gap-2\">\n            <FileText className=\"text-indigo-400 w-6 h-6\" />\n            {isZh ? 'ESG ?勗??銝剖?' : 'ESG Report Command Center'}\n          </h1>\n          <p className=\"text-slate-400 mt-1 text-sm font-medium\">\n            {isZh\n              ? '敺?????撘撠平?勗?多元核心??蝡?撌乩?瘚?'\n              : 'End-to-end workflow from guided data collection to professional generation'}\n          </p>\n        </div>\n      </div>\n\n      {/* Mode Toggle */}\n      <div className=\"flex p-1 bg-slate-900 border border-white/10 rounded-xl w-fit\">\n        <button\n          onClick={() => setActiveMode('wizard')}\n          className={`px-6 py-2 rounded-lg text-sm font-bold transition-all flex items-center gap-2 ${activeMode === 'wizard' ? 'bg-indigo-600 text-white shadow-lg' : 'text-slate-400 hover:text-white'}`}\n        >\n          <CheckSquare className=\"w-4 h-4\" /> 鞈?皞? (Data Prep)\n        </button>\n        <div className=\"w-px bg-white/10 my-1 mx-1\"></div>\n        <button\n          onClick={() => setActiveMode('generator')}\n          className={`px-6 py-2 rounded-lg text-sm font-bold transition-all flex items-center gap-2 ${activeMode === 'generator' ? 'bg-emerald-600 text-white shadow-lg' : 'text-slate-400 hover:text-white'}`}\n        >\n          <Sparkles className=\"w-4 h-4\" /> ?勗?多元核心 (Generator)\n        </button>\n      </div>\n\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Conditional Rendering based on Mode */}\n        {activeMode === 'wizard' ? (\n          <div className=\"lg:col-span-3\">\n            <ReportPrepWizard />\n          </div>\n        ) : (\n          <>\n            {/* Template Selection */}\n            <div className=\"lg:col-span-2 space-y-4\">\n              <h2 className=\"text-lg font-bold text-white\">\n                {isZh ? '數據?勗?模式' : 'Select Report Template'}\n              </h2>\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n                {templates.map(template => (\n                  <div\n                    key={template.id}\n                    onClick={() => setSelectedTemplate(template.id)}\n                    className={`bg-slate-900/50 border-2 rounded-2xl p-5 cursor-pointer transition-all ${\n                      selectedTemplate === template.id\n                        ? 'border-indigo-500 shadow-[0_0_20px_rgba(99,102,241,0.2)]'\n                        : 'border-white/5 hover:border-white/10'\n                    }`}\n                    role=\"button\"\n                    tabIndex={0}\n                    aria-label={`${isZh ? '數據' : 'Select'} ${template.name}${isZh ? '模式嚗??' : ' template, approximately'} ${template.time} ${isZh ? '??' : 'minutes'}`}\n                    onKeyDown={e => {\n                      if (e.key === 'Enter' || e.key === ' ') setSelectedTemplate(template.id);\n                    }}\n                  >\n                    <div className=\"flex justify-between items-start mb-3\">\n                      <div className=\"w-12 h-12 bg-white/5 rounded-xl flex items-center justify-center text-2xl\">\n                        {template.icon}\n                      </div>\n                      {selectedTemplate === template.id && (\n                        <CheckSquare className=\"w-5 h-5 text-indigo-400\" />\n                      )}\n                    </div>\n                    <h3 className=\"text-white font-bold mb-1\">{template.name}</h3>\n                    <p className=\"text-xs text-slate-400 mb-4\">{template.description}</p>\n                    <div className=\"flex gap-4 text-xs text-slate-500\">\n                      <span>\n                        ?? {template.pages} {isZh ? '?? : 'pages'}\n                      </span>\n                      <span>\n                        ?梧? {template.time} {isZh ? '??' : 'min'}\n                      </span>\n                    </div>\n                  </div>\n                ))}\n              </div>\n            </div>\n\n            {/* Generation Settings */}\n            <div className=\"bg-slate-900/50 border border-white/5 rounded-2xl p-6 h-fit\">\n              <h2 className=\"text-lg font-bold text-white mb-4\">\n                {isZh ? '多元核心閮剖?' : 'Generation Settings'}\n              </h2>\n\n              <div className=\"space-y-4\">\n                <div>\n                  <label className=\"block text-sm font-semibold text-slate-400 mb-2\">\n                    {isZh ? '?勗???' : 'Reporting Period'}\n                  </label>\n                  <select className=\"w-full bg-slate-800 border border-slate-600 text-white rounded-lg px-4 py-2\">\n                    <option>2025 {isZh ? '?典僑' : 'Full Year'}</option>\n                    <option>2025 Q4</option>\n                    <option>2025 Q3</option>\n                  </select>\n                </div>\n\n                <div>\n                  <label className=\"block text-sm font-semibold text-slate-400 mb-2\">\n                    {isZh ? '隤?' : 'Language'}\n                  </label>\n                  <select className=\"w-full bg-slate-800 border border-slate-600 text-white rounded-lg px-4 py-2\">\n                    <option>{isZh ? '蝜?銝剜?' : 'Traditional Chinese'}</option>\n                    <option>English</option>\n                    <option>{isZh ? '??' : 'Bilingual'}</option>\n                  </select>\n                </div>\n\n                <div>\n                  <label className=\"block text-sm font-semibold text-slate-400 mb-2\">\n                    {isZh ? '?澆?' : 'Format'}\n                  </label>\n                  <div className=\"grid grid-cols-2 gap-2\">\n                    <button\n                      onClick={() => setSelectedFormat('typst')}\n                      className={`border-2 py-2 rounded-lg font-semibold text-sm transition-all ${\n                        selectedFormat === 'typst'\n                          ? 'bg-cyan-600/20 border-cyan-500 text-cyan-400 shadow-[0_0_15px_rgba(6,182,212,0.3)]'\n                          : 'bg-white/5 border-white/10 text-slate-400 hover:border-white/20'\n                      }`}\n                    >\n                      Typst (.typ)\n                    </button>\n                    <button\n                      onClick={() => setSelectedFormat('pdf')}\n                      className={`border-2 py-2 rounded-lg font-semibold text-sm transition-all ${\n                        selectedFormat === 'pdf'\n                          ? 'bg-indigo-600/20 border-indigo-500 text-indigo-400'\n                          : 'bg-white/5 border-white/10 text-slate-400 hover:border-white/20'\n                      }`}\n                    >\n                      PDF (Standard)\n                    </button>\n                  </div>\n                </div>\n\n                <div className=\"flex items-center justify-between p-3 bg-white/5 rounded-lg\">\n                  <span className=\"text-white text-sm\">\n                    {isZh ? 'AI ?芸??批捆' : 'AI Content Enhancement'}\n                  </span>\n                  <label className=\"relative inline-flex items-center cursor-pointer\">\n                    <input type=\"checkbox\" className=\"sr-only peer\" defaultChecked />\n                    <div className=\"w-11 h-6 bg-slate-700 rounded-full peer peer-checked:after:translate-x-full after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-indigo-600\"></div>\n                  </label>\n                </div>\n\n                <button\n                  onClick={handleGenerate}\n                  disabled={isGenerating}\n                  className={`w-full py-3 rounded-xl font-bold flex items-center justify-center gap-2 hover:shadow-lg transition-all disabled:opacity-50 disabled:cursor-not-allowed ${\n                    selectedFormat === 'typst'\n                      ? 'bg-gradient-to-r from-cyan-600 to-blue-600 text-white'\n                      : 'bg-gradient-to-r from-indigo-600 to-purple-600 text-white'\n                  }`}\n                  aria-label={\n                    isGenerating\n                      ? isZh\n                        ? '甇?多元核心?勗?...'\n                        : 'Generating report...'\n                      : `${isZh ? '多元核心' : 'Generate'} ${templates.find(t => t.id === selectedTemplate)?.name}`\n                  }\n                >\n                  {isGenerating ? (\n                    <>\n                      <div className=\"w-5 h-5 border-2 border-white/30 border-t-white rounded-full animate-spin\" />\n                      {isZh ? '多元核心銝?..' : 'Generating...'}\n                    </>\n                  ) : (\n                    <>\n                      {selectedFormat === 'typst' ? (\n                        <Code className=\"w-5 h-5\" />\n                      ) : (\n                        <Sparkles className=\"w-5 h-5\" />\n                      )}\n                      {isZh\n                        ? selectedFormat === 'typst'\n                          ? '銝? Typst 皞Ⅳ'\n                          : '多元核心 PDF ?勗?'\n                        : selectedFormat === 'typst'\n                          ? 'Download .typ Source'\n                          : 'Generate PDF'}\n                    </>\n                  )}\n                </button>\n              </div>\n            </div>\n          </>\n        )}\n      </div>\n\n      {/* Recent Reports */}\n      <div className=\"bg-slate-900/50 border border-white/5 rounded-2xl p-6\">\n        <h2 className=\"text-lg font-bold text-white mb-4\">\n          {isZh ? '?餈????勗?' : 'Recent Reports'}\n        </h2>\n        <div className=\"space-y-3\">\n          {recentReports.map((report, i) => (\n            <div\n              key={i}\n              className=\"flex items-center justify-between p-4 bg-white/5 rounded-lg hover:bg-white/10 transition-colors\"\n            >\n              <div className=\"flex items-center gap-3\">\n                <div className=\"w-10 h-10 bg-indigo-500/10 rounded-lg flex items-center justify-center\">\n                  <FileText className=\"w-5 h-5 text-indigo-400\" />\n                </div>\n                <div>\n                  <p className=\"text-white font-semibold\">{report.name}</p>\n                  <div className=\"flex items-center gap-3 text-xs text-slate-500 mt-1\">\n                    {/* Access Verification Data safely */}\n                    {(report as any).txHash && (\n                      <VerificationBadge\n                        reportId=\"mock-id\"\n                        merkleRoot={(report as any).merkleRoot}\n                        timestamp={new Date(report.date)}\n                        txHash={(report as any).txHash}\n                      />\n                    )}\n                    <div className=\"flex items-center gap-1\">\n                      <span className=\"flex items-center gap-1\">\n                        <Calendar className=\"w-3 h-3\" />\n                        {report.date}\n                      </span>\n                      <span className=\"flex items-center gap-1\">\n                        <Download className=\"w-3 h-3\" />\n                        {report.downloads} {isZh ? '甈∩?頛? : 'downloads'}\n                      </span>\n                    </div>\n                  </div>\n                </div>\n                <div className=\"flex gap-2\">\n                  <button className=\"bg-white/5 hover:bg-white/10 border border-white/10 text-white px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors flex items-center gap-1\">\n                    <Eye className=\"w-3 h-3\" />\n                    {isZh ? '?汗' : 'Preview'}\n                  </button>\n                  <button className=\"bg-indigo-600/20 hover:bg-indigo-600/30 border border-indigo-500/30 text-indigo-400 px-3 py-1.5 rounded-lg text-xs font-semibold transition-colors flex items-center gap-1\">\n                    <Download className=\"w-3 h-3\" />\n                    {isZh ? '銝?' : 'Download'}\n                  </button>\n                </div>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n\n      {/* Statistics */}\n      <div className=\"grid grid-cols-1 md:grid-cols-4 gap-4\">\n        <div className=\"bg-slate-900/50 border border-white/5 rounded-2xl p-4 text-center\">\n          <div className=\"text-3xl font-black text-indigo-400 mb-1\">24</div>\n          <div className=\"text-xs text-slate-400\">\n            {isZh ? '?祆?多元核心?勗?' : 'Reports This Month'}\n          </div>\n        </div>\n        <div className=\"bg-slate-900/50 border border-white/5 rounded-2xl p-4 text-center\">\n          <div className=\"text-3xl font-black text-emerald-400 mb-1\">156</div>\n          <div className=\"text-xs text-slate-400\">{isZh ? '蝝航??勗?' : 'Total Reports'}</div>\n        </div>\n        <div className=\"bg-slate-900/50 border border-white/5 rounded-2xl p-4 text-center\">\n          <div className=\"text-3xl font-black text-amber-400 mb-1\">4.2</div>\n          <div className=\"text-xs text-slate-400\">\n            {isZh ? '撟喳?多元核心?? (??)' : 'Avg Generation Time (min)'}\n          </div>\n        </div>\n        <div className=\"bg-slate-900/50 border border-white/5 rounded-2xl p-4 text-center\">\n          <div className=\"text-3xl font-black text-purple-400 mb-1\">98%</div>\n          <div className=\"text-xs text-slate-400\">{isZh ? '?批捆皞Ⅱ摨? : 'Content Accuracy'}</div>\n        </div>\n      </div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\profile\\OmniHut.tsx","messages":[{"ruleId":"react/no-unescaped-entities","severity":2,"message":"`'` can be escaped with `&apos;`, `&lsquo;`, `&#39;`, `&rsquo;`.","line":50,"column":56,"nodeType":"JSXText","messageId":"unescapedEntityAlts","suggestions":[{"messageId":"replaceWithAlt","data":{"alt":"&apos;"},"fix":{"range":[1860,1878],"text":"Juniper&apos;s Omni-Hut"},"desc":"Replace with `&apos;`."},{"messageId":"replaceWithAlt","data":{"alt":"&lsquo;"},"fix":{"range":[1860,1878],"text":"Juniper&lsquo;s Omni-Hut"},"desc":"Replace with `&lsquo;`."},{"messageId":"replaceWithAlt","data":{"alt":"&#39;"},"fix":{"range":[1860,1878],"text":"Juniper&#39;s Omni-Hut"},"desc":"Replace with `&#39;`."},{"messageId":"replaceWithAlt","data":{"alt":"&rsquo;"},"fix":{"range":[1860,1878],"text":"Juniper&rsquo;s Omni-Hut"},"desc":"Replace with `&rsquo;`."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"// src/components/profile/OmniHut.tsx\nimport React, { useState } from 'react';\nimport {\n  User,\n  Settings,\n  Sun,\n  Moon,\n  Palette,\n  Coins,\n  ArrowRight,\n  Layout,\n  Zap,\n  Award,\n} from 'lucide-react';\nimport { useNavigate } from 'react-router-dom';\nimport { omniLogger, LogCategory } from '../../services/omniLogger';\n\nexport const OmniHut: React.FC = () => {\n  const navigate = useNavigate();\n  const [isDarkMode, setIsDarkMode] = useState(true);\n  const [activeTheme, setActiveTheme] = useState('default');\n\n  const toggleTheme = () => {\n    setIsDarkMode(!isDarkMode);\n    // In a real app, this would toggle a global context or class on the <html> tag\n    omniLogger.info(LogCategory.USER_ACTION, 'Theme toggled', {\n      mode: !isDarkMode ? 'Dark' : 'Light',\n    });\n  };\n\n  return (\n    <div\n      className={`min-h-screen ${isDarkMode ? 'bg-slate-950 text-white' : 'bg-slate-100 text-slate-900'} p-4 md:p-8 pb-32 animate-in fade-in transition-colors duration-500`}\n    >\n      {/* ?? Header: The Hut Identity */}\n      <div\n        className={`${isDarkMode ? 'bg-slate-900 border-white/10' : 'bg-white 