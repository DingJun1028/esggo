ooltip] = useState(false);\n\n  const getSourceIcon = () => {\n    switch (data.source.type) {\n      case 'blockchain':\n        return <Database className=\"w-3 h-3\" />;\n      case 'calculation':\n        return <Calculator className=\"w-3 h-3\" />;\n      case 'api':\n      case 'third-party':\n        return <ExternalLink className=\"w-3 h-3\" />;\n      default:\n        return <FileText className=\"w-3 h-3\" />;\n    }\n  };\n\n  const getSourceLabel = () => {\n    const labels = {\n      api: 'API數據',\n      calculation: '設計蝯?',\n      blockchain: '?憛?撽?',\n      manual: '鈭箏極?',\n      'third-party': '蝚砌??寞??,\n    };\n    return labels[data.source.type];\n  };\n\n  return (\n    <div className=\"relative inline-block group\">\n      {/* 銝餉?數據撅內 */}\n      <div className=\"flex items-center gap-2\">\n        {children}\n\n        {/* 靘??? */}\n        {showIcon && (\n          <button\n            onMouseEnter={() => setShowTooltip(true)}\n            onMouseLeave={() => setShowTooltip(false)}\n            className=\"text-cyan-500/50 hover:text-cyan-400 transition-colors\"\n          >\n            <Info className=\"w-4 h-4\" />\n          </button>\n        )}\n      </div>\n\n      {/* Tooltip嚗??皞底??*/}\n      <AnimatePresence>\n        {showTooltip && (\n          <motion.div\n            initial={{ opacity: 0, y: 10, scale: 0.95 }}\n            animate={{ opacity: 1, y: 0, scale: 1 }}\n            exit={{ opacity: 0, y: 10, scale: 0.95 }}\n            transition={{ duration: 0.2 }}\n            className=\"absolute z-50 top-full mt-2 left-0 min-w-[280px] bg-slate-900/98 backdrop-blur-xl border border-cyan-500/30 rounded-lg p-4 shadow-[0_0_20px_rgba(6,182,212,0.2)]\"\n          >\n            {/* 璅? */}\n            <div className=\"flex items-center gap-2 mb-3 pb-2 border-b border-cyan-500/20\">\n              {getSourceIcon()}\n              <span className=\"text-cyan-400 font-bold text-sm\">{getSourceLabel()}</span>\n            </div>\n\n            {/* 閰喟敦靽⊥ */}\n            <div className=\"space-y-2 text-xs\">\n              {/* ????*/}\n              <div className=\"flex justify-between\">\n                <span className=\"text-cyan-600\">?湔??:</span>\n                <span className=\"text-cyan-50 font-mono\">\n                  {new Date(data.source.timestamp).toLocaleString('zh-TW', {\n                    year: 'numeric',\n                    month: '2-digit',\n                    day: '2-digit',\n                    hour: '2-digit',\n                    minute: '2-digit',\n                  })}\n                </span>\n              </div>\n\n              {/* 撽???*/}\n              {data.source.verifiedBy && (\n                <div className=\"flex justify-between\">\n                  <span className=\"text-cyan-600\">撽?:</span>\n                  <span className=\"text-emerald-400\">{data.source.verifiedBy}</span>\n                </div>\n              )}\n\n              {/* Hash嚗?憛?嚗?*/}\n              {data.source.hash && (\n                <div className=\"flex justify-between\">\n                  <span className=\"text-cyan-600\">Hash:</span>\n                  <span className=\"text-cyan-50 font-mono text-[10px]\">\n                    {data.source.hash.slice(0, 10)}...\n                  </span>\n                </div>\n              )}\n\n              {/* 設計?砍? */}\n              {data.source.formula && (\n                <div className=\"mt-2 pt-2 border-t border-cyan-500/20\">\n                  <span className=\"text-cyan-600 block mb-1\">設計?砍?:</span>\n                  <code className=\"text-cyan-50 bg-slate-950/50 px-2 py-1 rounded text-[10px] block\">\n                    {data.source.formula}\n                  </code>\n                </div>\n              )}\n\n              {/* 靘陷??*/}\n              {data.source.dependencies && data.source.dependencies.length > 0 && (\n                <div className=\"mt-2 pt-2 border-t border-cyan-500/20\">\n                  <span className=\"text-cyan-600 block mb-1\">靘陷數據:</span>\n                  <ul className=\"text-cyan-50 text-[10px] space-y-0.5\">\n                    {data.source.dependencies.map((dep, idx) => (\n                      <li key={idx}>??{dep}</li>\n                    ))}\n                  </ul>\n                </div>\n              )}\n\n              {/* URL? */}\n              {data.source.url && (\n                <div className=\"mt-2\">\n                  <a\n                    href={data.source.url}\n                    target=\"_blank\"\n                    rel=\"noopener noreferrer\"\n                    className=\"text-cyan-400 hover:text-cyan-300 flex items-center gap-1 text-[10px]\"\n                  >\n                    <ExternalLink className=\"w-3 h-3\" />\n                    ?亦???數據\n                  </a>\n                </div>\n              )}\n            </div>\n\n            {/* 霅???蝷?*/}\n            {data.evidenceChain && data.evidenceChain.length > 0 && (\n              <div className=\"mt-3 pt-3 border-t border-cyan-500/20\">\n                <div className=\"text-cyan-400 text-[10px] flex items-center gap-1\">\n                  <FileText className=\"w-3 h-3\" />\n                  摰霅???({data.evidenceChain.length} 甇仿?)\n                </div>\n              </div>\n            )}\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n};\n\n/**\n * 雿輻蝷箔?嚗n *\n * const cpuData: TrackedDataPoint = {\n *   value: 12.5,\n *   label: 'CPU雿輻??,\n *   unit: '%',\n *   source: {\n *     type: 'api',\n *     timestamp: Date.now(),\n *     url: '/api/system/metrics',\n *     verifiedBy: 'System Monitor'\n *   }\n * };\n *\n * <DataWithSource data={cpuData}>\n *   <div className=\"text-3xl font-bold\">{cpuData.value}%</div>\n * </DataWithSource>\n */\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\ui\\Dialog.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\ui\\DisclosureWrapper.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 8.","line":42,"column":68,"nodeType":"Literal","messageId":"noMagic","endLine":42,"endColumn":69}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * ? ?剔內??元件嚗isclosureWrapper\n * --------------------------------------------------\n * [雿] ?箔遙雿?UI 元件瘜典?蝷箇??胯? 4T ?豢筑閬?\n * [UX] Hover 閫貊靽∩遙?剔內\n */\n\nimport React from 'react';\nimport { IComponentCore } from '../../types/core';\n\ninterface DisclosureWrapperProps {\n  data: IComponentCore;\n  children: React.ReactNode;\n  className?: string; // Allow custom styling\n}\n\nexport const DisclosureWrapper: React.FC<DisclosureWrapperProps> = ({\n  data,\n  children,\n  className = '',\n}) => {\n  // No longer an array, direct access to the 5T evidence object\n  const evidence = data.evidence;\n\n  return (\n    <div\n      className={`group relative border-l-4 border-emerald-500 pl-2 transition-all hover:bg-slate-900/30 rounded ${className}`}\n    >\n      {/* 數據銝駁? */}\n      <div className=\"relative\">{children}</div>\n\n      {/* 5T ?豢筑?剔內撅?(Hidden by default, shown on hover) */}\n      <div className=\"hidden group-hover:block absolute top-0 left-full ml-4 p-4 bg-slate-950 text-white rounded-lg shadow-2xl z-50 min-w-[300px] border border-slate-700 backdrop-blur-md\">\n        <h4 className=\"text-amber-400 font-bold mb-2 flex items-center gap-2\">\n          <span>🏛️/span> 5T Sentinel Evidence\n        </h4>\n\n        <div className=\"text-xs space-y-2 opacity-90 font-mono\">\n          {/* T1: Traceable */}\n          <div className=\"flex justify-between border-b border-slate-800 pb-1\">\n            <span className=\"text-slate-400\">UUID</span>\n            <span className=\"text-emerald-300\">{data.uuid.slice(0, 8)}...</span>\n          </div>\n\n          <div className=\"flex justify-between border-b border-slate-800 pb-1\">\n            <span className=\"text-slate-400\">Source</span>\n            <span className=\"text-blue-300\">{evidence.source_origin}</span>\n          </div>\n\n          {/* T2: Trackable */}\n          <div className=\"flex justify-between border-b border-slate-800 pb-1\">\n            <span className=\"text-slate-400\">Verified</span>\n            <span className=\"text-purple-300\">{new Date(data.timestamp).toLocaleTimeString()}</span>\n          </div>\n\n          <div className=\"flex justify-between border-b border-slate-800 pb-1\">\n            <span className=\"text-slate-400\">Lifecycle</span>\n            <span className=\"text-cyan-300\">{evidence.lifecycle_hooks.length} Hooks</span>\n          </div>\n\n          {/* T3: Transparent */}\n          <div className=\"flex justify-between border-b border-slate-800 pb-1\">\n            <span className=\"text-slate-400\">Formula</span>\n            <span className=\"text-amber-300 truncate max-w-[150px]\">{evidence.logic_formula}</span>\n          </div>\n\n          {/* T5: Hash Lock */}\n          <div className=\"mt-2 text-[10px] break-all text-slate-500\">\n            ?? Lock: {evidence.hash_lock}\n          </div>\n        </div>\n\n        {/* Visual Decoration */}\n        <div className=\"absolute -left-2 top-4 w-2 h-2 bg-slate-950 border-t border-l border-slate-700 rotate-45\"></div>\n      </div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\ui\\Floating428Button.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\es