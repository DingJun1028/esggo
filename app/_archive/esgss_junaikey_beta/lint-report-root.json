text-left font-black\">\n                          <p\n                            className={`text-sm tracking-tight ${btn.active ? 'text-white' : 'text-white/60'}`}\n                          >\n                            {btn.label}\n                          </p>\n                          <p className=\"text-[10px] text-white/20 uppercase tracking-widest mt-1\">\n                            {btn.desc}\n                          </p>\n                        </div>\n                      </div>\n                      <ChevronRight\n                        size={18}\n                        className={`transition-all ${btn.active ? 'text-[#09aea9] translate-x-1' : 'text-white/10 group-hover:text-white'}`}\n                      />\n                    </button>\n                  ))}\n                </div>\n\n                <div className=\"pt-8 border-t border-white/5 space-y-6 relative z-10\">\n                  <p className=\"text-white/60 text-[10px] font-black uppercase tracking-[0.2em] italic\">\n                    ?嗅?璅⊥蝯? Current Simulation Output\n                  </p>\n                  <div className=\"grid grid-cols-2 gap-6\">\n                    <div className=\"bg-black/40 border border-[#09aea9]/20 p-5 rounded-3xl space-y-2\">\n                      <p className=\"text-white/20 text-[9px] font-black uppercase tracking-widest leading-none\">\n                        瘛券?脩? Net Zero\n                      </p>\n                      <p className=\"text-[#09aea9] text-3xl font-black tracking-tighter leading-none\">\n                        +18%\n                      </p>\n                    </div>\n                    <div className=\"bg-black/40 border border-orange-400/20 p-5 rounded-3xl space-y-2\">\n                      <p className=\"text-white/20 text-[9px] font-black uppercase tracking-widest leading-none\">\n                        ??? Op-Cost\n                      </p>\n                      <p className=\"text-orange-400 text-3xl font-black tracking-tighter leading-none\">\n                        +4.2%\n                      </p>\n                    </div>\n                  </div>\n                </div>\n\n                <div className=\"absolute bottom-[-50px] right-[-50px] size-64 bg-[#09aea9]/5 rounded-full blur-3xl\" />\n              </motion.div>\n            </div>\n          </div>\n\n          {/* Strategic Action Log */}\n          <motion.div\n            initial={{ opacity: 0, y: 30 }}\n            animate={{ opacity: 1, y: 0 }}\n            transition={{ delay: 0.8 }}\n            className=\"backdrop-blur-3xl bg-white/[0.02] border border-white/5 rounded-[4rem] overflow-hidden shadow-2xl mb-12\"\n          >\n            <div className=\"px-12 py-8 border-b border-white/5 flex justify-between items-center bg-[#09aea9]/5 backdrop-blur-md\">\n              <h3 className=\"text-2xl font-black text-white flex items-center gap-5 tracking-tighter italic leading-none\">\n                <Assignment className=\"text-[#09aea9] size-7\" />\n                ?????亥??' '}\n                <span className=\"text-white/20 not-italic font-black text-xs uppercase tracking-widest ml-4\">\n                  Strategic Action Log\n                </span>\n              </h3>\n              <button className=\"text-[#09aea9] text-[10px] font-black uppercase tracking-[0.3em] hover:brightness-125 transition-all\">\n                ?亦??券閮? View All\n              </button>\n            </div>\n\n            <div className=\"divide-y divide-white/5\">\n              {[\n                {\n                  title: '?孵? 2024 撟湔偶蝥撅?蝞?,\n                  sub: '??潔??曹????偷??Signing Required',\n                  priority: '擃合約 Critical',\n                  color: 'text-orange-400',\n                  dot: 'bg-orange-500',\n                  btn: '蝪賜蔡 EXECUTE',\n                },\n                {\n                  title: '?? CSRD ??隢株岷?',\n                  sub: '瘜??券?撌脣???甇亙祟??Legal Verified',\n                  priority: '???? Compliance',\n                  color: 'text-blue-400',\n                  dot: 'bg-blue-500',\n                  btn: '?亦? VIEW',\n                },\n                {\n                  title: '靘??????輻??湔獢?,\n                  sub: '數據?舀?嚗SG 敺????? +5%',\n                  priority: '瘝餌??芸? Governance',\n                  color: 'text-emerald-400',\n                  dot: 'bg-emerald-500',\n                  btn: '?亦? VIEW',\n                },\n              ].map((action, idx) => (\n                <div\n                  key={idx}\n                  className=\"px-12 py-10 flex items-center justify-between group hover:bg-white/[0.03] transition-all\"\n                >\n                  <div className=\"flex items-center gap-8\">\n                    <div\n                      className={`size-3 rounded-full ${action.dot} shadow-[0_0_10px_currentColor] animate-pulse`}\n                    />\n                    <div className=\"space-y-1\">\n                      <p className=\"text-xl font-black text-white tracking-tight group-hover:text-[#09aea9] transition-colors\">\n                        {action.title}\n                      </p>\n                      <p className=\"text-white/30 text-xs font-medium italic\">{action.sub}</p>\n                    </div>\n                  </div>\n                  <div className=\"flex items-center gap-8\">\n                    <span\n                      className={`px-5 py-2 rounded-full border border-white/5 text-[9px] font-black uppercase tracking-widest bg-white/5 ${action.color}`}\n                    >\n                      {action.priority}\n                    </span>\n                    <button\n                      className={`px-10 py-3 rounded-2xl text-[10px] font-black uppercase tracking-[0.2em] transition-all active:scale-95 ${idx === 0 ? 'bg-[#09aea9] text-[#0a0c10] shadow-[0_0_20px_rgba(9,174,169,0.3)]' : 'bg-white/5 text-white/40 hover:bg-white/10 hover:text-white'}`}\n                    >\n                      {action.btn}\n                    </button>\n                  </div>\n                </div>\n              ))}\n            </div>\n          </motion.div>\n        </main>\n      </div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\BusinessIntelligenceDashboard.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 800.","line":38,"column":44,"nodeType":"Literal","messageId":"noMagic","endLine":38,"endColumn":47},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 800.","line":40,"column":44,"nodeType":"Literal","messageId":"noMagic","endLine":40,"endColumn":47},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 600.","line":44,"column":44,"nodeType":"Literal","messageId":"noMagic","endLine":44,"endColumn":47},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 80.","line":171,"column":81,"nodeType":"Literal","messageId":"noMagic","endLine":171,"endColumn":83},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 60.","line":171,"column":134,"nodeType":"Literal","messageId":"noMagic","endLine":171,"endColumn":136},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 70.","line":179,"column":78,"nodeType":"Literal","messageId":"noMagic","endLine":179,"endColumn":80},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 3.","line":329,"column":25,"nodeType":"Literal","messageId":"noMagic","endLine":329,"endColumn":26},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 4.","line":329,"column":28,"nodeType":"Literal","messageId":"noMagic","endLine":329,"endColumn":29}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":8,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState } from 'react';\nimport {\n  Search,\n  ShieldAlert,\n  TrendingUp,\n  Building2,\n  FileText,\n  AlertTriangle,\n  CheckCircle,\n  Bookmark,\n  PlusCircle,\n  Star,\n} from 'lucide-react';\nimport { businessIntelligenceService, CompanyReport } from '@/services/BusinessIntelligenceService';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport { omniLogger, LogCategory } from '@/services/omniLogger';\nimport { useFavorites } from '@/hooks/useFavorites';\n\nexport const BusinessIntelligenceDashboard: React.FC = () => {\n  const [query, setQuery] = useState('');\n  const [loading, setLoading] = useState(false);\n  const [scanningPhase, setScanningPhase] = useState<string | null>(null);\n  const [report, setReport] = useState<CompanyReport | null>(null);\n\n  const { toggleFavorite, isFavorite } = useFavorites();\n  const isReportFavorite = report ? isFavorite(report.taxId as any) : false;\n\n  const handleSearch = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!query.trim()) return;\n\n    setLoading(true);\n    setReport(null);\n    setScanningPhase('Initializing Quantum Probe...');\n\n    try {\n      // Simulated scanning phases\n      await new Promise(r => setTimeout(r, 800));\n      setScanningPhase('Accessing Deep Web Nodes...');\n      await new Promise(r => setTimeout(r, 800));\n      setScanningPhase('Analyzing 5T Integrity...');\n      await new Promise(r => setTimeout(r, 1000));\n      setScanningPhase('Synthesizing Risk Matrix...');\n      await new Promise(r => setTimeout(r, 600));\n\n      const result = await businessIntelligenceService.analyzeCompany(query);\n      setReport(result);\n    } catch (error) {\n      console.error(error);\n    } finally {\n      setLoading(false);\n      setScanningPhase(null);\n    }\n  };\n\n  return (\n    <div className=\"p-8 h-full bg-slate-950 text-slate-200 overflow-y-auto custom-scrollbar\">\n      <header className=\"mb-10 text-center\">\n        <h1 className=\"text-4xl font-bold text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300 mb-4\">\n          Business Intelligence & ESG Risk Radar\n        </h1>\n        <p className=\"text-slate-400 max-w-2xl mx-auto\">\n          Deep-dive investigations into corporate entities. Uncover financial health, ESG\n          performance, and hidden scandal risks using the 5T Sentinel Protocol.\n        </p>\n      </header>\n\n      {/* Search Section */}\n      <div className=\"max-w-3xl mx-auto mb-16\">\n        <form onSubmit={handleSearch} className=\"relative group\">\n          <div className=\"absolute inset-0 bg-gradient-to-r from-blue-500 to-cyan-500 rounded-full blur opacity-25 group-hover:opacity-50 transition-opacity\" />\n          <div className=\"relative flex items-center bg-slate-900 border border-slate-700 rounded-full p-2 shadow-2xl\">\n            <Search className=\"ml-4 w-6 h-6 text-slate-500\" />\n            <input\n              type=\"text\"\n              value={query}\n              onChange={e => setQuery(e.target.value)}\n              placeholder=\"Enter Company Name, Tax ID, or Website URL...\"\n              className=\"flex-1 bg-transparent border-none focus:ring-0 text-white placeholder-slate-500 px-4 text-lg\"\n            />\n            <button\n              type=\"submit\"\n              disabled={loading}\n              className=\"bg-blue-600 hover:bg-blue-500 text-white px-8 py-3 rounded-full font-bold transition-all disabled:opacity-50 disabled:cursor-not-allowed relative overflow-hidden\"\n            >\n              {loading && (\n                <motion.div\n                  className=\"absolute inset-0 bg-gradient-to-r from-blue-400 to-cyan-400 opacity-20\"\n                  animate={{ left: ['-100%', '100%'] }}\n                  transition={{ duration: 1.5, repeat: Infinity, ease: 'linear' }}\n                />\n              )}\n              {loading ? 'Quantum Scanning...' : 'Analyze'}\n            </button>\n          </div>\n          {scanningPhase && (\n            <motion.p\n              initial={{ opacity: 0 }}\n              animate={{ opacity: 1 }}\n              className=\"text-center mt-4 text-cyan-400 font-mono text-sm animate-pulse\"\n            >\n              {scanningPhase}\n            </motion.p>\n          )}\n        </form>\n      </div>\n\n      {/* Report Display */}\n      <AnimatePresence>\n        {report && (\n          <motion.div\n            initial={{ opacity: 0, y: 20 }}\n            animate={{ opacity: 1, y: 0 }}\n            className=\"max-w-6xl mx-auto space-y-8\"\n          >\n            {/* Company Header */}\n            <div className=\"bg-slate-900/50 border border-white/10 rounded-2xl p-8 flex flex-col md:flex-row justify-between items-start gap-6\">\n              <div>\n                <div className=\"flex items-center gap-3 mb-2\">\n                  <Building2 className=\"w-8 h-8 text-blue-400\" />\n                  <h2 className=\"text-3xl font-bold text-white\">{report.name}</h2>\n                </div>\n                <div className=\"flex gap-4 text-sm text-slate-400 font-mono\">\n                  <span>Tax ID: {report.taxId}</span>\n                  <span>|</span>\n                  <span>{report.industry}</span>\n                  <span>|</span>\n                  <a\n                    href={`https://${report.website}`}\n                    target=\"_blank\"\n                    rel=\"noreferrer\"\n                    className=\"text-blue-400 hover:underline\"\n                  >\n                    {report.website}\n                  </a>\n                </div>\n              </div>\n              <div className=\"flex gap-6 text-center\">\n                {/* Action Buttons */}\n                <div className=\"flex flex-col gap-2 justify-center\">\n                  <button\n                    onClick={() => {\n                      toggleFavorite(report.taxId as any);\n                      omniLogger.info(\n                        LogCategory.USER_ACTION,\n                        `${isReportFavorite ? 'Removed' : 'Added'} ${report.name} to Favorites`\n                      );\n                    }}\n                    className={`p-3 rounded-xl transition-all ${isReportFavorite ? 'bg-yellow-500/20 text-yellow-500 shadow-[0_0_10px_rgba(234,179,8,0.3)]' : 'bg-slate-800 hover:bg-slate-700 text-slate-400'}`}\n                    title={isReportFavorite ? 'Remove from Favorites' : 'Save to Favorites'}\n                  >\n                    <Bookmark className={`w-5 h-5 ${isReportFavorite ? 'fill-current' : ''}`} />\n                  </button>\n                  <button\n                    onClick={() =>\n                      omniLogger.info(\n                        LogCategory.USER_ACTION,\n                        `Added ${report.name} report to OmniNote`\n                      )\n                    }\n                    className=\"p-3 bg-slate-800 hover:bg-slate-700 text-cyan-400 rounded-xl transition-colors\"\n                    title=\"Add to OmniNote\"\n                  >\n                    <PlusCircle className=\"w-5 h-5\" />\n                  </button>\n                </div>\n\n                <div className=\"p-4 bg-slate-800 rounded-xl min-w-[120px]\">\n                  <div className=\"text-xs text-slate-400 mb-1\">Overview Score</div>\n                  <div\n                    className={`text-3xl font-bold ${report.esg.overallScore >= 80 ? 'text-emerald-400' : report.esg.overallScore >= 60 ? 'text-yellow-400' : 'text-red-400'}`}\n                  >\n                    {report.esg.overallScore} / 100\n                  </div>\n                </div>\n                <div className=\"p-4 bg-slate-800 rounded-xl min-w-[120px]\">\n                  <div className=\"text-xs text-slate-400 mb-1\">News Sentiment</div>\n                  <div\n                    className={`text-3xl font-bold ${report.newsSentiment >= 70 ? 'text-blue-400' : 'text-slate-200'}`}\n                  >\n                    {report.newsSentiment}%\n                  </div>\n                </div>\n              </div>\n            </div>\n\n            {/* Analysis Grid */}\n            <div className=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8\">\n              {/* Financials */}\n              <div className=\"bg-slate-900/50 border border-white/10 rounded-2xl p-6\">\n                <h3 className=\"text-xl font-bold text-white flex items-center gap-2 mb-6\">\n                  <TrendingUp className=\"w-5 h-5 text-emerald-400\" />\n                  Financial Health\n                </h3>\n                <div className=\"space-y-4\">\n                  <div className=\"flex justify-between py-2 border-b border-white/5\">\n                    <span className=\"text-slate-400\">Annual Revenue</span>\n                    <span className=\"text-white font-mono\">{report.financials.revenue}</span>\n                  </div>\n                  <div className=\"flex justify-between py-2 border-b border-white/5\">\n                    <span className=\"text-slate-400\">YoY Growth</span>\n                    <span\n                      className={`${report.financials.growth.startsWith('+') ? 'text-emerald-400' : 'text-red-400'} font-mono`}\n                    >\n                      {report.financials.growth}\n                    </span>\n                  </div>\n                  <div className=\"flex justify-between py-2 border-b border-white/5\">\n                    <span className=\"text-slate-400\">Profit Margin</span>\n                    <span className=\"text-white font-mono\">{report.financials.profitMargin}</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* ESG Performance */}\n              <div className=\"bg-slate-900/50 border border-white/10 rounded-2xl p-6\">\n                <h3 className=\"text-xl font-bold text-white flex items-center gap-2 mb-6\">\n                  <FileText className=\"w-5 h-5 text-blue-400\" />\n                  ESG Disclosure\n                </h3>\n                <div className=\"space-y-4\">\n                  <div>\n                    <div className=\"flex justify-between text-sm mb-1\">\n                      <span>Environment</span>\n                      <span>{report.esg.environmentScore}</span>\n                    </div>\n                    <div className=\"h-2 bg-slate-800 rounded-full overflow-hidden\">\n                      <div\n                        style={{ width: `${report.esg.environmentScore}%` }}\n                        className=\"h-full bg-emerald-500\"\n                      />\n                    </div>\n                  </div>\n                  <div>\n                    <div className=\"flex justify-between text-sm mb-1\">\n                      <span>Social</span>\n                      <span>{report.esg.socialScore}</span>\n                    </div>\n                    <div className=\"h-2 bg-slate-800 rounded-full overflow-hidden\">\n                      <div\n                        style={{ width: `${report.esg.socialScore}%` }}\n                        className=\"h-full bg-blue-500\"\n                      />\n                    </div>\n                  </div>\n                  <div>\n                    <div className=\"flex justify-between text-sm mb-1\">\n                      <span>Governance</span>\n                      <span>{report.esg.governanceScore}</span>\n                    </div>\n                    <div className=\"h-2 bg-slate-800 rounded-full overflow-hidden\">\n                      <div\n                        style={{ width: `${report.esg.governanceScore}%` }}\n                        className=\"h-full bg-purple-500\"\n                      />\n                    </div>\n                  </div>\n                  <div className=\"flex flex-wrap gap-2 mt-4\">\n                    {report.esg.commitments.map((c: string) => (\n                      <span\n                        key={c}\n                        className=\"px-2 py-1 bg-blue-500/20 text-blue-300 text-xs rounded border border-blue-500/30 flex items-center gap-1\"\n                      >\n                        <CheckCircle className=\"w-3 h-3\" /> {c}\n                      </span>\n                    ))}\n                  </div>\n                </div>\n              </div>\n\n              {/* Risk Radar & Scandal Timeline */}\n              <div className=\"bg-slate-900/50 border border-white/10 rounded-2xl p-6 relative overflow-hidden lg:col-span-1\">\n                <div className=\"absolute top-0 right-0 w-32 h-32 bg-red-600/10 blur-3xl rounded-full\" />\n                <h3 className=\"text-xl font-bold text-white flex items-center gap-2 mb-6\">\n                  <ShieldAlert className=\"w-5 h-5 text-red-500\" />\n                  Risk Radar\n                </h3>\n\n                <div className=\"space-y-6\">\n                  {report.risks.length === 0 ? (\n                    <div className=\"flex flex-col items-center justify-center h-48 text-emerald-400\">\n                      <CheckCircle className=\"w-12 h-12 mb-2 opacity-50\" />\n                      <p>No critical risks detected</p>\n                    </div>\n                  ) : (\n                    <div className=\"space-y-4 max-h-[400px] overflow-y-auto custom-scrollbar pr-2\">\n                      {/* Scandal Timeline Visualization */}\n                      <div className=\"relative pl-6 space-y-8 before:absolute before:left-2 before:top-2 before:bottom-0 before:w-0.5 before:bg-slate-800\">\n                        {report.risks.map((risk: any, idx: number) => (\n                          <div key={risk.id} className=\"relative\">\n                            <div\n                              className={`absolute -left-[22px] top-1.5 w-3 h-3 rounded-full border-2 border-slate-900 ${risk.severity === 'critical' ? 'bg-red-500' : 'bg-yellow-500'}`}\n                            />\n                            <div className=\"bg-slate-800/40 border border-white/5 rounded-xl p-4 hover:border-red-500/30 transition-colors\">\n                              <div className=\"flex justify-between items-start mb-2\">\n                                <span\n                                  className={`text-[10px] font-bold px-2 py-0.5 rounded ${risk.severity === 'critical' ? 'bg-red-500/20 text-red-400' : 'bg-yellow-500/20 text-yellow-400'}`}\n                                >\n                                  {risk.severity}\n                                </span>\n                                <span className=\"text-[10px] text-slate-500 font-mono\">\n                                  {risk.date}\n                                </span>\n                              </div>\n                              <h4 className=\"text-white font-bold text-sm mb-1\">{risk.title}</h4>\n                              <p className=\"text-xs text-slate-400 leading-relaxed\">\n                                {risk.description}\n                              </p>\n                            </div>\n                          </div>\n                        ))}\n                      </div>\n                    </div>\n                  )}\n                </div>\n              </div>\n            </div>\n\n            {/* Quantum Depth Section (Placeholder for future expansion) */}\n            <div className=\"bg-gradient-to-br from-blue-600/5 to-cyan-600/5 border border-white/5 rounded-3xl p-12 text-center\">\n              <h3 className=\"text-2xl font-bold text-white mb-4\">Deep Intelligence Scanning</h3>\n              <p className=\"text-slate-400 mb-8 max-w-2xl mx-auto\">\n                Analyzing multi-dimensional datasets to uncover hidden patterns. Our AI monitors\n                global supply chains, legal filings, and real-time sentiment to provide a\n                Sovereign-grade view of corporate character.\n              </p>\n              <div className=\"flex justify-center gap-8 opacity-50 grayscale hover:grayscale-0 transition-all duration-700\">\n                {/* Grid of scanning indicators */}\n                {[1, 2, 3, 4].map(i => (\n                  <div key={i} className=\"flex flex-col items-center gap-2\">\n                    <div className=\"w-12 h-12 rounded-full border-2 border-cyan-500/30 border-t-cyan-500 animate-spin\" />\n                    <span className=\"text-[10px] font-mono text-cyan-500\">Node {i}</span>\n                  </div>\n                ))}\n              </div>\n            </div>\n          </motion.div>\n        )}\n      </AnimatePresence>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\CarbonBentoDashboard.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\CarbonInventory.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\ChaosLab.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 5.","line":60,"column":38,"nodeType":"Literal","messageId":"noMagic","endLine":60,"endColumn":39},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: -20.","line":69,"column":44,"nodeType":"UnaryExpression","messageId":"noMagic","endLine":69,"endColumn":47},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 30.","line":77,"column":19,"nodeType":"Literal","messageId":"noMagic","endLine":77,"endColumn":21},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 800.","line":88,"column":44,"nodeType":"Literal","messageId":"noMagic","endLine":88,"endColumn":47},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 15.","line":90,"column":36,"nodeType":"Literal","messageId":"noMagic","endLine":90,"endColumn":38},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 1.5.","line":220,"column":43,"nodeType":"Literal","messageId":"noMagic","endLine":220,"endColumn":46},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.5.","line":220,"column":62,"nodeType":"Literal","messageId":"noMagic","endLine":220,"endColumn":65},{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 0.5.","line":220,"column":70,"nodeType":"Literal","messageId":"noMagic","endLine":220,"endColumn":73}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":8,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import React, { useState, useEffect, useRef } from 'react';\nimport { motion, AnimatePresence } from 'framer-motion';\nimport {\n  AlertOctagon,\n  Zap,\n  Activity,\n  Terminal,\n  ShieldAlert,\n  Flame,\n  Brain,\n  Lock,\n  Unlock,\n} from 'lucide-react';\nimport { useAgentRpg } from '../../hooks/useAgentRpg';\nimport { OMNI_AGENTS } from '../../data/omni-agents';\n\ninterface Anomaly {\n  id: string;\n  title: string;\n  description: string;\n  complexity: number;\n  impact: string;\n}\n\nconst AVAILABLE_ANOMALIES: Anomaly[] = [\n  {\n    id: 'anom_01',\n    title: 'Sudden Regulatory Collapse',\n    description: 'Global ESG reporting standards have been suspended after a major fraud scandal.',\n    complexity: 0.8,\n    impact: 'High instability in Governance (G) alignment.',\n  },\n  {\n    id: 'anom_02',\n    title: 'Deep-Sea Mining Crisis',\n    description: 'A massive ecosystem failure detected due to automated mining bots.',\n    complexity: 0.9,\n    impact: 'Violent fluctuations in Environmental (E) drift.',\n  },\n  {\n    id: 'anom_03',\n    title: 'Labor Revolt in VR Hubs',\n    description: 'Digital labor unions have taken control of regional compute nodes.',\n    complexity: 0.7,\n    impact: 'Serious Social (S) empathy conflict.',\n  },\n];\n\nexport const ChaosLab: React.FC = () => {\n  const { profile, processChaosInput } = useAgentRpg();\n  const [isInjecting, setIsInjecting] = useState(false);\n  const [selectedAnomaly, setSelectedAnomaly] = useState<Anomaly | null>(null);\n  const [terminalLogs, setTerminalLogs] = useState<string[]>([\n    '[SYSTEM] Chaos Laboratory Online.',\n    '[STATUS] Waiting for Anomaly Injection...',\n  ]);\n  const [chaosLevel, setChaosLevel] = useState(0);\n  const scrollRef = useRef<HTMLDivElement>(null);\n\n  const isEvolved = profile.level >= 5;\n\n  useEffect(() => {\n    if (scrollRef.current) {\n      scrollRef.current.scrollTop = scrollRef.current.scrollHeight;\n    }\n  }, [terminalLogs]);\n\n  const addLog = (msg: string) => {\n    setTerminalLogs(prev => [...prev.slice(-20), `[${new Date().toLocaleTimeString()}] ${msg}`]);\n  };\n\n  const handleInject = async () => {\n    if (!selectedAnomaly) return;\n\n    setIsInjecting(true);\n    addLog(`CRITICAL: Injecting Anomaly ${selectedAnomaly.id}...`);\n    setChaosLevel(30);\n\n    const phases = [\n      'Bypassing Safety Protocols...',\n      'Decrypting Fragmented Intelligence...',\n      'Force-Feeding Contradictory Logic...',\n      'Monitoring Neural Feedback...',\n      'Stabilizing High-Entropy Core...',\n    ];\n\n    for (const phase of phases) {\n      await new Promise(r => setTimeout(r, 800));\n      addLog(phase);\n      setChaosLevel(prev => prev + 15);\n    }\n\n    const result = processChaosInput({\n      content: selectedAnomaly.title,\n      complexity: selectedAnomaly.complexity,\n      category: 'Chaos',\n      type: 'CHAOS',\n    });\n\n    addLog(`INJECTION COMPLETE. Result: ${result.feedback}`);\n    addLog(`STATS: XP +${result.xpGained}, Drift Shifted.`);\n\n    setIsInjecting(false);\n    setChaosLevel(0);\n    setSelectedAnomaly(null);\n  };\n\n  if (!isEvolved) {\n    return (\n      <div className=\"flex flex-col items-center justify-center min-h-[600px] bg-red-950/20 border border-red-500/20 rounded-2xl p-12 text-center\">\n        <Lock className=\"w-16 h-16 text-red-500 mb-6 animate-pulse\" />\n        <h2 className=\"text-3xl font-bold text-red-100 mb-4\">CHAOS LAB LOCKED</h2>\n        <p className=\"text-red-400 max-w-md mx-auto\">\n          Training in the Chaos Laboratory is highly dangerous. Your agent must reach **Level 5** to\n          unlock the neural resilience required to survive high-entropy data injection.\n        </p>\n      </div>\n    );\n  }\n\n  return (\n    <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6 p-2\">\n      {/* Left: Anomaly Selector */}\n      <div className=\"lg:col-span-1 space-y-6\">\n        <div className=\"bg-black/60 border border-red-500/30 rounded-2xl p-6 backdrop-blur-md\">\n          <h3 className=\"text-xl font-bold text-red-400 flex items-center gap-2 mb-6\">\n            <AlertOctagon className=\"w-5 h-5\" />\n            Anomaly Injector\n          </h3>\n\n          <div className=\"space-y-3\">\n            {AVAILABLE_ANOMALIES.map(anom => (\n              <button\n                key={anom.id}\n                onClick={() => setSelectedAnomaly(anom)}\n                disabled={isInjecting}\n                className={`w-full p-4 rounded-xl border text-left transition-all ${\n                  selectedAnomaly?.id === anom.id\n                    ? 'border-red-500 bg-red-900/30 shadow-[0_0_15px_rgba(239,68,68,0.2)]'\n                    : 'border-white/10 bg-white/5 hover:border-red-500/50'\n                }`}\n              >\n                <div className=\"font-bold text-sm text-red-100 mb-1\">{anom.title}</div>\n                <div className=\"text-[10px] text-gray-500 leading-tight\">{anom.description}</div>\n              </button>\n            ))}\n          </div>\n\n          <button\n            onClick={handleInject}\n            disabled={!selectedAnomaly || isInjecting}\n            className={`w-full mt-8 py-4 rounded-xl font-bold flex items-center justify-center gap-2 transition-all ${\n              !selectedAnomaly || isInjecting\n                ? 'bg-gray-800 text-gray-500 cursor-not-allowed'\n                : 'bg-gradient-to-r from-red-600 to-orange-600 text-white hover:from-red-500 hover:to-orange-500 shadow-lg shadow-red-600/20'\n            }`}\n          >\n            <Flame className={`w-5 h-5 ${isInjecting ? 'animate-bounce' : ''}`} />\n            {isInjecting ? 'INJECTING CHAOS...' : 'INITIATE INJECTION'}\n          </button>\n        </div>\n\n        <div className=\"bg-black/60 border border-white/10 rounded-2xl p-6\">\n          <h4 className=\"text-sm font-bold text-gray-300 uppercase tracking-widest mb-4\">\n            Chaos Metrics\n          </h4>\n          <div className=\"space-y-4\">\n            <div>\n              <div className=\"flex justify-between text-[10px] mb-1\">\n                <span className=\"text-gray-500\">RESILIENCE</span>\n                <span className=\"text-cyan-400 font-bold\">\n                  {profile.attributes.resilience.toFixed(1)}\n                </span>\n              </div>\n              <div className=\"h-1.5 w-full bg-gray-800 rounded-full overflow-hidden\">\n                <motion.div\n                  className=\"h-full bg-cyan-500\"\n                  animate={{ width: `${Math.min(100, profile.attributes.resilience)}%` }}\n                />\n              </div>\n            </div>\n            <div className=\"p-3 bg-red-500/10 border border-red-500/20 rounded-lg\">\n              <div className=\"text-[10px] text-red-300 font-bold mb-1 uppercase\">Warning</div>\n              <p className=\"text-[9px] text-red-400/80 leading-relaxed italic\">\n                High chaos training increases drift instability. Prolonged exposure may lead to\n                neural corruption.\n              </p>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Middle & Right: Execution & Terminal */}\n      <div className=\"lg:col-span-2 space-y-6\">\n        {/* Visualizer */}\n        <div className=\"bg-black/60 border border-white/10 rounded-2xl p-8 relative overflow-hidden min-h-[300px] flex items-center justify-center\">\n          {/* Background Grid */}\n          <div className=\"absolute inset-0 bg-[url('https://grainy-gradients.vercel.app/noise.svg')] opacity-20\" />\n          <div\n            className=\"absolute inset-0\"\n            style={{\n              backgroundImage:\n                'radial-gradient(circle at center, transparent 0%, black 100%), linear-gradient(to right, #1a1a1a 1px, transparent 1px), linear-gradient(to bottom, #1a1a1a 1px, transparent 1px)',\n              backgroundSize: '100% 100%, 20px 20px, 20px 20px',\n            }}\n          />\n\n          <AnimatePresence>\n            {isInjecting ? (\n              <motion.div\n                initial={{ opacity: 0, scale: 0.5 }}\n                animate={{ opacity: 1, scale: 1 }}\n                exit={{ opacity: 0, scale: 1.5 }}\n                className=\"relative z-10 flex flex-col items-center\"\n              >\n                <div className=\"relative\">\n                  <Activity className=\"w-24 h-24 text-red-500 mb-4 animate-pulse\" />\n                  <motion.div\n                    className=\"absolute inset-0 rounded-full border-2 border-red-500\"\n                    animate={{ scale: [1, 1.5, 1], opacity: [0.5, 0, 0.5] }}\n                    transition={{ duration: 1.5, repeat: Infinity }}\n                  />\n                </div>\n                <div className=\"text-xl font-mono font-bold text-red-400 tracking-[0.2em]\">\n                  CHAOS DETECTED\n                </div>\n                <div className=\"text-[10px] text-red-600 font-mono mt-2\">\n                  ENTROPY: {chaosLevel}%\n                </div>\n              </motion.div>\n            ) : (\n              <motion.div\n                initial={{ opacity: 0 }}\n                animate={{ opacity: 1 }}\n                className=\"relative z-10 flex flex-col items-center text-center opacity-40 hover:opacity-100 transition-opacity\"\n              >\n                <Brain className=\"w-16 h-16 text-gray-600 mb-4\" />\n                <div className=\"text-sm font-bold text-gray-500 uppercase tracking-widest\">\n                  Neural Core Stable\n                </div>\n                <div className=\"text-[10px] text-gray-600 mt-1 max-w-xs\">\n                  Select an anomaly to begin high-entropy training sequence.\n                </div>\n              </motion.div>\n            )}\n          </AnimatePresence>\n        </div>\n\n        {/* Terminal */}\n        <div className=\"bg-black border border-white/10 rounded-2xl flex flex-col h-[280px]\">\n          <div className=\"bg-white/5 border-b border-white/10 px-4 py-2 flex items-center justify-between\">\n            <div className=\"flex items-center gap-2\">\n              <Terminal className=\"w-4 h-4 text-green-500\" />\n              <span className=\"text-[10px] font-mono text-gray-400 font-bold uppercase tracking-wider\">\n                Chaos Terminal v2.0\n              </span>\n            </div>\n            <div className=\"flex gap-1\">\n              <div className=\"w-2 h-2 rounded-full bg-red-500/50\" />\n              <div className=\"w-2 h-2 rounded-full bg-orange-500/50\" />\n              <div className=\"w-2 h-2 rounded-full bg-green-500/50\" />\n            </div>\n          </div>\n          <div\n            ref={scrollRef}\n            className=\"flex-1 p-4 font-mono text-[11px] overflow-y-auto custom-scrollbar bg-black/80\"\n          >\n            {terminalLogs.map((log, i) => (\n              <div\n                key={i}\n                className={`mb-1 ${\n                  log.includes('CRITICAL')\n                    ? 'text-red-500 font-bold'\n                    : log.includes('COMPLETE')\n                      ? 'text-green-400'\n                      : log.includes('[SYSTEM]')\n                        ? 'text-blue-400'\n                        : 'text-gray-400'\n                }`}\n              >\n                {log}\n              </div>\n            ))}\n            {isInjecting && (\n              <motion.div\n                animate={{ opacity: [1, 0] }}\n                transition={{ repeat: Infinity, duration: 0.8 }}\n                className=\"inline-block w-2 h-4 bg-red-500 ml-1\"\n              />\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n","usedDeprecatedRules":[]},{"filePath":"C:\\Project\\esgss_junaikey_beta\\esgss_junaikey_beta\\src\\components\\dashboard\\ComplianceMatrix.tsx","messages":[{"ruleId":"no-magic-numbers","severity":1,"message":"No magic number: 16.","line":181,"column":72,"nodeType":"Literal","messageId":"noMagic","endLine":181,"endColumn":74}],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":1,"fixableErrorCount":0,"fixableWarningCount":0,"source":"// src/components/dashboard/ComplianceMatrix.tsx\nimport React, { useState } from 'react';\nimport { ShieldCheck, AlertTriangle, CheckCircle, Search, FileText } from 'lucide-react';\n\ninterface ComplianceItem {\n  id: string;\n  category: '?啣? (E)' | '蝷暹? (S)' | '瘝餌? (G)';\n  code: string;\n  requirement: string;\n  status: 'compliant' | 'warning' | 'non-compliant';\n  lastCheck: string;\n  sourceUrl?: string;\n}\n\nconst COMPLIANCE_DATA: ComplianceItem[] = [\n  // Environmental (E) - 瘞????ISO\n  {\n    id: 'c1',\n    category: '?啣? (E)',\n    code: 'ISO 14064-1:5.1',\n    requirement: '蝯???閮剖? (?∠???嗆?瘜?',\n    status: 'compliant',\n    lastCheck: '2026-01-12',\n  },\n  {\n    id: 'c2',\n    category: '?啣? (E)',\n    code: '瘞???瑕??? 禮28',\n    requirement: '蝣唾祥?喳?撽?(瘥僑 4 ??????'