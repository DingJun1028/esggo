# 環境變數配置範例

# ===== 必需環境變數 =====

# Node.js 環境
NODE_ENV=production
PORT=8080

# 數據庫連接
DATABASE_URL=postgresql://username:password@host:5432/database
# 或分開配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=esgss
DB_USER=your_username
DB_PASSWORD=your_password

# Redis 連接
REDIS_URL=redis://host:6379
# 或分開配置
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=esg_redis_password
# 如果 Redis 版本 < 5.0.0，設為 true 使用 OmniQueue fallback
REDIS_FALLBACK_ONLY=false

# 監控與儀表板
GRAFANA_PASSWORD=admin

# JWT 認證
JWT_SECRET=your-very-long-random-secret-key-change-this-in-production
JWT_EXPIRES_IN=7d

# API 安全
API_SECRET_TOKEN=your-api-secret-token-change-this

# ===== AI 服務 =====

# Google Gemini (Real Intelligence)
GOOGLE_GEMINI_API_KEY=your-gemini-api-key-here
VITE_GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here

# OpenAI (如果使用)
OPENAI_API_KEY=your-openai-key

# Supabase (Optional - 數據持久化)
# 如果不使用 Supabase，應用仍可正常運行（僅使用記憶體數據）
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# ===== 可選配置 =====

# 日誌級別
LOG_LEVEL=info

# CORS 設定
CORS_ORIGIN=http://localhost:3000,https://yourdomain.com

# 文件上傳
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Email (如果使用)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# ===== Cloud Run 專用 =====

# Cloud SQL 連接名稱
CLOUD_SQL_CONNECTION_NAME=project:region:instance

# Cloud Storage
GCS_BUCKET_NAME=your-bucket-name

# ===== 開發環境 =====

# 前端 URL（用於 CORS）
FRONTEND_URL=http://localhost:3000

# 後端 URL
BACKEND_URL=http://localhost:8080

# Vite API URLs (用於 Docker 內部路由)
VITE_API_URL=http://api-gateway:80/api
VITE_JUNAIKEY_URL=http://api-gateway:80/api/junaikey
VITE_SHANXIANG_URL=http://api-gateway:80/api/shanxiang

# ===== 生產環境範例 =====

# 前端 URL
# FRONTEND_URL=https://your-app.vercel.app

# 後端 URL
# BACKEND_URL=https://esg-backend-service-*.run.app

# ===== Google Stitch MCP =====
GOOGLE_STITCH_API_URL=https://mcp.google-stitch.example.com
GOOGLE_STITCH_CLIENT_ID=your-stitch-client-id

# ===== 注意事項 =====
# 1. 複製此文件為 .env
# 2. 修改所有 "your-" 開頭的值
# 3. 不要將 .env 文件提交到 Git
# 4. 在 Cloud Run 中設置環境變數時，使用 gcloud 命令或控制台