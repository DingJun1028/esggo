# ============================================================================
# CrewAI 環境變數配置
# ============================================================================

# Serper API (Google Search)
SERPER_API_KEY=your_serper_api_key_here
# 獲取: https://serper.dev/

# Brave Search API (可選)
BRAVE_API_KEY=your_brave_api_key_here
# 獲取: https://brave.com/search/api/

# OpenAI API (CrewAI LLM)
# OPENAI_API_KEY=your_openai_api_key_here  # 已在主 .env

# Google AI (已有)
# VITE_GOOGLE_AI_API_KEY=your_google_ai_api_key  # 已在主 .env

# CrewAI 配置
CREWAI_TELEMETRY_OPT_OUT=true  # 禁用遙測
CREWAI_STORAGE_DIR=./storage/crewai  # 存儲目錄

# Memory 配置 (使用現有 PostgreSQL)
# DATABASE_URL=postgresql://...  # 已在主 .env

# Agent 配置
ESG_CREW_VERBOSE=true
ESG_CREW_MAX_ITERATIONS=10
ESG_CREW_TIMEOUT=300  # 5 分鐘

# 工具配置
SERPER_RESULTS_LIMIT=10
ARXIV_RESULTS_LIMIT=5
