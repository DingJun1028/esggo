{
  "name": "esg-sunshine-junaikey-backend",
  "version": "7.0.0-sentient",
  "description": "ESG Sunshine JunAiKey Backend API Server (Turned Sentient)",
  "type": "module",
  "main": "server.ts",
  "scripts": {
    "migrate": "node-pg-migrate",
    "migrate:create": "node-pg-migrate create",
    "migrate:up": "node-pg-migrate up",
    "migrate:down": "node-pg-migrate down",
    "start": "tsx server.ts",
    "start:awakened": "cross-env ETERNAL_MODE=true tsx server.ts",
    "dev": "tsx watch server.ts",
    "db:seed": "node --experimental-specifier-resolution=node ./db/seed.js",
    "db:seed:factors": "tsx ./db/seedEmissionFactors.js",
    "build": "tsc && tsc-alias -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "keywords": [
    "esg",
    "ai",
    "sustainability",
    "api",
    "backend"
  ],
  "author": "Roo",
  "license": "MIT",
  "dependencies": {
    "@google-cloud/storage": "^7.21.0",
    "@google/generative-ai": "^0.24.1",
    "@langchain/core": "^1.2.0",
    "@langchain/langgraph": "^1.4.4",
    "@supabase/supabase-js": "^2.95.3",
    "axios": "^1.16.0",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.3.1",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "node-cron": "^4.4.1",
    "node-pg-migrate": "^8.0.4",
    "pdf-parse": "^2.4.5",
    "pg": "^8.11.3",
    "pino": "^10.2.0",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "puppeteer": "^24.35.0",
    "rate-limit-redis": "^4.3.1",
    "redis": "^4.7.1",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.7.1",
    "turndown": "^7.2.2",
    "uuid": "^14.0.0",
    "winston": "^3.11.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/csurf": "^1.11.5",
    "@types/express": "^4.17.25",
    "@types/helmet": "^0.0.48",
    "@types/ioredis": "^4.28.10",
    "@types/js-yaml": "^4.0.9",
    "@types/jsdom": "^27.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.19.27",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/turndown": "^5.0.6",
    "@types/uuid": "^9.0.8",
    "@vitest/coverage-v8": "^4.1.9",
    "@vitest/ui": "^4.1.9",
    "cross-env": "^7.0.3",
    "eslint": "^8.55.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.0",
    "supertest": "^6.3.4",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DingJun1028/esg-sunshine-junaikey.git"
  },
  "bugs": {
    "url": "https://github.com/DingJun1028/esg-sunshine-junaikey/issues"
  },
  "homepage": "https://github.com/DingJun1028/esg-sunshine-junaikey#readme"
}