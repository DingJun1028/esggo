# === Build Stage ===
FROM node:20-alpine AS builder

WORKDIR /app

# 複製依賴文件
COPY package*.json ./

# 安裝依賴 (Use npm install for greater compatibility if lockfile desyncs)
RUN npm install

# 複製源碼
COPY . .

# 構建生產版本
RUN npm run build

# === Production Stage ===
FROM nginx:1.25-alpine

# Install curl for HEALTHCHECK
RUN apk add --no-cache curl

# 設置工作目錄
WORKDIR /usr/share/nginx/html

# 移除預設的 nginx 靜態資源及配置
RUN rm -rf ./* /etc/nginx/conf.d/default.conf

# 從 builder 階段複製構建產物
COPY --from=builder /app/dist .

# 複製自定義 nginx 配置
COPY nginx.conf /etc/nginx/nginx.conf

# 創建必要的目錄並設置權限
RUN mkdir -p /var/cache/nginx /var/run /var/log/nginx && \
  chown -R nginx:nginx /var/cache/nginx /var/run /var/log/nginx /usr/share/nginx/html /etc/nginx && \
  chmod -R 755 /var/cache/nginx /var/run /var/log/nginx /usr/share/nginx/html /etc/nginx

# 切換到非 root 用戶
USER nginx

# Cloud Run 注入的 PORT 環境變數（默認 8080）
EXPOSE 8080

# 健康檢查
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD curl --fail http://localhost:8080/ || exit 1

# 啟動 nginx
CMD ["nginx", "-g", "daemon off;"]
