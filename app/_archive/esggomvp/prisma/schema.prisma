// ESGSonar Database Schema
// ESG 法規監測系統資料庫模型

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 法規 (Regulation)
// ============================================
model Regulation {
  id          String   @id @default(cuid())
  code        String   @unique // 法規編號，如 "金管會 1120301"
  name        String   // 法規名稱
  category    RegulationCategory // 法規分類
  authority   String   // 主管機關
  sourceUrl   String?  // 來源 URL
  content     String?  // 法規內容摘要
  effectiveDate DateTime? // 生效日期
  publishedDate DateTime? // 發布日期
  status      RegulationStatus @default(ACTIVE)
  
  // 關聯
  reports     CompanyReport[]
  tags        RegulationTag[]
  crawlHistory CrawlHistory[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum RegulationCategory {
  ENVIRONMENTAL   // 環境保護
  SOCIAL          // 社會責任
  GOVERNANCE      // 公司治理
  DISCLOSURE      // 資訊揭露
  TAXONOMY        // 分類標準
  OTHER           // 其他
}

enum RegulationStatus {
  ACTIVE
  AMENDED
  REPEALED
  DRAFT
}

// 法規標籤關聯
model RegulationTag {
  id           String     @id @default(cuid())
  regulationId String
  tagId        String
  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  tag          ESGTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@unique([regulationId, tagId])
}

// ============================================
// 企業報告書 (CompanyReport)
// ============================================
model CompanyReport {
  id              String   @id @default(cuid())
  reportId        String   @unique // 報告書唯一識別碼
  
  // 企業資訊
  companyName     String   // 企業名稱
  companyCode     String?  // 股票代碼
  industry        String?  // 產業類別
  
  // 報告書資訊
  reportType      ReportType
  reportYear      Int       // 報告年度
  publishDate     DateTime? // 發布日期
  reportUrl       String?   // 報告書 URL
  contentHash     String?   // 內容雜湊值
  
  // 版本控制
  version         Int      @default(1)
  previousVersion Int?     // 前一版本編號
  isLatest        Boolean  @default(true)
  
  // 法規關聯
  regulationId    String?
  regulation      Regulation? @relation(fields: [regulationId], references: [id])
  
  // 來源關聯
  sourceId        String?
  source          Source?     @relation(fields: [sourceId], references: [id])
  
  // 內容
  summary         String?    // 摘要
  content         String?    // 完整內容 (JSON 或 Text)
  
  // 差異分析
  diffFromPrevious String?  // 與前一版本的差異
  changeType      ChangeType? // 變更類型
  
  // 狀態
  status          ReportStatus @default(PENDING)
  
  // 關聯
  tags            ReportTag[]
  crawlHistory    CrawlHistory[]
  
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

enum ReportType {
  ESG_REPORT       // ESG 報告
  SUSTAINABILITY  // 永續報告
  ANNUAL_REPORT    // 年報
  CARBON_INVENTORY // 碳盤查報告
  INTEGRATED       // 整合報告
  OTHER            // 其他
}

enum ReportStatus {
  PENDING      // 待處理
  PROCESSING   // 處理中
  COMPLETED    // 完成
  FAILED       // 失敗
  ARCHIVED     // 已歸檔
}

enum ChangeType {
  NEW          // 新增
  UPDATED      // 更新
  DELETED      // 刪除
  NO_CHANGE    // 無變更
}

// 報告書標籤關聯
model ReportTag {
  id        String        @id @default(cuid())
  reportId  String
  tagId     String
  report    CompanyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  tag       ESGTag        @relation(fields: [tagId], references: [id], onDelete: Cascade)
  
  @@unique([reportId, tagId])
}

// ============================================
// ESG 標籤 (ESGTag)
// ============================================
model ESGTag {
  id          String   @id @default(cuid())
  name        String   @unique // 標籤名稱
  category    ESGCategory
  description String?  // 標籤描述
  
  // 顏色標示
  color       String?  // 顏色代碼
  
  // 關聯
  regulations RegulationTag[]
  reports     ReportTag[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum ESGCategory {
  ENVIRONMENTAL   // E - 環境
  SOCIAL          // S - 社會
  GOVERNANCE      // G - 治理
  OTHER           // 其他
}

// ============================================
// 來源網站 (Source)
// ============================================
model Source {
  id          String   @id @default(cuid())
  name        String   // 來源名稱
  url         String   @unique // 網址
  type        SourceType
  authority   String?  // 主管機關
  
  // 爬蟲配置
  crawlConfig String?  // 爬蟲配置 (JSON)
  selector    String?  // CSS 選擇器
  
  // 狀態
  isActive    Boolean  @default(true)
  lastCrawled DateTime? // 上次爬取時間
  crawlInterval Int    @default(86400) // 爬取間隔 (秒)，預設 24 小時
  
  // 關聯
  reports     CompanyReport[]
  crawlHistory CrawlHistory[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum SourceType {
  GOVERNMENT    // 政府機關
  REGULATORY    // 監管機構
  INTERNATIONAL // 國際組織
  THIRD_PARTY   // 第三方機構
  COMPANY       // 企業官網
  OTHER         // 其他
}

// ============================================
// 爬蟲歷史 (CrawlHistory)
// ============================================
model CrawlHistory {
  id          String   @id @default(cuid())
  
  // 爬取目標
  sourceId    String?
  source      Source?      @relation(fields: [sourceId], references: [id])
  regulationId String?
  regulation  Regulation?  @relation(fields: [regulationId], references: [id])
  reportId    String?
  report      CompanyReport? @relation(fields: [reportId], references: [id])
  
  // 爬取結果
  status      CrawlStatus
  itemsFound  Int      @default(0) // 找到的項目數
  itemsNew    Int      @default(0) // 新增項目數
  itemsUpdated Int     @default(0) // 更新項目數
  
  // 錯誤資訊
  errorMessage String?  // 錯誤訊息
  errorDetail  String?  // 錯誤詳情
  
  // 效能指標
  duration    Int?     // 爬取耗時 (毫秒)
  responseTime Int?    // 回應時間 (毫秒)
  
  // 雜湊鎖定
  contentHash String?  // 內容雜湊
  
  // 時間戳
  startedAt   DateTime @default(now())
  completedAt DateTime?
}

enum CrawlStatus {
  PENDING      // 待處理
  RUNNING      // 執行中
  COMPLETED    // 完成
  FAILED       // 失敗
  PARTIAL      // 部分成功
}

// ============================================
// 通知日誌 (NotificationLog)
// ============================================
model NotificationLog {
  id          String   @id @default(cuid())
  
  // 通知類型
  type        NotificationType
  channel     NotificationChannel // 通知管道
  
  // 收件人
  recipient   String   // 收件人 (email, LINE ID, etc.)
  subject     String?  // 通知標題
  
  // 內容
  content     String   // 通知內容
  data        Json?    // 附加資料
  
  // 狀態
  status      NotificationStatus @default(PENDING)
  attempts    Int      @default(0) // 嘗試次數
  maxAttempts Int      @default(3) // 最大嘗試次數
  
  // 發送結果
  sentAt      DateTime?
  readAt      DateTime?
  errorMessage String? // 錯誤訊息
  
  // 關聯
  reportId    String?
  regulationId String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum NotificationType {
  REGULATION_UPDATE  // 法規更新
  REPORT_PUBLISHED  // 報告書發布
  REPORT_UPDATE     // 報告書更新
  CHANGE_DETECTED   // 偵測到變更
  SYSTEM_ALERT      // 系統警告
  REMINDER          // 提醒
}

enum NotificationChannel {
  EMAIL       // 電子郵件
  LINE        // LINE
  WEBHOOK     // Webhook
  SMS         // 簡訊
  IN_APP      // 應用內通知
}

enum NotificationStatus {
  PENDING      // 待發送
  SENT         // 已發送
  DELIVERED    // 已送達
  READ         // 已讀
  FAILED       // 失敗
  CANCELLED    // 已取消
}

// ============================================
// 索引定義 (Indexes)
// ============================================

// 加速法規查詢
@@index([category, status])
@@index([authority, publishedDate])

// 加速報告書查詢
@@index([companyCode, reportYear])
@@index([reportType, isLatest])
@@index([status, createdAt])

// 加速爬蟲歷史查詢
@@index([sourceId, startedAt])
@@index([status, startedAt])

// 加速通知日誌查詢
@@index([type, status])
@@index([recipient, status])