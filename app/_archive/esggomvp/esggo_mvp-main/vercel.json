{
    "github": {
        "silent": false
    },
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "framework": "nextjs",
    "regions": [
        "hnd1"
    ],
    "env": {
        "NEXT_PUBLIC_APP_VERSION": "11.1.0-Stabilized",
        "NEXT_PUBLIC_APP_ENVIRONMENT": "production"
    },
    "rewrites": [
        {
            "source": "/api/dispatch",
            "destination": "/api/dispatch.js"
        }
    ]
}