{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user profile information and roles.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique user ID from Firebase Auth." },
        "displayName": { "type": "string", "description": "User's display name." },
        "email": { "type": "string", "format": "email", "description": "User's email address." },
        "role": { "type": "string", "enum": ["admin", "user", "guest"], "description": "User's role in the system." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the profile was created." }
      },
      "required": ["uid", "email", "role"]
    },
    "Project": {
      "title": "ESG Project",
      "description": "Represents an ESG initiative or project.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique project ID." },
        "title": { "type": "string", "description": "Project title." },
        "description": { "type": "string", "description": "Project description." },
        "authorUid": { "type": "string", "description": "UID of the user who created the project." },
        "status": { "type": "string", "enum": ["draft", "active", "completed"], "description": "Current status of the project." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the project was created." }
      },
      "required": ["title", "authorUid", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile documents."
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "ESG project documents."
    }
  }
}
