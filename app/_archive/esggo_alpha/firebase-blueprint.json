{
  "entities": {
    "UserActivity": {
      "title": "User Activity",
      "description": "Logs of user actions on the platform",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "metadata": { "type": "object" },
        "serverTime": { "type": "string", "description": "Firestore server timestamp" }
      },
      "required": ["action", "timestamp", "serverTime"]
    },
    "ESGReport": {
      "title": "ESG Report",
      "description": "Permanent storage for ESG reports",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "year": { "type": "integer" },
        "status": { "type": "string", "enum": ["draft", "completed"] },
        "progress": { "type": "number" },
        "sections": { "type": "array" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "firestore": {
    "/_connection_test/{docId}": {
      "schema": { "type": "object", "properties": { "status": { "type": "string" } } },
      "description": "Internal collection for infrastructure health checks"
    },
    "/user_activities/{activityId}": {
      "schema": "UserActivity",
      "description": "Global activity feed"
    },
    "/esg_reports/{reportId}": {
      "schema": "ESGReport",
      "description": "Company ESG reports"
    }
  }
}
