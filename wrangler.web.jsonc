{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "esggo-web",
  "main": "vinext/server/app-router-entry",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "VINEXT_KV_CACHE",
      "id": "2f376dbffa554d3680c04cc936ace80c"
    }
  ],
  // 522 根因：無 routes/custom_domains 時 CF 只把 proxied 記錄當一般 origin 拉
  // → 回源目標死亡（2026-11-17 Vercel 帳號刪除後 apex/origin 全 522）。
  // route 綁定讓 esggo-web 直接接管請求（proxied 域名由 CF 依 hostname 路由到 Worker）。
  // 實測 2026-10-17：帳號級 Access app「All Workers」(86a4d5af…, destination
  // all_workers, allow→account_member) 會匹配 Worker/Pages 自訂網域（htb-b2b.esggo.co
  // 曾 302），故 web.esggo.co 另有專屬 app (14121b0e…) 加 Everyone→Skip 才公開。
  // apex/www 加入 route 後同樣會先被 All Workers 擋（302），需把專屬 app 的
  // domain 擴到 esggo.co / www.esggo.co（或另建 app 加 bypass）才會 200。
  "routes": [
    {
      "pattern": "web.esggo.co",
      "zone_name": "esggo.co"
    },
    {
      "pattern": "esggo.co",
      "zone_name": "esggo.co"
    },
    {
      "pattern": "www.esggo.co",
      "zone_name": "esggo.co"
    }
  ]
}
