# Example .env.local for Docker compose projects with missing env vars
# Copy to docker/.env.local and fill with your project's internal paths
# Never commit real secrets — use this for internal container paths only

# Project paths (NOT secrets)
# Example for DeerFlow:
# DEER_FLOW_CONFIG_PATH=/path/to/config.yaml
# DEER_FLOW_HOME=/path/to/.runtime
# DEER_FLOW_EXTENSIONS_CONFIG_PATH=/path/to/extensions_config.json

# Enable CSRF-free stateless API access:
# DEER_FLOW_AUTH_DISABLED=***
