# ═══════════════════════════════════════════════════════════════
# .env.unified.example — Unified Environment Configuration
# Single Source of Truth for all environment variables
# ═══════════════════════════════════════════════════════════════

# ── App ────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://esggo.co

# ── Database (PostgreSQL via Prisma) ──────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:5432/dbname
OMNI_DATABASE_URL=postgresql://user:password@host:5432/omnodb

# ── Redis ──────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379
# Upstash (optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Firebase ───────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# ── Supabase ──────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI Providers ──────────────────────────────────────────────
GROQ_API_KEY=gsk_xxx
OPENROUTER_API_KEY=sk-or-xxx
GEMINI_API_KEY=AIzaSyxxx
FREE_TIER_ONLY=true

# ── Gateway ────────────────────────────────────────────────────
GATEWAY_URL=http://omniagent-gateway:8642
GATEWAY_API_KEY=your-gateway-key

# ── NCB (NoCodeBackend) ────────────────────────────────────────
NCB_APP_ID=your-ncb-app-id
NCB_APP_KEY=your-ncb-app-key
NCB_BASE_URL=https://api.nocodebackend.com

# ── Notion (Optional) ─────────────────────────────────────────
NOTION_WORKSPACE_ID=your-workspace-id
NOTION_API_SECRET=secret_xxx

# ── Observability (Optional) ──────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=omnicore

# ── Security ───────────────────────────────────────────────────
CORS_ORIGIN=https://esggo.co
