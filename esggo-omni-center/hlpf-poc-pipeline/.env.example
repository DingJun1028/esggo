# HLPF POC Pipeline — environment template (copy to .env, fill secrets)
# All keys are optional. If a provider key is absent, that provider falls
# back to the poster clip automatically. Never commit real .env values.

# --- TTS ---
# edge-tts is used by default (no key needed); set elevenlabs key to switch
ELEVENLABS_API_KEY=

# --- B-roll providers ---
# one of: poster (default) | runway | heygen
BROLL_PROVIDER=poster

# Runway image-to-video (https://dev.runwayml.com)
RUNWAY_API_KEY=
RUNWAY_MODEL=gen4_turbo

# HeyGen talking-avatar (https://www.heygen.com)
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
HEYGEN_VOICE_ID=
