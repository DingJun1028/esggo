{
  "name": "omniagent-gateway",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "main": "omni-server.mjs",
  "scripts": {
    "start": "node omni-server.mjs",
    "health": "node -e \"fetch('http://127.0.0.1:8642/status').then((res) => process.exit(res.ok ? 0 : 1)).catch(() => process.exit(1))\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "node-telegram-bot-api": "^1.1.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.0",
    "@types/node-telegram-bot-api": "^0.6.4",
    "@types/ws": "^8.5.10",
    "typescript": "^5.4.0"
  }
}
