{
  "name": "omniagent-gateway",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "main": "omni-server.mjs",
  "scripts": {
    "start": "node omni-server.mjs",
    "health": "node -e \"fetch('http://127.0.0.1:8642/status').then((res) => process.exit(res.ok ? 0 : 1)).catch(() => process.exit(1))\"",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "cors": "^2.8.6",
    "express": "^4.22.2",
    "express-rate-limit": "^7.5.1",
    "helmet": "^7.2.0",
    "node-telegram-bot-api": "^1.1.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20.19.43",
    "@types/node-telegram-bot-api": "^0.64.15",
    "@types/ws": "^8.18.1",
    "typescript": "^5.9.3",
    "zod": "^4.4.3"
  }
}
