# 萬能即時翻譯 — 環境變數
# 純免費版預設零 key 即可運作；下方 Gemini 區塊為「可選雲端增強」，不設即關閉。
# 絕對不要把真實 key 寫進 git（.env 已被 gitignore）。

# 服務端口
PORT=8788

# 翻譯引擎優先序（免費層）: google-gtx(零key) → libretranslate(自建,可選) → mymemory(免費) → 原文兜底
LIBRETRANSLATE_URL=
LIBRETRANSLATE_KEY=
MYMEMORY_EMAIL=esggo.translate@gmail.com
TRANSLATE_CACHE_MAX=1000
TRANSLATE_TIMEOUT_MS=8000
TRANSLATE_RETRIES=2

# Ollama 本地 LLM 翻譯（可選，需本機有 ollama + 模型）
# OLLAMA_MODEL=qwen2.5:3b

# ───────────────────────────────────────────────
# 可選雲端增強：Gemini 3.5 Live Translate 技術整合
# 設了 GEMINI_API_KEY 才啟用最前端增強層；失敗自動回落免費鏈。
# 不設 → 完全關閉，純免費零 key 運作。
# ───────────────────────────────────────────────
# GEMINI_API_KEY=你的_Gemini_API_金鑰
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=10000
