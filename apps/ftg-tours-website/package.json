{
  "name": "ftg-tours-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint",
