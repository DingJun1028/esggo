    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "happy-dom": "^20.11.1",
    "oxlint": "^1.71.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "vite": "^8.1.1",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.13",
    "pnpm": ">=11"
