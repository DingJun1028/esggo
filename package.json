{
  "name": "esggo",
  "version": "5.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "bin": {
    "esggo": "./packages/cli/src/omni.mjs"
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "libs/*"
  ],
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs || true",
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 NODE_OPTIONS=--max-old-space-size=1536 tsx scripts/validate-env.ts 2>/dev/null || true && next build",
    "start": "bash -c 'set -a; source .env 2>/dev/null; set +a; next start -H 127.0.0.1'",
    "lint": "ts-node scripts/celestial-gate.ts",
    "lint:full": "eslint src/ --max-warnings 50",
    "typecheck": "tsc -p tsconfig.core.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "pnpm run typecheck && vitest run src/impl/__tests__/core.test.ts src/agents/twelve-omni/__tests__",
    "turbo:dev": "next dev",
    "turbo:build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "turbo:start": "next start",
    "turbo:lint": "eslint . --fix",
    "oa:summon": "ts-node --transpile-only -P tsconfig.scripts.json scripts/run-summon.ts",
    "oa:summon:core": "ts-node --transpile-only -P tsconfig.scripts.json scripts/run-summon.ts -- --core",
    "oa:weekly-report": "tsx cli/oa-cli/src/index.ts weekly-report",
    "oa:audit": "tsx cli/oa-cli/src/index.ts audit --dir \"src/lib,cli/oa-cli/src\"",
    "verify:gap-matrix": "node scripts/export-shared-types.js && npx tsx scripts/verify_gap_matrix.ts",
    "verify:matrix": "node scripts/verify-terminal-origin.mjs",
    "verify": "pnpm turbo run lint typecheck test build && pnpm -F ./apps/learning-center check:types-sync"
  },
  "dependencies": {
    "@esggo/errors": "workspace:*",
    "@esggo/shared": "workspace:*",
    "@esggo/ui": "workspace:*",
    "@google/genai": "^2.25.0",
    "@grpc/grpc-js": "^1.14.5",
    "@grpc/proto-loader": "0.8.1",
    "@notionhq/client": "^5.27.0",
    "@notionhq/workers": "^0.4.0",
    "@prisma/client": "^6.19.3",
    "@tailwindcss/typography": "^0.5.20",
    "@upstash/redis": "^1.39.0",
    "commander": "^12.1.0",
    "framer-motion": "^12.43.0",
    "ioredis": "^5.11.1",
    "isomorphic-dompurify": "^3.23.0",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.507.0",
    "pdf-parse": "^1.1.4",
    "pg": "^8.23.1",
    "pino": "^10.3.1",
    "prisma": "^6.19.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "tsx": "^4.23.15",
    "uuid": "^14.0.2",
    "xlsx": "^0.18.5",
    "xss": "^1.0.15",
    "zenrows": "^2.0.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@next/eslint-plugin-next": "16.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@vitest/coverage-v8": "^4.1.11",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "next": "^16.3.8",
    "pino-pretty": "^13.1.3",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.19",
    "ts-node": "^10.9.2",
    "turbo": "^2.11.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20",
    "pnpm": "11.5.2"
  },
  "omnilules": {
    "enabled": true,
    "agents": [
      "omni-agent",
      "jules",
      "antigravity",
      "omninexus"
    ],
    "skills": [
      "omni-sync-memory",
      "omni-tag",
      "omni-base",
      "omni-seed",
      "omni-agent",
      "omni-write",
      "omni-biz",
      "omni-memory"
    ],
    "protocols": [
      "5t-protocol"
    ]
  },

  "resolutions": {
    "undici": "^7.29.1",
    "ip-address": "^10.7.1",
    "js-yaml": "^5.4.1",
    "fast-uri": "^3.1.8",
    "brace-expansion": "^5.0.10",
    "next": "^16.3.8",
    "dompurify": "^3.4.16",
    "@grpc/grpc-js": "^1.13.6",
    "node-forge": "^1.4.1",
    "cross-spawn": "^7.0.6",
    "ws": "^8.18.0",
    "fast-xml-parser": "^4.5.3",
    "express": "^4.21.2",
    "body-parser": "^1.20.3",
    "cookie": "^0.7.2"
  },
  "overrides": {
    "undici": "^7.29.1",
    "ip-address": "^10.7.1",
    "js-yaml": "^5.4.1",
    "fast-uri": "^3.1.8",
    "brace-expansion": "^5.0.10",
    "next": "^16.3.8",
    "dompurify": "^3.4.16",
    "@grpc/grpc-js": "^1.13.6",
    "node-forge": "^1.4.1",
    "cross-spawn": "^7.0.6",
    "ws": "^8.18.0",
    "fast-xml-parser": "^4.5.3",
    "express": "^4.21.2",
    "body-parser": "^1.20.3",
    "cookie": "^0.7.2"
  }
}
