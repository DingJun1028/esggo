{
  "name": "esggo",
  "version": "5.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "bin": {
    "esggo": "./packages/cli/src/omni.mjs"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs && node packages/omni-agent/src/bin_cli/omni-agent.js init",
    "dev": "pnpm omni:dev && next dev",
    "build": "pnpm omni:build && cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "pnpm omni:start && next start -H 127.0.0.1",
    "lint": "pnpm omni:lint && ts-node scripts/celestial-gate.ts",
    "lint:full": "pnpm omni:lint:full && eslint src/ --max-warnings 50",
    "typecheck": "pnpm omni:typecheck && tsc -p tsconfig.core.json",
    "test": "pnpm omni:test && vitest run",
    "test:watch": "vitest",
    "test:coverage": "pnpm omni:test:coverage && vitest run --coverage",
    "turbo:dev": "pnpm omni:dev && next dev",
    "turbo:build": "pnpm omni:build && cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "turbo:start": "pnpm omni:start && next start",
    "turbo:lint": "pnpm omni:lint:full && eslint . --fix",
    "omni:init": "node packages/omni-agent/src/bin_cli/omni-agent.js init",
    "omni:dev": "node packages/omni-agent/src/bin_cli/omni-agent.js dev",
    "omni:build": "node packages/omni-agent/src/bin_cli/omni-agent.js build",
    "omni:start": "node packages/omni-agent/src/bin_cli/omni-agent.js start",
    "omni:lint": "node packages/omni-agent/src/bin_cli/omni-agent.js lint",
    "omni:lint:full": "node packages/omni-agent/src/bin_cli/omni-agent.js lint:full",
    "omni:typecheck": "node packages/omni-agent/src/bin_cli/omni-agent.js typecheck",
    "omni:test": "node packages/omni-agent/src/bin_cli/omni-agent.js test",
    "omni:test:coverage": "node packages/omni-agent/src/bin_cli/omni-agent.js test:coverage",
    "oa:summon": "ts-node --transpile-only scripts/run-summon.ts",
    "oa:summon:core": "ts-node --transpile-only scripts/run-summon.ts -- --core"
  },
  "dependencies": {
    "@esggo/errors": "workspace:*",
    "@esggo/shared": "workspace:*",
    "@esggo/ui": "workspace:*",
    "@google/genai": "^2.10.0",
    "@notionhq/client": "^5.22.0",
    "@notionhq/workers": "^0.4.0",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/typography": "^0.5.20",
    "@upstash/redis": "^1.38.0",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "ioredis": "^5.11.1",
    "isomorphic-dompurify": "^3.18.0",
    "lucide-react": "^0.507.0",
    "pdf-parse": "^1.1.4",
    "pg": "^8.22.0",
    "prisma": "^5.22.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "uuid": "^14.0.1",
    "xss": "^1.0.15",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/uuid": "~11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "^16.0.0",
    "@next/eslint-plugin-next": "16.0.0",
    "next": "^16.0.0",
    "postcss": "^8.5.16",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.1",
    "turbo": "^2",
    "typescript": "^5",
    "vitest": "^4.1.9",
    "typescript-eslint": "^8.63.0"
  },
  "engines": {
    "node": "20.x",
    "pnpm": "11.5.2"
  },
  "omnilules": {
    "enabled": true,
    "agents": [
      "omni-agent",
      "jules",
      "antigravity",
      "omninexus"
    ],
    "skills": [
      "omni-sync-memory",
      "omni-tag",
      "omni-base",
      "omni-seed",
      "omni-agent",
      "omni-write",
      "omni-biz",
      "omni-memory"
    ],
    "protocols": [
      "5t-protocol"
    ]
  }
}
