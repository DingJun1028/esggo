{
  "name": "esggo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "bin": {
    "esggo": "./packages/cli/src/omni.mjs"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "turbo:dev": "next dev",
    "turbo:build": "cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "turbo:start": "next start",
    "turbo:lint": "next lint"
  },
  "dependencies": {
    "@esggo/shared": "workspace:*",
    "@esggo/ui": "workspace:*",
    "@google/genai": "^2.10.0",
    "@notionhq/client": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/typography": "^0.5.20",
    "@upstash/redis": "^1.38.0",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.1.0",
    "ioredis": "^5.11.1",
    "isomorphic-dompurify": "^3.18.0",
    "lucide-react": "^0.378.0",
    "pdf-parse": "^1.1.1",
    "prisma": "^5.22.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0",
    "uuid": "^14.0.1"
  },
  "overrides": {
    "glob": ">=10.5.0",
    "minimatch": ">=9.0.7",
    "postcss": ">=8.5.10",
    "uuid": ">=11.1.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "~11.0.0",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "cross-env": "^10.1.0",
    "eslint": "^8",
    "eslint-config-next": "^16.0.0",
    "eslint-plugin-next": "^0.0.0",
    "next": "^16.0.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.1",
    "turbo": "^2",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
