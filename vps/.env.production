# =============================================================================
# ESG GO — Oracle VPS Production Environment
# =============================================================================
# 將此檔案複製到 VPS 的 /opt/esggo/vps/.env
# 使用方式: cp .env.production vps/.env && vi vps/.env
# =============================================================================

# ─── AI Provider Keys (免費層) ──────────────────────────────────
# Groq: 30 req/min, 無每日上限 — 最快免費推論
# 取得金鑰: https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter: 200 req/day 免費層 — 最廣模型選擇
# 取得金鑰: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free

# Gemini: 免費層可用
# 取得金鑰: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# AGNES API (可選)
AGNES_API=

# ─── Supabase (可選 — 用於 ESG 資料儲存) ────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Firebase (可選 — 用於認證與雲端儲存) ───────────────────────
# 將 service account JSON 壓縮為單行後填入
FIREBASE_SERVICE_ACCOUNT_JSON=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# ─── Redis (docker-compose 內建，通常不需修改) ──────────────────
# REDIS_HOST=redis
# REDIS_PORT=6379

# ─── Gateway (AI 代理閘道) ──────────────────────────────────────
# 設定閘道 API 金鑰以限制存取
GATEWAY_API_KEY=

# ─── Oracle Cloud (可選 — 用於 Oracle API 整合) ────────────────
# ORACLE_COMPARTMENT_ID=

# ─── Nginx SSL (certbot 自動續約用) ─────────────────────────────
# CERTBOT_EMAIL=admin@esggo.ai
