# =============================================================================
# ESG GO — OmniAgent Gateway Dockerfile (ARM64)
# Multi-stage build: minimal runtime image, non-root user
# =============================================================================
FROM node:22-alpine AS builder
WORKDIR /app
RUN apk add --no-cache wget curl
COPY vps/package.json ./
RUN npm install --omit=dev
COPY vps/omni-server.mjs ./
COPY vps/omni-server-secure.mjs ./
COPY vps/omni-master-key.mjs ./
COPY vps/ecosystem.esggo.config.cjs ./
COPY apps/gateway/model-router.mjs ./

FROM node:22-alpine AS runner
WORKDIR /app
RUN apk add --no-cache wget curl && rm -rf /var/cache/apk/*
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/omni-server.mjs ./
COPY --from=builder /app/omni-server-secure.mjs ./
COPY --from=builder /app/omni-master-key.mjs ./
COPY --from=builder /app/ecosystem.esggo.config.cjs ./
COPY --from=builder /app/model-router.mjs ./
RUN addgroup --system --gid 1001 nodejs
RUN adduser --system --uid 1001 gateway
RUN chown -R gateway:nodejs /app
USER gateway
EXPOSE 8642
LABEL org.opencontainers.image.title="esggo-gateway" \
      org.opencontainers.image.description="OmniAgent Gateway (ARM64)" \
      org.opencontainers.image.version="1.0.0" \
      org.opencontainers.image.vendor="ESG GO" \
      org.opencontainers.image.licenses="AGPL-3.0"
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:8642/status || exit 1
CMD ["node", "omni-server.mjs"]
