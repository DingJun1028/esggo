{
  "name": "omni-agent",
  "version": "5.1.0",
  "private": true,
  "type": "module",
  "main": "src/gates.ts",
  "types": "src/gates.ts",
  "exports": {
    ".": "./src/gates.ts",
    "./types": "./src/types.ts"
  },
  "scripts": {
    "start": "ts-node src/gates.ts",
    "build": "tsc",
    "dev": "ts-node src/gates.ts",
    "test": "vitest",
    "lint": "eslint src/ --fix",
    "lint:full": "eslint src/ --max-warnings 50",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["omnijules", "ai-agent", "esggo", "5t-protocol", "five-t-gate"],
  "author": "ESG GO Team",
  "license": "UNLICENSED",
  "description": "OmniJules 5T Gate Verification Engine — 5T 閘道驗證核心 (traceable/transparent/tangible/trustworthy/trackable)",
  "dependencies": {
    "@esggo/shared": "workspace:*",
    "@esggo/errors": "workspace:*",
    "zod": "^3.25.0",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.9",
    "ts-node": "^10.9.1"
  },
  "engines": {
    "node": "20.x"
  },
  "omni": {
    "agent": {
      "name": "OmniJules",
      "version": "5.1.0",
      "capabilities": ["ai", "agent", "editor", "devops", "security"],
      "protocols": ["5t-protocol", "esggo-standards", "omniskill-codex"]
    }
  }
}
