{
  "name": "omni-agent",
  "version": "5.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "omni-agent": "./src/bin_cli/omni-agent.js"
  },
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "test": "vitest",
    "lint": "eslint src/ --fix",
    "lint:full": "eslint src/ --max-warnings 150",
    "typecheck": "tsc --noEmit",
    "version": "node scripts/version.js",
    "omni:init": "node src/bin_cli/omni-agent.js init",
    "omni:dev": "node src/bin_cli/omni-agent.js dev",
    "omni:build": "node src/bin_cli/omni-agent.js build",
    "omni:start": "node src/bin_cli/omni-agent.js start",
    "omni:lint": "node src/bin_cli/omni-agent.js lint",
    "omni:lint:full": "node src/bin_cli/omni-agent.js lint:full",
    "omni:typecheck": "node src/bin_cli/omni-agent.js typecheck",
    "omni:test": "node src/bin_cli/omni-agent.js test",
    "omni:test:coverage": "node src/bin_cli/omni-agent.js test:coverage"
  },
  "keywords": ["omnijules", "ai-agent", "esggo", "5t-protocol"],
  "author": "ESG GO Team",
  "license": "UNLICENSED",
  "description": "OmniJules AI Agent - Sovereign Intelligence Core for ESG GO Platform",
  "dependencies": {
    "@esggo/shared": "workspace:*",
    "@esggo/errors": "workspace:*",
    "zod": "^3.25.0",
    "typescript": "^5.0.0",
    "chalk": "^4.1.2",
    "figlet": "^1.5.0",
    "inquirer": "^9.0.0",
    "yargs": "^17.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.62.1",
    "@typescript-eslint/parser": "^8.62.1",
    "eslint": "^9.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.9",
    "ts-node": "^10.9.1"
  },
  "engines": {
    "node": "20.x"
  },
  "omni": {
    "agent": {
      "name": "OmniJules",
      "version": "5.1.0",
      "capabilities": ["ai", "agent", "editor", "devops", "security"],
      "protocols": ["5t-protocol", "esggo-standards", "omniskill-codex"]
    }
  }
}